<div class="content-page bg-primary ">
    <div class="heading-section color-overlay content-light " style="background-image: url('/-/media/ASC-Publishing-Images/Web-header.jpg');background-size:cover;">
        <div class="breadcrumb"></div>
                    <div class="container">
                <div class="row">
                    <div class="heading-content col-1 gold-bar"></div>
                </div>
                <div class="row">
                    <div class="heading-content col-12">
                        <h1>Raising Money by Selling Securities</h1>

                    </div>
                </div>
            </div>
    </div>

    <div class="content-section row content-dark bg-white">
            <div class="sidenav-container col-3">
                        <div class="sidebar-title title-small-border-blue">
            <div class="title">
                <a href="/en/small-business" class="">
                    <i class="gold-bar"></i>
                    Small Business
                </a>
            </div>
        </div>
    <div class="sidebar-nav-list">
            <ul>
                        <li class="child-title">
                            <a href="/en/small-business/raising-money-by-selling-securities" class="active">
                                <i class="gold-bar"></i>
                                Raising Money by Selling Securities
                            </a>


                        </li>
                        <li class="child-title">
                            <a href="/en/small-business/going-public" class="">
                                <i class="gold-bar"></i>
                                Going Public
                            </a>


                        </li>
                        <li class="child-title">
                            <a href="/en/small-business/intro-to-raising-capital-using-prospectus-exemptions" class="">
