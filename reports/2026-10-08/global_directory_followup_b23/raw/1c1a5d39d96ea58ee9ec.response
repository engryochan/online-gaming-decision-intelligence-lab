        <a  href="/newsroom/news/open-ended-funds-and-resilient-capital-markets-perspective-european-asset-management" class="no-ajax slide-content"
          hide="true">
        
            <div class="article__field-image">  
<img loading="lazy" src="/sites/default/files/styles/large/public/news/iStock-1304066178.jpg?h=c81ea5ac&amp;itok=oNWxe3Kj" width="480" height="331" alt="an impressionistic view of the stock markets" class="img-fluid" />


</div>
      
        </a>
      </div>
      
      <div class="article__field-topic">
              <div class="field__item">UCITS</div>
              <div class="field__item">Financial stability</div>
              <div class="field__item">Operational resilience</div>
