<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml" lang="en" xml:lang="en">		

	<head>
			
		
		
					
		
		<title>ESMA Registers</title>
		
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
		<meta http-equiv="Content-Language" content="en-uk" />
		<meta http-equiv="Pragma" content="no-cache" />
		<meta http-equiv="imagetoolbar" content="false" />
		
		<link rel="shortcut icon" type="image/ico" href="data:image/png;base64," />
		
		<link rel="stylesheet" type="text/css" href="/publication/resources/css/custom.css" media="screen, projection" />

		<link rel="stylesheet" type="text/css" href="/publication/resources/css/print.css" media="print" />
		
		<script type="text/javascript" src="/publication/resources/js/jquery-3.6.0.min.js"></script>
		
		<!-- <script type="text/javascript" src="../../resources/js/jquery-ui-1.9.2.custom.js" th:src="@{/resources/js/jquery-ui-1.9.2.custom.js}"></script> -->
		<script type="text/javascript" src="/publication/resources/js/jquery-ui.min.js"></script>		
		<script type="text/javascript" src="/publication/resources/js/intro.js?v="></script>
		<script type="text/javascript" src="/publication/resources/js/jquery.equalheights.js"></script>
		<script type="text/javascript" src="/publication/resources/js/esma.js?v="></script>
		<script type="text/javascript" src="/publication/resources/js/jquery.cookie.js"></script>	

	</head>
	
	<body data-img-base="/publication/resources/images/">
		<div id="Wrapper">
			<div id="Header">	
		<div id="logo">
			<a href="http://www.esma.europa.eu/"><img src="/publication/resources/images/LogoRGB.jpg" style="height: 100px;" alt="ESMA Registers system" title="ESMA Registers system" /></a>
		</div><!--Logo-->
		<div id="globalNav">
			<!--<a class="SignBtn" href="#" th:href="${extranetUrl}">SIGN IN</a>-->
			<a class="BTN" href="">SIGN IN</a>
		</div>
	</div>
			<div id="path">
				<span><a id="homePageId" href="/publication/"><img src="/publication/resources/images/white-home-15.png" alt="Homepage"/><span>Homepage</span></a>&nbsp;&gt; </span>
				<span class="PathIcon"><a href="javascript:void(0)" onclick="window.print();return false;">
					<img src="/publication/resources/images/icon_print.gif" alt="Print" /></a></span>
			</div>
			<div id="Container">
				<div id="error">
					<span style="font-weight: bolder; font-size: medium;">General application error</span> 
					<br /> 
					<span style="font-weight: bold; font-size: medium;">Error message</span>
					
					
					<br />
					<div> <!-- ${#strings.isEmpty(variable)} -->
	                	<p>An error has been encountered while accessing this page</p>
	                </div>
	                
	                <p><br/><a href="/publication">Back to Esma Registers publication</a></p>
				</div>
			</div>
		</div>
		<div id="Footer">
        <footer class="row">
            <div class="container">
                <div class="footer_logo">
	              <!--<div><a href="http://www.esma.europa.eu/" th:href="${footerParams['esma']}" th:text="#{footer.esma}">European Securities and Markets Authority</a> <span th:text="#{footer.version}"> version:1.4.4</span></div>-->
	                   <a href="http://www.esma.europa.eu/"><img src="/publication/resources/images/NewLogoWHITE.png" class="logo"/></a>
	                   <span class="text_europe">ESMA is an authority of the European Union</span>
	           </div>  
               <div class="footer_links">
                    <nav role="menuitem">  
                       <a href="https://registers.esma.europa.eu/publication/contactPage">Contact</a>
                    </nav>
                    <nav role="menuitem">
                       <a href="javascript:void(0)" onclick="window.open('helpPage', 'newwindow', 'width=1024,height=768,status=1,resizable=yes,scrollbars=yes,menubar=yes'); return false;">Help</a>
                    </nav>
                     <nav role="menuitem">
                       <a href="https://registers.esma.europa.eu/publication/legalNoticePage">Legal Notice</a>
                    </nav>
	           </div>
	           <div class="footer_version">&copy; <span>European Securities and Markets Authority</span>&nbsp;<span>| version: null</span></div>
            </div>
        </footer>
    </div> 
	</body>
	
</html>