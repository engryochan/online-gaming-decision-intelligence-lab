      CONNEXOR</nobr>-Benutzernamen und Ihr Passwort ein:
      </p><div data-dojo-type="dijit/TitlePane" class="mpulse_theme " style="width:500;" title="Login"><div data-dojo-type="dijit/form/Form" id="loginForm" style="visibility:hidden;" dojo-version="latest" method="POST" action="login-user" name="N100FA"><input type="hidden" name="viewFrom" value="viewLOGIN"/><input type="hidden" name="cugname" value="ibl"/><input type="hidden" name="forward" value="profile_de.html"/><input type="hidden" name="referer" value="/termsheetapp/issuers/services/connexor/ibt2/login_de.html"/><table class="form-grid" cellspacing="0" cellpadding="0" border="0" width="100%"><tr><td width="15%"><img src="/resources/images/trans@mui2g1h4.png" height="1" width="1" border="0" hspace="0" vspace="0"/></td><td width="60%"><img src="/resources/images/trans@mui2g1h4.png" height="1" width="1" border="0" hspace="0" vspace="0"/></td><td width="25%"><img src="/resources/images/trans@mui2g1h4.png" height="1" width="1" border="0" hspace="0" vspace="0"/></td></tr><tr class="form-grid"><td class="first" colspan="2" align="left" valign="top"><span style="color:red">&nbsp;
        </span></td></tr><tr class="ip-middle"><td><span class="label">Benutzer</span></td><td><input name="username" value="" data-dojo-type="dijit/form/ValidationTextBox" id="username" class="mpulse_theme" regexp=".{0,80}" type="text" style="width: 262px;" maxlength="80" autocomplete="on"/></td><td>&nbsp;</td></tr><tr class="ip-middle"><td><span class="label">Passwort</span></td><td><input name="password" value="" data-dojo-type="dijit/form/ValidationTextBox" id="password" class="mpulse_theme" regexp=".{0,80}" type="password" style="width: 262px;" maxlength="80" autocomplete="off"/></td><td>&nbsp;</td></tr><tr class="ip-middle"><td class="first" colspan="2" align="left" valign="top">&nbsp;</td><td class="" align="left" valign="top"><a href="/issuers/services/connexor/ibt2/reset_password.html">Passwort vergessen?</a></td></tr><tr class="form-grid"><td class="first" align="left" valign="top"><img border="0" hspace="0" vspace="0" src="/resources/images/trans@mui2g1h4.png" height="10" width="0"/></td></tr><tr class="ip-middle"><td class="first" align="left" valign="top"><a href="#" onclick="resetForm();return false;">Eingaben l&ouml;schen</a></td><td align="right"><input type="submit" name="actionSUBMIT" id="actionSUBMIT" style="position:absolute;bottom:0px;left:0px;visibility:hidden;"/><div data-dojo-type="dijit/form/Button" id="actionSUBMITProxyN65796" class="mpulse_theme">Login<script type="dojo/connect" event="onClick">
    function setLabelDecoration(widgetId, valid) {
      require(["dojo/dom", "dojo/domReady!"],
        function(dom) {
          const label = dom.byId("label_" + widgetId);
          if (label == null) {
            return;
          } else if (valid) {
            if (label.className === "form-label-invalid" || label.className === "form-label-bad") {
              label.className = "form-label";
            }
          } else if (label.className === "form-label") {
            label.className = "form-label-invalid";
          }
        }
      );
    }
  
        require(["dojo/dom", "dijit/registry", "dojo/domReady!"],
          function(dom, registry) {
            const button = dom.byId("actionSUBMITProxyN65796");
            const formNode = dom.byId("loginForm");
            button.disable = true;
            let formValid = true;
            Array.from(formNode.elements).forEach(function(element, i) {
              const widget = registry.byId(element.id);
              if (element.type === "textarea") {
                if (element.attributes.getNamedItem("required").nodeValue) {
                  const regExp = element.attributes.getNamedItem("regexp").nodeValue;
                  const widgetValid = new RegExp(regExp).test(element.value);
                  if (!widgetValid) formValid = false;
                  setLabelDecoration(element.name, widgetValid);
                }
              } else if (widget == null) {
                // nothing to do
              } else if (widget.type === "button") {
                // nothing to do
              } else if (widget.type === "radio" || widget.type === "checkbox") {
                const required = new RegExp(".*required{1}").test(widget.id);
                if (required) {
                  let checked = false;
                  const siblings = document.getElementsByName(widget.name);
                  Array.from(siblings).forEach(function(sibling) {
                    checked = checked || sibling.checked;
                  });
                  if (!checked) formValid = false;
                }
                setLabelDecoration(widget.name, !required || checked);
              } else {
                const widgetValid = widget.isValid();
                if (!widgetValid) formValid = false;
                setLabelDecoration(widget.name, widgetValid);
              }
            });
            if (formValid) {
              dom.byId("actionSUBMIT").click();
            } else {
              button.disable = false;
            }
          }
        );
      </script></div></td><td class="" align="left" valign="top">&nbsp;</td></tr></table><script>
        require(["dojo/dom-style", "dojo/domReady!"],
