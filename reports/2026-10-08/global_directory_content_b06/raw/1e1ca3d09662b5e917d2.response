 color: #4C214D !important;
 font-style: normal;
 font-family: "Titillium Web";
 font-weight: 600;
}
.header_top, .fixed_top_header .top_header {
 padding: 10px 63px 0 0; 
}
/*  LATEST NEWS PAGE */
.page-news-card {
 font-family: "Titillium Web";
}
.page-news-card h5.latest_post_two_title.entry_title {
 color: #033F72; 
 font-size: 24px;
 font-weight: 600;
 text-transform: capitalize;
}
.page-news-card p.latest_post_two_excerpt {
 color: #636363; 
 font-size: 18px;
 font-weight: 400;
 line-height: 27px;
}
.page-news-sidebar {
 font-family: "Titillium Web";
}
.page-news-sidebar h6.latest_post_title.entry_title, .page-news-sidebar a {
 font-size: 16px;
 text-transform: none;
 font-weight: 500;
 color: #033F72;
}
.page-news-sidebar h6.latest_post_title.entry_title::before {
 content: ' \25BA';
 margin-right: 10px;
 font-size: 13px;
}
.side_menu_button_wrapper { margin-top: -4px; }
/* page breadcrumb */
.page-breadcrumb span.current-item { color: #fff; }
.page-breadcrumb a.home, .page-breadcrumb .navxt-arrow-right { color: #FFFFFF80;}
/* Wpform */
.wpform-contactform-field {
 font-family: "Montserrat" !important;
 padding: 12px 0 !important;
}
.wpform-contactform-field input, .wpform-contactform-field-email input { 
 border-radius: 2px !important; 
 border-bottom: 2px solid #9897A9 !important;
 height: 40px !important;
} 
.wpform-contactform-field label, .wpform-contactform-field-email label {
 font-size: 15px !important;
 font-weight: bold !important;
}
.wpforms-field-limit-text {
 color: #7A4F7B;
}
.wpforms-confirmation-container-full{
 color: #006644 !important;
 font-weight: 500!important;
}
.wpforms-form label.wpforms-error{
color:#FD5757!important;
 font-size: 14px !important;
 font-weight:500 !important;
}
.wpforms-error {
color:#FD5757!important;
}
.wpforms-field input.wpforms-error{
 border-width: 0 0 2px 1!important;
 border-color: #FD5757!important;
}
button.wpform-contactform-button {
