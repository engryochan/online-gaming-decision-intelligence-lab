/*# sourceURL=global-styles-inline-css */ </style> <style id="admin-bar-inline-css"> /* Hide CanvasJS credits for P404 charts specifically */
 #p404RedirectChart .canvasjs-chart-credit {
 display: none !important;
 } 
 #p404RedirectChart canvas {
 border-radius: 6px;
 }
 .p404-redirect-adminbar-weekly-title {
 font-weight: bold;
 font-size: 14px;
 color: #fff;
 margin-bottom: 6px;
 }
 #wpadminbar #wp-admin-bar-p404_free_top_button .ab-icon:before {
 content: "\f103";
 color: #dc3545;
 top: 3px;
 } 
 #wp-admin-bar-p404_free_top_button .ab-item {
 min-width: 80px !important;
 padding: 0px !important;
 } 
 /* Ensure proper positioning and z-index for P404 dropdown */
 .p404-redirect-adminbar-dropdown-wrap { 
 min-width: 0; 
 padding: 0;
 position: static !important;
 } 
 #wpadminbar #wp-admin-bar-p404_free_top_button_dropdown {
 position: static !important;
 } 
 #wpadminbar #wp-admin-bar-p404_free_top_button_dropdown .ab-item {
 padding: 0 !important;
 margin: 0 !important;
 } 
 .p404-redirect-dropdown-container {
 min-width: 340px;
 padding: 18px 18px 12px 18px;
 background: #23282d !important;
 color: #fff;
 border-radius: 12px;
 box-shadow: 0 8px 32px rgba(0,0,0,0.25);
 margin-top: 10px;
 position: relative !important;
 z-index: 999999 !important;
 display: block !important;
 border: 1px solid #444;
 } 
 /* Ensure P404 dropdown appears on hover */
 #wpadminbar #wp-admin-bar-p404_free_top_button .p404-redirect-dropdown-container { 
 display: none !important;
 } 
 #wpadminbar #wp-admin-bar-p404_free_top_button:hover .p404-redirect-dropdown-container { 
 display: block !important;
 } 
 #wpadminbar #wp-admin-bar-p404_free_top_button:hover #wp-admin-bar-p404_free_top_button_dropdown .p404-redirect-dropdown-container {
 display: block !important;
 } 
 .p404-redirect-card {
 background: #2c3338;
 border-radius: 8px;
 padding: 18px 18px 12px 18px;
 box-shadow: 0 2px 8px rgba(0,0,0,0.07);
 display: flex;
 flex-direction: column;
 align-items: flex-start;
 border: 1px solid #444;
 } 
 .p404-redirect-btn {
 display: inline-block;
 background: #dc3545;
 color: #fff !important;
 font-weight: bold;
 padding: 5px 22px;
 border-radius: 8px;
 text-decoration: none;
 font-size: 17px;
 transition: background 0.2s, box-shadow 0.2s;
 margin-top: 8px;
 box-shadow: 0 2px 8px rgba(220,53,69,0.15);
 text-align: center;
 line-height: 1.6;
 } 
 .p404-redirect-btn:hover {
 background: #c82333;
 color: #fff !important;
 box-shadow: 0 4px 16px rgba(220,53,69,0.25);
 } 
 /* Prevent conflicts with other admin bar dropdowns */
 #wpadminbar .ab-top-menu > li:hover > .ab-item,
 #wpadminbar .ab-top-menu > li.hover > .ab-item {
 z-index: auto;
 } 
 #wpadminbar #wp-admin-bar-p404_free_top_button:hover > .ab-item {
 z-index: 999998 !important;
 } 
 .canvasjs-chart-credit{
 display: none !important;
 }
 #vtrtsFreeChart canvas {
 border-radius: 6px;
}
.vtrts-free-adminbar-weekly-title {
 font-weight: bold;
 font-size: 14px;
 color: #fff;
 margin-bottom: 6px;
}
 #wpadminbar #wp-admin-bar-vtrts_free_top_button .ab-icon:before {
 content: "\f185";
 color: #1DAE22;
 top: 3px;
 }
 #wp-admin-bar-vtrts_pro_top_button .ab-item {
 min-width: 180px;
 }
 .vtrts-free-adminbar-dropdown {
 min-width: 420px ;
 padding: 18px 18px 12px 18px;
 background: #23282d;
 color: #fff;
 border-radius: 8px;
 box-shadow: 0 4px 24px rgba(0,0,0,0.15);
 margin-top: 10px;
 }
 .vtrts-free-adminbar-grid {
 display: grid;
 grid-template-columns: 1fr 1fr;
 gap: 18px 18px; /* row-gap column-gap */
 margin-bottom: 18px;
 }
 .vtrts-free-adminbar-card {
 background: #2c3338;
 border-radius: 8px;
 padding: 18px 18px 12px 18px;
 box-shadow: 0 2px 8px rgba(0,0,0,0.07);
 display: flex;
 flex-direction: column;
 align-items: flex-start;
 }
 /* Extra margin for the right column */
 .vtrts-free-adminbar-card:nth-child(2),
 .vtrts-free-adminbar-card:nth-child(4) {
 margin-left: 10px !important;
 padding-left: 10px !important;
 padding-top: 6px !important;
 margin-right: 10px !important;
 padding-right : 10px !important;
 margin-top: 10px !important;
 }
 .vtrts-free-adminbar-card:nth-child(1),
 .vtrts-free-adminbar-card:nth-child(3) {
 margin-left: 10px !important;
 padding-left: 10px !important;
 padding-top: 6px !important;
 margin-top: 10px !important;
 padding-right : 10px !important;
 }
 /* Extra margin for the bottom row */
 .vtrts-free-adminbar-card:nth-child(3),
 .vtrts-free-adminbar-card:nth-child(4) {
 margin-top: 6px !important;
 padding-top: 6px !important;
 margin-top: 10px !important;
 }
 .vtrts-free-adminbar-card-title {
 font-size: 14px;
 font-weight: 800;
 margin-bottom: 6px;
 color: #fff;
 }
 .vtrts-free-adminbar-card-value {
 font-size: 22px;
 font-weight: bold;
 color: #1DAE22;
 margin-bottom: 4px;
 }
 .vtrts-free-adminbar-card-sub {
 font-size: 12px;
 color: #aaa;
 }
 .vtrts-free-adminbar-btn-wrap {
 text-align: center;
 margin-top: 8px;
 }
 #wp-admin-bar-vtrts_free_top_button .ab-item{
 min-width: 80px !important;
 padding: 0px !important;
 .vtrts-free-adminbar-btn {
 display: inline-block;
 background: #1DAE22;
 color: #fff !important;
 font-weight: bold;
 padding: 8px 28px;
 border-radius: 6px;
 text-decoration: none;
 font-size: 15px;
 transition: background 0.2s;
 margin-top: 8px;
 }
 .vtrts-free-adminbar-btn:hover {
 background: #15991b;
 color: #fff !important;
 }
 .vtrts-free-adminbar-dropdown-wrap { min-width: 0; padding: 0; }
 #wpadminbar #wp-admin-bar-vtrts_free_top_button .vtrts-free-adminbar-dropdown { display: none; position: absolute; left: 0; top: 100%; z-index: 99999; }
 #wpadminbar #wp-admin-bar-vtrts_free_top_button:hover .vtrts-free-adminbar-dropdown { display: block; } 
 .ab-empty-item #wp-admin-bar-vtrts_free_top_button-default .ab-empty-item{
 height:0px !important;
 padding :0px !important;
 }
 #wpadminbar .quicklinks .ab-empty-item{
 padding:0px !important;
 }
 .vtrts-free-adminbar-dropdown {
 min-width: 420px;
 padding: 18px 18px 12px 18px;
 background: #23282d;
 color: #fff;
 border-radius: 12px; /* more rounded */
 box-shadow: 0 8px 32px rgba(0,0,0,0.25); /* deeper shadow */
 margin-top: 10px;
}
.vtrts-free-adminbar-btn-wrap {
 text-align: center;
 margin-top: 18px; /* more space above */
}
.vtrts-free-adminbar-btn {
 display: inline-block;
 background: #1DAE22;
 color: #fff !important;
 font-weight: bold;
 padding: 5px 22px;
 border-radius: 8px;
 text-decoration: none;
 font-size: 17px;
 transition: background 0.2s, box-shadow 0.2s;
 margin-top: 8px;
 box-shadow: 0 2px 8px rgba(29,174,34,0.15);
 text-align: center;
 line-height: 1.6; 
}
.vtrts-free-adminbar-btn:hover {
 background: #15991b;
 color: #fff !important;
 box-shadow: 0 4px 16px rgba(29,174,34,0.25);
}  /*# sourceURL=admin-bar-inline-css */ </style><link rel='stylesheet' id='buttonizer-icon-library-css' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css?ver=c0a5b319481ce4fefeef01639e6dcff4' media='all' integrity='sha512-1ycn6IcaQQ40/MKBW2W4Rhis/DbILU74C1vSrLJxCq57o941Ym01SwNsOMqvEBFlcgUa6xLiPY/NS5R+E6ztJQ==' crossorigin='anonymous' /> <style id="bridge-stylesheet-inline-css"> .page-id-5196.disabled_footer_top .footer_top_holder, .page-id-5196.disabled_footer_bottom .footer_bottom_holder { display: none;}  /*# sourceURL=bridge-stylesheet-inline-css */ </style> <style id="bridge-style-dynamic-responsive-inline-css"> .page-breadcrumb span.current-item { color: #9897A9; }
.page-breadcrumb a.home, .page-breadcrumb .navxt-arrow-right { color: #813882;  }
.carousel-indicators {
 bottom: 20% !important;
}
.qode_slide-svg-holder {
 width: 50% !important;
 margin-left: auto !important;
 margin-right: auto !important;
}  /*CSS by Mara*/
#submit_comment  {
 background-color: #fff;
 font-family: montserrat,sans-serif;
 border-color: #4C214D;
text-align: left!important;
}
#submit_comment:hover {
 background-color: #4C214D;
 color: #fff;
 font-family: montserrat,sans-serif;
 border-color: #4C214D;
text-align: left!important;
}
div.comment_form form p.form-submit {
 margin: 0;
 text-align: left;
}
#breadcrumbs {
 font-size: 14px!important;
}
.breadcrumb_last {
 color: #9897A9!important;
}
#breadcrumbs a {
 font-weight:600;
 color: #813882;
}
/*Data Table*/
td {
 vertical-align: middle;
}
.td-content a {
 font-size: 14px;
 display: flex;
 align-items: center;
}
/*TablePress*/
.tablepress th {
 color: #fff!important;
 padding: 0 20px;
}
.registered-token td, .registered-token th {
 text-align: center!important;
}
.registered-token td.column-6 {
 font-size: 13px!important;
}
.tablepress thead th {
 background-color: #4c214d!important;
}
.tablepress .sorting:hover, .tablepress .sorting_asc, .tablepress .sorting_desc {
 background-color: #4c214d;
}
.tablepress .sorting, .tablepress tbody td, .tablepress tfoot th {
 padding: 10px 20px;
}
.tablepress tbody {
 border: 1px solid #ddd;
}
.tablepress tbody td, .tablepress tfoot th {
 border-top: none;
 border-bottom: 1px solid #ddd;
}
.tablepress td, .tablepress a {
 color: #333333;
 font-family: "Montserrat", Sans-serif;
 font-size: 14px;
 font-weight: 500;
}
.tablepress a:hover {
 color:#813882;
}
/*TOKEN DISPUTE*/
.token-dispute td, .token-dispute th {
 text-align: center!important;
}
.token-dispute td, .token-dispute th {
 font-size: 12px;
}  /*Cookie banner*/
#cookie-law-info-bar[data-cli-style="cli-style-v2"] {
 padding: 20px;
}
.cli-tab-container h4, .cli-tab-container h1 {
 font-family: inherit;
 font-size: 24px;
 font-weight: bold;
 margin-bottom: 15px;
 margin: 10px 0px;
 color: #4C214D;
}
a.cli-privacy-readmore {
 margin-top: 12px;
 display: inline-block;
 padding-bottom: 0;
 cursor: pointer;
 color: #4C214D !important;
text-decoration: none;
}  .cli-tab-footer .wt-cli-privacy-accept-btn {
 background-color: #ffca80!important;
 font-weight:bold;
 color: #4C214D;
 border-radius: 4px;
}
.cli-tab-footer .wt-cli-privacy-accept-btn {
 background-color: #4C214D;
}  .cli-tab-header a.cli-nav-link {
 position: relative;
 display: flex;
 align-items: center;
 font-size: 16px;
 font-weight: 500;
 color: #333;
}
table.cookielawinfo-winter thead th {
 background: #4C214D!important; 
}
.cli-plugin-button, .cli-plugin-button:visited, .medium.cli-plugin-button, .medium.cli-plugin-button:visited{
 font-size: 14px;
 font-weight:700;
}
.cli_settings_button :hover{
background-color: #fff!important;
}
.q_icon_list .qode-ili-icon-holder.transparent, .q_icon_list i.transparent {
 color: #4C214D;
}
/*NEWS*/
.elementor-post__thumbnail{
 width: 100%;
 height: 100%;
 object-fit: contain;
}
.line-height .elementor-post__excerpt p{
 -webkit-line-clamp: 3;
 display: -webkit-box;
 -webkit-box-orient: vertical;
 overflow: hidden;
}
.line-height .elementor-post__title a {
 -webkit-line-clamp: 3;
 display: -webkit-box;
 -webkit-box-orient: vertical;
 overflow: hidden;
} 
.elementor-post__title a:hover{
 color:#813882!important;
}
.elementor-post-info__item--type-date{
 color: #666666;
 font-weight: 400!important;
}
.post-template-default.single.single-post ol {
 padding-inline-start: 20px !important;
}
.subscribe-newsletter-form .elementor-message {
 text-align: center;
}
/*BUTTONIZER*/
.buttonizer-label-0-0-13 {
font-size:12px!important;
background: none!important;
}
/*PAC POLL*/
.basic-yop-poll-container .basic-inner {
 padding: 0!important;
}
.bootstrap-yop h5, .bootstrap-yop h6 {
 line-height: 1.4!important;
}
.bootstrap-yop label {
 display: flex!important;
 align-items: baseline!important;
}
.basic-yop-poll-container a.basic-vote-button {
 padding: 10px 20px!important;
}
.basic-vote {
 margin: 0!important;
}
.bootstrap-yop .text-center {
 text-align: right!important;
 color:#9897A9;
 font-size: 14px;
}
.basic-answer input {
 margin: 0px;
}
.basic-yop-poll-container ul.basic-answers{
padding-top: 0px;
}
.basic-question {
 margin-top: 10px!important;
}
.basic-answer {
 margin-top: 0px; 
 margin-bottom: 5px;
}
.progress-bar{
background-color:#FDC372!important;
}
.basic-answers-results .progress{
margin:0!important;
}
.basic-message {
 background-color: #603362!important;
}
.basic-stats {
margin:0!important;
}
.bootstrap-yop a:hover{
background: #fff!important;
}
.bootstrap-yop input {
 -webkit-appearance: none;
 -moz-appearance: none;
 appearance: none;
 border-radius: 50%;
 width: 20px;
 height: 20px;
 border: 2px solid #FDC372;
 transition: 0.2s all linear;
 margin-right: 5px;
 position: relative;
 top: 4px;
}
.bootstrap-yop input:checked {
 border: 6px solid #FDC372;
 outline: unset !important /* I added this one for Edge (chromium) support */
}
.basic-yop-poll-container .basic-custom-field textarea.basic-input-text {
 width: 100% !important;
}
/*LOGIN PATH HOVER EFFECT
.login-btn:hover .elementor-widget-wrap{
 background-color: #4C214D;
}
.login-btn:hover  .element p {
 color: #fff;
}
.login-btn:hover .svg-icon {
 filter: invert(100%) sepia(3%) saturate(0%) hue-rotate(243deg) brightness(103%) contrast(106%);
}
*/
/*Elementor Clickable Column*/
.pointer {
cursor: pointer;
}
/*PAC Profile Page*/
.wpf-label{
 padding:5px 0px 5px!important;
 font-size: 14px!important;
}
.wpfcl-1 {
 color:#333!important;
}  .wpf-desc{
 padding-top: 5px !important;
 padding-bottom: 20px!important;
 line-height: 18px!important;
 font-size: 11px!important;
}
.wpf-label-wrap{
 padding-right: 30px!important;
}  /*WPFORM*/
div.wpforms-container-full .wpforms-form input.wpforms-field-medium, div.wpforms-container-full .wpforms-form select.wpforms-field-medium, div.wpforms-container-full .wpforms-form .wpforms-field-row.wpforms-field-medium {
 max-width: 100%!important;
}
.wpform-contactform-field label, .wpform-contactform-field-email label {
 font-weight: 800!important;
}
/*WPFORM*/
div.wpforms-container-full .wpforms-form input.wpforms-field-medium, div.wpforms-container-full .wpforms-form select.wpforms-field-medium, div.wpforms-container-full .wpforms-form .wpforms-field-row.wpforms-field-medium {
 max-width: 100%!important;
}
.wpform-contactform-field label, .wpform-contactform-field-email label {
 font-weight: 800!important;
}
/*MC4WP Form*/
.mc4wp-form-theme label {
font-size: 15px;
color: #333;
}
.mc4wp-form-theme button, .mc4wp-form-theme input[type=button], .mc4wp-form-theme input[type=submit] {
width: 100%!important;
}
.mc4wp-form-theme-dark input[type=submit] {
font-family: 'Montserrat';
 font-weight: bold;
 font-size: 15px;
 color: #4C214D!important;
 background-color: #FDC372!important;
 border: 0;
 margin-top: 20px;
}
.mc4wp-form-theme-dark input[type=submit]:hover {
 color: #4C214D!important;
 background-color: #fff!important;
 border: 2px solid #4C214D;
}
.mc4wp-form-theme input[type=text], .mc4wp-form-theme input[type=email]{
 margin: 0px 0px 15px;
 border-bottom: 2px solid #9897A9;
}
/*SCREEN*/
@media screen and (max-width: 1920px) and (min-width: 1400px) {
.cli-bar-container{
 width: 1200px;
}
}  /*Document Archive */ 
#wpdm-all-packages>div {
 border: none;
}
.wpdmdt-toolbar {
 display: flex;
 justify-content: space-between;
 flex-direction: row-reverse;
 padding-bottom: 10px !important;
}
input.form-control{
 width: 450px !important;
}
.wpdmdt-toolbarb {
 display: flex;
 justify-content: center !important;
}
.dataTables_info {
 display: none !important;
}
.dataTables_filter > label {
 color: #333;
 font: normal normal 500 15px/19px Montserrat !important;
 opacity: .8;
}
.dataTables_filter > label > input {
 border: 1px solid #A09F9F !important;
 border-radius: 4px !important;
 height: 45px !important;
}
.dataTables_length > label {
 color: #333333;
 font: normal normal 500 15px/19px Montserrat !important; 
 opacity: .8;
}
.dataTables_length > label > select {
width: 65px !important;
}
ul.pagination > li.paginate_button.page-item.active > a {
 background: #4C214D !important;
 color: #fff !important;
}
ul.pagination > li.paginate_button.page-item.active > a:hover {
 background: #e9ecef !important;
 color:  #4C214D !important;
}
ul.pagination > li.paginate_button.page-item.disabled > a { 
 color: #666 !important;
 background: #e9ecef !important;
}
ul.pagination > li.paginate_button.page-item.disabled > a:hover { 
 color:  #666 !important;
 border: 1px solid rgba(0,0,0,.2) !important;
background: #e9ecef !important;
cursor: default !important;
}
