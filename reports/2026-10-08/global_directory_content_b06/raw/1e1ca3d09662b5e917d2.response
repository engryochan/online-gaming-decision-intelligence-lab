//# sourceURL=bridge-default-js-extra </script> <script id="bridge-default-js" src="https://dtif.org/wp-content/themes/bridge/js/default.min.js"></script> <script id="bridge-default-js-after"> //#region Form Validation
const body = jQuery("body");
function keydownNameValidation(e) {
 if (/[0-9a-zA-Z .-]/i.test(e.key)) {
 return true;
 }
 e.preventDefault();
}
function keyupNameValidation(e) {
 this.value = e.target.value.replace(/[^0-9a-zA-Z .-]/g, "");
}
function keydownEmailValidation(e) {
 if (/[0-9a-zA-Z @_.-]/i.test(e.key)) {
 return true;
 }
 e.preventDefault();
}
function keyupEmailValidation(e) {
 this.value = e.target.value.replace(/[^0-9a-zA-Z@_.-]/g, "");
}
function keydownScriptTagValidation(e) {
 if (/[<>]/i.test(e.key)) {
 e.preventDefault();
 }
 return true;
}
function keyupScriptTagValidation(e) {
 this.value = e.target.value.replace(/[<>]/g, "");
}
function keyupScriptTagPasswordValidation(e) {
 this.value = e.target.value.replace(/\s/g, "").replace(/[<>]/g, "");
}
// PAC Form
const pacUsername = jQuery('input[name="log"]'),
 pacPassword = jQuery('input[name="pwd"]');
pacUsername.keydown(keydownEmailValidation);
pacUsername.keyup(keyupEmailValidation);
pacPassword.keydown(keydownScriptTagValidation);
pacPassword.keyup(keyupScriptTagPasswordValidation);
// Contact Us Form (cu)
const cuSubject = jQuery("input#wpforms-709-field_12"),
 cuMessage = jQuery("textarea#wpforms-709-field_2");
cuSubject.keydown(keydownScriptTagValidation);
cuSubject.keyup(keyupScriptTagValidation);
cuMessage.keydown(keydownScriptTagValidation);
cuMessage.keyup(keyupScriptTagValidation);
// Premiun Download Interest Form
body.on("keydown", 'input[name="FNAME"]', keydownNameValidation);
body.on("keydown", 'input[name="LNAME"]', keydownNameValidation);
body.on("keydown", 'input[name="EMAIL"]', keydownEmailValidation);
body.on("keyup", 'input[name="FNAME"]', keyupNameValidation);
body.on("keyup", 'input[name="LNAME"]', keyupNameValidation);
body.on("keyup", 'input[name="EMAIL"]', keyupEmailValidation);
// Register Your Interest (RYI) Form
body.on("keydown", "input#wpforms-1816-field_0", keydownNameValidation);
body.on("keydown", "input#wpforms-1816-field_0-last", keydownNameValidation);
body.on("keydown", "input#wpforms-1816-field_1", keydownEmailValidation);
body.on("keydown", "input#wpforms-1816-field_4", keydownScriptTagValidation);
body.on("keydown", "input#wpforms-1816-field_3", keydownScriptTagValidation);
body.on("keyup", "input#wpforms-1816-field_0", keyupNameValidation);
body.on("keyup", "input#wpforms-1816-field_0-last", keyupNameValidation);
body.on("keyup", "input#wpforms-1816-field_1", keyupEmailValidation);
body.on("keyup", "input#wpforms-1816-field_4", keyupScriptTagValidation);
body.on("keyup", "input#wpforms-1816-field_3", keyupScriptTagValidation);
//#endregion Form Validation
////////////////////////
// Dynamic Count of Tokens
///////////////////////
// dev-url🔗 = `https://5c1obvagzl.execute-api.ap-southeast-1.amazonaws.com/dev/tokens/count`,
// dev-api-key🔑 = `Y2IhMFKjph2PxX1zCJwDt9O7Gfh7XkYa8AMKe9o9`
// prod-url🔗 = `https://w4s480rxn1.execute-api.ap-southeast-1.amazonaws.com/ext/tokens/count`,
// prod-api-key🔑 = `r0GeYEHpv56tcs3tEoTFD50vwaGfD01z3oX0xsce`
const strDate = (new Date()).toLocaleDateString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric' }),
 localStorageKey = `token-counts/${strDate}`,
 objTokenCounts = JSON.parse(localStorage.getItem(localStorageKey));
// maybe outdated tokens-count💰 or nothing at all.
if (!objTokenCounts) {
 const baseProd = `https://w4s480rxn1.execute-api.ap-southeast-1.amazonaws.com/ext`,
 prodKey = `r0GeYEHpv56tcs3tEoTFD50vwaGfD01z3oX0xsce`,
 baseDev = `https://5c1obvagzl.execute-api.ap-southeast-1.amazonaws.com/dev`,
 devKey = `Y2IhMFKjph2PxX1zCJwDt9O7Gfh7XkYa8AMKe9o9`,
 url = `${baseProd}/tokens/count`,
 headers = { 'x-api-key': prodKey },
 settings = { url, headers };
 jQuery.get(settings, ({ data }) => {
 removePreviousTokensCount();
 setTokenCounts(data);
 localStorage.setItem(localStorageKey, JSON.stringify(data));
 // TODO: need to clear existing token counts in localStorage.
 });
} else {
 setTokenCounts(objTokenCounts);
}
// setting Object details
function setTokenCounts({ tokensCount, auxilliariesCount, nativesCount, fungiblesCount }) {
 // Slider(2) Revolution
 const slider2 = jQuery('#slider-1-slide-3-layer-3'),
 sliderText = `${tokensCount} ${slider2.text().substr(4)}`,
 // Footer details
 footer = jQuery('div#footer-tokens-details > div.elementor-widget-container > h2'),
 footerText = `${tokensCount} ${footer.text().substr(4)}`,
 //Registry Search Footer details
 footerRS = jQuery('div#rs-footer-tokens-details > div.elementor-widget-container > h2');
 footerRSText = `${tokensCount} ${footerRS.text().substr(4)}`;
 slider2.text(sliderText);
 footer.text(footerText);
 footerRS.text(footerRSText);
 let tokensLastValue = jQuery('div.qodef-m-digit').first().text();
 const changeTokens = setInterval(() => {
 const uniqueTokens = jQuery('div.qodef-m-digit').first().text();
 if (tokensLastValue !== uniqueTokens || !(+uniqueTokens)) {
 tokensLastValue = uniqueTokens;
 } else {
 jQuery('div.qodef-m-digit').first().text(tokensCount);
 clearInterval(changeTokens);
 }
 }, 300);
 // Auxilliary Count
 let elAuxiliary = jQuery('div.qodef-m-digit:eq(1)'),
 auxiliaryLastValue = elAuxiliary.text(),
 changeAuxiliary = setInterval(() => {
 const auxiliaryNum = elAuxiliary.text();
 if (auxiliaryLastValue !== auxiliaryNum || !(+auxiliaryNum)) {
 auxiliaryLastValue = auxiliaryNum;
 } else {
 elAuxiliary.text(auxilliariesCount);
 clearInterval(changeAuxiliary);
 }
 }, 300);
 // Auxilliary Count
 let elNative = jQuery('div.qodef-m-digit:eq(2)'),
 nativeLastValue = elNative.text(),
 changeNative = setInterval(() => {
 const nativeNum = elNative.text();
 if (nativeLastValue !== nativeNum || !(+nativeNum)) {
 nativeLastValue = nativeNum;
 } else {
 elNative.text(nativesCount);
 clearInterval(changeNative);
 }
 }, 200);
 // Fungible Count
 let elFungible = jQuery('div.qodef-m-digit:eq(3)'),
 fungibleLastValue = elFungible.text(),
 changeFungible = setInterval(() => {
 const fungibleNum = elFungible.text();
 if (fungibleLastValue !== fungibleNum || !(+fungibleNum)) {
 fungibleLastValue = fungibleNum;
 } else {
 elFungible.text(fungiblesCount);
 clearInterval(changeFungible);
 }
 }, 200);
}
// remove existing token
function removePreviousTokensCount() {
 Object.keys(localStorage).forEach(s => {
 if (s.indexOf(`token-counts/`) > -1) {
 localStorage.removeItem(s);
 }
 });
}
