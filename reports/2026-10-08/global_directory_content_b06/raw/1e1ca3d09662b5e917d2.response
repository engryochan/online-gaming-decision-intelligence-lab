t elementor-widget-image" data-id="5325094" data-element_type="widget" data-e-type="widget" data-widget_type="image.default"><div class="elementor-widget-container"> <img loading="lazy" decoding="async" data-src="https://dtif.org/wp-content/uploads/2025/02/crypto-1.svg" width="115" height="96" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" class="attachment-full size-full wp-image-20479 lazyload" alt="" /><noscript><img loading="lazy" decoding="async" width="115" height="96" src="https://dtif.org/wp-content/uploads/2025/02/crypto-1.svg" class="attachment-full size-full wp-image-20479" alt=""></noscript></div></div><div class="elementor-element elementor-element-fe5515f elementor-widget elementor-widget-heading" data-id="fe5515f" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default"><div class="elementor-widget-container"><h5 class="elementor-heading-title elementor-size-default">Who we are</h5></div></div><div class="elementor-element elementor-element-cc398de elementor-widget elementor-widget-text-editor" data-id="cc398de" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"><div class="elementor-widget-container"><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}"><span data-usefontface="true" data-contrast="none">DTIF is a non-profit division of </span><span data-usefontface="true" data-contrast="none">Etrading</span> <span data-usefontface="true" data-contrast="none">Software, a financial technology firm</span>​ <span data-usefontface="true" data-contrast="none">with a mission of solving market-wide </span><span data-usefontface="true" data-contrast="none">problems by building market </span><span data-usefontface="true" data-contrast="none">infrastructures for the new digital</span>​ <span data-usefontface="true" data-contrast="none">economy.</span></p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}"> </p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}">Etrading Software is the Registration Authority for ISO 24165, responsible for issuing and maintaining DTIs via the DTI Foundation.</p></div></div><div class="elementor-element elementor-element-d8fc751 elementor-align-center elementor-widget elementor-widget-button" data-id="d8fc751" data-element_type="widget" data-e-type="widget" data-widget_type="button.default"><div class="elementor-widget-container"><div class="elementor-button-wrapper"> <a class="elementor-button elementor-button-link elementor-size-sm" href="https://dtif.org/dti-foundation/"> <span class="elementor-button-content-wrapper"> <span class="elementor-button-text">Read more</span> </span> </a></div></div></div></div></div><div class="elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-3d70e13" data-id="3d70e13" data-element_type="column" data-e-type="column"><div class="elementor-widget-wrap elementor-element-populated"><div class="elementor-element elementor-element-458942a elementor-widget elementor-widget-image" data-id="458942a" data-element_type="widget" data-e-type="widget" data-widget_type="image.default"><div class="elementor-widget-container"> <img loading="lazy" decoding="async" data-src="https://dtif.org/wp-content/uploads/2025/02/governance.svg" width="115" height="96" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" class="attachment-full size-full wp-image-20507 lazyload" alt="" /><noscript><img loading="lazy" decoding="async" width="115" height="96" src="https://dtif.org/wp-content/uploads/2025/02/governance.svg" class="attachment-full size-full wp-image-20507" alt=""></noscript></div></div><div class="elementor-element elementor-element-e4a2e49 elementor-widget elementor-widget-heading" data-id="e4a2e49" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default"><div class="elementor-widget-container"><h5 class="elementor-heading-title elementor-size-default">Our Governance</h5></div></div><div class="elementor-element elementor-element-5ec6102 elementor-widget elementor-widget-text-editor" data-id="5ec6102" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"><div class="elementor-widget-container"><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}"><span data-usefontface="true" data-contrast="none">DTIF issues and maintains DTIs on a non-</span><span data-usefontface="true" data-contrast="none">profit, cost-recovery model.</span><span data-usefontface="false" data-contrast="none"> DTIF</span> <span data-usefontface="false" data-contrast="none">follows </span><span data-usefontface="false" data-contrast="none">strict ISO governance requirements and </span><span data-usefontface="false" data-contrast="none">follows FRAND (fair, reasonable, and non-</span><span data-usefontface="false" data-contrast="none">discriminatory) principles for cost-recovery </span><span data-usefontface="false" data-contrast="none">fees</span><span data-usefontface="false" data-contrast="none">. A Product Advisory Committee </span><span data-usefontface="false" data-contrast="none">oversees DTIF’s implementation of the ISO </span><span data-usefontface="false" data-contrast="none">standard. </span>​</p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}">​</p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}"><span data-usefontface="true" data-contrast="none">The DTI is open and may be freely </span><span data-usefontface="true" data-contrast="none">reproduced, distributed, transmitted, or </span><span data-usefontface="true" data-contrast="none">otherwise used by anyone for any purpose, </span><span data-usefontface="true" data-contrast="none">commercial or non-commercial at no cost.</span></p></div></div><div class="elementor-element elementor-element-0ef316f elementor-align-center elementor-widget elementor-widget-button" data-id="0ef316f" data-element_type="widget" data-e-type="widget" data-widget_type="button.default"><div class="elementor-widget-container"><div class="elementor-button-wrapper"> <a class="elementor-button elementor-button-link elementor-size-sm" href="https://dtif.org/governance/"> <span class="elementor-button-content-wrapper"> <span class="elementor-button-text">Read more</span> </span> </a></div></div></div></div></div><div class="elementor-column elementor-col-33 elementor-inner-column elementor-element elementor-element-3366a79" data-id="3366a79" data-element_type="column" data-e-type="column"><div class="elementor-widget-wrap elementor-element-populated"><div class="elementor-element elementor-element-5d138f0 elementor-widget elementor-widget-image" data-id="5d138f0" data-element_type="widget" data-e-type="widget" data-widget_type="image.default"><div class="elementor-widget-container"> <img loading="lazy" decoding="async" data-src="https://dtif.org/wp-content/uploads/2025/02/rocket.svg" width="115" height="96" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7" class="attachment-full size-full wp-image-20506 lazyload" alt="" /><noscript><img loading="lazy" decoding="async" width="115" height="96" src="https://dtif.org/wp-content/uploads/2025/02/rocket.svg" class="attachment-full size-full wp-image-20506" alt=""></noscript></div></div><div class="elementor-element elementor-element-2de4c63 elementor-widget elementor-widget-heading" data-id="2de4c63" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default"><div class="elementor-widget-container"><h5 class="elementor-heading-title elementor-size-default">Our Vision​</h5></div></div><div class="elementor-element elementor-element-947e807 elementor-widget elementor-widget-text-editor" data-id="947e807" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default"><div class="elementor-widget-container"><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}"><span data-usefontface="true" data-contrast="none">DTIF’s mission is to provide the golden</span>​</p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}"><span data-usefontface="true" data-contrast="none">source reference data for the unique </span><span data-usefontface="true" data-contrast="none">identification of digital tokens.</span>​ <span data-usefontface="true" data-contrast="none">The unique identification </span></p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}"><span data-usefontface="true" data-contrast="none">of digital tokens </span><span data-usefontface="true" data-contrast="none">uses ISO’s new standard for digital assets, </span><span data-usefontface="true" data-contrast="none">ISO 24165.</span>​</p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}">​</p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}"><span data-usefontface="true" data-contrast="none">DTIF welcomes stakeholder engagement to </span><span data-usefontface="true" data-contrast="none">ensure the DTI standard remains fit for </span><span data-usefontface="true" data-contrast="none">purpose based on industry and regulatory </span><span data-usefontface="true" data-contrast="none">needs to reduce complexities, cut </span><span data-usefontface="true" data-contrast="none">operational costs, and improve transparency </span><span data-usefontface="true" data-contrast="none">across digital asset market. </span></p><p data-ccp-props="{&quot;335551550&quot;:2,&quot;335551620&quot;:2,&quot;335559683&quot;:0,&quot;335559685&quot;:0,&quot;335559731&quot;:0,&quot;335559737&quot;:0,&quot;335562764&quot;:2,&quot;335562765&quot;:1,&quot;335562766&quot;:4,&quot;335562767&quot;:0,&quot;335562768&quot;:4,&quot;335562769&quot;:0}">​</p></div></div><div class="elementor-element elementor-element-81715f6 elementor-align-center elementor-widget elementor-widget-button" data-id="81715f6" data-element_type="widget" data-e-type="widget" data-widget_type="button.default"><div class="elementor-widget-container"><div class="elementor-button-wrapper"> <a class="elementor-button elementor-button-link elementor-size-sm" href="https://dtif.org/vision/"> <span class="elementor-button-content-wrapper"> <span class="elementor-button-text">Read more</span> </span> </a></div></div></div></div></div></div></section></div></div></div></section><section class="elementor-section elementor-top-section elementor-element elementor-element-dd74c98 elementor-section-height-min-height elementor-section-boxed elementor-section-height-default elementor-section-items-middle parallax_section_no qode_elementor_container_no" data-id="dd74c98" data-element_type="section" data-e-type="section" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}"><div class="elementor-container elementor-column-gap-default"><div class="elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-a4bbed5" data-id="a4bbed5" data-element_type="column" data-e-type="column"><div class="elementor-widget-wrap elementor-element-populated"><section class="elementor-section elementor-inner-section elementor-element elementor-element-6349463 elementor-section-full_width elementor-section-height-default elementor-section-height-default pa