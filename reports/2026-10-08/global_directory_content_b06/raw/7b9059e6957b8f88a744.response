                <h3 class="text-black mb-4">Statistics</h3>
                
                <div class="mb-5">
                    
                    <div class="card border-0 mb-3">
    <div class="card-body">
        <form method="POST" action="https://informinvestor.cmda.gov.mv/admin/stats/export" accept-charset="UTF-8" id="stats-form"><input name="_token" type="hidden" value="XBwctXcLKEHKXH5HCEkgN86lgdoAhDeZEI6S0jWk">
        <div class="row">
    <div class="col-md-3">
        <div class="form-group">
            <div class="col-lg-4 mb-1">
                <label for="metric" class="form-label">Metric *</label>
            </div>
            
            <div class="col-md-12  mb-3">
                <select class="form-control select2-basic" data-allow-clear="true" data-placeholder="Nothing Selected" id="metric" name="metric"><option value="asset_cover_available">Asset Cover Available</option><option value="debt_equity_ratio">Debt Equity Ratio</option><option value="debt_service_coverage_ratio">Debt Service Coverage Ratio</option><option value="interest_service_coverage_ratio">Interest Service Coverage Ratio</option><option value="current_ratio">Current Ratio</option><option value="total_revenue">Total Revenue</option><option value="total_expenses">Total Expenses</option><option value="net_profit">Net Profit</option><option value="earnings_per_share">Earnings Per Share</option><option value="net_assets_per_share">Net Assets Per Share</option><option value="cash_flow_per_share">Cash Flow Per Share</option><option value="dividend_per_share">Dividend Per Share</option><option value="current_assets">Current Assets</option><option value="current_liabilities">Current Liabilities</option><option value="fixed_assets">Fixed Assets</option><option value="fixed_liabilities">Fixed Liabilities</option><option value="total_assets">Total Assets</option><option value="total_liabilities">Total Liabilities</option><option value="total_equity">Total Equity</option><option value="reserves">Reserves</option><option value="net_worth">Net Worth</option><option value="highest_traded_price">High Traded Price</option><option value="lowest_traded_price">Low Traded Price</option><option value="last_traded_price">Last Traded Price</option><option value="weighted_average_traded_price">Weighted Average Traded Price</option><option value="number_of_trades">Number of Trades</option><option value="number_of_shares_traded">Number of Shares Traded</option><option value="value_of_shares_traded">Value Of Shares Traded</option><option value="market_capitalisation">Market Capitalisation</option><option value="dividend_yield">Dividend Yield</option><option value="price_earnings_ratio">Price Earning Ratio</option></select>
                
                            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group">
            <div class="col-lg-4 mb-1">
                <label for="mode" class="form-label">Mode *</label>
            </div>
                        <div class="col-lg-12  mb-3">
                <select class="form-control select2-basic" data-allow-clear="true" data-placeholder="Nothing Selected" id="mode" name="mode"><option value="year" selected="selected">Year</option></select>
                            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group"
             data-enable-section-checkbox="#custom-date-range"
             data-disable="true"
        >
            <div class="col-lg-8 mb-1">
                <label for="date_range" class="form-label">Date Range *</label>
            </div>
                        <div class="col-lg-8  mb-3">
                <select class="form-control select2-basic" data-placeholder="Custom" id="date_range" name="date_range"><option value="this_year">This Year</option><option value="last_year">Last Year</option><option value="lifetime">Lifetime</option></select>
                            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mt-4 pt-3">
            <div class="checkbox">
                <input id="custom-date-range" class="form-check-input" name="custom_date_range" type="checkbox" value="1">
                <label for="custom-date-range" class="checkbox__label">Custom Date Range</label>
            </div>
                    </div>
    </div>
</div>

<div class="row  mt-3"
     data-enable-section-checkbox="#custom-date-range"
     data-hide-fields="true"
>
    <div class="col-md-6">
        <div class="form-group">
            <div class="col-lg-4 mb-1">
