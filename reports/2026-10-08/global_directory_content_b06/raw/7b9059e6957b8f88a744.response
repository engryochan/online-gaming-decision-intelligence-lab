<!-- Material Admin JS -->
<!-- Custom JS-->
<script src="/js/vendors.js?id=ba9c19bb01e6ad34e694"></script>
<script src="https://informinvestor.cmda.gov.mv/js/apexcharts.min.js"></script>
<script src="https://informinvestor.cmda.gov.mv/js/select2-custom.js"></script>
