ing CDRs","stocklists":"Related Stocklists","news":"News","optionsTrading":"Options Trading","faq":"FAQ","education":"CDR Education","options":"CDR Options"},"landing":{"relatedStocklist":"Related Stocklists","title":"TSX CDR Centre | TMX Money","stocklistTitle":"Comprehensive CDRs List","viewScreener":"View Stock Screener"},"stocklists":{"topPerforming":"Top Performing CDRs","topPerformingDesc":"The best performing Canadian Depositary Receipts over the past 30 days.","topCdrPerformers":"Top CDR Performers","topCdrPerformersDesc":"The best performing Canadian Depositary Receipts based on recent market performance.","cdr30Day":"CDR 30-Day Movers","cdr30DayDesc":"Canadian Depositary Receipts with significant price movement over 30 days.","recentCDRs":"Recently Listed CDRs","recentCDRsDesc":"The most recently added Canadian Depositary Receipts to the TSX.","cdrDividend":"CDR Dividend Payers","cdrDividendDesc":"Canadian Depositary Receipts that pay dividends to investors.","cdrList":"CDR List","cdrListDesc":"A comprehensive list of Canadian Depositary Receipts available for trading."},"faq":{"title":"CDR FAQ"},"videos":{"title":"CDR Centre Video"},"education":{"learnMore":"Learn More"},"table":{"symbol":"Symbol","company":"Company","price":"Price","change":"Change","percentChange":"% Change","volume":"Volume","thirtyDayPriceChange":"30 Day Price Change"},"news":{"title":"News - The Companies Behind the CDRs","source":"(\u003ca\u003eNewsfile\u003c/a\u003e a TMX Group Company, via QuoteMedia)"},"options":{"title":"CDR Options","availableCdrsTitle":"Available CDRs for Options Trading"}},"Home":{"title":"TMX Money | TSX Today | Canadian Stock Market","metaDescr":"Get free real-time stock prices for the TSX today or use our premium investor tools to research your next investment on TSX, TSXV, or Alpha.","metaKeywords":"TMX Money, TSX, investment ideas, free real-time stock prices, free real time stock stock quotes, TSX Venture, stock prices, stock quotes, market movers, mome