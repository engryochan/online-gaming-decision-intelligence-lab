  <script src="/account/rsrc/lib/popup/jquery.magnific-popup.min.js"></script>
  <script>
    function loginBackend(response) {
      if (response.status === 'connected') {
        var accessToken = response.authResponse.accessToken;
        FB.api('/me?fields=id,name,email,birthday,gender,link', function(response) {
          response.accessToken = accessToken;
          $.post('/account/member/ajaxLogin', response, function(data) {
            if (data.login === 'OK') {
              window.location.replace("/account/favorite-report");
            } else if (data.login === 'SIGNUP') {
                window.location.replace("/account/signup");
            } else if ( data.login === 'NOACTIVE' ) {
                window.location.replace("/account/login");
            } else if ( data.login === 'EXISTED' ) {
                window.location.replace("/account/login");
            } else {
              alert('您的登入發生問題，請稍候在試')
            }
          });
        });
      }
    }
  
  
    $(function(){
      $('form#login').on('submit',function(){
        if(!reEmail.test($('input[name=account]').val())) {
          alertMsg('請輸入正確 Emal 地址'); return false;
        }
        else if($('input[name=password]').val().length<6){
          alertMsg('密碼長度需大於 6 碼'); return false;
        }
        else if(isVerifyRecaptcha==false) {
          alertMsg('請勾選「我不是機器人」再登入'); return false;
        }
        return true;
      });

    });
  </script>

