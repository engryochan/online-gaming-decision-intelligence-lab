        </span></td></tr><tr class="form-grid"><td class="first" align="left" valign="top"><span id="label_grouptoken" class="form-label">Group name</span>&nbsp;<img src="/resources/images/member_section/help@lt8syji8.gif" border="0" title="If you have forgotten the group name,
use the &quot;Forgot your password&quot; link below."/></td><td class="" align="left" valign="top"><input value="" name="grouptoken" data-dojo-type="dijit/form/ValidationTextBox" id="grouptoken" class="mpulse_theme" required="false" regexp=".{0,80}" type="text" size="32" maxlength="80"/></td></tr><tr class="form-grid"><td class="first" align="left" valign="top"><span id="label_usertoken" class="form-label">E-mail</span></td><td class="" align="left" valign="top"><input value="" name="usertoken" data-dojo-type="dijit/form/ValidationTextBox" id="usertoken" class="mpulse_theme" required="false" regexp=".{0,80}" type="text" size="32" maxlength="80"/></td></tr><tr class="form-grid"><td class="first" align="left" valign="top"><span id="label_password" class="form-label">Password</span></td><td class="" align="left" valign="top"><input value="" name="password" data-dojo-type="dijit/form/ValidationTextBox" id="password" class="mpulse_theme" required="false" regexp=".{0,80}" type="password" size="32" maxlength="80" autocomplete="off"/>&nbsp;<a href="/member_section/reset_password.html">Forgot your password?</a></td></tr><tr class="form-grid"><td class="first" colspan="2" align="left" valign="top"><img src="/resources/images/trans@lt8syji8.png" vspace="0" hspace="0" border="0" height="10" width="0"/></td></tr><tr class="form-grid"><td class="first" align="left" valign="top"><a href="#" onclick="resetForm(); return false">Clear form</a></td><td align="right"><input style="position:absolute;bottom:0px;left:0px;visibility:hidden;" id="actionSUBMIT" name="actionSUBMIT" type="submit"/><div id="actionSUBMITProxyN100C8" data-dojo-type="dijit/form/Button" class="mpulse_theme">Login<script event="click" type="dojo/on">
    function setLabelDecoration(widgetId, valid) {
      require(["dojo/dom", "dojo/domReady!"],
        function(dom) {
          var label = dom.byId("label_" + widgetId);
          if (label == null) {
            return;
          } else if (valid) {
            if (label.className == "form-label-invalid" || label.className == "form-label-bad") {
              label.className = "form-label";
            }
          } else { //invalid
            if (label.className == "form-label") {
              label.className = "form-label-invalid";
            }
          }
        }
      );
    }
  
        require(["dojo/dom", "dijit/registry", "dojo/domReady!"],
          function(dom, registry) {
            var button = dom.byId("actionSUBMITProxyN100C8");
            var formNode = dom.byId("loginForm");
            button.disable = true;
            var formValid = true;
            for (var i = 0; i < formNode.elements.length; i++) {
              var elm = formNode.elements[i];
              var widget = registry.byId(elm.id);
              if (elm.type === "textarea") {
                if (elm.attributes.getNamedItem("required").nodeValue) {
                  var regExp = elm.attributes.getNamedItem("regexp").nodeValue;
                  var widgetValid = new RegExp(regExp).test(elm.value);
                  if (!widgetValid) formValid = false;
                  setLabelDecoration(elm.name, widgetValid);
                }
              } else if (widget == null) {
                // nothing to do
              } else if (widget.type === "button") {
                // nothing to do
              } else if (widget.type === "radio" || widget.type === "checkbox") {
                var required = new RegExp(".*required{1}").test(widget.id);
                if (required) {
                  var checked = false;
                  var siblings = document.getElementsByName(widget.name);
                  for (var j = 0; j < siblings.length; j++) {
                    checked = checked || siblings[j].checked;
                  }
                  if (!checked) formValid = false;
                }
                setLabelDecoration(widget.name, !required || checked);
              } else {
                var widgetValid = widget.isValid();
                if (!widgetValid) formValid = false;
                setLabelDecoration(widget.name, widgetValid);
              }
            }
            if (formValid) {
              dom.byId("actionSUBMIT").click();
            } else {
              button.disable = false;
            }
          }
        );
      </script></div></td></tr></table><script>
        require(["dojo/dom-style", "dojo/ready", "dojo/domReady!"],
          function (domStyle, ready) {
            ready(function () {
              domStyle.set("loginForm", "visibility", "visible");
            });
          }
        );
