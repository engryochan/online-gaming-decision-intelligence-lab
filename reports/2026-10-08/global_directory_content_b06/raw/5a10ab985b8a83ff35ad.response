                        main
                        "><table style="border-width:0px;width:596px;height:100%" cellspacing="0" cellpadding="0"><tr><td style="vertical-align:top;background-color:#FFFFFF;height:400px"><table style="border-width:0px;width:100%" cellspacing="0" cellpadding="0"><tr><td><h1>Member Section Login</h1></td></tr></table><script type="text/javascript">
      require(["common/logger", "dojo/dom", "dojo/ready", "dojo/domReady!"],
        function (logger, dom, ready) {
          ready(function () {
            const log = new swx.util.Logger();
            log.start();
            const gt = dom.byId("grouptoken");
            const lf = dom.byId("loginForm");
            const ut = dom.byId("usertoken");
            (gt) ? (gt.autocomplete = "on", gt.focus()) : log.warn("Cannot find grouptoken!");
            (lf) ? lf.autocomplete = "on" : log.warn("Cannot find loginForm!");
            (ut) ? ut.autocomplete = "on" : log.warn("Cannot find usertoken!");
            log.stop();
          });
        }
      );

      function resetForm() {
        require(["dojo/dom", "dojo/domReady!"],
          function(dom) {
            dom.byId('grouptoken').value = '';
            dom.byId('usertoken').value = '';
            dom.byId('password').value = '';
          }
        );
      }

      function resetStaffForm() {
        require(["dojo/dom", "dojo/domReady!"],
          function(dom) {
            dom.byId('StaffGrouptoken').value = '';
            dom.byId('StaffUsertoken').value = '';
            dom.byId('StaffPassword').value = '';
          }
        );
      }
    ;
    </script><p class="para">
        To request a user account, go to the
        <a href="/member_section/request_account.html">Request a user account</a>
        page.
        This service is available only to registered participants of SIX Swiss Exchange
        and BME, and recognized Service Providers.
      </p><div data-dojo-type="dijit/TitlePane" class="mpulse_theme " style="
