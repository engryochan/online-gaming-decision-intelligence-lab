<script nonce="8cmdEdy2qhCTt70KJ20Rfg==">
  (function() {
    function isInternalUser(email) {
      if (!email) return false;
      return email.includes('@seedrs.com') || email.includes('@republic.com');
    }
  
    function getFullName(firstName, lastName) {
      return [firstName, lastName]
        .filter(function(name) { return !!name; })
        .join(' ')
        .trim();
    }
  
    function hasAnalyticsConsent() {
      if (!window.Osano || !window.Osano.cm || !window.Osano.cm.getConsent) {
        return false;
      }
      var consent = window.Osano.cm.getConsent();
      return consent && consent.ANALYTICS === "ACCEPT";
    }
  
    const currentUser = null;
    const ddAppId = 'f92fd80a-a4a4-4532-949c-a16f96fd41a2';
    const ddClientToken = 'pub6374ec517bbc598273738ead7da53b61';
  
    if (!ddAppId || !ddClientToken) {
      console.log("Datadog RUM: app id or client token missing, skipping initialization");
      return;
    }
  
    const CONFIG = {
      clientToken: ddClientToken,
      applicationId: ddAppId,
      site: 'datadoghq.com',
      service: 'platform-web',
      env: 'production',
      sessionSampleRate: 100,
      sessionReplaySampleRate: 100,
      trackBfcacheViews: true,
      defaultPrivacyLevel: 'mask-user-input'
    };
  
    if (currentUser && isInternalUser(currentUser.email)) {
      return;
    }
  
    let retryCount = 0;
    const maxRetries = 10;
    const retryInterval = 200;
    let initialized = false;
    let sdkLoaded = false;
    let osanoLoaded = false;
  
    let identificationInProgress = false;
    let debounceTimer = null;
    let pendingUser = null;
  
    // SDK LOADING
  
    function checkSdkLoaded() {
      if (sdkLoaded) return true;
  
      if (window.DD_RUM) {
        sdkLoaded = true;
        return true;
      }
  
      if (retryCount < maxRetries) {
        retryCount++;
        setTimeout(attemptInitialization, retryInterval);
        return false;
      }
  
      return false;
    }
  
  
    function identifyUser(user) {
      if (!user || !user.id) return;
  
      const id = user.id;
      const firstName = user.first_name;
      const lastName = user.last_name;
      const email = user.email;
  
      // Store the latest user data
      pendingUser = user;
  
      // Clear any existing debounce timer
      if (debounceTimer) {
        clearTimeout(debounceTimer);
      }
  
      const debounceDelay = 300;
  
      // Debounce rapid calls
      debounceTimer = setTimeout(function() {
        if (identificationInProgress) {
          const retryAttemptDelay = 500;
          debounceTimer = setTimeout(function() {
            identifyUser(pendingUser);
          }, retryAttemptDelay);
          return;
        }
  
        identificationInProgress = true;
        const name = getFullName(firstName, lastName);
  
        let success = false;
        let retries = 5;
        const retryDelay = 1000;
  
        function tryIdentify() {
          if (typeof window === 'undefined' || !window.DD_RUM) {
            identificationInProgress = false;
            return;
          }
  
          try {
            window.DD_RUM.setUser({
              id: id ? id.toString() : undefined,
              name: name || undefined,
              email: email || undefined
            });
            success = true;
          } catch (error) {
            console.warn('Datadog RUM: Failed to identify user', error);
          } finally {
            retries--;
            if (!success && retries > 0) {
              setTimeout(tryIdentify, retryDelay);
            } else {
              identificationInProgress = false;
            }
          }
        }
  
        tryIdentify();
      }, debounceDelay);
    }
  
    function initializeDatadog(trackingConsent) {
      if (initialized) return;
      if (!sdkLoaded) return;
  
      try {
        window.DD_RUM.init(Object.assign({}, CONFIG, {
          trackingConsent: trackingConsent
        }));
        window.DD_RUM.startSessionReplayRecording();
  
        initialized = true;
  
        // Only identify user if consent is granted
        if (currentUser && trackingConsent === 'granted') {
          identifyUser(currentUser);
        }
  
      } catch (error) {
        console.error('Datadog RUM: Initialization failed', error);
      }
    }
  
    function attemptInitialization() {
      if (!checkSdkLoaded()) return;
  
      // Wait for Osano consent before initializing
      if (!osanoLoaded) {
        console.log('Datadog RUM: waiting for user consent');
        return;
      }
  
      const trackingConsent = hasAnalyticsConsent() ? 'granted' : 'not-granted';
      initializeDatadog(trackingConsent);
    }
  
    // Osano loading with polling
    function checkOsanoLoaded() {
      if (osanoLoaded) return true;
  
      if (window.Osano && window.Osano.cm && window.Osano.cm.getConsent) {
        osanoLoaded = true;
  
        // Set up consent change listener
        if (window.Osano.cm.addEventListener) {
          window.Osano.cm.addEventListener('osano-cm-consent-saved', function(consent) {
            if (!consent) return;
  
            var trackingConsent = consent.ANALYTICS === 'ACCEPT' ? 'granted' : 'not-granted';
  
            if (initialized && window.DD_RUM) {
              // Update consent on already-initialized SDK
              try {
                window.DD_RUM.setTrackingConsent(trackingConsent);
  
                // Identify user if consent changed to granted
                if (currentUser && trackingConsent === 'granted') {
                  identifyUser(currentUser);
                }
              } catch (error) {
                console.warn('Datadog RUM: Failed to update tracking consent', error);
              }
            } else if (!initialized) {
              // First-time initialization after consent is available
              // Reset retry count to allow SDK loading attempts even after timeout
              retryCount = 0;
              attemptInitialization();
            }
          });
        }
  
        // Try initialization now that Osano is loaded
        attemptInitialization();
        return true;
      }
  
      return false;
    }
  
    // Poll for Osano with timeout
    const OSANO_CHECK_INTERVAL = 100;
    const MAX_OSANO_WAIT = 10000;
    const osanoStartTime = Date.now();
  
    const osanoIntervalId = setInterval(function() {
      if (Date.now() - osanoStartTime > MAX_OSANO_WAIT) {
        clearInterval(osanoIntervalId);
        return;
      }
  
      if (checkOsanoLoaded()) {
        clearInterval(osanoIntervalId);
      }
    }, OSANO_CHECK_INTERVAL);
  })();
</script>

