$(function() {
  if (document.referrer !== '' && !document.referrer.match('^https?://[^/]*seedrs.com')) {
    if (document.referrer !== Cookies.get('ignored_referrer')) {
      Cookies.set('_seedrs_referrer', document.referrer);
    }
  }
});

$(function() {
  var paramValue = new RegExp('[?&]promo_code=' + '([^&;]+?)(&|#|;|$)').exec(window.location.search),
      promoCode = (decodeURIComponent((paramValue || [null, ''])[1].replace(/\+/g, '%20')) || null) || '';

  if (promoCode !== '') {
    Cookies.set('_seedrs_campaign_code', promoCode, { expires: 30, path: '/' });
    var originalQueryString = document.URL.split('?')[1].split('#')[0],
        queryStringParams = originalQueryString.split('&'),
        replaceableString;

    if (queryStringParams.length === 1) {
      replaceableString = '?promo_code=' + promoCode;
    } else {
      if (queryStringParams[0].indexOf('promo_code=') === 0) {
        replaceableString = 'promo_code=' + promoCode + '&';
      } else {
        replaceableString = '&promo_code=' + promoCode;
      }
    }
    window.location = window.location.href.replace(replaceableString, '');
  }
});

//]]>
</script>
