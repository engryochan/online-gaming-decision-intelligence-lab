<script nonce="8cmdEdy2qhCTt70KJ20Rfg==">
//<![CDATA[
$(function() {
  const staticPageContentElem = document.querySelector('.staticPageContent');
  const jurisdictionValue = staticPageContentElem.getAttribute('data-jurisdiction');
  const footerElem = document.getElementById('root-footer');

  function handleFooterMounted() {
    if (jurisdictionValue === 'EU') {
      const evt = new CustomEvent('is_eu_jurisdiction', { detail: true });
      window.dispatchEvent(evt);
    }
  }

  if (footerElem && footerElem.getAttribute('data-mounted') === 'true') {
    handleFooterMounted();
  } else {
    window.addEventListener('footer_mounted', handleFooterMounted);
  }
});

//]]>
</script><script nonce="8cmdEdy2qhCTt70KJ20Rfg==">
