  <body>
    <div class="page">
      <div class="uk-section-default">
        <div 
          class="uk-height-medium uk-flex uk-flex-center uk-flex-middle uk-background-cover"
          sources="[{&quot;srcset&quot;: &quot;https://cdn.world-exchanges.org/images/london.webp&quot,
          &quot;type&quot;: &quot;image\/webp&quot;}]"
          data-src="https://cdn.world-exchanges.org/images/london.jpg"
          uk-img="loading: eager" uk-height-viewport>
          <div class="uk-position-cover overlay-primary hero"></div>
          <div class="uk-width-xlarge uk-position-z-index">
            <div class="uk-container">
              <div uk-grid>
                <div class="uk-width-1-1">
                  <a href="/">
                    <img class="uk-responsive uk-align-center uk-margin-bottom" src="https://cdn.world-exchanges.org/images/wfe_master_blue_60.png" title="The World Federation of Exchanegs logo" alt="WFE logo in blue" srcset="https://cdn.world-exchanges.org/images/wfe_master_blue_60.png 1x, https://cdn.world-exchanges.org/images/wfe_master_blue_60@2x.png 2x">
                  </a>
                </div>
              </div>
                <div class="uk-panel uk-padding auth-box uk-box-shadow-large primary">
    <div uk-grid>
      <div class="uk-width-expand">
        <h1 class="h2">Members Portal</h1>
      </div>
    </div>
    <div uk-grid>
      <div class="uk-width-1-1@m">
        <div>
                    <h3>Sign in</h3>
          <form method="post" data-request="onLogin" data-request-flash class="uk-form-stacked">
            <input type="hidden" name="redirect" value="true" />

            <div class="uk-margin">
              <label class="uk-form-label" for="inputEmail">Email</label>
              <div class="uk-form-controls uk-inline uk-width-1-1">
                  <span class="uk-form-icon" uk-icon="icon: user"></span>
                <input
                  name="email"
                  type="email"
                  class="uk-input"
                  id="inputEmail"
                  placeholder="Enter your email"
                  oninput="document.getElementById('inputRecoverEmail').value = this.value"
                />
              </div>
            </div>

            <div class="uk-margin">
              <label class="uk-form-label" for="inputPassword">Password</label>
              <div class="uk-form-controls uk-inline uk-width-1-1">
                <span class="uk-form-icon" uk-icon="icon: lock"></span>
                <input
                  name="password"
                  type="password"
                  class="uk-input"
                  id="inputPassword"
                  placeholder="Enter your password"
                />
              </div>
            </div>

            <!--  -->

            <div class="uk-margin-medium-top">
              <button
                type="submit"
                data-attach-loading
                class="uk-button uk-button-large button animate button-outline uk-width-1-1"
              >
                Sign in
              </button>
            </div>
          </form>
                      <p>No account? <a href="https://members.world-exchanges.org/register">Register here</a></p>
                    
                      <p class="uk-margin-auto-vertical">
              <a href="https://members.world-exchanges.org/forgot-password">Forgotten Password?</a>
            </p>
                  </div>
      </div>
    </div>
  </div>
            </div>
          </div>
        </div>
