<script>
// *************************
// ページトップへボタン表示
// *************************
$(function() {
	$(window).on('scroll', function (){
		let scroll = $(window).scrollTop();
		if (scroll > 200){
			$('.js-pagetop').fadeIn();
			$('.js-cv').fadeIn();
		} else {
			$('.js-pagetop').fadeOut();
			$('.js-cv').fadeOut();
		}
	});
});
</script>
