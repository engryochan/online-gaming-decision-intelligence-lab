        <script type="text/plain" data-static-src="/_modules/background-visuals/shaders/fragment.glsl">#version 300 es
precision highp float;

#define PI 3.14159265359

uniform vec2 resolution;
uniform vec2 mouse;
uniform float time;
uniform vec4 date;
uniform float aspectRatio;
uniform float opacity;
uniform sampler2D baseTexture;
uniform sampler2D portraitTexture;

#include "functions.glsl"

out vec4 fragColor;

vec3 saturateColor(vec3 color, float amount) {
    float luminance = dot(color, vec3(0.299, 0.587, 0.114));
    return mix(vec3(luminance), color, amount);
}

float remap(float value, float inMin, float inMax, float outMin, float outMax) {
    float t = clamp((value - inMin) / (inMax - inMin), 0.0, 1.0);
    return mix(outMin, outMax, t);
}

vec2 coverUv(vec2 uv, float screenAspect, float imageAspect) {
    vec2 scaled = uv - 0.5;

    if (screenAspect > imageAspect) {
        scaled.y *= imageAspect / screenAspect;
    } else {
        scaled.x *= screenAspect / imageAspect;
    }

    return scaled + 0.5;
}

float layeredFbm(vec2 uv) {
    float value = 0.0;
    float amplitude = 0.58;
    mat2 transform = mat2(1.72, 1.18, -1.18, 1.72);

    for (int i = 0; i < 5; i++) {
        value += amplitude * noise(uv);
        uv = transform * uv + vec2(4.2, -2.7);
        amplitude *= 0.52;
    }

    return value;
}

float treeLightBand(vec2 uv, float speed, float phase, float scale) {
    vec2 wind = vec2(time * speed, time * speed * 0.09);
    vec2 warp = vec2(
        fbm(uv * 0.75 + vec2(time * 0.021 + phase, -1.7 + phase)),
        fbm(uv * 0.68 + vec2(-time * 0.016 - phase, 2.3 - phase))
    ) - 0.5;

    uv += warp * 0.24;

    float nA = layeredFbm(uv * scale + vec2(phase, 0.0) + wind);
    float nB = layeredFbm(rotate2d(-0.22) * (uv * (scale * 1.45) - wind * 0.6 + vec2(-phase, phase)));
    float streaks = nA * 0.65 + nB * 0.35;

    return smoothstep(0.52, 0.77, streaks);
}

float particleField(vec2 uv, float scale, float threshold, float size, float speed) {
    vec2 flowUv = uv * scale + vec2(time * speed, 0.0);
    vec2 cell = floor(flowUv);
    vec2 local = fract(flowUv);
    float particles = 0.0;

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec2 neighbor = vec2(float(x), float(y));
            vec2 id = cell + neighbor;
            float seed = random(id);

            if (seed < threshold) {
                continue;
            }

            vec2 offset = random2(id) * 0.8 + 0.1;
            vec2 delta = local - offset - neighbor;
            float dist = length(delta);
            float glow = smoothstep(size, 0.0, dist);
            particles = max(particles, glow * remap(seed, threshold, 1.0, 0.18, 1.0));
        }
    }

    return particles;
}

void main() {
    vec2 uv = gl_FragCoord.xy / resolution.xy;
    vec2 imageUv = coverUv(uv, aspectRatio, 16.0 / 9.0);
    vec2 portraitImageUv = coverUv(uv, aspectRatio, 9.0 / 16.0);
    vec2 p = uv - 0.5;
    float portraitBlend = clamp((1.0 - aspectRatio) / 0.45, 0.0, 1.0);
    float portraitTextureBlend = smoothstep(0.08, 0.62, portraitBlend);
    float horizontalScale = mix(aspectRatio, pow(aspectRatio, 0.72), portraitBlend);
    float verticalScale = mix(1.0, 0.8, portraitBlend);

    p.x *= horizontalScale;
    p.y *= verticalScale;

    vec2 scenicUv = vec2(
        p.x * mix(0.82, 0.96, portraitBlend),
        p.y * mix(1.08, 0.9, portraitBlend)
    );
    vec2 baseUv = scenicUv * 0.96;
    vec2 flowUv = scenicUv + vec2(time * 0.034, time * 0.0025);

    vec3 landscapeBaseColor = texture(baseTexture, imageUv).rgb;
    vec3 portraitBaseColor = texture(portraitTexture, portraitImageUv).rgb;
    vec3 baseColor = mix(landscapeBaseColor, portraitBaseColor, portraitTextureBlend);
    vec3 finalColor = baseColor;
    float motionFade = smoothstep(0.6, 6.0, time);
    float orangeGrowth = smoothstep(2.4, 18.0, time);
    float orangePresence = mix(
        mix(0.0, 0.22, portraitBlend),
        mix(0.62, 0.58, portraitBlend),
        orangeGrowth
    );
    float portraitOrangeShift = portraitBlend * 0.02;
    float portraitRightGate = mix(1.0, smoothstep(0.0, 0.18, p.x), portraitBlend);
    float portraitLowerGate = mix(1.0, smoothstep(-0.08, 0.32, -p.y), portraitBlend);
    float portraitOrangeGate = portraitRightGate * portraitLowerGate;
    float compactLayoutBlend = 1.0 - smoothstep(980.0, 1180.0, resolution.x);
    float tallPortraitBlend = smoothstep(860.0, 900.0, resolution.y)
        * smoothstep(0.12, 0.32, portraitBlend)
        * (1.0 - smoothstep(0.82, 0.95, portraitBlend));
    float compactOrangeLowerGate = mix(
        1.0,
        1.0 - smoothstep(mix(0.18, 0.42, tallPortraitBlend), mix(0.32, 0.62, tallPortraitBlend), uv.y),
        compactLayoutBlend
    );
    float orangeLayoutGate = portraitOrangeGate * compactOrangeLowerGate;
    float orangeCornerBlend = max(portraitBlend, compactLayoutBlend * 0.72);

    float maskAspect = max(horizontalScale, 0.0001);
    float upperLeftMask = exp(-pow((p.x + 0.36 * maskAspect) / (0.26 * maskAspect), 2.0)) * smoothstep(0.9, 0.02, p.y);
    float centerMask = exp(-pow((p.x + 0.02 * maskAspect) / (0.28 * maskAspect), 2.0));
    float lowerLeftMask = smoothstep(0.34 * maskAspect, -0.9 * maskAspect, p.x) * smoothstep(0.72, -0.36, p.y);
    float rightEmberMask = smoothstep(0.34 * maskAspect, 1.08 * maskAspect, p.x) * smoothstep(0.78, -0.42, p.y);
    float diagonalTreeMask = smoothstep(0.84, 0.18, abs(p.x * 0.46 + p.y * 0.92 + 0.14));

    float murmurA = treeLightBand(flowUv + vec2(-0.14, 0.06), 0.064, 0.2, 0.94);
    float murmurB = treeLightBand(rotate2d(0.18) * (flowUv + vec2(0.08, -0.02)), 0.048, 1.1, 1.2);
    float murmurC = treeLightBand(rotate2d(-0.14) * (flowUv + vec2(-0.02, 0.18)), 0.036, 2.0, 1.5);

    finalColor += vec3(0.08, 0.12, 0.1) * murmurA * lowerLeftMask * 0.22 * motionFade;
    finalColor += vec3(0.12, 0.16, 0.15) * murmurB * centerMask * 0.24 * motionFade;
    finalColor += vec3(0.08, 0.06, 0.04) * murmurC * rightEmberMask * 0.17 * motionFade;
    finalColor += vec3(0.14, 0.18, 0.16) * murmurB * upperLeftMask * 0.13 * motionFade;

    float fleetingLight = treeLightBand(
        rotate2d(-0.08) * (flowUv * vec2(1.28, 0.84) + vec2(0.24, -0.08)),
        0.08,
        3.2,
        1.18
    );
    float fleetingMask = smoothstep(-0.25, 0.55, p.x) * smoothstep(0.82, -0.18, p.y);
    finalColor += vec3(0.11, 0.14, 0.1) * fleetingLight * fleetingMask * 0.12 * motionFade;

    float treeShadowA = smoothstep(0.64, 0.36, fbm(vec2(baseUv.x * 2.8, baseUv.y * 0.8) + vec2(0.0, 4.0)));
    float treeShadowB = smoothstep(0.68, 0.42, fbm(rotate2d(0.08) * vec2(baseUv.x * 4.2, baseUv.y * 0.7) + vec2(3.2, -1.4)));
    float treeShadowMask = clamp(treeShadowA * 0.5 + treeShadowB * 0.4, 0.0, 1.0) * diagonalTreeMask;
    finalColor *= 1.0 - treeShadowMask * 0.05 * motionFade;

    float particlesNear = particleField(scenicUv + vec2(0.0, 0.08), 18.0, 0.986, 0.12, 0.024);
    float particlesFar = particleField(rotate2d(0.3) * scenicUv, 28.0, 0.993, 0.08, 0.018);
    vec3 particleColor = mix(vec3(0.16, 0.22, 0.2), vec3(0.44, 0.3, 0.22), smoothstep(0.7, 1.0, uv.x));
    finalColor += particleColor * (particlesNear * 0.01 + particlesFar * 0.006) * motionFade;

    vec2 emberUv = vec2(
        scenicUv.x * mix(1.04, 1.34, portraitBlend) + time * 0.062,
        scenicUv.y * 0.54 - time * 0.008
    );
    float emberField = layeredFbm(emberUv + vec2(1.7, -0.6));
    float emberBreakup = layeredFbm(rotate2d(0.36) * (emberUv * 1.18 + vec2(-3.1, 1.9)));
    float emberRibbon = smoothstep(0.53, 0.76, emberField * 0.76 + emberBreakup * 0.24);
    float emberMask = smoothstep(0.18 - orangeGrowth * 0.24, 1.06 - orangeGrowth * 0.46, p.x + portraitOrangeShift) * smoothstep(0.9, -0.18 - orangeGrowth * 0.2, p.y) * orangeLayoutGate;
    vec3 emberColor = mix(vec3(0.34, 0.17, 0.08), vec3(0.92, 0.45, 0.16), smoothstep(0.48, 0.9, emberBreakup));
    finalColor += emberColor * emberRibbon * emberMask * orangePresence * mix(0.24, 0.52, orangeGrowth) * motionFade;

    float warmDrift = smoothstep(
        0.46,
        0.72,
        layeredFbm(vec2(scenicUv.x * 1.08 + time * 0.05, scenicUv.y * 0.34 - time * 0.008) + vec2(5.3, -1.4))
    );
    float warmMask = smoothstep(0.12 - orangeGrowth * 0.22, 1.0 - orangeGrowth * 0.42, p.x + portraitOrangeShift) * smoothstep(0.92, -0.1 - orangeGrowth * 0.24, p.y) * orangeLayoutGate;
    finalColor += vec3(0.76, 0.31, 0.1) * warmDrift * warmMask * orangePresence * mix(0.18, 0.42, orangeGrowth) * motionFade;

    vec2 orangeCloudUv = vec2(
        scenicUv.x * 0.72 + time * 0.02,
        scenicUv.y * 0.52 - time * 0.004
    );
    float orangeFlow = smoothstep(0.44, 0.78, layeredFbm(orangeCloudUv + vec2(-2.2, 3.6)));
    float orangeCloudBreakup = smoothstep(0.32, 0.72, layeredFbm(rotate2d(-0.28) * (orangeCloudUv * 1.75 + vec2(1.4, -0.9))));
    float orangeCloudCenterX = mix(-0.18, 0.24, portraitBlend);
    float orangeCloudWidth = mix(0.46, 0.18, portraitBlend);
    float orangeCloudCenter = exp(-pow((p.x - orangeCloudCenterX) / orangeCloudWidth, 2.0));
    float orangeFlowMask = orangeCloudCenter * smoothstep(0.98, -0.42, p.y) * mix(0.55, 1.0, orangeCloudBreakup) * orangeLayoutGate;
    finalColor += vec3(0.66, 0.27, 0.08) * orangeFlow * orangeFlowMask * orangePresence * mix(0.1, 0.16, portraitBlend) * orangeGrowth * motionFade;

    vec2 compactCornerUv = vec2(
        (uv.x - mix(0.92, 0.9, tallPortraitBlend)) / mix(0.36, 0.42, tallPortraitBlend),
        (uv.y - mix(0.24, 0.44, tallPortraitBlend)) / mix(0.28, 0.34, tallPortraitBlend)
    );
    float compactCornerRight = smoothstep(mix(0.56, 0.52, tallPortraitBlend), mix(0.84, 0.84, tallPortraitBlend), uv.x);
    float compactCornerLower = 1.0 - smoothstep(mix(0.32, 0.5, tallPortraitBlend), mix(0.46, 0.64, tallPortraitBlend), uv.y);
    float compactCornerCore = exp(-dot(compactCornerUv, compactCornerUv));
    float compactCornerGlow = orangeCornerBlend * compactCornerRight * compactCornerLower * compactCornerCore * mix(0.72, 1.0, orangeCloudBreakup) * mix(0.42, 1.0, orangeGrowth) * motionFade;
    finalColor += vec3(0.76, 0.31, 0.09) * compactCornerGlow * mix(0.36, 0.82, tallPortraitBlend);

    float tabletPortraitOrangeBand = tallPortraitBlend
        * compactLayoutBlend
        * smoothstep(0.56, 0.84, uv.x)
        * smoothstep(0.28, 0.42, uv.y)
        * (1.0 - smoothstep(0.52, 0.66, uv.y))
        * mix(0.45, 1.0, orangeGrowth)
        * motionFade;
    finalColor = mix(finalColor, vec3(0.72, 0.34, 0.18), tabletPortraitOrangeBand * 0.14);

    finalColor = saturateColor(finalColor, 1.02);
    finalColor = pow(max(finalColor, vec3(0.0)), vec3(1.02, 1.01, 1.0));

    fragColor = vec4(finalColor, clamp(0.9 + opacity * 0.08, 0.0, 1.0));
}
</script>
        <script type="text/plain" data-static-src="/_modules/background-visuals/shaders/functions.glsl">float plot (vec2 st, float pct){
  return  smoothstep( pct-0.01, pct, st.y) -
    smoothstep( pct, pct+0.01, st.y);
}

vec3 rgb2hsb( in vec3 c ){
  vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
  vec4 p = mix(vec4(c.bg, K.wz),
        vec4(c.gb, K.xy),
        step(c.b, c.g));
  vec4 q = mix(vec4(p.xyw, c.r),
        vec4(c.r, p.yzx),
        step(p.x, c.r));
  float d = q.x - min(q.w, q.y);
  float e = 1.0e-10;
  return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)),
        d / (q.x + e),
        q.x);
}

//  Function from Iñigo Quiles
//  https://www.shadertoy.com/view/MsS3Wc
vec3 hsb2rgb( in vec3 c ){
  vec3 rgb = clamp(abs(mod(c.x*6.0+vec3(0.0,4.0,2.0),
              6.0)-3.0)-1.0,
          0.0,
          1.0 );
  rgb = rgb*rgb*(3.0-2.0*rgb);
  return c.z * mix(vec3(1.0), rgb, c.y);
}

//Rotate 2D
vec2 rotate2D (vec2 _st, float _angle) {
  _st -= 0.5;
  _st =  mat2(cos(_angle),-sin(_angle),
        sin(_angle),cos(_angle)) * _st;
  _st += 0.5;
  return _st;
}

vec2 tile (vec2 _st, float _zoom) {
  _st *= _zoom;
  return fract(_st);
}

vec2 rotateTilePattern(vec2 _st){

  //  Scale the coordinate system by 2x2
  _st *= 2.0;

  //  Give each cell an index number
  //  according to its position
  float index = 0.0;
  index += step(1., mod(_st.x,2.0));
  index += step(1., mod(_st.y,2.0))*2.0;

  //      |
  //  2   |   3
  //      |
  //--------------
  //      |
  //  0   |   1
  //      |

  // Make each cell between 0.0 - 1.0
  _st = fract(_st);

  // Rotate each cell according to the index
  if(index == 1.0){
    //  Rotate cell 1 by 90 degrees
    _st = rotate2D(_st,PI*0.5);
  } else if(index == 2.0){
    //  Rotate cell 2 by -90 degrees
    _st = rotate2D(_st,PI*-0.5);
  } else if(index == 3.0){
    //  Rotate cell 3 by 180 degrees
    _st = rotate2D(_st,PI);
  }

  return _st;
}

float random (in vec2 st) {
    return fract(sin(dot(st.xy, vec2(12.9898, 78.233))) * 43758.5453123);
}

float noise (in vec2 st) {
    vec2 i = floor(st);
    vec2 f = fract(st);

    float a = random(i);
    float b = random(i + vec2(1.0, 0.0));
    float c = random(i + vec2(0.0, 1.0));
    float d = random(i + vec2(1.0, 1.0));

    vec2 u = f * f * (3.0 - 2.0 * f);

    return mix(a, b, u.x) +
           (c - a) * u.y * (1.0 - u.x) +
           (d - b) * u.x * u.y;
}

vec2 random2(vec2 p) {
  return fract(sin(vec2(dot(p, vec2(127.1, 311.7)), dot(p, vec2(269.5, 183.3)))) * 43758.5453123);
}


vec2 truchetPattern(in vec2 _st, in float _index){
  _index = fract(((_index-0.5)*2.0));
  if (_index > 0.75) {
    _st = vec2(1.0) - _st;
  } else if (_index > 0.5) {
    _st = vec2(1.0-_st.x,_st.y);
  } else if (_index > 0.25) {
    _st = 1.0-vec2(1.0-_st.x,_st.y);
  }
  return _st;
}





// Value noise by Inigo Quilez - iq/2013
// https://www.shadertoy.com/view/lsf3WH
float noiseWoodTexture(vec2 st) {
  vec2 i = floor(st);
  vec2 f = fract(st);
  vec2 u = f*f*(3.0-2.0*f);
  return mix( mix( random( i + vec2(0.0,0.0) ),
          random( i + vec2(1.0,0.0) ), u.x),
        mix( random( i + vec2(0.0,1.0) ),
          random( i + vec2(1.0,1.0) ), u.x), u.y);
}

mat2 rotate2d(float angle){
  return mat2(cos(angle),-sin(angle),
        sin(angle),cos(angle));
}

float lines(in vec2 pos, float b){
  float scale = 10.0;
  pos *= scale;
  return smoothstep(0.0,
          .5+b*.5,
          abs((sin(pos.x*3.1415)+b*2.0))*.5);
}


vec2 skew (vec2 st) {
  vec2 r = vec2(0.0);
  r.x = 1.1547*st.x;
  r.y = st.y+0.5*r.x;
  return r;
}

vec3 simplexGrid (vec2 st) {
  vec3 xyz = vec3(0.0);

  vec2 p = fract(skew(st));
  if (p.x > p.y) {
    xyz.xy = 1.0-vec2(p.x,p.y-p.x);
    xyz.z = p.y;
  } else {
    xyz.yz = 1.0-vec2(p.x-p.y,p.y);
    xyz.x = p.x;
  }

  return fract(xyz);
}

float customNoise(vec2 st, float frequency) {
  return fract(length(st) * frequency);
}

float perlin(vec2 st, float frequency) {
  return fract(st.x * frequency + st.y * frequency);
}

float perlinNoise(vec2 st, float frequency) {
  st += vec2(0.1 * sin(st.y), 0.1 * cos(st.x)); // Add a small perturbation
  return fract(st.x * frequency + st.y * frequency);
}


float simplexNoise(vec2 st) {
  vec2 i = floor(st);
  vec2 f = fract(st);
  vec2 u = f * f * (3.0 - 2.0 * f);
  return mix(
    mix(
      dot(random2(i + vec2(0.0, 0.0)), f - vec2(0.0, 0.0)),
      dot(random2(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0)),
      u.x
    ),
    mix(
      dot(random2(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0)),
      dot(random2(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0)),
      u.x
    ),
    u.y
  );
}

float worleyNoise(vec2 st, float frequencyDesign) {
  vec2 scaledSt = st * frequencyDesign;
  vec2 i = floor(scaledSt);
  vec2 f = fract(scaledSt);
  float minDist = 1.0;
  
  for (int j = -1; j <= 1; ++j) {
    for (int k = -1; k <= 1; ++k) {
      vec2 neighbor = vec2(float(j), float(k));
      vec2 point = random2(i + neighbor);
      vec2 diff = point - f + vec2(0.5); // Add a central anchor point
      float dist = length(diff);
      minDist = min(minDist, dist);
    }
  }
  return minDist;
}

float voronoiNoise(vec2 st, float frequencyDesign) {
  vec2 i = floor(st * frequencyDesign);
  vec2 f = fract(st * frequencyDesign);
  float minDist = 1.0;
  for (int j = -1; j <= 1; j++) {
    for (int k = -1; k <= 1; k++) {
      vec2 neighbor = vec2(float(j), float(k));
      vec2 point = random2(i + neighbor);
      float dist = length(f - point); // Note the difference here
      minDist = min(minDist, dist);
    }
  }
  return minDist;
}

#define OCTAVES 6
float fbm (in vec2 st) {
    float value = 0.0;
    float amplitude = .5;

    for (int i = 0; i < OCTAVES; i++) {
        value += amplitude * noise(st);
        st *= 2.0;
        amplitude *= 0.5;
    }
    return value;
}

// Function to generate a Sierpinski Carpet-like fractal pattern
float fractalPattern(vec2 uv, float scale) {
    vec2 p = uv * scale;
    float d = 1.0;
    for (int i = 0; i < 5; i++) {  // Increased iteration count for a more detailed fractal
        if (mod(p.x, 1.0) < 0.1 && mod(p.y, 1.0) < 0.1) {
            d = min(d, length(p - vec2(0.5)));
        }
        p *= 3.0;
    }
    return d;
}

float mandelbrotSet(vec2 uv, float scale) {
  vec2 c = vec2(-0.5, 0.0) + scale * uv;
  vec2 z = vec2(0, 0);
  int iterations = 0;
  for (int i = 0; i < 100; i++) {
    z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
    if (dot(z, z) > 4.0) break;
    iterations++;
  }
  return float(iterations) / 100.0;
}

float juliaSet(vec2 uv, float scale) {
  vec2 c = vec2(-0.4, 0.6) + scale * uv;
  vec2 z = vec2(0, 0);
  int iterations = 0;
  for (int i = 0; i < 100; i++) {
    z = vec2(z.x * z.x - z.y * z.y, 2.0 * z.x * z.y) + c;
    if (dot(z, z) > 4.0) break;
    iterations++;
  }
  return float(iterations) / 100.0;
}

float burningShipSet(vec2 uv, float scale) {
  vec2 c = vec2(-0.5, 0.0) + scale * uv;
  vec2 z = vec2(0, 0);
  int iterations = 0;
  for (int i = 0; i < 100; i++) {
    z = vec2(z.x * z.x - z.y * z.y, abs(2.0 * z.x * z.y)) + c;
    if (dot(z, z) > 4.0) break;
    iterations++;
  }
  return float(iterations) / 100.0;
}

float sierpinskiCarpet(vec2 uv, int iterations, vec3 color, float scale) {
  float offset = 0.5;
  float result = 0.0;

  for (int i = 0; i < iterations; i++) {
    vec2 coord = floor(uv * scale);
    vec2 frac = fract(uv * scale);
    result += step(1.0, dot(sign(frac - offset), vec2(1.0)));
    uv = (uv - coord / scale) / scale;
  }

  return result * dot(color, vec3(1.0));
}

vec3 getColor(float t) {
    vec3 color1 = vec3(0.677, 0.803, 0.827); // #adcbd5
    vec3 color2 = vec3(0.859, 0.827, 0.784); // #ddd899
    vec3 color3 = vec3(0.922, 0.909, 0.902); // #ebe6e2
    vec3 color4 = vec3(0.615, 0.423, 0.408); // #9c6d67
    vec3 color5 = vec3(0.266, 0.266, 0.266); // #444444
    vec3 color6 = vec3(0.443, 0.427, 0.459); // #727076
    vec3 color7 = vec3(0.960, 0.961, 0.965); // #f5f5f5 (light gray)
    vec3 color8 = vec3(0.212, 0.212, 0.212); // #343434 (dark gray)

    if (t < 1.0) {
        return mix(color1, color2, t);
    } else if (t < 2.0) {
        return mix(color2, color3, t - 1.0);
    } else if (t < 3.0) {
        return mix(color3, color4, t - 2.0);
    } else if (t < 4.0) {
        return mix(color4, color5, t - 3.0);
    } else if (t < 5.0) {
        return mix(color5, color6, t - 4.0);
    } else if (t < 6.0) {
        return mix(color6, color7, t - 5.0);
    } else {
        return color7;
    }
}

float gaussianBlur(float distance, float radius) {
    return exp(-distance * distance / (radius * radius));
}

// Color palette for the fog effect
vec3 getFogColor(float t) {
    vec3 colorA = vec3(0.677, 0.803, 0.827); // #adcbd5
    vec3 colorB = vec3(0.859, 0.827, 0.784); // #ddd899
    vec3 color3 = vec3(0.922, 0.909, 0.902); // #ebe6e2
    vec3 colorC = vec3(0.615, 0.423, 0.408); // #9c6d67


    if (t < 0.33) {
        return mix(colorA, colorB, t * 3.0);
    } else if (t < 0.66) {
        return mix(colorB, colorC, (t - 0.33) * 3.0);
    } else {
        return mix(colorC, colorA, (t - 0.66) * 3.0);
    }
}
</script>
    
