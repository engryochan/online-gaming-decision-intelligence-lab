    <div style="display: none;">
    <input id="cache-flag" type="text" value="" />
</div>
<script>
        // refresh page on back/forward button to ensure cached data is removed:
        $(window).on("pageshow", function (event) {
            if ($("#cache-flag").val() == "true") {
                $.blockUI({
                    message: '<p id="loading-status" class="loading-status" role="progressbar" aria-valuetext="loading">loading <img class="loading-ellipsis" src="/content/img/ellipsis.gif" /></p>',
                    // prevent busy cursor issue on reload
                    css: { cursor: 'auto' },
                    overlayCSS: { cursor: 'auto' }
                });
                location.reload(true);
            }
            $("#cache-flag").val("true");
        });
</script>

