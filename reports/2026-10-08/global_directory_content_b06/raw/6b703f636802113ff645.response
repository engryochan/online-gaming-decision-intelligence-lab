            /* Create the expiry date (today + 1 year) */
            var CookieDate = new Date;
            CookieDate.setFullYear(CookieDate.getFullYear( ) +1);
            
            /* Set the cookie (acceptance of cookies usage) */
            document.cookie = 'infoCookies=true; expires=' + CookieDate.toGMTString( ) + ';';

            /* When "OK" clicked, hides this popup */
            document.getElementById("cookies-info").style.display = "none";		
        }	
        
        // Handle accept button click
        document.getElementById('cookie-accept-btn').addEventListener('click', function (e) {
            e.preventDefault();
            hideCookie();
        });
        
        // Handle close button click
        document.getElementById('cookie-close-btn').addEventListener('click', function (e) {
            e.preventDefault();
            hideCookie();
        });
    </script>
    		<!-- Cookies E -->
		<!-- Java Script S -->
