  <!-- Section - Support -->
  <section id="support" class="section reveal">
    <h2>
      <span lang="en">Need support?</span>
      <span lang="de">Benötigen Sie Unterstützung?</span>
    </h2>
    <p>
      <span lang="en">We are here to help. Feel free to get in touch via email or phone.</span>
      <span lang="de">Wir stehen Ihnen zur Verfügung. Kontaktieren Sie uns gerne per E-Mail oder telefonisch.</span>
    </p>
    <div class="support__card-container">
      <div class="support__card">
        <img src="img/icons/DBG_Icons_RGB_white-296.svg" alt="Email">
        <h4>
          <span lang="en">Write us</span>
          <span lang="de">Schreiben Sie uns</span>
        </h4>
        <p>
          <span lang="en">Contact our support team via email for any questions or comments. Our support team is here to help you.</span>
          <span lang="de">Wenden Sie sich bei Fragen oder Anmerkungen per E-Mail an unser Support-Team. Unser Support-Team hilft Ihnen gerne.</span>
        </p>
        <a href="mailto:member.section@deutsche-boerse.com"><span lang="en">Send an email</span><span lang="de">E-Mail senden</span></a>
      </div>
      <div class="support__card">
        <img src="img/icons/DBG_Icons_RGB_white-302.svg" alt="Phone">
        <h4>
          <span lang="en">Give us a call</span>
          <span lang="de">Rufen Sie an</span>
        </h4>
        <p>
          <span lang="en">Call +49 (0) 069-211-178 88<br>Our Support team is happy to assist you.<br>Service hours: Mon - Fri, 9am - 6pm CET.</span>
          <span lang="de">Rufen Sie an unter +49 (0) 069-211-178 88<br>Unser Support-Team hilft Ihnen gerne weiter.<br>SServicezeiten: Mo - Fr, 9 - 18 Uhr (MEZ).</span>
        </p>
        <a href="tel:+49 (0)69 - 21117888"><span lang="en">Call now</span><span lang="de">Jetzt anrufen</span></a>
      </div>
      <div class="support__card">
        <img src="img/icons/DBG_Icons_RGB_white-303.svg" alt="Web">
        <h4>
          <span lang="en">Supporting information</span>
          <span lang="de">Unterstützende Information</span>
        </h4>
        <p>
          <span lang="en">Looking for FAQs or user guides? Explore our support webpage to extend your knowledge about the Member Section.</span>
          <span lang="de">Suchen Sie nach FAQs oder Handbüchern? Erkunden Sie unsere Support-Webseite, um Ihr Wissen über die Member Section zu erweitern.</span>
        </p>
        <a href="https://deutsche-boerse.com/dbg-en/meta/member-section-support#top" target="_blank"><span lang="en">Learn more</span><span lang="de">Mehr erfahren</span></a>
      </div>
    </div>
  </section>
  <!-- Footer -->
  <footer id="footer">
  	<nav class="footer__container">
      <p>&#169; 2022 Deutsche Börse Group</p>
      <a lang="en" href="https://deutsche-boerse.com/dbg-en/meta/imprint" target="_blank">Imprint</a>
      <a lang="de" href="https://deutsche-boerse.com/dbg-de/meta/impressum" target="_blank">Impressum</a>
      <a lang="en" href="./external/data_privacy.html" target="_blank">Data Privacy</a>
      <a lang="de" href="./external/data_privacy_de.html" target="_blank">Datenschutz</a>
      <a href="./external/tech_requirements.html" target="_blank"><span lang="en">Technical Requirements</span><span lang="de">Technische Anforderungen</span></a>
      <a lang="en" href="./external/terms_of_use.html" target="_blank">Terms of Use</a>
      <a lang="de" href="./external/terms_of_use_de.html" target="_blank">Nutzungsbedingungen</a>
	  <div class="centered">
	    <button class="arrow-button" onclick="backToTop()">
		  <i class="fa-solid fa-chevron-up"></i>
		</button>
		<p><span lang="en">Back to top</span><span lang="de">Zurück zum Anfang</span></p>
	  </div>
  	</nav>
  </footer>
  
  <script src="js/language-switch.js"></script>
</body>
</html>