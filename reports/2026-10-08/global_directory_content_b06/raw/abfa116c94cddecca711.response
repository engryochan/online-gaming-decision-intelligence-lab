<div class="responsive_table">
<form action="/DirectoryList" method="post">		<div class="card-body">
			<div class="row">
				<div class="form-group col-md-6 mt-6">
						<label for="paginationRequest_SearchText" class="control-label d-block mb-1">Global Search</label>
					<div class="input-group">
						<input class="form-control caf-search" data-val="true" data-val-required="The SearchText field is required." id="paginationRequest_SearchText" maxlength="100" name="paginationRequest.SearchText" placeholder="Search Text by Entity Name, Category, Sub category" type="text" value="" />
						<div class="input-group-append">
							<button class="file-upload-browse btn btn-primary" type="button" id="searchButton"> <i class="mdi mdi-magnify"></i>Search</button>
						</div>
					</div>
				</div>
			</div>
			<div class="row">
				<div class="form-group col-md-4">
					Category
					<select class="form-control" data-val="true" data-val-required="The ParentTypeId field is required." ID="ParenDFTypeId" name="ParentTypeId" onchange="getChildCategoryData(this.value);"><option value="">-- Select All--</option>
<option value="9">Ancillary Service Provider</option>
<option value="1">Banking</option>
<option value="27">BATF Service Providers</option>
<option value="3">Capital Market Intermediaries</option>
<option value="2">Finance Company</option>
<option value="24">Fintech Sandbox Entities</option>
<option value="29">Foreign Universities</option>
<option value="7">Fund Management</option>
<option value="10">Global In-House Centres</option>
<option value="5">IFSC Insurance Intermediary Office (IIIO)</option>
<option value="4">IFSC Insurance Office (IIO)</option>
<option value="19">KYC Registration Agency</option>
<option value="23">Market Infrastructure Institutions</option>
<option value="11">Metals &amp; Commodities entities</option>
<option value="26">Payment Service Provider</option>
<option value="22">Payment System Provider</option>
<option value="21">Qualified Jewellers</option>
<option value="30">Surrendered/Cancelled CoRs</option>
<option value="28">TAS Service Provider</option>
</select>
				</div>
				<div class="form-group col-md-4">
					Sub Category
					<select class="select2 form-control" data-val="true" data-val-required="The Id field is required." ID="DFTypeId" name="Id" onchange="getDirectoryChildDataByID(this.value);"><option value="">-- Select All--</option>
</select>
				</div>
