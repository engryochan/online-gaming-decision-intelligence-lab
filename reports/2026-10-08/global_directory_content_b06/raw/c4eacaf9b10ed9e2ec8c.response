    $('.bannerSlider').show();
    $('#homeslider').bxSlider({});
    $('#slider_swipe').bxSlider({
      touchEnabled: true,
      infiniteLoop: false,
      oneToOneTouch: false
    });
    $('#slider_no_swipe').bxSlider({
      /* touchEnabled: false,
       infiniteLoop: false,
       oneToOneTouch:false*/
    });
    $('#commonhomeslider').bxSlider({
      pager: false,
      touchEnabled: false,
      infiniteLoop: false,
      oneToOneTouch: false
    });
    setTimeout(function() {
      var slideHeight = $('.bx-viewport').height();
      $('#slider_no_swipe li').height(slideHeight);
    }, 100);
  });</script> <script>function howTosSearchBoxFunction() {
    // Declare variables
    var input, filter, div, innerDiv, a, i, txtValue;
    input = document.getElementById('searchBox');
    filter = input.value.toUpperCase();
    div = document.getElementById("howTosPanel");
    innerDiv = div.getElementsByClassName('panel');
    // Loop through all list items, and hide those who don't match the search query
    for (i = 0; i < innerDiv.length; i++) {
      a = innerDiv[i].getElementsByTagName("a")[0];
      txtValue = a.textContent || a.innerText;
      if (txtValue.toUpperCase().indexOf(filter) > -1) {
        innerDiv[i].style.display = "";
      } else {
        innerDiv[i].style.display = "none";
      }
    }
  }</script> <script>function tutorialSearchBoxFunction() {
