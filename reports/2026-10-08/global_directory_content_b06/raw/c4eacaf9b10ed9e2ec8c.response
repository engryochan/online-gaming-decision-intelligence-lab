    var demoAccountUrl = 'https://eurofinance.bg/open-demo-account';</script> </head><body class="wp-singular page-template page-template-page-template page-template-licensed page-template-page-templatelicensed-php page page-id-1712 wp-custom-logo wp-embed-responsive wp-theme-euro-finance wrapper strippadding page-22-redesign font-mont-regular group-blog has-header-image page-two-column colors-light"><div class=bodycontent><header class=main-header><div class="container-fluid pt-2 pt-lg-0 d-flex d-lg-block justify-content-between"><ul id=menu-mobile-top-header-menu-bulgarian class="mobile-top-navigation d-none"><li id=menu-item-3281 class="menu-item menu-item-type-custom menu-item-object-custom menu-item-3281"><a href=https://my.eurofinance.bg/ >Отворете сметка</a></li> <li id=menu-item-3279 class="menu-item menu-item-type-custom menu-item-object-custom menu-item-3279"><a href=https://payments.eurofinance.bg/ >Депозит</a></li> <li id=menu-item-3280 class="d-none menu-item menu-item-type-post_type menu-item-object-page menu-item-3280"><a href=https://eurofinance.bg/helpdesk/ >Helpdesk</a></li> <li><a href="tel:+359 700 156 56"><i class="fa fa-phone rotate-90"></i></a></li><li><a href=javascript:; class=search-box><i class="fa fa-search"></i></a></li><li style="height: 16px; padding-right: 0;"> <a href=https://eurofinance.bg/en/licensed/ style="background-position: center !important; background-size: cover !important; background: url(https://my.eurofinance.bg/images/flag-en.svg); border-radius: 8px; display: inline-block; height: 12px; margin-left: 2px; width: 12px;"> </a> </li></ul>  <a href=https://eurofinance.bg class=logo> <img src=https://eurofinance.bg/wp-content/uploads/2019/08/eurofinance-logo.svg alt=logo class="large pt-1 pt-lg-0"> <img src=https://eurofinance.bg/wp-content/uploads/2019/07/favicon.png alt=logo class=small> </a><div class=navigation style="flex: 1;"><div class=top-navigation><ul class=left-nav> <li class="newDeposit d-none"> <a target=_blank href=https://payments.eurofinance.bg/ >Направете депозит</a> </li> <li class="menu d-none"><a target href=https://eurofinance.bg/helpdesk/ class=menuArrow>Helpdesk</a><div class="submenu mn_650"><div class=row><div class=col><div class=menuBox><a href=https://eurofinance.bg/helpdesk/how-tos/ ><h4>How-tos</h4><span class="icon icon-info"></span></a></div></div><div class=col><div class=menuBox><a href=https://eurofinance.bg/faq/ ><h4>FAQs</h4><span class="icon icon-faq"></span></a></div></div><div class=col><div class=menuBox><a href=https://eurofinance.bg/tutorials/ ><h4>Tutorials</h4><span class="icon icon-play"></span></a></div></div><div class=col><div class=menuBox><a href=https://eurofinance.bg/support-center/ ><h4>Помощен център</h4><span class="icon icon-support"></span></a></div></div></div></div> </li> </li> </li> </li> </li> <li><a href=mailto:office@eurofinance.bg></i>office@eurofinance.bg</a></li><li><a href="tel:+359 700 156 56"><i class="fa fa-phone rotate-90 mr-1 f-10"></i>+359 700 156 56</a></li></ul></div><div class="bottom-navigation justify-content-end justify-content-lg-between" style="flex: 1;"><ul> <li class="megamenu menu "><div class="hover-menu-item shrink-hidden-item">Услуги</div><div class="hover-menu-item shrinkMenu"><i class="far fa-th"></i></div><div class=submenu><ul class=container> <li class="inline-block hover-menu-item-parent"><div class="p-0 has-sub-submenu hover-menu-item">Реална търговия <span class="d-none d-md-inline">></span></div><ul class="menuInfoList d-none"><li><a href=https://eurofinance.bg/services/ class>Обща информация</a></li><li><a href=https://eurofinance.bg/services/trading/bse/ class>Българска Фондова Борса (БФБ)</a></li><li><a href=https://eurofinance.bg/services/trading/deutscheboerse/ class>Deutsche Börse (Xetra и Frankfurt)</a></li></ul></li><li class=inline-block><a href=https://eurofinance.bg/services/cfds/ class="p-0 ">ДЗР</a></li><li class=inline-block><a href=https://eurofinance.bg/services/wealth-management/ class="p-0 ">Управление на активи</a></li><li class=inline-block><a href=https://eurofinance.bg/services/investment-banking/ class="p-0 ">Инвестиционно банкиране</a></li></ul></div> </li> </li> </li> </li> </li> </li> </li> </li> <li class="megamenu menu "><div class="hover-menu-item shrink-hidden-item">Amundi</div><div class="hover-menu-item shrinkMenu"><i class="far fa-sack-dollar"></i></div><div class=submenu><ul class=container> <li class=inline-block><a href=https://eurofinance.bg/amundi/ class="p-0 ">Обща информация</a></li><li class=inline-block><a href=https://eurofinance.bg/amundi/investment-plan/ class="p-0 ">Инвестиционен план</a></li><li class=inline-block><a href=https://eurofinance.bg/amundi/direct-investments/ class="p-0 ">Директни инвестиции</a></li></ul></div> </li> </li> </li> </li> <li class="megamenu menu "><div class="hover-menu-item shrink-hidden-item">Платформи</div><div class="hover-menu-item shrinkMenu"><i class="far fa-desktop"></i></div><div class=submenu><ul class=container> <li class=inline-block><a href=https://eurofinance.bg/platforms/ef-metatrader-5/ class="p-0 ">EF MetaTrader 5</a></li><li class=inline-block><a href=https://eurofinance.bg/platforms/efocs/ class="p-0 ">EFOCS</a></li></ul></div> </li> </li> </li> <li class="megamenu menu "><div class="hover-menu-item shrink-hidden-item">Още</div><div class="hover-menu-item shrinkMenu"><i class="fas fa-th"></i></div><div class=submenu><ul class=container> <li class=inline-block><a href=https://eurofinance.bg/news/ class="p-0 ">Новини</a></li><li class=inline-block><a href=https://eurofinance.bg/faqs/ class="p-0 ">Помощ</a></li></ul></div> </li> </li> </li></ul><div class=mobileMenuIcon><i class="far fa-bars"></i></div><div class=top-navigation><ul class=left-nav> <li class="newDeposit d-none"> <a target=_blank href=https://payments.eurofinance.bg/ >Направете депозит</a> </li> <li class="menu d-none"><a target href=https://eurofinance.bg/helpdesk/ class=menuArrow>Helpdesk</a><div 