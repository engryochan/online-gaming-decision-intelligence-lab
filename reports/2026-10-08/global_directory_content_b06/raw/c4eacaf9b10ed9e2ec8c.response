  })</script> <script>$('.toggle-sections-button').on('click', function(e) {
    e.preventDefault();
    $moreContainer = $('#' + $(this).data('more-container'));
    $lessContainer = $('#' + $(this).data('less-container'));

    if ($lessContainer.is(":visible")) {
      $moreContainer.show();
      $lessContainer.hide();
      $(this).html("Скрийте");
    } else {
      $lessContainer.show();
      $moreContainer.hide();
      $(this).html("Вижте повече");
    }
  });</script> </body></html>