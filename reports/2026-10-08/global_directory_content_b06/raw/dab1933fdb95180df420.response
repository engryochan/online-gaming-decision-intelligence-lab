    <script>
        function loadedInIframe() {
            return window.self !== window.top;
        }

        window.addEventListener('load', function () {
            if (false === loadedInIframe()) {
                return;
            }

            notifyDocumentSizeChangedToParent();

            $("select, input[type='checkbox'], input[type='radio']").on('change', function () {
                notifyDocumentSizeChangedToParent();
            });
        });
    </script>


    <script>
        var locale = 'en';

        $('.datetimepicker').each(function () {
            var item = $(this);

            var $dateInput = item.find('input[name$="[date]"]');
            $dateInput.prop('type', 'text');
            $dateInput.prop('placeholder', item.attr('placeholder'));
            $dateInput.addClass('js-datepicker');

            // Manually pass the minimum and maximum dates to the datepicker
            // The form type does not allow to pass attributes to the input
            let minimumDate = item.data('date-start-date');
            let maximumDate = item.data('date-end-date');

            if (minimumDate) {
              $dateInput.data('date-start-date', minimumDate);
            }

            if (maximumDate) {
              $dateInput.data('date-end-date', maximumDate);
            }

            var $timeInput = item.find('input[name$="[time]"]');
            $timeInput.prop('placeholder', 'hh:mm');
            $timeInput.prop('type', 'time');
        });

        $('.js-datepicker').datepicker({
            language: locale,
            format: 'dd/mm/yyyy',
            autoclose: true,
            enableOnReadonly: false
        });

        $('.form-wrapper form select').each((index, element) => {
            let $select = $(element);
            let allowCustomValues = $select.hasClass("allow-custom-values");

            $select.select2({
                tags: allowCustomValues,
                language: locale,
                width: '100%'
            });
        });

        </script>

