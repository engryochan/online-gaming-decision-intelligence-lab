ght" data-astro-cid-sz7xmlte>© 2026 EBI Employee Benefits Ireland Limited.<br data-astro-cid-sz7xmlte>All rights reserved.</p> </div> </div> <div class="container regulator" data-astro-cid-sz7xmlte> <p data-astro-cid-sz7xmlte>EBI Employee Benefits Ireland Ltd, trading as &lsquo;Employee Benefits Ireland&rsquo;, is regulated by the Central Bank of Ireland.</p> </div> </footer>  <div id="ebi-cookie-banner" class="ebi-cookie-banner" role="dialog" aria-live="polite" aria-label="Cookie consent" hidden data-astro-cid-garwan2p> <p class="ebi-cookie-text" data-astro-cid-garwan2p>
We use cookies to measure how visitors use this site so we can improve it.
    You can accept or decline analytics cookies at any time. See our
<a href="/docs/EBI_Cookie_Notice_072026.pdf" data-astro-cid-garwan2p>Cookie Notice</a>.
</p> <div class="ebi-cookie-actions" data-astro-cid-garwan2p> <button type="button" id="ebi-cookie-decline" class="ebi-cookie-btn ebi-cookie-btn--ghost" data-astro-cid-garwan2p>Decline</button> <button type="button" id="ebi-cookie-accept" class="ebi-cookie-btn ebi-cookie-btn--solid" data-astro-cid-garwan2p>Accept</button> </div> </div>  <script>
  (function () {
    var KEY = "ebi-analytics-consent";
    var banner = document.getElementById("ebi-cookie-banner");
    if (!banner) return;

    var stored = null;
    try { stored = localStorage.getItem(KEY); } catch (e) {}
    if (stored !== "granted" && stored !== "denied") {
      banner.hidden = false; // no choice yet — ask
    }

    function choose(consent) {
      try { localStorage.setItem(KEY, consent); } catch (e) {}
      if (typeof gtag === "function") {
        gtag("consent", "update", {
          analytics_storage: consent === "granted" ? "granted" : "denied",
        });
      }
      banner.hidden = true;
    }

    document.getElementById("ebi-cookie-accept")
      .addEventListener("click", function () { choose("granted"); });
    document.getElementById("ebi-cookie-decline")
      .addEventListener("click", function () { choose("denied"); });

    // Re-open control: any element with data-ebi-cookie-open re-shows the banner.
    document.querySelectorAll("[data-ebi-cookie-open]").forEach(function (el) {
      el.addEventListener("click", function (e) {
        e.preventDefault();
        banner.hidden = false;
      });
    });
  })();
</script>  <script type="module">const t=document.querySelectorAll(".reveal");if("IntersectionObserver"in window&&t.length){const e=new IntersectionObserver(s=>{s.forEach(r=>{r.isIntersecting&&(r.target.classList.add("is-in"),e.unobserve(r.target))})},{threshold:.12});t.forEach(s=>e.observe(s))}else t.forEach(e=>e.classList.add("is-in"));</script> <script type="module" src="https://static.cloudflareinsights.com/beacon.min.js/v4bc70e2c01a94c73b74392e4234840661791215815920" integrity="sha512-L0ha0OXavK/8okipN9F8BtP84dg9DUhPERbBXzwI6dgTA55d2+yweo3pn5CSFYs45/r8md2+xvUPtTdvTNRfjA==" data-cf-beacon='{"version":"2024.11.0","token":"aefd1e79fc064dbea7b856c1f9294ab1","r":1,"spa":2}' crossorigin="anonymous"></script>
