/* MOBIL FIXES */
@media (max-width: 767px) {

  /* Rækkefølge på kolonner */
  .mobil-kolonner .elementor-container {
    display: flex;
    flex-wrap: wrap;
  }

  .mobil-kolonner .kol-1 { order: 2; }
  .mobil-kolonner .kol-2 { order: 3; }
  .mobil-kolonner .kol-3 { order: 1; }

  /* Fjern sticky */
  #sticky-kapitel-menu,
  .kol-3,
  .kol-3.elementor-sticky--active,
  .elementor-sticky--active {
    position: static !important;
    top: auto !important;
    bottom: auto !important;
    left: auto !important;
    right: auto !important;
    transform: none !important;
  }

  .elementor-sticky__spacer {
    display: none !important;
    height: 0 !important;
  }

  /* Centrering */
  .mobil-kolonner .kol-3 {
    margin-left: auto !important;
    margin-right: auto !important;
    text-align: center !important;
  }

  .mobil-kolonner .kol-3 .elementor-widget-container,
  .mobil-kolonner .kol-3 .elementor-html,
  #sticky-kapitel-menu {
    width: 100% !important;
    text-align: center !important;
  }

  .kapitel-oversigt,
  .kapitel-bokse {
    display: flex !important;
    justify-content: center !important;
    flex-wrap: wrap !important;
    text-align: center !important;
  }
}
</style>
