<style>
  :root{
    --font-Outfit: 'Outfit', -apple-system, BlinkMacSystemFont, 
    'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, 
    Cantarell, 'Helvetica Neue', sans-serif;
  }
  
blockquote,dl,dd,h1,h2,h3,h4,h5,h6,hr,figure,p,pre,address,ul,li,a,div,span,ol,select,input,button,textarea {  margin: 0;
font-size: 18px; font-family: var(--font-Outfit);}
.headerMain .headWrap .navigation ul li a{font-family: var(--font-Outfit);}


</style>  

<script>
  (function() {
    // Only run if FontFace is supported
    if ("FontFace" in window) {
      // Create session storage key for font caching
      const FONT_CACHE_KEY = 'fonts-loaded';
      
      // Check if fonts were previously loaded
      if (sessionStorage.getItem(FONT_CACHE_KEY)) {
        document.documentElement.classList.add('fonts-loaded');
        return;
      }

      // Load fonts and add class when complete
      Promise.all([
        document.fonts.load('400 18px Outfit'),
        document.fonts.load('500 18px Outfit'),
        document.fonts.load('600 18px Outfit'),
        document.fonts.load('700 18px Outfit')
      ]).then(() => {
        document.documentElement.classList.add('fonts-loaded');
        sessionStorage.setItem(FONT_CACHE_KEY, 'true');
      });
    }
  })();
</script>

  
