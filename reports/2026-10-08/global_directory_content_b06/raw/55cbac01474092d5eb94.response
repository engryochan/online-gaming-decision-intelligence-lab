",\"success_redirect_url\":null,\"is_active\":true,\"fields\":[{\"id\":\"d37bc00f-bfb5-4496-85c3-70190b21b707\",\"name\":\"email\",\"type\":\"text\",\"label\":\"Email\",\"placeholder\":\"Enter yo email\",\"help\":null,\"validation\":null,\"width\":\"100\",\"choices\":null,\"required\":true,\"sort\":2}]}}]\n19:I[67411,[\"/_next/static/chunks/2wlgh9vnn0ani.js\",\"/_next/static/chunks/3_5pidpwanyt5.js\",\"/_next/static/chunks/1wg244jbqqw2b.js\",\"/_next/static/chunks/06rcpbwh6iysf.js\",\"/_next/static/chunks/445shp0br1zac.js\",\"/_next/static/chunks/2kimibzxuazyu.js\",\"/_next/static/chunks/0mtfmaed2ovl4.js\",\"/_next/static/chunks/2w2_hvcfq89di.js\",\"/_next/static/chunks/3ma2-1lg9k8pc.js\",\"/_next/static/chunks/1atypd1mah76b.js\",\"/_next/static/chunks/0q122z92yof_5.js\"],\"default\"]\n6:[\"$\",\"$L19\",null,{\"sections\":[{\"id\":\"500ad904-600c-4815-a271-26376c92c12d\",\"background\":\"light\",\"collection\":\"block_hero\",\"item\":{\"id\":\"a5232ac4-12c9-41ee-b884-26577c14184c\",\"headline\":\"Clearing Membership\",\"description\":\"Review the eligibility criteria and regulatory requirements for firms seeking to become direct Clearing Members of Abaxx Clearing.\",\"image\":{\"id\":\"691e05c1-2047-4f5b-acb2-27e8fc8bfca4\",\"modified_on\":\"2025-09-26T19:03:00.504Z\"},\"product_code\":null,\"product_market\":null,\"show_price_carousel\":false},\"sort\":1,\"hide_block\":false},{\"id\":\"97770e7d-b127-4417-b456-b8aff8241172\",\"background\":\"light\",\"collection\":\"block_divider\",\"item\":{\"id\":7},\"sort\":3,\"hide_block\":false},{\"id\":\"d98158dc-6b81-438c-99e6-9d76b8569fbc\",\"background\":\"light\",\"collection\":\"block_two_column\",\"item\":{\"id\":17,\"heading\":\"Membership Requirements\",\"description\":\"\u003cp\u003eTo be considered for Clearing Membership, applicants must meet the following criteria:\u003c/p\u003e\\n\u003cul\u003e\\n\u003cli\u003eHold a Capital Markets Services (CMS) license for dealing in capital markets products, or be a bank licensed in Singapore\u003c/li\u003e\\n\u003cli\u003eMaintain base capital or net head office funds of at least S$5 million (or S$1 million if operating under a relevant restricted CMS license)\u003c/li\u003e\\n\u003cli\u003eContribute to the Guaranty Fund as required\u003c/li\u003e\\n\u003cli\u003eMeet the Monetary Authority of Singapore's fit and proper criteria\u003c/li\u003e\\n\u003cli\u003eBe in good standing, with relevant industry experience\u003c/li\u003e\\n\u003cli\u003eSatisfy creditworthiness criteria established by the Clearing House\u003c/li\u003e\\n\u003cli\u003eMaintain adequate policies, procedures, systems, and internal controls to supervise clearing-related activities\u003c/li\u003e\\n\u003cli\u003eDemonstrate sufficient financial, operational, compliance, and risk management resources to support clearing operations\u003c/li\u003e\\n\u003c/ul\u003e\",\"cta_label\":null,\"cta_link\":null,\"background_color\":\"#FAFAFA\",\"center_content\":null,\"image\":null,\"image_size\":\"{\\\"width\\\":552,\\\"height\\\":542}\",\"video\":null,\"link\":null,\"alt\":null,\"media_type\":\"card\",\"second_content\":null,\"video_source\":\"direct_upload\",\"video_upload\":null,\"reverse_columns\":false,\"card_header\":\"Apply for Membership\",\"card_body\":\"Prospective applicants are invited to initiate the registration process. Following the completion of our registration form, a representative from Abaxx Clearing will be in touch to provide further guidance.\",\"card_subheader\":\"No membership fees apply.\",\"card_cta_label\":\"Register Now\",\"card_cta_link\":\"/resources/start-trading\",\"repeating_cards\":null},\"sort\":4,\"hide_block\":false},{\"id\":\"9348c939-7588-467c-9860-690a313fe8a5\",\"background\":\"light\",\"collection\":\"block_divider\",\"item\":{\"id\":30},\"sort\":5,\"hide_block\":false},{\"id\":\"0a7c2ae9-9c15-4a53-a66b-d5975ad4c9f6\",\"background\":\"light\",\"collection\":\"block_richtext\",\"item\":{\"id\":\"a6431186-b12f-4759-b280-0135c4877278\",\"tagline\":null,\"headline\":null,\"content\":\"\u003cp\u003eApplicants seeking to become members of Abaxx Clearing must satisfy the membership criteria outlined in Chapter 2 of both Exchange \u0026amp; Clearing Rules at the time of their application and continue to meet these requirements as long as they remain Clearing Members.\u003c/p\u003e\",\"alignment\":\"left\"},\"sort\":6,\"hide_block\":false}],\"pageId\":\"627baa3e-7e76-4292-a0ed-fd2d54ca603f\"}]\n1a:I[66137,[\"/_next/static/chunks/2wlgh9vnn0ani.js\",\"/_next/static/chunks/3_5pidpwanyt5.js\",\"/_next/static/chunks/1wg244jbqqw2b.js\",\"/_next/static/chunks/06rcpbwh6iysf.js\"],\"IconMark\"]\n9:null\ne:[[\"$\",\"title\",\"0\",{\"children\":\"Become an Abaxx Exchange Clearing Member | Abaxx Exchange\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Explore Abaxx Clearing Membership, outlining eligibility, regulatory, and operational requirements for firms seeking direct membership.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"canonical\",\"href\":\"https://abaxx.exchange/resources/clearing/membership\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:title\",\"content\":\"Become an Abaxx Exchange Clearing Member\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:description\",\"content\":\"Explore Abaxx Clearing Membership, outlining eligibility, regulatory, and operational requirements for firms seeking direct membership.\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:url\",\"content\":\"https://abaxx.exchange/resources/clearing/membership\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:image\",\"content\":\"https://abexcws.directus.app/assets/6b9aef10-a7f7-4652-8408-f66f2c5cc487?v=1770217749014\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"8\",{\"name\":\"twitter:card\",\"content\":\"summary\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:creator\",\"content\":\"@abaxx_exchange\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"Become an Abaxx Exchange