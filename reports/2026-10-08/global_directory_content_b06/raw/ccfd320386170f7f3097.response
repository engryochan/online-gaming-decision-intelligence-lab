y="" data-bg-overlay="false"><div class="inner-wrap row-bg-layer using-image" ><div class="row-bg viewport-desktop using-image has-tablet has-phone"  style="background-image: url(https://fcx.com.au/wp-content/uploads/2026/09/fcx-hero-banner.png); background-position: center top; "></div><div class="row-bg viewport-tablet using-image"  style="background-image: url(https://fcx.com.au/wp-content/uploads/2025/11/fcx-feature-lines.svg); background-position: center top; "></div><div class="row-bg viewport-phone using-image"  style="background-image: url(https://fcx.com.au/wp-content/uploads/2025/11/fcx-feature-lines.svg); background-position: center top; "></div></div></div><div class="row_col_wrap_12 span_12 dark "><div id="inner-banner"  data-column-margin="default" data-midnight="dark" data-top-percent="8%" data-bottom-percent="8%"  class="wpb_row vc_row-fluid vc_row full-width-section  top_padding_tablet_10pct top_padding_phone_12pct bottom_padding_tablet_10pct bottom_padding_phone_12pct"  style="padding-top: calc(100vw * 0.08); padding-bottom: calc(100vw * 0.08); "><div class="row-bg-wrap" data-bg-animation="none" data-bg-animation-delay="" data-bg-overlay="false"><div class="inner-wrap row-bg-layer using-image" ><div class="row-bg viewport-desktop using-image has-tablet has-phone"  style=""></div><div class="row-bg viewport-tablet using-image"  style="background-image: url(https://fcx.com.au/wp-content/uploads/2025/11/fcx-feature-lines.svg); background-position: ; background-repeat: ; "></div><div class="row-bg viewport-phone using-image"  style="background-image: url(https://fcx.com.au/wp-content/uploads/2025/11/fcx-feature-lines.svg); background-position: ; background-repeat: ; "></div></div></div><div class="row_col_wrap_12 col span_12 dark left"><div style=" color: #2C483B;" class="vc_col-sm-6 wpb_column column_container vc_column_container col" data-cfc="true"  data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" ><div class="vc_column-inner" ><div class="wpb_wrapper"><h1 style="color: #2C483B;text-align: left" class="vc_custom_heading vc_do_custom_heading" >Liquidity solutions on your terms</h1><div class="divider-wrap" data-alignment="default"><div style="height: 60px;" class="divider"></div></div><div class="wpb_text_column wpb_content_element " ><p><span style="font-weight: 400;">Unlock capital or offer liquidity to early investors and employees, while staying private </span></p></div><a class="nectar-button large see-through-2 "  role="button" style=""  href="/contact-us" data-color-override="false"  data-hover-color-override="#FFA300" data-hover-text-color-override="#ffffff"><span>Talk to our team</span></a></div></div></div><div  class="vc_col-sm-6 wpb_column column_container vc_column_container col no-extra-padding inherit_tablet inherit_phone flex_gap_desktop_10px "  data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" ><div class="vc_column-inner" ><div class="wpb_wrapper"></div></div></div></div></div></div></section><section id="fws_6ac6defe42ab6"  data-column-margin="default" data-midnight="light" data-top-percent="3%" data-bottom-percent="3%"  class="nectar_section wpb_row vc_row full-width-section  top_padding_tablet_5pct bottom_padding_tablet_5pct"  style="padding-top: calc(100vw * 0.03); padding-bottom: calc(100vw * 0.03); "><div class="row-bg-wrap" data-bg-animation="none" data-bg-animation-delay="" data-bg-overlay="false"><div class="inner-wrap row-bg-layer using-image" ><div class="row-bg viewport-desktop using-image"  style="background-image: url(https://fcx.com.au/wp-content/uploads/2026/09/bg-muted-green.svg); background-position: right top; "></div></div></div><div class="row_col_wrap_12 span_12 light "><div id="fws_6ac6defe431e5"  data-column-margin="default" data-midnight="dark"  class="wpb_row vc_row-fluid vc_row"  style="padding-top: 0px; padding-bottom: 0px; "><div class="row-bg-wrap" data-bg-animation="none" data-bg-animation-delay="" data-bg-overlay="false"><div class="inner-wrap row-bg-layer" ><div class="row-bg viewport-desktop"  style=""></div></div></div><div class="row_col_wrap_12 col span_12 dark left"><div  class="vc_col-sm-12 wpb_column column_container vc_column_container col no-extra-padding inherit_tablet inherit_phone flex_gap_desktop_10px "  data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" ><div class="vc_column-inner" ><div class="wpb_wrapper"><div class="divider-wrap" data-alignment="default"><div style="height: 100px;" class="divider"></div></div><div class="nectar-split-heading " data-align="left" data-m-align="inherit" data-text-effect="default" data-animation-type="line-reveal-by-space" data-animation-delay="0" data-animation-offset="" data-m-rm-animation="" data-stagger="" data-custom-font-size="false" ><h3 >Why it matters:</h3></div><div class="wpb_text_column wpb_content_element " ><p><span style="font-weight: 400;">As your company grows, the capital and liquidity needs change. Sometimes you need new capital, or you need to give early investors or employees a way out.</span><span style="font-weight: 400;"><br />
</span><span style="font-weight: 400;">Doing each of these as a one-off creates admin burden, compliance risk, and an inconsistent cap table.</span></p><p><span style="font-weight: 400; font-size: 16px;">FCX solves this by providing:</span></p></div><div class="nectar-fancy-ul font_size_desktop_20px font_size_tablet_18px" data-list-icon="icon-salient-check" data-animation="true" data-animation-delay="0" data-color="extra-color-3" data-spacing="default" data-alignment="left"><ul><li><span style="font-weight: 400;">Full control over price, timing and eligibility in whichever transaction type you run</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">A fully regulated, auditable process for every raise, tender or auction</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Australia’s </span><span style="font-weight: 400;">first</span><span style="font-weight: 400;"> ASIC and RBA regulated alternative for company and fund transactions &#8211; providing security and transparency in every transaction<br />
</span></li><li><span style="font-weight: 400;">One admission that covers every transaction type, so you&#8217;re not restarting the process each time</span></li></ul></div><div class="divider-wrap" data-alignment="default"><div style="height: 120px;" class="divider"></div></div></div></div></div></div></div></div></section><section id="fws_6ac6defe448a2"  data-column-margin="default" data-midnight="dark" data-top-percent="8%" data-bottom-percent="8%"  class="nectar_section wpb_row vc_row full-width-section  top_padding_tablet_10pct top_padding_phone_12pct bottom_padding_tablet_10pct bottom_padding_phone_12pct"  style="padding-top: calc(100vw * 0.08); padding-bottom: calc(100vw * 0.08); "><div class="row-bg-wrap" data-bg-animation="none" data-bg-animation-delay="" data-bg-overlay="false"><div class="inner-wrap row-bg-layer" ><div class="row-bg viewport-desktop using-bg-color"  style="background-color: #2C483B; "></div></div></div><div class="row_col_wrap_12 span_12 dark "><div id="fws_6ac6defe44ef0"  data-column-margin="default" data-midnight="dark"  class="wpb_row vc_row-fluid vc_row vc_row-o-equal-height vc_row-flex  top_margin_50px top_margin_tablet_30px"  style="padding-top: 0px; padding-bottom: 0px; "><div class="row-bg-wrap" data-bg-animation="none" data-bg-animation-delay="" data-bg-overlay="false"><div class="inner-wrap row-bg-layer" ><div class="row-bg viewport-desktop"  style=""></div></div></div><div class="row_col_wrap_12 col span_12 dark left"><div  class="vc_col-sm-12 wpb_column column_container vc_column_container col no-extra-padding inherit_tablet inherit_phone flex_gap_desktop_10px "  data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" ><div class="vc_column-inner" ><div class="wpb_wrapper"><div class="nectar-split-heading " data-align="left" data-m-align="inherit" data-text-effect="default" data-animation-type="line-reveal-by-space" data-animation-delay="0" data-animation-offset="" data-m-rm-animation="" data-stagger="" data-custom-font-size="false" ><h3 style=" color: #FDF9EF;">Benefits of using FCX:</h3></div><div class="divider-wrap" data-alignment="default"><div style="height: 50px;" class="divider"></div></div></div></div></div></div></div><div id="fws_6ac6defe45d8e"  data-column-margin="default" data-midnight="dark"  class="wpb_row vc_row-fluid vc_row"  style="padding-top: 0px; padding-bottom: 0px; "><div class="row-bg-wrap" data-bg-animation="none" data-bg-animation-delay="" data-bg-overlay="false"><div class="inner-wrap row-bg-layer" ><div class="row-bg viewport-desktop"  style=""></div></div></div><div class="row_col_wrap_12 col span_12 dark left"><div style=" color: #FDF9EF;" class="vc_col-sm-4 wpb_column column_container vc_column_container col no-extra-padding inherit_tablet inherit_phone " data-cfc="true"  data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" ><div class="vc_column-inner" ><div class="wpb_wrapper"><div class="img-with-aniamtion-wrap " data-max-width="100%" data-max-width-mobile="default" data-shadow="none" data-animation="none" ><div class="inner"><div class="hover-wrap"><div class="hover-wrap-inner">
<img fetchpriority="high" decoding="async" class="img-with-animation skip-lazy" data-delay="0" height="1024" width="1536" data-animation="none" src="https://fcx.com.au/wp-content/uploads/2026/09/fcx-capital-raise-1.jpg" alt="" srcset="https://fcx.com.au/wp-content/uploads/2026/09/fcx-capital-raise-1.jpg 1536w, https://fcx.com.au/wp-content/uploads/2026/09/fcx-capital-raise-1-300x200.jpg 300w, https://fcx.com.au/wp-content/uploads/2026/09/fcx-capital-raise-1-1024x683.jpg 1024w, https://fcx.com.au/wp-content/uploads/2026/09/fcx-capital-raise-1-768x512.jpg 768w, https://fcx.com.au/wp-content/uploads/2026/09/fcx-capital-raise-1-900x600.jpg 900w" sizes="(max-width: 1536px) 100vw, 1536px" /></div></div></div></div><div class="wpb_text_column wpb_content_element " ><p><strong>Capital Raise</strong></p><ul><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Set your own raise size, valuation range and investor profile</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Manage investor onboarding, document signing and settlement in one licensed marketplace</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">No need to search for buyers &#8211; Access FCX’s network of high-quality investors</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Create an auditable and compliant record of every process in every transaction, with integrated KYC and AML checks</span></li></ul></div><div class="nectar-cta  alignment_tablet_default alignment_phone_default display_tablet_inherit display_phone_inherit " data-color="default" data-using-bg="false" data-style="arrow-circle-animation" data-display="block" data-alignment="left" data-text-color="custom" style="--nectar-text-color: #FFA300; --nectar-button-color: var(--nectar-default); --nectar-icon-gap: 10px; "><span style="color: #FFA300;" class="nectar-button-type"><span class="link_wrap" ><a  class="link_text" role="button" href="https://fcx.com.au/capital-raise/"><span class="text">Find out how it works</span><div class="arrow-circle-animation-arrow-wrap"><svg class="arrow-circle-animation-arrow" viewBox="0 0 24 24" fill="currentColor"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg><svg class="arrow-circle-animation-arrow hover" viewBox="0 0 24 24" fill="currentColor"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg></div></a></span></span></div><div class="divider-wrap" data-alignment="default"><div style="height: 150px;" class="divider"></div></div></div></div></div><div style=" color: #FDF9EF;" class="vc_col-sm-4 wpb_column column_container vc_column_container col no-extra-padding inherit_tablet inherit_phone " data-cfc="true"  data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" ><div class="vc_column-inner" ><div class="wpb_wrapper"><div class="img-with-aniamtion-wrap " data-max-width="100%" data-max-width-mobile="default" data-shadow="none" data-animation="none" ><div class="inner"><div class="hover-wrap"><div class="hover-wrap-inner">
<img decoding="async" class="img-with-animation skip-lazy" data-delay="0" height="1024" width="1536" data-animation="none" src="https://fcx.com.au/wp-content/uploads/2026/09/image-2-1.jpg" alt="" srcset="https://fcx.com.au/wp-content/uploads/2026/09/image-2-1.jpg 1536w, https://fcx.com.au/wp-content/uploads/2026/09/image-2-1-300x200.jpg 300w, https://fcx.com.au/wp-content/uploads/2026/09/image-2-1-1024x683.jpg 1024w, https://fcx.com.au/wp-content/uploads/2026/09/image-2-1-768x512.jpg 768w, https://fcx.com.au/wp-content/uploads/2026/09/image-2-1-900x600.jpg 900w" sizes="(max-width: 1536px) 100vw, 1536px" /></div></div></div></div><div class="wpb_text_column wpb_content_element " ><p><strong>Tender Market:</strong></p><ul><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Incentivise shareholders through having a clear exit path &#8211; turn equity or ESOPs into real value</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Stay private on your terms &#8211; avoid the costs and volatility associated with continuous trading</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">No need to search for buyers &#8211; Access FCX’s network of high-quality investors</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Provide transparency and regulation in every transaction through our ASIC and RBA licensing</span></li><li style="font-weight: 400;" aria-level="1"><span style="font-weight: 400;">Retain full control over your cap table</span></li></ul></div><div class="nectar-cta  alignment_tablet_default alignment_phone_default display_tablet_inherit display_phone_inherit " data-color="default" data-using-bg="false" data-style="arrow-circle-animation" data-display="block" data-alignment="left" data-text-color="custom" style="--nectar-text-color: #FFA300; --nectar-button-color: var(--nectar-default); --nectar-icon-gap: 10px; "><span style="color: #FFA300;" class="nectar-button-type"><span class="link_wrap" ><a  class="link_text" role="button" href="https://fcx.com.au/tender-market/"><span class="text">See how it works</span><div class="arrow-circle-animation-arrow-wrap"><svg class="arrow-circle-animation-arrow" viewBox="0 0 24 24" fill="currentColor"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg><svg class="arrow-circle-animation-arrow hover" viewBox="0 0 24 24" fill="currentColor"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg></div></a></span></span></div><div class="divider-wrap" data-alignment="default"><div style="height: 150px;" class="divider"></div></div></div></div></div><div style=" color: #FDF9EF;" class="vc_col-sm-4 wpb_column column_container vc_column_container col no-extra-padding inherit_tablet inherit_phone " data-cfc="true"  data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" ><div class="vc_column-inner" ><div class="wpb_wrapper"><div class="img-with-aniamtion-wrap " data-max-width="100%" data-max-width-mobile="default" data-shadow="none" data-animation="none" ><div class="inner"><div class="hover-wrap"><div class="hover-wrap-inner">
<img decoding="async" class="img-with-animation skip-lazy" data-delay="0" height="1024" width="1536" data-animation="none" src="https://fcx.com.au/wp-content/uploads/2026/09/image-1.jpg" alt="" srcset="https://fcx.com.au/wp-content/uploads/2026/09/image-1.jpg 1536w, https://fcx.com.au/wp-content/uploads/2026/09/image-1-300x200.jpg 300w, https://fcx.com.au/wp-content/uploads/2026/09/image-1-1024x683.jpg 1024w, https://fcx.com.au/wp-content/uploads/2026/09/image-1-768x512.jpg 768w, https://fcx.com.au/wp-content/uploads/2026/09/image-1-900x600.jpg 900w" sizes="(max-width: 1536px) 100vw, 1536px" /></div></div></div></div><div class="wpb_text_column wpb_content_element " ><p><strong>Auction Market:</strong></p><ul><li><span style="font-weight: 400;">Price discovery &#8211; let the market decide the price</span></li><li><span style="font-weight: 400;">Set time and price ranges, then let FCX do the rest</span></li><li><span style="font-weight: 400;">Provide transparency and regulation in every transaction through our ASIC and RBA licensing</span></li><li><span style="font-weight: 400;">Visibility and discretion, allow participants to see a live orderbook as it develops</span></li><li><span style="font-weight: 400;">Access FCX’s wide distribution base</span></li></ul></div><div class="nectar-cta  alignment_tablet_default alignment_phone_default display_tablet_inherit display_phone_inherit " data-color="default" data-using-bg="false" data-style="arrow-circle-animation" data-display="block" data-alignment="left" data-text-color="custom" style="--nectar-text-color: #FFA300; --nectar-button-color: var(--nectar-default); --nectar-icon-gap: 10px; "><span style="color: #FFA300;" class="nectar-button-type"><span class="link_wrap" ><a  class="link_text" role="button" href="https://fcx.com.au/auction-market/"><span class="text">More details</span><div class="arrow-circle-animation-arrow-wrap"><svg class="arrow-circle-animation-arrow" viewBox="0 0 24 24" fill="currentColor"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg><svg class="arrow-circle-animation-arrow hover" viewBox="0 0 24 24" fill="currentColor"><path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z"></path></svg></div></a></span></span></div><div class="divider-wrap" data-alignment="default"><div style="height: 150px;" class="divider"></div></div></div></div></div></div></div><div id="fws_6ac6defe50c9a"  data-br="custom" data-br-applies="bg" data-column-margin="default" data-midnight="light"  class="wpb_row vc_row-fluid vc_row full-width-section  tl_br_40px tr_br_40px bl_br_40px br_br_40px right_padding_100px left_padding_100px top_padding_tablet_100px bottom_padding_tablet_100px right_padding_tablet_50px left_padding_tablet_50px"  style="padding-top: 150px; padding-bottom: 150px; "><div class="row-bg-wrap" data-bg-animation="zoom-out-reveal" data-bg-animation-delay="" data-bg-overlay="true"><div class="inner-wrap row-bg-layer using-image" ><div class="row-bg viewport-desktop using-image using-bg-color"  style="background-image: url(https://fcx.com.au/wp-content/uploads/2026/09/guide.jpg); background-position: center top; background-repeat: no-repeat; background-color: #FDF9EF; "></div></div><div class="row-bg-overlay row-bg-layer" style="background-color:#111111;  opacity: 0.3; "></div></div><div class="row_col_wrap_12 col span_12 light left"><div  class="vc_col-sm-12 wpb_column column_container vc_column_container col centered-text"  data-padding-pos="all" data-has-bg-color="false" data-bg-color="" data-bg-opacity="1" data-animation="" data-delay="0" ><div class="vc_column-inner" ><div class="wpb_wrapper"><div class="nectar-split-heading " data-align="default" data-m-align="inherit" data-text-effect="default" data-animation-type="line-reveal-by-space" data-animation-delay="0" data-animation-offset="" data-m-rm-animation="" data-stagger="" data-custom-font-size