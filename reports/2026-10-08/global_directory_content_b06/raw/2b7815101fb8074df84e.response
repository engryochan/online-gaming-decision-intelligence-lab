    <script type="text/javascript">
        SessionTimeOut = '120' * 60 * 1000;
        if ('' != "")
            SessionExpireAlert(SessionTimeOut);

        function SessionExpireAlert(timeout) {
            var seconds = timeout / 1000;

            $('#minutes').text(fnTimeConverter(seconds));

            setInterval(function () {
                seconds--;
                $('#minutes').text(fnTimeConverter(seconds));
            }, 1000);
            setTimeout(function () {
                //Show Popup before 10 minutes of timeout.
                $find("ctl00_radToolTipSessionExpired").show();
            }, timeout - 600 * 1000);
            setTimeout(function () {
                window.location = "/Show_Doc.aspx?File=SessionExpired.html";
            }, timeout);
        };

        function ResetSession() {
            //Redirect to reset Session.
            window.location = window.location.href;
        }

        function fnCloseSessionExpiryNotification() {
            $find("ctl00_radToolTipSessionExpired").hide();

            if ('' != "")
                SessionExpireAlert(SessionTimeOut);
            return false;
        }

        function fnTimeConverter(seconds) {
            var hours = Math.floor(seconds / 3600);
            var minutes = Math.floor((seconds - (hours * 3600)) / 60);
            var seconds = seconds - (hours * 3600) - (minutes * 60);
            var time = "";

            if (hours != 0) {
                time = hours + ":";
            }
            if (minutes != 0 || time !== "") {
                minutes = (minutes < 10 && time !== "") ? "0" + minutes : String(minutes);
                time += minutes + " minutes : ";
            }
            if (time === "") {
                time = seconds;
            }
            else {
                time += (seconds < 10) ? "0" + seconds : String(seconds);
            }
            return time + " seconds";
        }
        function fnOnSearchClick()
        {
            window.location = "GSResults.aspx?q=" + encodeURIComponent('' + document.getElementById("ctl00_txtSearchBox").value);
            return false;
        }
        function fnEnterKeyPress(event, id) { 
            event = event || window.event;
            if (id == document.getElementById("ctl00_txtSearchBox").id) {
                if(event.keyCode == 13)
                {
                    event.preventDefault();
                    window.location = "GSResults.aspx?q=" + encodeURIComponent(document.getElementById("ctl00_txtSearchBox").value);
                    return false;
                }
            }
            return true;
        }   

        var AdminSite = "ILAwebSite";
    </script>  


            
