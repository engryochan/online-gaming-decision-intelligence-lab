<section class="mp-governance">
	<div class="mp-governance__wr">
		<h2 class="mp-governance__title">Industry Governance</h2>
		<div class="mp-governance__content row no-gutters">
			<div class="mp-governance__content--item col-md-6">
				<h3 class="mp-governance__content--title">28 member board of directors across:</h3>
				<div class="mp-governance__content--number">
					<div class="gradient"></div>
					28				</div>
			</div>
			<ul class="mp-governance__content--list col-md-6">
															<li class="mp-governance__content--list-item">Banking</li>
											<li class="mp-governance__content--list-item">Asset Management</li>
											<li class="mp-governance__content--list-item">Supranational</li>
											<li class="mp-governance__content--list-item">Pension Fund</li>
											<li class="mp-governance__content--list-item">Energy</li>
											<li class="mp-governance__content--list-item">Clearing Business</li>
												</ul>
		</div>
	</div>
	<div class="img-wr">
		<div class="mp-governance__wr">
			<p class="mp-governance__img-title--mobile">Total Member Growth</p>
			<div class="mp-governance__img">
									<img  alt="Member growth graph." data-src="https://membership.isda.org/wp-content/uploads/2026/07/Total-Member-Growth-071526.png" class="lazyload" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /><noscript><img src="https://membership.isda.org/wp-content/uploads/2026/07/Total-Member-Growth-071526.png" alt="Member growth graph."/></noscript>
							</div>
		</div>
	</div>

</section>
<section class="mp-global">
    <div class="mp-global__wr row no-gutters">
        <div class="mp-global__title col-12 col-sm-12 col-lg-5 ">
            <h2>Global Reach, Local Expertise</h2>
        </div>
        <div class="mp-global__content col-12 col-sm-12 col-lg-7">
                                                <p class="mp-global__content--item">ISDA provides a comprehensive front-to-back view across products and regions. Through its global network of committees, members and industry experts from around the world collaborate to reach consensus on important industry issues, develop best practices and drive standardization to make the global derivatives markets safer and more efficient.</p>
                                    <p class="mp-global__content--item">ISDA drives from a position of leadership, using the holistic product approach: we offer our members capital expertise, documentation/protocol solutions, netting and collateral opinions, accounting issues, risk mitigation, and much more.</p>
                                        <a href="https://assets.isda.org/media/d129935a/4d199048.pdf" class="mp-global__content--link btn-hover l-gray" target="_blank">ISDA’s Year in Review <span class="blue-btn" aria-hidden="true"></span></a>
        </div>
    </div>
</section>


