prises">Austria<option value="/belgium/en/professionals">Belgium<option value="/france/en/institutional-enterprises">France<option value="/germany/en/institutional-enterprises">Germany<option value="/italy/en/institutional-enterprises">Italy<option value="/luxembourg/en/institutional-enterprises">Luxembourg<option value="/netherlands/en/institutional-enterprises">Netherlands<option value="/other/en/other">Other<option value="/portugal/en/institutional-enterprises">Portugal<option value="/spain/en/institutional-enterprises">Spain<option value="/switzerland/en/institutional-professionals">Switzerland<option value="/uk/en/institutional-enterprises" class="current" selected disabled>UK</select><div class="fill"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_52cccc9daf2141999d9024263c310d5f"><path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z" /><title id="svgTitle_52cccc9daf2141999d9024263c310d5f">Chevron Down</title></svg></div></div></div><div class="divider me-0"></div><div class="dropdown"><div class="select dropdownResizable"><span></span> <select aria-label="Your Profile" class="dropdownSelect" name="selInvestor" onchange="goToInvestorType()"><option value="" disabled selected>Your Profile<option value="/uk/en/institutional-enterprises" class="current" disabled>Institutional &amp; enterprises<option value="/uk/en/intermediaries-private-investors">Intermediaries &amp; private investors</select><div class="fill"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_024d2a2ea93b41bda8764f27f94df183"><path d="M480-344 240-584l56-56 184 184 184-184 56 56-240 240Z" /><title id="svgTitle_024d2a2ea93b41bda8764f27f94df183">Chevron Down</title></svg></div></div></div><div class="divider me-0"></div><div class="langSwitcher language-switcher hideContent"><div class="first fill">en