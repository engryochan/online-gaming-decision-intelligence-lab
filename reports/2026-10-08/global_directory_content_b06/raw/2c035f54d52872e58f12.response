const triggerControls=Array.from(navigation.querySelectorAll('.mainLink[data-menu-selector] .first, .mainLink[data-menu-selector] a.first, .mainLink[data-menu-selector] button.first'));const topLevelControls=Array.from(navigation.querySelectorAll('.main-links .mainLink .first, .main-links .mainLink a.first, .main-links .mainLink button.first')).filter((control)=>(control.textContent||'').trim().length>0);const menus=Array.from(navigation.querySelectorAll('.megaBlock[data-menu-container]'));const privateMenu=navigation.querySelector('.megaBlock[data-menu-container="private"]');const privateAccordionButtons=privateMenu?Array.from(privateMenu.querySelectorAll('.accordion-button[data-bs-target]')):[];const panelFocusableSelectors='a, button, input, select, textarea, [tabindex]';const languageChooserLinks=Array.from(navigation.querySelectorAll('.language-switcher .language-options a'));const getFocusableElements=(root)=>Array.from(root.querySelectorAll('a, button, input, select, textarea, [tabindex]')).filter((element)=>element.tabIndex>=0);const isVisibleFocusable=(element)=>(element.getClientRects().length>0&&window.getComputedStyle(element).visibility!=='hidden');const focusMainContent=()=>{const mainElement=document.querySelector('main, #main');if(!mainElement){return;}
if(!mainElement.hasAttribute('tabindex')){mainElement.setAttribute('tabindex','-1');}
mainElement.focus({preventScroll:true});};const focusNextTopLevelControl=(selector)=>{const currentIndex=topLevelControls.findIndex((control)=>(control.closest('.mainLink')?.getAttribute('data-menu-selector')===selector));const nextControl=topLevelControls[currentIndex+1];if(nextControl){nextControl.focus({preventScroll:true});return;}
focusMainContent();};const openPrivateAccordionPanel=(button,focusFirstItem=false)=>{if(!button){return;}
const targetSelector=button.getAttribute('data-bs-target');if(!targetSelector){return;}
const panel=privateMenu?.querySelector(targetSelector);if(!panel){return;}
if(!panel.classList.contains('show')){if(window.bootstrap?.Collapse?.getOrCreateInstance){window.bootstrap.Collapse.getOrCreateInstance(panel,{toggle:false}).show();}else{button.click();}}
if(focusFirstItem){panel.querySelector('a, button, input, select, textarea, [tabindex]:not([tabindex="-1"])')?.focus();}};languageChooserLinks.forEach((link)=>{link.setAttribute('tabindex','-1');});triggerControls.forEach((control)=>{const item=control.closest('.mainLink[data-menu-selector]');if(!item){return;}
const selector=item.getAttribute('data-menu-selector');if(!selector){return;}
if(control.classList.contains('no-link')&&!control.hasAttribute('tabindex')){control.setAttribute('tabindex','0');control.setAttribute('role','button');}
control.setAttribute('aria-haspopup','true');control.setAttribute('aria-expanded','false');});const setMenuFocusableState=(menu,isOpen)=>{if(!menu){return;}
menu.setAttribute('aria-hidden',isOpen?'false':'true');menu.querySelectorAll(panelFocusableSelectors).forEach((element)=>{if(isOpen){const originalTabindex=element.getAttribute('data-original-tabindex');if(originalTabindex!==null){element.setAttribute('tabindex',originalTabindex);element.removeAttribute('data-original-tabindex');}else if(element.matches('a, button, input, select, textarea')){element.setAttribute('tabindex','0');}else{element.removeAttribute('tabindex');}}else{if(element.hasAttribute('tabindex')&&!element.hasAttribute('data-original-tabindex')){element.setAttribute('data-original-tabindex',element.getAttribute('tabindex'));}
element.setAttribute('tabindex','-1');}});};const setOpenMenuTabOrder=(menu,isOpen)=>{if(!menu){return;}
menu.querySelectorAll('a, button, input, select, textarea').forEach((element)=>{element.tabIndex=isOpen?0:-1;});};menus.forEach((menu)=>setMenuFocusableState(menu,false));menus.forEach((menu)=>setOpenMenuTabOrder(menu,false));privateAccordionButtons.forEach((button)=>{button.addEventListener('focus',()=>{openPrivateAccordionPanel(button,false);});button.addEventListener('keydown',(event)=>{if(event.key==='Enter'||event.key===' '||event.key==='ArrowDown'){event.preventDefault();openPrivateAccordionPanel(button,true);}});});const clearTriggerState=()=>{triggerControls.forEach((control)=>{const item=control.closest('.mainLink[data-menu-selector]');item?.classList.remove('open');control.setAttribute('aria-expanded','false');});};const closeMenus=()=>{clearTriggerState();menus.forEach((menu)=>{menu.classList.remove('open');setMenuFocusableState(menu,false);setOpenMenuTabOrder(menu,false);});navigation.classList.remove('open');};const openMenu=(selector)=>{if(!selector){closeMenus();return;}
closeMenus();const trigger=navigation.querySelector(`.mainLink[data-menu-selector="${selector}"]`);const menu=navigation.querySelector(`.megaBlock[data-menu-container="${selector}"]`);trigger?.classList.add('open');trigger?.querySelector('.first, a.first, button.first')?.setAttribute('aria-expanded','true');menu?.classList.add('open');setMenuFocusableState(menu,true);setOpenMenuTabOrder(menu,true);navigation.classList.add('open');};triggerControls.forEach((control)=>{const item=control.closest('.mainLink[data-menu-selector]');if(!item){return;}
const selector=item.getAttribute('data-menu-selector');if(!selector){return;}
control.addEventListener('focus',()=>{openMenu(selector);});control.addEventListener('mouseenter',()=>{openMenu(selector);});control.addEventListener('keydown',(event)=>{if((event.key==='ArrowDown'||event.key==='Enter'||event.key===' ')&&selector){event.preventDefault();openMenu(selector);navigation.querySelector(`.megaBlock[data-menu-container="${selector}"] a, .megaBlock[data-menu-container="${selector}"] button, .megaBlock[data-menu-container="${selector}"] input, .megaBlock[data-menu-container="${selector}"] select, .megaBlock[data-menu-container="${selector}"] textarea, .megaBlock[data-menu-container="${selector}"] [tabindex]:not([tabindex='-1'])`)?.focus();}
if(event.key==='Tab'&&!event.shiftKey){event.preventDefault();openMenu(selector);navigation.querySelector(`.megaBlock[data-menu-container="${selector}"] a, .megaBlock[data-menu-container="${selector}"] button, .megaBlock[data-menu-container="${selector}"] input, .megaBlock[data-menu-container="${selector}"] select, .megaBlock[data-menu-container="${selector}"] textarea, .megaBlock[data-menu-container="${selector}"] [tabindex]:not([tabindex='-1'])`)?.focus();}
if(event.key==='Escape'){closeMenus();}});});navigation.addEventListener('keydown',(event)=>{const item=event.target.closest('.mainLink[data-menu-selector]');if(item&&event.key==='Escape'){closeMenus();return;}
if(event.key==='Escape'){closeMenus();}});menus.forEach((menu)=>{menu.addEventListener('keydown',(event)=>{if(event.key!=='Tab'){return;}
const selector=menu.getAttribute('data-menu-container');const focusables=getFocusableElements(menu);const firstPanelItem=focusables[0];const lastPanelItem=focusables[focusables.length-1];if(event.shiftKey&&menu.classList.contains('open')&&event.target===firstPanelItem){event.preventDefault();navigation.querySelector(`.mainLink[data-menu-selector="${selector}"] .first, .mainLink[data-menu-selector="${selector}"] a.first, .mainLink[data-menu-selector="${selector}"] button.first`)?.focus();return;}
if(!event.shiftKey&&menu.classList.contains('open')&&event.target===lastPanelItem){event.preventDefault();closeMenus();focusNextTopLevelControl(selector);}});menu.addEventListener('focusout',(event)=>{if(!menu.classList.contains('open')){return;}
const focusables=getFocusableElements(menu);const lastPanelItem=focusables[focusables.length-1];const nextTarget=event.relatedTarget;if(event.target===lastPanelItem&&(!nextTarget||!menu.contains(nextTarget))){window.setTimeout(()=>{if(menu.classList.contains('open')){closeMenus();focusNextTopLevelControl(selector);}},0);}});});navigation.addEventListener('focusout',function(){window.setTimeout(()=>{if(!navigation.contains(document.activeElement)){closeMenus();}},0);});navigation.addEventListener('mouseleave',closeMenus,false);document.addEventListener('click',(event)=>{if(!navigation.contains(event.target)){closeMenus();}});})();</script><main id="main" aria-label="Home"><div class="umb-block-list"><section class="main-header"><div class="splide mainHeaderSplide"><div class="splide__track"><div class="splide__list"><div class="slider-container splide__slide"><div class="d-none d-md-block background" style="background-image:url('/media/w2qnfuxo/img_0027_retouche.jpg?width=1920&amp;height=1080&amp;v=1db1677a4b4e740')"></div><div class="d-block d-md-none background" style="background-image:url('/media/w2qnfuxo/img_0027_retouche.jpg?width=1920&amp;height=1080&amp;v=1db1677a4b4e740')"></div><div class="content-wrapper medium"><div class="container"><div class="row justify-content-center"><div class="col text-left"><div class="content special-letter"><h1><strong>Asset management.</strong></h1><h6><br>At Edmond de Rothschild Asset Management, we are independent &amp; investment-led with long standing experience of serving global institutional clients. Above all, we are led by our convictions and fully committed to progress.</h6></div></div></div></div></div><div class="slide-overlay"></div><div class="image-credit header light"><div class="container"><div class="row"><div class="col"><div class="d-flex justify-content-end">The 5 arrows of Rothschild by designer Philippe Druillet</div></div></div></div></div></div></div></div></div></section></div><div class="umb-block-list"><section class="text-full-image spacer-70"><div class="background" style="background-color:#"><div class="container"><div class="row"><div class="col"><div class="title"><h2><strong>A unique<br></strong><strong>alternative</strong></h2></div></div></div><div class="row content-container"><div class="col-12 col-lg-6 order-lg-3 ps-lg-80 order-1 image-outer"><div class="copy-container"><div class="image-container"><div class="image-wrapper"><img class="d-none d-md-block" src="/media/vsimycge/220209_mxhpics_sfhm_0268_1.jpg?width=1920&amp;height=1080&amp;v=1db15b976bfb590" alt="Drawing of the amphora for the Eve cuvée, Château de Malengin, Montagne-St. Emilion"> <img class="d-block d-md-none" src="/media/vsimycge/220209_mxhpics_sfhm_0268_1.jpg?width=1920&amp;height=1080&amp;v=1db15b976bfb590" alt="Drawing of the amphora for the Eve cuvée, Château de Malengin, Montagne-St. Emilion"></div></div><div aria-hidden="true" class="image-credit left">Drawing of the amphora for the Eve cuv&#xE9;e, Ch&#xE2;teau de Malengin, Montagne-St. Emilion</div></div></div><div class="col-12 col-lg-6 d-flex align-items-center order-lg-1 order-2"><div class="h-100 d-flex align-items-start"><div class="content"><p>At Edmond de Rothschild Asset Management, we are an independent, investment-led and conviction-driven asset manager with longstanding experience of serving global Institutional clients.<p>We believe finance serves as a catalyst for shaping the future and driving real economic progress. Rooted in a 250 year history of entrepreneurial expertise, we pursue a transformative and proactive investment approach to generate enduring value. Our legacy is one of putting clients’ interests at the centre of our actions - clients such as institutions, private banks and wealth managers based in major markets across Europe, Middle East and Asia.<p>We are fiercely independent, as we remain a 100% family-owned business; always pioneering and entirely following our convictions in everything we do. We act boldly, making committed choices to achieve long-term value creation and offering our clients the opportunity to invest in both public and private market strategies, including Infrastructure Debt, Real Estate and Private Equity.<p>We believe in investing with purpose. The demand for sustainability is engrained within the DNA of Edmond de Rothschild's values. It is expressed through dedicated strategies that combine financial, social, and environmental performance.<p>That is why Edmond de Rothschild Asset Management is one of a kind.</div></div></div></div><div class="row"><div class="col"><div class="section-border"></div></div></div></div></div></section><div class="umb-block-list"><section class="statistic-slider-a spacer-70 wider-arrows"><div class="background" style="background-color:#"><div class="container position-relative z-2"><div class="row"><div class="col"><div class="text-center title"><h2 style="text-align:left"><strong>Key figures</strong></h2><p style="text-align:left">(31/12/2025)</div></div></div><div class="row content-container mt-50"><div class="col-12"><div class="splide statisticSlider" data-splide='{"perPage":"3"}'><div class="splide__track"><div class="splide__list"><div class="slider-container splide__slide"><div class="statistic-item"><div class="icon-wrapper"><img class="icon" src="/media/hi1ncreu/icon_invest_responssable_02.png" alt="Icon Invest Responssable 02"></div><div class="value">107</div><div class="description">Bn EUR under management</div></div></div><div class="slider-container splide__slide"><div class="statistic-item"><div class="icon-wrapper"><img class="icon" src="/media/lj2peidy/icon_edr_assurances_conseils_01.png" alt="Icon Edr Assurances Conseils 01"></div><div class="value">700</div><div class="description">Team members in asset management</div></div></div><div class="slider-container splide__slide"><div class="statistic-item"><div class="icon-wrapper"><img class="icon" src="/media/zczlhupq/icon_corporate_finance_01.png" alt="Icon Corporate Finance 01"></div><div class="value">200&#x2B;</div><div class="description">Investment professionals</div></div></div><div class="slider-container splide__slide"><div class="statistic-item"><div class="icon-wrapper"><img class="icon" src="/media/1t1aeeic/icon_corporate_finance_03.png" alt="Icon Corporate Finance 03"></div><div class="value">20&#x2B;</div><div class="description">Distribution in countries worldwide</div></div></div><div class="slider-container splide__slide"><div class="statistic-item"><div class="icon-wrapper"><img class="icon" src="/media/3dyjfpc3/icon_gerants_patrimoine_ext_02.png" alt="Icon Gerants Patrimoine Ext 02"></div><div class="value">7</div><div class="description">Expertise in major asset classes</div></div></div></div></div></div></div></div><div class="row"><div class="col"><div class="section-border"></div></div></div></div></div></section></div><section class="group-cards spacer-70"><div class="background" style="background-color:#"><div class="container"><div class="row"><div class="col"><div class="title"><h2><strong>Our investment&nbsp;</strong><br><strong>strategies</strong></h2></div></div></div><div class="row cards"><div class="col-lg-6 col-xl-3 align-items-center"><div class="card shrinkingBox" style="background-image:url('/media/sogll2li/2024_websiteam-assets_v1_7.jpg')"><a href="/uk/en/institutional-enterprises/our-investment-strategies/equities"><div class="content row-height-1"><div class="inner-title"><div class="fittingText"><p>Equities</div><div class="icon"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_428626ee0f904716bc1384a1384f07f2"><path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z" /><title id="svgTitle_428626ee0f904716bc1384a1384f07f2">Add</title></svg></div></div><div class="description">An active and conviction-led approach applying a range of strategies to build concentrated portfolios aimed at generating consistent risk-adjusted returns over the long term.</div></div></a></div></div><div class="col-lg-6 col-xl-3 align-items-center"><div class="card shrinkingBox" style="background-image:url('/media/ae3jadia/2024_websiteam-assets_v1_8.jpg')"><a href="/uk/en/institutional-enterprises/our-investment-strategies/fixed-income"><div class="content row-height-1"><div class="inner-title"><div class="fittingText"><p>Fixed Income</div><div class="icon"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_513c0a84a7c2450295df8008755b8c0c"><path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z" /><title id="svgTitle_513c0a84a7c2450295df8008755b8c0c">Add</title></svg></div></div><div class="description">An experienced team, innovators in strategies covering the main bond market segments and with a long track record in high yield, subordinated and emerging market debt.</div></div></a></div></div><div class="col-lg-6 col-xl-3 align-items-center"><div class="card shrinkingBox" style="background-image:url('/media/yjxdw1i1/ui5a7577.jpg')"><a href="/uk/en/institutional-enterprises/our-investment-strategies/multi-asset-overlay"><div class="content row-height-1"><div class="inner-title"><div class="fittingText"><p>Multi-Asset &amp; Overlay</div><div class="icon"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_0541ebc2faf64081a3faa0c67abbabed"><path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z" /><title id="svgTitle_0541ebc2faf64081a3faa0c67abbabed">Add</title></svg></div></div><div class="description">A fundamental top-down approach with a disciplined risk-control overlay, providing a range of investment solutions and achieving optimal risk-adjusted returns.</div></div></a></div></div><div class="col-lg-6 col-xl-3 align-items-center"><div class="card shrinkingBox" style="background-image:url('/media/1ppg5cxd/qwant_1_bis.jpg')"><a href="/uk/en/institutional-enterprises/our-investment-strategies/quantitative-investing"><div class="content row-height-1"><div class="inner-title"><div class="fittingText"><p>Quantitative investing</div><div class="icon"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_7240a690143242049d240e5d8e62149f"><path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z" /><title id="svgTitle_7240a690143242049d240e5d8e62149f">Add</title></svg></div></div></div></a></div></div><div class="col-lg-6 col-xl-4 align-items-center"><div class="card shrinkingBox" style="background-image:url('/media/h4epaur4/2024_websiteam-assets_v1_11.jpg')"><a href="/uk/en/institutional-enterprises/our-investment-strategies/private-equity"><div class="content row-height-2"><div class="inner-title"><div class="fittingText"><p>Private Equity</div><div class="icon"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_8239bbbcbee7438a8b236f85e39b77f7"><path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z" /><title id="svgTitle_8239bbbcbee7438a8b236f85e39b77f7">Add</title></svg></div></div><div class="description">A platform based on a partnership business model offering distinctive and pioneering strategies that combine sustainability and profitability.</div></div></a></div></div><div class="col-lg-6 col-xl-4 align-items-center"><div class="card shrinkingBox" style="background-image:url('/media/y3wjbncv/2024_websiteam-assets_v1_12.jpg')"><a href="/uk/en/institutional-enterprises/our-investment-strategies/real-estate"><div class="content row-height-2"><div class="inner-title"><div class="fittingText"><p>Real Estate</div><div class="icon"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_8b613e323d2d451faecb7ea648140659"><path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z" /><title id="svgTitle_8b613e323d2d451faecb7ea648140659">Add</title></svg></div></div><div class="description">A pan-European platform with strong local roots (local presence and local knowledge). A comprehensive offer of strategies, from investment to portfolio management, with a strong focus on sustainability.</div></div></a></div></div><div class="col-lg-6 col-xl-4 align-items-center"><div class="card shrinkingBox" style="background-image:url('/media/bd5jwoc5/2024_websiteam-assets_v1_10.jpg')"><a href="/uk/en/institutional-enterprises/our-investment-strategies/infrastructure-debt"><div class="content row-height-2"><div class="inner-title"><div class="fittingText"><p>Infrastructure Debt</div><div class="icon"><svg role="img" xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#e8eaed" aria-labelledby="svgTitle_929dca6a33494adda6a0295df875d43c"><path d="M440-440H200v-80h240v-240h80v240h240v80H520v240h-80v-240Z" /><title id="svgTitle_929dca6a33494adda6a0295df875d43c">Add</title></svg></div></div><div class="description">A leading infrastructure platform, in the top ten globally, deploying flexible strategies to finance key themes including Energy transition, Digital, Transport, Social and Cleaner Utilities.</div></div></a></div></div></div><div class="row"><div class="col"><div class="section-border"></div></div></div></div></div></section><section class="spacer-70 filter-articles-extra"><div class="background" style="background-color:#"><div class="filter-articles p-0 m-0"><div class="container"><div class="row"><div class="col"><div class="outer-title"><h2><strong>Latest thought<br>leadership</strong></h2></div></div></div></div><div class="container"><div class="row articles mt-60"><div class="col-12 col-md-3"><a href="/en/news/show/8761-17719-healthcare-a-new-wave-driven-by-innovation-ai" class="d-block no-hover"><div class="image-wrapper smaller"><img src="/media/ubgfp5nf/_rl_87.jpg?width=1920&amp;height=1080&amp;v=1dd566bdf15f330" alt="Healthcare: A New Wave of Progress Driven by Innovation and AI
"></div><article class="content-container mb-0"><p class="category">Market Analysis, Expert Interview<h3 class="title">Healthcare: A New Wave of Progress Driven by Innovation and AI&#xA;</h3><p class="date">07/10/2026<div class="excerpt"><p>After several months of strong performance in the healthcare sector, Adeline SALAT-BAROUX and Sébastien MALAFOSSE, equity fund managers, review recent developments in the healthcare sector. They examine scientific advances, the resurgence in funding, and the acceleration of mergers and acquisitions (M&amp;A). They also analyze the long-term opportunities offered by artificial intelligence and innovation in healthcare.</div></article></a></div><div class="col-12 col-md-3"><a href="/en/news/show/8761-17705-asset-management-market-flash-pressure-on-interest-rates-is-mounting" class="d-block no-hover"><div class="image-wrapper smaller"><img src="/media/enxoaipv/market-flash-generic.png?width=1920&amp;height=1080&amp;v=1daf39a663bf710" alt="Asset Management Market Flash: Pressure on Interest Rates Is Mounting"></div><article class="content-container mb-0"><p class="category">Market Analysis<h3 class="title">Asset Management Market Flash: Pressure on Interest Rates Is Mounting</h3><p class="date">02/10/2026<div class="excerpt"><ul><li><p>The strength of the U.S. economy is driving yields higher, despite a PCE reading that fell short of expectations. However, markets expect the Fed to maintain its current policy stance in October, with yield curves steepening.<li><p>Long-term rates are rising, particularly in France, where the spread over Germany exceeds 140 basis points. Fiscal and political uncertainties are fuelling concerns about the sustainability of French debt.<li><p>Oil prices are stabilizing at high levels, while tensions over diesel remain.</ul></div></article></a></div><div class="col-12 col-md-3"><a href="/en/news/show/8761-17654-letter-from-the-cio-am-a-new-paradigm-for-the-markets-active-management-matters-more-than-ever" class="d-block no-hover"><div class="image-wrapper smaller"><img src="/media/3sqjsq53/2024_website-assets_4.jpg?width=1920&amp;height=1080&amp;v=1dd36dcb77e5dc0" alt="Letter from the CIO AM: A New Paradigm for the Markets: Active Management Matters More Than Ever."></div><article class="content-container mb-0"><p class="category">Market Analysis<h3 class="title">Letter from the CIO AM: A New Paradigm for the Markets: Active Management Matters More Than Ever.</h3><p class="date">25/09/2026<div class="excerpt"><p>Just a few months ago, the outlook seemed relatively clear: the&nbsp;slowdown in inflation was expected to allow central banks to gradually&nbsp;support the economic cycle through rate cuts. That outlook has&nbsp;now faded into the past.<p>In both the United States and Europe, the resilience of the economy&nbsp;and the return of inflationary pressures have led central banks to&nbsp;resume their monetary tightening policies. The Fed raised rates by 25&nbsp;basis points in September, while the ECB had taken the same step a&nbsp;few days earlier. But beyond these decisions, it is above all the shift&nbsp;in the direction of monetary policy that, in our view, is of particular&nbsp;importance.<p>Growth is not just holding steady. It is robust, particularly in the United&nbsp;States, and the rise of artificial intelligence is driving growth across&nbsp;many sectors. Furthermore, inflation remains a clear concern. Central&nbsp;banks must remain vigilant, and markets must learn to adapt without&nbsp;the ongoing support of accommodative monetary policy. Against this&nbsp;backdrop, we look ahead to the months to come.</div></article></a></div><div class="col-12 col-md-3"><a href="/en/news/show/8761-17662-asset-management-market-flash-pressure-is-mounting-on-risk-assets" class="d-block no-hover"><div class="image-wrapper smaller"><img src="/media/enxoaipv/market-flash-generic.png?width=1920&amp;height=1080&amp;v=1daf39a663bf710" alt="Asset Management Market Flash: Pressure is mounting on risk assets"></div><article class="content-container mb-0"><p class="category">Market Analysis<h3 class="title">Asset Management Market Flash: Pressure is mounting on risk assets</h3><p class="date">25/09/2026<div class="excerpt"><ul><li><p>Persistently high interest rates are dominating the markets: rising U.S. yields are increasing pressure on growth stocks and risky assets.<li><p>Europe remains vulnerable due to energy risks and rising tensions over French debt, for which borrowing costs are increasing significantly.<li><p>We are continuing to focus our portfolio allocation on short- to intermediate-term bonds and remain positive on stocks, particularly U.S. stocks, while we have begun to take some profits.</ul></div></article></a></div></div></div><div class="container"><div class="row"><div class="col"><div class="section-border"></div></div></div></div></div></div></section><section class="column-boxes spacer-70"><div class="background" style="background-color:#"><div class="container"><div class="row"><div class="col"><div class="title"></div></div></div><div class="row boxes"><div class="col-lg-6 box"><div class="h-100"><div class="row g-0 h-100"><div class="col-md-5 col-xxl-6"><div class="image-wrapper"><img src="/media/v1nmpubj/ground-copy-copy.jpg" alt="Ground Copy"></div></div><div class="col-md-7 col-xxl-6"><div class="content"><div class="description"><h3>Sustainable investing</h3><p>We are ready to support our clients' journeys to sustainability. We bring a clear and considered ESG approach, which we have tried and tested over time.</div><a href="/uk/en/institutional-enterprises/sustainability"> Find out more <span class="skip-link"> (<h3>Sustainable investing</h3><p>We are ready to support our clients' journeys to sustainability. We bring a clear and considered ESG approach, which we have tried and tested over time.</p>)</span> </a></div></div></div></div></div><div class="col-lg-6 box"><div class="h-100"><div class="row g-0 h-100"><div class="col-md-5 col-xxl-6"><div class="image-wrapper"><img src="/media/vmbgm5ut/chateau-clarke-cession-3-balanca-145.jpg" alt="Chateau Clarke Cession 3 Balanca (145)"></div></div><div class="col-md-7 col-xxl-6"><div class="content"><div class="description"><h3>Our investment strategies</h3><p>We look towards the future, and we are committed to achieving long term value creation for our clients.</div><a href="/uk/en/institutional-enterprises/our-investment-strategies"> Find out more <span class="skip-link"> (<h3>Our investment strategies</h3><p>We look towards the future, and we are committed to achieving long term value creation for our clients.</p>)</span> </a></div></div></div></div></div></div><div class="row"><div class="col"><div class="section-border"></div></div></div></div></div></section></div><div class="spacer- position-relative"></div></main><footer><div class="container"><div class="row"><div class="col"><ul class="footer-navigation"><li class="navigation-item"><div class="title">Our House</div><ul class="navigation-links"><li><a href="https://www.edmond-de-rothschild.com/en/our-history" target="_blank" rel="noopener noreferrer" class="link" title="Our history" alt="Our history">Our history</a><li><a href="/uk/en/institutional-enterprises/who-we-are" class="link" title="Who we are" alt="Who we are">Who we are</a><li><a href="https://www.edmond-de-rothschild.com/en/governance" target="_blank" rel="noopener noreferrer" class="link" title="Governance" alt="Governance">Governance</a><li><a href="https://www.edmond-de-rothschild.com/en/our-headquarters" class="link" title="Our headquarters" alt="Our headquarters">Our headquarters</a><li><a href="https://www.edmond-de-rothschild.com/en/at-the-heart-of-the-world" target="_blank" rel="noopener noreferrer" class="link" title="Our locations" alt="Our locations">Our locations</a></ul><li class="navigation-item"><div class="title">Candidates</div><ul class="navigation-links"><li><a href="https://www.edmond-de