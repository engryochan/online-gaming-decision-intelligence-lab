<script>
 	  var mndFields44844000000642476=new Array('Contacts.First\x20Name','Contacts.Last\x20Name','Contacts.Phone','Contacts.Email','Contacts.CONTACTCF3','Potential\x20Name','Accounts.Account\x20Name','Accounts.ACCOUNTCF6','Accounts.ACCOUNTCF9','Accounts.ACCOUNTCF7','Accounts.Website','Contacts.CONTACTCF8');
 	  var fldLangVal44844000000642476=new Array('First Name','Last Name','Phone','Email','Role','Entity Name','Confirm Entity Name','Entity ABN or ACN&#x2f;Country','Industry Segment','Business Focus&#x2f;What It Does','Website','How did you hear about us&#x3f;');
 	 var wfInnerWidth = window.innerWidth;
 	 if(wfInnerWidth <= 768){
 	 	 document.forms['BiginWebToRecordForm44844000000642476'].setAttribute('data-ux-form-alignment', 'top');
 	 }
 	const backgroundDiv = document.getElementsByClassName('wf-parent')[0];

 	if(backgroundDiv.style.backgroundImage) {
 	 	 const imageUrl = backgroundDiv.style.backgroundImage.split(/"/)[1];
 	 	 backgroundDiv.style.backgroundImage = '';
 	 	 backgroundDiv.style.backgroundColor = '#EAEEF2'
 	 	 // Create a new Image object
 	 	 const img = new Image();
 	 	 // Set the src of the Image object to the same URL
 	 	 img.src = imageUrl;
 	 	 // Trigger the onload event when the image is fully loaded
 	 	 img.onload = function() {
 	 	 backgroundDiv.style.backgroundImage = `url(${imageUrl})`;
 	};
 	// Handle any potential errors
 	img.onerror = function() {
 	 	console.error('Failed to load the background image.');
 	};
