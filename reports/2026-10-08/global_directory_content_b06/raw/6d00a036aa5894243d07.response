<style id="wp-custom-css">
/* Change the background color of the arrow container */
.ast-icon.icon-arrow {
background-color: #336e63 !important;
display: inline-flex; /* Keeps size minimal and aligns content */
justify-content: center; /* Centers the arrow horizontally */
align-items: center; /* Centers the arrow vertically */
width: 40px; /* Set a specific width for the square */
height: 40px; /* Set a specific height for the square */
border-radius: 4px; /* Optional: Rounded corners */
box-sizing: border-box; /* Ensures padding doesn’t affect size */
}
/* Ensure the arrow color remains as is or set it explicitly */
.ast-arrow-svg path {
fill: #ffffff; /* Keeps the arrow white */
width: 16px; /* Set a specific size for the arrow */
height: 16px; /* Match arrow dimensions */
}
.is-style-stripes table tbody tr:nth-child(odd) {
background-color: #336e63 !important; /* Apply the green color */
color: #ffffff; /* Change text color to white for better contrast */
}
.is-style-stripes table tbody tr:nth-child(odd) td {
color: #ffffff; /* Ensure table cell text is white */
}
.pum-container {
border-radius: 20px !important;
overflow: hidden;
}
.pum-content a:hover {
}
body.page-id-517 #ast-hf-menu-1,
body.page-id-636 #ast-hf-menu-1,
body.page-id-646 #ast-hf-menu-1 {
display: none !important;
}
/* Hide the Client Agreement menu item on specific pages and all posts */
body.page-id-516 #menu-item-519,
body.page-id-422 #menu-item-519,
body.page-id-460 #menu-item-519,
body.single-post #menu-item-519 {
display: none !important;
}
@media (max-width: 921px) {
body.page-id-157 button.menu-toggle.main-header-menu-toggle {
display: none !important;
}
}
@media (max-width: 768px) {
.wp-block-media-text__media img {
max-width: 80px; /* tweak as needed */
height: auto;
}
}
/* Force the disclosure footer row and all its inner wrappers to the same colour */
.site-primary-footer-wrap,
.site-primary-footer-wrap .ast-builder-grid-row-container-inner,
.site-primary-footer-wrap .site-primary-footer-inner-wrap,
.site-primary-footer-wrap .site-footer-primary-section-1,
.site-primary-footer-wrap .ast-footer-html-1,
.site-primary-footer-wrap .ast-header-html,
.site-primary-footer-wrap .ast-builder-html-element {
background: #eeeeee !important;
}
/* Remove any border or shadow creating a visual split */
.site-primary-footer-wrap {
border-top: none !important;
box-shadow: none !important;
margin-top: 0 !important;
}
/* Tidy spacing */
.site-primary-footer-wrap .ast-builder-grid-row-container-inner {
padding-top: 1px;
padding-bottom: 6px;
}
/* Disclosure text styling */
.bsl-promo-note {
margin: 0 !important;
text-align: center;
font-size: 12px;
line-height: 1.4;
color: #666666;
}
/* Hide all disclaimer links by default */
.disclaimer-london,
.disclaimer-espana,
.disclaimer-dubai {
display: none !important;
}
/* Espana pages */
body.page-id-646 .disclaimer-espana,
body.page-id-654 .disclaimer-espana {
display: inline-block !important;
}
/* Dubai page */
body.page-id-636 .disclaimer-dubai {
display: inline-block !important;
}
/* London pages */
body.page-id-516 .disclaimer-london,
body.page-id-517 .disclaimer-london {
display: inline-block !important;
}
/* Hide all Market Notices header links by default */
.Market-Notices-London,
.Market-Notices-Espana {
display: none !important;
}
/* London page (516) */
body.page-id-516 .Market-Notices-London {
display: inline-block !important;
}
/* España page (654) */
body.page-id-654 .Market-Notices-Espana {
display: inline-block !important;
}
</style>
