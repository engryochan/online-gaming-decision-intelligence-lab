ht.svg);-webkit-mask-size:contain;-webkit-mask-repeat:no-repeat;-webkit-mask-position:center;mask-image:url(/icons/magna/ArrowRight.svg);mask-size:contain;mask-repeat:no-repeat;mask-position:center;color:var(--color-default-dark)"></span></button></div></div></div></div></section><div class="w-full bg-white"><div class="relative w-full h-[var(--spacer-height)]" style="--spacer-height:clamp(6rem, calc(6rem + 4 * ((100vw - 20rem) / 76)), 10rem)" aria-hidden="true"></div></div><section class="w-full bg-white"><div class=""><div class="relative overflow-hidden bg-white"><div class="dot-grid block " style="position:relative;width:100%;height:100%"><svg class="block absolute inset-0 size-full z-[1] pointer-events-none" aria-hidden="true"></svg><div class="relative w-full h-full " style="z-index:4"><div class="px-page-margin"><div class="mx-auto w-full max-w-screen-2xl"><div class="w-full h-30" aria-hidden="true"></div><div class="flex flex-col xl:max-w-5xl items-center text-center mx-auto [[data-theme=dark]_&amp;]:text-white"><h2 class="font-heading text-balance text-heading-sm xl:text-heading-md bg-white px-3 py-1">Related resources</h2></div><div class="w-full h-16" aria-hidden="true"></div><ul class="list-none m-0 p-0 flex flex-col gap-4 sm:grid sm:gap-6 sm:grid-cols-2 xl:grid-cols-4"><li class="flex" data-resource-card=""><a href="/sg/en/learn/startups/equity-management/cap-table/?ir=corps_captable_related1" aria-label="What is a cap table?" class="group relative flex flex-col items-start bg-white p-4 md:p-6 outline-none focus-visible:outline-2 focus-visible:outline-solid focus-visible:outline-offset-2 focus-visible:outline-black flex-1"><span class="inline-flex items-center justify-center overflow-hidden shrink-0 size-7 bg-coral absolute top-0 right-0 transition-colors duration-200 ease-out motion-reduce:transition-none group-hover:bg-gray"><span aria-hidden="true" class="inline-block shrink-0 bg-current size-3.5" style="-webkit-mask-image:url(/icons/magna/ArrowRight