		<style id="wp-custom-css">
			/* Insights - tab filter - underline */

.insights_tab_filter a {
  position: relative;
  text-decoration: none;
  color: inherit;
}

.insights_tab_filter a::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -4px; /* gap from text */
  width: 100%;
  height: 2px;
  background: #56BBA8;

  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s ease;
}

.insights_tab_filter a:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}

/*  Hover out direction */

.insights_tab_filter a:not(:hover)::after {
  transform-origin: right;
}

/* Home page - feature box (market/services) - text */

.homepagemarketserviceboxes-text{
	min-height:116px;
}

@media (max-width: 1024px) {
    .homepagemarketserviceboxes-text{
	min-height:1px !important;
}
}

/* Anchor link - move position up because of sticky header */

#marketdataanchor{
	position:relative;
	top:-180px;
}


#technicaldocumentationanchor{
	position:relative;
	top:-180px;
}

/* Trading services - boxes (bullet boxes ) */

.tradingservices-bullet-boxes hr{
	 border: none;
  height: 1px;
  background-color: #5A6C8A; 
  margin: 20px 0;
}


/* Typography */

h1{
	font-size:64px;
	line-height:1.1em !important;
	font-weight:300 !important;
} 


h2{
	font-size:40px;
	line-height:1.1em !important;
	font-weight:300 !important;
} 

/* Services page - why BPX */

.services-why h4{
	color:#FFF;
}

/* Buttons - in accordions */

.e-n-accordion-item a.elementor-button {
    width: 400px;
	max-width:100%;
}


/* About us - line */

.twae-h-line {
height:2px !important;
}


/* About us - timeline - box */


.twae-content {
    border-radius: 20px !important;
    box-shadow: none !important;
	border-right:1px solid #D6D6D6 !important;
	border-bottom:1px solid #D6D6D6 !important;
  border-left:1px solid #D6D6D6 !important;


}


/* About page - Timeline - changing icon - overriding the clock icon */

i.far.fa-clock::before {
  content: "\f054"; /* Unicode for fa-solid fa-chevron-right */
  font-weight: 700;
}


/* About page - Timeline - change the icon border */

.twae-icon{
border:4px solid #57BBA9 !important
}

/* Header - CTA */

.uicore-header-wrapper{}



.uicore-header-wrapper a.uicore-btn {
  background-color: #2D3D54 !important;  /* main color */
  color: #fff;
  border-radius:5px;
  transition: all 0.3s ease;
}

.uicore-header-wrapper a.uicore-btn:hover {
  background-color: #010101 !important; 

}


/* Accordion - icon styling - Market sub pages */

.marketaccordion .elementor-icon {
  background-color: #56BBA8; 
  color: #fff;
	/*border: 5px solid #FFF;*/
	/*box-shadow: 0 0 10px 3px rgba(86,187,171, 0.8);*/
  border-radius: 50%;
  width: 130px; 
  height: 130px; 
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28px;
}

/* Market page - Services - heading */

/* CSS for screens larger than 767px (desktop and large tablets) */
@media (min-width: 768px) {
    .markets_services_heading{
	min-height:70px;
}
}

/* Navigation - sub menu */
ul.sub-menu li a{
	font-weight:normal !important;
}


/* Contact form - mailing list */

.mailinglistform{
	
}

.formleftcol{
	float:left;
	width: calc(50% - 10px);
	margin-right:10px;
}


.formrightcol{
		float:left;
	width:50%;
}



/* Mobile and below */
@media (max-width: 767px) {
  
.formleftcol{
	float:none !important;
	width: 100% !important;
	margin-right:0px !important;
}


.formrightcol{
		float:none !important;
	width:100% !important;
}
}

.mailinglistform input[type="submit"] {
 width:100% !important;
	height:50px !important;
  background-color: #56BBA8;
  color: #fff;
  padding: 12px 30px;
  border: none !important;
  border-radius: 5px;
  cursor: pointer;
  font-size: 16px;
  font-weight: 600;
}

/* Contact form - Contact page*/

.wpcf7 input, 
.wpcf7 select, 
.wpcf7 textarea {
  margin: 0 0 15px !important;
  border: 1px solid #2D3D54 !important;
  border-radius: 5px !important;
  background: #F1F4F5;
}

.wpcf7 input::placeholder {
  
	font-style:italic;
}

/* Wrap the submit button in a container and center it */
.wpcf7 .wpcf7-submit-wrapper {
  text-align: center;
}

/* Style the button */
.wpcf7 input[type="submit"] {
  display: inline-block;   /* keep it inline so text-align works */
  background-color: #56BBA8;
  color: #fff;
  padding: 12px 30px;
  border: none !important;
  border-radius: 5px;
  cursor: pointer;
  font-size: 16px;
  font-weight: 600;
}

.wpcf7 input[type="submit"]:hover {
  background-color: #3D8678;
}		</style>
