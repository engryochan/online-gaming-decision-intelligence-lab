			<!-- 1.4 uicore_before_content -->		<div data-elementor-type="wp-page" data-elementor-id="488" class="elementor elementor-488" data-elementor-settings="{&quot;element_pack_global_tooltip_width&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;element_pack_global_tooltip_width_tablet&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;element_pack_global_tooltip_width_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;size&quot;:&quot;&quot;,&quot;sizes&quot;:[]},&quot;element_pack_global_tooltip_padding&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;top&quot;:&quot;&quot;,&quot;right&quot;:&quot;&quot;,&quot;bottom&quot;:&quot;&quot;,&quot;left&quot;:&quot;&quot;,&quot;isLinked&quot;:true},&quot;element_pack_global_tooltip_padding_tablet&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;top&quot;:&quot;&quot;,&quot;right&quot;:&quot;&quot;,&quot;bottom&quot;:&quot;&quot;,&quot;left&quot;:&quot;&quot;,&quot;isLinked&quot;:true},&quot;element_pack_global_tooltip_padding_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;top&quot;:&quot;&quot;,&quot;right&quot;:&quot;&quot;,&quot;bottom&quot;:&quot;&quot;,&quot;left&quot;:&quot;&quot;,&quot;isLinked&quot;:true},&quot;element_pack_global_tooltip_border_radius&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;top&quot;:&quot;&quot;,&quot;right&quot;:&quot;&quot;,&quot;bottom&quot;:&quot;&quot;,&quot;left&quot;:&quot;&quot;,&quot;isLinked&quot;:true},&quot;element_pack_global_tooltip_border_radius_tablet&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;top&quot;:&quot;&quot;,&quot;right&quot;:&quot;&quot;,&quot;bottom&quot;:&quot;&quot;,&quot;left&quot;:&quot;&quot;,&quot;isLinked&quot;:true},&quot;element_pack_global_tooltip_border_radius_mobile&quot;:{&quot;unit&quot;:&quot;px&quot;,&quot;top&quot;:&quot;&quot;,&quot;right&quot;:&quot;&quot;,&quot;bottom&quot;:&quot;&quot;,&quot;left&quot;:&quot;&quot;,&quot;isLinked&quot;:true}}">
				<div class="elementor-element elementor-element-883ecf2 e-flex e-con-boxed e-con e-parent" data-id="883ecf2" data-element_type="container" data-e-type="container">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-80ba0d5 e-con-full e-flex e-con e-child" data-id="80ba0d5" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-c09e825 elementor-widget__width-initial elementor-widget elementor-widget-heading" data-id="c09e825" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h1 class="elementor-heading-title elementor-size-default">Pioneering digital markets for institutions</h1>				</div>
				<div class="elementor-element elementor-element-950996c elementor-widget__width-initial elementor-widget elementor-widget-text-editor" data-id="950996c" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p><span style="font-weight: 400;">BPX is a UK-authorised and regulated securities marketplace for the admission, trading, and lending of alternative assets such as real estate, infrastructure, private credit funds, and digital assets, including tokenised or digitally native money market funds.</span></p>								</div>
				</div>
					</div>
				</div>
		<div class="elementor-element elementor-element-7ead6fd e-flex e-con-boxed e-con e-parent" data-id="7ead6fd" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
				<div class="elementor-element elementor-element-4ca2f3e elementor-widget elementor-widget-heading" data-id="4ca2f3e" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">Our story</h2>				</div>
					</div>
				</div>
		<div class="elementor-element elementor-element-07d0be2 e-flex e-con-boxed e-con e-parent" data-id="07d0be2" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-c9aca90 e-con-full e-flex e-con e-child" data-id="c9aca90" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-7aceafe elementor-widget elementor-widget-heading" data-id="7aceafe" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">Our goal is simple: to modernise securities market infrastructure for alternative assets</h2>				</div>
				<div class="elementor-element elementor-element-2519ee2 elementor-widget elementor-widget-text-editor" data-id="2519ee2" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p>Established by industry leaders with decades of experience across capital markets, fintech and digital innovation, BPX was built to deliver access, liquidity and regulatory assurance for issuers and investors in alternative and digital assets.</p>								</div>
				<div class="elementor-element elementor-element-0bf29ad elementor-widget elementor-widget-button" data-id="0bf29ad" data-element_type="widget" data-e-type="widget" data-widget_type="button.default">
										<a class="elementor-button elementor-button-link elementor-size-sm" href="https://bpx.exchange/contact/">
						<span class="elementor-button-content-wrapper">
									<span class="elementor-button-text">Contact our team</span>
					</span>
					</a>
								</div>
				</div>
		<div class="elementor-element elementor-element-fc44bdf e-con-full e-flex e-con e-child" data-id="fc44bdf" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-a8661c2 elementor-widget elementor-widget-text-editor" data-id="a8661c2" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p>By combining the regulatory strength of traditional finance with the efficiency and scalability of digital markets, BPX provides institutions with a secure, compliant and future-ready foundation for participation in alternative asset classes and the tokenised economy. We connect legacy and DLT systems through composable architecture, delivering frictionless securities lifecycle management from issuance and trading to lending and custody.</p>								</div>
				</div>
					</div>
				</div>
		<div class="elementor-element elementor-element-764828e e-flex e-con-boxed e-con e-parent" data-id="764828e" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-ec65830 e-con-full e-flex e-con e-child" data-id="ec65830" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
		<div class="elementor-element elementor-element-c362758 e-con-full e-flex e-con e-child" data-id="c362758" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-6fdbf68 elementor-widget elementor-widget-text-editor" data-id="6fdbf68" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<p><img loading="lazy" decoding="async" class="alignnone size-full wp-image-406" src="https://bpx.exchange/wp-content/uploads/2025/10/quote-blue.png" alt="" width="47" height="35" /> </p><p><em><i><span style="font-weight: 400;">BPX exists to modernise the investment process – from issuance to execution – without compromising on regulatory trust or institutional-grade infrastructure.</span></i>”</em></p><p>Tony Scawthorn, BPX MD.</p>								</div>
				</div>
		<div class="elementor-element elementor-element-2ec40b0 e-con-full e-flex e-con e-child" data-id="2ec40b0" data-element_type="container" data-e-type="container">
				<div class="elementor-element elementor-element-ac0395d elementor-widget elementor-widget-text-editor" data-id="ac0395d" data-element_type="widget" data-e-type="widget" data-widget_type="text-editor.default">
									<h2>Led by market practitioners</h2><p><span style="font-weight: 400;">Built by a team of capital markets </span><span style="font-weight: 400;">and financial technology</span><span style="font-weight: 400;"> professionals, BPX blends decades of trading and technology expertise to deliver efficient, compliant market infrastructure.</span></p>								</div>
				</div>
				</div>
				<div class="elementor-element elementor-element-15ffc4c elementor-widget elementor-widget-heading" data-id="15ffc4c" data-element_type="widget" data-e-type="widget" id="teammembers" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">The team driving market innovation</h2>				</div>
		<div class="elementor-element elementor-element-a570463 e-con-full e-flex e-con e-child" data-id="a570463" data-element_type="container" data-e-type="container">
