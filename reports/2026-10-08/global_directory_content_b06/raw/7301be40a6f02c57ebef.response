<fieldset data-drupal-selector="edit-datashop" id="edit-datashop" class="js-form-item form-item js-form-wrapper form-group col-auto">
      <legend>
    <span class="fieldset-legend"></span>
  </legend>
  <div class="fieldset-wrapper">
            <fieldset data-drupal-selector="edit-datashop-user" id="edit-datashop-user" class="js-form-item form-item js-form-wrapper form-group col-auto">
      <legend>
    <span class="fieldset-legend"></span>
  </legend>
  <div class="fieldset-wrapper">
            <label for="datashop_user" class="ftsz150">I want to access the <a href="https://live.euronext.com/datashop" target="_blank">Euronext Data Shop</a><button type="button" class="btn btn-link p-0 pb-2 border-0" role="button" data-toggle="popover" data-placement="bottom" data-trigger="focus" data-html="true" data-content="The Data Shop allows you to find and buy the data products offered by Euronext." data-original-title="" title="">
                                  <div class="svg_container">
                                    <svg width="24" height="24">
                                      <use xlink:href="/themes/custom/euronext_connect/frontend-library/public/assets/spritemap.svg#info"></use>
                                    </svg>
                                  </div>
                                </button></label><div class="custom-control custom-radio"><input id="DataShopUserYes" class="custom-control-input form-radio form-control" data-drupal-selector="edit-datashop-user" type="radio" name="datashop_user" value="1" /><div class="custom-control-label" for="DataShopUserYes">Yes</div></div><div class="custom-control custom-radio"><input id="DataShopUserNo" class="custom-control-input form-radio form-control" checked="checked" data-drupal-selector="edit-datashop-user" type="radio" name="datashop_user" value="0" /><div class="custom-control-label" for="DataShopUserNo">No</div></div>
          </div>
</fieldset>
<fieldset class="row js-form-item form-item js-form-wrapper form-group col-auto" style="display:none" data-drupal-selector="edit-user-profile" data-drupal-states="{&quot;invisible&quot;:[{&quot;:input[name=\u0022datashop_user\u0022]&quot;:{&quot;value&quot;:&quot;0&quot;}}]}" id="edit-user-profile">
      <legend>
    <span class="fieldset-legend">What will be my data use?</span>
  </legend>
  <div class="fieldset-wrapper">
            <div class="">
                <div class="custom-control custom-radio custom-radio-card"><input id="customRadioCardAcademic" class="custom-control-input form-radio form-control" data-drupal-selector="edit-user-profile" type="radio" name="user_profile" value="Academic" /><div class="custom-control-label" for="customRadioCardAcademic">Academic Use</div>
                <p class="subtitle pl-3 ">The Euronext data will be used for non-commercial academic research purposes performed by a student and/or faculty member at an accredited academic institution. The use case does not include any redistribution of the Euronext data and/or of original created works to third parties. As defined in the applicable terms and conditions available <a target="_blank" href="/datashop-documents/terms_use_academic">here</a>.</p></div></div><div class="">
                <div class="custom-control custom-radio custom-radio-card"><input id="customRadioCardBusiness" class="custom-control-input form-radio form-control" data-drupal-selector="edit-user-profile" type="radio" name="user_profile" value="Business" /><div class="custom-control-label" for="customRadioCardBusiness">Business Use</div>
                <p class="subtitle pl-3 ">The Euronext data will be used for commercial purposes by a business. The use case does not include any redistribution of the Euronext data and/or of original created works to third parties. As defined in the applicable terms and conditions available <a target="_blank" href="/datashop-documents/terms_use_business">here</a>.</p></div></div><div class="">
                <div class="custom-control custom-radio custom-radio-card"><input id="customRadioCardPrivateInvestor" class="custom-control-input form-radio form-control" data-drupal-selector="edit-user-profile" type="radio" name="user_profile" value="Private_Investor" /><div class="custom-control-label" for="customRadioCardPrivateInvestor">Private Investor Use</div>
                <p class="subtitle pl-3 ">The Euronext data will be used solely for managing my own personal property. I am not purchasing the Euronext data as principal, officer, partner, employee or agent neither of a business and/or academic institution nor on behalf of any other individual. My use case does not include any redistribution of the Euronext data and/or of original created works to third parties. As defined in the applicable terms and conditions available <a target="_blank" href="/datashop-documents/terms_use_private">here</a>.</p></div></div>
          </div>
</fieldset>
<fieldset style="display:none" data-drupal-selector="edit-new-company" data-drupal-states="{&quot;invisible&quot;:[{&quot;:input[name=\u0022user_profile\u0022]&quot;:{&quot;value&quot;:&quot;Private_Investor&quot;}},&quot;or&quot;,{&quot;:input[name=\u0022user_profile\u0022]&quot;:{&quot;checked&quot;:false}},&quot;or&quot;,{&quot;:input[name=\u0022datashop_user\u0022]&quot;:{&quot;value&quot;:&quot;0&quot;}}],&quot;disabled&quot;:[{&quot;:input[name=\u0022user_profile\u0022]&quot;:{&quot;value&quot;:&quot;Private_Investor&quot;}},&quot;or&quot;,{&quot;:input[name=\u0022user_profile\u0022]&quot;:{&quot;checked&quot;:false}},&quot;or&quot;,{&quot;:input[name=\u0022datashop_user\u0022]&quot;:{&quot;value&quot;:&quot;0&quot;}}]}" id="edit-new-company" class="js-form-item form-item js-form-wrapper form-group col-auto">
