                            <div class="memberships">
                                            <div class="memberships__item" data-id="16" data-type="0" data-region="1" style="display: none;">
                          <div class="memberships__item--content">
                            <div class="memberships__item--image">
                                                                    <img src="https://aixkz-com.s3.eu-central-1.amazonaws.com/photos/17/ags_-1.png" title="Abylai Global Solutions Ltd">
                                                            </div>
                            <div class="memberships__item--name">
                              <div>Abylai Global Solutions Ltd</div>
                              <svg width="15" height="14" viewBox="0 0 15 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6.96967 10.4125C7.26256 10.7053 7.73744 10.7053 8.03033 10.4125L12.8033 5.63948C13.0962 5.34659 13.0962 4.87172 12.8033 4.57882C12.5104 4.28593 12.0355 4.28593 11.7426 4.57882L7.5 8.82146L3.25736 4.57882C2.96447 4.28593 2.48959 4.28593 2.1967 4.57882C1.90381 4.87172 1.90381 5.34659 2.1967 5.63948L6.96967 10.4125ZM6.75 9.05859L6.75 9.88212L8.25 9.88212L8.25 9.05859L6.75 9.05859Z" fill="#C09A5D"/>
                              </svg>
                            </div>
