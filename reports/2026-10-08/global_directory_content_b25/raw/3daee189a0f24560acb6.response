items-center gap-10 lg:grid-cols-[1.5fr_1fr] lg:gap-16"><div><div class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-7 text-nasd-red-500" aria-hidden="true"><path fill="currentColor" d="M10 5.874a.833.833 0 1 0 0-1.667a.833.833 0 0 0 0 1.667m6 7.466V8h.092c.893 0 1.26-1.148.53-1.665l-5.85-4.152a1.33 1.33 0 0 0-1.544 0L3.376 6.335c-.728.517-.363 1.664.53 1.664H4v5.34c-.601.386-1 1.06-1 1.827v1.333a.5.5 0 0 0 .5.5h13a.5.5 0 0 0 .5-.5v-1.333c0-.767-.398-1.441-1-1.826M9.806 2.999a.33.33 0 0 1 .385 0l5.639 4H4.168zm5.192 5v5.006a2 2 0 0 0-.166-.006h-1.834V8zM5 13.005V8h2v5H5.166q-.084 0-.167.006m.167.994h9.667c.644 0 1.166.522 1.166 1.167V16H4v-.833C4 14.522 4.523 14 5.167 14M9.5 13H8V8h1.5zm1 0V8H12v5z"/></svg><h2 class="text-3xl font-bold tracking-tight text-neutral-900 sm:text-4xl">Central Security Depository</h2></div><p class="mt-5 text-base leading-relaxed text-neutral-700">Central Securities Clearing System Plc (CSCS) is the appointed Central Securities Depository (CSD) for NASD. It handles clearing and settlement of trades using a Delivery versus Payment model.</p><p class="mt-4 text-base leading-relaxed text-neutral-700">CSCS securely holds securities in electronic form and provides efficient depository services. It also issues ISINs for admitted securities when required. For more information, visit CSCS <a href="https://www.cscs.ng" target="_blank" rel="noopener noreferrer" class="font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500">www.cscs.ng</a></p></div><div class="mx-auto flex aspect-square w-full max-w-xs items-center justify-center overflow-hidden rounded-full border border-neutral-200 p-8"><img src="/marketing/markets/cscs-logo.png" alt="Central Securities Clearing System Plc (CSCS)" width="220" height="157" loading="lazy" class="h-auto w-full object-contain"></div></div><div class="mt-12"><h3 class="text-xl font-semibold text-neutral-900">Settlement Cycle</h3><div class="mt-4 overflow-hidden rounded-2xl border border-neutral-200"><table class="w-full text-left text-sm"><thead class="border-b border-neutral-200 bg-neutral-50 text-neutral-900"><tr><th scope="col" class="px-6 py-4 font-semibold">Class</th><th scope="col" class="px-6 py-4 font-semibold">Settlement Cycle</th></tr></thead><tbody class="divide-y divide-neutral-200 bg-white text-neutral-700"><tr><td class="px-6 py-4 font-medium text-neutral-900">Equity</td><td class="px-6 py-4">T + 1</td></tr><tr><td class="px-6 py-4 font-medium text-neutral-900">N-DSP</td><td class="px-6 py-4">T + 0</td></tr></tbody></table></div></div></div></section></main><section class="bg-white py-16 sm:py-20" aria-labelledby="newsletter-heading"><div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8"><h2 id="newsletter-heading" class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl">Join our newsletter</h2><p class="mt-3 text-base text-neutral-700 sm:text-lg">Stay informed with the latest market updates, insights, and announcements from NASD.</p><form data-newsletter-form action="/api/newsletter" method="post" novalidate class="mt-8 flex flex-col items-stretch gap-3 sm:mx-auto sm:max-w-xl sm:flex-row"><label for="newsletter-email" class="sr-only">Email address</label><input id="newsletter-email" name="email" type="email" required maxlength="254" autocomplete="email" placeholder="Enter email" data-newsletter-email class="w-full rounded-md border border-neutral-300 bg-white px-4 py-3 text-sm text-neutral-900 placeholder:text-neutral-400 focus:border-nasd-blue-600 focus:outline-none focus:ring-2 focus:ring-nasd-blue-600/30 sm:flex-1"><!-- Honeypot: hidden from users; bots that fill it are silently dropped. --><div aria-hidden="true" class="absolute left-[-9999px] h-0 w-0 overflow-hidden"><label>Company<input type="text" name="company" tabindex="-1" autocomplete="off"></label></div><button type="submit" data-newsletter-submit class="inline-flex items-center justify-center gap-2 rounded-md bg-nasd-blue-600 px-6 py-3 text-sm font-medium text-white transition-colors hover:bg-nasd-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nasd-blue-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60"><span data-newsletter-label>Join our newsletter</span><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" role="img" aria-label="Submit"><path fill="currentColor" d="M10.837 3.13a.5.5 0 0 0-.674.74L16.33 9.5H2.5a.5.5 0 0 0 0 1h13.828l-6.165 5.628a.5.5 0 0 0 .674.739l6.916-6.314a.747.747 0 0 0 0-1.108z"/></svg></button></form><!-- Turnstile renders here once the script lazy-loads (on first focus). --><div data-turnstile data-sitekey="0x4AAAAAAEV4dakQgTkdy09O" data-action="newsletter" class="mt-4 flex min-h-[65px] justify-center sm:mx-auto sm:max-w-xl [&amp;:empty]:min-h-0"></div><p data-newsletter-status role="status" aria-live="polite" class="mt-3 text-sm"></p></div></section><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script type="module">document.querySelectorAll(`[data-newsletter-form]`).forEach(e=>{let t=e.querySelector(`[data-newsletter-email]`),n=e.querySelector(`[data-newsletter-submit]`),r=e.querySelector(`[data-newsletter-label]`),i=e.closest(`section`),a=i.querySelector(`[data-turnstile]`),o=i.querySelector(`[data-newsletter-status]`),s,c=!1;function l(e,t){o.textContent=e,o.className=`mt-3 text-sm ${t?`text-success-700`:`text-nasd-red-700`}`}function u(){if(c||s!==void 0)return;c=!0;let e=()=>{let e=window.turnstile;e&&(s=e.render(a,{sitekey:a.dataset.sitekey,action:a.dataset.action,appearance:`interaction-only`}))};if(window.turnstile){e();return}let t=document.createElement(`script`);t.src=`https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit`,t.async=!0,t.defer=!0,t.onload=e,document.head.appendChild(t)}t.addEventListener(`focus`,u,{once:!0});function d(){let t=e.querySelector(`[name="cf-turnstile-response"]`);if(t?.value)return t.value;let n=window.turnstile;return s!==void 0&&n?n.getResponse(s)??``:``}e.addEventListener(`submit`,async i=>{i.preventDefault();let a=t.value.trim();if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(a)||a.length>254){l(`Please enter a valid email address.`,!1),t.focus();return}u();let o=d();if(!o){l(`Please complete the verification, then try again.`,!1);return}n.disabled=!0,r.textContent=`Subscribing…`;try{let t=await fetch(`/api/newsletter`,{method:`POST`,headers:{"content-type":`application/json`},body:JSON.stringify({email:a,token:o,company:``})}),n=await t.json().catch(()=>({}));l(n.message??(t.ok?`Thanks for subscribing.`:`Something went wrong.`),!!n.ok),n.ok&&e.reset()}catch{l(`Network error. Please try again.`,!1)}finally{let e=window.turnstile;s!==void 0&&e&&e.reset(s),n.disabled=!1,r.textContent=`Join our newsletter`}})});</script><footer class="border-t border-neutral-200 bg-white"><div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"><!-- 5-column grid: brand + 4 nav columns --><div class="grid grid-cols-1 gap-10 md:grid-cols-2 lg:grid-cols-5"><!-- Column 1: brand block --><div class="space-y-5"><a href="/" class="inline-flex items-center " aria-label="NASD PLC home"><img src="/logos/NASD-PLC-1-1.png" alt="NASD PLC" class="w-auto h-8" width="320" height="80" loading="lazy" decoding="async"></a><p class="text-xs leading-relaxed text-neutral-600">The NASD OTC Securities Exchange is an Over The Counter (OTC) market and a Self-Regulatory Organisation, registered with and regulated by the Securities and Exchange Commission, Nigeria. NASD is also a member of the Association of Securities Exchanges of Africa (ASEA), the Lagos Chamber of Commerce and Industry (LCCI), and the Association of Securities Exchanges of Nigeria (ASEN).</p><div class="flex flex-wrap gap-3"><a href="/get-started" class="inline-flex items-center rounded-md bg-nasd-blue-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-nasd-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nasd-blue-600 focus-visible:ring-offset-2">Get Started</a><!--
            NASD: "Live Market links to the OTC Market Watch page not the
            admitted securities page." It pointed at /markets/admitted
            (Admitted Securities); OTC Market Watch is /markets/statistics.

            Get Started above stays on /get-started deliberately: that page
            offers both routes — "Raise capital on NASD" and "Open an account
            and invest" — which suits a footer button serving both audiences,
            where /investors/get-started is investor-only.
          --><a href="/markets/statistics" class="inline-flex items-center rounded-md border border-neutral-300 bg-white px-5 py-2.5 text-sm font-medium text-neutral-900 transition-colors hover:bg-neutral-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nasd-blue-600 focus-visible:ring-offset-2">Live Market</a></div></div><!-- Column 2: Markets --><div><h3 class="mb-3 text-sm font-semibold text-neutral-900">Markets</h3><ul class="space-y-2.5"><li><a href="/markets/admitted" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Admitted Companies</a></li><li><a href="/markets/introduce" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Introduce a Company</a></li><li><a href="/markets/watchlist" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Watchlist</a></li><li><a href="/markets/delisted" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Delisted &amp; Suspended Companies</a></li><li><a href="/markets/commercial-paper" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Commercial Paper</a></li><li><a href="/markets/bonds" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Bonds</a></li><li><a href="/markets/indices" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Indices</a></li><li><a href="/markets/price-list" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Price List</a></li><li><a href="/markets/reports" class="text-xs text-neutral-600 hover:text-nasd-blue-600 focus-visible:outline-none focus-visible:underline">Trade Reports</a></li><li><a href="/markets/data-portal" class="te