ine-none sm:pl-6"></label></div></div></nav><main><section class="bg-nasd-blue-50"><div class="mx-auto max-w-7xl px-4 pb-12 pt-16 sm:px-6 sm:pb-16 sm:pt-20 lg:px-8"><div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.3fr_1fr] lg:gap-12"><div><h1 class="text-4xl font-bold tracking-tight text-neutral-900 sm:text-5xl lg:text-6xl">Members &amp; Partners</h1><p class="mt-5 max-w-xl text-base text-neutral-700 sm:text-lg">Explore the network of brokers, dealers, and partners driving the NASD market.</p><div class="mt-8 flex flex-wrap gap-3"><a href="#partner-list" class="inline-flex items-center gap-2 rounded-lg border border-nasd-blue-900 bg-white px-5 py-3 text-sm font-medium text-nasd-blue-900 hover:bg-nasd-blue-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nasd-blue-600 focus-visible:ring-offset-2">Members &amp; Partners List<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path fill="currentColor" d="M16.867 10.837a.5.5 0 1 0-.739-.674l-5.63 6.168V2.5a.5.5 0 0 0-1 0v13.828l-5.629-6.165a.5.5 0 0 0-.738.674l6.314 6.916a.747.747 0 0 0 1.108 0z"/></svg></a><a href="#join" class="inline-flex items-center gap-2 rounded-lg border border-nasd-blue-900 bg-white px-5 py-3 text-sm font-medium text-nasd-blue-900 hover:bg-nasd-blue-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nasd-blue-600 focus-visible:ring-offset-2">Joining as an Operator<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path fill="currentColor" d="M16.867 10.837a.5.5 0 1 0-.739-.674l-5.63 6.168V2.5a.5.5 0 0 0-1 0v13.828l-5.629-6.165a.5.5 0 0 0-.738.674l6.314 6.916a.747.747 0 0 0 1.108 0z"/></svg></a><a href="#csd" class="inline-flex items-center gap-2 rounded-lg border border-nasd-blue-900 bg-white px-5 py-3 text-sm font-medium text-nasd-blue-900 hover:bg-nasd-blue-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nasd-blue-600 focus-visible:ring-offset-2">CSD<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true"><path fill="currentColor" d="M16.867 10.837a.5.5 0 1 0-.739-.674l-5.63 6.168V2.5a.5.5 0 0 0-1 0v13.828l-5.629-6.165a.5.5 0 0 0-.738.674l6.314 6.916a.747.747 0 0 0 1.108 0z"/></svg></a></div></div><div class="overflow-hidden rounded-3xl bg-white p-2 ring-1 ring-nasd-blue-100"><img src="/marketing/markets/members-hero.webp" alt="Network of brokers, dealers and partners on NASD" width="436" height="284" loading="eager" fetchpriority="high" decoding="async" class="h-full w-full rounded-2xl object-cover"></div></div></div></section><section id="join" class="bg-neutral-50 py-16 sm:py-20"><div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8"><div class="rounded-2xl border border-neutral-200 bg-white p-6 sm:p-10"><h2 class="text-2xl font-bold tracking-tight text-neutral-900 sm:text-3xl">Joining as an Operator</h2><p class="mt-2 text-sm text-neutral-700 sm:text-base">Follow these steps if you'd like to join NASD OTC exchange as an operator.</p><div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-10"><div class="rounded-xl border border-neutral-200 p-6"><h3 class="border-b border-neutral-200 pb-3 text-base font-semibold text-neutral-900">Joining as a Trading Member</h3><ol class="mt-5 space-y-4"><li class="flex items-start gap-3 text-sm leading-relaxed text-neutral-700"><span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-nasd-red-500 text-xs font-semibold text-nasd-red-500">1</span><span>Complete <a href="https://nasdspace.sfo3.digitaloceanspaces.com/nasd-web/documents/library/NASD-FORM-1A-Participating-Institutions-Registration-Form-2025.pdf" class="font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500">NASD Form 1a</a></span></li><li class="flex items-start gap-3 text-sm leading-relaxed text-neutral-700"><span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-nasd-red-500 text-xs font-semibold text-nasd-red-500">2</span><span>Complete <a href="https://nasdspace.sfo3.digitaloceanspaces.com/nasd-web/documents/library/NASD-Form-1b-Registration-as-an-Authorised-Trader-V3.pdf" class="font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500">NASD Form 1b</a></span></li><li class="flex items-start gap-3 text-sm leading-relaxed text-neutral-700"><span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-nasd-red-500 text-xs font-semibold text-nasd-red-500">3</span><span>Submit completed form and non-refundable fees payable in full at the time of application, accompanied by the listed supporting documents to <a href="/cdn-cgi/l/email-protection#a5c9c0c2c4c9c6cac8d5c9ccc4cbc6c0e5cbc4d6c1cbc28bc6cac8" class="font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500"><span class="__cf_email__" data-cfemail="8be7eeeceae7e8e4e6fbe7e2eae5e8eecbe5eaf8efe5eca5e8e4e6">[email&#160;protected]</span>.</a></span></li></ol><a href="/markets/documents" class="mt-5 inline-block max-w-md text-sm text-neutral-700"><span class="font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500">Download the full admission document</span> to see supporting documents and payable fees</a><!--
                NASD row 225: this section needed a button that opens a modal
                for submitting details. The formal T-Form application still
                lives at /markets/operator; this is the shorter route in.
              --><div class="mt-5 flex flex-wrap items-center gap-3"><button type="button" data-open-modal="operator-interest" class="inline-flex items-center rounded-md bg-nasd-blue-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-nasd-blue-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-nasd-blue-600 focus-visible:ring-offset-2">Submit your details</button><a href="/markets/operator" class="text-sm font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500">Or complete the full application</a></div></div><div class="rounded-xl border border-neutral-200 p-6"><h3 class="border-b border-neutral-200 pb-3 text-base font-semibold text-neutral-900">Joining as a Non-trading Member</h3><ol class="mt-5 space-y-4"><li class="flex items-start gap-3 text-sm leading-relaxed text-neutral-700"><span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-nasd-red-500 text-xs font-semibold text-nasd-red-500">1</span><span>Complete <a href="https://nasdspace.sfo3.digitaloceanspaces.com/nasd-web/documents/library/NASD-Form-1b-Registration-as-an-Authorised-Trader-V3.pdf" class="font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500">NASD Form 1b</a></span></li><li class="flex items-start gap-3 text-sm leading-relaxed text-neutral-700"><span class="mt-0.5 inline-flex size-5 shrink-0 items-center justify-center rounded-full border border-nasd-red-500 text-xs font-semibold text-nasd-red-500">2</span><span>Submit completed form and non-refundable fees payable in full at the time of application, accompanied by the listed supporting documents to <a href="/cdn-cgi/l/email-protection#016d6466606d626e6c716d68606f6264416f6072656f662f626e6c" class="font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500"><span class="__cf_email__" data-cfemail="83efe6e4e2efe0eceef3efeae2ede0e6c3ede2f0e7ede4ade0ecee">[email&#160;protected]</span>.</a></span></li></ol><a href="/markets/documents" class="mt-5 inline-block max-w-md text-sm text-neutral-700"><span class="font-medium text-nasd-blue-600 underline underline-offset-2 hover:text-nasd-blue-500">Download the full admission document</span> to see supporting documents and payable fees</a><!--
