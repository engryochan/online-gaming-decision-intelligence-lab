            <script>
                (function ($) {
                    var cardCalendarSwiper;
                    var calendarRecord = [];
                    var dynamicCardData = [];
                    var systemCardData = [];
                    var cardHeightListData = [];

                    var minMonth = 1;
                    var maxMonth = 1;

                    document.addEventListener("DOMContentLoaded", function (event) {
                        //$(document).ready(function () {
                        if ($(this).attr("data-prev-month") != "") {
                            minMonth = parseInt($(".hkex_card__datepicker").attr("data-prev-month"));
                        }
                        if ($(this).attr("data-after-month") != "") {
                            maxMonth = parseInt($(".hkex_card__datepicker").attr("data-after-month"));
                        }
                        cardViewInit();
                        $.when(
                            GetSpDataCard(),
                            GetDynamicDataCard(),
                            getSystemStatusDataCard(),
                            GetSpCalendar()
                        ).done(function () {
                            dynamicCardInit();
                            getcardHeightListData();
                            initSystemStatusCard();
                            swiperInit();
                            cardCalendarInit();
                            setTimeout(function () {
                                TriggerResize();
                            }, 500);
                        });
                    });

                    $(document).ready(function () {
                        $(".hkex-card-block-section").fadeIn(800);
                        setTimeout(function () {
                            TriggerResize();
                        }, 500);
                    });

                    //can't click video with view more
                    $(document).ready(function () {
                        var sss = document.querySelectorAll('section.hkexweb-hero-banner__bottom.section-main-card');
                        sss.forEach(function (e, i, a) {
                            e.querySelectorAll('div[id^="card"]').forEach(function (element, index, array) {
                                if (element.id.startsWith('card') && element.getAttribute("data-col-span") == '1' && element.children.length > 0&& !element.children[0].classList.contains('hkex_card__swiper')){
                                    let hrefCard='';
                                    let targetCard='';
                                     if(element.querySelector('.video_popup')!=null){
                                         hrefCard=element.querySelector('.video_popup').getAttribute('href');
                                         targetCard=element.querySelector('.video_popup').getAttribute('target');
                                        replaceA_Div(element.querySelector('.video_popup'),'div');
                                     }
                                     if(element.querySelector('.hkex_card__more')!=null){
                                         hrefCard=element.querySelector('.hkex_card__more').getAttribute('href');
                                         targetCard=element.querySelector('.hkex_card__more').getAttribute('target');
                                         replaceA_Div(element.querySelector('.hkex_card__more'),'div');
                                     }
                                     if(element.querySelector('.video_popup')!=null || element.querySelector('.hkex_card__more')!=null){
                                         replaceA_Div(element.children[0],'a');
                                         element.children[0].setAttribute('href',hrefCard);
                                         element.children[0].setAttribute('target',targetCard);
                                         if(element.querySelector('.video_popup')!=null && element.querySelector('.hkex_card__more')==null){
                                             element.children[0].classList.add('video_popup');
                                         }
                                     }
                                }
                            })
                        })
                    })
                   
                    function replaceA_Div(oldElement,tag){
                        var newElement = document.createElement(tag);
                        newElement.innerHTML = oldElement.innerHTML;
                        for (var i = 0; i < oldElement.attributes.length; i++) {
                          var attr = oldElement.attributes[i];
                          newElement.setAttribute(attr.name, attr.value);
                        }
                        oldElement.parentNode.replaceChild(newElement, oldElement);
                    }

                    //can click video
                    //$(document).ready(function () {
                    //    var sss = document.querySelectorAll('section.hkexweb-hero-banner__bottom.section-main-card');
                    //    sss.forEach(function (e, i, a) {
                    //        e.querySelectorAll('div[id^="card"]').forEach(function (element, index, array) {
                    //            if (element.id.startsWith('card') && element.getAttribute("data-col-span") == '1' && element.children.length > 0 && !element.children[0].classList.contains('hkex_card__swiper')) {
                    //                element.addEventListener('click', function (event) {
                    //                    if (element.querySelector('a.hkex_card__more') != null && event.target != element.querySelector('a.video_popup')) {
                    //                        element.querySelector('a.hkex_card__more').click();
                    //                    }
                    //                    if(element.querySelector('a.hkex_card__more') == null&&element.querySelector('a.video_popup')!=null){
                    //                        element.querySelector('a.video_popup').click();
                    //                    }
                    //                });
                    //                if (element.querySelector('a.hkex_card__more') != null||element.querySelector('a.video_popup')!=null) {
                    //                    element.style.cursor = 'pointer';
                    //                    element.querySelector('a.hkex_card__more').setAttribute('style', 'pointer-events: none;');
                    //                }
                    //            }
                    //        })
                    //    })
                    //})

                    $(window).resize(function () {
                        cardViewInit();
                    })

                    function TriggerResize() {
                        var event;
                        if (typeof (Event) === 'function') {
                            event = new Event('resize');
                        } else {
                            event = document.createEvent('Event');
                            event.initEvent('resize', true, true);
                        }

                        //        $(".card-system-status").each(function () {
                        //var currEle = $(this);
                        //var swiper = currEle.find(".hkex_card__swiper");
                        //if (swiper && swiper.length > 0) {
                        //                var a = swiper.offset().top + swiper.outerHeight();
                        //	var min = 230;
                        //	currEle.find(".swiper-slide").each(function () {
                        //		var titleEle = $(this).find(".hkex_card__title");
                        //                    if (titleEle && titleEle .length > 0) {
                        //			var maxHeight = a - titleEle.offset().top - titleEle.outerHeight();
                        //			if (min > maxHeight) {
                        //			    min = maxHeight - 78
                        //			}
                        //                    }
                        //	});
                        //	if (min < 230) {
                        //	    currEle.find(".hkex_card__desc").css("max-height", min + "px");
                        //	}
                        //            }
                        //        })
                        window.dispatchEvent(event);
                    };

                    var HkexAjaxUtils = {
                        getKANHANString: function () {
                            dest = '' + window.parent.location;
                            dest = dest.toLowerCase();
                            if (dest.toLowerCase().indexOf('/sc.hkex.com.hk/tunis/') != -1) {
                                return 'sc.hkex.com.hk/TuniS/';
                            } else if (dest.toLowerCase().indexOf('/sc.hkex.com.hk/gb/') != -1) {
                                return 'sc.hkex.com.hk/gb/';
                            } else {
                                return '';
                            }
                        },
                        stripKANHAN: function (url_in) {
                            var khstr = HkexAjaxUtils.getKANHANString();
                            var re = new RegExp(khstr, "i");
                            return url_in.replace(re, "");
                        },
                        getDomain: function (url) {
                            var lead_slashes = url.indexOf("://");
                            var domain_start = lead_slashes + 3;
                            var without_resource = url.substring(domain_start, url.length);
                            var next_slash = without_resource.indexOf("/");
                            var domain = without_resource.substring(0, next_slash);
                            return domain;
                        },
                        getAjaxLink: function (path) {
                            var dest = window.parent.location.href;
                            dest = HkexAjaxUtils.stripKANHAN(dest);
                            var domain = HkexAjaxUtils.getDomain(dest);
                            var khstr = HkexAjaxUtils.getKANHANString();
                            var http = window.parent.location.protocol == "https:" ? "https" : "http";
                            return http + "://" + khstr + domain + path;
                        },
                        convertTag: function (html) {
                            return html.split("___LT___").join("<").split("___GT___").join(">");
                        }
                    };

                    function GetSpCalendar() {
                        var promises = [];
                        $(".sp-market-calendar").each(function () {
                            var spJson = JSON.parse($(this).html());
                            var sid = $(this).attr("data-sid");
                            if (spJson) {
                                var path = spJson.path;
                                var lang = spJson.lang;
                                if (path.length > 0) {
                                    var def = new $.Deferred();
                                    GetCalendar(sid, path, lang).done(function () {
                                        def.resolve();
                                    });
                                    promises.push(def);
                                }
                            }
                        });
                        return $.when.apply(undefined, promises).promise();
                    }

                    function GetCalendar(sid, path, lang) {
                        var promises = [];
                        var currentTime = new Date();
                        var now = Date.now();
                        for (var i = 0; i < (minMonth + 1 + maxMonth); i++) {
                            var calDate = new Date(currentTime.getFullYear(), currentTime.getMonth() + (i - minMonth + 1), 0);
                            var year = calDate.getFullYear().toString();
                            var mth = (calDate.getMonth() + 1).toString();
                            mth = mth.length > 1 ? mth : "0" + mth;
                            // prevent no cn version json
                            if (lang.toLowerCase() == "zh_cn") {
                                lang = "zh_hk";
                            }
                            var url = path + "/" + year + mth + "_" + lang + ".json?" + now;
                            (function () {
                                var def = new $.Deferred();
                                $.ajax({
                                    dataType: "json",
                                    async: true,
                                    contentType: "application/json; charset=utf-8",
                                    type: "GET",
                                    url: HkexAjaxUtils.getAjaxLink(url),
                                    success: function (data) {
                                        $.merge(calendarRecord, data);
                                    },
                                    error: function (xhr, option, thrownError) {
                                        //console.log(xhr.status);
                                    }
                                }).always(function () {
                                    def.resolve();
                                });
                                promises.push(def);
                            })();
                        }
                        return $.when.apply(undefined, promises).promise();
                        //swiperInit(); // calendar
                        //cardCalendarInit(); // calendar
                    }

                    function cardViewInit() {
                        var screenWidth = window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;
                        if (screenWidth < 440) {
                            $(".hkex_cards_column").columnView("distory");
                        } else if (screenWidth <= 1024) {
                            $(".hkex_cards_column").columnView({ columnCount: 2, columnGap: 18 });
                        } else {
                            $(".hkex_cards_column").columnView({ columnCount: 4, columnGap: 18 });
                        }
                    }

                    function swiperInit() {
                        $('.hkex_card__swiper').each(function () {

                            var cols = parseInt($(this).parents(".column_item").attr('data-col-span'));
                            var screenWidth = window.innerWidth || document.documentElement.clientWidth || document.body.clientWidth;
                            if (screenWidth < 440) {
                                cols = 1;
                            }
                            //var cols = parseInt($(this).parents(".column_item").attr('data-col-span'));
                            var swiper = new Swiper(this, {
                                slidesPerView: isNaN(cols) ? 1 : cols,
                                slidesPerGroup: isNaN(cols) ? 1 : cols,
                                spaceBetween: 32,
                                navigation: {
                                    nextEl: '.hkex_card__swiper_next',
                                    prevEl: '.hkex_card__swiper_prev',
                                },
                                pagination: {
                                    el: '.hkex_card__swiper_pagination',
                                    type: 'fraction'
                                },
                                updateOnWindowResize: true,
                                loop: true
                            })
                        });
                    }

                    function cardCalendarInit() {
                        $('.hkex_card__datepicker').each(function () {
                            var datePickerMonth = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
                            var datePickerDay = ["S", "M", "T", "W", "T", "F", "S"]
                            var yearSuffix = ""
                            if ($("html").attr("lang") != "en") {
                                datePickerMonth = ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"];
                                datePickerDay = ["日", " 一", "二", "三", "四", "五", "六"];
                                yearSuffix = "年";
                            }
                            var currentTime = new Date();
                            var maxDate = new Date(currentTime.getFullYear(), currentTime.getMonth() + (maxMonth + 1), 0);
                            var minDate = new Date(currentTime.getFullYear(), currentTime.getMonth() - (minMonth - 1), 0);

                            $(this).datepicker({
                                dateFormat: 'dd/mm/yy',
                                inline: true,
                                minDate: minDate,
                                maxDate: maxDate,
                                changeMonth: false,
                                selectOtherMonths: true,
                                monthNames: datePickerMonth,
                                dayNamesMin: datePickerDay,
                                yearSuffix: yearSuffix,
                                beforeShowDay: function beforeShowDay(date) {
                                    if (date > currentTime) {
                                        return [false, "calendar-day further-day day-" + date.getFullYear() + '-' + (date.getMonth() + 1) + '-' + date.getDate()];
                                    } else {
                                        return [false, "calendar-day day-" + date.getFullYear() + '-' + (date.getMonth() + 1) + '-' + date.getDate()];
                                    }
                                },
                                onChangeMonthYear: function onChangeMonthYear(date) {
                                    setTimeout(function () {
                                        renderDateEvent()
                                    }, 50);
                                    clickRecentlyDay(false)
                                }
                            });
                            renderDateEvent()
                            initCardCalendarClick()
                            clickRecentlyDay(true)
                            initCardCalendarSwiper()
                        });
                    }

                    function renderDateEvent() {
                        $.each(calendarRecord, function (index, value) {
                            $(".hkex_card__datepicker .day-" + value.date).addClass("has-event").attr("data-event-date", value.date)
                        });
                    }

                    function initCardCalendarSwiper() {
                        cardCalendarSwiper = new Swiper(".hkex_card__calendar_swiper", {
                            autoHeight: true,
                            loop: false,
                            spaceBetween: 32,
                            slidesPerGroup: 1,
                            slidesPerView: 1,
                            navigation: {
                                nextEl: '.hkex_card__calendar_next',
                                prevEl: '.hkex_card__calendar_prev',
                            },
                            pagination: {
                                el: '.hkex_card__calendar_pagination',
                                type: 'fraction',
                            },
                        })
                    }

                    function initCardCalendarClick() {
                        $("body").on("click", ".has-event", function () {
                            $(".selectedDay").removeClass("selectedDay")
                            $(this).addClass("selectedDay")
                            var target = $(this).attr("data-event-date")
                            var swiperSlideHTML = ""
                            cardCalendarSwiper.destroy(true, true);
                            $.each(calendarRecord, function (index, value) {
                                if (value.date == target) {
                                    swiperSlideHTML += '<div class="swiper-slide hkex_card__calendar_slide">'
                                    swiperSlideHTML += '<a href="' + value["link"] + '" target="_blank" title="' + bannerhtmlDecode(value["description"]).replace(/<br>/gi, '\n') + (value["refNo"] != "" ? '\n' + value["refNo"] : '') + '" >'
                                    var typeStr = (value["issuedBy"] != "" ? value["issuedBy"] + (value["type1"] != "" ? "  |  " : "") : "") + value["type1"] + (value["type1"] != "" && value["type2"] != "" ? "  |  " : "") + value["type2"] + (value["type2"] != "" && value["type3"] != "" ? "  |  " : "") + value["type3"];
                                    swiperSlideHTML += '<div class="hkex_card__calendar_date hkex_card__date"><span>' + (typeStr != "" ? typeStr + "  |  " : "") + value["display-date"] + '</span></div>';
                                    var refCount = 0;
                                    if (value["refNo"] != "") {
                                        refCount = value["refNo"].length;
                                    }
                                    swiperSlideHTML += '<div class="hkex_card__calendar_content">' + bannerhtmlDecode(value["description"]).replace(/<br>/gi, ' ') + (value["file"] != "" ? '<span class="filetype filetype--' + value["file"] + '--hollow">' + value["file"].toUpperCase() + '</span>' : '') + (value["refNo"] != "" ? '<br/>' + value["refNo"] : '') + '</div>'
                                    swiperSlideHTML += '</a>'
                                    swiperSlideHTML += '</div>'
                                }
                            });
                            $(".hkex_card__calendar_swiper .swiper-wrapper").html(swiperSlideHTML)
                            initCardCalendarSwiper()
                        })
                    }

                    function clickRecentlyDay(init) {
                        setTimeout(function () {
                            if ($(".ui-datepicker-today").hasClass("has-event")) {
                                $(".ui-datepicker-today").eq(0).click().addClass("selectedDay")
                            } else {
                                $(".further-day.has-event").eq(0).click().addClass("selectedDay")
                            }
                            if (init && $(".further-day.has-event").length <= 0) {
                                $(".ui-datepicker-next").click()
                                clickRecentlyDay()
                            }
                        }, 50);
                    }

                    // ---- media card handle ----- //
                    function generateSliderCardHtml(sid, data) {
                        if (data != "") {
                            var dataHtml = "";
                            var marks = "  |  ";

                            for (var key in data) {
                                if (data.hasOwnProperty(key)) {
                                    dataHtml += '<div class="swiper-slide">';
                                    var cateAndDate = "";
                                    cateAndDate += data[key].issuedBy != "" ? data[key].issuedBy + marks : "";
                                    cateAndDate += data[key].type1 ? data[key].type1 + marks : "";
                                    cateAndDate += data[key].type2 ? data[key].type2 + marks : "";
                                    cateAndDate += data[key].type3 ? data[key].type3 + marks : "";
                                    cateAndDate += data[key].date ? data[key].date : "";
                                    if (cateAndDate.endsWith(marks)) {
                                        cateAndDate = cateAndDate.substring(0, cateAndDate.length - marks.length);
                                    }
                                    if (data[key].hasCardMedia == "false") {
                                        dataHtml += '<div class="hkex_card_img ">';
                                        dataHtml += '<img src="' + data[key].image + '" alt="' + data[key].imageAlt + '">';
                                        dataHtml += '</div>';
                                    }
                                    dataHtml += '<div class="hkex_card__content">';
                                    dataHtml += '<a href="' + (data[key].link == "" ? "#" : data[key].link) + '" target="_blank" title="' + data[key].title + '">';
                                    dataHtml += '<div class="hkex_card__date">' + cateAndDate + '</div><div class="hkex_card__desc">' + data[key].title + (data[key].file != "" ? '<span class="filetype filetype--' + data[key].file + '--hollow">' + data[key].file.toUpperCase() + '</span>' : '');
                                    dataHtml += '</div></a>';
                                    dataHtml += '</div>';
                                    dataHtml += '</div>';
                                }
                            }

                            $("#" + sid + " .swiper-wrapper").html(dataHtml);
                        }
                    }

                    function GetSpDataCard() {
                        var promises = [];
                        var now = Date.now();
                        $(".sp-market-card").each(function () {
                            var spJson = JSON.parse($(this).html());
                            var sid = $(this).attr("data-sid");
                            if (spJson) {
                                var path = spJson.path;
                                var lang = spJson.lang;
                                // prevent no cn version json
                                if (lang.toLowerCase() == "zh_cn") {
                                    lang = "zh_hk";
                                }
                                if (path.length > 0) {
                                    var url = path + "_" + lang + ".json?" + now;
                                    var def = new $.Deferred();
                                    $.ajax({
                                        dataType: "json",
                                        async: true,
                                        contentType: "application/json; charset=utf-8",
                                        type: "GET",
                                        url: HkexAjaxUtils.getAjaxLink(url),
                                        success: function (data) {
                                            generateSliderCardHtml(sid, data);
                                        },
                                        error: function (xhr, option, thrownError) {
                                            //console.log(xhr.status);
                                        }
                                    }).always(function () {
                                        def.resolve();
                                    });
                                    promises.push(def);
                                }
                            }
                        });
                        return $.when.apply(undefined, promises).promise();
                    }

                    // --- dynamic card --- //
                    function dynamicCardInit() {
                        $(".card-dynamic").each(function () {
                            var order = parseInt($(this).attr("data-order"));
                            if (order + 1 <= dynamicCardData.length) {
                                if ($(this).attr("data-normal").toLowerCase() == "true") {
                                    $(this).html(generateDynamicCardHtml(dynamicCardData[order]));
                                } else { // get all remain items in dynamic json
                                    var mergeHtml = "";
                                    while (order + 1 <= dynamicCardData.length) {
                                        mergeHtml += generateDynamicCardHtml(dynamicCardData[order]);
                                        order++;
                                    }
                                    $(this).html(mergeHtml);
                                }
                            }
                        });
                    }

                    function generateDynamicCardHtml(data) {
                        var dataHtml = "";
                        if (data != "") {
                            var marks = "  |  ";

                            dataHtml += '<div class="column_item" data-col-span="1">';
                            dataHtml += '<div class="hkex_card ' + (data.colour != "" ? "hkex_card--" + data.colour : "") + " " + (data.height != "" ? "hkex_card--" + data.height : "") + '">';
                            dataHtml += '<div class="hkex_card__dynamic_title">' + data.title + '</div>';
                            dataHtml += '<div class="card-line-space"></div>';

                            if (data.data.length != 0) {
                                var cateAndDate = "";
                                cateAndDate += data.data.issuedBy != "" ? data.data.issuedBy + marks : "";
                                cateAndDate += data.data.type1 ? data.data.type1 + marks : "";
                                cateAndDate += data.data.type2 ? data.data.type2 + marks : "";
                                cateAndDate += data.data.type3 ? data.data.type3 + marks : "";
                                cateAndDate += data.data.date ? data.data.date : "";
                                if (cateAndDate.endsWith(marks)) {
                                    cateAndDate = cateAndDate.substring(0, cateAndDate.length - marks.length);
                                }
                                if (data.data.image != "") {
                                    dataHtml += '<div class="hkex_card_img ">';
                                    dataHtml += '<img src="' + data.data.image + '" alt="' + data.data.imageAlt + '">';
                                    dataHtml += '</div>';
                                    dataHtml += '<div class="card-line-space"></div>';
                                }
                                dataHtml += '<a href="' + (data.data.link == "" ? "#" : data.data.link) + '" target="_blank" title="' + data.data.title + '">';
                                dataHtml += '<div class="hkex_card__date">' + cateAndDate + '</div><div class="hkex_card__desc">' + data.data.title + (data.data.file != "" ? '<span class="filetype filetype--' + data.data.file + '--hollow">' + data.data.file.toUpperCase() + '</span>' : '');
                                dataHtml += '</div></a>';
                            }
                            if (data.linkText != "" && data.link != "") {
                                dataHtml += '<div class="card-line-space"></div>';
                                dataHtml += '<div class="hkex_card__foot">';
                                dataHtml += '<a class="hkex_card__more" href="' + data.link + '" title="' + data.linkText + '" target="' + data.linkTarget + '">' + data.linkText + '</a>';
                                dataHtml += '</div>';
                            }
                            dataHtml += '</div>';
                            dataHtml += '</div>';
                        }
                        return dataHtml;
                    }

                    function GetDynamicDataCard() {
                        var promises = [];
                        var now = Date.now();
                        $(".sp-market-dynamic").each(function () {
                            if ($(this).html() != "") {
                                var spJson = JSON.parse($(this).html());
                                for (var key in spJson) {
                                    if (spJson.hasOwnProperty(key)) {
                                        var path = spJson[key].path;
                                        var lang = spJson[key].lang;
                                        // prevent no cn version json
                                        if (lang.toLowerCase() == "zh_cn") {
                                            lang = "zh_hk";
                                        }
                                        if (path.length > 0) {
                                            var url = path + "_" + lang + ".json?" + now;
                                            var def = new $.Deferred();
                                            $.ajax({
                                                dataType: "json",
                                                async: true,
                                                contentType: "application/json; charset=utf-8",
                                                type: "GET",
                                                url: HkexAjaxUtils.getAjaxLink(url),
                                                success: function (data) {
                                                    $.merge(dynamicCardData, data);
                                                },
                                                error: function (xhr, option, thrownError) {
                                                    //console.log(xhr.status);
                                                }
                                            }).always(function () {
                                                def.resolve();
                                            });
                                            promises.push(def);
                                        }
                                    }
                                }
                            }
                        });
                        return $.when.apply(undefined, promises).promise();
                    }

                    // --- system status card --- //

                    function getcardHeightListData() {
                        $(".sp-market-card-height").each(function () {
                            var spJson = JSON.parse($(this).html());
                            $.merge(cardHeightListData, spJson)
                        })
                    }

                    function getSystemStatusDataCard() {
                        var promises = [];
                        var now = Date.now();
                        $(".sp-market-system-status").each(function () {
                            if ($(this).html() != "") {
                                var spJson = JSON.parse($(this).html());
                                for (var key in spJson) {
                                    if (spJson.hasOwnProperty(key)) {
                                        var path = spJson[key].path;
                                        var lang = spJson[key].lang;
                                        // prevent no cn version json
                                        if (lang.toLowerCase() == "zh_cn") {
                                            lang = "zh_hk";
                                        }
                                        if (path.length > 0) {
                                            var url = path + "_" + lang + ".json?" + now;
                                            (function () {
                                                var def = new $.Deferred();

                                                $.ajax({
                                                    dataType: "json",
                                                    async: true,
                                                    contentType: "application/json; charset=utf-8",
                                                    type: "GET",
                                                    url: HkexAjaxUtils.getAjaxLink(url),
                                                    success: function (data) {
                                                        if (data["dataLang"] && data["dataLang"] && data["dataPath"] && data["dataPath"]) {

                                                            $.ajax({
                                                                dataType: "json",
                                                                async: true,
                                                                contentType: "application/json; charset=utf-8",
                                                                type: "GET",
                                                                url: HkexAjaxUtils.getAjaxLink(data["dataPath"] + "_" + data["dataLang"] + ".json?" + now),
                                                                success: function (sliderData) {
                                                                    data["sliderData"] = sliderData;
                                                                    systemCardData.push(data);
                                                                }
                                                            }).always(function () {
                                                                def.resolve();
                                                            });
                                                        } else {
                                                            def.resolve();
                                                        }
                                                    },
                                                    error: function (xhr, option, thrownError) {
                                                        //console.log(xhr.status);
                                                        def.resolve();
                                                    }
                                                });
                                                promises.push(def);
                                            })();
                                        }
                                    }
                                }
                            }
                        });
                        return $.when.apply(undefined, promises).promise();
                    }

                    function generateSystemStatusCardHtml(data) {
                        var dataHtml = "";
                        if (data && data != "") {
                            var marks = "  |  ";

                            for (var key in data) {
                                if (data.hasOwnProperty(key)) {
                                    dataHtml += '<div class="swiper-slide">';
                                    var cateAndDate = "";
                                    cateAndDate += data[key].remark != "" ? data[key].remark + marks : "";
                                    cateAndDate += data[key].date != "" ? data[key].date + marks : "";

                                    if (cateAndDate.endsWith(marks)) {
                                        cateAndDate = cateAndDate.substring(0, cateAndDate.length - marks.length);
                                    }
                                    dataHtml += '<div class="hkex_card__content"><div style="width:100%">';
                                    dataHtml += '<div class="hkex_card__date">' + cateAndDate + '</div>';
                                    //dataHtml += "<div class='hkex_card__title' style='padding-left:0px'>" + data[key].name + "</div>";
                                    dataHtml += '<div class="hkex_card__desc" >' + "<div class='hkex_card__title' style='padding-left:0px'>" + data[key].name + "</div>";
                                    if (data[key].status != "") {
                                        dataHtml += '<div style="font-size:18px;padding-bottom:10px" ><strong><u>' + data[key].status + '</u></strong></div>';
                                    }
                                    dataHtml += data[key].desc + '</div>';
                                    dataHtml += '</div></div>';
                                    dataHtml += '</div>';
                                }
                            }
                        }
                        return dataHtml;
                    }

                    function initSystemStatusCard() {
                        $(".card-system-status").each(function () {
                            var currEle = $(this)
                            var cardSystemStatusId = currEle.data("sys-status-id");
                            console.log(systemCardData)
                            for (var i = 0; i < systemCardData.length; i++) {
                                var currJson = systemCardData[i];
                                if (currJson["id"] != cardSystemStatusId || !currJson["sliderData"] || Object.keys(currJson["sliderData"]).length == 0) { continue; }

                                var replaceCard = $("#card" + currEle.data("replace-id"));
                                if (replaceCard) {
                                    var _class = replaceCard.attr('class');
                                    var _colSpan = replaceCard.data('col-span');
                                    var _cardSize = "hkex_card--small";
                                    var tempcardSize = replaceCard.find(".hkex_card").attr("class");

                                    for (var j = 0; j < cardHeightListData.length; j++) {
                                        if (tempcardSize.indexOf(cardHeightListData[j]) != -1) {
                                            _cardSize = "hkex_card--" + cardHeightListData[j];
                                            break;
                                        }
                                    }

                                    var cardHtml = "<div class='" + _class + "' data-col-span='" + _colSpan + "'>";
                                    cardHtml += "<div class='hkex_card__swiper swiper-container hkex_card " + _cardSize + " hkex_card--" + currJson["colour"] + "'>";
                                    cardHtml += "<div class='hkex_card__title'>" + currJson["title"] + "</div>";
                                    cardHtml += "<div class='swiper-wrapper'>" + generateSystemStatusCardHtml(currJson["sliderData"]) + "</div>";
                                    cardHtml += "<div class='hkex_card__swiper_nav'>";
                                    cardHtml += "<a class='hkex_card__swiper_prev'></a>";
                                    cardHtml += "<span class='hkex_card__swiper_pagination'></span>";
                                    cardHtml += "<a class='hkex_card__swiper_next'></a>";
                                    if (currJson["link"] && currJson["link"] != "" && currJson["linkText"] && currJson["linkText"] != "") {
                                        cardHtml += "<a href='" + currJson["link"] + "' target='" + currJson["linkTarget"] + "' title='" + currJson["linkAlt"] + "' class='hkex_card__more'>" + currJson["linkText"] + "</a>";
                                    }
                                    cardHtml += "</div>";
                                    currEle.html(cardHtml);

                                    replaceCard.remove();
                                }
                                break;
                            }
                        });
                    }

                    function bannerhtmlDecode(value) {
                        return $('<div/>').html(value).text();
                    }
                })(jQuery);
            </script>
            
    </div>
</div>
<!-- End Homepage Card Block -->


