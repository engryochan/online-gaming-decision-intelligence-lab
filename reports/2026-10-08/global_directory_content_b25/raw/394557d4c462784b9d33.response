<script>
    $(document).ready(function () {
        $(".section_container_in.breadcrumb").addClass("stage");
        initStageHomeBannerSlide();
        initStageHomePartnersSwiper();
        initStageHomeAnchor();
        initStageBannerShare();
        initJoinStageTag();
        initDiscoverPopup();
        initDiscoverRecordFilter();
        initDiscoverRecordControls();
        initDiscoverRecordSorting();
    });

    $(window).resize(function () {
        $(".stage-home-banner__word-slides").each(function () {
            var height = 0
            $(this).find(".stage-home-banner__word-slide").each(function () {
                if ($(this).height() > height) {
                    height = $(this).height()
                }
            })
            $(this).height(height)
        })
    })
    document.addEventListener("DOMContentLoaded", function () {
        var bannerNavHtml = "";
        $("[id][data-anchor-title].stage_section_anchor_point").each(function () {
            var $s = $(this);
            var navID = $s.attr("id");
            var navScTitle = $s.attr("title");
            var navTitle = $s.attr("data-anchor-title");
            if (navScTitle) {
                navTitle = navScTitle;
            }
            if (navID != "" && navTitle != "") {
                bannerNavHtml += '<a href="#' + navID + '" title="' + navTitle + '" class="stage_index_btn w-inline-block"><div>' + navTitle + '</div></a>'
            }
        });
        //console.log("banner: " + bannerNavHtml);
        $(".anchorLink").each(function () {
            $(this).html(bannerNavHtml);
        });
    });
    function initStageHomeBannerSlide() {
        $(".stage-home-banner__slide-btn").click(function (e) {
            e.preventDefault()
            $(".stage-home-banner__slide-btn").removeClass("active")
            $(this).addClass("active")
            $(".stage-home-banner [data-slide]").removeClass("active")
            $(".stage-home-banner " + $(this).attr("data-href")).addClass("active")
        })
        setInterval(function () {
            if ($(".stage-home-banner__slide-btn.active").next().length > 0) {
                $(".stage-home-banner__slide-btn.active").next().click()
            } else {
                $(".stage-home-banner__slide-btn").eq(0).click()
            }
        }, 20000);
        setTimeout(function () {
            $(".stage-home-banner__word-slides").each(function () {
                var height = 0
                $(this).find(".stage-home-banner__word-slide").each(function () {
                    if ($(this).height() > height) {
                        height = $(this).height()
                    }
                })
                $(this).height(height)
            })

        }, 100);
    }

    function initStageHomePartnersSwiper() {
        var homePartnerSwiper = new Swiper(".stage-partners__swiper", {

            slidesPerView: 1,
            slidesPerGroup: 1,
            pagination: {
                el: '.stage-partners__swiper-pagination',
                type: 'bullets',
                clickable: true,
            },
            navigation: {
                nextEl: '.stage-partners__swiper-next',
                prevEl: '.stage-partners__swiper-prev',
            },
            breakpoints: {
                641: {
                    slidesPerView: 2,
                    slidesPerGroup: 2,
                },
                993: {
                    slidesPerView: 3,
                    slidesPerGroup: 3,
                },
            }
        })
    }

    function initStageHomeAnchor() {
        $(".stage_index_btn").click(function (e) {
            e.preventDefault()
            var target = $(this).attr("href")
            console.log(target)
            $('html,body').animate({
                scrollTop: $(target).eq(0).offset().top - 120
            }, 1200);
        })
    }

    function initStageBannerShare() {
        $(".stage_banner_share_btn.share").click(function (e) {
            e.preventDefault();
            var shareBlock = $(this).find(".share_popup_block.stage")
            if (shareBlock.css("display") == "flex") {
                shareBlock.css("display", "none")
            } else {
                shareBlock.css("display", "flex")
            }
        })
    }
</script>

