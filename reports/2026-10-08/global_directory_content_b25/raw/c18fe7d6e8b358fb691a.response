zPV" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><use href="#eva-icons-facebook"></use></svg></a></div></span><span class="FooterSocialIcon PJLV"><div class="SocialMediaIcon eJrgFp iPiHAH jcimvb"><a class="Link hxlSIK gMcxnl" href="https://www.linkedin.com/company/75896" target="_blank"><svg class="Icon bQczPV" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><use href="#eva-icons-linkedin"></use></svg></a></div></span></div></div></div></footer></div></div></div><script id="__NEXT_DATA__" type="application/json" crossorigin="">{"props":{"pageProps":{"menuSections":[{"id":"SEC-4JEF6D","name":"Markets","children":[{"id":"AFQiL","url":"/markets/NZSX","name":"NZX Main Board (NZSX)"},{"id":"7h1KeGqZlGYMioTPwmBk4s","url":"/markets/NZDX","name":"NZX Debt Market (NZDX)"},{"id":"3W05Z","url":"/markets/nzx-dairy-derivatives","name":"SGX-NZX Dairy Derivatives"},{"id":"3RqCMgaUCZTOiRNrDK1bj","url":"/markets/NZCX","name":"NZX Equity Derivatives (NZCX)"},{"id":"5YeruxshUZc2F1x1fMi17J","url":"/markets/indices","name":"S\u0026P/NZX Indices"}]},{"id":"SEC-43s5XC","name":"Regulation","children":[{"id":"2wlb7B","url":"/regulation/nzregco","name":"NZ RegCo"},{"id":"1XkJ2E","url":"/regulation/nzx-rules-guidance","name":"NZX Rules \u0026 Guidance"},{"id":"1FfHbX","url":"/regulation/nzmd-tribunal-regulation","name":"NZ Markets Disciplinary Tribunal"},{"id":"36DYPt","url":"/regulation/corporate-governance-institute","name":"Corporate Governance Institute"},{"id":"2qKrUL","url":"/regulation/complaints","name":"Complaints"},{"id":"37Ypoi","url":"/regulation/faqs","name":"FAQS"},{"id":"3EU6NW","url":"/regulation/contact-us","name":"Contact Us"},{"id":"2CoehM","url":"/regulation/nzx-policy","name":"NZX Policy"},{"id":"70WX8beNP6h5YKonTpDy4A","url":"/regulation/issuer-training-modules","name":"Issuer Training Modules"}]},{"id":"SEC-2D5om2","name":"Products","children":[{"id":"1FzjLP","url":"/products/products-overview","name":"Prod