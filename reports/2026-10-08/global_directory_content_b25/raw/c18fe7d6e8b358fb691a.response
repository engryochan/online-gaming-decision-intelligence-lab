:{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"70WX8beNP6h5YKonTpDy4A","type":"Entry","createdAt":"2023-11-15T20:21:08.680Z","updatedAt":"2026-06-24T02:06:57.002Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":149,"revision":17,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"page"}},"locale":"en-US"},"fields":{"label":"Issuer Training Modules","title":"Issuer Training Modules","path":"/regulation/issuer-training-modules","slug":"issuer-training-modules","layoutRef":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"1JjDWE","type":"Entry","createdAt":"2023-05-04T22:03:03.807Z","updatedAt":"2024-11-08T02:33:56.092Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":14,"revision":7,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"layouts"}},"locale":"en-US"},"fields":{"name":"Article with Sibling Navigation","template":"sidebarWithSiblings"}},"content":{"nodeType":"document","data":{},"content":[{"nodeType":"heading-1","data":{},"content":[{"nodeType":"text","value":"Issuer Training Modules","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"If you are the Primary Authorised Representative for a primary listed equity Issuer, you are required to access all training modules via the Safetrac website and pass the prescribed test for each module available on Safetrac.","marks":[{"type":"bold"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Existing Issuers – Listing Rule requirements","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The NZX Listing Rules (including Listing Rule 1.7.2 and 1.22) require issuers to appoint a Primary Authorised Representative and a Secondary Authorised Representative. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"These requirements include that primary listed equity Issuers must ensure that their Primary Authorised Representative has successfully completed the Authorised Representative Training by 24 January 2025. The relevant Primary Authorised Representatives must pass the test of all eight modules to meet this requirement. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"NZ RegCo encourages Secondary Authorised Representatives to undergo Authorised Representative Training, although there is no Listing Rule requirement for them to do so. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Please note that while individual weblinks to each module are available below, Primary Authorised Representatives for primary listed equity Issuers must complete and pass the test for each module while logged in to the Safetrac website. Users will receive email confirmation after passing the test for each module. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Prospective Issuers","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Applicants who are seeking to list on NZX must also appoint a Primary and Secondary Authorised Representatives. Primary Authorised Representatives for primary listed equity Issuers must successfully complete the Authorised Representative Training prior to listing. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Training Modules","marks":[{"type":"underline"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Issuer Training Modules are available here:","marks":[{"type":"bold"}],"data":{}}]},{"nodeType":"embedded-entry-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"3tCnKViGIPY1dZBO1OT08I","type":"Entry","createdAt":"2024-10-16T22:13:45.147Z","updatedAt":"2024-10-16T22:13:45.147Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":3,"revision":1,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"button"}},"locale":"en-US"},"fields":{"title":"Issuer Training Modules","label":"Issuer Training Modules","type":"primary","size":"default","link":"https://clients.safetrac.com/nzregco#","stretch":false}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Primary Authorised Representative for each primary listed equity Issuer is required to access all training modules via this link and pass the prescribed test for each module.","marks":[{"type":"bold"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The modules available through Safetrac include a test and are designed, subject to individual professional requirements, to qualify for continuing professional development (CPD) time. Each module is expected to take no more than 45 minutes to complete. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The NZX Listing Rule training modules are: ","marks":[],"data":{}}]},{"nodeType":"table","data":{},"content":[{"nodeType":"table-row","data":{},"content":[{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Subject","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Summary","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Available?","marks":[{"type":"bold"}],"data":{}}]}]}]},{"nodeType":"table-row","data":{},"content":[{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Continuous Disclosure","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Information on Continuous Disclosure, when disclosure is required, and other disclosure obligations under the NZX Listing Rules","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Yes","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://360.articulate.com/review/content/f9780fd1-a82d-4701-a052-904452edc252/review"},"content":[{"nodeType":"text","value":"Quick view","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}]},{"nodeType":"table-row","data":{},"content":[{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Shareholder Meetings ","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"NZX Listing Rule obligations that apply in relation to shareholder meetings ","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Yes","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://360.articulate.com/review/content/7330ce2b-50ee-4823-be6b-02dc43c49a