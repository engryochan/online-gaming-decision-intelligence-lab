":"text","value":"Quick view","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}]},{"nodeType":"table-row","data":{},"content":[{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Corporate Governance ","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Key corporate governance requirements under the NZX Listing Rules, and the NZX Corporate Governance Code ","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Yes","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://360.articulate.com/review/content/7a046270-630c-4d22-9e5d-cd04f57fd57a/review"},"content":[{"nodeType":"text","value":"Quick view","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}]},{"nodeType":"table-row","data":{},"content":[{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Major and Related Party Transactions ","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Overview of major and related party transactions including information issuers should include in a notice of meeting ","marks":[],"data":{}}]}]},{"nodeType":"table-cell","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Yes","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://360.articulate.com/review/content/d8ebaa79-3e22-4b90-af9e-9c4d94f81357/review"},"content":[{"nodeType":"text","value":"Quick view","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}]}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Please note that the \"Quick view\" version of each training module is a copy of the module content. Accessing the \"Quick view\" versions does not constitute passing the Authorised Representative Training.","marks":[{"type":"italic"},{"type":"bold"}],"data":{}},{"nodeType":"text","value":" ","marks":[{"type":"bold"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The Authorised Representative Training (as defined in the Listing Rules) is the online training and associated tests available on the Safetrac website. To complete the Authorised Representative Training, an Authorised Representative must pass the test for each of the eight modules. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Refresher training","marks":[{"type":"italic"}],"data":{}},{"nodeType":"text","value":" ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Primary Authorised Representatives for primary listed equity issuers must undertake the Authorised Representative Training every three years. The date that Authorised Representatives must use to calculate this anniversary is the date that all eight modules were completed, and the tests were passed. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Webinar","marks":[{"type":"italic"}],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"On 13 June 2024, NZ RegCo hosted a webinar on the Authorised Representative requirements and Issuer training modules. The presentation is available ","marks":[],"data":{}},{"nodeType":"asset-hyperlink","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"50wVBVf