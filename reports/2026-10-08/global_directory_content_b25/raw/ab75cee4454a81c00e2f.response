Exchange Inc."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Guyana Bank for Trade and Industry Limited | Guyana Stock Exchange Inc."/><link rel="canonical" href="https://guyanastockexchangeinc.com/security/guyana-bank-for-trade-and-industry-limited/"/><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://guyanastockexchangeinc.com/","name":"Guyana Stock Exchange Inc."}},{"@type":"ListItem","position":2,"item":{"@id":"https://guyanastockexchangeinc.com/security-type/ordinary-shares/","name":"Ordinary Shares"}},{"@type":"ListItem","position":3,"item":{"@id":"https://guyanastockexchangeinc.com/security/guyana-bank-for-trade-and-industry-limited/","name":"Guyana Bank for Trade and Industry Limited"}}]}</script><style type="text/css" media="all">@font-face{font-family:'Noto Serif';font-style:italic;font-weight:400;font-stretch:normal;src:url(https://fonts.gstatic.com/s/notoserif/v33/ga6saw1J5X9T9RW6j9bNfFIMZhhWnFTyNZIQD1-_FXP0RgnaOg9MYBNLg_cIrq0.woff) format('woff')}@font-face{font-family:'Noto Serif';font-style:italic;font-weight:700;font-stretch:normal;src:url(https://fonts.gstatic.com/s/notoserif/v33/ga6saw1J5X9T9RW6j9bNfFIMZhhWnFTyNZIQD1-_FXP0RgnaOg9MYBOshPcIrq0.woff) format('woff')}@font-face{font-family:'Noto Serif';font-display:block;font-style:normal;font-weight:400;font-stretch:normal;src:url(https://fonts.gstatic.com/s/notoserif/v33/ga6iaw1J5X9T9RW6j9bNVls-hfgvz8JcMofYTa32J4wsL2JAlAhZqFCTx8cM.woff) format('woff')}@font-face{font-family:'Noto Serif';font-display:block;font-style:normal;font-weight:700;font-stretch:normal;src:url(https://fonts.gstatic.com/s/notoserif/v33/ga6iaw1J5X9T9RW6j9bNVls-hfgvz8JcMofYTa32J4wsL2JAlAhZT1eTx8cM.woff) format('woff')}</style><link rel='stylesheet' id='fvm-header-0-css' href='https://guyanastockexchangeinc.com/gse/sec/media/cache/fvm/1759280682/out/header-39879a3be031dd10f0fc341162d58b61f5b4420e.min.css' type='text/css' media='all'/><script type='text/javascript' src='https://guyanastockexchangeinc.com/gse/wp-includes/js/jquery/jquery.js' id='jquery-core-js'></script><script type='text/javascript' src='https://guyanastockexchangeinc.com/gse/sec/assets/js/chart.js' id='chart-js'></script><script type='text/javascript' src='https://guyanastockexchangeinc.com/gse/sec/media/cache/fvm/1759280682/out/header-3afae13aa1a25beeb109a30bd2eaf7523b55eb03.min.js' id='fvm-header-1-js'></script><link rel="https://api.w.org/" href="https://guyanastockexchangeinc.com/wp-json/"/><style type="text/css">.recentcomments a{display:inline !important;padding:0 !important;margin:0 !important;}</style></head><body class="security-template-default single single-security guyana-bank-for-trade-and-industry-limited security dwpb-push-page group-blog"><div id="page" class="site"> <a class="skip-link screen-reader-text" href="#content">Skip to content</a> <header id="masthead" class="site-header" role="banner"><div class="site-contact group"><div class="wrapper group"><div class="dropdown"><div class="menu-label">Help</div> <nav class="help-menu"><div class="menu-help-container"><ul id="menu-help" class="menu"><li class="menu-item"><a href="https://guyanastockexchangeinc.com/faqs/">FAQs</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/glossary/">Glossary</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/buying-selling-shares/">Buying &#038; Selling Shares</a></li></ul></div> </nav></div> <nav class="secondary"><div class="menu-secondary-container"><ul id="menu-secondary" class="menu"><li class="menu-item"><a href="https://guyanastockexchangeinc.com/about-us/">About Us</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/articles/">Articles</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/legal-framework/">Legal Framework</a></li><li class="menu-item"><a href="https://gu