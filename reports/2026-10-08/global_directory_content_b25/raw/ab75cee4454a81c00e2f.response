angeinc.com/securities/">Securities</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/brokers/">Brokers</a></li></ul></div><div class="menu-secondary-container"><ul id="menu-secondary-1" class="menu"><li class="menu-item"><a href="https://guyanastockexchangeinc.com/about-us/">About Us</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/articles/">Articles</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/legal-framework/">Legal Framework</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/news/">News</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/links/">Links</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/previous-website/">Previous Website</a></li></ul></div><div class="menu-help-container"><ul id="menu-help-1" class="menu"><li class="menu-item"><a href="https://guyanastockexchangeinc.com/faqs/">FAQs</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/glossary/">Glossary</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/buying-selling-shares/">Buying &#038; Selling Shares</a></li></ul></div></div> </nav> <nav class="primary"><div class="menu-primary-container"><ul id="menu-primary-1" class="menu"><li class="menu-item"><a href="https://guyanastockexchangeinc.com/ai-tutor/">AI Tutor</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/trades/">Trades</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/financials/">Financials</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/market-capitalisation/">Market Capitalisation</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/securities/">Securities</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/brokers/">Brokers</a></li></ul></div></nav></div></div></div> </header> <main id="site-content" class="site-content"><div class="site-ticker"><div class="wrapper"><div class="stock-ticker"><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/banks-dih-holdings-inc/">bdh</a></div><div class="closing">155</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/guyana-bank-for-trade-and-industry-limited/">bti</a></div><div class="closing">2500</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/citizens-bank-guyana-incorporated/">cbi</a></div><div class="closing">388</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/caribbean-container-incorporated/">cci</a></div><div class="closing">149</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/demerara-bank-limited/">dbl</a></div><div class="closing">279</div></div></div></div><div class="item"><div class="stock"><div class="negative"><div class="security"><a href="https://guyanastockexchangeinc.com/security/demerara-distillers-limited/">ddl</a></div><div class="closing">295</div><div class="change"><span>-</span>2 (0.67%)</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/demerara-tobacco-company-limited/">dtc</a></div><div class="closing">3000</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/guyana-stockfeeds-incorporated/">gsi</a></div><div class="closing">112</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/j-p-santos-company-limited/">jps</a></div><div class="closing">20</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/property-holdings-incorporated/">phi</a></div><div class="closing">14</div></div></div></div><div class="item"><div class="stock"><div class="negative"><div class="security"><a href="https://guyanastockexchangeinc.com/security/republic-bank-guyana-limited/">rbl</a></div><div class="closing">539.9</div><div class="change"><span>-</span>0.1 (0.02%)</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/rupununi-development-company-limited/">rdl</a></div><div class="closing">500</div></div></div></div><div class="item"><div class="stock"><div class="same"><div class="security"><a href="https://guyanastockexchangeinc.com/security/sterling-products-limited/">spl</a></div><div class="closing">841.5</div></div></div></div></div></div></div><div class="feature background group" style="background:url(https://guyanastockexchangeinc.com/gse/sec/media/02-1600x800.jpg) no-repeat center 50%; background-size:cover;"><div class="overlay"><div class="wrapper"><div class="content"><h1><div class="title">Guyana Bank for Trade and Industry Limited</div></h1></div></div></div></div> <main id="main" class="site-main wrapper group" role="main"><div class="sidebar col span-3"><div class="feed"><div class="bulletins"><h3>Bulletins</h3><div class="bulletin"><div class="info group"><div class="title"><a href="#26902" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $21.00 per share Interim Dividend for 2026</a></div><div id="26902" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Wednesday, July 15, 2026 and agreed to recommend the payment of an Interim Dividend of $21.00 per share for 2026.</p><p>Dividends will be paid to shareholders on August 3, 2026. The share register will be closed for the period July 20 &#8211; August 2, 2026,  to facilitate the payment of the Interim Dividend.</p></div><span class ="number 222"><a href="https://guyanastockexchangeinc.com/bulletin-number/222/">Bulletin 222</a></span><span class="date">July 2026</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#26245" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $14.00 per share Final Dividend for 2025</a></div><div id="26245" class="mfp-hide popup-content" ><p style="font-weight: 400;">The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Wednesday, February 25, 2026 and agreed to recommend the payment of a Final Dividend of $14.00 per share for 2025.</p><p style="font-weight: 400;">When added to the two interim dividends of $16.00 and $11.00 paid earlier, the total dividend for the year 2025 amounts to $41.00.</p></div><span class ="number 217"><a href="https://guyanastockexchangeinc.com/bulletin-number/217/">Bulletin 217</a></span><span class="date">February 2026</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#25764" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $11.00 per share Second Interim Dividend for 2025</a></div><div id="25764" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Wednesday, November 19, 2025 and agreed to recommend the payment of a Second Interim Dividend of $11.00 per share for 2025.</p><p>This recommendation has been approved by the Bank of Guyana and dividends will be paid to shareholders on December 10, 2025. The share register will be closed for the period November 26 &#8211; December 9 2025, both days inclusive, to facilitate the payment of the Second Interim Dividend.</p></div><span class ="number 216"><a href="https://guyanastockexchangeinc.com/bulletin-number/216/">Bulletin 216</a></span><span class="date">November 2025</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#25169" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $16.00 per share Interim Dividend for 2025</a></div><div id="25169" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Monday, June 18, 2025 and agreed to recommend the payment of an Interim Dividend of $16.00 per share for 2025.</p><p>Dividends will be paid to shareholders on July 25, 2025. The share register will be closed for the period July 11 &#8211; 24 2025,  both days inclusive, to facilitate the payment of the Interim Dividend.</p></div><span class ="number 214"><a href="https://guyanastockexchangeinc.com/bulletin-number/214/">Bulletin 214</a></span><span class="date">July 2025</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#24811" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; AGM to be held on Friday May 16, 2025 at 6:00 p.m.</a></div><div id="24811" class="mfp-hide popup-content" ><p>Guyana Bank for Trade and Industry Limited&#8217;s AGM will be held on Friday May 16, 2025 at 6:00 p.m. The share register will be closed for the period May 3 &#8211; May 16 2025, both days inclusive, to facilitate the payment of the Final Dividend</p></div><span class ="number 212"><a href="https://guyanastockexchangeinc.com/bulletin-number/212/">Bulletin 212</a></span><span class="date">April 2025</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#24496" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $12.00 per share Final Dividend for 2024</a></div><div id="24496" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Monday, February 17, 2025 and agreed to recommend the payment of a Final Dividend of $12.00 per share for 2024.</p><p>When added to the two interim dividends of $14.00 and $6.00 paid earlier, the total dividend for the year 2024 amounts to $32.00.</p></div><span class ="number 210"><a href="https://guyanastockexchangeinc.com/bulletin-number/210/">Bulletin 210</a></span><span class="date">February 2025</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#24174" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $6.00 per share Second Interim Dividend for 2024</a></div><div id="24174" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Wednesday, November 21, 2024 and agreed to recommend the payment of a Second Interim Dividend of $6.00 per share for 2024.</p><p>This recommendation has been approved by the Bank of Guyana and dividends will be paid to shareholders on December 12, 2024. The share register will be closed for the period November 29 &#8211; December 12 2024, both days inclusive, to facilitate the payment of the Second Interim Dividend.</p></div><span class ="number 209"><a href="https://guyanastockexchangeinc.com/bulletin-number/209/">Bulletin 209</a></span><span class="date">November 2024</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#23579" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $14.00 per share Interim Dividend for 2024</a></div><div id="23579" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Monday, July 15, 2024 and agreed to recommend the payment of an Interim Dividend of $14.00 per share for 2024.</p><p>Dividends will be paid to shareholders on August 5, 2024. The share register will be closed for the period July 23 &#8211; August 5 2024,  both days inclusive, to facilitate the payment of the Interim Dividend.</p></div><span class ="number 206"><a href="https://guyanastockexchangeinc.com/bulletin-number/206/">Bulletin 206</a></span><span class="date">July 2024</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#24169" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; 36th Annual General Meeting</a></div><div id="24169" class="mfp-hide popup-content" ><p>Guyana Bank for Trade &amp; Industry Ltd. (GBTI) advised that their 36th Annual General Meeting will be held on Friday, May 24, 2024 at 6:00 p.m. at the GBTI Corporate Office, High &amp; Young Streets, Kingston, Georgetown.</p><p>The share register will be closed for the period May 11, 2024 to May 24,2024. Dividends will be paid on May 28, 2024 to Shareholders on record as at May 11, 2024.</p></div><span class ="number 204"><a href="https://guyanastockexchangeinc.com/bulletin-number/204/">Bulletin 204</a></span><span class="date">April 2024</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#24168" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; Appointment of Director</a></div><div id="24168" class="mfp-hide popup-content" ><p>Mr. Shawn Gurcharran has been appointed Director effective April 17, 2024.</p></div><span class ="number 204"><a href="https://guyanastockexchangeinc.com/bulletin-number/204/">Bulletin 204</a></span><span class="date">April 2024</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#22868" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $6.50 per share Final Dividend for 2023</a></div><div id="22868" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Monday, March 04, 2024 and agreed to recommend the payment of a Final Dividend of $6.50 per share for 2023.</p><p>When added to the two interim dividends of $13.00 and $5.00 paid earlier, the total dividend for the year 2023 amounts to $24.50.</p><p>The Board of Directors of GBTI have appointed Mr. Shawn Gurcharran as Chief Executive Officer (CEO) with effect from April 02, 2024. Mr. James Foster, the current CEO vacates that position effective March 31, 2024.</p></div><span class ="number 203"><a href="https://guyanastockexchangeinc.com/bulletin-number/203/">Bulletin 203</a></span><span class="date">March 2024</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#22336" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $5.00 per share Interim Dividend for 2023</a></div><div id="22336" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Friday, December 1, 2023 and agreed to recommend the payment of an Interim Dividend of $5.00 per share for 2023.</p><p>This recommendation has been approved by the Bank of Guyana and dividends will be paid to shareholders on December 21, 2023. The share register will be closed for the period December 6 &#8211; December 19 2023,  both days inclusive, to facilitate the payment of the Interim Dividend.</p></div><span class ="number 201"><a href="https://guyanastockexchangeinc.com/bulletin-number/201/">Bulletin 201</a></span><span class="date">December 2023</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#21709" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $13.00 per share Interim Dividend for 2023</a></div><div id="21709" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Wednesday, July 19, 2023 and agreed to recommend the payment of an Interim Dividend of $13.00 per share for 2023.  This recommendation has been approved by the Bank of Guyana and dividends will be paid to shareholders on August 14, 2023. The share register will be closed for the period July 31 &#8211; August 14 2023,  both days inclusive, to facilitate the payment of the Interim Dividend.</p></div><span class ="number 197"><a href="https://guyanastockexchangeinc.com/bulletin-number/197/">Bulletin 197</a></span><span class="date">July 2023</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#21251" class="inline-popup">Guyana Bank for Trade and Industry Limited (BTI) &#8211; Annual General Meeting (AGM)</a></div><div id="21251" class="mfp-hide popup-content" ><p>Guyana Bank for Trade and Industry  Limited will hold their 35th Annual General Meeting on Monday June 23, 2023 at 6:00 p.m. at GBTI Corporate Office, High &amp; Young streets, Kingston, Georgetown. The payment of a Final Dividend of $8.00 per share to be paid on June 26, 2023.  The share register will be closed for the period June 9-23, 2023 to facilitate the payment of the Final Dividend to shareholders on record as at June 9, 2023.</p></div><span class ="number 195"><a href="https://guyanastockexchangeinc.com/bulletin-number/195/">Bulletin 195</a></span><span class="date">May 2023</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#20451" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $6.00 per share Second Interim Dividend for 2022</a></div><div id="20451" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Wednesday, November 16, 2022 and agreed to recommend the payment of a Second  Interim Dividend of $6.00 per share for 2022.</p><p>This recommendation has been approved by the Bank of Guyana and dividends will be paid to shareholders on December 22, 2022. The share register will be closed for the period December 7 &#8211; December 21 2022,  both days inclusive, to facilitate the payment of the Second Interim Dividend.</p></div><span class ="number 191"><a href="https://guyanastockexchangeinc.com/bulletin-number/191/">Bulletin 191</a></span><span class="date">December 2022</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#19963" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $6.00 per share Interim Dividend for 2022</a></div><div id="19963" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Wednesday, July 20, 2022 and agreed to recommend the payment of an Interim Dividend of $6.00 per share for 2022.</p><p>This recommendation has been approved by the Bank of Guyana and dividends will be paid to shareholders on August 31, 2022. The share register will be closed for the period August 17 &#8211; August 31 2022,  both days inclusive, to facilitate the payment of the Interim Dividend.</p></div><span class ="number 187"><a href="https://guyanastockexchangeinc.com/bulletin-number/187/">Bulletin 187</a></span><span class="date">August 2022</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#19500" class="inline-popup">Demerara Bank Limited (DBL) &#8211; recommends $0.40 per share Interim Dividend for 2022</a></div><div id="19500" class="mfp-hide popup-content" ><p>The Board of Directors of Demerara Bank Limited met on April 27, 2022 and recommended an Interim Dividend of $0.40 per share for the half-year ended March 31, 2022 payable on May 20, 2022.</p></div><span class ="number 186"><a href="https://guyanastockexchangeinc.com/bulletin-number/186/">Bulletin 186</a></span><span class="date">May 2022</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#19496" class="inline-popup">Guyana Bank for Trade and Industry Limited (BTI) &#8211; Annual General Meeting (AGM)</a></div><div id="19496" class="mfp-hide popup-content" ><p>Guyana Bank for Trade and Industry  Limited will hold their 34th Annual General Meeting on Monday May 23, 2022 at 4:00 p.m. at GBTI Corporate Office, High &amp; Young streets, Kingston, Georgetown.</p><p>The meeting will be held in a hybrid from (virtually/limited physical attendance) and conducted in the manner directed by Order of the Court.</p><ol><li>In order to reduce the number of members in physical attendance at the AGM to the requisite amount needed to constitute a quorum, members may appoint any one of the following designated persons to be their proxy and attend and vote on their behalf, that is to say:<ol><li>Suresh Beharry</li><li>Edward Beharry</li><li>Basil Mahadeo</li><li>Stanley Boodie</li><li>Agatha C. Ramjohn</li><li>Nazam Ramjohn</li></ol></li><li>Members may also attend and vote at the AGM by means of the Guyana Bank for Trade and Industry Limited Zoom virtual meeting platform.</li><li>In order to facilitate the effective use of the Zoom virtual meeting platform members may submit questions at least 48 hours before the commencement of the AGM to the following email address: marketing@gbtibank.com</li></ol></div><span class ="number 185"><a href="https://guyanastockexchangeinc.com/bulletin-number/185/">Bulletin 185</a></span><span class="date">April 2022</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#19218" class="inline-popup">Guyana Bank for Trade and Industry Limited (BTI) &#8211; proposes a Final Dividend of $12.50 per share for 2021</a></div><div id="19218" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. recommend the payment of a Final Dividend of $12.50 per share, which will bring total dividends to $16.00 for 2021. This recommendation is subject to the approval of the Bank of Guyana and the shareholders at their Annual General Meeting.</p></div><span class ="number 184"><a href="https://guyanastockexchangeinc.com/bulletin-number/184/">Bulletin 184</a></span><span class="date">March 2022</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#19215" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; Confirmation of Chief Executive Officer</a></div><div id="19215" class="mfp-hide popup-content" ><p>Effective March 16, 2022, Mr. James Eoin Foster has been confirmed Chief Executive Officer of Guyana Bank for Trade &amp; Industry Limited. Mr. Foster was previously Chief Executive Officer (acting). He is now confirmed to the substantive position.</p></div><span class ="number 184"><a href="https://guyanastockexchangeinc.com/bulletin-number/184/">Bulletin 184</a></span><span class="date">March 2022</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#17700" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $3.50 per share Interim Dividend for 2021</a></div><div id="17700" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on Tuesday, July 20, 2021 and agreed to recommend the payment of an Interim Dividend of $3.50 per share for 2021.</p><p>This recommendation is subject to the approval of the Bank of Guyana.</p></div><span class ="number 177"><a href="https://guyanastockexchangeinc.com/bulletin-number/177/">Bulletin 177</a></span><span class="date">July 2021</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#17482" class="inline-popup">Guyana Bank for Trade and Industry Limited (BTI) &#8211; Annual General Meeting</a></div><div id="17482" class="mfp-hide popup-content" ><p>Guyana Bank for Trade and Industry  Limited will hold their 33rd Annual General Meeting on Monday June21, 2021 at 4:00 p.m. at GBTI Corporate Office, High &amp; Young streets, Kingston, Georgetown.</p><p>&#8220;In light of the restrictions on public gatherings as a result of the COVID-19 pandemic, the meeting will be held virtually via Zoom Meeting portal as directed by Court order.</p><ol><li>No more than ten individuals of whom six individuls whose names are set out at (i)-(vi) below representing personally or by proxy, no less than 10% of the shareholding of GBTI shall be present  at the meeting in their capacity solely as shareholders namely;<ul><li>Suresh Beharry</li><li>Edward Beharry</li><li>Basil Mahadeo</li><li>S. Boodie</li><li>A. Ramjohn</li><li>N. Ramjohn</li></ul></li><li>Shareholders of GBTI are entitled to observe and participate in the AGM virtually but not to be physically present at the AGM</li><li>Shareholders of GBTI are entitled to appoint one of the six individuals named at (1) above as their proxy with instructions as to voting on the Resolutions to be proposed at the AGM which are contained in the Notice sent to Shareholders.</li></ol></div><span class ="number 176"><a href="https://guyanastockexchangeinc.com/bulletin-number/176/">Bulletin 176</a></span><span class="date">June 2021</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#15933" class="inline-popup">Guyana Bank for Trade and Industry Limited (BTI) &#8211; Annual General Meeting (Postponement)</a></div><div id="15933" class="mfp-hide popup-content" ><p>GBTI had scheduled its financial year 2019 Annual General Meeting for August 28, 2020, however, as a result of the decisions taken by the government on the protocols for managing COVID-19 and with reference to COVID-19 emergency measures (No.8) published in the Official Gazette 14 August, 2020, the bank has taken the decision to postpone the holding of the aforementioned AGM to a date later in the year. That decision considers the restrictions on large gatherings and the wellbeing of shareholders, employees and the public at large.</p><p>The bank is cognizant of its obligations to its shareholders and will work to a timely convening of the AGM in the interest of all stakeholders.</p></div><span class ="number 168"><a href="https://guyanastockexchangeinc.com/bulletin-number/168/">Bulletin 168</a></span><span class="date">August 2020</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#13149" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; proposes a $4.00 per share Interim Dividend for 2019</a></div><div id="13149" class="mfp-hide popup-content" ><p>The Directors of Guyana Bank for Trade &amp; Industry Ltd. met on August 5, 2019 and approved the payment of an Interim Dividend of $4.00 per share for 2019.</p></div><span class ="number 159"><a href="https://guyanastockexchangeinc.com/bulletin-number/159/">Bulletin 159</a></span><span class="date">August 2019</span></div></div><div class="bulletin"><div class="info group"><div class="title"><a href="#13148" class="inline-popup">Guyana Bank for Trade &#038; Industry Ltd. (BTI) &#8211; Closure of Share Register</a></div><div id="13148" class="mfp-hide popup-content" ><p>The Share Register of Guyana Bank for Trade &amp; Industry Ltd. will be closed from September 6 &#8211; September 20, 2019 to facilitate the distribution of dividends on September 23, 2019.</p></div><span class ="number 159"><a href="https://guyanastockexchangeinc.com/bulletin-number/159/">Bulletin 159</a></span><span class="date">August 2019</span></div></div></div></div></div><div id="primary" class="content-area col span-9"><h2> Financials</h2><div class="carousel financials financial-nav"><div class="slide" id="2026">2026</div><div class="slide" id="2025">2025</div><div class="slide" id="2024">2024</div><div class="slide" id="2023">2023</div><div class="slide" id="2022">2022</div><div class="slide" id="2021">2021</div><div class="slide" id="2020">2020</div><div class="slide" id="2019">2019</div><div class="slide" id="2018">2018</div></div><div class="small">-->Select Year</div><div class="slider financials financial-years"><div class="year slide" id="2026"><h3>2026</h3><div class="fin-data"><table class="financial-session"><thead><tr><th class="session">Session</th><th class="date">Ses