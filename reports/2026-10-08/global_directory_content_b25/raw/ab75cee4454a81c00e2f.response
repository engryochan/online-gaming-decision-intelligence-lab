ce">1</td></tr><tr class="trade" BTI><td class="session"><a href="https://guyanastockexchangeinc.com/financial_session/1159/">1159</a></td><td class="date">09/02/2026</td><td class="name">1,845.0</td><td class="best bid">113.11</td><td class="vol bid">16.3</td><td class="best offer">39.00</td><td class="vol offer">2.1%</td><td class="opening price">1</td></tr><tr class="trade" BTI><td class="session"><a href="https://guyanastockexchangeinc.com/financial_session/1160/">1160</a></td><td class="date">16/02/2026</td><td class="name">1,845.0</td><td class="best bid">113.11</td><td class="vol bid">16.3</td><td class="best offer">39.00</td><td class="vol offer">2.1%</td><td class="opening price">1</td></tr><tr class="trade" BTI><td class="session"><a href="https://guyanastockexchangeinc.com/financial_session/1161/">1161</a></td><td class="date">25/02/2026</td><td class="name">1,850.0</td><td class="best bid">111.06</td><td class="vol bid">16.7</td><td class="best offer">39.00</td><td class="vol offer">2.1%</td><td class="opening price">1</td></tr><tr class="trade" BTI><td class="session"><a href="https://guyanastockexchangeinc.com/financial_session/1162/">1162</a></td><td class="date">02/03/2026</td><td class="name">1,850.0</td><td class="best bid">111.06</td><td class="vol bid">16.7</td><td class="best offer">41.00</td><td class="vol offer">2.2%</td><td class="opening price">2</td></tr><tr class="trade" BTI><td class="session"><a href="https://guyanastockexchangeinc.com/financial_session/1163/">1163</a></td><td class="date">09/03/2026</td><td class="name">1,850.0</td><td class="best bid">111.06</td><td class="vol bid">16.7</td><td class="best offer">41.00</td><td class="vol offer">2.2%</td><td class="opening price">2</td></tr><tr class="trade" BTI><td class="session"><a href="https://guyanastockexchangeinc.com/financial_session/1164/">1164</a></td><td class="date">16/03/2026</td><td class="name">1,850.0</td><td class="best bid">111.06</td><td class="vol bid">16.7</td><td 