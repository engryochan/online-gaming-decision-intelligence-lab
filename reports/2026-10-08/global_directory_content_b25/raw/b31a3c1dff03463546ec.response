    <script>
        const lightThemePath = '/RNVIWeb/Content/css/ClaroOscuro/light-theme.css';
        const darkThemePath = '/RNVIWeb/Content/css/ClaroOscuro/dark-theme.css';
        const lightLogoPath = '/RNVIWeb/Content/images/Logo-Sugeval.png';
        const darkLogoPath = '/RNVIWeb/Content/images/SUGEVAL.jpg';

        function setTheme(theme) {
            var normalizedTheme = theme === 'dark' ? 'dark' : 'light';
            var themePath = normalizedTheme === 'dark' ? darkThemePath : lightThemePath;
            document.getElementById('themeStylesheet').setAttribute('href', themePath);
            localStorage.setItem('theme', normalizedTheme);

            var themeToggle = document.getElementById('themeToggle');
            if (themeToggle) {
                themeToggle.checked = normalizedTheme === 'dark';
            }

            var themeToggleMobile = document.getElementById('themeToggleMobile');
            if (themeToggleMobile) {
                themeToggleMobile.checked = normalizedTheme === 'dark';
            }

            var logo = document.getElementById('logoSugeval');
            if (logo) {
                logo.setAttribute('src', normalizedTheme === 'dark' ? lightLogoPath: darkLogoPath );
            }
        }

        (function () {
            var savedTheme = localStorage.getItem('theme') || 'light';
            setTheme(savedTheme);

            var themeToggle = document.getElementById('themeToggle');
            if (themeToggle) {
                themeToggle.addEventListener('change', function () {
                    setTheme(this.checked ? 'dark' : 'light');
                });
            }

            var themeToggleMobile = document.getElementById('themeToggleMobile');
            if (themeToggleMobile) {
                themeToggleMobile.addEventListener('change', function () {
                    setTheme(this.checked ? 'dark' : 'light');
                });
            }
        })();
    </script>
</body>
