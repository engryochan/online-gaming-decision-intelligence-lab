                                        <div class="portal-button-collection">
                                            <div>
                                                <span class="asic-text-body-xsmall">Already have an account?</span>
                                                <a class="asic-button asic-button--primary" href="https://www.edge.asic.gov.au/001/regaportal/get/ServicesLogin"><span class="asic-icon" data-symbol="account_circle"></span>Log in</a>
