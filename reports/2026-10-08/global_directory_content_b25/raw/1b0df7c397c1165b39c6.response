<script type="text/javascript">
$(document).ready(function() 
{
    $.tablesorter.addParser({
        // set a unique id          
        id: 'delisted',
        is: function(s) {
            // return false so this parser is not auto detected
            return false;
        },
        format: function(s) {
            var x = s.split(";")
            return x[1];
        },
        // set type, either numeric or text
        type: 'numeric'
    });

    $.tablesorter.addParser({
        // set a unique id          
        id: 'suspended',
        is: function (s) {
            // return false so this parser is not auto detected
            return false;
        },
        format: function (s) {
            var x = s.split(";")
            return x[1];
        },
        // set type, either numeric or text
        type: 'numeric'
    });

    // call the tablesorter plugin 
    $("#myTable").tablesorter({ 
        // sort on the first column and third column, order asc 
        widgets: ["zebra"],
        headers: { 
          2: {sorter:'suspended'} 
        }          
    });

    $("#myTable_delisted").tablesorter({
        // sort on the first column and third column, order asc 
        widgets: ["zebra"],
        headers: {
            2: { sorter: 'delisted' }
        }
    });
    
    var pagesize = 20;

    if ($("#pager select").length > 0) {
        pagesize = $("#pager select").val();
    }
    $("#myTable").tablesorter({ widgets: ["zebra"] });
    $("#myTable").tablesorterPager({ container: $("#pager"), positionFixed: false, size: pagesize });

    $("#myTable_delisted").tablesorter({ widgets: ["zebra"] });
    $("#myTable_delisted").tablesorterPager({ container: $("#pager"), positionFixed: false, size: pagesize });

    //$("#myTable").tablesorter( { widgets: ["zebra"] } );
});
</script>


