<div id="divFCRC" class="col-xs-4 pull-right pRight0">

    <div class="boxed-panel">
        <h2 class="styled small">Ghiduri pentru listare</h2>

        <p class="mTop20">
            <a href="/info/Rapoarte/Ghiduri/_BVB_Finanteaza-ti_Compania-2026-02-05.pdf" target="_blank">
                <b>Listarea la BVB - Brosura</b>
