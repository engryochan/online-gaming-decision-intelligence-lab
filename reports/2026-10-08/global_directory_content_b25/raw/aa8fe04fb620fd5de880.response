    <a id="back-to-top" href="#" class="btn btn-cyan btn-lg back-to-top" style="opacity: 0.5; padding: 6px 12px 12px 14px;" role="button"><span class="glyphicon glyphicon-chevron-up white"></span></a>

    <script>
        function ProgressCheckbox() {
            // progress functionality on checkbox change        
            $('.process-row input[type="checkbox"]').change(function (e) {
                if ($(this).closest('.process-row').is('.done')) {
                    var pos = $(this).closest('.process-row').index() - 1;
                } else {
                    var pos = $(this).closest('.process-row').index();
                }
                $('.process-row').each(function (i) {
                    if (i <= pos) {
                        $(this).addClass('done').find('input[type="checkbox"]').prop('checked', true);
                    } else {
                        $(this).removeClass('done').find('input[type="checkbox"]').prop('checked', false);
                    }
                })
            })
        }

        $(document).ready(ProgressCheckbox);
        Sys.WebForms.PageRequestManager.getInstance().add_endRequest(ProgressCheckbox);

        $(document).ready(function () {
            $(window).scroll(function () {
                if ($(this).scrollTop() > 50) {
                    $('#back-to-top').fadeIn();
                } else {
                    $('#back-to-top').fadeOut();
                }
            });
            $('#back-to-top').click(function () {
                $('body,html').animate({
                    scrollTop: 0
                }, 800);
                return false;
            });
        });

    </script>


