                                            //     for (let i = 1; i < chartClosingData.length; i++) {

                                            //         dataMap[chartClosingData[i][0]] = chartClosingData[i][1];

                                            //     }



                                            //     const filledData = [chartClosingData[0]]; // Header: ["Month", "Close Price"]



                                            //     let current = moment(startDate);

                                            //     while (current <= endDate) {

                                            //         const dateStr = current.format('DD MMM YYYY');

                                            //          const value = dataMap.hasOwnProperty(dateStr) ? dataMap[dateStr] : 0;

                                            //         filledData.push([dateStr, value]);

                                            //         current.add(1, 'days'); // You can use .add(1, 'months') for monthly steps

                                            //     }



                                            //     drawChartclosingpricehistory(filledData, chartClosingTitle);

                                            // }



                                            $(document).ready(function() {

                                                // Trigger filter and redraw chart when clicking "Update Chart" button

                                                $('.updated-chart').on('click', function() {

                                                    filterAndDrawChart();

                                                });

                                                

                                            });

                                        </script>

