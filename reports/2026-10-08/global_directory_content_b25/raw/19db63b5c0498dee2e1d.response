                                            const chartVolumeTitle = "Volume Data";



                                            // Function to draw the chart

                                            function drawChartVolume(filteredData, chartVolumeTitle) {

                                                try {

                                                    const data = google.visualization.arrayToDataTable(filteredData);



                                                    const options = {

                                                        title: chartVolumeTitle,

                                                        hAxis: { title: '', titleTextStyle: { color: '#333' },showTextEvery: 7 },

                                                        vAxis: { title: 'Total Volume', minValue: 0 },

                                                        colors: ['#4285F4'],

                                                        areaOpacity: 0,

                                                        lineWidth: 2,

                                                        curveType: 'function',

                                                        legend: { position: 'left' }

                                                    };



                                                    const chart = new google.visualization.AreaChart(document.getElementById('chart_div_volume'));

                                                    chart.draw(data, options);

                                                } catch (error) {

                                                    console.error('Error drawing chart:', error);

                                                }

                                            }



                                            // Initial chart render without filtering

                                            function drawChartWithoutFilterVolume() {

                                                drawChartVolume(chartVolumeData, chartVolumeTitle);

                                            }



                                            // Function to filter the chart data based on date range

                                            function filterAndDrawVolumeChart() {

                                                const dateRange = $('#volumedatadatepicker').val();

                                                if (!dateRange) return;



                                                const [startDateStr, endDateStr] = dateRange.split(' - ');



                                                // Convert selected dates to a comparable format

                                                const startDate = moment(startDateStr, 'MM/DD/YYYY').toDate();

                                                const endDate = moment(endDateStr, 'MM/DD/YYYY').toDate();



                                                const filteredData = chartVolumeData.filter((row, index) => {

                                                    if (index === 0) return true; // Keep header row



                                                    const rowDate = moment(row[0], 'MMM D, YYYY').toDate();

                                                    return rowDate >= startDate && rowDate <= endDate;

                                                });



                                                if (filteredData.length > 1) {
                                                    drawChartVolume(filteredData, chartVolumeTitle);
                                                } else {
                                                    $('#chart_div_volume').html(
                                                        "<div style='text-align:center; padding:40px; color:#888;'>No data available for the selected date range</div>"
                                                    );
                                                }

                                            }



                                            $(document).ready(function() {

                                                // Trigger filter and redraw chart when clicking "Update Chart" button

                                                $('.update-volume-chart').on('click', function() {

                                                    filterAndDrawVolumeChart();

                                                });

                                            });

                                        </script>

                                    </head>



                                    <body>

                                        <div id="chart_div_volume" style="width: 112%; height: 320px;"></div>

                                    </body>



                                </html>

                            
