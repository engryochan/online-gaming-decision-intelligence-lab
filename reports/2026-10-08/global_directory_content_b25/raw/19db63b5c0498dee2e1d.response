<script  type="text/javascript" nonce="2QGX/Wq2PpOdB0ZsqzmU3A==">
     $(document).ready(function(){
        $('.all_news_front').on('click', function() {
            var catField = $(this).data('id');
            var stockDataSymbol = $(this).data('name');
            sendAjaxRequest(catField,stockDataSymbol);
        });
    });

    function sendAjaxRequest(catField,stockDataSymbol) {
        sessionStorage.setItem('newsCategoryId', catField);
        sessionStorage.setItem('stockSymbol', stockDataSymbol);
        window.location.href = '/news';
    }
    $(document).ready(function () {
    const hash = window.location.hash;
    if (hash) {
        const tabTrigger = document.querySelector(`button[data-bs-target="${hash}"]`);
        if (tabTrigger) {
            const tab = new bootstrap.Tab(tabTrigger);
            tab.show();
        }
    }
    filterAndDrawChart();
    filterAndDrawVolumeChart();
});
</script>
