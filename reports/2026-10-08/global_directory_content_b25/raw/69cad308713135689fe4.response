                    <span class="hrelev-hora">11:25</span>
                    <span class="hrelev-fecha">22/09/2026</span>
                </div><div class="hrelev-enlace">
                    <a href="/docs/Documentos/esp/hechosrelev/2026/Aviso-aos-Acionistas-Cemig-2026-09-17-Fcp7LwWf.pdf" target="_blank" class="pdf"><span class="tam">132 KB</span> Declaration of Interest on Equity</a>
                </div></div><div><div class="hrelev-datos">
