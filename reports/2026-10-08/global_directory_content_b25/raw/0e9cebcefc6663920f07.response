    <div class="searchResult">
        <button id ="get-result">بحث<span class="btn-ring"></span></button>
        <button id ="reset-result">تفريغ الحقول</button>
    </div>




    <span id="resulte-from" >
    </span>
    <span id="resulte-count">
    </span>
    <div id ="resulte">

    </div>
</div>
<script>


    $(function () {
        var queryString = window.location.search;
        var urlParams = new URLSearchParams(queryString);
        var categoryId = urlParams.get('categoryId');
        var resulteFrom = document.getElementById('resulte-from');
        var resulteCount = document.getElementById('resulte-count');

        if (queryString.includes("priview"))
        {



            setTimeout(() => {
                if (queryString.includes("publicissuerstatus"))
                {
                    $("#publicissuerstatus").val(urlParams.get('publicissuerstatus'));
                    $("#publicissuername").val(urlParams.get('publicissuername'));
                    $("#securitycategory").val(urlParams.get('securitycategory'));
                    $("#securitystatus").val(urlParams.get('securitystatus'));
                    $("#currencytype").val(urlParams.get('currencytype'));
                    $("#get-result").click();
                } else
                {

                }
            }, 1000);
        }
        if (queryString.includes("print"))
        {



            setTimeout(() => {
                if (queryString.includes("publicissuerstatus"))
                {
                    $("#publicissuerstatus").val(urlParams.get('publicissuerstatus'));
                    $("#publicissuername").val(urlParams.get('publicissuername'));
                    $("#securitycategory").val(urlParams.get('securitycategory'));
                    $("#securitystatus").val(urlParams.get('securitystatus'));
                    $("#currencytype").val(urlParams.get('currencytype'));
                    $("#get-result").click();
                } else
                {

                }

            }, 1000);

        }


        
        var TableId = [];
        $('#get-result').click(function () {

            var issuerStatus = $("#publicissuerstatus").find(":selected").val();
            var issuerID = $("#publicissuername").find(":selected").val();
            var securityCategory = $('#securitycategory').find(":selected").val();
            var securityStatus = $("#securitystatus").find(":selected").val();
            var currencytype = $('#currencytype').find(":selected").val();
            TableId = [];
            $(".btn-ring").show();
            $("#get-result").prop('disabled', true);
            $("#get-result").val('disabled');
            setTimeout(function () {
                $(".btn-ring").hide();
                $("#get-result").prop('disabled', false);
                if (categoryId == 1)
                {
                    resulteFrom.innerHTML = `نتائج البحث في سندات حكومية`;
                } else {
                    resulteFrom.innerHTML = `نتائج البحث في سندات / اسناد قرض شركات	`;
                }
            }, 1000);

            getFilterResulte(categoryId, issuerStatus, issuerID, securityStatus, securityCategory, currencytype,TableId);
            

            setTimeout(function () {
    

                    $(".tablesorter").tablesorter({headers: {3: {sorter: "text"},
                            '.columnSelector-disable': {
                                // disable it by setting the property sorter to false
                                sorter: false
                            }
                        },
                        widgets: ['zebra', 'indexFirstColumn']});
                }, 3000);
            });
             $('#excell').click(function(){
                console.log(TableId)

                if(TableId.length > 0)
                {
                   let filename = document.querySelector('.inner-image h1.page-title')
                        fnExcelReport(TableId,filename.innerHTML)
                }
                    
            });
        });
  
            $('#reset-result').click(function () {
                location.reload();
            });


            $('#customPrintRiview').click(function () {
                const publicissuerstatus = $("#publicissuerstatus").find(":selected").val();
                const publicissuername = $("#publicissuername").find(":selected").val();
                const securitycategory = $("#securitycategory").find(":selected").val();
                const securitystatus = $("#securitystatus").find(":selected").val();
                const currencytype = $("#currencytype").find(":selected").val();
                if (publicissuerstatus == '0' && publicissuername == '0' && securitystatus == '0')
                {
                    const urL = window.location + `&publicissuerstatus=0&publicissuername=0&securitycategory=${securitycategory}&securitystatus=0&currencytype=${currencytype}&priview=1`;
                    window.open(urL);
                } else
                {
                    const urL = window.location + `&publicissuerstatus=${publicissuerstatus}&publicissuername=${publicissuername}&securitycategory=${securitycategory}&securitystatus=${securitystatus}&currencytype=${currencytype}&priview=1`;
                    window.open(urL);
                }




            });

            $('#customPrint').click(function () {
                const publicissuerstatus = $("#publicissuerstatus").find(":selected").val();
                const publicissuername = $("#publicissuername").find(":selected").val();
                const securitycategory = $("#securitycategory").find(":selected").val();
                const securitystatus = $("#securitystatus").find(":selected").val();
                const currencytype = $("#currencytype").find(":selected").val();
                if (publicissuerstatus == '0' && publicissuername == '0' && securitystatus == '0')
                {
                    const urL = window.location + `&publicissuerstatus=0&publicissuername=0&securitycategory=${securitycategory}&securitystatus=0&currencytype=${currencytype}&priview=1&print=1`;
                    window.open(urL);
                } else
                {
                    const urL = window.location + `&publicissuerstatus=${publicissuerstatus}&publicissuername=${publicissuername}&securitycategory=${securitycategory}&securitystatus=${securitystatus}&currencytype=${currencytype}&priview=1&print=1`;
                    window.open(urL);
                }






            });

           



       
        async function getFilterIssuerStatus(indexOfData)
        {
            var publicIssuerName = Drupal.t('@publicIssuerName', {'@publicIssuerName': 'جميع المصدرين العامين'});
            var securitystatus = "جميع الحالات";
            const urlParams = new URLSearchParams(window.location.search);
            const categoryId = urlParams.get('categoryId');
            const issuerID = urlParams.get('issuerID');

            const response = await fetch('governmentCorporateBonds?categoryId=' + categoryId + '&issuerStatus=' + indexOfData + '&issuerID=' + issuerID);
            console.log(response)
            const data = await response.json();

            $('#publicissuername option').remove();
            $('#securitystatus option').remove();
            keys = Object.keys(data['filter']['publicIssuerNames']);
            console.log(data['filter']['publicIssuerNames'])
            $('#publicissuername').append(`<option value="0">${publicIssuerName}</option>`);
            for (i_options = 0; i_options < keys.length; i_options++)
            {
                var optionValue = keys[i_options];
                var optionText = data['filter']['publicIssuerNames'][keys[i_options]];
                $('#publicissuername').append(`<option value="${optionValue}">${optionText}</option>`);
            }

            keysSecuritystatus = Object.keys(data['filter']['securityStatus']);
            $('#securitystatus').append(`<option value="0">${securitystatus}</option>`);
            for (i_options = 0; i_options < keysSecuritystatus.length; i_options++)
            {
                var optionValue = keysSecuritystatus[i_options];
                var optionText = data['filter']['securityStatus'][keysSecuritystatus[i_options]];
                $('#securitystatus').append(`<option value="${optionValue}">${optionText}</option>`);
            }

            if (indexOfData == 2)
            {
                $('#securitystatus').attr("disabled", true);
            } else
            {
                $('#securitystatus').attr("disabled", false);
            }




        }

        async function getFilterSecurityCategory(indexOfData)
        {
            var securityCategory = Drupal.t('@securityCategory', {'@securityCategory': 'جميع الفئات'});
            const urlParams = new URLSearchParams(window.location.search);
            const categoryId = urlParams.get('categoryId');

            var issuerStatus = $("#publicissuerstatus").find(":selected").val();

            const response = await fetch('governmentCorporateBonds?categoryId=' + categoryId + '&issuerStatus=' + issuerStatus + '&issuerID=' + indexOfData);
            const data = await response.json();
            console.log(response)
            $('#securitycategory option').remove();
            keys = Object.keys(data['filter']['securityCategory']);
            console.log(data['filter']['securityCategory'])
           
            if(keys.length == 1)
            {
                var optionValue = keys[0];
                var optionText = data['filter']['securityCategory'][keys[0]];
                $('#securitycategory').append(`<option value="${optionValue}">${optionText}</option>`);
            }
            else 
            {

                $('#securitycategory').append(`<option value="0">${securityCategory}</option>`);
                for (i_options = 0; i_options < keys.length; i_options++)
                {
                    var optionValue = keys[i_options];
                    var optionText = data['filter']['securityCategory'][keys[i_options]];
                    $('#securitycategory').append(`<option value="${optionValue}">${optionText}</option>`);
                }
            }




        }
        async function getFilterResulte(categoryId, issuerStatus, issuerID, securityStatus, securityCategory, CurrencyType,TableId)
        {
            
            console.log(issuerID)
            var divOfTable = document.getElementById('resulte');
            let childDiv = document.querySelector('groupTable');
