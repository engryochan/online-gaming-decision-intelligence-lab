        async function getFiltermemmbers(result1, index1, total)
        {



            const resulteData = result1['memmbers'];

            var table = document.getElementById(index1);

            var tbodyRef = table.getElementsByTagName('tbody')[0];
            var tfootRef = table.getElementsByTagName('tfoot')[0];
            var keys = Object.keys(resulteData);
            for (i_col = 0; i_col < keys.length; i_col++)
            {
                var newRow = tbodyRef.insertRow();
                newCell = newRow.insertCell();
                newCell.innerHTML = `<a href='securityInformation?security_id=${resulteData[keys[i_col]]['security_id']}'>${resulteData[keys[i_col]]['security_id']}</a>`;
                newCell = newRow.insertCell();
                newCell.innerHTML = `<a href='securityInformation?security_id=${resulteData[keys[i_col]]['security_id']}'>${resulteData[keys[i_col]]['security_name']}</a>`;
                newCell = newRow.insertCell();
                newCell.innerHTML = `<a href='securityInformation?security_id=${resulteData[keys[i_col]]['security_id']}'>${resulteData[keys[i_col]]['issue_no']}</a>`;
                newCell = newRow.insertCell();
                newCell.innerHTML = `<a href='securityInformation?security_id=${resulteData[keys[i_col]]['security_id']}'>${resulteData[keys[i_col]]['status_code']}</a>`;
                newCell = newRow.insertCell();
                newCell.innerHTML = `<a href='securityInformation?security_id=${resulteData[keys[i_col]]['security_id']}'>${resulteData[keys[i_col]]['interest_rate']}</a>`;

                if (resulteData[keys[i_col]]['issue_date'] == null)
                {
                    newCell = newRow.insertCell().innerHTML = `-`
                } else {
                    newCell = newRow.insertCell().appendChild(document.createTextNode(resulteData[keys[i_col]]['issue_date']));
                }

                newCell = newRow.insertCell().appendChild(document.createTextNode(resulteData[keys[i_col]]['maturity_date']));
                newCell = newRow.insertCell().appendChild(document.createTextNode(resulteData[keys[i_col]]['total_value']));

            }
            var newRow = tfootRef.insertRow();
            newCell = newRow.insertCell();
            newCell.colSpan = 7;
            newCell.innerHTML = `${total}`;
            newCell = newRow.insertCell().appendChild(document.createTextNode(result1['memmbers_total']));
            ;


        }
        const breadcrumbs = JSON.parse("\u005B\u007B\u0022name\u0022\u003A\u0022\\u0627\\u0644\\u0635\\u0641\\u062d\\u0629\u0020\\u0627\\u0644\\u0631\\u0626\\u064a\\u0633\\u064a\\u0629\u0022,\u0022link\u0022\u003A\u0022\\\/ar\\\/\u0022\u007D,\u007B\u0022name\u0022\u003A\u0022\\u0645\\u0639\\u0644\\u0648\\u0645\\u0627\\u062a\u0020\\u0623\\u0639\\u0636\\u0627\\u0621\u0020\\u0627\\u0644\\u0645\\u0631\\u0643\\u0632\u0022,\u0022link\u0022\u003A\u0022\\\/ar\\\/members\u002Dinfo\u0022\u007D,\u007B\u0022name\u0022\u003A\u0022\\u0627\\u0644\\u0645\\u0635\\u062f\\u0631\\u064a\\u0646\u0020\\u0627\\u0644\\u0639\\u0627\\u0645\\u064a\\u0646\u0022,\u0022link\u0022\u003A\u0022\u0022\u007D\u005D");

        var custom_bread = document.getElementById('breadcrumb-custom');
        if (custom_bread != null)
        {
            custom_bread.innerHTML = ``;
            breadcrumbs.forEach(function (element, index, array) {
                if (index === array.length - 1)
                {
                    custom_bread.innerHTML += `${element['name']} `
                } else
                {
                    custom_bread.innerHTML += `<a href='${element['link']}'>${element['name']}</a> / `
                }
            });
        }



        



</script>
