        </ul>
    </div>

    <table class="publicissuerTableSearch">
        <tbody>
            <tr>
                <th width="25%">حالة المصدر العام</th>
                <td width="75%">
                    <select id="publicissuerstatus" onchange = 'getFilterIssuerStatus(this.value)'>
                        <option value="0"> جميع الحالات</option>
                                                    <option value =1 >حالي</option>
                                                    <option value =2 >سابق</option>
                        
                    </select>
                </td>
            </tr>
            <tr>
                <th>اسم المصدر العام</th>
                <td>
                    <select id="publicissuername" onchange = 'getFilterSecurityCategory(this.value)'>
                        <option value="0"> جميع المصدرين العامين</option>
                                                    <option value =150100 >حكومة المملكة الاردنية الهاشمية</option>
                                                    <option value =150200 >مؤسسة الاقراض الزراعي</option>
                                                    <option value =150300 >سلطة المياه الاردنية</option>
                                                    <option value =150400 >المؤسسة العامة للإسكان والتطوير الحضري</option>
                                                    <option value =150500 >شركة الكهرباء الوطنية</option>
                                                    <option value =150600 >الأردنية للصكوك الاسلامية لتمويل المشاريع الحكومية ذات الغرض الخاص</option>
                                                    <option value =150700 >الكوثر للتأجير التمويلي</option>
                                            </select>
                </td>   
            </tr>
            <tr>
                <th>فئة الورقة المالية</th>
                <td>
                    <select id="securitycategory">
                        <option value="0"> جميع الفئات</option>
                                                    <option value =33 >أذونات خزينة</option>
                                                    <option value =36 >أذونات مؤسسات حكومية</option>
                                                    <option value =71 >الاجارة</option>
                                                    <option value =73 >المرابحة</option>
                                                    <option value =72 >المضاربة/المقارضة</option>
                                                    <option value =78 >اي عقد اخر</option>
                                                    <option value =37 >سندات أفراد</option>
                                                    <option value =31 >سندات تنمية</option>
                                                    <option value =32 >سندات خزينة</option>
                                                    <option value =34 >سندات مؤسسات حكومية</option>
                                            </select>
                </td>  
            </tr>
            <tr>
                <th>حالة الورقة المالية</th>
                <td>
                    <select id="securitystatus">
                        <option value="0"> جميع الحالات</option>
                                                    <option value =1 >قائمة</option>
                                                    <option value =2 >مطفأة</option>
                                            </select>
                </td>  
            </tr>
            <tr>
                <th>نوع العملة</th>
                <td>
                    <select id="currencytype">

                                                    <option value =1 >الدينار الاردني</option>
                                                    <option value =22 >الدولار الأمريكي</option>
                                            </select>
                </td>  
            </tr>
        </tbody>
