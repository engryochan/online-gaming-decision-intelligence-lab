      float:left;
      background:url(/images/hometoptabs_left.png) no-repeat left top;
      margin:0;
       padding:0px 0px 0px 10px;
list-style-type:none;
text-decoration: none;
      }
    #hometoptabs a {
      float:left;
      display:block;
      
      background: url(/images/toptabs_right.png) no-repeat right top;
      padding:7px 14px 6px 1px;
      text-decoration:none;
      font-weight:bold;
      color:#1d4d82;
      }
    #hometoptabs > ul a {width:auto;}
    /* Commented Backslash Hack hides rule from IE5-Mac \*/
    #hometoptabs a {float:none;}
    /* End IE5-Mac hack */
    #hometoptabs a:hover {
      color:#1d4d82;
      }
    #hometoptabs .on {
      background-position:0 -28px;
      border-width:0;
      padding:0 0 0 36px;
      }

      
    #hometoptabs .on a {
      background-position:100% -28px;
      padding-bottom:6px;
      color:#1d4d82;
      }
    #hometoptabs li:hover, #toptabs li:hover a {
      background-position:0% -28px;
      color:#1d4d82;
cursor: pointer
      }
    #hometoptabs li:hover a {
      background-position:100% -28px;
cursor: pointer
      }
      
