  <table width="100%" border="0" cellspacing="0" cellpadding="0" class="tableSettings">
	<tr>
    <td><br>
	  <span id="tabshares" class="tabsInternal" onclick="setUnits('shares');"><a href="#">Volume</a></span>
	  <span id="tabtrades" class="tabsInternal" onclick="setUnits('trades');"><a href="#">Trades</a></span>
	  <span id="tabdollarVol" class="tabsInternal" onclick="setUnits('dollarVol');"><a href="#">Dollar Volume</a></span>
	  <span class="btnSetDefault" style="margin-left:10px" onclick="setDefaultUnits();"><a href="#">Set Default Tab</a></span>
    </td>
    <td style="width: 115px; vertical-align: bottom">
	<select name="select" id="select" class="dropDownCustom" style="position: relative; margin-top: 10px; border:1px solid #CCCCCC; padding-bottom: 0px" onchange="getDownload();">
	  <option selected value="">Download</option>
      <option value="daily">Most Recent Day</option>
