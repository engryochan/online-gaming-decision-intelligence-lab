<script type="text/javascript">
function tab5Start()
{
    GetPHLXTop1();
    GetPHLXTop2();
    GetPHLXTop3();
}
function tab5Stop()
{
    StopPHLXTop1();
    StopPHLXTop2();
    StopPHLXTop3();
}
function showPHLX(instance)
{
    switch (instance)
    {
        case "1":
            document.getElementById('PHLX1').style.display = "block";
            document.getElementById('PHLX2').style.display = "none";
            document.getElementById('PHLX3').style.display = "none";
            document.getElementById('subtab_1').className = "subtab_on";
            document.getElementById('subtab_2').className = "subtab_off";
            document.getElementById('subtab_3').className = "subtab_off";
            break;
        case "2":
            document.getElementById('PHLX1').style.display = "none";
            document.getElementById('PHLX2').style.display = "block";
            document.getElementById('PHLX3').style.display = "none";
            document.getElementById('subtab_1').className = "subtab_off";
            document.getElementById('subtab_2').className = "subtab_on";
            document.getElementById('subtab_3').className = "subtab_off";
            break;
        case "3":
            document.getElementById('PHLX1').style.display = "none";
            document.getElementById('PHLX2').style.display = "none";
            document.getElementById('PHLX3').style.display = "block";
            document.getElementById('subtab_1').className = "subtab_off";
            document.getElementById('subtab_2').className = "subtab_off";
            document.getElementById('subtab_3').className = "subtab_on";
            break;
    }
}
</script>
