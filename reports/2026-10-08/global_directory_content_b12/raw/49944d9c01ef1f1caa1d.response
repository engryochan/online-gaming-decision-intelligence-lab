<div id="equities">
  <div class="section_header">
    <h5>Equities Market <span id="equitiesLabel">Volume</span></h5>
  </div>
 <div id="equitiesTab">
 </div>
 <table width="100%" border="0" cellspacing="0" cellpadding="0" class="printBoxSmall">
  <tr>
    <td>Data is updated every 1 minute. <span class="smallGreenText">Last Update <span id="equitiesTs">11/04/2011 11:44</span></span></td>
    <td align="right"><span onclick="printEquitiesGrid(unit);"><a href="#"><img src="/images/printer2.png" width="16" height="16" /></a></span></td>
  </tr>
</table>
</div>
<table width="100%" border="0" cellspacing="0" cellpadding="0" class="tableSettingsHeader"  style="display: none;">
 	  <tr>
 	    <td style="position: relative; width: 150px;">&nbsp;</td>
 	     <td><br><a href="/Trader.aspx?id=OptionsVolumeSummary"><b>Full Options Market Volume Page</b></a><br></td>
 	  </tr></table>
 <div class="section_header_blue" style="display: none;">
    <h5>Options Market Volume</h5>
  </div>
  <div id="optionsTab"  style="display: none;">
  </div>
  <table width="100%" border="0" cellspacing="0" cellpadding="0" class="printBoxSmall"  style="display: none;">
  <tr>
    <td>Data is updated every 1 minute and may be delayed at least 10 minutes. <span class="smallGreenText">Last Update <span id="optionsTs">11/04/2011 11:44</span></span></td>
    <td align="right"><span onclick="printOptionsGrid();"><a href="#"><img src="/images/printer2.png" width="16" height="16" /></a></span></td>
  </tr>
</table>

</div>
<script>

	var unit = 'shares';

	var dataDate = new Date();

	function getDownload() {
		var e = document.getElementById('select');
		if (e.value == '')
			return;
		var filename = e.value;
		if (unit != 'shares')
			filename += unit;
		filename += '.csv';
		var url = '/dynamic/MarketStats/' + filename;
		window.open(url);
    }

	function printEquitiesGrid(val) {

        var popup = window.open("/snippets/marketvolprint.html?type=" + unit + "&dataDate=" + encodeURIComponent($.datepicker.formatDate('mm/dd/yy',dataDate)));
    }

	function printOptionsGrid() {

        var popup = window.open("/snippets/marketvoloptionsprint.html");
    }
	
	function tab6Stop()
	{
		StopMarketVol();
	}
	function tab6Start()
	{
		GetMarketVol();
	}
	
	function StopMarketVol() {
		clearTimeout(window.HomePageTimers['DailyVolumeTimer']);
	}

	function setUnits(val) {
		var tab1 = 'tabshares';
		var tab2 = 'tabtrades';
		var tab3 = 'tabdollarVol';
		var equitiesLabel = 'equitiesLabel';
		var e = document.getElementById(tab1);
		e.className = 'tabsInternal';
		e = document.getElementById(tab2);
		e.className = 'tabsInternal';
		e = document.getElementById(tab3);
		e.className = 'tabsInternal';
		e = document.getElementById('tab' + val);
		e.className = 'tabsInternal tabsInternalClicked';
		e = document.getElementById(equitiesLabel);
		if (val == 'shares')
			e.innerHTML = 'Volume';
		if (val == 'trades')
			e.innerHTML = 'Trades';
		if (val == 'dollarVol')
			e.innerHTML = 'Dollar Volume';
      unit = val;
		StopMarketVol();
		GetMarketVol();
    }

	function setDefaultUnits() {
        setCookie('MarketShareDefaultUnits',unit, 365);
    }

    function GetMarketVol() {

        var s;
        var s2;
		var mdy = $.datepicker.formatDate('mm/dd/yy',dataDate);

        s2 = 'equitiesTab';
        var e = document.getElementById(s2);
        if (e !=  null) e.innerHTML = "updating....";
		s2 = 'optionsTab';
        e = document.getElementById(s2);
        if (e !=  null) e.innerHTML = "updating....";
        Server.BL_MarketShare.GetUpdateMarkup(cb_GetUpdateMarkup, 'DESKTOP', unit, mdy);
		Server.BL_MarketShare.GetOptionsUpdateMarkup(cb_GetOptionsUpdateMarkup, 'DESKTOP');

        window.HomePageTimers['DailyVolumeTimer'] = setTimeout('GetMarketVol()', 1000*60);

    }

    function cb_GetUpdateMarkup(r, e){
        if (e) return alert(e.message);
		var a = r.split('|');
        var d = document.getElementById('equitiesTab');
        if (d != null)
            d.innerHTML = a[1];
		d = document.getElementById('equitiesTs');
        if (d != null)
            d.innerHTML = a[0];

    }

	function cb_GetOptionsUpdateMarkup(r, e){
        if (e) return alert(e.message);
		var a = r.split('|');
        var d = document.getElementById('optionsTab');
        if (d != null)
            d.innerHTML = a[1];
		d = document.getElementById('optionsTs');
        if (d != null)
            d.innerHTML = a[0];

    }

	var availableDates = [];

function initAvailableDates() {
	var d = $.datepicker.formatDate('mm/dd/yy',new Date());
	availableDates.push(d);
	var x = Server.BL_MarketShare.GetMarketVolumeDates();
	var i;
	var xx;
	for (i = 0; i < x.length; i++)
	{
		xx = x[i];
		availableDates.push(xx.ValidDate);
	}
}

function available(date) {
  mdy = $.datepicker.formatDate('mm/dd/yy',date);
  if ($.inArray(mdy, availableDates) >= 0) {
    return [true,"","Choose"];
  } else {
    return [false,"","Invalid Date"];
  }
}

function onDateSelect(dateText, inst)
{
	dataDate = new Date(dateText);
	GetMarketVol();
}
function setDatePicker() {
  $('#chooseDate').datepicker({
  ampm: true,
  showOn: "both",
  buttonImage: "/images/calendar_16x16.gif",
  buttonImageOnly: true,
  buttonText: "Choose another date",
  beforeShowDay: available,
  onSelect: onDateSelect
  });
}

$(function(){
    document.getElementById('chooseDate').value = $.datepicker.formatDate('mm/dd/yy',dataDate);
    setDatePicker();
	initAvailableDates();
	var myUnit = getCookie('MarketShareDefaultUnits');
	if (myUnit == null || myUnit == '')
		myUnit = 'shares';
	window.HomePageTimers= new Object();
	window.HomePageTimers.DailyVolumeTimer = null;
	setUnits(myUnit);
});

</script>
</div>
<div class="block" id="tab4div" style="display: none; z-index: 1; overflow: auto; height: 475px; width: 715px; border: 1px solid; */margin-top: 5px;">    <!-- Begin TopMatched.html -->
    <div id="divTopMatched">    

 </div>

<script language="javascript" type="text/javascript">
    var currentView;

    function switchViewTopMatched(val)
    {
	    var from;
	    var to;

	    if (val == 'as')
	    {
		    from = 'ah';
		    to = 'as';
	    }
	    else
	    {
		    from = 'as';
		    to = 'ah';
        }

        currentView = to;

	    var elm = document.getElementById(from + 'Grid');
	    elm.style.display = 'none';

	    elm = document.getElementById(to + 'Grid');
	    elm.style.display = 'block';

	    elm = document.getElementById(from + 'Dot');
	    elm.style.display = 'none';

	    elm = document.getElementById(to + 'Dot');
	    elm.style.display = '';

	    elm = document.getElementById(from + 'Button');
	    elm.style.backgroundColor = 'white';

	    elm = document.getElementById(to + 'Button');
	    elm.style.backgroundColor = '#ECF3F9';
   }
	
    function tab4Stop()
	{
		TopMatchedStop();
    }

	function tab4Start()
	{
		TopMatchedInit();
    }

	function GetTopMatched() 
    {
        var s;
        var s2;
        s2 = 'divTopMatched';

        var e = document.getElementById(s2);
        if (e != null) e.innerHTML = "updating....";

        Server.BL_NasdaqTopMatched.GetTopMatchedMarkup(cb_GetTopMatched, 'TopMatched.html');
        TopMatchedStart();
    }

    function cb_GetTopMatched(r, e)
    {
        if (e) return alert(e.message);
        var d = document.getElementById('divTopMatched');
        if (d != null)
        {   d.innerHTML = r;
			switchViewTopMatched(currentView);
		}
    }


    var topMatchedInitDone = false;

	function TopMatchedStart()
	{
	   window.HomePageTimers['topMatchedTimer'] = setTimeout('GetTopMatched()', 1000*60);
	}
	
	function TopMatchedInit()
	{		
		if (!topMatchedInitDone)
		{   currentView = 'as';			
			topMatchedInitDone = true;
		}
		GetTopMatched();
    }

	function TopMatchedStop()
	{
		if (window.HomePageTimers['topMatchedTimer'])
			clearTimeout(window.HomePageTimers['topMatchedTimer']);
	}
</script>


<table style="width:540px;padding-top:15px;padding-left:5px;">
    <tr><td class="footnote" style="text-align:left;padding-top:8px;font-size:9px;font-weight:bold;">
            Data is updated every minute.
            <p style="padding-top:7px;">Refer to <a href="http://www.nasdaqtrader.com/content/MarketStatistics/MarketShare/terms.pdf">NASDAQ Market Share Terminology</a> for more information regarding Matched Handled volume.</p>
