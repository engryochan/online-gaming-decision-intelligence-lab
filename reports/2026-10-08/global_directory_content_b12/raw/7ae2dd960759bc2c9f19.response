    <div class="plx plx-up plx-custom" style="botom: -330px; left: -65px;">
                    <img decoding="async" src="https://www.sfox.com/wp-content/uploads/2026/02/deco-6.svg" class="attachment-full size-full" alt="Deco 6" >            </div>
</div>

</div>
</div>



