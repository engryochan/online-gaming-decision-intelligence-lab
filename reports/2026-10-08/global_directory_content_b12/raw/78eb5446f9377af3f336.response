                    <section id="2025-bnd1">
                        <h4 class="h4 mb-6 text-green">BND1</h4>
                        <div class="mb-12 grid gap-6 sm:grid-cols-2">
                            <div class="flex flex-col items-center justify-center gap-2 md:gap-3">
                                <img src="https://www.bdcb.gov.bn/img/currency/security-features/2025/bnd1-front.webp" class="shadow-banknote" alt="BND1 note">
                                <p class="font-bold text-gold">OBVERSE (FRONT) SIDE</p>
                            </div>
                            <div class="flex flex-col items-center justify-center gap-2 md:gap-3">
                                <img src="https://www.bdcb.gov.bn/img/currency/security-features/2025/bnd1-back.webp" class="shadow-banknote" alt="BND1 note">
                                <p class="font-bold text-gold">REVERSE (BACK) SIDE</p>
                            </div>
