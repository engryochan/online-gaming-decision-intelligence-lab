<div id="contactModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="contactModal-title">
<div class="modal-dialog">
<div id="modal-content" class="modal-content">
<div class="modal-header">
<h5 class="modal-title">Inquiries</h5>
<button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">×</span></button>
</div>
<div class="modal-body">
<form action="https://formspree.io/f/mayarkrr" method="post">
<input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response">
<div class="form-group">
<input required type="text" class="form-control" name="first_name" autocomplete="off" maxlength="60" placeholder="First Name" title="First Name" aria-label="First Name">
</div>
<div class="form-group">
<input required type="text" class="form-control" name="last_name" autocomplete="off" maxlength="60" placeholder="Last Name" title="Last Name" aria-label="Last Name">
</div>
<div class="form-group">
<input type="text" class="form-control" name="company" autocomplete="off" maxlength="100" placeholder="Company" title="Company" aria-label="Company">
</div>
<div class="form-group">
<input required type="text" class="form-control" name="email" autocomplete="off" maxlength="60" placeholder="Email Address" title="Email Address" aria-label="Email Address">
</div>
<div class="form-group">
<input required type="text" class="form-control" name="phone" autocomplete="off" maxlength="60" placeholder="Phone" title="Phone" aria-label="Phone">
</div>
<div class="form-group">
<select class="form-control" id="inquiry" name="inquiry" required>
<option value="" disabled selected>Select Inquiry</option>
<option value="I am a shareholder">I am a shareholder</option>
<option value="I am a client of TSX Trust">I am a client of TSX Trust</option>
<option value="I want to learn more about Transfer Agency/Annual General Meeting services">I want to learn more about Transfer Agency/Annual General Meeting services</option>
<option value="I want to learn more about equity plan solutions">I want to learn more about equity plan solutions</option>
</select>
</div>
<div class="form-check pb-3">
<input type="checkbox" name="Optin" required id="Optin" class="form-check-input">
<label class="form-check-label agree" for="agree">I agree to receive electronic communications from TSX Trust Company, in accordance with the TSX Trust Company’s <a href="https://www.tsxtrust.com/privacy-policy" target="_blank">Privacy Policy</a>, including for promotional, marketing and other purposes, and I understand that I can unsubscribe from such communications at any time.</label>
</div>
<div class="form-group form-group-submit">
<button type="submit" class="submit-contact-form modal-submit btn" name="submit">Submit form</button>
</div>
</form>
</div>
</div>
</div>
</div>
