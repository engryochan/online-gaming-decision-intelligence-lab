<style id="wp-custom-css">
.w3eden a {
    color: #BD9A5F;
}
.w3eden .btn-primary {
    color: #ffffff;
    background-color: #BD9A5F;
    border-color: #BD9A5F;
}
.w3eden .btn-primary:hover {
    border-color: #000000;
}



.w3eden .media-body{
    color: #000000;
    font-weight: 700;
}
body.custom-background {
    background-color: #BD9A5F !important;
}


.header-inner .custom-container {
    float: right;
}
.footer-middle-wrap {
	  width:100% !important;
}

.elementor-tab-content {
    color: #000000;
    background-color: #ffffff;
    border: none !important;
}
body .job-listing .job-preview .job-cta .apply-btn {
    background-color: #BD9A5F;
    width: 180px;
	  float:right;
}
.awsm-selectric {
	box-shadow: 0 0 5px rgba(0, 0, 0, 0.3)!important;
	
}
.awsm-job-single-wrap * {
	margin-top: 20px !important;
}
.awsm-job-single-wrap strong {
    display: block;
}
.awsm-selectric .label, .awsm-selectric .label, .awsm-grid-item .awsm-job-item {
	font-family:arial !important;
}


.team-wrapper.team-modern.text-center.team-light.shortcode-rand-4 .team-member {
    margin: 10px; /* Adjust spacing between team members */
}

.team-wrapper.team-modern.text-center.team-light.shortcode-rand-4 .team-member img {
    border-radius: 50%; /* Makes the images circular if desired */
    width: 150px; /* Adjust size as needed */
    height: 150px; /* Adjust size as needed */
    object-fit: cover; /* Ensures the image fits within the given dimensions */
}


/*Events Page*/
.type1 .desc .event_post .event_title a , .time-date-child,.fc-toolbar-title {
   color: #000000;
}
.fc-prev-button, .fc-next-button, .fc-today-button{
	background-color:#000000 !important;
}
.fc-h-event .fc-event-title-container {
    background-color: #BD9A5F !important;
}
.fc-prev-button:hover, .fc-next-button:hover{
	background-color:#BD9A5F !important;
}
.fc .fc-daygrid-event-harness:hover {
	background-color:#BD9A5F !important;
	color:#000000 !important;
}
.fc-button-active{
	background-color:#BD9A5F !important;
	border-color:#BD9A5F !important;
}
.fc-direction-ltr .fc-button-group>.fc-button:not(:last-child) ,.fc-direction-ltr .fc-button-group>.fc-button:not(:first-child) {
	background-color:#000000;
}
.fc-direction-ltr .fc-daygrid-event.fc-event-end {
    color: #000000;
}
.fc-today-button fc-button fc-button-primary{
	background-color: #000000 !important;
}
	
/*DOCUMENTS TABLE*/
.page-item.active .page-link {
  background-color: #BD9A5F !important;
    border-color: #BD9A5F !important;
}
.w3eden .card {
    border: none !important;
}
.menu a {
	color: #ffffff !important;
}
.menu a:hover {
    color: #BD9A5F !important;
}


/*Complaints form*/
.nav-item-inner a.egovenz-popup-trigger.btn {
    vertical-align: inherit;
    background: #BD9A5F;
		color:#ffffff;
}
/*Procurement Listing*/
.jobwp-listing-top {
    display: none;
}

jobwp-listing-body-container .jobwp-item {
    border: 1px solid #BD9A5F !important;
    background-color: #FFF;
}
.awsm-job-item h2.awsm-job-post-title a {
    font-size: 18px;
    color: #000000 !important;
}
.single-post-template article .article-inner> .top-meta {
    display: none;
}
.single-post h1.page-title {
    color: #ffffff !important;
}

.contact-widget-info>p.contact-address>span:before {
    background: url(assets/images/contact/icon-message-1.png);
	display:none;
}
.contact-widget-info>p.contact-phone>span:before {
    background: url(assets/images/contact/icon-call-1.png);
	display:none;
}
.contact-widget-info>p.contact-email>span:before {
    background: url(assets/images/contact/icon-mail-1.png);
	display:none;
}

/*wpdatatables*/
#table_1_paginate, .dataTables_paginate,   .paging_full_numbers{
	display: block !important;
}
.dataTables_paginate .paginate_button::before {
  color: inherit !important;
}

/*TEAM*/
.team-designation{
	height:60px !important;
}
.team-name{
	height:65px !important;
}

.page-title-inner .page-title {
	background-image:none !important;
}

/*FORM BUTTONS*/
.cf7mls_next.action-button {
    background-color: #BD9A5F;
}


/*The Events Calendar - Single Event*/
.elementor-26420 
.elementor-element.elementor-element-62cca8ce {
    display: none !important;
}
.e-con.e-flex>.e-con-inner {
    display: none;
}



/*Complaints Button*/
.header-logobar-text-1 h5{
	color:#FFFFFF !important;
}
a.btn-primary h5{
	color:#FFFFFF !important;
}

/*Job Listing Search*/
