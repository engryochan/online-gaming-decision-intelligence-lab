</div>    <script type="text/javascript">
        jQuery(document).ready(function($) {
            // Define the table ID
            var tableId = 'tablepress-28';

            // Loop through each row in the table
            $('#' + tableId + ' tbody tr').each(function() {
                var closingDateCell = $(this).find('td.column-4').text().trim();
                //"dd MMMM yyyy"
                var closingDate = new Date(closingDateCell);

                // Get the current date
                var currentDate = new Date();

                // Compare the dates
                if (closingDate < currentDate) {
                    $(this).hide();
                }
            });
        });
    </script>
        <!-- The Modal -->
    <div id="entityAgentsModal" class="modal" style="display: none; position: fixed; z-index: 10000; left: 0; top: 0; width: 100%; height: 100%; overflow: auto; background-color: rgba(0,0,0,0.4);">
        <div class="modal-content" style="background-color: #fefefe; margin: 5% auto; padding: 20px; border: 1px solid #888; width: 90%; max-width: 1200px; border-radius: 5px;">
            <span class="close-modal" style="color: #aaa; float: right; font-size: 28px; font-weight: bold; cursor: pointer;">&times;</span>
            <h2 style="color: #bd9a5f;">Active Personnel for: <span id="modalCompanyLicense"></span></h2>
            
            <!-- Tab Navigation -->
            <div class="modal-tabs" style="margin: 20px 0; border-bottom: 2px solid #ddd;">
                <button class="tab-button active" data-tab="agents">Agents</button>
                <button class="tab-button" data-tab="brokers">Brokers</button>
            </div>
            
            <!-- Tab Content -->
            <div id="agentsTab" class="tab-content active">
                <!-- Search Input for Agents -->
                <div style="margin: 20px 0;">
                    <input type="text" id="agentSearch" placeholder="Search agents..." style="width: 100%; padding: 10px; font-size: 16px;">
                </div>
                
                <!-- Agents Table -->
                <div style="max-height: 500px; overflow-y: auto;">
                    <table id="agentsTable" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #bd9a5f;">
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">Agent Name</th>
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">License Number</th>
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">Registration Date</th>
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">Contact</th>
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">Status</th>
                            </tr>
                        </thead>
                        <tbody id="agentsTableBody">
                            <!-- Agents will be loaded here -->
                        </tbody>
                    </table>
                </div>
                
                <div id="noAgentsMessage" class="no-data-message" style="display: none; text-align: center; padding: 40px; color: #666;">
                    No active agents found for this entity.
                </div>
            </div>
            
            <div id="brokersTab" class="tab-content" style="display: none;">
                <!-- Search Input for Brokers -->
                <div style="margin: 20px 0;">
                    <input type="text" id="brokerSearch" placeholder="Search brokers..." style="width: 100%; padding: 10px; font-size: 16px;">
                </div>
                
                <!-- Brokers Table -->
                <div style="max-height: 500px; overflow-y: auto;">
                    <table id="brokersTable" style="width: 100%; border-collapse: collapse;">
                        <thead>
                            <tr style="background-color: #bd9a5f;">
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">Broker Name</th>
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">License Number</th>
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">Registration Date</th>
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">Contact</th>
                                <th style="padding: 12px; text-align: left; border-bottom: 2px solid #ffffff;color: #ffffff;">Status</th>
                            </tr>
                        </thead>
                        <tbody id="brokersTableBody">
                            <!-- Brokers will be loaded here -->
                        </tbody>
                    </table>
                </div>
                
                <div id="noBrokersMessage" class="no-data-message" style="display: none; text-align: center; padding: 40px; color: #666;">
                    No active brokers found for this entity.
                </div>
            </div>
            
            <div id="loadingMessage" style="text-align: center; padding: 40px;">
                Loading data...
            </div>
        </div>
    </div>

    <style>
        .modal-content {
            animation: fadeIn 0.3s;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-50px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Tab Styles */
        .modal-tabs {
            display: flex;
            gap: 5px;
        }
        
        .tab-button {
            padding: 12px 24px;
            background: #f5f5f5;
            border: 1px solid #ddd;
            border-bottom: none;
            cursor: pointer;
            font-size: 16px;
            font-weight: 500;
            color: #666;
            border-radius: 5px 5px 0 0;
            transition: all 0.3s ease;
        }
        
        .tab-button:hover {
            background: #e9e9e9;
        }
        
        .tab-button.active {
            background: #bd9a5f;
            color: white;
            border-color: #bd9a5f;
        }
        
        .tab-content {
            display: none;
        }
        
        .tab-content.active {
            display: block;
        }
        
        /* Table Styles */
        #agentsTable, #brokersTable {
            margin-top: 20px;
        }
        
        #agentsTable tbody tr, #brokersTable tbody tr {
            border-bottom: 1px solid #eee;
        }
        
        #agentsTable tbody tr:hover, #brokersTable tbody tr:hover {
            background-color: #f9f9f9;
        }
        
        #agentsTable td, #brokersTable td {
            padding: 10px 12px;
        }
        
        .status-active {
            color: green;
            font-weight: bold;
        }
        
        .status-inactive {
            color: #999;
        }
    </style>

    <script>
    jQuery(document).ready(function($) {
        var allAgentsData = [];
        var allBrokersData = [];
        var currentCompanyLicense = '';
        
        // Tab switching functionality
        $('.tab-button').click(function() {
            var tabId = $(this).data('tab');
            
            // Update active tab button
            $('.tab-button').removeClass('active');
            $(this).addClass('active');
            
            // Show active tab content
            $('.tab-content').removeClass('active').hide();
            $('#' + tabId + 'Tab').addClass('active').show();
            
            // Load data for the tab if needed
            if (tabId === 'agents') {
                displayAgentsForLicense(currentCompanyLicense);
            } else if (tabId === 'brokers') {
                displayBrokersForLicense(currentCompanyLicense);
            }
        });
        
        // Load both datasets
        function loadAllData() {
            $('#loadingMessage').show();
            
            // Load agents data
            $.ajax({
                url: 'https://www.namfisa.com.na/wp-content/uploads/all_agents.json',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    if (Array.isArray(data)) {
                        allAgentsData = data;
                    } else {
                        allAgentsData = [];
                        console.error('Agents data is not an array');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error loading agents data:', error);
                    allAgentsData = [];
                }
            });
            
            // Load brokers data
            $.ajax({
                url: 'https://www.namfisa.com.na/wp-content/uploads/all_brokers.json',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    if (Array.isArray(data)) {
                        allBrokersData = data;
                    } else {
                        allBrokersData = [];
                        console.error('Brokers data is not an array');
                    }
                    $('#loadingMessage').hide();
                },
                error: function(xhr, status, error) {
                    console.error('Error loading brokers data:', error);
                    allBrokersData = [];
                    $('#loadingMessage').hide();
                }
            });
        }
        
        // Load data on page load
        loadAllData();
        
        // Open modal when entity name is clicked
        $(document).on('click', '.open-entity-modal', function(e) {
            e.preventDefault();
            currentCompanyLicense = $(this).data('company-license');
            openModalWithData(currentCompanyLicense);
        });
        
        // Close modal
        $('.close-modal').click(function() {
            $('#entityAgentsModal').hide();
        });
        
        // Close modal when clicking outside
        $(window).click(function(e) {
            if (e.target.id === 'entityAgentsModal') {
                $('#entityAgentsModal').hide();
            }
        });
        
        // Search functionality for agents
        $('#agentSearch').on('keyup', function() {
            var searchText = $(this).val().toLowerCase();
            filterTable('agentsTableBody', searchText);
        });
        
        // Search functionality for brokers
        $('#brokerSearch').on('keyup', function() {
            var searchText = $(this).val().toLowerCase();
            filterTable('brokersTableBody', searchText);
        });
        
        function openModalWithData(companyLicense) {
            $('#modalCompanyLicense').text(companyLicense);
            $('#loadingMessage').show();
            
            // Clear previous data
            $('#agentsTableBody').empty();
            $('#brokersTableBody').empty();
            $('.no-data-message').hide();
            
            // Reset search inputs
            $('#agentSearch').val('');
            $('#brokerSearch').val('');
            
            // Show modal
            $('#entityAgentsModal').show();
            
            // Show loading message
            $('#loadingMessage').show();
            
            // Wait a moment for data to load, then display
            setTimeout(function() {
                // Display agents for the current tab
                if ($('#agentsTab').hasClass('active')) {
                    displayAgentsForLicense(companyLicense);
                } else {
                    displayBrokersForLicense(companyLicense);
                }
                $('#loadingMessage').hide();
            }, 300);
        }
        
        function displayAgentsForLicense(companyLicense) {
            var tableBody = $('#agentsTableBody');
            tableBody.empty();
            $('#noAgentsMessage').hide();
            
            // Filter agents by company license and active status
            var filteredAgents = allAgentsData.filter(function(agent) {
                return agent.company_license === companyLicense && 
                       agent.agent_status && 
                       agent.agent_status.toLowerCase() === 'active';
            });
            
            if (filteredAgents.length === 0) {
                $('#noAgentsMessage').show();
                return;
            }
            
            filteredAgents.forEach(function(agent) {
                var row = $('<tr>');
                
                // Agent Name
                var agentName = agent.agent_name || 'N/A';
                row.append($('<td>').text(agentName));
                
                // License Number
                var licenseNumber = agent.license_number || 'N/A';
                row.append($('<td>').text(licenseNumber));
                
                // Registration Date
                var regDate = agent.registration_date || 'N/A';
                row.append($('<td>').text(regDate));
                
                // Contact Info
                var contactInfo = '';
                if (agent.cellphone) contactInfo += 'Tel: ' + agent.cellphone;
                if (agent.email_address) {
                    if (contactInfo) contactInfo += '<br>';
                    contactInfo += 'Email: ' + agent.email_address;
                }
                if (!contactInfo) contactInfo = 'N/A';
                row.append($('<td>').html(contactInfo));
                
                // Status
                var statusClass = agent.agent_status && agent.agent_status.toLowerCase() === 'active' ? 
                    'status-active' : 'status-inactive';
                row.append($('<td>').addClass(statusClass).text(agent.agent_status || 'N/A'));
                
                tableBody.append(row);
            });
        }
        
        function displayBrokersForLicense(companyLicense) {
            var tableBody = $('#brokersTableBody');
            tableBody.empty();
            $('#noBrokersMessage').hide();
            
            // Filter brokers by company license and active status
            var filteredBrokers = allBrokersData.filter(function(broker) {
                return broker.company_license === companyLicense && 
                       broker.agent_status && 
                       broker.agent_status.toLowerCase() === 'active';
            });
            
            if (filteredBrokers.length === 0) {
                $('#noBrokersMessage').show();
                return;
            }
            
            filteredBrokers.forEach(function(broker) {
                var row = $('<tr>');
                
                // Broker Name
                var brokerName = broker.broker_name || broker.agent_name || 'N/A';
                row.append($('<td>').text(brokerName));
                
                // License Number
                var licenseNumber = broker.license_number || 'N/A';
                row.append($('<td>').text(licenseNumber));
                
                // Registration Date
                var regDate = broker.registration_date || 'N/A';
                row.append($('<td>').text(regDate));
                
                // Contact Info
                var contactInfo = '';
                if (broker.cellphone) contactInfo += 'Tel: ' + broker.cellphone;
                if (broker.email_address) {
                    if (contactInfo) contactInfo += '<br>';
                    contactInfo += 'Email: ' + broker.email_address;
                }
                if (!contactInfo) contactInfo = 'N/A';
                row.append($('<td>').html(contactInfo));
                
                // Status - Try different possible field names
                var brokerStatus = broker.agent_status || 'N/A';
                var statusClass = brokerStatus.toLowerCase() === 'active' ? 
                    'status-active' : 'status-inactive';
                row.append($('<td>').addClass(statusClass).text(brokerStatus));
                
                tableBody.append(row);
            });
        }
        
        function filterTable(tableBodyId, searchText) {
            $('#' + tableBodyId + ' tr').each(function() {
                var rowText = $(this).text().toLowerCase();
                if (rowText.indexOf(searchText) > -1) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        }
        
        // Handle clicks on dynamically loaded table rows
        $(document).ajaxComplete(function() {
            $('.open-entity-modal').off('click').on('click', function(e) {
                e.preventDefault();
                currentCompanyLicense = $(this).data('company-license');
                openModalWithData(currentCompanyLicense);
            });
        });
    });
    </script>
    <script> /* <![CDATA[ */var tribe_l10n_datatables = {"aria":{"sort_ascending":": activate to sort column ascending","sort_descending":": activate to sort column descending"},"length_menu":"Show _MENU_ entries","empty_table":"No data available in table","info":"Showing _START_ to _END_ of _TOTAL_ entries","info_empty":"Showing 0 to 0 of 0 entries","info_filtered":"(filtered from _MAX_ total entries)","zero_records":"No matching records found","search":"Search:","all_selected_text":"All items on this page were selected. ","select_all_link":"Select all pages","clear_selection":"Clear Selection.","pagination":{"all":"All","next":"Next","previous":"Previous"},"select":{"rows":{"0":"","_":": Selected %d rows","1":": Selected 1 row"}},"datepicker":{"dayNames":["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],"dayNamesShort":["Sun","Mon","Tue","Wed","Thu","Fri","Sat"],"dayNamesMin":["S","M","T","W","T","F","S"],"monthNames":["January","February","March","April","May","June","July","August","September","October","November","December"],"monthNamesShort":["January","February","March","April","May","June","July","August","September","October","November","December"],"monthNamesMin":["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"],"nextText":"Next","prevText":"Prev","currentText":"Today","closeText":"Done","today":"Today","clear":"Clear"}};/* ]]> */ </script>			<script>
				( () => {
					const lazyloadRunObserver = () => {
						const lazyloadBackgrounds = document.querySelectorAll( `.e-con.e-parent:not(.e-lazyloaded)` );
						const lazyloadBackgroundObserver = new IntersectionObserver( ( entries ) => {
							entries.forEach( ( entry ) => {
								if ( entry.isIntersecting ) {
									let lazyloadBackground = entry.target;
									if( lazyloadBackground ) {
										lazyloadBackground.classList.add( 'e-lazyloaded' );
									}
									lazyloadBackgroundObserver.unobserve( entry.target );
								}
							});
						}, { rootMargin: '200px 0px 200px 0px' } );
						lazyloadBackgrounds.forEach( ( lazyloadBackground ) => {
							lazyloadBackgroundObserver.observe( lazyloadBackground );
						} );
					};
					const events = [
						'DOMContentLoaded',
						'elementor/lazyload/observe',
					];
					events.forEach( ( event ) => {
						document.addEventListener( event, lazyloadRunObserver );
					} );
				} )();
			</script>
			
