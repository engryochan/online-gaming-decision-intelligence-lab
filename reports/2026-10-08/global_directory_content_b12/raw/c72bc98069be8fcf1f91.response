#wp-chatbot-editor-container{display:grid!important;grid-template-columns:minmax(0,1fr) auto auto auto;align-items:center;column-gap:4px;row-gap:6px;height:auto!important;max-height:none!important;min-height:48px!important;overflow:visible!important;padding:6px 6px 6px 14px!important;box-sizing:border-box}
#wp-chatbot-editor-container>label{display:none!important}
#wp-chatbot-editor-container>.wpbot-ai-file-preview{grid-column:1/-1!important;width:100%!important}
#wp-chatbot-editor-container>input#wp-chatbot-editor{display:block!important;width:100%!important;min-width:0!important;height:40px!important}
#wp-chatbot-editor-container>#wpbot-ai-file-upload,#wp-chatbot-editor-container>#wp-chatbot-send-message{position:relative!important;top:auto!important;right:auto!important;left:auto!important;width:36px!important;height:36px!important;margin:0!important;box-shadow:none!important}
#wp-chatbot-editor-container>.wpbot-ai-file-preview .wpbot-ai-file-remove{position:relative!important;width:auto!important;height:auto!important;background:transparent!important;color:#8a8a92!important;box-shadow:none!important}
.wp-chatbot-footer{overflow:visible!important;height:auto!important;max-height:none!important}
@media screen and (max-width:768px){
.wp-chatbot-footer{margin-top:0!important;padding-top:8px!important}
.wp-chatbot-content{padding-bottom:20px!important}
.qcld-horizontal-scroll{padding-top:10px;margin-top:4px}
ul.wp-chatbot-messages-container>li:last-child{margin-bottom:16px}
}
.wp-chatbot-header-style04{display:flex!important;align-items:center!important;height:56px!important;padding:8px 10px!important;box-sizing:border-box}
.wp-chatbot-header-style040-center-icon{display:flex!important;align-items:center;gap:8px;margin:0!important}
.wp-chatbot-header-style04 .qcld_back_to_start_menu,.wp-chatbot-header-style04 #wp-chatbot-email-transcript,.wp-chatbot-header-style04 #wp-chatbot-desktop-reload,.wp-chatbot-header-style04 #wp-chatbot-desktop-close,.wp-chatbot-header-style04 span{position:relative!important;top:auto!important;left:auto!important;right:auto!important;transform:none!important;width:36px!important;height:36px!important;margin:0!important;padding:0!important;display:inline-flex!important;align-items:center;justify-content:center;background:#f2f2f2!important;border-radius:50%!important;color:#000!important;line-height:1!important;box-sizing:border-box}
li.wp-chatbot-msg.wp-chatbot-msg-flat .wp-chatbot-paragraph{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
