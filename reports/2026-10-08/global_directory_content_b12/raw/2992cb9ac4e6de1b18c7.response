    Object.defineProperty(String.prototype, 'unEscapeNordicChars', {
        value: function () {
            return this.replace(/&#229;/g, 'å').replace(/&#197;/g, 'Å')
                .replace(/&#xE5;/g, 'å').replace(/&#XE5;/g, 'Å')
                .replace(/&#228;/g, 'ä').replace(/&#196;/g, 'Ä')
