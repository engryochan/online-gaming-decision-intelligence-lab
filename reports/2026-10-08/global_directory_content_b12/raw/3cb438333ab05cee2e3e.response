nyse.com/cms/41.10.17/chunks/shared/breadcrumb-context/BreadCrumbContext-Ciq78Fk2.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/shared/utils/isCmsTemplateName-CHdGwdya.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/shared/utils/isCmsTemplateName-CHdGwdya.js"}},{"id":"__cms__site-favicon","type":"link","props":{"rel":"shortcut icon","href":"/publicdocs/images/favicon_nyse_2022.gif","type":"image/gif"}}],"scriptTags":[],"template":{"id":"0242eac7-2cab-4315-bc2c-3006287df3b3","name":"cms-template-nyse-page","props":{"slots":{"body":[{"id":"fe28b204-1ded-4504-8123-f8a8a13bae41","name":"cms-component-layout-nyse-page-2022","props":{"slots":{"hero":[{"id":"6fff618f-c107-4da8-adbf-aa9d89c125c3","name":"cms-component-hero","props":{"slots":{"contentA":[{"id":"aeec829f-6307-4fc8-a135-99de759b5c63","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h1","children":[{"text":"Get Started","textColor":"#ffffff"}]}]}},{"id":"0fdcb1dd-e921-4f6c-9680-0018cc8cf5a2","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"ac4ced3c-e56e-438d-89f2-9c4262a13973","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{"text":"When you’re ready to make the big move and share your vision with the world, we’ve got you covered. As the premiere partner for today’s corporate leaders, we make it our mission to provide everything you need to easily take your business public and maintain a healthy, publicly traded company - and that starts with the application process.","textColor":"#ffffff"}]},{"type":"paragraph","children":[{}]}]}}],"contentB":[{"id":"73b56de3-ba27-4d0e-ae14-de17a6ca1124","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h3","children":[{"text":"Become part of the world's leading network"}]}]}]}},{"id":"b0a6b658-5964-4e30-8c6f-da175f871f4d","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"fac56489-1ac5-4ee5-935c-1e0d339dc311","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"paragraph","children":[{},{"href":"#contact","icon":"MoveRightIcon","type":"link","wide":true,"children":[{"text":"Contact Us"}],"isButton":true},{}]}]}]}}]},"box1bg":"black","box2bg":"gray","variant":"multi-box","box1Text":"white","imageAlt":"NYSE Listings Podium","imageSrc":"/publicdocs/images/Hero-NYSE-1920x550-18.jpg","alignBoxes":"alignBoxBottoms"}}],"main":[{"id":"87162ace-023f-4a4d-8828-c34e2cb4b06c","name":"cms-component-spacer","props":{"slots":{},"size":"xl"}},{"id":"9e4dbd63-5ecb-4a6d-ae50-e3e99f049e14","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{"text":"The four-step process for submitting an application to list at NYSE is outlined below. Once you complete and submit your application, a member of our NYSE listings team will review your information and get back to you within 14 business days. After your application is accepted, we’ll assign a dedicated listings specialist to your company who will help you walk through each step of the process to going public."}]}]}},{"id":"3b10dfdb-0560-496a-b2d4-1906fa6fed5e","name":"cms-component-spacer","props":{"slots":{},"size":"sm"}},{"id":"02c68d17-b600-4e0e-aa7b-dc706f63158d","name":"cms-component-tabs-2022","props":{"slots":{"15874408-3f4d-43c3-babf-4e500d144ab9":[{"id":"2a2d78ac-4552-465c-ba24-6b9cb04d8195","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"1abfc3b1-9ad2-437c-a756-da3fe5e36171","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h3","children":[{"text":"Select Your Designated Market Maker (DMM)"}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Your DMM will facilitate price discovery for your stock during market opens, closes and during periods of substantial trading imbalances or instability. Once you contact our listings team about a DMM, we’ll send you a list of all eligible DMMs and their contact information."}]},{"type":"paragraph","children":[{},{"href":"#contact","icon":"MoveRightIcon","type":"link","children":[{"text":"Contact Us"}]},{}]}]}}],"16262370-de09-42b8-a472-0b4244588236":[{"id":"c68d8b6f-101b-4495-95d3-bc76f6abd851","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"bbd858c6-bd5a-4dd0-83bd-7b9b6f3798a4","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h4","children":[{"text":"Submit Your Application"}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"If this is your first time listing securities on NYSE, NYSE American or NYSE Arca, please contact us to get additional information about the process. We'll answer any questions you have, provide a confidential review of eligibility and help you identify the appropriate forms to file."}]},{"type":"paragraph","children":[{},{"href":"/regulation/initial-listings","icon":"MoveRightIcon","type":"link","children":[{"text":"Learn more about the Initial Listing proces"}]},{}]}]}}],"4220ab15-4739-4f35-be8a-d957be8a92f9":[{"id":"b175f210-ac70-440d-b6a2-17803ee62d2d","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"5e8b869a-6974-4471-bd79-b2c3bfcca14f","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h4","children":[{"text":"Choose Your Market"}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"We offer several different markets designed to meet the needs of companies of all sizes with all different issue types (stocks, bonds, ETPs, etc)."}]},{"type":"paragraph","children":[{"text":"NYSE – the world’s listing venue for mid- and large-cap companies across all verticals"}]},{"type":"paragraph","children":[{"text":"NYSE American – the leading global marketplace for small-cap companies"}]},{"type":"paragraph","children":[{"text":"NYSE Arca – a highly liquid, fully electronic marketplace for ETPs"}]},{"type":"paragraph","children":[{},{"href":"/regulation#issuer-regulation","icon":"MoveRightIcon","type":"link","children":[{"text":"View company resources"}]},{}]}]}}],"b690d772-3271-4d2d-ae8f-4d0ec4c16b21":[{"id":"984ce4a5-8542-4bf9-afda-90b4e52d756b","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"311ad9c1-5d79-4a90-86be-b5e3c2d736e4","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h4","children":[{"text":"Reserve Your Ticker Symbol"}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Choosing your ticker symbol is an initial step in the life of a public company. An issuer's symbol is unique and can reinforce branding initiatives."}]},{"type":"paragraph","children":[{"text":"NYSE, NYSE American and NYSE Arca use up to four-character symbols. The SEC's uniform system for the selection and reservation of securities trading symbols gives issuers on all participant exchanges the right to retain their symbols should they transfer to a new exchange."}]},{"type":"paragraph","children":[{},{"href":"/form/ticker","icon":"MoveRightIcon","type":"link","children":[{"text":"Reserve your symbol"}]},{}]}]}}]},"tabs":[{"id":"4220ab15-4739-4f35-be8a-d957be8a92f9","title":"Step 1"},{"id":"b690d772-3271-4d2d-ae8f-4d0ec4c16b21","title":"Step 2"},{"id":"16262370-de09-42b8-a472-0b4244588236","title":"Step 3"},{"id":"15874408-3f4d-43c3-babf-4e500d144ab9","title":"Step 4"}]}},{"id":"7baa6861-75af-4ef7-b86a-ee36a82c7b3e","name":"cms-component-spacer","props":{"slots":{},"size":"lg"}},{"id":"019088fa-c37e-46f5-9826-c296d95e377a","name":"cms-component-modal","props":{"slots":{"content":[{"id":"102596ed-66a8-4c18-82af-9a0fb74e600d","name":"cms-component-form-snow","props":{"slots