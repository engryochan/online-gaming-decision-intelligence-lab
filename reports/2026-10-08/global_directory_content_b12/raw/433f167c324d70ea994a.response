						</label>
						<label>
							<span>Datum från</span>
							<input id="from" name="from" type="date" placeholder="yyyy-mm-dd" title="yyyy-mm-dd" pattern="(19|20)\d{2}-(1[012]|0\d)-(3[01]|[012]\d)" />
						</label>
						<label>
							<span>Datum till</span>
							<input id="to" name="to" type="date" placeholder="yyyy-mm-dd" title="yyyy-mm-dd" pattern="(19|20)\d{2}-(1[012]|0\d)-(3[01]|[012]\d)" />
						</label>
						<button type="submit">Sök</button>
					</form>
				</div>

			</div>

