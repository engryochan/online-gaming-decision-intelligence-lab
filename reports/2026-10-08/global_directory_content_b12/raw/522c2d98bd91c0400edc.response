<script>
	jQuery(".leadership .person").click(function(){
		var index = jQuery(this).index(".person");
		elementorProFrontend.modules.popup.showPopup( { id: 4293 } );
		jQuery('#leadershipPopup .e-con-inner').append('<div id="swiper" class="swiper"><div class="swiper-wrapper"></div><div class="swiper-button-prev"></div><div class="swiper-button-next"></div><div class="swiper-scrollbar"></div></div>');
  	jQuery(".leadership .person").each(function() {
			var img = jQuery( this ).find(".elementor-testimonial-image:first").html();
			var name = jQuery( this ).find(".elementor-testimonial-name:first").html();
			var job = jQuery( this ).find(".elementor-testimonial-job:first").html();
			var content = jQuery( this ).find(".elementor-testimonial-content:first").html();
			var sliderItem = '<div class="swiper-slide"><div class="person-info"><h3 class="elementor-heading-title elementor-size-default name">' + name + '</h3><h4 class="elementor-heading-title elementor-size-default job">' + job + '</h4></div><div class="person-image">' + img + '</div><div class="person-content">' + content + '</div></div>';
			jQuery('#swiper .swiper-wrapper').append(sliderItem);
		});
		var swiperElement = document.getElementById('swiper');
		var scrollbar = {
			'el' : '.swiper-scrollbar',
			'enabled' : true,
			'hide' : false
		};
		var navigation = {
	    nextEl: '.swiper-button-next',
    	prevEl: '.swiper-button-prev'
  	};
		var swiperConfig = {
			'slidesPerView': 'auto',
			'spaceBetween': 0,
			'scrollbar': scrollbar,
			'pagination': false,
			'navigation': navigation,
			on: {
				afterInit: function (swiper) {
					swiper.slideTo(index,1,true);
					jQuery('#swiper').css('opacity',1);
				},
				slideChangeTransitionEnd: function () {
					jQuery('.elementor-popup-modal .dialog-widget-content').animate({ scrollTop: 0 }, 'fast');
				}
		  }
		};
		
		if ( 'undefined' === typeof Swiper ) {
			const asyncSwiper = elementorFrontend.utils.swiper;
			new asyncSwiper( swiperElement, swiperConfig ).then( ( newSwiperInstance ) => {
				mySwiper = newSwiperInstance;
			});
		} else {
			mySwiper = new Swiper( swiperElement, swiperConfig );
		}
	});
</script>
	</body>
</html>
