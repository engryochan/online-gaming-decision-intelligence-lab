    <!-- Jump-to-page control for Joomla core pagination -->
    <script type="text/javascript">
    (function () {
        'use strict';

        document.addEventListener('DOMContentLoaded', function () {
            var counterRegex = /Page\s+(\d+)\s+of\s+(\d+)/i;

            // 1. Find the pagination links first (a[href*="start="]) — these are
            //    reliably present and specific to the actual article listing's
            //    pagination, unlike a page-wide text search which can pick up an
            //    unrelated module's "Page X of Y" counter (e.g. a sidebar news
            //    widget) if that one happens to have simpler markup.
            var pageLinks = document.querySelectorAll('a[href*="start="]');

            if (!pageLinks.length) {
                console.log('[jump-to-page] No pagination links (start=) found on this page.');
                return;
            }

            var lastLink = pageLinks[pageLinks.length - 1];
            var paginationRoot = lastLink.closest('ul, nav, .pagination') || lastLink.parentElement;
            // Search for the counter within the pagination's own wrapping
            // container first (it's very often a sibling of the link list),
            // and only fall back to the whole page if nothing turns up there.
            var searchRoot = (paginationRoot && paginationRoot.parentElement) || document.body;

            function findCounter(root) {
                var candidates = root.querySelectorAll('*');
                var found = [];
                for (var i = 0; i < candidates.length; i++) {
                    var el = candidates[i];
                    var text = el.textContent.replace(/\s+/g, ' ').trim();
                    var m = text.match(counterRegex);
                    if (m) {
                        found.push({ el: el, m: m, depth: el.querySelectorAll('*').length });
                    }
                }
                if (!found.length) return null;
                found.sort(function (a, b) { return a.depth - b.depth; });
                return found[0];
            }

            var result = findCounter(searchRoot) || findCounter(document.body);

            if (!result) {
                console.log('[jump-to-page] No "Page X of Y" counter found near the pagination links.');
                return;
            }

            var counterEl = result.el;
            var match = result.m;

            var currentPage = parseInt(match[1], 10);
            var totalPages = parseInt(match[2], 10);

            if (!totalPages || totalPages < 2) {
                return; // Only one page, no need for a jump control.
            }

            // 2. Work out the per-page "limit" from the existing pagination
            //    links' start= values, so we can compute start for any page.
            var starts = [];
            var hrefTemplate = null;

            pageLinks.forEach(function (a) {
                var url = new URL(a.href, window.location.href);
                var startVal = url.searchParams.get('start');
                if (startVal !== null && /^\d+$/.test(startVal)) {
                    starts.push(parseInt(startVal, 10));
                    if (!hrefTemplate) {
                        hrefTemplate = url;
                    }
                }
            });

            starts = starts.filter(function (v, idx) {
                return starts.indexOf(v) === idx;
            }).sort(function (a, b) { return a - b; });

            var limit = null;
            for (var j = 1; j < starts.length; j++) {
                var diff = starts[j] - starts[j - 1];
                if (diff > 0) {
                    limit = diff;
                    break;
                }
            }

            if (!limit) {
                var curUrl = new URL(window.location.href);
                var curStart = parseInt(curUrl.searchParams.get('start') || '0', 10);
                if (currentPage > 1 && curStart > 0) {
                    limit = Math.round(curStart / (currentPage - 1));
                }
            }

            if (!limit) {
                console.log('[jump-to-page] Counter found but could not determine page size.', { currentPage: currentPage, totalPages: totalPages, starts: starts });
                return; // Couldn't work out the page size reliably; bail out safely.
            }

            // 3. Find a guaranteed-visible place to attach the control. The
            //     "Page X of Y" counter element itself may be CSS-hidden on
            //     some templates (present in the DOM, not on screen), so we
            //     anchor to the actual pagination link list instead, which we
            //     know is visible since the user can click it. We insert
            //     *after the pagination's outer wrapper*, not right next to
            //     the <ul> itself, since the <ul> commonly lives inside a
            //     flex row (e.g. a "pagination-wrap d-flex justify-content-
            //     between" container) — inserting a sibling there just makes
            //     our control another flex item sitting beside it instead of
            //     dropping to a new line below.
            var anchorEl = (paginationRoot && paginationRoot.parentElement) || paginationRoot || counterEl;

            // 3. Build the "Go to page" control.
            var wrap = document.createElement('div');
            wrap.className = 'jump-to-page-control';

            var label = document.createElement('label');
            label.textContent = 'Go to page';
            label.setAttribute('for', 'jump-to-page-input');

            var input = document.createElement('input');
            input.type = 'number';
            input.id = 'jump-to-page-input';
            input.min = '1';
            input.max = String(totalPages);
            input.value = String(currentPage);
            input.setAttribute('aria-label', 'Page number, 1 to ' + totalPages);
            // Hint to password managers / form-fill extensions (Keeper, LastPass,
            // 1Password, etc.) that this is not a credential field they should
            // attach autofill behavior to.
            input.setAttribute('autocomplete', 'off');
            input.setAttribute('data-lpignore', 'true');
            input.setAttribute('data-form-type', 'other');

            var hint = document.createElement('span');
            hint.className = 'jump-to-page-hint';
            hint.textContent = 'of ' + totalPages;

            var button = document.createElement('button');
            button.type = 'button';
            button.textContent = 'Go';

            function goToPage() {
                var target = parseInt(input.value, 10);
                if (!target || target < 1) target = 1;
                if (target > totalPages) target = totalPages;

                var url = hrefTemplate
                    ? new URL(hrefTemplate.href)
                    : new URL(window.location.href);

                var newStart = (target - 1) * limit;
                url.searchParams.set('start', String(newStart));
                window.location.href = url.toString();
            }

            button.addEventListener('click', goToPage);
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    goToPage();
                }
            });

            wrap.appendChild(label);
            wrap.appendChild(input);
            wrap.appendChild(hint);
            wrap.appendChild(button);

            // Insert as a full sibling below the pagination wrapper, not
            // inside its flex row, so it always renders on its own line.
            anchorEl.insertAdjacentElement('afterend', wrap);
        });
    })();
    </script>
    </body>
</html>

<script type="text/javascript">
    (function($) {
        $(document).ready(function() {
            
             $(".btn-floating.btn-large").on("click", function () {
              const container = $(this).closest(".fixed-action-btn");
              container.toggleClass("active");
              const isActive = container.hasClass("active");
        
              const customDetails = container.find("ul.custom_details");
              if (isActive) {
                customDetails.show();
              } else {
                customDetails.hide();
              }
            });

            var tabIdFromUrl = window.location.hash;

            if (tabIdFromUrl && tabIdFromUrl.startsWith("#tab-")) {
                $('a.nav-link[href="' + tabIdFromUrl + '"]').addClass('active');
                $('.tab-pane').removeClass('active show');
                $(tabIdFromUrl).addClass('active show');
            } else {
                $('a.nav-link:first').addClass('active');
                $('.tab-pane:first').addClass('active show');
            }

            $('a.nav-link').click(function(e) {
                e.preventDefault();
                var tabHref = $(this).attr('href');

                // Manually update the hash without scrolling
                history.replaceState(null, null, tabHref);

                $('a.nav-link').removeClass('active');
                $('.tab-pane').removeClass('active show');
                $(this).addClass('active');
                $(tabHref).addClass('active show');
            });

            $('.card-header').on('click', function () {
				const $currentCollapseDiv = $(this).next();
				if ($currentCollapseDiv.hasClass('collapsed')) {
					$currentCollapseDiv.removeClass('collapsed');
					$currentCollapseDiv.addClass('collapse');
				} 
				else if (!$currentCollapseDiv.hasClass('collapsed')) {
					$('.card .collapsed').removeClass('collapsed').addClass('collapse');
					$currentCollapseDiv.removeClass('collapse').addClass('collapsed');
				}
			});
        });
    })(jQuery);
</script>
<style>
.badge-warning {
  display:none !important;
}</style>

<style>
/* Jump-to-page control */
.jump-to-page-control {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.jump-to-page-control label {
    margin: 0;
    font-size: 0.9rem;
    color: #6c757d;
    font-weight: 500;
}

.jump-to-page-control input[type="number"] {
    width: 4.5em;
    padding: 6px 10px;
    border: 1px solid #d7dbe0;
    border-radius: 6px;
    text-align: center;
    font-size: 0.9rem;
    line-height: 1.4;
    -moz-appearance: textfield;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
}

.jump-to-page-control input[type="number"]:focus {
    outline: none;
    border-color: #5b8def;
    box-shadow: 0 0 0 3px rgba(91, 141, 239, 0.15);
}

.jump-to-page-control input[type="number"]::-webkit-outer-spin-button,
.jump-to-page-control input[type="number"]::-webkit-inner-spin-button {
    opacity: 0.5;
}

.jump-to-page-control .jump-to-page-hint {
    font-size: 0.85rem;
    color: #9aa0a6;
}

.jump-to-page-control button {
    padding: 6px 18px;
    border: none;
    border-radius: 6px;
    background: var(--sp-primary-color, #2a5cdd);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s ease, transform 0.1s ease;
}

.jump-to-page-control button:hover {
    background: #1f47b3;
}

.jump-to-page-control button:active {
    transform: scale(0.97);
}

@media (max-width: 480px) {
    .jump-to-page-control {
        justify-content: flex-start;
    }
}
</style>
