-Application-Form-2022.pdf",blocks:[]},{id:188029,type:n,desc:h,button:o,title:"Tin Clearing House Membership Application Form 2022",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{src:c,width:d,height:e,alt:f,caption:a,video:a,desktop:{src:c,width:d,height:e,alt:f,caption:a,video:a}},icon_button_default:{desktop:[]},single_file:"https:\u002F\u002Fwww.icdx.co.id\u002Fcms\u002Fstorage\u002Ffiles\u002F4d7f3750-4709-40b2-a562-2b7ca2e3fb33\u002FTin-Clearing-Membership-Application-Form-2022.pdf",blocks:[]},{id:188030,type:n,button:o,title:"Tin (Buyer) Exchange Requirement 2022",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{src:c,width:d,height:e,alt:f,caption:a,video:a,desktop:{src:c,width:d,height:e,alt:f,caption:a,video:a}},icon_button_default:{desktop:[]},single_file:"https:\u002F\u002Fwww.icdx.co.id\u002Fcms\u002Fstorage\u002Ffiles\u002F117a9427-d39b-4d8e-a7af-fe4aea83be71\u002FTin-(Buyer)-Required-Documents---2022.pdf",blocks:[]},{id:188031,type:n,button:o,title:"Tin (Seller) Exchange Requirement 2022",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{src:c,width:d,height:e,alt:f,caption:a,video:a,desktop:{src:c,width:d,height:e,alt:f,caption:a,video:a}},icon_button_default:{desktop:[]},single_file:"https:\u002F\u002Fwww.icdx.co.id\u002Fcms\u002Fstorage\u002Ffiles\u002F26e18cfc-704d-4cf8-889e-0c19190f8d8e\u002FTin-(Seller)-Required-Documents---2022.pdf",blocks:[]},{id:188032,type:n,button:o,title:"Local Tin Company Exchange Membership Application Form",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{src:c,width:d,height:e,alt:f,caption:a,video:a,desktop:{src:c,width:d,height:e,alt:f,caption:a,video:a}},icon_button_default:{desktop:[]},single_file:"https:\u002F\u002Fwww.icdx.co.id\u002Fcms\u002Fstorage\u002Ffiles\u002Fd4be3f46-0082-481f-818c-697a9bf50388\u002FLocal-TIN-Company-Exchange-Membership-Application-Form--2021.pdf",blocks:[]}]};D[2]={id:27,slug:"members-activity",title:aj,body:a,title_seo:ak,description_seo:ak,active:b,published:b,position:3,image_default:{desktop:[]},blocks:[{id:36685,type:J,routeprefix:K,name:"MemberEligibility",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]}]};D[3]={id:28,slug:"members-support",title:al,body:a,title_seo:am,description_seo:am,active:b,published:b,position:4,image_default:{desktop:[]},blocks:[{id:196790,type:"membership-faq",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[{id:196791,type:"membership-faq-category",title:"Exchange membership",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[{id:196792,type:i,title:"Who can be a member of the ICDX?",desc:"\u003Cp\u003E\u003Cstrong\u003ETrader Members\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\u003Cp\u003ETrader members can be companies or individuals who are domiciled both locally and internationally. Corporate entities (eg private limited companies, partnerships etc.) can be 100% Indonesian owned or 100% foreign owned. The individual must be a resident of Indonesia with a TIN (Indonesian Tax ID) or a Foreigner with an NPWP.\u003C\u002Fp\u003E\u003Cp\u003E\u003Cbr\u003E\u003C\u002Fp\u003E\u003Cp\u003E\u003Cstrong\u003EBroker Members\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\u003Cp\u003EBrokerage members must be applicants for companies domiciled in Indonesia or abroad. Corporate entities (eg private limited companies, partnerships etc.) can be 100% Indonesian owned or 99% foreign owned.\u003C\u002Fp\u003E\u003Cp\u003E\u003Cbr\u003E\u003C\u002Fp\u003E",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]},{id:196793,type:i,title:"Why do I need to become an ICDX broker member?",desc:"\u003Cp\u003EICDX has a vision \"To become a leading global futures exchange that plays a role in strengthening the Indonesian economy through better formation tools and a proven risk management system\" and also a mission, namely to become the global trading platform of choice for commodity business actors in Indonesia and ASEAN and form a Strong and efficient \"Financial Deepening\" for financial institutions and trading companies in Indonesia.\u003C\u002Fp\u003E\u003Cp\u003E\u003Cbr\u003E\u003C\u002Fp\u003E",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]},{id:196794,type:i,title:"How do I become an ICDX member? What forms and documents do I need to complete?",desc:"\u003Cp\u003EPlease click \u003Ca href=\"https:\u002F\u002Fdrive.google.com\u002Ffile\u002Fd\u002F1r1d4j_sie2fOIIV7FY8hLuhWE6FLlFXd\u002Fview?usp=sharing\" rel=\"noopener noreferrer\" target=\"_blank\"\u003E\u003Cstrong\u003Ehere \u003C\u002Fstrong\u003E\u003C\u002Fa\u003Eto download the ICDX membership registration form. The document requirements can be found on the \u003Cstrong\u003E\"Dokumen yang Diperlukan\"\u003C\u002Fstrong\u003E page.\u003C\u002Fp\u003E",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]},{id:196795,type:i,title:"Will I receive training as an ICDX member?",desc:"\u003Cp\u003EEach Member of the ICDX can submit a training request via email membership@icdx.co.id and for tin commodity via email tin@icdx.co.id\u003C\u002Fp\u003E",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]},{id:196796,type:i,title:"Can a member on other exchanges apply for membership at ICDX?",desc:"\u003Cp\u003EBrokers and traders can have membership in more than one exchange, this refers to the Regulation of the Commodity Futures Trading Supervisory Agency of the Republic of Indonesia Number 3 of 2018 concerning Futures Brokerage Business Licenses and Approval of Opening of Futures Broker Branch Offices.\u003C\u002Fp\u003E",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]},{id:196797,type:i,title:"Do I need to have an office in Jakarta?",desc:"\u003Cp\u003EProspective brokers or traders are required to have a physical office in Indonesia.\u003C\u002Fp\u003E",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]},{id:196798,type:i,title:"What are the costs and other taxes and charges associated per category?",desc:"\u003Cp\u003EFor complete information regarding membership fees, please contact our email \u003Cspan style=\"color: rgb(102, 102, 102);\"\u003Emembership@icdx.co.id\u003C\u002Fspan\u003E, \u003Cspan style=\"color: rgb(102, 102, 102);\"\u003Efor tin commodity via email tin@icdx.co.id\u003C\u002Fspan\u003E\u003C\u002Fp\u003E",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]}]}]}]};return {layout:"default",data:[{memberships:D},{}],fetch:[{},{memberships:D},{datas:[]},{show:p,products:[{id:an,slug:"gold",title:"Gold"},{id:24,slug:"crude-oil",title:"Crude Oil"},{id:22,slug:"fx",title:"FX"},{id:ao,slug:"palm-oil",title:"Palm Oil"},{id:23,slug:"tin",title:"TIN"}],news:[],members:[],communities:[],filter:{search:a}}],error:h,state:{siteMeta:{title:h,description:h,keywords:h,image:"\u002Fcms\u002Fimg\u002F5deeae6d-c628-485d-a11e-dcdb1cf86770\u002Flogo.png?fm=&q=80&fit=max&crop=466%2C170%2C0%2C0"},menu:{topMenus:[{id:9,slug:ap,title:aq,title_seo:"Contact Us | Indonesia Commodity & Derivatives Exchange (ICDX)",description_seo:"Are you curious about something? Do you have some problems with our products? Contact the Indonesia Commodity & Derivatives Exchange (ICDX) If you're looking for answers, want to know how to do it, you'll find many ways to contact us here.",active:b,name:a,url:ap,component:a,published:b,parent_slug:a,subMenus:a,cover_default:{square:[],landscape:[]},blocks:[]},{id:19,slug:"careers",title:"Careers",title_seo:"CAREERS | Indonesia Commodity & Derivatives Exchange (ICDX)",description_seo:"At ICDX, you can build a better economy through an organized commodity trade within an exchange and an array of financial instruments provided by ICDX. Stretch yourself and work beyond your comfort zone with inspiring and diverse people.",active:b,name:a,url:"career",component:a,published:b,parent_slug:a,subMenus:a,cover_default:{square:[],landscape:[]},blocks:[]}],bottomMenus:[{id:7,slug:"our-markets",title:"Our Markets",title_seo:ar,description_seo:ar,active:b,name:a,url:"our-market",component:a,published:b,parent_slug:a,subMenus:[{title:"EXCHANGE",slug:"\u002Four-market\u002Fexchange"},{title:"RENEWABLE ENERGY CERTIFICATE",slug:"\u002Four-market\u002Frenewable-energy-certificate"},{title:"SHARIA",slug:"\u002Four-market\u002Fsharia"},{title:"DIGITAL GOLD",slug:"\u002Four-market\u002Fdigital-gold"},{title:"FBOT",slug:"\u002Four-market\u002Ffbot"},{title:"OTC",slug:"\u002Four-market\u002Fotc"},{title:"TIN PHYSICAL MARKET",slug:"\u002Four-market\u002Ftin-physical-market"},{title:"CPO PHYSICAL MARKET",slug:"\u002Four-market\u002Fcpo-physical-market"}],cover_default:{square:[],landscape:[]},blocks:[{id:36584,type:g,model:"App\\Models\\OurMarket",cover_default:{desktop:[]},cover_mobile_default:{mobile:[]},background_default:{desktop:[]},icon_button_default:{desktop:[]},blocks:[]}]},{id:15,slug:as,title:"Our Technology",title_seo:at,description_seo:at,active:b,name:a,url:as,component:a,published:b,parent_slug:a,subMenus:[{title:"Our Trading Platform",slug:"\u002Four-technology\u002Four-trading-platform"},{title:"Connectivity",slug:"\u002Four-technology\u002Fconnectivity"},{title:"Data Center",slug:"\u002Four-technology\u002Fdata