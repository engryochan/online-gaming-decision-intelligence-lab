const selectedLanguages = document.querySelector('.footer__language-options');

titleLanguages.addEventListener('click', () => {
  const isOpen = selectedLanguages.classList.toggle('open');
  
  if (isOpen) {
    selectedLanguages.style.display = 'block';
    selectedLanguages.setAttribute('aria-hidden', 'false');
    titleLanguages.setAttribute('aria-expanded', 'true');
  } else {
    selectedLanguages.style.display = 'none';
    selectedLanguages.setAttribute('aria-hidden', 'true');
    titleLanguages.setAttribute('aria-expanded', 'false');
  }
});;</script></div>




	
	


