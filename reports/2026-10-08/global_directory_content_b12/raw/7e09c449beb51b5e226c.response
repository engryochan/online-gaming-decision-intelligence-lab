  </style>
  <script>
    var windowSize = document.documentElement.clientWidth || window.innerWidth;
    if (windowSize < 998){
  const menuMobileContainer = document.querySelector('.b3-mobile-menu__mobile');
   const getFocusableElements = (container) => {
     return Array.from(
     container.querySelectorAll(
      'button, textarea, input[type="text"], input[type="radio"], input[type="checkbox"], select'
      )
    );
  };

  const checkFocusableElements = function (event) {
    if (event.key != 'Tab') return;
    const focusableElements = getFocusableElements(this);
    const firstElement = focusableElements.shift();
    const lastElement = focusableElements.pop();
    if (event.shiftKey) {
      if (document.activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
      }
    } else {
      if (document.activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    }
  };

  menuMobileContainer.addEventListener('keydown', checkFocusableElements);
}
  </script>
			
			
		
	
	
	
	


	
	
					
				
			
		
	
	


