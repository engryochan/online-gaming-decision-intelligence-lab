const openTab = url.searchParams.get("section");

const buttonFragment = document.getElementById(`btn-${configuration.idTab}`);
const panelFragment = document.getElementById(`panel-${configuration.idTab}`);

if ((configuration.isStandard && openTab === null) || openTab === configuration.idTab) {
  activeTab(buttonFragment, panelFragment)
}

buttonFragment.addEventListener('click', () => {
  disableAllTabs();
  activeTab(buttonFragment, panelFragment);
});;</script></div><div class="lfr-layout-structure-item-menu-lateral-item lfr-layout-structure-item-93dcb3a4-0814-0d0c-eb05-19382fc64f42 paragraph-auditoria"><div id="fragment-eea6786f-3981-2940-ed09-aa944d3c425e"> <button id="btn-auditoria-pre-operacional" role="tab" aria-selected="false" aria-controls="panel-bdrs-auditoria-pre-operacional" class="menu-lateral__button menu-lateral__button--auditoria-pre-operacional">
  Auditoria Pré-Operacional
</button>
<div id="content-auditoria-pre-operacional">
  <div id="panel-auditoria-pre-operacional" role="tabpanel" aria-labelledby="btn-auditoria-pre-operacional" aria-hidden="true" class="tabs__result tabs__result--auditoria-pre-operacional">
    <div><div class="lfr-layout-structure-item-43dbf387-38ed-a34b-6bc7-87bc6e9b19a0 lfr-layout-structure-item-container "><div class="lfr-layout-structure-item-basic-component-heading lfr-layout-structure-item-1cff21f6-0ccb-383f-e16c-ad9ae30ae7bd title-auditoria"><div id="fragment-8205233d-1f0b-b5f7-87b2-16ac593fa36c"> <h3 class="component-heading mb-0 text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="text">Auditoria Pré-Operacional</h3></div><style>.fragment-heading-text-colored a {
	color: inherit;
}</style></div><div class="lfr-layout-structure-item-basic-component-paragraph lfr-layout-structure-item-be365e36-982f-dad6-419f-15d6aa53d33a paragraph-auditoria"><div id="fragment-1d0c77cc-dcd4-2da2-53cb-bf02f63baf3c"> <div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">Para se tornar Participante de uma das categorias de acesso dos mercados administrados pela B3, a instituição deve atender a um conjunto de requisitos de admissão operacionais, tecnológicos e financeiros.&nbsp;O atendimento de tais requisitos é verificado por meio de auditoria pré-operacional realizada pela BSM conforme regras da B3, que levam em consideração requisitos operacionais e tecnológicos relacionados às atividades desempenhadas pela instituição requerente da autorização de acesso.</div></div><style>.component-paragraph img {
	max-width: 100%;
}</style></div></div></div>
  </div>
