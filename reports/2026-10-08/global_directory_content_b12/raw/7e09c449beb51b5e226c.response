.modal-consultaMRP__select {
  display: flex;
  flex-direction: column;
  gap: var(--b3-border-width-xl);
  position: relative;
  border: 0;
  background: transparent;
  color: #27826b;
}

.modal-consultaMRP__select :focus-visible {
  border: none;
}

.modal-consultaMRP__select-content {
  display: flex;
  flex-direction: column;
  position: relative;
  height: 100%;
  cursor: pointer;
  background-color: var(--b3-white-300);
  margin-top: var(--b3-spacing-lg);
  border-radius: var(--b3-border-width-xl);
  border: 0;
  border-bottom: var(--b3-border-width-md) solid var(--b3-bsm-green-300);
}

.modal-consultaMRP__select-placeholder {
  font: var(--b3-body);
  line-height: var(--b3-subtitle-size);
  text-align: left;
  color: var(--b3-gray-300);
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  height: 3.5rem;
}

.modal-consultaMRP__icon {
  transition: transform var(--b3-motion-duration-fastest) ease;
  size: var(--b3-spacing-lg);
  color: var(--b3-bsm-green-300);
  align-content: center;
  padding-right: 0;
  margin: auto 0;
}

.modal-consultaMRP__select-options {
  font: var(--b3-body-small);
  color: var(--b3-bsm-green-300);
  background-color: var(--b3-white-100);
  border-radius: var(--b3-corner-radius-md);
  border: var(--b3-spacing-3-xs) solid var(--b3-bsm-green-300);
  position: absolute;
  top: 5rem;
  left: 0rem;
  right: 0rem;
  height: var(--b3-spacing-3-xl);
}

.modal-consultaMRP__select-options.show {
  display: block;
  z-index: 1;
}

.modal-consultaMRP__select-option {
  font: var(--b3-body-small);
  text-align: left;
  color: var(--b3-bsm-green-300);
  box-sizing: border-box;
  padding: 0.375rem;
  border: none;
}

.modal-consultaMRP__select-option:hover {
  cursor: pointer;
}

.modal-button-disabled {
  background-color: #f6f6f7;
  border: 1px solid #f6f6f7;
  color: #666e7a66;
  cursor: not-allowed;
  height: 48px;
}

.modal-button-enabled {
  border: var(--b3-border-width-sm) solid var(--b3-bsm-yellow-600);
  background: var(--b3-bsm-yellow-600);
  color: var(--b3-navy-200);
  height: 48px;
}

.modal-button-standard {
  border-radius: 100px;
  font-weight: 700;
  font-size: 12px;
  text-align: center;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  white-space: nowrap;
  transition-duration: 0.3s;
  padding: 10px 16px;
  cursor: pointer;

  text-transform: uppercase;
  border-radius: 100px;
}
</style><script type="module" >const configuration = {}; const fragmentElement = document.querySelector('#fragment-afc53b78-038b-508a-b05f-b170e8ed0c52'); const fragmentEntryLinkNamespace = 'rtow'; const fragmentNamespace = 'rtow'; const layoutMode = 'view';Liferay.on('allPortletsReady', function () {
  const btnAccess = document.querySelector('#acessarBtn');
  const modalContent = document.querySelector('.modal-consultaMRP__content');
  const closeModalBtn = document.getElementById('closeModal');
  const modal = document.getElementById('modal-consultaMRP');
  const openModalBtn = document.querySelector('.b3-header__queriesMRP');
  const selectedBtn = document.querySelector('.modal-consultaMRP__select');
  const switchOptions = {
    opcao1:'https://sistema-mrp.bsmsupervisao.com.br/',
	opcao2:'https://www.bsmsupervisao.com.br/w/sistema-utilizado-para-o-tratamento-dos-processos-de-mrp',
    opcao3:'/pesquisa-de-mrp'
  };

  let valueSelect = '';

  if (btnAccess) {
    btnAccess.classList.add('modal-button-disabled');
    btnAccess.disabled = true;
  }

  function selectOption(event) {
    const target = event.target;
    const selectedOptionElement = target.selectedOptions[0];
    if (selectedOptionElement) {
      valueSelect = selectedOptionElement.getAttribute('value');
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('modal-consultaMRP--open');
    }
  }

  function openModal() {
    if (modal) {
      modal.classList.add('modal-consultaMRP--open');
      const focusableElements = getFocusableElements(modalContent);
      if (focusableElements.length > 0) {
        closeModalBtn.focus();
      }
    }
  }

  if (closeModalBtn) {
    closeModalBtn.addEventListener('click', closeModal);
    closeModalBtn.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        closeModal();
      }
    });
  }

  if (openModalBtn) {
    openModalBtn.addEventListener('click', openModal);
  }

  if (selectedBtn) {
    selectedBtn.addEventListener('change', function (event) {
      if (selectedBtn.value !== '') {
        if (btnAccess) {
          btnAccess.classList.remove('modal-button-disabled');
          btnAccess.classList.add('modal-button-enabled');
          btnAccess.disabled = false;
        }
        selectOption(event);
      } else {
        if (btnAccess) {
          btnAccess.classList.add('modal-button-disabled');
          btnAccess.disabled = true;
        }
      }
    });
  }

  if (btnAccess) {
    btnAccess.addEventListener('click', () => {
      if (valueSelect) {
        window.open(`${switchOptions[valueSelect]}`, '_blank');
        modal.classList.remove('modal-consultaMRP--open');
      }
    });
  }

  const checkFocusableElements = function (event) {
    if (event.key !== 'Tab') return;

    const focusableElements = getFocusableElements(this);
    if (focusableElements.length === 0) return; // Nenhum elemento focável

    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];

    if (event.shiftKey) {
      if (document.activeElement === closeModalBtn) {
        event.preventDefault();
        lastElement.focus();
      }
    } else {
      if (document.activeElement === lastElement) {
        event.preventDefault();
        closeModalBtn.focus();
      }
    }
  };

  modalContent.addEventListener('keydown', checkFocusableElements);

  function getFocusableElements(container) {
    return Array.from(
      container.querySelectorAll(
        'a[href], button, textarea, input[type="text"], input[type="radio"], input[type="checkbox"], select'
      )
    ).filter(
      (el) => !el.hasAttribute('disabled') && !el.disabled && el.tabIndex !== -1
    );
  }
});;</script></div><div class="lfr-layout-structure-item-vlibras lfr-layout-structure-item-0d8c9ff3-6293-5a35-f35c-a1d400dc41aa "><div id="fragment-f7461f20-199c-8dfd-23ce-a722d73c068c" > <div vw class="enabled">
