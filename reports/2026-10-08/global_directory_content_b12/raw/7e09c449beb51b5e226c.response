}</style><script type="module" >const configuration = {"idMenu":"","numberMenus":"7"}; const fragmentElement = document.querySelector('#fragment-2f2121f6-91cc-5abf-30c1-2c8079f779e5'); const fragmentEntryLinkNamespace = 'rumb'; const fragmentNamespace = 'rumb'; const layoutMode = 'view';const windowSize = document.documentElement.clientWidth || window.innerWidth;
const tabSelectedTitleMob = fragmentElement.querySelector(
  '.sub-menu__mobile-selected'
);
const menuButtons = fragmentElement.querySelectorAll(
  `.sub-menu__button--${configuration.idMenu}`
);
const changeSelected = (buttons) => {
  buttons.forEach((button, i) => {
    button.classList.remove('open');
    button.setAttribute('aria-selected', false);
    const splitLink = button.href.split('/');
    if (
      window.location.href.includes(
        splitLink[splitLink.length - 1].toLowerCase()
      )
    ) {
      menuButtons[i].classList.add('open');
      button.setAttribute('aria-selected', true);
    }
  });
};
const changeTabSelectedMob = (buttonSelected) => {
  const containerButtons = fragmentElement.querySelector(
    '.sub-menu__wrapper-buttons'
  );
  if (buttonSelected.classList.contains('open')) {
    tabSelectedTitleMob.textContent = buttonSelected.textContent;
    containerButtons.classList.remove('open');
  }
};
const openTabsMob = () => {
  const openTab = fragmentElement.querySelector(
    '.sub-menu__mobile-wrapper-select'
  );
  openTab.addEventListener('click', () => {
    const titleTab = fragmentElement.querySelector(
      '.sub-menu__wrapper-buttons'
    );
    titleTab.classList.toggle('open');
  });
};
changeSelected(menuButtons);
if (windowSize < 768) {
  menuButtons.forEach((button, i) => {
    changeTabSelectedMob(button);
  });
  openTabsMob();
};</script></div></div><div class="lfr-layout-structure-item-banner-secondary lfr-layout-structure-item-4101198a-a7bb-afb6-5c65-25567deeb871 "><div id="fragment-d65de4ec-dee9-0b2d-dc72-055e86a843bf" > <article class="banner-principal">
  <section class="banner-principal__img">
    <picture data-fileentryid="1590210"><source media="(max-width:300px)" srcset="/o/adaptive-media/image/1590210/Thumbnail-300x300/AdobeStock_709183917.jpeg?t=1724180483629" /><source media="(max-width:1000px) and (min-width:300px)" srcset="/o/adaptive-media/image/1590210/Preview-1000x0/AdobeStock_709183917.jpeg?t=1724180483629" /><img class="banner-principal__img-desktop" src="/documents/1266368/1342007/AdobeStock_709183917.jpeg/62a452a6-5b72-f242-a228-08d3d6a65739?version=1.0&amp;t=1724180483629" alt="" data-lfr-editable-id="banner-principal-img-desktop" data-lfr-editable-type="image" data-fileentryid="1590210"></picture>
    <img class="banner-principal__img-mobile" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAJCAYAAAA7KqwyAAAACXBIWXMAAAsTAAALEwEAmpwYAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAkSURBVHgB7cxBEQAACAIwtH8Pzw52kxD8OBZgNXsPQUOUwCIgAz0DHTyygaAAAAAASUVORK5CYII=" alt="" data-lfr-editable-id="banner-principal-img-mobile" data-lfr-editable-type="image">
    <div class="banner-principal__img-text">
      <h2 class="banner-principal__text" data-lfr-editable-id="banner-principal-text-img" data-lfr-editable-type="text">Auditoria BSM para a Conformidade e Eficiência Operacional</h2>
    </div>
  </section>
  <div class="banner-description">
    <div class="banner-description__container">
      <p class="banner-description__text" data-lfr-editable-id="banner-description-text" data-lfr-editable-type="rich-text">Nossa atividade de auditoria busca avaliar a conformidade dos processos e controles dos Participantes do mercado às normas vigentes. A auditoria é um dos mecanismos para executar o nosso dever de supervisão e fiscalização dos Participantes com acesso aos mercados organizados da B3.</p>
    </div>
</div></article></div><style >.banner-principal {
