  window.history.pushState({}, '', url);
}

const disableTab = (button, panel) => {
  button.classList.remove('open');
  button.setAttribute('aria-selected', false);
  panel.classList.remove('open');
  panel.setAttribute('aria-hidden', true);
}

const disableAllTabs = () => {
  const btnList = fragmentElement.closest('.tabs__wrapper-buttons');
  const buttons = btnList.querySelectorAll('button');
  const panelsList = fragmentElement.closest('.tabs__container').querySelector('.tabs__context');
  const panels = panelsList.querySelectorAll('.tabs__result');
  for (let i = 0; i < buttons.length; i++) {
    disableTab(buttons[i], panels[i]);
  }
}


createPanel();
