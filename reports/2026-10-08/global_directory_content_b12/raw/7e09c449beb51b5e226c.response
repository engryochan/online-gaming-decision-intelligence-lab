<style>
  .menu-fast-access {
    width: 100%;
    background-color: var(--b3-navy-500);
  }

  .menu-fast-access__wrapper {
    max-width: var(--b3-breakpoint-2-xl-down);
    margin: 0 auto;
    width: 100%;
  }

  .menu-fast-access__ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-template-rows: 1fr;
  }

  .menu-fast-access__link {
    font: var(--b3-ds3-type-button-button-small);
    text-transform: uppercase;

    color: var(--b3-white-100);
    padding-block: var(--b3-spacing-md);
    line-height: 1.125rem;
    display: block;
    text-align: center;

    position: relative;
  }

  .menu-fast-access__link:hover {
    color: var(--b3-white-100);
    opacity: 0.6;
  }

  .menu-fast-access__link::after {
    content: '';
    width: var(--b3-spacing-3-xs);
    height: var(--b3-spacing-xl);
    background-color: #ffffff40;
    display: block;
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
  }

  .menu-fast-access__list:last-child .menu-fast-access__link::after {
    content: unset;
  }

  .menu-fast-access .b3-mobile-menu-fast-access__header,
  .menu-fast-access .b3-mobile-menu__intern-item--button-mrp{
    display: none;
  }

  .b3-mobile-menu-fast-access__header {
      display: flex;
      border-bottom: 1px solid #E3E5E7;
      padding-block: 20px;
      justify-content: space-between;
      padding-inline: 24px;
    }

    .b3-mobile-menu-fast-access__header-wrapper {
      flex: 1;
      text-align: center;
    }

    .b3-mobile-menu-fast-access__header-title {
      font: var(--b3-body);
      font-weight: 600;
      color: var(--b3-gray-400);
    }

    .b3-mobile-menu-fast-access__header-close {
      cursor: pointer;
    }

  @media (max-width: 998px) {
    .menu-fast-access {
      display: block;
    }

    .menu-fast-access .b3-mobile-menu-fast-access__header,
  .menu-fast-access .b3-mobile-menu__intern-item--button-mrp{
    display: block;
  }

    .menu-fast-access .b3-mobile-menu-fast-access__header {
      display: flex;
      cursor: pointer;
    }

    .menu-fast-access .b3-mobile-menu__intern-item--button-mrp{
      display: flex;
      align-items: flex-end;
      flex: 1;
    }

    .menu-fast-access {
      background-color: var(--b3-white-100);
      height: calc(100vh - 70px);

      display: flex;
      flex-direction: column;
    }

    .menu-fast-access__ul {
      display: flex;
      flex-direction: column;
    }

    .menu-fast-access__link {
      text-align: left;
      padding-inline: var(--b3-spacing-lg);
      color: var(--b3-bsm-green-500)
    }

    .menu-fast-access__link:hover {
      color: var(--b3-bsm-green-300);
    }
  }
</style>
<script>
var windowSize = document.documentElement.clientWidth || window.innerWidth;
if (windowSize < 998){
  const menuMobileFastAccessContainer = document.querySelector('.menu-fast-access__content');
  const getFocusableElementsFastAcess = (container) => {
     return Array.from(
     container.querySelectorAll(
      'button, textarea, input[type="text"], input[type="radio"], input[type="checkbox"], select'
      )
    );
  };

  const checkFocusableElements = function (event) {
    if (event.key != 'Tab') return;
    const focusableElements = getFocusableElements(this);
    const firstElement = focusableElements.shift();
    const lastElement = focusableElements.pop();
    if (event.shiftKey) {
      if (document.activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
      }
    } else {
      if (document.activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    }
  };

  menuMobileFastAccessContainer.addEventListener('keydown', checkFocusableElements);
}

</script>
			
			
		
	
	
	
	


	
	
					
				
			
		
	
	


