<style>
  .b3-header__desktop-overflow {
    display: none;
    background-color: var(--b3-white-100);
    box-shadow: var(--b3-shadow-xs-shadow);
    z-index: 2;
  }

  .b3-header__nav-menu {
    display: flex;
    justify-content: center;
    margin: 0;
  }

  .b3-header__nav-menu-item-button,
  .b3-header__nav-menu-item-link {
    position: relative;
    display: block;
    font: var(--b3-body);
    line-height: var(--b3-subtitle-size);
    color: #005C45;
    padding-block: var(--b3-spacing-xl);
    padding-inline: var(--b3-spacing-lg);
    height: 100%;
  }

  .b3-header__nav-menu-item-link {
    padding-block: calc(2.0rem + 2px) var(--b3-spacing-xl);
  }

  .b3-header__nav-menu-item-button:not(.b3-header__nav-menu-item-button-search):before,
  .b3-header__nav-menu-item-link:before {
    content: '';
    width: 0;
    height: var(--b3-border-width-lg);
    background-color: #27826B;
    position: absolute;
    bottom: 0px;
    left: 50%;
    transform: translateX(-50%);
    transition: all var(--b3-motion-duration-faster) ease-in-out;
  }

  .b3-header__nav-menu-item-button.open~.b3-header__desktop-overflow {
    display: block;
  }

  .b3-header__nav-menu-item-button:hover::before,
  .b3-header__nav-menu-item-link:hover::before {
    width: 100%;
  }

  .b3-header__overflow-second.open {
    display: block;
  }

  .b3-header__nav-menu-item-search {
    margin-inline-start: 123px;
  }

  .b3-header__desktop-overflow {
    position: absolute;
    top: 101%;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    padding: var(--b3-spacing-2-xl);
  }

  .b3-header__desktop-center {
    position: relative;
    display: flex;
    max-width: var(--b3-breakpoint-2-xl-down);
    width: 100%;
    margin: 0 auto;
  }

  .b3-header__nav-second-level {
    width: 25%;
  }

  .b3-header__overflow-second {
    display: none;
    position: absolute;
    top: 0;
    width: 75%;
    right: 0;
    height: 100%;
    background-color: var(--b3-white);
    padding-left: var(--b3-spacing-2-xl);
  }

  .b3-header__nav-menu-item-second-level {
    display: flex;
    justify-content: space-between;
    padding: var(--b3-ds3-type-button-button-small-size);
    font: var(--b3-body);
    color: #005C45;
    border-bottom: 1px solid #E3E5E7;
    border-left: 3px solid transparent;
    width: 100%;
    transition: all var(--b3-motion-duration-faster) ease-out;
    text-align: left;
  }

  .b3-header__nav-menu-item-second-level:hover {
    border-color: #27826B;
    background-color: #EEF6F5;
  }

  .b3-header__nav-menu-item-second-level--arrow {
    transition: all 300ms ease-out;
  }

  .b3-header__nav-menu-item-second-level:hover .b3-header__nav-menu-item-second-level--arrow {
    margin-right: 0.625rem;
  }

  .b3-header__nav-menu-item-second-level--arrow {
    margin-right: var(--b3-subtitle-size);
  }

  .b3-header__nav-tertiary-level {
    flex: 1;
    border-left: 1px solid #E3E5E7;
    height: 100%;
    margin-left: var(--b3-spacing-2-xl);
    padding-inline: var(--b3-spacing-2-xl);
  }

  .b3-header__nav-menu-item-tertiary-level {
    width: 48%;
  }

  .b3-header__nav-menu-item-tertiary-level {
    font: var(--b3-body);
    color: #005C45;
    white-space: nowrap;
    gap: var(--b3-spacing-xs);
    transition: opacity var(--b3-motion-duration-fastest) ease-in;
    display: inline-block;
    width: 48%;
    padding-bottom: var(--b3-spacing-lg);
  }

  .b3-header__nav-menu-item-tertiary-level:hover {
    opacity: 0.8;
  }

  @media (max-width: 1200px) {
    .b3-header__nav-menu-item-search {
      margin-inline-start: var(--b3-spacing-2-xl);
    }
  }

  @media (max-width: 998px) {
    .b3-header__desktop-container {
      display: none;
    }
  }
</style>

<script>
  window.onload = () => {
  const menuDesktop = document.querySelectorAll('#b3-header-menu .b3-header__nav-menu-item-button');
  const listMenu = document.querySelectorAll('.b3-header__nav-menu-item:not(.b3-header__nav-menu-item-search)')
  listMenu.forEach((element,index)=>{
    let count = element.querySelectorAll('.b3-header__nav-menu-item-sencod-level button.b3-header__nav-menu-item-second-level').length;
  });
  const menuSecondLevel = document.querySelectorAll('.b3-header__nav-menu-item-sencod-level button.b3-header__nav-menu-item-second-level');
  const tertiaryLevel = document.querySelectorAll('.b3-header__nav-menu-item-sencod-level .b3-header__overflow-second');
  const fastAcess = document.querySelectorAll('.menu-fast-access');

  const closeMenus = (selectedIndex) => {
    menuDesktop.forEach((el, index) => {
      if (selectedIndex !== index) el.classList.remove('open');
    });
  };

  const closeAllMenuSecondLevel = (secondLevel, tertiaryLevel, currentSelected) => {
    secondLevel.forEach((button, index) => {
      tertiaryLevel[index].classList.remove('open');
    });
  };

  const handleSecondLevelClick = (listTertiary , buttonSecond, indexSecond) => {
    closeAllMenuSecondLevel(menuSecondLevel, tertiaryLevel, indexSecond);
    listTertiary.classList.toggle('open');
    listTertiary.classList.contains('open')
      ? buttonSecond.setAttribute('aria-expanded', 'true')
      : buttonSecond.setAttribute('aria-expanded', 'false');
  };

  const toggleMenuFirstElement = () => {
    listMenu.forEach((element, index) => {
      const button = element.querySelector('#b3-header-menu .b3-header__nav-menu-item-button');
      const listSecond = element.querySelectorAll('.b3-header__nav-menu-item-sencod-level');
      button.addEventListener('click', (event) => {
        closeMenus(index);
        button.classList.toggle('open');
        button.classList.contains('open')
          ? button.setAttribute('aria-expanded', 'true')
          : button.setAttribute('aria-expanded', 'false');

        if (listSecond) {
          listSecond.forEach((elementSecond , indexSecond) => {
            const buttonSecond = elementSecond.querySelector('button.b3-header__nav-menu-item-second-level');
            const listTertiary = elementSecond.querySelector('.b3-header__overflow-second')
            if(indexSecond == 0 && listTertiary){
              handleSecondLevelClick(listTertiary , buttonSecond , indexSecond);
            }
          });
        }
      });
    });
  };

  const toggleMenuSecondLevel = () => {
    const menuSecondLevel = document.querySelectorAll(
      '.b3-header__nav-menu-item-sencod-level button.b3-header__nav-menu-item-second-level'
    );
    const tertiaryLevel = document.querySelectorAll(
      '.b3-header__nav-menu-item-sencod-level .b3-header__overflow-second'
    );

    menuSecondLevel?.forEach((button, index) => {
      button.addEventListener('click', () => {
        closeAllMenuSecondLevel(menuSecondLevel, tertiaryLevel, index)
        tertiaryLevel[index].classList.toggle('open');

        tertiaryLevel[index].classList.contains('open')
          ? button.setAttribute('aria-expanded', 'true')
          :  button.setAttribute('aria-expanded', 'false');
      });
    });
  };

  const clickOutside = () => {
    document.addEventListener('click', (e) => {
      let clickInside = false;
      const targetSecondLevel = document.querySelectorAll('.b3-header__desktop-overflow');

      menuDesktop.forEach(menu => {
        if (menu.contains(e.target)) {
          clickInside = true;
          fastAcess.forEach(access => {
            access.style.display = 'none';
          });
        } else {
          targetSecondLevel.forEach(subMenu => {
            if (subMenu.contains(e.target)) {
              clickInside = true;
            }
          });
        }
      });

      menuDesktop.forEach(menu => {
        if (!clickInside || !menu.classList.contains('open')) {
          menu.classList.remove('open');
          fastAcess.forEach(access => {
            access.style.display = 'block';
          });
        }
      });
    });
  };

  if (window.innerWidth > 1024) {
    toggleMenuFirstElement();
    toggleMenuSecondLevel();
    clickOutside();
  }
};
</script>
			
			
		
	
	
	
	


	
	
					
				
			
		
	
	


