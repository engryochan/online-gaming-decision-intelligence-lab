  padding-bottom: var(--b3-tags-tag-size);
}

.accordion-bsm__body-list-text {
  font: var(--b3-body);
  line-height: var(--b3-spacing-lg);
  color: var(--b3-gray-200);
}

.accordion-bsm__body-img {
  width: 100%;
  border-radius: var(--b3-corner-radius-md) 0px 0px 0px;
}

.accordion-bsm__body.active {
  height: 100%;
  display: flex;
  justify-content: center;
  margin-top: var(--b3-spacing-md);
  margin-bottom: var(--b3-tags-tag-size);
  flex-direction: column;
}

.accordion-bsm-icon {
  transition: transform var(--b3-motion-duration-fastest) linear;
}

.accordion-bsm-icon.active {
  transform: rotate(180deg);
}

.accordion-bsm__content.active {
  border-bottom: var(--b3-border-width-lg) solid var(--b3-gray-900);
}

@media(max-width: 998px) {
  .accordion-bsm {
    padding: 0 var(--b3-header-4-size);
    box-shadow: unset;
  }

  .accordion-bsm__body-list {
    padding: var(--b3-tags-tag-size);
  }

  .accordion-bsm__content {
    border-bottom: var(--b3-border-width-lg) solid var(--b3-gray-900);
  }
