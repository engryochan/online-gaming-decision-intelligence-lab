}</style><script type="module">const configuration = {"isStandard":true,"label":"Informações Gerais","idTab":"informacoes-gerais"}; const fragmentElement = document.querySelector('#fragment-72195851-141d-35bf-11e6-5b309ff14a80'); const fragmentEntryLinkNamespace = 'nwuz'; const fragmentNamespace = 'nwuz'; const layoutMode = 'view';const createPanel = () => {
  const content = document.getElementById(`content-${configuration.idTab}`);
  const panel = fragmentElement.closest('.tabs__container').querySelector('.tabs__context');
  panel.appendChild(content);
}

const activeTab = (button, panel) => {
  button.classList.add('open');
  button.setAttribute('aria-selected', true);
  panel.classList.add('open');
  panel.setAttribute('aria-hidden', false);
  const url = new URL(window.location);
  url.searchParams.set("section", configuration.idTab);
  window.history.pushState({}, '', url);
}

const disableTab = (button, panel) => {
  button.classList.remove('open');
  button.setAttribute('aria-selected', false);
  panel.classList.remove('open');
  panel.setAttribute('aria-hidden', true);
}

const disableAllTabs = () => {
  const btnList = fragmentElement.closest('.tabs__wrapper-buttons');
  const buttons = btnList.querySelectorAll('button');
  const panelsList = fragmentElement.closest('.tabs__container').querySelector('.tabs__context');
  const panels = panelsList.querySelectorAll('.tabs__result');
  for (let i = 0; i < buttons.length; i++) {
    disableTab(buttons[i], panels[i]);
  }
}


createPanel();
const url = new URL(window.location);
const openTab = url.searchParams.get("section");

const buttonFragment = document.getElementById(`btn-${configuration.idTab}`);
const panelFragment = document.getElementById(`panel-${configuration.idTab}`);

if ((configuration.isStandard && openTab === null) || openTab === configuration.idTab) {
  activeTab(buttonFragment, panelFragment)
}

buttonFragment.addEventListener('click', () => {
  disableAllTabs();
  activeTab(buttonFragment, panelFragment);
});;</script></div><div class="lfr-layout-structure-item-menu-lateral-item lfr-layout-structure-item-1995c22f-031b-977a-299f-78be4f08a44f "><div id="fragment-6f93a84b-21bd-18c4-2e60-245c53c9a63f"> <button id="btn-monitoramento-conjunto-continuo-de-dados" role="tab" aria-selected="false" aria-controls="panel-bdrs-monitoramento-conjunto-continuo-de-dados" class="menu-lateral__button menu-lateral__button--monitoramento-conjunto-continuo-de-dados">
  MC²D
</button>
<div id="content-monitoramento-conjunto-continuo-de-dados">
  <div id="panel-monitoramento-conjunto-continuo-de-dados" role="tabpanel" aria-labelledby="btn-monitoramento-conjunto-continuo-de-dados" aria-hidden="true" class="tabs__result tabs__result--monitoramento-conjunto-continuo-de-dados">
    <div><div class="lfr-layout-structure-item-basic-component-heading lfr-layout-structure-item-0ed0495d-9ab8-a636-13ad-e7471ab970f9 title-auditoria"><div id="fragment-547ef943-e73b-f981-8286-0d490e6e6757"> <h3 class="component-heading mb-0 text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="text">Monitoramento Conjunto Contínuo de Dados (MC²D)</h3></div><style>.fragment-heading-text-colored a {
	color: inherit;
}</style></div><div class="lfr-layout-structure-item-basic-component-paragraph lfr-layout-structure-item-7e993ea0-d06f-f55d-8f4c-e9480b191171 paragraph-auditoria"><div id="fragment-2cff8c93-8628-45e6-a6f3-74c4caf21133"> <div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">O Monitoramento Conjunto Contínuo de Dados (MC²D) é uma iniciativa da BSM que visa aprimorar a supervisão e fiscalização dos mercados organizados. Este monitoramento é realizado de forma contínua, utilizando dados fornecidos pelo Participante do mercado. Através da análise massiva de dados, o MC²D permite a identificação tempestiva de exceções e a manutenção da integridade das informações e processos de forma contínua. Aqui você encontrará tudo relacionado ao MC²D, como: (i) Manual de Layout; (ii) Calendário; (iii) GT de MC²D; e muito mais!</div></div><style>.component-paragraph img {
	max-width: 100%;
}</style></div><div class="lfr-layout-structure-item-1f88bd06-bae9-a5d2-ab68-d6aa5ee99919 lfr-layout-structure-item-row "><div class="row align-items-lg-start align-items-sm-start align-items-start align-items-md-start flex-lg-row flex-sm-row flex-row flex-md-row"><div class="col col-lg-4 col-sm-12 col-12 col-md-4"><div class="lfr-layout-structure-item-anchor-comum lfr-layout-structure-item-8cb2adcd-b205-8831-9469-2ca9bfbc1bbe "><div id="fragment-57b8f60d-d419-c0fb-fd8c-532a408a6577"> <div class="anchor-container anchor-container--border">
