const tabSelectedTitleMob = fragmentElement.querySelector(
  '.menu-tabs__mobile-selected'
);
const menuButtons = fragmentElement.querySelectorAll(
  `.menu-tabs__button--${configuration.idTab}`
);

const contentButtons = fragmentElement.querySelectorAll(
  `.menu-tabs__result--${configuration.idTab}`
);

const changeSelected = (buttons, results) => {
  buttons.forEach((button, i) => {
    button.classList.remove('open');
    button.setAttribute('aria-selected', false);
    results[i].classList.remove('open');
    results[i].setAttribute('aria-hidden', true);
  });
};

const selectFirstElement = () => {
  const selectAllButtonsTabsChildren = document.querySelectorAll(
    `.menu-tabs__result--${configuration.idTab}.open .menu-tabs__button`
  );
  const selectAllResultTabsChildren = document.querySelectorAll(
    `.menu-tabs__result--${configuration.idTab}.open .menu-tabs__result`
  );

  selectAllButtonsTabsChildren.forEach((button, i) => {
    button.classList.remove('open');
    selectAllResultTabsChildren[i].classList.remove('open');

    if (button.classList.contains('fragment-tabs__button-1')) {
      button.classList.add('open');
      button.setAttribute('aria-selected', true);
      selectAllResultTabsChildren[i].classList.add('open');
      selectAllResultTabsChildren[i].setAttribute('aria-hidden', false);
    }
  });
};

const changeTabSelectedMob = (buttonSelected) => {
  const containerButtons = fragmentElement.querySelector(
    '.menu-tabs__wrapper-buttons'
  );
  if (buttonSelected.classList.contains('open')) {
    tabSelectedTitleMob.textContent = buttonSelected.textContent;
    containerButtons.classList.remove('open');
  }
};

const openTabsMob = () => {
  const openTab = fragmentElement.querySelector(
    '.menu-tabs__mobile-wrapper-select'
  );

  openTab.addEventListener('click', () => {
    const titleTab = fragmentElement.querySelector(
      '.menu-tabs__wrapper-buttons'
    );
    titleTab.classList.toggle('open');
  });
};

menuButtons.forEach((button, i) => {
  button.addEventListener('click', () => {
    changeSelected(menuButtons, contentButtons);
    button.classList.add('open');
    button.setAttribute('aria-selected', true);
    contentButtons[i].classList.add('open');
    contentButtons[i].setAttribute('aria-hidden', false);

    selectFirstElement();
    if (windowSize < 768) {
      changeTabSelectedMob(button);
    }
  });

  if (windowSize < 768) {
    changeTabSelectedMob(button);
  }
});
openTabsMob();;</script></div><div class="lfr-layout-structure-item-fb443974-9a59-4de9-2c43-3bd1b9d01eae lfr-layout-structure-item-container "><div class="lfr-layout-structure-item-basic-component-heading lfr-layout-structure-item-c2d9df39-ae39-a496-fdee-a2bed9f9357f title-auditoria"><div id="fragment-0da6e9d7-72cb-507e-0410-721b5803d0da"> <h3 class="component-heading mb-0 text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="text">Ficou com dúvidas? Respondemos as principais para você!</h3></div><style>.fragment-heading-text-colored a {
