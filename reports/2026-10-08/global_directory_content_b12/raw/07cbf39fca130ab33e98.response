            link: 'https://d2744r28dxz36a.cloudfront.net/MemberNotices/2007/07_03_DME_Spread_Credits_Notice_Circular.pdf'
        },                {
            date: '24/05/2007',
            rawDate: '2007-05-24',
            circularNumber: '07-02',
            summary: 'Margin Rates, Tiers, and Spot Month Assessment for the DME Contracts',
            category: 'Compliance',
            link: 'https://d2744r28dxz36a.cloudfront.net/MemberNotices/2007/07_02_DME_Circular.pdf'
        },                {
            date: '21/05/2007',
            rawDate: '2007-05-21',
            circularNumber: '07-01',
            summary: 'Data Protection',
            category: 'Membership',
            link: 'https://d2744r28dxz36a.cloudfront.net/MemberNotices/2007/07_01_DME_Member_Notice_Circular.pdf'
        }            ];

    function normalizeCategory(cat) {
        return (cat || '')
            .replace(/&amp;/gi, 'and')
            .replace(/\s*&\s*/g, ' and ')
            .replace(/\s+/g, ' ')
            .trim()
            .toLowerCase();
    }

    // Function to render notices
    function renderMemberNotices() {
        member.innerHTML = '';

        const itemsPerPage = 10;
        const startIndex = (activePageNumber - 1) * itemsPerPage;
        const endIndex = activePageNumber * itemsPerPage;

        const filteredData = data
            .filter((item) => {
                const itemYear = new Date(item.rawDate).getFullYear();
                return (!SelectedYear || itemYear === Number(SelectedYear)) &&
                       (!SelectedCategory || normalizeCategory(item.category) === normalizeCategory(SelectedCategory));
            })
            .sort((a, b) => {
                const dateDiff = new Date(b.rawDate) - new Date(a.rawDate);
                if (dateDiff !== 0) return dateDiff;
                return String(b.circularNumber).localeCompare(String(a.circularNumber), undefined, { numeric: true });
            })
            .slice(startIndex, endIndex);

        if (filteredData.length > 0) {
            filteredData.forEach((item) => {
                member.innerHTML += `
                    <td>
                        <div class="member-notice-card">
                            <div class="card-content">
                                <div>
                                    <h2>${item.summary}</h2>
                                </div>
                                <div class="card-actions">
                                    <a viewPdf=${item.link} id="view-button-${item.circularNumber}" class="view-btn view-button-table">
                                        <svg width="16" height="12" viewBox="0 0 16 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M15.965 5.83539C15.9415 5.78276 15.3775 4.53143 14.1182 3.27203C12.9504 2.10413 10.941 0.711914 8 0.711914C5.05899 0.711914 3.04959 2.10413 1.88182 3.27203C0.622549 4.53143 0.0584599 5.78276 0.0350226 5.83539C0.0119196 5.88741 -1.16696e-05 5.9437 8.56453e-09 6.00062C1.16867e-05 6.05754 0.0119661 6.11382 0.0350904 6.16583C0.0584613 6.21847 0.622616 7.46953 1.88189 8.72866C3.04965 9.8963 5.05899 11.2882 8 11.2882C10.941 11.2882 12.9503 9.8963 14.1181 8.72867C15.3774 7.46953 15.9415 6.21847 15.9649 6.16583C15.988 6.11382 16 6.05754 16 6.00062C16 5.9437 15.9881 5.88741 15.965 5.83539ZM8 10.4746C5.87268 10.4746 4.0149 9.70066 2.47808 8.17424C1.83373 7.53419 1.28848 6.80157 0.860367 6.00058C1.28848 5.19939 1.83374 4.46657 2.47815 3.82632C4.0149 2.29957 5.87275 1.52547 8 1.52547C10.1273 1.52547 11.9851 2.29958 13.5218 3.82632C14.1662 4.46652 14.7115 5.1993 15.1396 6.00045C14.7079 6.82758 12.545 10.4746 8 10.4746ZM8 2.882C7.38319 2.882 6.78023 3.06491 6.26737 3.40759C5.75452 3.75027 5.35479 4.23733 5.11875 4.80719C4.88271 5.37705 4.82095 6.00411 4.94128 6.60906C5.06161 7.21402 5.35864 7.76971 5.79479 8.20586C6.23094 8.64201 6.78662 8.93903 7.39158 9.05937C7.99654 9.1797 8.6236 9.11794 9.19345 8.8819C9.76331 8.64585 10.2504 8.24613 10.5931 7.73327C10.9357 7.22041 11.1186 6.61746 11.1186 6.00065C11.1177 5.17382 10.7888 4.38113 10.2042 3.79647C9.61952 3.21181 8.82683 2.88294 8 2.882ZM8 8.30573C7.5441 8.30573 7.09843 8.17054 6.71936 7.91725C6.34029 7.66397 6.04485 7.30396 5.87038 6.88276C5.69591 6.46156 5.65026 5.99809 5.73921 5.55095C5.82815 5.1038 6.04769 4.69308 6.37006 4.3707C6.69243 4.04833 7.10316 3.82879 7.5503 3.73985C7.99744 3.65091 8.46092 3.69656 8.88212 3.87103C9.30332 4.04549 9.66332 4.34094 9.91661 4.72001C10.1699 5.09908 10.3051 5.54474 10.3051 6.00065C10.3044 6.61178 10.0613 7.19769 9.62919 7.62983C9.19705 8.06197 8.61114 8.30505 8 8.30573Z" fill="#055C44" />
                                        </svg> VIEW
                                    </a>
                                    <a target="_blank" href=${item.link} id="download-button-${item.circularNumber}" class="download-btn download-button-table">
                                        <svg width="14" height="16" viewBox="0 0 14 16" fill="none" xmlns="http://www.w3.org/2000/svg">                                    
                                                <path d="M9.30971 0.0924075C9.23634 0.0151368 9.13576 -0.03125 9.03151 -0.03125H2.78992C1.63819 -0.03125 0.6875 0.915651 0.6875 2.06726V13.8701C0.6875 15.0219 1.63819 15.9688 2.78992 15.9688H11.2614C12.4131 15.9688 13.3638 15.0219 13.3638 13.8701V4.49818C13.3638 4.39771 13.3174 4.30116 13.2517 4.22767L9.30971 0.0924075ZM9.42177 1.33301L12.0614 4.10401H10.3455C9.83534 4.10401 9.42177 3.69434 9.42177 3.18421V1.33301ZM11.2614 15.1958H2.78992C2.06726 15.1958 1.46045 14.5968 1.46045 13.8701V2.06726C1.46045 1.34461 2.06336 0.741701 2.78992 0.741701H8.64882V3.18421C8.64882 4.1233 9.40639 4.87696 10.3455 4.87696H12.5908V13.8701C12.5908 14.5968 11.9879 15.1958 11.2614 15.1958Z" fill="#055C44" />                                   
                                                 <path d="M10.2068 12.5312H3.84546C3.63293 12.5312 3.45898 12.7051 3.45898 12.9177C3.45898 13.1303 3.63293 13.3042 3.84546 13.3042H10.2107C10.4232 13.3042 10.5972 13.1303 10.5972 12.9177C10.5972 12.7051 10.4232 12.5312 10.2068 12.5312Z" fill="#055C44" />                                    
                                                 <path d="M6.74345 11.1403C6.81694 11.2175 6.9174 11.2639 7.02555 11.2639C7.13383 11.2639 7.2343 11.2175 7.30766 11.1403L9.57243 8.70936C9.71929 8.55469 9.70769 8.30738 9.55315 8.16443C9.39848 8.01758 9.15117 8.02906 9.00822 8.18372L7.41203 9.89576V5.67554C7.41203 5.46289 7.23808 5.28906 7.02555 5.28906C6.81303 5.28906 6.63908 5.46289 6.63908 5.67554V9.89576L5.04679 8.18372C4.89994 8.02918 4.65641 8.01758 4.50187 8.16443C4.34733 8.31129 4.33573 8.55482 4.48258 8.70936L6.74345 11.1403Z" fill="#055C44" />                                
                                             </svg>  DOWNLOAD
                                    </a>
                                </div>
                            </div>
                            <div class="card-details">
                                <p><strong>CIRCULAR #</strong> ${item.circularNumber}</p>
                                <p><strong>DATE</strong> ${item.date}</p>
                                <p><strong>CATEGORY</strong> ${item.category}</p>
                            </div>
                        </div>
                    </td>`;
            });
            attachViewButtonEvents(); // Attach events after rendering
        } else {
            member.innerHTML = "No Data Found";
        }
        updatePaginationButtons();
    }

    // Function to update pagination buttons
    function updatePaginationButtons() {
        const filteredData = data
            .filter((item) => {
                const itemYear = new Date(item.rawDate).getFullYear();
                return (!SelectedYear || itemYear === Number(SelectedYear)) &&
                       (!SelectedCategory || normalizeCategory(item.category) === normalizeCategory(SelectedCategory));
            });
        const totalPages = Math.ceil(filteredData.length / 10);
        paginationContainer.innerHTML = '';

        for (let i = 1; i <= totalPages; i++) {
            const button = document.createElement('div');
            button.innerText = i;
            button.classList.add('pageno');
            if (i === activePageNumber) {
                button.classList.add('active');
            }
            button.addEventListener('click', () => {
                activePageNumber = i;
                renderMemberNotices();
            });
            paginationContainer.appendChild(button);
        }
    }

    // Function to handle category changes
    function handleCategoryChange() {
        SelectedCategory = document.getElementById("category").value;
        activePageNumber = 1;
        renderMemberNotices();
    }

    // Function to handle year changes
    function handleYearChange() {
        SelectedYear = document.getElementById("year").value;
        activePageNumber = 1;
        renderMemberNotices();
    }

    // Function to attach view button events
    function attachViewButtonEvents() {
        document.querySelectorAll('.view-btn').forEach((button) => {
            button.addEventListener('click', () => {
                const pdfUrl = button.getAttribute('viewPdf');
                openPdfModal(pdfUrl);
            });
        });
    }

    // Function to open PDF modal
    function openPdfModal(pdfUrl) {
        const modal = document.getElementById('pdfModal');
        const pdfViewer = document.getElementById('pdfViewer');
        modal.style.display = "block";
        pdfViewer.src = pdfUrl;
    }

    // Initialize event listeners and render notices
    document.getElementById('year').addEventListener('change', handleYearChange);
    document.getElementById('category').addEventListener('change', handleCategoryChange);
    document.querySelector('.close').addEventListener('click', () => {
        document.getElementById('pdfModal').style.display = "none";
    });

    // Initial render
    renderMemberNotices();





</script>        
        
        
