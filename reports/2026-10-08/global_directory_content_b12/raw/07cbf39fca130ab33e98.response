    <script type="text/javascript">
        $(document).on("click", ".goto", function (e) {
            var id = $(this).attr("href");
            var $id = $(id);
            if ($id.length === 0) {
                return;
            }
            e.preventDefault();
            var pos = $id.offset().top;
            $("body, html").animate({
                scrollTop: pos,
            });
        });
    </script>

 <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
<script>
    var southWest = L.latLng(-85, -180),
        northEast = L.latLng(85, 180);
    var bounds = L.latLngBounds(southWest, northEast);

    var map = L.map('map', {
        maxBoundsViscosity: 1.0,
        worldCopyJump: true,
        noWrap: false,
        attributionControl: false,

    }).setView([20, 0], 3);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
        // attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
        noWrap: true
    }).addTo(map);

    // var customIcon = L.icon({
    //     iconUrl: 'path/to/your/icon.png',
    //     iconSize: [25, 41],
    //     iconAnchor: [12, 41],
    //     popupAnchor: [1, -34],
    // });

    function addMarker(lat, lng, description) {
        var marker = L.marker([lat, lng]).addTo(map);
        // var marker = L.marker([lat, lng], { icon: customIcon }).addTo(map);
        marker.bindPopup(description).openPopup();
    }

    addMarker(34.53248, 104.44610, "China");
    addMarker(36.52672, 139.06676, "Japan");
    addMarker(3.77232, 101.79492, "Malaysia");
    addMarker(-42.87191, 172.34538, "New Zealand");
    addMarker(35.9078, 127.7669, "Republic of Korea");
    addMarker(1.27898, 103.85385, "Singapore");
    addMarker(15.25130, 101.25293, "Thailand");
    addMarker(22.33422, 114.17646, "Hong Kong");

    addMarker(35.032186301320586, 33.22449402729979 , "Cyprus");
    addMarker(58.67197012324855, 25.839077244838123 , "Estonia");
    addMarker(61.99430502370608, 25.449017892374258 , "Finland");
    addMarker(49.463664505019175, -2.5771385025889613 , "Guernsey");
    addMarker(53.130773364216665, -8.109514838263252 , "Ireland");
    addMarker(55.58376050728899, 23.852427747843713 , "Lithuania");
    addMarker(49.61221321719065, 6.176833529733245 , "Luxembourg");
    addMarker(52.16978519417698, 5.689331059247541 , "Netherlands");
    addMarker(61.756139316869884, 93.43967630659137 , "Russia");
    addMarker(36.140529272253495, -5.352613555167244 , "Gibraltar");
    addMarker(49.21393745724436, -2.1385351656524554 , "Jersey");

    addMarker(34.0843599896699, 35.88677645635962, "Lebanon");
    addMarker(20.639831265780554, 56.24259890279247, "Sultanate of Oman");
    addMarker(23.786555651666138, 54.13438385105498, "United Arab Emirates");

    addMarker(32.29939505787576, -64.79147809094079 , "Bermuda");
    addMarker(40.04145905770472, -99.27310319087692 , "USA");


    map.setMaxBounds(bounds);
</script>

