i/file/file/4e690b2a-d0e2-470a-ac0a-ab8d67aa8938"}},"resourceIdObjMeta":{"display":true,"description":"","drupal_internal__target_id":12078},"uid":{"type":"user--user","id":"6cb6debc-b814-4fa9-a101-02168c26d1e4","resourceIdObjMeta":{"drupal_internal__target_id":12}},"relationshipNames":["uid"]},"field_referenced_node":null,"relationshipNames":["paragraph_type","field_document_category","field_entity","field_file","field_referenced_node"]}],"relationshipNames":["node_type","revision_uid","uid","moderation_state","field_domain_access","field_domain_source","field_edit_permission","field_news_main_conten"]},"relationshipNames":["paragraph_type","field_document_category","field_entity","field_file","field_referenced_node"]}],"relationshipNames":["paragraph_type","field_paragraph_content"]}],"relationshipNames":["paragraph_type","field_paragraph_content"]}],"relationshipNames":["paragraph_type","field_paragraph_content"]},{"type":"paragraph--text_block_v1","id":"86649909-7bd8-4b3a-ae6e-72a8b095b5b5","drupal_internal__id":7301,"drupal_internal__revision_id":272979,"langcode":"en","status":true,"created":"2023-04-20T13:29:34+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-25T07:51:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cul\u003e\u003cli\u003e\u003cstrong\u003eEXTRACT FROM CREDIT AGRICOLE CIB'S 2016 REGISTRATION DOCUMENT REGARDING OFAC\u003c/strong\u003e\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eIn October 2015, Crédit Agricole CIB and its parent company Crédit Agricole S.A. (CASA) reached agreements with the US Federal and New York State authorities as part of an investigation into USD-denominated transactions with countries subject to US economic sanctions. The events covered by this agreement took place between 2003 and 2008.\u003c/p\u003e","format":"full_html","processed":"\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003e\u003cstrong\u003eEXTRACT FROM CREDIT AGRICOLE CIB'S 2016 REGISTRATION DOCUMENT REGARDING OFAC\u003c/strong\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eIn October 2015, Crédit Agricole CIB and its parent company Crédit Agricole S.A. (CASA) reached agreements with the US Federal and New York State authorities as part of an investigation into USD-denominated transactions with countries subject to US economic sanctions. The events covered by this agreement took place between 2003 and 2008.\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/86649909-7bd8-4b3a-ae6e-72a8b095b5b5?resourceVersion=id%3A272979"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/86649909-7bd8-4b3a-ae6e-72a8b095b5b5?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":272979,"drupal_internal__target_id":7301},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--section_background_block_v1","id":"f6b30e5d-bac4-40c0-ab7b-ed3db17fbd44","drupal_internal__id":11724,"drupal_internal__revision_id":272986,"langcode":"en","status":true,"created":"2023-08-24T09:00:29+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-24T12:54:08+00:00","preserve":null},"cacib_field_country":null,"field_visible":true,"links":{"self":{"href":