28"}},{"tag":"meta","attributes":{"property":"og:title","content":"Financial security system"}},{"tag":"meta","attributes":{"property":"og:description","content":"In accordance with the legal and regulatory obligations in force and with Crédit Agricole S.A. Group policy, Crédit Agricole CIB has implemented a system to prevent money laundering, terrorist financing and corruption, and ensure compliance with international sanctions. This system applies to both the Head Office and branches and subsidiaries abroad."}},{"tag":"meta","attributes":{"property":"og:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/themes/custom/bs5_ca_cib/images/social-default-image.png"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}},{"tag":"meta","attributes":{"name":"twitter:description","content":"In accordance with the legal and regulatory obligations in force and with Crédit Agricole S.A. Group policy, Crédit Agricole CIB has implemented a system to prevent money laundering, terrorist financing and corruption, and ensure compliance with international sanctions. This system applies to both the Head Office and branches and subsidiaries abroad."}},{"tag":"meta","attributes":{"name":"twitter:title","content":"Financial security system"}},{"tag":"meta","attributes":{"name":"twitter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/themes/custom/bs5_ca_cib/images/social-default-image.png"}},{"tag":"meta","attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"@type","content":"VideoObject","group":"schema_video_object","schema_metatag":true}}],"path":{"alias":"/about-us/compliance-rules/financial-security-system","pid":6773,"langcode":"en"},"cacib_extra_paths":[{"alias":"/fr/nous-connaitre/regles-de-conformite/dispositif-de-securite-financiere","langcode":"fr"},{"alias":"/en/about-us/compliance-rules/financial-security-system","langcode":"en"}],"cacib_extra_metatags":[{"title":{"#tag":"meta","#attributes":{"name":"title","content":"FINANCIAL SECURITY"}},"description":{"#tag":"meta","#attributes":{"name":"description","content":"Crédit Agricole CIB is subject to oversight and supervision by Autorité de Contrôle Prudentiel et de Résolution (ACPR) and Autorité des Marchés Financiers (AMF)."}},"og_site_name":{"#tag":"meta","#attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},"og_url":{"#tag":"meta","#attributes":{"property":"og:url","content":"https://www.ca-cib.com/about-us/compliance-rules/financial-security-system"}},"og_title":{"#tag":"meta","#attributes":{"property":"og:title","content":"Financial security system"}},"og_description":{"#tag":"meta","#attributes":{"property":"og:description","content":"In accordance with the legal and regulatory obligations in force and with Crédit Agricole S.A. Group policy, Crédit Agricole CIB has implemented a system to prevent money laundering, terrorist financing and corruption, and ensure compliance with international sanctions. This system applies to both the Head Office and branches and subsidiaries abroad."}},"og_image_0":{"#tag":"meta","#attributes":{"property":"og:image","content":"/_next/image?url=http%3A%2F%2Fbo-en-instit-cacib.adsi.credit-agricole.fr%2Fthemes%2Fcustom%2Fbs5_ca_cib%2Fimages%2Fsocial-default-image.png\u0026w=1920\u0026q=100"}},"twitter_cards_type":{"#tag":"meta","#attributes":{"name":"twitter:card","content":"summary_large_image"}},"twitter_cards_description":{"#tag":"meta","#attributes":{"name":"twitter:description","content":"In accordance with the legal and regulatory obligations in force and with Crédit Agricole S.A. Group policy, Crédit Agricole CIB has implemented a system to prevent money laundering, terrorist financing and corruption, and ensure compliance with international sanctions. This system applies to both the Head Office and branches and subsidiaries abroad."}},"twitter_cards_title":{"#tag":"meta","#attributes":{"name":"twitter:title","content":"Financial security system"}},"twitter_cards_image":{"#tag":"meta","#attributes":{"name":"twitter:image","content":"/_next/image?url=http%3A%2F%2Fbo-en-instit-cacib.adsi.credit-agricole.fr%2Fthemes%2Fcustom%2Fbs5_ca_cib%2Fimages%2Fsocial-default-image.png\u0026w=1920\u0026q=100"}},"schema_article_author_0":{"#tag":"meta","#attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},"schema_article_publisher":{"#tag":"meta","#attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},"schema_video_object_type":{"#tag":"meta","#attributes":{"name":"@type","content":"VideoObject","group":"schema_video_object","schema_metatag":true}}}],"cacib_menu_tree":[{"menu_item":{"class":"Drupal\\menu_link_content\\Plugin\\Menu\\MenuLinkContent","menu_name":"main","url":null,"route_name":"entity.node.canonical","route_parameters":{"node":"1945"},"options":[],"title":"About Us","description":null,"weight":2,"id":"menu_link_content:3bba6daa-304d-47f3-bc1a-edec175155dc","metadata":{"entity_id":"32"},"form_class":"\\Drupal\\menu_link_content\\Form\\MenuLinkContentForm","enabled":1,"expanded":1,"provider":"menu_link_content","discovered":0,"parent":""},"menu_item_entity_title":"About us","url":"/en/about-us"},{"menu_item":{"class":"Drupal\\menu_link_content\\Plugin\\Menu\\MenuLinkContent","menu_name":"main","url":null,"route_name":"entity.node.canonical","route_parameters":{"node":"1150"},"options":[],"title":"Compliance rules","description":"Compliance rules","weight":2,"id":"menu_link_content:33517d01-458a-4146-9225-0eaebd29f41b","metadata":{"entity_id":"71"},"form_class":"\\Drupal\\menu_link_content\\Form\\MenuLinkContentForm","enabled":1,"expanded":0,"provider":"menu_link_content","discovered":0,"parent":"menu_link_content:3bba6daa-304d-47f3-bc1a-edec175155dc"},"menu_item_entity_title":"Compliance rules","url":"/en/about-us/compliance-rules"},{"menu_item":{"class":"Drupal\\menu_link_content\\Plugin\\Menu\\MenuLinkContent","menu_name":"main","url":null,"route_name":"entity.node.canonical","route_parameters":{"node":"1023"},"options":[],"title":"Financial security","description":null,"weight":0,"id":"menu_link_content:42b34c12-fee7-486b-9d98-fdd841fdc8ce","metadata":{"entity_id":"72"},"form_class":"\\Drupal\\menu_link_content\\Form\\MenuLinkContentForm","enabled":1,"expanded":0,"provider":"menu_link_content","discovered":0,"parent":"menu_link_content:33517d01-458a-4146-9225-0eaebd29f41b"},"menu_item_entity_title":"Financial security system","url":"/en/about-us/compliance-rules/financial-security-system"}],"body":{"value":"\u003cp\u003eIn accordance with the legal and regulatory obligations in force and with Crédit Agricole S.A. Group policy, Crédit Agricole CIB has implemented \u003cstrong\u003ea system to prevent money laundering, terrorist financing and corruption, and ensure compliance with international sanctions\u003c/strong\u003e. This system applies to both the Head Office and branches and subsidiaries abroad.\u003c/p\u003e\u003cp\u003e\u003cbr\u003eAs a financial institution and investment firm \u003cstrong\u003eCrédit Agricole CIB is subject to supervision and supervision by Autorité de Contrôle Prudentiel et de Résolution (ACPR) and Autorité des Marchés Financiers (AMF)\u003c/strong\u003e, respectively the French banking and financial sector supervisory authorities.\u003c/p\u003e\u003cp\u003e\u003cbr\u003eCrédit Agricole CIB’s financial security system \u003cstrong\u003ecovers compliance with applicable anti-money laundering and counter-terrorist financing obligations and compliance with international sanctions\u003c/strong\u003e.\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cbr\u003eThe system is continuously strengthened in line with regulatory changes and risk assessments.\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eIn accordance with the legal and regulatory obligations in force and with Crédit Agricole S.A. Group policy, Crédit Agricole CIB has implemented \u003cstrong\u003ea system to prevent money laundering, terrorist financing and corruption, and ensure compliance with international sanctions\u003c/strong\u003e. This system applies to both the Head Office and branches and subsidiaries abroad.\u003c/p\u003e\n\u003cp\u003eAs a financial institution and investment firm \u003cstrong\u003eCrédit Agricole CIB is subject to supervision and supervision by Autorité de Contrôle Prudentiel et de Résolution (ACPR) and Autorité des Marchés Financiers (AMF)\u003c/strong\u003e, respectively the French banking and financial sector supervisory authorities.\u003c/p\u003e\n\u003cp\u003eCrédit Agricole CIB’s financial security system \u003cstrong\u003ecovers compliance with applicable anti-money laundering and counter-terrorist financing obligations and compliance with international sanctions\u003c/strong\u003e.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThe system is continuously strengthened in line with regulatory changes and risk assessments.\u003c/p\u003e\n","summary":""},"field_anchor_link_title":"Content","field_domain_all_affiliates":false,"field_language_select_message":"Find the content of [node:title] in the following language:","field_meta_tag":null,"field_meta_tags":"{\"description\":\"Cr\\u00e9dit Agricole CIB is subject to oversight and supervision by Autorit\\u00e9 de Contr\\u00f4le Prudentiel et de R\\u00e9solution (ACPR) and Autorit\\u00e9 des March\\u00e9s Financiers (AMF).\",\"title\":\"FINANCIAL SECURITY\"}","field_publishing_date":"2023-04-20T02:00:00+02:00","field_resume":null,"field_send_to_client_portal":false,"field_show_anchor_links":true,"field_show_social_media_sharing":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/node/page_edito/a6199f0c-dd5a-4c13-8efe-5143b333be28?resourceVersion=id%3A18489"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/node/page_edito/a6199f0c-dd5a-4c13-8efe-5143b333be28?resourceVersion=rel%3Aworking-copy"}},"node_type":{"type":"node_type--node_type","id":"d600fcc2-ad99-429f-a0f2-245525e92f0b","resourceIdObjMeta":{"drupal_internal__target_id":"page_edito"}},"revision_uid":{"type":"user--user","id":"e3ff7a90-1ee9-4f61-b223-333dd0c8cce9","resourceIdObjMeta":{"drupal_internal__target_id":15}},"uid":{"type":"user--user","id":"be1166bb-7d30-46de-b087-689ab94ecacc","resourceIdObjMeta":{"drupal_internal__target_id":1}},"moderation_state":{"type":"moderation_state--moderation_state","id":"6ad9fede-47e7-4dc0-887d-ed5642e71918","resourceIdObjMeta":{"drupal_internal__target_id":"published"}},"field_banner_image":null,"field_categories":null,"field_country":[],"field_craft":[],"field_domain_access":[{"type":"domain--domain","id":"a608439f-976c-4aa2-90d9-9404c4ec16ad","resourceIdObjMeta":{"drupal_internal__target_id":"ca_cib_com"}}],"field_domain_source":{"type":"domain--domain","id":"a608439f-976c-4aa2-90d9-9404c4ec16ad","resourceIdObjMeta":{"drupal_internal__target_id":"ca_cib_com"}},"field_edit_permission":[],"field_free_tag":[],"field_news_main_conten":[{"type":"paragraph--title_block_v1","id":"08e8bd0e-5c5f-40fc-987e-31748c2e3338","drupal_internal__id":7287,"drupal_internal__revision_id":272959,"langcode":"en","status":true,"created":"2023-04-20T12:45:40+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-07T09:42:46+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"International sanctions","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/08e8bd0e-5c5f-40fc-987e-31748c2e3338?resourceVersion=id%3A272959"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/08e8bd0e-5c5f-40fc-987e-31748c2e3338?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":272959,"drupal_internal__target_id":7287},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"d375fc35-4408-4a0e-9a4c-8c646f5c6ed2","drupal_internal__id":7288,"drupal_internal__revision_id":272960,"langcode":"en","status":true,"created":"2023-04-20T12:46:10+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-25T07:51:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eCrédit Agricole CIB has put in place a \u003cstrong\u003estrong compliance programme to comply with international sanctions\u003c/strong\u003e (embargoes, asset-freezing measures and sectoral sanctions).\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003cbr\u003eThe programme takes into account the international sanctions imposed by the United Nations, the European Union, France and the United States, and the local sanctions applying to each Group entity.\u003c/p\u003e\u003cp\u003e\u003cbr\u003eCrédit Agricole CIB also implements the policies of the Crédit Agricole S.A. Group.\u003cbr\u003e\u0026nbsp;\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eCrédit Agricole CIB has put in place a \u003cstrong\u003estrong compliance programme to comply with international sanctions\u003c/strong\u003e (embargoes, asset-freezing measures and sectoral sanctions).\u003c/p\u003e\n\u003cp\u003e\u0026nbsp;\u003cbr\u003eThe programme takes into account the international sanctions imposed by the United Nations, the European Union, France and the United States, and the local sanctions applying to each Group entity.\u003c/p\u003e\n\u003cp\u003eCrédit Agricole CIB also implements the policies of the Crédit Agricole S.A. Group.\u003cbr\u003e\u0026nbsp;\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/d375fc35-4408-4a0e-9a4c-8c646f5c6ed2?resourceVersion=id%3A272960"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/d375fc35-4408-4a0e-9a4c-8c646f5c6ed2?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":272960,"drupal_internal__target_id":7288},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"ba6c213c-698c-43be-a8cd-ab5a8a9aba8b","drupal_internal__id":7289,"drupal_internal__revision_id":272961,"langcode":"en","status":true,"created":"2023-04-20T12:46:51+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-07T09:44:34+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"Anti-money laundering and combating the financing of terrorism (AML/CFT)","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/ba6c213c-698c-43be-a8cd-ab5a8a9aba8b?resourceVersion=id%3A272961"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/ba6c213c-698c-43be-a8cd-ab5a8a9aba8b?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":272961,"drupal_internal__target_id":7289},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"998e491a-f655-4f2f-81a0-bcdf68af2eee","drupal_internal__id":7290,"drupal_internal__revision_id":272962,"langcode":"en","status":true,"created":"2023-04-20T12:47:56+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-25T07:51:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eCrédit Agricole CIB is \u003cstrong\u003efirmly committed to contributing to the international efforts to combat money laundering and the financing of terrorism (AML/CFT)\u003c/strong\u003e. To that end, it has set up a comprehensive Financial Security programme based on:\u0026nbsp;\u003c/p\u003e\u003cul\u003e\u003cli\u003eInternational AML/CFT regulations and recommendations:\u0026nbsp;\u003cul\u003e\u003cli\u003eThe FATF Recommendations on Combating Money Laundering and the Financing of Terrorism and Proliferation adopted in February 2012 and regularly updated;\u003c/li\u003e\u003cli\u003eThe 4th Directive 2015/849 and the 5th Directive 2018/843 of the European Union on the prevention of the use of the financial system for the purpose of money laundering or terrorist financing.\u003c/li\u003e\u003c/ul\u003e\u003c/li\u003e\u003cli\u003eThe French Monetary and Financial Code.\u003c/li\u003e\u003cli\u003eGuidelines issued by the European and French authorities (EBA, ACPR, etc.).\u003c/li\u003e\u003cli\u003eThe AML/CFT laws and regulations applicable in the jurisdictions in which Crédit Agricole CIB operates.\u003c/li\u003e\u003cli\u003eCrédit Agricole CIB also follows the Crédit Agricole S.A. Group's policy.\u003c/li\u003e\u003c/ul\u003e","format":"full_html","processed":"\u003cp\u003eCrédit Agricole CIB is \u003cstrong\u003efirmly committed to contributing to the international efforts to combat money laundering and the financing of terrorism (AML/CFT)\u003c/strong\u003e. To that end, it has set up a comprehensive Financial Security programme based on:\u0026nbsp;\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eInternational AML/CFT regulations and recommendations:\u0026nbsp;\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eThe FATF Recommendations on Combating Money Laundering and the Financing of Terrorism and Proliferation adopted in February 2012 and regularly updated;\u003c/li\u003e\n\u003cli\u003eThe 4th Directive 2015/849 and the 5th Directive 2018/843 of the European Union on the prevention of the use of the financial system for the purpose of money laundering or terrorist financing.\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/li\u003e\n\u003cli\u003eThe French Monetary and Financial Code.\u003c/li\u003e\n\u003cli\u003eGuidelines issued by the European and French authorities (EBA, ACPR, etc.).\u003c/li\u003e\n\u003cli\u003eThe AML/CFT laws and regulations applicable in the jurisdictions in which Crédit Agricole CIB operates.\u003c/li\u003e\n\u003cli\u003eCrédit Agricole CIB also follows the Crédit Agricole S.A. Group's policy.\u003c/li\u003e\n\u003c/ul\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/998e491a-f655-4f2f-81a0-bcdf68af2eee?resourceVersion=id%3A272962"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/998e491a-f655-4f2f-81a0-bcdf68af2eee?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":272962,"drupal_internal__target_id":7290},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"4971d432-0ec0-440f-a1f7-a7633f41a972","drupal_internal__id":7291,"drupal_internal__revision_id":272963,"langcode":"en","status":true,"created":"2023-04-20T12:53:41+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-07T09:44:34+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"The Financial Security programme","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/4971d432-0ec0-440f-a1f7-a7633f41a972?resourceVersion=id%3A272963"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/4971d432-0ec0-440f-a1f7-a7633f41a972?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":272963,"drupal_internal__target_id":7291},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"12878b32-c2d3-4dde-9809-cf14984bee48","drupal_internal__id":7292,"drupal_internal__revision_id":272964,"langcode":"en","status":true,"created":"2023-04-20T12:55:05+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-25T07:51:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eThe Financial Security programme implemented by Crédit Agricole CIB covers the \u003cstrong\u003efight against money laundering, terrorist financing and corruption, and compliance with international sanctions\u003c/strong\u003e.\u0026nbsp;\u003cbr\u003eIt consists of a corpus of standards on:\u003c/p\u003e\u003cul\u003e\u003cli\u003eThe Know Your Customer (KYC) implementing a risk-based approach;\u003c/li\u003e\u003cli\u003eThe monitoring of transactions in accordance with the applicable embargo and asset-freezing measures, the rules on transparency for transfers of funds, and for the purposes of combating money laundering and terrorist financing;\u0026nbsp;\u003c/li\u003e\u003cli\u003eThe enhanced review and reporting of suspicious transactions and activities to the Financial Intelligence Unit (TRACFIN in France);\u003c/li\u003e\u003cli\u003eEmployee training;\u003c/li\u003e\u003cli\u003eThe monitoring of compliance with the procedures and measures introduced to meet the above-mentioned obligations;\u003c/li\u003e\u003cli\u003eDocumentation and storing of KYC files and transaction documents;\u003c/li\u003e\u003cli\u003eInformation sharing.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003eCrédit Agricole CIB has set up a \u003cstrong\u003ededicated governance system\u003c/strong\u003e and an appropriate i\u003cstrong\u003enternal control framework to ensure compliance with its AML/CFT obligations and applicable international sanctions programmes.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eLearn more on our dedicated page on the fight against corruption.\u0026nbsp;\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eThe Financial Security programme implemented by Crédit Agricole CIB covers the \u003cstrong\u003efight against money laundering, terrorist financing and corruption, and compliance with international sanctions\u003c/strong\u003e.\u0026nbsp;\u003cbr\u003eIt consists of a corpus of standards on:\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eThe Know Your Customer (KYC) implementing a risk-based approach;\u003c/li\u003e\n\u003cli\u003eThe monitoring of transactions in accordance with the applicable embargo and asset-freezing measures, the rules on transparency for transfers of funds, and for the purposes of combating money laundering and terrorist financing;\u0026nbsp;\u003c/li\u003e\n\u003cli\u003eThe enhanced review and reporting of suspicious transactions and activities to the Financial Intelligence Unit (TRACFIN in France);\u003c/li\u003e\n\u003cli\u003eEmployee training;\u003c/li\u003e\n\u003cli\u003eThe monitoring of compliance with the procedures and measures introduced to meet the above-mentioned obligations;\u003c/li\u003e\n\u003cli\u003eDocumentation and storing of KYC files and transaction documents;\u003c/li\u003e\n\u003cli\u003eInformation sharing.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eCrédit Agricole CIB has set up a \u003cstrong\u003ededicated governance system\u003c/strong\u003e and an appropriate i\u003cstrong\u003enternal control framework to ensure compliance with its AML/CFT obligations and applicable international sanctions programmes.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eLearn more on our dedicated page on the fight against corruption.\u0026nbsp;\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/12878b32-c2d3-4dde-9809-cf14984bee48?resourceVersion=id%3A272964"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/12878b32-c2d3-4dde-9809-cf14984bee48?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":272964,"drupal_internal__target_id":7292},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--button_block_v1","id":"ee3718eb-06f7-41ce-a129-366d8abf3df3","drupal_internal__id":11734,"drupal_internal__revision_id":272966,"langcode":"en","status":true,"created":"2023-08-24T12:11:41+00:00","parent_id":"1023","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":false,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"fr","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-25T07:51:50+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/button_block_v1/ee3718eb-06f7-41ce-a129-366d8abf3df3?resourceVersion=id%3A272966"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/button_block_v1/ee3718eb-06f7-41ce-a129-366d8abf3df3?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":272966,"drupal_internal__target_id":11734},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"f554bd3b-5c2e-40a7-8550-d339bbc720e0","resourceIdObjMeta":{"drupal_internal__target_id":"button_block_v1"}},"field_paragraph_content":[{"type":"paragraph--button_block_item_v1","id":"df73c7fa-bf47-4043-942c-2f28bb8aa34f"