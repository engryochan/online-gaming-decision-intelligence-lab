<script src="https://cdn.jsdelivr.net/npm/jwt-decode@3.1.2/build/jwt-decode.min.js"></script>
<script type='text/javascript'>
  window.onload = function () {
    if (window.navigator.appName == 'Microsoft Internet Explorer' || window.navigator.userAgent.indexOf('Trident') > 0) {
      var searchElement = document.getElementById('search');
      if (searchElement != null) searchElement.setAttribute('href', '');
    }
  };

  function setHeight() {
    var windowHeight = window.innerHeight - 140;
    var navbar = document.getElementById('navbar');
    if (navbar) {
      navbar.style.maxHeight = windowHeight + 'px';
    }
  }
  window.addEventListener('resize', function (event) {
    setHeight();
  });
  
  var homeLink = document.getElementById('home');
  if (window.location.pathname === '/' || window.location.pathname === '/home') {
    homeLink.style.display = 'none';
  } else {
    homeLink.style.display = 'block';
  }

  const specificLinkIds = ['help', 'divider', 'call'];

  if (window.location.pathname === '/Unclaimed-Benefits-Search/') {
    const links = document.querySelectorAll('li a');
  
    links.forEach(function(link) {
     link.style.display = 'none';
    });
  
    specificLinkIds.forEach(function(id) {
      const link = document.getElementById(id);
    
      if (link) {
        link.style.display = 'block';
      }
    });
  }
  else {
    specificLinkIds.forEach(function(id) {
      const link = document.getElementById(id);
    
      if (link) {
        link.style.display = 'none';
      }
    });  
  }

  document.addEventListener('DOMContentLoaded', function () {
    // Select all the menu items
    const menuItems = document.querySelectorAll('.menu-item');

    // Loop through each menu item and add the hover effect
    menuItems.forEach(menuItem => {
    // Get the nav links and content sections for this specific menu item
    const navLinks = menuItem.querySelectorAll('.sidenav .nav-link');
    const contentSections = menuItem.querySelectorAll('.content .content-section');

    // Loop through each nav link and add click listener
    navLinks.forEach(link => {
      link.addEventListener('click', function (e) {
        // e.preventDefault(); // Prevent default anchor behavior

        // Remove 'active' class from all nav links
        navLinks.forEach(link => link.classList.remove('active'));

        // Add 'active' class to the clicked link
        this.classList.add('active');

        // Hide all content sections
        contentSections.forEach(section => section.classList.remove('active'));

        // Get the target content section from the data-bs-target attribute
        const targetId = this.getAttribute('data-bs-target');
        const targetContent = menuItem.querySelector(targetId);

        // Show the target content section
        if (targetContent) {
          targetContent.classList.add('active');
        }
      });
    });
    });
  });

  window.addEventListener('load', function () {
    const jwtToken = sessionStorage.getItem('c2Token');

    if (!jwtToken) {
      console.log('JWT Token not found');
      return;
    }

    try {
      const decodedToken = jwt_decode(jwtToken);
      const username = decodedToken.email;
      document.getElementById("username").textContent = username;

    } catch (error) {
      console.error('Error decoding JWT token:', error);
    }
  });

  // Grab all menu items and iterate over them
  const menuItems = document.querySelectorAll('.menu-item');

  // Loop through each menu item to add event listeners
  menuItems.forEach(item => {
    const hoverContainer = item.querySelector('.hover-container');
    const closeBtn = item.querySelector('.btn-close');

    // Show the hover container when the menu item is hovered
    item.addEventListener('mouseenter', function () {
      hoverContainer.style.display = 'block'; // Show on hover
    });

    // Hide the hover container when the mouse leaves the menu item
    item.addEventListener('mouseleave', function () {
      hoverContainer.style.display = 'none'; // Hide on mouse leave
    });

    // Close the hover container when the close button is clicked
    closeBtn.addEventListener('click', function () {
      hoverContainer.style.display = 'none'; // Close when the close button is clicked
    });

    // Optional: Close the hover container if you click anywhere outside the menu
    document.addEventListener('click', function (event) {
      if (!item.contains(event.target)) {
        hoverContainer.style.display = 'none'; // Hide if clicked outside of the menu item
      }
    });
  });

</script>

