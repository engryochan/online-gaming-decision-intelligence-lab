<style>

.pva-embedded-web-chat-widget-icon {
  display: none;
}

.webchat__imageAvatar__image img[src*="BotDefaultIcon.svg"] {
  display: none !important;
}

.webchat__imageAvatar__image {
  position: relative;
  background-image: url('https://fscasa.sharepoint.com/sites/FSCAProd/Chatbot/chatbot_avatar_png%202.png') !important;
  background-size: cover;
  background-position: center;
  width: 100%;
  height: 100%;
  border-radius: 50%;
    background-color: #FFFFFF;
}

.pva-embedded-web-chat-widget {
  background: none !important;
  background-image: url('https://fscasa.sharepoint.com/sites/FSCAProd/Chatbot/chatbot_avatar_png%202.png') !important;
  background-size: cover !important;
  background-position: center !important;
  background-repeat: no-repeat !important;
  width: 60px !important;
  height: 60px !important;
  border: 1px solid #FFFFFF;
  background-color: #FFFFFF;
}

.pva-embedded-web-chat-widget-icon,
.pva-embedded-web-chat-widget-tooltip {
  display: none !important;
}

 .webchat__bubble.webchat__bubble--from-user .webchat__bubble__content {
     background-color: #4562a1 !important;
     border-radius: 5px !important;
 }
 .webchat__bubble.webchat__bubble--from-user p {
     color: #ffffff;
 }

.pva-embedded-web-chat-widget {
  position: fixed !important;
  bottom: 25px !important;
  right: 25px !important;
  width: 220px !important;
  height: 52px !important;
  background: transparent !important;
  box-shadow: none !important;
  border: none !important;
  z-index: 9997 !important;
  pointer-events: none !important;
}

.fsca-chat-pill {
  position: fixed;
  bottom: 25px;
  right: 25px;

  display: flex;
  align-items: center;
  gap: 10px;

  height: 52px;
  padding: 6px 16px 6px 6px;

  background: #ffffff;
  color: #000000;

  border-radius: 26px;
  border: 1.5px solid #000000;

  font-size: 14px;
  font-weight: 600;

  box-shadow: 0 6px 14px rgba(0,0,0,0.2);
  cursor: pointer;
  z-index: 9998;

  opacity: 0;
}

.fsca-chat-pill-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background-image: url('https://fscasa.sharepoint.com/sites/FSCAProd/Chatbot/chatbot_avatar_png%202.png');
  background-size: cover;
  background-position: center;
  background-color: #FFFFFF;
  flex-shrink: 0;
}

.fsca-chat-pill:hover {
  box-shadow: 0 8px 18px rgba(0,0,0,0.25);
  transform: scale(1.03);
}

@keyframes slideInRight {
  from {
    transform: translateX(120px);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.fsca-chat-pill.slide-in {
  animation: slideInRight 0.6s ease-out forwards;
}

@media (max-width: 768px) {
  .pva-embedded-web-chat {
    width: 90% !important;
  }
}

.dropdown-search {
  width: 350px !important;
}

</style>

<script>
(function () {

  const pillHTML = `
    <div class="fsca-chat-pill" id="fscaChatPill">
      <div class="fsca-chat-pill-avatar"></div>
      <div>Hi, I'm <b>Zazi</b></div>
    </div>
  `;
  document.body.insertAdjacentHTML("beforeend", pillHTML);

  const pill = document.getElementById("fscaChatPill");

const SLIDE_IN_DELAY = 2000; // milliseconds (4000 = 4 seconds)

setTimeout(() => {
  pill.classList.add("slide-in");
}, SLIDE_IN_DELAY);


  pill.addEventListener("click", function () {
    const launcher = document.querySelector('.pva-embedded-web-chat-widget');
    if (launcher) {
      launcher.style.pointerEvents = 'auto';
      launcher.click();
      launcher.style.pointerEvents = 'none';
    }
  });

})();
</script>




 <nav class="navbar navbar-expand-lg navbar-white bg-white">
