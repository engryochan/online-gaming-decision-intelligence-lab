           const intercept = () => {
           let send = XMLHttpRequest.prototype.send;
           XMLHttpRequest.prototype.send = function () {
               this.addEventListener('readystatechange', function () {
				if (this.readyState === 4 && (this.getAllResponseHeaders().indexOf("x-ms-user-trace-id") >= 0 || this.getAllResponseHeaders().indexOf("x-ms-user-trace") >= 0)) {
					try {
						var inline = this.getResponseHeader('x-ms-user-trace');
						if (inline) {
							try {
								// decode base64, parse JSON
								var userTrace = JSON.parse(atob(inline));
                                document.dispatchEvent(new CustomEvent('updateDevToolRuntime',
                                    { detail: userTrace }
                                ));
								return;
							} catch (e) {
								console.warn('Failed to decode/parse inline x-ms-user-trace header', e);
							}
						}

						// fallback: id-based cache lookup (existing logic)
						var traceId = this.getResponseHeader('x-ms-user-trace-id');
						if (traceId) {
							return window.webapi.safeAjax({
								type: 'GET',
								url: '/_services/portal/UserTrace/Get?id=' + encodeURIComponent(traceId),
								// Accept text because the endpoint may return JSON or plain text
								headers: { 'Accept': 'text/plain, application/json' }
							})
                            .then(function (userTrace) {
                                if (userTrace) {
                                    document.dispatchEvent(new CustomEvent('updateDevToolRuntime', { detail: userTrace }));
                                }
                                return userTrace;
                            })
                            .fail(function (err) {
                                 console.warn('Error fetching user trace by id', err);
                                 return null;
                            });
                        }
                    }
                    catch (err) {
						console.log("In intercept for ajax call, Exception while parsing UserTrace header" + err);
                    }
                }
               }, false);
               send.apply(this, arguments);
           };
       };
		intercept();

        const interceptFetch = () => {
            const originalFetch = window.fetch;

            window.fetch = async function () {
                try {
                    const response = await originalFetch.apply(this, arguments);

                    const traceIdHeader = response.headers.get("x-ms-user-trace-id");
                    const inlineTraceHeader = response.headers.get("x-ms-user-trace");
                    // Inline trace present
                    if (inlineTraceHeader) {
                        try {
                            const userTrace = JSON.parse(atob(inlineTraceHeader));
                            document.dispatchEvent(
                                new CustomEvent("updateDevToolRuntime", {
                                    detail: userTrace
                                })
                            );

                            return response;
                        } catch (err) {
                            console.warn("Failed to decode/parse x-ms-user-trace header", err);
                        }
                    }
                    // Trace ID present, fetch full trace from cach
                    if (traceIdHeader) {
                        try {
                            const traceResponse = await originalFetch("/_services/portal/UserTrace/Get?id=" + encodeURIComponent(traceIdHeader),
                                {
                                    method: "GET",
                                    headers: {
                                        Accept:
                                            "text/plain, application/json"
                                    },
                                    credentials: "same-origin"
                                }
                            );

                            if (!traceResponse.ok) {
                                throw new Error(`HTTP ${traceResponse.status} ${traceResponse.statusText}`);
                            }
                            const contentType = traceResponse.headers.get("content-type") || "";

                            let userTrace;

                            if (contentType.includes("application/json")
                            ) {
                                userTrace = await traceResponse.json();
                            } else {
                                const text = await traceResponse.text();

                                try {
                                    userTrace = JSON.parse(text);
                                } catch {
                                    userTrace = text;
                                }
                            }

                            if (userTrace) {
                                document.dispatchEvent(new CustomEvent("updateDevToolRuntime",
                                        {
                                            detail: userTrace
                                        }
                                    )
                                );
                            }
                        } catch (err) {
                            console.warn("Error fetching user trace by id", err);
                        }
                    }

                    return response;
                } catch (err) {
                    console.error( "interceptFetch exception", err );

                    throw err;
                }
            };
        };

        interceptFetch();

	document.addEventListener("pagesRuntimeMessageProcessedInDevtool",function (e) {
        if (typeof ClientLogWrapper !== "undefined" && ClientLogWrapper && typeof ClientLogWrapper.getLogger === "function") {
            ClientLogWrapper.getLogger().traceInfo("pagesRuntimeMessageProcessedInDevtool","Devtool");
        } else {
            console.log( "pagesRuntimeMessageProcessedInDevtool RECEIVED",e.detail);
        }
    }
);


		
