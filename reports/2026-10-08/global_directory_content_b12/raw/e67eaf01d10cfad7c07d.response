                <div class="col-lg-4 mb-3">
                  
                  
                  
                  <a href="/_api/cr3ad_regulatedentitiesdocuments(14fa9c42-cbdf-f011-8544-7ced8d754080)/cr3ad_document/$value" target="_blank" class="btn custom-btn">
