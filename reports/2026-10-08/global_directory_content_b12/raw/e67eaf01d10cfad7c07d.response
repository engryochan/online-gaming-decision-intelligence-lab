	<script type="text/javascript">$(document).ready(function() {
    const urlParams = new URLSearchParams(window.location.search);

    // Get the value of the 'collapse' and 'subCollapse' parameters
    const param1 = urlParams.get('collapse');
    const param2 = urlParams.get('subCollapse');

    if (param1 || param2) {
        const allAccordions = document.querySelectorAll('.accordion-collapse');

        // Hide all accordions
        allAccordions.forEach(acc => {
            const collapse = new bootstrap.Collapse(acc, {toggle: false});
            collapse.hide();
        });

        // Open the accordion corresponding to the 'collapse' parameter
        const targetAccordion1 = document.getElementById(param1);
        const targetAccordion2 = document.getElementById(param2);

        if (targetAccordion1) {
            const collapse1 = new bootstrap.Collapse(targetAccordion1, {toggle: true});
            collapse1.show();

            // Smoothly scroll to the collapsed accordion item with some extra space above
            const rect1 = targetAccordion1.getBoundingClientRect();
            window.scrollTo({
                top: window.pageYOffset + rect1.top - 50, // Adjust the -50 to scroll a bit further
                behavior: 'smooth'
            });
        }

        if (targetAccordion2) {
            const collapse2 = new bootstrap.Collapse(targetAccordion2, {toggle: true});
            collapse2.show();

            // Smoothly scroll to the expanded accordion item with some extra space above
            const rect2 = targetAccordion2.getBoundingClientRect();
            window.scrollTo({
                top: window.pageYOffset + rect2.top - 50, // Adjust the -50 to scroll a bit further
                behavior: 'smooth'
            });
        } 
    }
});
</script>
