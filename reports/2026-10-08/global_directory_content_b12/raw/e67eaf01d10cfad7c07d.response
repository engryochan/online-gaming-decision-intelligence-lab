		<style type="text/css">body {
    font-family: Arial;
}
  
p, ul, li {
    font-family: inherit;
}

h3 {
    font-size: 18px;
}
  
p {
    font-size: 14px;
}

ul {
    list-style-type: disc;
    padding-left: 20px;
    font-size: 14px;
}
  
li {
    margin-bottom: 3px;
}
  
.card {
    display: flex;
    border: 1px solid #ccc;
    border-radius: 15px;
    overflow: hidden;
    height: 100%;
}
  
.card img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    display: block;
}
 
.card .col-lg-6 h3 {
    font-size: 24px;
}

.accordion .accordion-item {
    border: none;
    border-radius: 8px;
}

.accordion .accordion-header {
    border-radius: 8px;
    overflow: hidden;
}

.accordion-button {
    color: white !important;
}

.accordion-button::before {
    display: none;
}

.accordion-button.collapsed::after {
    content: '\f055';
    font-family: 'Font Awesome 5 Free';
    font-weight: 900;
    margin-left: auto;
}

.accordion-button:not(.collapsed)::after {
    content: '\f056';
    font-family: 'Font Awesome 5 Free';
    font-weight: 900;
    margin-left: auto;
}

.accordion-collapse {
    margin: 20px;
}

.accordion-collapse p {
    display: block;
}

.bg-light {
    background-color: #939594 !important;
}

.custom-btn,  
    .custom-btn:hover,
    .btn-primary:active,
    .btn-primary:visited,
    .btn-primary:focus {
      background-color: #ff8200 !important;
      border-color: #ff8200 !important;
      color: #ffffff;
      width: 100%;
}

table {
    table-layout: fixed;
}

/* Mobile Screen Styles */
@media (max-width: 768px) {
    .card .col-lg-6:not(:first-child) {
      padding: 20px;
    }
  
    .card .col-lg-6:not(:first-child) h3,
    .card .col-lg-6:not(:first-child) p {
      padding: 15px;
    }

    .card .col-lg-6:not(:first-child) ul {
        padding-left: 35px;
    }
}
</style>
