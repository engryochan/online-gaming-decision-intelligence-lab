<style>
.ob-cta-row{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.ob-cta-row a,.ob-form button,.ob-btn,.ob-btn-dark,.ob-btn-outline{display:inline-flex;align-items:center;justify-content:center;padding:11px 20px;border-radius:6px;font-size:14px;font-weight:600;text-decoration:none;border:1px solid #07173D;font-family:Manrope,'DM Sans',Arial,sans-serif;background:#07173D;color:#FFFFFF;cursor:pointer;line-height:1.2}
.ob-cta-row a:hover,.ob-form button:hover{background:#163A7C;border-color:#163A7C}
.ob-cta-row a:not(:first-child){background:transparent;color:#07173D;border-color:#C9CDD4}
.ob-cta-row a:not(:first-child):hover{background:transparent;border-color:#07173D}
.ob-hero .ob-cta-row a:first-child,.ob-section-navy .ob-cta-row a:first-child{background:#2F62B3;border-color:#2F62B3;color:#FFFFFF}
.ob-hero .ob-cta-row a:first-child:hover,.ob-section-navy .ob-cta-row a:first-child:hover{background:#7FA1D6;border-color:#7FA1D6;color:#07173D}
.ob-hero .ob-cta-row a:not(:first-child),.ob-section-navy .ob-cta-row a:not(:first-child){color:#FFFFFF;border-color:rgba(255,255,255,0.4)}
.ob-hero .ob-cta-row a:not(:first-child):hover,.ob-section-navy .ob-cta-row a:not(:first-child):hover{border-color:#FFFFFF}
.ob-card-ice .ob-cta-row a:first-child,.ob-card .ob-cta-row a:first-child{background:#07173D;border-color:#07173D;color:#FFFFFF}
.ob-sample{background:#DCE5F3;color:#163A7C}
.ob-prose table{width:100%;border-collapse:collapse;font-size:15px;margin:16px 0 24px}
.ob-prose th{text-align:left;padding:10px 12px;background:#DCE5F3;color:#07173D;font-weight:600;border-bottom:1px solid #C9CDD4}
.ob-prose td{padding:10px 12px;border-bottom:1px solid #E6E9EF;color:#3D4451}
.ob-prose img{max-width:100%;height:auto;border-radius:8px}
.ob-prose figcaption{font-size:13px;color:#3D4451;margin-top:8px}
.ob-prose h2,.ob-prose h3,.ob-prose h4{font-family:'DM Sans',Manrope,Arial,sans-serif;color:#07173D;margin:28px 0 10px;line-height:1.3}
.ob-prose h2{font-size:26px}.ob-prose h3{font-size:22px}.ob-prose h4{font-size:18px;font-weight:600}
.ob-prose p{margin:0 0 16px}.ob-prose a{color:#163A7C}
.ob-prose blockquote{border-left:3px solid #163A7C;padding:8px 18px;margin:20px 0;background:#F5F7FB;color:#07173D}
.ob-form select,.ob-form textarea{font-family:Manrope,'DM Sans',Arial,sans-serif}
</style>
<script>
(function(){
  try{
    var nav=document.getElementById('ob-nav');
    if(nav){
      var items=nav.querySelectorAll('.ob-menu-item');
      var mobile=function(){return window.matchMedia('(max-width: 991px)').matches;};
      items.forEach(function(li){
        var dd=li.querySelector('.ob-dropdown');if(!dd)return;
        var show=function(){if(!mobile())dd.style.display='block';};
        var hide=function(){if(!mobile())dd.style.display='none';};
        li.addEventListener('mouseenter',show);li.addEventListener('mouseleave',hide);
        li.addEventListener('focusin',show);li.addEventListener('focusout',function(e){if(!li.contains(e.relatedTarget))hide();});
      });
      var burger=document.getElementById('ob-burger'),menu=document.getElementById('ob-menu');
      if(burger&&menu){burger.addEventListener('click',function(){var open=menu.style.display==='flex';menu.style.display=open?'none':'flex';burger.setAttribute('aria-expanded',open?'false':'true');});}
      window.addEventListener('resize',function(){if(!mobile()&&menu){menu.style.display='';}});
    }
  }catch(e){}
  try{var y=String(new Date().getFullYear());var el=document.getElementById('ob-copyright');if(el){el.textContent=el.textContent.replace(/20\d\d/,y);}}catch(e){}
  try{var c=document.querySelector('link[rel="canonical"]');if(!c){c=document.createElement('link');c.setAttribute('rel','canonical');document.head.appendChild(c);}c.setAttribute('href','https://www.optaxe.com'+location.pathname);}catch(e){}
})();
</script></div></footer><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=6a8951159977c2e34a0915cb" type="text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6a8951159977c2e34a0915cb/js/webflow.schunk.7321a5097fb66f41.js" type="text/javascript" integrity="sha384-8byG6BgY1rxlpnYqw3IQGKRV7Mxk5Ef2uzXD18kNuDGZptVybdX5pFRjNb3znG62" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/6a8951159977c2e34a0915cb/js/webflow.751e0867.148dc658e77a3916.js" type="text/javascript" integrity="sha384-gRsZCr5oM+8TIikTjp8mlQaxo339itgljbpHAoEYW6GgTyU0BumceR5934ES3MO8" crossorigin="anonymous"></script><!-- OptAxe: keep the footer copyright year current automatically. -->
<script>
(function(){
  try{
    var y=String(new Date().getFullYear());
    var el=document.getElementById('optx-copyright');
    var nodes=el?[el]:[].slice.call(document.querySelectorAll('div,p,span')).filter(function(n){return n.children.length===0 && /^\s*©\s*20\d\d/.test(n.textContent||'');});
    nodes.forEach(function(n){ n.textContent=(n.textContent||'').replace(/20\d\d/, y); });
  }catch(e){}
})();
</script>

<!-- OptAxe cookie consent banner. Added 17 Sep 2026. Pairs with the Google Consent Mode v2 defaults in the site head code:
     analytics_storage starts denied, and only this banner can grant it. Choice is stored in localStorage under 'optx-consent'.
     The "Cookie settings" footer link below is inserted by script because the footer nav lives in an HTML embed; it can be
     moved into that embed in the Designer at any time (just add <a href="#cookie-settings" class="ob-footer-link">Cookie settings</a>)
     and this insert will then skip itself, because it checks for an existing link first. -->
<style>
#optx-cc{position:fixed;left:0;right:0;bottom:0;z-index:2147483000;display:none;background:#07173d;color:#dce5f3;font-family:"DM Sans",system-ui,-apple-system,sans-serif;box-shadow:0 -2px 24px rgba(7,23,61,.28)}
#optx-cc.optx-show{display:block}
.optx-cc-in{max-width:1180px;margin:0 auto;padding:20px 24px;display:flex;align-items:center;gap:24px;flex-wrap:wrap}
.optx-cc-tx{flex:1 1 420px;min-width:260px;font-size:.9375rem;line-height:1.55;margin:0}
.optx-cc-tx a{color:#7fa1d6;text-decoration:underline;text-underline-offset:2px}
.optx-cc-tx a:hover{color:#dce5f3}
.optx-cc-bt{display:flex;gap:12px;flex-wrap:wrap}
.optx-cc-bt button{font:inherit;font-weight:600;font-size:.9375rem;padding:11px 26px;border-radius:6px;cursor:pointer;border:1px solid transparent;transition:background .15s,border-color .15s,color .15s}
.optx-cc-bt button:focus-visible{outline:2px solid #7fa1d6;outline-offset:2px}
#optx-cc-no{background:transparent;color:#dce5f3;border-color:#7fa1d6}
#optx-cc-no:hover{background:rgba(127,161,214,.16)}
#optx-cc-yes{background:#2f62b3;color:#fff}
#optx-cc-yes:hover{background:#163a7c}
@media (max-width:900px){.optx-cc-in{padding:18px 20px;gap:16px}.optx-cc-bt{width:100%}.optx-cc-bt button{flex:1 1 0;padding:12px 16px}}
@media (prefers-reduced-motion:reduce){.optx-cc-bt button{transition:none}}
</style>

<div id="optx-cc" role="dialog" aria-live="polite" aria-label="Cookie consent">
  <div class="optx-cc-in">
    <p class="optx-cc-tx">We use analytics cookies to understand how this site is used, so we can improve it. They are only set if you accept. Essential cookies needed to run the site are always on. See our <a href="/privacy">privacy policy</a>.</p>
    <div class="optx-cc-bt">
      <button type="button" id="optx-cc-no">Reject analytics</button>
      <button type="button" id="optx-cc-yes">Accept analytics</button>
    </div>
  </div>
</div>

<script>
(function(){
  var KEY='optx-consent', bar=document.getElementById('optx-cc');
  if(!bar) return;
  function store(v){ try{ localStorage.setItem(KEY,v); }catch(e){} }
  function read(){ try{ return localStorage.getItem(KEY); }catch(e){ return null; } }
  function gt(){ window.dataLayer=window.dataLayer||[]; window.dataLayer.push(arguments); }
  function hide(){ bar.classList.remove('optx-show'); }
  function show(){ bar.classList.add('optx-show'); }
  function decide(granted){
    store(granted?'granted':'denied');
    gt('consent','update',{'analytics_storage':granted?'granted':'denied'});
    hide();
  }
  document.getElementById('optx-cc-yes').addEventListener('click',function(){decide(true);});
  document.getElementById('optx-cc-no').addEventListener('click',function(){decide(false);});
  if(!read()) show();
  window.optxCookieSettings=function(){ show(); };
  document.addEventListener('click',function(e){
    var a=e.target.closest&&e.target.closest('a[href="#cookie-settings"]');
    if(a){ e.preventDefault(); show(); }
  });

  // Insert the "Cookie settings" link into the footer nav, after "Privacy policy".
  // Skips itself if a #cookie-settings link already exists (e.g. added in the Designer).
  function addFooterLink(){
    var nav=document.querySelector('nav.ob-footer-links');
    if(!nav || nav.querySelector('a[href="#cookie-settings"]')) return;
    var priv=nav.querySelector('a[href="/privacy"]');
    var a=document.createElement('a');
    a.className=priv?priv.className:'ob-footer-link';
    a.setAttribute('href','#cookie-settings');
    a.textContent='Cookie settings';
    if(priv&&priv.nextSibling){ nav.insertBefore(a,priv.nextSibling); } else { nav.appendChild(a); }
  }
  if(document.readyState==='loading'){ document.addEventListener('DOMContentLoaded',addFooterLink); } else { addFooterLink(); }
})();
</script></body></html>