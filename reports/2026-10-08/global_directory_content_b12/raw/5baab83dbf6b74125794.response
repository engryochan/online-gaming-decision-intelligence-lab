}

#ringIDTriggers-ccp .brm-btn:hover,#ringIDTriggers-disponibil .brm-btn:hover,#ringIDTriggers-echilibrare .brm-btn:hover,#ringIDTriggers-forward .brm-btn:hover,#ringIDTriggers-spot .brm-btn:hoverr {
