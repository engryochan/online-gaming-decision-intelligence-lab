/* investor forum contact form css*/



#contact .career_form_wrapper {
    margin-top: 60px;
}
#contact .career_form_wrapper .career_form {
    display: block;
    padding: 0;
}
	
#contact .career_form_wrapper .career_form span.wpcf7-form-control-wrap {
    padding: 0;
    margin: 0;
    width: 100%;
}
	
#contact .career_form_wrapper .career_form input.wpcf7-form-control, .careers .main .career_form_wrapper .career_form select.wpcf7-form-control {
    margin: 0 0 25px;
    -webkit-appearance: none;
    -moz-appearance: none;
}

	#contact .career_form_wrapper .career_form input.wpcf7-form-control, .careers .main .career_form_wrapper .career_form select.wpcf7-form-control {
    width: 100%;
    border: none;
    outline: none;
    padding: 20px 22px;
    background: #e1e1e1;
    font-size: 14px;
    line-height: normal;
    margin: 0 0 15px;
    height: 60px;
    border-radius: 0;
    -webkit-appearance: none;
    -moz-appearance: none;
    position: relative;
}

#contact .career_form textarea.wpcf7-form-control {
    width: 100%;
    height: 295px;
    border: none;
    outline: none;
    padding: 20px 22px;
    background: #e1e1e1;
    margin: 0 0 30px;
    border-radius: 0;
    -webkit-appearance: none;
}
	
	#contact .career_form_wrapper .career_form .contact_submit_btn {
    float: left;
    width: 125px;
    height: 50px;
    background: #fff100;
		margin-left: 20px;
}
	#contact .career_form_wrapper .career_form .contact_submit_btn p {
    height: 50px;
    margin: 0;
    position: relative;
}
	
#contact .career_form_wrapper .career_form .contact_submit_btn p .wpcf7-submit {
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    background: none;
    padding: 0;
    margin: 0;
    height: 50px;
    position: relative;
}
	
#contact .career_form_wrapper .career_form .form_reset {
    float: left;
    background: #e1e1e1;
    margin-left: 14px;
}
	
#contact .career_form_wrapper .career_form .form_reset p {
    height: 50px;
    position: relative;
    margin: 0;
}
	#contact .career_form_wrapper .career_form .form_reset p input {
    font-size: 15px;
    font-weight: 700;
    background: none;
    padding: 0;
    width: 125px;
    height: 50px;
    border: none;
    outline: none;
    -webkit-appearance: none;
    text-transform: uppercase;
    color: #000;
}

.wpcf7 form .wpcf7-response-output {
    margin: 6em 0.5em 1em;
    padding: 0.2em 1em;
    border: 2px solid #00a0d2;
}

.DirectMarketing input[type=checkbox]{
    display: block;
    float: left;
    margin: 3px 14px 3px 3px;
    width: 19px;
    height: 19px;
}

.DirectMarketing .wpcf7-list-item {
    display: inline-block;
    margin: 0 ;
}

.DirectMarketing span .wpcf7-list-item-label{font-size:16px}

.section_container .section_header span, .section_container .section_intro .career_form_wrapper span {
    font-size: 14px;
    line-height: 20px;
    margin-bottom: 10px;
    float: left;
}
span.wpcf7-list-item-label {
    margin-top: 2px;
}


.wpcf7 form .wpcf7-response-output {
    margin: 6em 0.5em 1em;
    padding: 0.2em 1em;
    border: 2px solid #00a0d2;
    float: left;
}


