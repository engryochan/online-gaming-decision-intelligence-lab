<style>.recentcomments a{display:inline !important;padding:0 !important;margin:0 !important;}</style><style id="wp-custom-css">
/*
 * Start
 * Alternative Investment Management
 */
@media (max-width: 992px) {
	.aim-why-citic-clsa-container{
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
	}
	
	.aim-why-citic-clsa-block{
		padding: 20px 0px 20px 0px;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		justify-content: flex-start;
	}
	
	.aim-why-citic-clsa-block img {
		width: 90px;
		height: auto;
		display: block;
		padding-right: 20px;
	}
}

@media (min-width: 992px) {
	
	.aim-intro {
			display: flex;
	}

	.aim-intro-title{
			padding-right: 50px !important;
			min-width: fit-content;
			border-right: solid 3px #000066;
			align-content: center;
			display:grid !important;
		}

	.aim-intro-content {
			padding-left: 50px;
	}

	.aim-why-citic-clsa-container{
		display: flex;
		flex-wrap: wrap;
		margin-top: 30px;
	}

	.aim-why-citic-clsa-block{
		padding: 20px 30px 20px 0px;
		box-sizing: border-box;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		width: 50%;
	}

	.aim-why-citic-clsa-block img {
		width: 100px;
		height: auto;
		display: block;
		padding-right: 20px;
	}
}

/*
 * End
 * Alternative Investment Management
 */


/*
 * Start
 * FICC
 */
@media (max-width: 992px) {
	.ficc-why-citic-clsa-block {
		text-align: center;
		text-align: -webkit-center;
		box-sizing: border-box;
		padding-bottom: 25px
	}

	.ficc-why-citic-clsa-block img {
		width: 25%;
		height: auto;
		display: block;
		padding-right: 20px;
	}
	
	.ficc-why-citic-clsa-block h3 {
		font-size: 22px !important;
		margin: 8px 0px
	}
}

@media (max-width: 480px) {
	.ficc-why-citic-clsa-block{
			padding-bottom: 20px
	}
	
	.ficc-why-citic-clsa-block h3 {
		font-size: 18px !important;
		margin: 8px 0px
	}	
	
	.ficc-why-citic-clsa-block img {
		width: 40%;
		margin: 10px auto;
		padding-right: 0px;
	}
	
	p.tablink {
		padding-left: 0px;
		padding-right: 20px;
	}
}

@media (min-width: 992px) {
	.ficc-sectors-block img {
		width: 35%;
		height: auto;
		display: block;
		padding-right: 20px;
	}	
	
	.ficc-why-citic-clsa_container{
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 30px;
	}

	.ficc-why-citic-clsa-block{
		width: 50%;
		padding: 20px 30px 20px 0px;
		box-sizing: border-box;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
	}

	.ficc-why-citic-clsa-block img {
		width: 17%;
		height: auto;
		display: block;
		padding-right: 20px;
	}
}

/*
 * End
 * FICC
 */


/*
 * Start
 * Research
 */
.research #markets .section_container {
	margin-bottom: 0px;
}


.research #sectors .section_container {
  margin-top: 0px;	
}

.research #markets .section_container .section_intro {
  margin-bottom: 0px;	
}

.research #sectors .section_container .section_intro {
  margin-top: 0px;	
}

 .research-awards-container{
	  display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
}

	.research-awards-container .research-services-block img{
