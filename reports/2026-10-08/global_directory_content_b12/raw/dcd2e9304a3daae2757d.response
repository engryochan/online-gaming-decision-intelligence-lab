  /* Style the tab links */
  .tablink {
		font-weight:bold;
    float: left;
    border: none;
    outline: none;
    cursor: pointer;
    font-size: 20px !important;
    width: 160px;
  }

  /* Style the tab content */
  .tabcontent {
    display: none;

/*     border: 1px solid #ccc; */
    border-top: none;
  }

  /* Change background color of buttons on hover */
  .tablink:hover {
   color: #000066;
	
  }

  /* Create an active/current tablink class */
  .tablink.active {
    background-color: #000066;
  }

