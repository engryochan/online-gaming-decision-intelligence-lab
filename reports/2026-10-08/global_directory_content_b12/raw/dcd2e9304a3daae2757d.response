		*/

ul#menu-side-navigation-1{
    display: none;
}

.header_contain {
	background:#fff;
	border-top: 6px solid #000066;
	height:83px;
}


.navbar-default .navbar-nav>.active>a, .navbar-default .navbar-nav>.active a:focus, .navbar-default .navbar-nav>.active a:hover {
    color:#000066;
    background: none;
}

.member_login a:hover {
    background: #fff;
	color:#0202b5;
}
header.scroll-nav .header_contain {
    height: 63px;
	background:#fff;
}

.header_contain a {  
    text-transform: capitalize;
	font-size: 17px;
	
}
.navbar-default .navbar-nav>li>a 
{
	
	letter-spacing:0.25px;
	color:#000;
	
}

.header_contain .dropdown-menu {
	background:#fff;
}

.header_contain .dropdown-menu>li>a
{
	color:#000;
transition: none;
}

.header_contain .dropdown-menu>li>a:focus, .header_contain .dropdown-menu>li>a:hover, .header_contain .navbar-default .navbar-nav>.active a>.dropdown-menu>.active a:hover {
   color:#0202b5 !important;
	background:#fff !important;
}

 .header_contain .dropdown-menu>.active>a {
    color: #000 ;
    background: #fff;
}
.navbar-default .navbar-nav>li>a:hover, .navbar-nav-hover-active {
	color:#0202b5 !important ;
	background:#fff !important;
}


.navbar-default .navbar-nav>li>a:focus, .navbar-default .navbar-nav>li>a:hover {
    color: #000;
    background-color: transparent;
}

#menu-side-navigation li.dropdown ul.dropdown-menu li.dropdown ul.dropdown-menu  {
    display:none;
}

		#menu-side-navigation li.dropdown ul.dropdown-menu li.dropdown:hover ul.dropdown-menu  {
    display: block;
}

