#overview .readMore.readMore_left {
    display: flex;
    width: 135px;
    padding: 16px 16px 13px 16px;
    height: 51px;
    background: #fff100;
    color:#000;
}

#overview .readMore:after {
    content: "";
    position: absolute;
    /*right: 87%;*/
    /* top: 85%; */
    overflow: visible;
    width: 12px;
    height: 15%;
    background: #f8f8f8;
    z-index: 99;
    -webkit-transform: skewY(-8deg);
    transform: skewX(-8deg);
    bottom: 0px;
     left: 127px; 
}

#overview .readMore_left a:after { display:none;  }

#overview .readMore_left a {
    color: #333;}

#overview .readMore.readMore_left:hover{
background: #faff00;  }

