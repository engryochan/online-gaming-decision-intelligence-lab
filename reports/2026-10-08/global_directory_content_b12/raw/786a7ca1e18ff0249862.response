<script>
    function changeLanguage(langCode) {
        // Remove language prefix from current path
        let currentPath = window.location.pathname;
        let pathWithoutLang = currentPath;

        // Remove existing language prefix (e.g., /en/, /ar/, etc.)
        const langPattern = /^\/[a-z]{2}(-[A-Z]{2})?\//;
        if (langPattern.test(currentPath)) {
            pathWithoutLang = currentPath.replace(langPattern, '/');
        }

        // Set the clean path as next URL
        document.querySelector('.next-url').value = pathWithoutLang;
        document.querySelector('.language').value = langCode;
        document.querySelector('.language_form').submit();
    }
</script>
