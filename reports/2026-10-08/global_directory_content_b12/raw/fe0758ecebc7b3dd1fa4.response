	<meta itemscope itemprop="mainEntityOfPage" itemtype="https://schema.org/WebPage" itemid="https://www.indexindustry.org/index-industry-association-welcomes-tilt-indices-as-newest-member-2/" content="Index Industry Association welcomes Tilt Indices as newest member" /><meta itemprop="datePublished" content="2026-10-02" /><meta itemprop="dateModified" content="2026-10-02" /><div itemprop="publisher" itemscope itemtype="https://schema.org/Organization"><meta itemprop="name" content="Index Industry Association"></div><div itemscope itemprop="author" itemtype="https://schema.org/Person"><meta itemprop="url" content="https://www.indexindustry.org/author/mgeorgibuttonwoodpr-com/" /><meta itemprop="name" content="Mandy Boyd" /></div><div itemscope itemprop="image" itemtype="https://schema.org/ImageObject"><meta itemprop="url" content="https://www.indexindustry.org/wp-content/uploads/Screenshot-2026-10-02-at-10.02.18-AM.png" /><meta itemprop="width" content="332" /><meta itemprop="height" content="72" /></div><div itemprop="interactionStatistic" itemscope itemtype="https://schema.org/InteractionCounter"><meta itemprop="interactionType" content="https://schema.org/CommentAction" /><meta itemprop="userInteractionCount" content="0" /></div>
