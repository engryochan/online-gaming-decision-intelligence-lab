/** TABLE OF CONTENTS
---------------------------------------------------------------------------/


1.0 - Global Styles
  1.1 - General
  1.2 - Selection Highlight
  1.3 - Buttons
  1.4 - Typography
  1.5 - Custom Font Face

2.0 - Layout + Themer
  2.1 - Header
  2.2 - Navigation
  2.3 - Footer
  2.4 - Courses

3.0 - Page Specific CSS
  3.1 - Homepage
  3.2 - Resource Library
  3.3 - LearnDash
  3.4 - User Registration

4.0 - Admin Branding
  4.1 - Admin Bar
  4.2 - Builder Styles

5.0 - Tablet Only Styles

6.0 - Tablet + Mobile Styles

7.0 - Mobile Only Styles

8.0 - Accessibility Styles


/// END TABLE OF CONTENTS
--------------------------------------------------------------------------*/


/** 1.0 - Global Settings
--------------------------------------------------------------------------*/

/* =========================
   1.1 - General
   ========================= */

:root {
  --clr-primary: #0a406b;
	--clr-primary-rgb: 135 135 135;

	--clr-secondary: #595959;
	--clr-secondary-rgb: 89 89 89;
	
	--clr-accent: #1790d6;
	--clr-accent-rgb: 23 144 214;

	--tr: .2s ease-in-out;

	--bs: 0 5px 10px rgba(0,0,0,.25);
}

*{
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html{
	font-size: 16px;
}

/* Utility Classes */

.wrapcenter {
	text-align: center !important;
}

.centeralign {
	margin: 0 auto;
	display: block;
}

.inlineblock {
     display: inline-block;
}

.flow, .float {
  display: inline-block;
  position: relative;
}

/* Hero Styles */

.hero:not(.home-hero) .fl-row-content-wrap{
	min-height:300px;
}

@media (min-width: 768px) and (max-width: 992px) {
	.hero:not(.home-hero) .fl-row-content-wrap{
		min-height:250px;
	}
}

@media (max-width: 767px) {
	.hero:not(.home-hero) .fl-row-content-wrap{
		min-height:200px;
	}
}

/* Flexbox */

.flex{
	display:flex;
}

.align-bottom{
  display: flex;
  justify-content: center;
  align-items: flex-end;
  flex: 1 1 0;
}

.align-flex-start, .align-flex-start .fl-row-content-wrap, .align-flex-start.fl-row-custom-height.fl-row-align-center .fl-row-content-wrap{
	align-items:flex-start;
	-webkit-align-items:flex-start;
}
.justify-flex-start, .justify-flex-start .fl-row-content-wrap, .justify-flex-start.fl-row-custom-height.fl-row-align-center .fl-row-content-wrap{
	justify-content:flex-start;
	-webkit-justify-content:flex-start;
}
.align-flex-center, .align-flex-center .fl-row-content-wrap, .align-flex-center.fl-row-custom-height.fl-row-align-center .fl-row-content-wrap{
	align-items:center;
	-webkit-align-items:center;
}
.justify-flex-center, .justify-flex-center .fl-row-content-wrap, .justify-flex-center.fl-row-custom-height.fl-row-align-center .fl-row-content-wrap{
	justify-content:center;
	-webkit-justify-content:center;
}
.align-flex-end, .align-flex-end .fl-row-content-wrap, .align-flex-end.fl-row-custom-height.fl-row-align-center .fl-row-content-wrap{
	align-items:flex-end;
	-webkit-align-items:flex-end;
}
.justify-flex-end, .justify-flex-end .fl-row-content-wrap, .justify-flex-end.fl-row-custom-height.fl-row-align-center .fl-row-content-wrap{
	justify-content:flex-end;
	-webkit-justify-content:flex-end;
}


/* Sticky Column for Desktop */
@media (min-width: 993px) {
	.sticky-col{
		position: -webkit-sticky; /* Safari */
		position: sticky;
		top: 125px;
	}
}

/* Fixes margins for when modules pull content from another saved module. */
.fl-builder-module-template {
	margin: 0 !important;
	max-width: 100% !important;
	padding: 0 !important;
}


/* Fixes pixel shifting for row shape layers */
.fl-builder-shape-layer > svg {
    -webkit-backface-visibility: hidden;
   backface-visibility: hidden;
   -ms-perspective: 1000;
   perspective: 1000;
}



/* =========================
   1.2 - Selection Highlight
   ========================= */

::-moz-selection {
  background: var(--clr-primary);
  color: white;
	-webkit-text-fill-color: white;
	text-shadow:none;
}

::selection {
  background: var(--clr-primary);
  color: white;
	-webkit-text-fill-color: white;
	text-shadow:none;
}



/* =========================
   1.3 - Buttons
   ========================= */

button:active, input[type=button]:active, input[type=submit]:active, button:focus, input[type=button]:focus, input[type=submit]:focus,
.fl-builder-content .fl-button:active{
	top:inherit;
}

.ur-button-container button.ur-submit-button {
	border: 1px solid #1790d6  !important;
	border-radius: 0px !important;
	font-weight: 600 !important;
	text-transform: capitalize !important;
	background: #1790d6 !important;
}
.ur-button-container button.ur-submit-button:is(:hover, :focus-visible){
	background: white !important;
	color: #1790d6 !important;
}


/* =========================
   1.4 - Typography
   ========================= */

p:last-child{
	margin-bottom: 0;
}


/* =========================
   1.5 - Custom Font Face
   ========================= */

/* @font-face {
  font-family: "Font Name";
  src:  url("/wp-content/themes/bb-theme-child/fonts/font.woff2") format("woff2"),
        url("/wp-content/themes/bb-theme-child/fonts/font.woff") format("woff");
  font-weight: normal;
} */


/** END Global Settings
--------------------------------------------------------------------------*/



/** 2.0 - Layout + Themer
--------------------------------------------------------------------------*/

/* =========================
   2.1 - Header
   ========================= */

header{
	position:relative;
}

.fl-page-header-wrap {
	box-shadow: 0 10px 25px 0 rgba(0, 0, 0, 0.15);
	z-index:9999;
}


/* Scrolled Header */

.fl-theme-builder-header-scrolled .menu-item span{
	color: #0a406b;
}



/* =========================
   2.2 - Navigation
   ========================= */

.menu-item a{
	transition: var(--tr);
}


#menu-main-menu .menu-item a span{
	position:relative;
}
#menu-main-menu .menu-item a span::after{
  content: '';
	width:100%;
	height:2px;
	background-color:#1790d6;
	position:absolute;
	bottom:-5px;
	left:0;
	transform: scaleX(0);  
  transition: transform 250ms ease-in-out;
	transform-origin:  0% 50%;
}
/* .home #menu-main-menu .menu-item a span::after{
	background-color:white !important;
} */

#menu-main-menu .menu-item:hover > a span::after
{
	transform: scaleX(1);
}

/* 
body.home .fl-theme-builder-header-scrolled #menu-main-menu .menu-item a span::after{
	background-color:#1790d6 !important;
} */



/* =========================
   2.3 - Footer
   ========================= */


/* =========================
   2.4 - Courses
   ========================= */

.single-sfwd-courses .fl-page > header,
.single-sfwd-lessons .fl-page > header,
.single-sfwd-quiz .fl-page > header{
	background: #0a406b
}
.single-sfwd-courses article.sfwd-courses,
.single-sfwd-lessons article.sfwd-lessons,
.single-sfwd-quiz article.sfwd-quiz{
	padding-top: 100px !important;
}

.ld-featured-image--course{
	display: none;
}

.fl-post-meta-bottom{
	display:none;
}

/** END Layout
--------------------------------------------------------------------------*/



/** 3.0 - Page Specific CSS
--------------------------------------------------------------------------*/

/* =========================
   3.1 - Homepage
   ========================= */

/* =========================
   3.2 - Resource Library
   ========================= */
.resource-category-grid ul{
	list-style: none;
	padding-left:0px !important;
	margin-bottom: 20px;
}
.resource-category-grid li{
	margin-bottom:10px;
	border-bottom: 1px solid lightgray;
	padding-bottom: 10px;
}

.wpgb-facet>fieldset:last-child{
	margin-bottom: 0 !important;
}

.resource-category-grid{
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}
.resource-category{
    background: #fafafa;
    padding: 20px;
}
.resource-category h3{
    font-size: 20px;
    margin: 0;
}
.resource-category ul{
    margin-block: 20px;
    padding-left: 20px;
}
.view-all-resources{
    color: var(--clr-primary) !important;
    background: transparent;
    border: 1px solid var(--clr-primary);
    color: white;
    padding: 5px 20px;
    border-radius: 100vw;
    display: inline-block;
    margin-block: 10px;
    transition: var(--tr);
}
.view-all-resources:is(:hover, :focus-visible){
    color: white !important;
    background: var(--clr-primary);
}

/* =========================
   3.3 - LearnDash
   ========================= */
.page-id-1438 header{
	background: var(--clr-primary)
}
.page-id-1438 .fl-post-header{
	display:none;
}
.page-id-1438 .fl-post-content{
	margin-top: 100px;
	padding-block: 80px;
}

.ld-enrollment__join .ld-enrollment__login{
	display: none;
}

/* =========================
   3.4 - User Registration
   ========================= */

#user-registration,
.user-registration.ur-frontend-form{
	margin-inline: auto !important;
}

body.user-registration-page #user-registration:not(.user-registration-MyAccount) .ur-frontend-form .user-registration-form .ur-form-row .ur-form-grid>div .user-registration-Button,
body.user-registration-page .user-registration:not(.user-registration-MyAccount) .ur-frontend-form .user-registration-form .ur-form-row .ur-form-grid>div .user-registration-Button {
	background-color: #1790d6 !important;
	color: white !important;
	border: none !important;
	font-weight: 600;
}
body.user-registration-page #user-registration:not(.user-registration-MyAccount) .ur-frontend-form .user-registration-form .ur-form-row .ur-form-grid>div .user-registration-Button:is(:hover, :focus-visible),
body.user-registration-page .user-registration:not(.user-registration-MyAccount) .ur-frontend-form .user-registration-form .ur-form-row .ur-form-grid>div .user-registration-Button:is(:hover, :focus-visible){
	border: none;
	background-color: var(--clr-primary) !important;
}

#user-registration.vertical .user-registration-MyAccount-navigation ul .user-registration-MyAccount-navigation-link a{
	display: flex !important;
	padding: 12px !important;
}

/* Hide top contributor option from profile */
[data-ref-id="user_registration_check_box_1756142115"]{
	display: none;
}

/* Directory */
body .user-registration-frontend-listing-container .ur-frontend-user-listings .ur-frontend-user-list{
	min-height: 200px;
	text-align: center;
}
.ur-advance-filter.ur-frontend-advance-filter-open{
	display: none !important;
}
.ur-advance-filter.ur-frontend-advance-filter-open.text-updated{
	display: inline-flex !important;
}


.ur-list-display-name,
.badges .badge{
	font-size: 14px;
	padding: .15em 1em;
	background: var(--clr-primary);
	color: white !important; 
	border-radius: 100vw;
	margin-bottom: 1em;
	text-align: center;
}
.user-registration-frontend-listing-container .ur-search-field .button,
.user-registration-frontend-listing-container .frontend-listing-title-settings .ur-advance-setting-container .ur-advance-setting-button .btn-primary{
	background-color: var(--clr-accent) !important;
	border: none;
	transition: var(--tr);
	color: white;
	border-radius: 0 !important;
	font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
	padding: 10px 30px !important;
	font-weight: 600;
	font-size: 16px !important;
	line-height: inherit !important;
}
.user-registration-frontend-listing-container .ur-search-field .button:is(:hover, :focus-visible),
.user-registration-frontend-listing-container .frontend-listing-title-settings .ur-advance-setting-container .ur-advance-setting-button .btn-primary:is(:hover, :focus-visible){
	background-color: var(--clr-primary) !important;
	border: none;
	color: white !important;
}
.ur-frontend-listing-sort-by{
	display: none;
}

body .user-registration-frontend-listing-container .ur-frontend-user-listings .ur-frontend-user-list .btn-view-details{
	background: none;
	border: 1px solid var(--clr-accent);
	border-radius: 0;
	color: var(--clr-accent);
	width: max-content;
	padding: .5em 1em;
	transition: var(--tr);
}
body .user-registration-frontend-listing-container .ur-frontend-user-listings .ur-frontend-user-list .btn-view-details:is(
:hover, :focus-visible){
	background: var(--clr-accent);
	text-decoration: none;
}

.ur-list-display-name:empty{
	display: none !important;
}

/* Profile */
.ur-detail-wrapper{
	display: flex;
	flex-wrap: wrap;
	gap: 100px;
}
.ur-user-details-container .ur-detail-image{
	text-align: center;
}
body .ur-user-details-container .ur-info-wrap{
	margin-top: 0;
	width: calc(100% - 310px)
}
.ur-user-details-container{
	min-width: 100% !important;
}
@media(max-width: 850px){
	body .ur-detail-wrapper{
		align-items: center;
		flex-direction: column;
		padding: 40px !important;
	}
	body .ur-user-details-container .ur-info-wrap{
		width: 100%;
	}
}
.ur-user-details-container .ur-info-wrap table tr{
	padding-left: 0 !important;
}
.ur-user-details-container .ur-info-wrap h2{
	font-size: 24px;
	font-weight: 500;
	color: #2D3559;
	margin-left: 0px;
	margin-bottom: 16px;
	margin-top: 0;
}
.ur-user-details-container .badges .badge{
	display: block;
	margin-block: 1em;
}

.ur-user-details-container .ur-detail-wrapper .ur-detail-image{
	height: unset !important;
	border: none !important;
}
.ur-user-details-container .ur-detail-wrapper .ur-detail-image img{
	height: 150px !important;
	border-color: darkgray !important;
}

.ur-user-details-container .ur-info-wrap table tr{
	background: transparent !important;
}

/** END Page Specific CSS
--------------------------------------------------------------------------*/



/** 4.0 - Admin Branding
--------------------------------------------------------------------------*/

/* =========================
   4.1 - Admin Bar
   ========================= */

#wpadminbar{
	background-color: var(--clr-primary);
	box-shadow: 0 3px 5px rgba(0,0,0,.2);
}

#wpadminbar .menupop .ab-sub-wrapper, #wpadminbar .shortlink-input{
	background-color: var(--clr-secondary);
}

#wpadminbar .ab-top-menu>li.hover>.ab-item, #wpadminbar.nojq .quicklinks .ab-top-menu>li>.ab-item:focus, #wpadminbar:not(.mobile) .ab-top-menu>li:hover>.ab-item, #wpadminbar:not(.mobile) .ab-top-menu>li>.ab-item:focus{
	background-color: var(--clr-secondary);
}

#wp-admin-bar-wp-logo, #wp-admin-bar-rank-math, #wpadminbar #wp-admin-bar-site-name>.ab-item:before{
	display:none;
}

li#wp-admin-bar-wlcms-admin-logo img {
    max-width: 30px;
}



/* =========================
   4.2 - Builder Styles
   ========================= */

.fl-builder-bar-title-icon, #fl-builder-toggle-notifications{
	display:none;
}

.fl-builder-bar-title-area{
	padding: 4px 4px 4px 15px;
}

/** END Admin Branding
--------------------------------------------------------------------------*/


/** 5.0 - Tablet Only Styles
--------------------------------------------------------------------------*/

@media (min-width: 768px) and (max-width: 992px) {
	.tabletcenter{
		text-align: center !important;
		float:none !important;
	}
}

/** 6.0 - Tablet + Mobile Styles
--------------------------------------------------------------------------*/

@media (max-width: 992px) {
	/* For reverse tablet, must add tablet_reversed class to ROW */
	.tablet_reversed .fl-col-group.fl-col-group-responsive-reversed {
    display: -moz-flex;
    display: flex;
    flex-flow: row wrap;
    -ms-box-orient: horizontal;
  }
  .tablet_reversed .fl-col-group-responsive-reversed .fl-col:nth-of-type(1) {
    order: 12;
  }
}

/** 7.0 - Mobile Only Styles
--------------------------------------------------------------------------*/

@media (max-width: 767px) {
	.mobilecenter{
		text-align: center !important;
		float:none !important;
	}
	
	.resource-category-grid{
		grid-template-columns: 1fr;
	}
}

/** 8.0 - Accessibility Styles
--------------------------------------------------------------------------*/

/* Reduce Motion */
@media(prefers-reduced-motion: reduce){
	*,
	*::before,
	*::after{
		-webkit-animation-duration:.01ms !important;
		        animation-duration:.01ms !important;
		-webkit-animation-delay:.01ms !important;
		        animation-delay:.01ms !important;
		-webkit-animation-iteration-count:1 !important;
		        animation-iteration-count:1 !important;
		scroll-behavior: auto !important;
		transition-delay:.01ms !important;
		transition-duration:.01ms !important;
	}
}
/**Advocacy / Tab
--------------------------------------------------------------------------**/



.fl-builder-content-356 .fl-node-rn1pmh0bvjks .pp-tabs-vertical.pp-tabs-style-7 .pp-tabs-label .pp-tab-label-inner {
    padding: 10px;
}

/**Insights / All Insights
--------------------------------------------------------------------------**/
.hide-wpgb-label .wpgb-facet-title{
	font-size: 15px !important;
text-transform: uppercase;
margin-bottom: 10px !important;
}

/*NAV DROPDOWN
--------------------------------------------------------------------------**/

.pp-advanced-menu .pp-menu-toggle {
	right: -12px !important;
	top: 1px
}

