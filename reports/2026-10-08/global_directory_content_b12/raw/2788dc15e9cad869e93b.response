\"638\",\"static/chunks/638-d73242ec813555d9.js\",\"426\",\"static/chunks/426-73c23caf66f7c65c.js\",\"243\",\"static/chunks/app/%5Blang%5D/%5B%5B...slug%5D%5D/page-0a917f9da9421ffe.js\"],\"\"]\n21:I[32,[\"610\",\"static/chunks/610-cb403da6fa073148.js\",\"175\",\"static/chunks/175-d3c5090a1f6e0f16.js\",\"307\",\"static/chunks/307-9c119218d0998069.js\",\"388\",\"static/chunks/388-a85d3f4aaf3b9b7d.js\",\"575\",\"static/chunks/575-173e69f05de2e0cf.js\",\"638\",\"static/chunks/638-d73242ec813555d9.js\",\"426\",\"static/chunks/426-73c23caf66f7c65c.js\",\"243\",\"static/chunks/app/%5Blang%5D/%5B%5B...slug%5D%5D/page-0a917f9da9421ffe.js\"],\"HeroParagraph\"]\n22:I[4072,[\"610\",\"static/chunks/610-cb403da6fa073148.js\",\"175\",\"static/chunks/175-d3c5090a1f6e0f16.js\",\"307\",\"static/chunks/307-9c119218d0998069.js\",\"388\",\"static/chunks/388-a85d3f4aaf3b9b7d.js\",\"575\",\"static/chunks/575-173e69f05de2e0cf.js\",\"638\",\"static/chunks/638-d73242ec813555d9.js\",\"426\",\"static/chunks/426-73c23caf66f7c65c.js\",\"243\",\"static/chunks/app/%5Blang%5D/%5B%5B...slug%5D%5D/page-0a917f9da9421ffe.js\"],\"default\"]\n20:Te19,"])</script><script>self.__next_f.push([1,"\u003ch1\u003eIssuer Services\u003c/h1\u003e\u003ch3\u003eSovereign debt issuance and management\u003c/h3\u003e\u003cp\u003eMTS Issuer Services offers an extensive suite of tools and platforms including Treasury Operations and the Primary Auction Facilities. Our solutions are designed to support sovereign debt managers and primary dealers across Europe and beyond, ensuring the efficient, transparent, and secure execution of debt issuance and management activities.\u003c/p\u003e\u003ch4\u003eTreasury Operations (TRS)\u003c/h4\u003e\u003cp\u003eTreasury Operations (TRS) is a specialised market facility tailored for Debt Management Offices (DMOs) to conduct Taps, Buybacks, and Switch Auctions.\u003c/p\u003e\u003cp\u003eKey features:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eElectronic execution of firm prices\u003c/strong\u003e: Facilitates swift and accurate transactions.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eShared Technology\u003c/strong\u003e: Operates on the same technology as DMO-designated MTS Cash order books.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eCustomisable set-up\u003c/strong\u003e: Allows for system configuration based on unique client requirements.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eExtensive network:\u003c/strong\u003e Broad and diverse range of market participants\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eFull STP and automated settlement\u003c/strong\u003e: Sends\u0026nbsp; settlement instructions to\u0026nbsp;Central Securities Depositories (CSD) for seamless processing.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eOur offering currently covers:\u003c/p\u003e\u003cul\u003e\u003cli\u003eItalian Taps, Buybacks, and Switch Auctions\u003c/li\u003e\u003cli\u003eDutch Taps\u003c/li\u003e\u003cli\u003eCzech Taps, Buybacks, and Switch Auctions\u003c/li\u003e\u003cli\u003eBelgium Buybacks\u003c/li\u003e\u003cli\u003eDanish Buybacks\u003c/li\u003e\u003c/ul\u003e\u003ch4\u003e\u0026nbsp;\u003c/h4\u003e\u003ch4\u003ePrimary Auction Facility (PAF)\u003c/h4\u003e\u003cp\u003eThe Primary Auction Facility (PAF) is engineered for the efficient issuance of debt via primary auctions. The MTS Primary Auction System includes:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eSingle price auctions\u003c/strong\u003e: Simplifies pricing strategies.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eNormal or reverse auctions\u003c/strong\u003e: Offers flexibility in auction types.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003ePricing/matching in price or yield\u003c/strong\u003e: Applicable for both coupon and zero-coupon bonds.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eSimultaneous multiple auctions\u003c/strong\u003e: Supports concurrent auctions, enhancing operational efficiency.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eThe auction process is structured into distinct market phases, providing comprehensive historical data tailored to user profiles such as DMOs and Primary Dealers. This data includes:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003eAuction summaries\u003c/strong\u003e: Detailed breakdowns of auction results.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eDemand curve simulation\u003c/strong\u003e: Analytical tools to model market demand.\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eBidding data\u003c/strong\u003e: Full access to bids, with capabilities for members/issuers to amend or delete bids.\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003ch4\u003eDMO Reporting\u003c/h4\u003e\u003cp\u003e\u003cstrong\u003eAdded-value analytics for issuers and dealers\u003c/strong\u003e\u003c/p\u003e\u003cp\u003eMTS has been designated by a wide group Sovereign Debt Managers across Europe and beyond to provide the electronic trading platform on which Primary Dealers are expected to support secondary market liquidity of public debt instruments. As part of its service, MTS provides DMOs and Primary Dealers all the data and reporting information, tailored to the specific requirements of each market and in the desired format.\u003c/p\u003e\u003cp\u003eDMOs receive quoting and trading information by single instrument, allowing them to produce their Primary Dealer ranking based on their evaluation methodology for Primary Dealers performance. Where required, MTS can also conduct this evaluation on the DMO’s behalf.\u003c/p\u003e\u003cp\u003eMTS delivers monthly reports summarising trading activity by instrument for each Primary Dealer (PD).\u003c/p\u003e\u003cp\u003eIndividual participants can monitor their own trading activity on a dedicated webpage.\u003c/p\u003e"])</script><script>self.__next_f.push([1,"a:[[\"$\",\"section\",null,{\"className\":