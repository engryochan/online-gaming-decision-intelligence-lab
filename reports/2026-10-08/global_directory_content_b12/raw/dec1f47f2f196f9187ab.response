852f-6b17ab5e5c2d","name":"cms-component-raw-html","props":{"slots":{},"html":"<footer class=\"footer\" style=\"\">\n  <div style=\"background-color:#e3e0de;\"><br />\n    <ul class=\"list-inline-separated text-center\">\n      <li>\n        <a\n          rel=\"noopener noreferrer\"\n          href=\"/terms-and-conditions\"\n          target=\"_blank\"\n          >Terms And Conditions<\/a\n        >\n      <\/li>\n      <li>\n        <a rel=\"noopener noreferrer\" href=\"/privacy-policy\" target=\"_blank\"\n          >Privacy Policy<\/a\n        >\n      <\/li>\n      <li><a id=\"do-not-sell\">Do Not Sell My Personal Information<\/a><\/li>\n      <li>\n        <a rel=\"noopener noreferrer\" href=\"/disclaimer\" target=\"_blank\"\n          >Global OTC Disclaimer<\/a\n        >\n      <\/li>\n      <li>\n        <a\n          rel=\"noopener noreferrer\"\n          target=\"_blank\"\n          href=\"/important-legal-disclaimer\"\n          >Important Legal Disclaimer<\/a\n        >\n      <\/li>\n\n <li><a href=\"/subscriptions\" alt=\"Subscriptions\">Subscriptions<\/a><\/li><\/ul><br />\n  <\/div>\n<\/footer>\n\n<script>\n  (function() {\n    const link = document.querySelector('#do-not-sell');\n    if (link) {\n      link.addEventListener('click', (e) => {\n        e.preventDefault();\n        window.OneTrust.ToggleInfoDisplay()\n      });\n    }\n  })();\n<\/script>"}}]},"initializeComponents":false,"siteName":"globalotc"},"meta":{"snippets":[]}}],"alertContent":[{"id":"5b5633f5-544d-462f-a078-ec608078b51c","name":"cms-template-partial","props":{"slots":{"body":[]},"initializeComponents":false,"siteName":"globalotc"},"meta":{"snippets":[]}}]},"footerUrl":"/footer","headerUrl":"/header","widePageContent":false}}],"adhoc-styles":[{"id":"3fa73e06-de12-4a83-94da-846b468064cf","name":"cms-template-partial","props":{"slots":{"body":[{"id":"41dc10bf-0bcf-48d0-98b8-ce65d6adebac","name":"cms-component-adhoc-styles","props":{"slots":{}}}]},"initializeComponents":false,"site