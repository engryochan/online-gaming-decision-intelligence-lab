          <option value="" disabled="" selected="" hidden="">Select</option>
          <option value="1">Under 500 Securities</option>
          <option value="10500">Up to 2,500 Securities</option>
          <option value="21000">Up to 5,000 Securities</option>
          <option value="42000">Up to 10,000 Securities</option>
          <option value="63000">Up to 20,000 Securities</option>
          <option value="94500">Up to 30,000 Securities</option>
          <option value="126000">Up to 40,000 Securities</option>
          <option value="136500">Greater Than 40,000 Securities</option>
        </select>
