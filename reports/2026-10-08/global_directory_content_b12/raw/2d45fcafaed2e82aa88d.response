          <option value="" disabled="" selected="" hidden="">Select</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3</option>
          <option value="4">4 or more</option>
        </select>
      </div>

      <div class="fee-field">
        <label for="feeRegions">Number of Regions</label>
