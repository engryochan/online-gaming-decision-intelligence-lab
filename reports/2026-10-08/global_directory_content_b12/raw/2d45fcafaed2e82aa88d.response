  </div>
</div>

<!-- ══ END USER FEE ESTIMATOR MODAL ══════════════════════ -->
<div class="modal-overlay" id="feeModal">
  <div class="modal fee-modal" role="dialog" aria-modal="true" aria-labelledby="feeModalTitle">
