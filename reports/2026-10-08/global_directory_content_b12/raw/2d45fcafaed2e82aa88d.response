  <style>
    .lf-section { max-width: 900px; margin: 0 auto; padding: 56px 24px; }
    .lf-section + .lf-section { border-top: 1px solid var(--neutral-100); }
    .lf-section-title { font-size: 26px; font-weight: 800; color: var(--navy-900); letter-spacing: -0.015em; margin-bottom: 20px; text-align: center;}
    .lf-body { font-size: 15px; color: var(--neutral-600); line-height: 1.7; margin-bottom: 16px; }
    .lf-body strong { color: var(--neutral-800); }
    .lf-subhead { font-size: 15px; font-weight: 700; color: var(--neutral-950); margin: 24px 0 10px; }

    /* FAQ accordion */
    .faq-list { border-top: 1px solid var(--neutral-200); margin-top: 8px; }
    .faq-item { border-bottom: 1px solid var(--neutral-200); }
    .faq-q { width: 100%; border: 0; background: transparent; display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 18px 4px; cursor: pointer; text-decoration: none; text-align: left; }
    .faq-q-text { font-size: 15px; font-weight: 600; color: var(--neutral-950); line-height: 1.4; }
    .faq-chevron { transition: transform 0.2s ease; flex-shrink: 0; color: var(--neutral-400); margin-top: 1px; }
    .faq-item.open .faq-chevron { transform: rotate(180deg); }
    .faq-body { padding: 0 4px 20px; }
    .faq-item.open .faq-body { display: block; }
    .faq-a { padding: 0 4px 20px; }
    .faq-a p { font-size: 14px; color: var(--neutral-600); line-height: 1.7; margin-bottom: 12px; }
    .faq-a p:last-child { margin-bottom: 0; }

    /* License structure examples */
    .lf-example { display: flex; gap: 14px; margin-bottom: 16px; }
    .lf-example-num { font-size: 13px; font-weight: 700; color: var(--blue-500); flex-shrink: 0; width: 20px; }
    .lf-example p { font-size: 14px; color: var(--neutral-700); line-height: 1.65; margin-bottom: 8px; }
    .lf-example p:last-child { margin-bottom: 0; }
     body {
      background: none !important;
    }
  </style>
</head>
