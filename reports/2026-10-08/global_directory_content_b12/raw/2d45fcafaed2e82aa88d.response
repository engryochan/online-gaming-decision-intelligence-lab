          <option value="" disabled="" selected="" hidden="">Select</option>
          <option value="1">1</option>
          <option value="2">2</option>
          <option value="3">3 or more</option>
        </select>
      </div>

      <div class="fee-field">
        <label for="feeDiscount"><span class="fee-optional-tag">Optional</span> Firm / Discount Type</label>
        <select id="feeDiscount">
          <option value="none">None</option>
          <option value="100_7" data-tiers="large">Academic</option>
          <option value="equity_12" data-tiers="large">Equity Only</option>
          <option value="50_6" data-tiers="large">Government/Regulator</option>
          <option value="50_9" data-tiers="large">Limited Asset Class</option>
          <option value="90_11" data-tiers="all">Micro AUM</option>
          <option value="75_1" data-tiers="large">Non-Financial Research</option>
          <option value="00_0" data-tiers="large">Regulatory Reporting Use Only</option>
          <option value="50_4" data-tiers="large">Small Asset Manager</option>
          <option value="50_8" data-tiers="large">University Endowment</option>
          <option value="50_3" data-tiers="large">U.S. Only Mid-sized Bank</option>
          <option value="30_5" data-tiers="large">U.S. Only Regional Broker-Dealer</option>
          <option value="90_2" data-tiers="all">U.S. Only Small Bank</option>
          <option value="100_10" data-tiers="large">U.S. Only Wealth Manager</option>
        </select>
      </div>

      <div class="fee-result">
        <span class="fee-result-label">Total $U.S.</span>
        <span class="fee-result-value" id="feeTotal">—</span>
      </div>

      <p class="fee-discount-desc" id="feeDiscountDesc"></p>

      <p class="fee-note-bottom" style="margin-top:18px;">*Does not apply to Authorized Data Vendors</p>
      <p class="fee-note-bottom">*Note: To ensure compliance, all end-user customers undergo annual affirmations of use or usage reviews to validate their usage, fees and any applied discounts, ensuring they are appropriate.</p>
    </div>
    <div class="modal-footer">
      <button type="button" class="fee-reset-link" id="feeReset">Reset</button>
    </div>
  </div>
</div>



