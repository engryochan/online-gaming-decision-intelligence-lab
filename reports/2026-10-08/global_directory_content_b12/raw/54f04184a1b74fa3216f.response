</div>

        
    


        </div>
    
        <span class="cc-separator"></span>
        <div id="content_main_columnControlColumn_9" class="cc-column">
            




    
        
        
            
            
            
            
            <div class="M-IMG-RW-DEV O-SMARTSPCGEN-DEV">
    <div id="content_main_image_10" class="smart-image">
        
            
            <figure class="smart-image-figure">
                
    
    
    <picture id="content_main_image_11">
        
        
        
        <source srcset="/content/dam/hsbc/hk/images/mass/cyber-security/screenshots/sms-3-en-pwsimg-3393.jpg 1x" media="(min-width: 960px)"/>
