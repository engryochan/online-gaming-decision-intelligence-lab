.com/wp-content/uploads/2025/11/ChatGPT_Image_Nov_25__2025__01_18_52_PM-removebg-preview.png?v=1764094762\",\"alt\":\"\",\"width\":96,\"height\":96,\"className\":\"callout-grid-module-scss-module__sL0P2G__icon\",\"priority\":false,\"sizes\":\"96px\",\"quality\":100}],[\"$\",\"h3\",null,{\"className\":\"callout-grid-module-scss-module__sL0P2G__heading heading4\",\"children\":\"Gain the Edge\"}],[\"$\",\"div\",null,{\"className\":\"callout-grid-module-scss-module__sL0P2G__desc body-m\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eLeverage data and expertise for long-term advantage.\u003c/span\u003e\u003c/p\u003e\\n\"}}]]}]}],[\"$\",\"div\",\"2\",{\"className\":\"callout-grid-module-scss-module__sL0P2G__item\",\"children\":[\"$\",\"div\",null,{\"className\":\"callout-grid-module-scss-module__sL0P2G__inner\",\"children\":[[\"$\",\"$L22\",null,{\"src\":\"https://www.xpansiv.com/wp-content/uploads/2025/10/icon2.png?v=1761571187\",\"alt\":\"\",\"width\":96,\"height\":96,\"className\":\"callout-grid-module-scss-module__sL0P2G__icon\",\"priority\":false,\"sizes\":\"96px\",\"quality\":100}],[\"$\",\"h3\",null,{\"className\":\"callout-grid-module-scss-module__sL0P2G__heading heading4\",\"children\":\"Work with the Leader\"}],[\"$\",\"div\",null,{\"className\":\"callout-grid-module-scss-module__sL0P2G__desc body-m\",\"dangerouslySetInnerHTML\":{\"__html\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eCapture the Opportunity\u003c/span\u003e\u003c/p\u003e\\n\"}}]]}]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"27:[\"$\",\"$L2e\",\"2\",{\"data\":{\"__typename\":\"PageBuilderBlocksAccordion5050Layout\",\"sectionId\":null,\"text\":{\"description\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eXpansiv’s pioneering teams and technology deliver trading solutions and intelligence that help you better understand the market and capture opportunities.\u003c/span\u003e\u003c/p\u003e\\n\",\"eyebrow\":null,\"hasBreadcrumbs\":false,\"heading\":\"Explore the Solution\",\"headingTag\":[\"h2\"],\"button1\":{\"variant\":[\"primary\"],\"link\":null},\"button2\":{\"variant\":[\"secondary\"],\"link\":null},\"button3\":{\"variant\":[\"link\"],\"link\":null}},\"variant\":{\"variantOptions\":[\"light-primary\"]},\"accordionItems\":[{\"heading\":\"Trade energy and environmental commodities efficiently.\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eTransact RECs, carbon, power, clean fuel credits and more through electronic and voice access, with transparent pricing and reliable settlement.\u003c/span\u003e\u003c/p\u003e\\n\u003cp\u003eOfferings: CBL®, Evolution Markets®, Xpansiv® Data™\u003c/p\u003e\\n\"},{\"heading\":\"Gain price intelligence that drives confidence.\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eAccess transaction-based, real-time and historical market pricing to understand trends, value positions and capture opportunities.\u003c/span\u003e\u003c/p\u003e\\n\u003cp\u003eOfferings: Xpansiv® Data™, Evolution Markets, Xpansiv® Power™\u003c/p\u003e\\n\"},{\"heading\":\"Manage multi-registry portfolios with ease.\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eTrack, manage and trade across markets and registries – all from a single screen.\u003c/span\u003e\u003c/p\u003e\\n\u003cp\u003e\u003cspan style=\\\"font-weight: 400;\\\"\u003eOfferings: Xpansiv® Connect™, CBL, Xpansiv® Registries™ (NAR™, TIGR™, Xpansiv I-REC)\u003c/span\u003e\u003c/p\u003e\\n\"}],\"image\":{\"node\":{\"altText\":\"\",\"sourceUrl\":\"https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Traders_02.png?v=1764094928\",\"slug\":\"xp_traders_02\",\"srcSet\":\"https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Traders_02-300x300.png?v=1764094928 300w, https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Traders_02-150x150.png?v=1764094928 150w, https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Traders_02.png?v=1764094928 600w\",\"modified\":\"2025-11-25T18:22:08\",\"mediaDetails\":{\"height\":600,\"width\":600},\"mimeType\":\"image/png\",\"mediaItemUrl\":\"https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Traders_02.png?v=1764094928\"}},\"imageOnLeft\":false,\"cardContent\":null}}]\n"])</script><script>self.__next_f.push([1,"28:[\"$\",\"$L2e\",\"3\",{\"data\":{\"__typename\":\"PageBuilderBlocksAccordion5050Layout\",\"sectionId\":null,\"text\":{\"description\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eTraders, brokers and other market participants have relied on Xpansiv and our ecosystem for 25 years.\u003c/span\u003e\u003c/p\u003e\\n\",\"eyebrow\":null,\"hasBreadcrumbs\":false,\"heading\":\"Built for Traders \u0026 Brokers\",\"headingTag\":[\"h2\"],\"button1\":{\"variant\":[\"primary\"],\"link\":null},\"button2\":{\"variant\":[\"secondary\"],\"link\":null},\"button3\":{\"variant\":[\"link\"],\"link\":null}},\"variant\":{\"variantOptions\":[\"light-primary\"]},\"accordionItems\":[{\"heading\":\"Unmatched leadership and expertise\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eEvolution Markets has been a leader in global carbon since the inception of cap-and-trade systems. CBL has offered breakthrough innovations like the Global Emissions Offset™ (GEO®) standardized contract and more recently the CBL GEO CORSIA CP1 and ICVCM CCP® standardized contracts. Across renewable energy, carbon, power and fuel, our market knowledge, product innovation and relationships equip customers to thrive in unpredictable markets.\u003c/span\u003e\u003c/p\u003e\\n\"},{\"heading\":\"Unique pricing intelligence\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eBuilt on verified transaction and order data from CBL and Evolution Markets, Xpansiv Data provides invaluable insights, spanning real-time to historical data. The solution covers both environmental and energy markets for a comprehensive view of pricing, liquidity and trends.\u003c/span\u003e\u003c/p\u003e\\n\"},{\"heading\":\"Exceptional product access\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003eIn addition to standardized contracts, Xpansiv customers can find and transact a vast range of project-specific credits, filtered by project type, registry, vintage, region and country. Whether you’re seeking voluntary or compliance RECs from a specific country or U.S. state, carbon credits with a particular profile, compliance or voluntary clean fuel certificates or another instrument, you can rely on Xpansiv to help you meet your objectives.\u003c/p\u003e\\n\"},{\"heading\":\"Streamlining the complete commodity lifecycle\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eXpansiv offers tools and support every step of the way – from research and price intelligence to transacting, tracking and reporting. You can even settle OTC transactions via CBL’s post-trade settlement mechanism, enabling trades with hundreds of qualified exchange participants without bilateral agreements.\u003c/span\u003e\u003c/p\u003e\\n\"}],\"image\":{\"node\":{\"altText\":\"\",\"sourceUrl\":\"https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Registries_Hero-1.jpg?v=1763493015\",\"slug\":\"xp_registries_hero-1\",\"srcSet\":\"https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Registries_Hero-1-300x300.jpg?v=1763493015 300w, https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Registries_Hero-1-1024x1024.jpg?v=1763493015 1024w, https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Registries_Hero-1-150x150.jpg?v=1763493015 150w, https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Registries_Hero-1-768x768.jpg?v=1763493015 768w, https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Registries_Hero-1.jpg?v=1763493015 1034w\",\"modified\":\"2025-11-18T19:10:15\",\"mediaDetails\":{\"height\":1034,\"width\":1034},\"mimeType\":\"image/jpeg\",\"mediaItemUrl\":\"https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Registries_Hero-1.jpg?v=1763493015\"}},\"imageOnLeft\":true,\"cardContent\":null}}]\n"])</script><script>self.__next_f.push([1,"29:[\"$\",\"$L2f\",\"4\",{\"imageData\":{\"__typename\":\"PageBuilderBlocksModule5050Layout\",\"sectionId\":null,\"text\":{\"description\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eTake advantage of our complete platform to help you execute profitably and operate efficiently.\u003c/span\u003e\u003c/p\u003e\\n\",\"eyebrow\":null,\"hasBreadcrumbs\":false,\"heading\":\"Learn more about the Xpansiv toolkit for traders and brokers\",\"headingTag\":[\"h2\"],\"button1\":{\"variant\":[\"primary\"],\"link\":null},\"button2\":{\"variant\":[\"secondary\"],\"link\":null},\"button3\":{\"variant\":[\"link\"],\"link\":null}},\"variant\":{\"variantOptions\":[\"light-secondary\"]},\"items\":null,\"image\":{\"node\":{\"altText\":\"\",\"sourceUrl\":\"https://www.xpansiv.com/wp-content/uploads/2026/07/XP_Platform_Overview_R8_Mobile_Square.png?v=1785147450\",\"slug\":\"xp_platform_overview_r8_mobile_square\",\"srcSet\":\"https://www.xpansiv.com/wp-content/uploads/2026/07/XP_Platform_Overview_R8_Mobile_Square-300x300.png?v=1785147450 300w, https://www.xpansiv.com/wp-content/uploads/2026/07/XP_Platform_Overview_R8_Mobile_Square-1024x1024.png?v=1785147450 1024w, https://www.xpansiv.com/wp-content/uploads/2026/07/XP_Platform_Overview_R8_Mobile_Square-150x150.png?v=1785147450 150w, https://www.xpansiv.com/wp-content/uploads/2026/07/XP_Platform_Overview_R8_Mobile_Square-768x768.png?v=1785147450 768w, https://www.xpansiv.com/wp-content/uploads/2026/07/XP_Platform_Overview_R8_Mobile_Square-1536x1536.png?v=1785147450 1536w, https://www.xpansiv.com/wp-content/uploads/2026/07/XP_Platform_Overview_R8_Mobile_Square-2048x2048.png?v=1785147450 2048w, https://www.xpansiv.com/wp-content/uploads/2026/07/XP_Platform_Overview_R8_Mobile_Square-1200x1200.png?v=1785147450 1200w, ht