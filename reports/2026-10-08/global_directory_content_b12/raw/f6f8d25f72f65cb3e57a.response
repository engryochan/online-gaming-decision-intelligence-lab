        <div id="tabs-e9dfcb3ea0-item-7e0349ce49-tabpanel" role="tabpanel" aria-labelledby="tabs-e9dfcb3ea0-item-7e0349ce49-tab" tabindex="-1" class="cmp-tabs__tabpanel cmp-tabs__tabpanel--active" data-cmp-hook-tabs="tabpanel" data-cmp-data-layer="{&#34;tabs-e9dfcb3ea0-item-7e0349ce49&#34;:{&#34;@type&#34;:&#34;core/wcm/components/tabs/v1/tabs/item&#34;,&#34;dc:title&#34;:&#34;Asset management and investment&#34;}}">
