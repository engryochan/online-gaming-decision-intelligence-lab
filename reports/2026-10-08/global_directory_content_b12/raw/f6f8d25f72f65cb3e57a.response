            <span class="tabs-tab-text">Bank underwriting</span>
        </div>
        <div id="tabs-e9dfcb3ea0-item-c88ccd239e-tabpanel" role="tabpanel" aria-labelledby="tabs-e9dfcb3ea0-item-c88ccd239e-tab" tabindex="-1" class="cmp-tabs__tabpanel" data-cmp-hook-tabs="tabpanel" data-cmp-data-layer="{&#34;tabs-e9dfcb3ea0-item-c88ccd239e&#34;:{&#34;@type&#34;:&#34;core/wcm/components/tabs/v1/tabs/item&#34;,&#34;dc:title&#34;:&#34;Bank underwriting&#34;}}">
