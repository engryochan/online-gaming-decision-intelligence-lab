</div>
<div class="card-insight aem-GridColumn aem-GridColumn--default--12">

    
    <div class="insight  variation-article">
        
        <div class="card-header">
            <div class="card-insight-image-wrapper">
                
    
    
        
            
                <div data-linktarget="_self" data-classname="img-cover card-insight-image" class="responsive-image" data-wcmdisabled data-mode="smartcrop" data-contenturl="https://s7d1.scene7.com/is/content/" data-videoserver="https://s7d1.scene7.com/is/content/" data-imageserver="https://s7d1.scene7.com/is/image/" data-viewer-path="https://s7d1.scene7.com/s7viewers/" data-asset-type="image" data-asset-name="increase-confidence-in-your-investment-decisions-with-third-party-data.jpg" data-asset-path="moodyscorp/increase-confidence-in-your-investment-decisions-with-third-party-data-1">
                        <picture>
                            
                                
                                    <source media="(min-width: 1200px)" srcset="https://s7d1.scene7.com/is/image/moodyscorp/increase-confidence-in-your-investment-decisions-with-third-party-data-1?$responsive$ 2x, https://s7d1.scene7.com/is/image/moodyscorp/increase-confidence-in-your-investment-decisions-with-third-party-data-1?$responsive$ 1x"/> 
                                
