            <span class="tabs-tab-number">05</span>
            
            <span class="tabs-tab-text">Patent research and analysis</span>
        </div>
        <div id="tabs-e9dfcb3ea0-item-3fb536bd28-tabpanel" role="tabpanel" aria-labelledby="tabs-e9dfcb3ea0-item-3fb536bd28-tab" tabindex="-1" class="cmp-tabs__tabpanel" data-cmp-hook-tabs="tabpanel" data-cmp-data-layer="{&#34;tabs-e9dfcb3ea0-item-3fb536bd28&#34;:{&#34;@type&#34;:&#34;core/wcm/components/tabs/v1/tabs/item&#34;,&#34;dc:title&#34;:&#34;Patent research and analysis&#34;}}">
