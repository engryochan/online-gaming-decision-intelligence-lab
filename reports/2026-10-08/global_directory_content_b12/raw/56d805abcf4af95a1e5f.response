    (function() {
      var modal = document.getElementById('member-form');
      var formFrame = document.getElementById('member-formstack-iframe');
      var loadingMessage = document.getElementById('member-form-loading');
      var triggers = document.querySelectorAll('.js-load-member-form');

      if (!modal || !formFrame) {
        return;
      }

      function loadFormstackForm() {
        if (formFrame.getAttribute('src')) {
          return;
        }

        var frameSrc = formFrame.getAttribute('data-src');
        if (!frameSrc) {
          return;
        }

        if (loadingMessage) {
          loadingMessage.style.display = 'block';
        }

        formFrame.setAttribute('src', frameSrc);
      }

      formFrame.addEventListener('load', function() {
        if (loadingMessage) {
          loadingMessage.style.display = 'none';
        }
      });

      for (var i = 0; i < triggers.length; i++) {
        triggers[i].addEventListener('click', loadFormstackForm);
      }

      modal.addEventListener('beforeshow', loadFormstackForm);
    })();
  </script>  </html>