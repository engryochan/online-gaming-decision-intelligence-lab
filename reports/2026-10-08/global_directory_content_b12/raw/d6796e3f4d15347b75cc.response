<section class="block NOpadding100">
  <div class="container">

	<div class="row">
	  <div class="col-12">
		<h2 class="block-title thin-title">Member fees</h2>
	  </div>
	</div>
	<div class="row">
		
		  <div class="col-md-4">
			<div class="listing-two-content padding0">
			  <div class="text-center">
									<h2>Becoming a member</h2>
													<h3>No entry fee</h3>
													<p>The entry and processing for members is free</p>
							  </div>
			  <div class="mylisttable tablepadding0 tablemargin0">
				<table class="table">
				  <tbody>
										<tr>
					  <td class="font-weight-bold"> Single member monthly fee</td>
					  <td class="text-right">650€</td>
					</tr>
										<tr>
					  <td class="font-weight-bold">Group monthly fee</td>
					  <td class="text-right">1200€</td>
					</tr>
									  </tbody>
				</table>
							  </div>
			</div>
		  </div>

		
		  <div class="col-md-4">
			<div class="listing-two-content padding0">
			  <div class="text-center">
									<h2>Equity transactions</h2>
													<h3>0.035%</h3>
													<p>Value-based trading fee</p>
							  </div>
			  <div class="mylisttable tablepadding0 tablemargin0">
				<table class="table">
				  <tbody>
										<tr>
					  <td class="font-weight-bold">Automatic matching</td>
					  <td class="text-right">0.035% (min 0.30€)</td>
					</tr>
										<tr>
					  <td class="font-weight-bold">Manual trades</td>
					  <td class="text-right">0.035% (min 0.30€, max 150€)</td>
					</tr>
									  </tbody>
				</table>
							  </div>
			</div>
		  </div>

		
		  <div class="col-md-4">
			<div class="listing-two-content padding0">
			  <div class="text-center">
									<h2>Debt securities transactions</h2>
													<h3>0.01%</h3>
													<p>Value-based trading fee<sup>*</sup></p>
							  </div>
			  <div class="mylisttable tablepadding0 tablemargin0">
				<table class="table">
				  <tbody>
										<tr>
					  <td class="font-weight-bold">Automatic matching</td>
					  <td class="text-right">0.01% (min 0.30€, max 30€)</td>
					</tr>
										<tr>
					  <td class="font-weight-bold">Manual trades</td>
					  <td class="text-right">0.01% (min 0.30€, max 30€)</td>
					</tr>
									  </tbody>
				</table>
									<p class="table-comment">
					  <sup>*</sup> The transaction fee is not levied for debt securities issued by the Republic of Lithuania.					</p>
							  </div>
			</div>
		  </div>

		
	</div>

	
  </div>
</section> <!-- #member-fees -->



