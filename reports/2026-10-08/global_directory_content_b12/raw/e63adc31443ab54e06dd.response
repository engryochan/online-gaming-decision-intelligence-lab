      <div class="heading heading--withborderbottom">Delisted Securities</div>
      <table style="width:99.968%;height:29271.2px;">
<thead>
<tr style="height:40px;">
<th style="width:3.32637%;height:40px;text-align:center;">#</th>
<th style="width:30.3236%;height:40px;text-align:center;">Delisting Date</th>
<th style="width:20.7125%;height:40px;text-align:center;">Ticker</th>
<th style="width:25.7556%;height:40px;text-align:center;">Company</th>
<th style="width:9.2188%;height:40px;text-align:center;">Asset Type</th>
<th style="width:10.6444%;height:40px;text-align:center;">Reason</th>
</tr>
</thead>
<tbody>
<tr style="height:120px;">
<td style="width:3.32637%;height:120px;text-align:center;">1</td>
<td style="width:30.3236%;height:120px;text-align:center;">26 Jun 2019</td>
<td style="width:20.7125%;height:120px;text-align:center;"><a href="https://www-aix-kz.s3.eu-central-1.amazonaws.com/uploads/2018/12/Notice-of-admission-to-the-Official-List_Real-Estate-Fund-SK.pdf" target="_blank" rel="noreferrer noopener">REFSK.0619</a></td>
<td style="width:25.7556%;height:120px;text-align:center;">Samruk-Kazyna Construction JSC</td>
<td style="width:9.2188%;height:120px;text-align:center;">Bonds</td>
<td style="width:10.6444%;height:120px;text-align:center;">Delisted following the maturity of all remaining bonds of the Listed Entity</td>
</tr>
<tr style="height:120px;">
<td style="width:3.32637%;height:120px;text-align:center;">2</td>
<td style="width:30.3236%;height:120px;text-align:center;">02 Mar 2020</td>
<td style="width:20.7125%;height:120px;text-align:center;"><a href="https://www-aix-kz.s3.eu-central-1.amazonaws.com/uploads/2019/12/Notice-of-admission-to-the-Official-List_GUM.pdf" target="_blank" rel="noreferrer noopener">GDS.3022</a></td>
<td style="width:25.7556%;height:120px;text-align:center;">Guldala Department Store LLP</td>
<td style="width:9.2188%;height:120px;text-align:center;">Bonds</td>
<td style="width:10.6444%;height:120px;text-align:center;">Delisted at the Listed Entity’s request pursuant to MLR 19.5</td>
</tr>
<tr style="height:160px;">
<td style="width:3.32637%;height:160px;text-align:center;">3</td>
<td style="width:30.3236%;height:160px;text-align:center;">15 Oct 2020</td>
<td style="width:20.7125%;height:160px;text-align:center;"><a href="https://www-aix-kz.s3.eu-central-1.amazonaws.com/uploads/2020/07/Notice-of-admission-to-the-Official-List_Kaspi.kz_.pdf" target="_blank" rel="noreferrer noopener">N/A</a></td>
<td style="width:25.7556%;height:160px;text-align:center;">Kaspi.kz JSC</td>
<td style="width:9.2188%;height:160px;text-align:center;">GDRs</td>
<td style="width:10.6444%;height:160px;text-align:center;">Delisted from Pre-IPO Listings following the listing of GDRs on main segment</td>
</tr>
<tr style="height:180px;">
<td style="width:3.32637%;height:180px;text-align:center;">4</td>
<td style="width:30.3236%;height:180px;text-align:center;">10 Dec 2020</td>
<td style="width:20.7125%;height:180px;text-align:center;"><a href="https://www-aix-kz.s3.eu-central-1.amazonaws.com/uploads/2020/09/Notice-of-admission-to-the-Official-List_Kazakhtelecom2_final.pdf" target="_blank" rel="noreferrer noopener">KTCB2.1024</a></td>
<td style="width:25.7556%;height:180px;text-align:center;">Kazakhtelecom JSC</td>
<td style="width:9.2188%;height:180px;text-align:center;">Bonds</td>
<td style="width:10.6444%;height:180px;text-align:center;">Delisted following the early redemption of all remaining bonds pursuant to MLR 19.7.1 (7)</td>
</tr>
<tr style="height:80px;">
