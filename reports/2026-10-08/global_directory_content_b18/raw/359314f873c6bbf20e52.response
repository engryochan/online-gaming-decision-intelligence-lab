                                                <option value="F&#xF6;rs&#xE4;kringsf&#xF6;rmedlare, utl&#xE4;ndska"> F&#xF6;rs&#xE4;kringsf&#xF6;rmedlare, utl&#xE4;ndska</option>
                                                <option value="Hypoteksinstitut"> Hypoteksinstitut</option>
                                                <option value="Institut f&#xF6;r vissa andra konsumentkrediter"> Institut f&#xF6;r vissa andra konsumentkrediter</option>
                                                <option value="Internt f&#xF6;rvaltade fonder"> Internt f&#xF6;rvaltade fonder</option>
