                                                <option value="Leverant&#xF6;r av kryptotillg&#xE5;ngstj&#xE4;nster, utl&#xE4;ndska"> Leverant&#xF6;r av kryptotillg&#xE5;ngstj&#xE4;nster, utl&#xE4;ndska</option>
                                                <option value="Registrerade, inte under tillsyn"> Registrerade, inte under tillsyn</option>
                                                <option value="Svenska f&#xF6;retags filialer utomlands"> Svenska f&#xF6;retags filialer utomlands</option>
                                                <option value="Tj&#xE4;nstepensionsf&#xF6;retag"> Tj&#xE4;nstepensionsf&#xF6;retag</option>
                                                <option value="Underordnade objekt"> Underordnade objekt</option>
                                                <option value="Utgivare av elektroniska pengar"> Utgivare av elektroniska pengar</option>
                                                <option value="Utgivare av elektroniska pengar, utl&#xE4;ndska"> Utgivare av elektroniska pengar, utl&#xE4;ndska</option>
                                                <option value="Utl&#xE4;ndska f&#xF6;retags filialer i Sverige"> Utl&#xE4;ndska f&#xF6;retags filialer i Sverige</option>
