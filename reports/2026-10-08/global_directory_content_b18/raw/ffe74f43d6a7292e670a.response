/fvm/1759280682/out/header-3afae13aa1a25beeb109a30bd2eaf7523b55eb03.min.js' id='fvm-header-1-js'></script><link rel="https://api.w.org/" href="https://guyanastockexchangeinc.com/wp-json/"/><link rel="alternate" type="application/json" href="https://guyanastockexchangeinc.com/wp-json/wp/v2/pages/15"/><style type="text/css">.recentcomments a{display:inline !important;padding:0 !important;margin:0 !important;}</style></head><body class="page-template-default page page-id-15 brokers dwpb-push-page group-blog"><div id="page" class="site"> <a class="skip-link screen-reader-text" href="#content">Skip to content</a> <header id="masthead" class="site-header" role="banner"><div class="site-contact group"><div class="wrapper group"><div class="dropdown"><div class="menu-label">Help</div> <nav class="help-menu"><div class="menu-help-container"><ul id="menu-help" class="menu"><li class="menu-item"><a href="https://guyanastockexchangeinc.com/faqs/">FAQs</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/glossary/">Glossary</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/buying-selling-shares/">Buying &#038; Selling Shares</a></li></ul></div> </nav></div> <nav class="secondary"><div class="menu-secondary-container"><ul id="menu-secondary" class="menu"><li class="menu-item"><a href="https://guyanastockexchangeinc.com/about-us/">About Us</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/articles/">Articles</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/legal-framework/">Legal Framework</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/news/">News</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/links/">Links</a></li><li class="menu-item"><a href="https://guyanastockexchangeinc.com/previous-website/">Previous Website</a></li></ul></div></nav></div></div><div class="site-nav"><div class="site-branding row wrapper"><div class="site-logo co