      <article data-history-node-id="18017" class="node node--type-page node--view-mode-full">

  
    

  
  <div class="node__content">
    
            <div class="clearfix text-formatted field field--name-body field--type-text-with-summary field--label-hidden field__item"><p><h2 class="table-title">Azioni italiane</h2><div class="datatable-wrapper"><div class="datatable-scroller"><table data-striping="1">
  
  
      <thead>
      <tr>
                            <th class="cell-ISINCODE"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="The code that uniquely identifies each instrument"></span></div><a href="/en/equity/italian-equities?sort=asc&order=ISINCODE" class="sortable">ISIN</a></div></th>
                            <th class="cell-DESCRIPTION"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Indicates a brief summary of the specific characteristics of the security, i.e. issuer name and any characteristics such as coupon value and maturity of the financial instrument."></span></div><a href="/en/equity/italian-equities?sort=asc&order=DESCRIPTION" class="sortable">Description</a></div></th>
                            <th class="cell-CURRENCY"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Represents the trading currency of the instrument"></span></div><a href="/en/equity/italian-equities?sort=asc&order=CURRENCY" class="sortable">Trading Currency</a></div></th>
                            <th class="cell-bidNumOfOrders"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Indicates the number of purchase proposals for aggregate level"></span></div><span>Nr. of proposals (bid)</span></div></th>
                            <th class="cell-bidQty"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Indicates the total nominal value (for bonds) or the total number of pieces (for equities, ETF, CW and certificates) that is purchased at the corresponding Bid Price"></span></div><span>Bid quantity</span></div></th>
                            <th class="cell-bidPrice"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Indicates the price, associated with the bid quantity, at which one or more operators on the market are willing to buy the financial instrument. Also defined as &#039;denaro&#039;"></span></div><span>Bid price</span></div></th>
                            <th class="cell-askPrice"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Indicates the price, associated with the ask quantity, at which one or more operators on the market are willing to sell the financial instrument. Also defined as &#039;lettera&#039;"></span></div><span>Ask price</span></div></th>
                            <th class="cell-askQty"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Indicates the total nominal value (for bonds) or the total number of pieces (for equities, ETF, CW and certificates) that is sold at the corresponding Ask Price"></span></div><span>Ask quantity</span></div></th>
                            <th class="cell-askNumOfOrders"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Indicates the number of selling proposals for aggregate level"></span></div><span>Nr. of proposals (ask)</span></div></th>
                            <th class="cell-ExecPercVarYesterday"><div class="tooltip-wrapper"><div class="tooltip-cont"><span data-tooltip="Indicates the percentage variation of price between the last trade executed today and the previous closing price"></span></div><span>Var %</span></div></th>
              </tr>
    </thead>
  
      <tbody>
                      <tr class="odd">
                      <td><a href="/en/hitmtf_info/det/EQUITYIT0001233417" target="_blank">IT0001233417</a></td>
