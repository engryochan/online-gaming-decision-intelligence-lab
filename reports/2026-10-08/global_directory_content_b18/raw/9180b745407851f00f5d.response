                  </tr>
                      <tr class="odd">
                      <td><a href="/en/hitmtf_info/det/EQUITYIT0004056880" target="_blank">IT0004056880</a></td>
                      <td>AMPLIFON</td>
                      <td>EUR</td>
                      <td>2</td>
                      <td>3,338</td>
