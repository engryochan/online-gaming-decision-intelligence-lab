/><link rel="preload" as="image" href="https://www.adx.ae/_next/static/media/Earth.5712b293.svg"/><div id="__next"><div id="content-wrapper" class="prod-mode main-div-container" data-testid="layout-main"><header id="header"><div id="header-top" class="header component adx-header adx-header-removebg"><div class="component-content container"><!--$--><div class="gridcontainer"><div class="header-separate"><div class="header-row1-logo"><div class="adx-logo"><a href="/en"><div class="adx-logo-img"><img alt="full-variant-logo" loading="eager" width="540" height="106" decoding="async" data-nimg="1" class="full-variant-logo" style="color:transparent" src="/-/media/adx/topnavigation/adx-logo/adx-white-logo.svg"/><img alt="light-variant-logo" loading="eager" width="540" height="106" decoding="async" data-nimg="1" class="light-variant-logo" style="color:transparent" src="/-/media/adx/topnavigation/adx-logo/adx-dark-logo.svg"/></div></a></div></div><div class="header-utility-group"><div class="header-util-item header-util-date"><div class="uae-current-date"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" class="uae-current-date__icon" aria-hidden="true" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M9.99996 18.3337C14.6023 18.3337 18.3333 14.6027 18.3333 10.0003C18.3333 5.39795 14.6023 1.66699 9.99996 1.66699C5.39759 1.66699 1.66663 5.39795 1.66663 10.0003C1.66663 14.6027 5.39759 18.3337 9.99996 18.3337Z"></path><path d="M10 5V10L12.9167 11.6667"></path></svg><span class="uae-current-date__text"></span></div></div><div class="header-util-item header-util-fintech"><a class="header-fintech" href="https://terminal.fintech.tv/" target="_blank" rel="noopener noreferrer" aria-label="FINTECH.TV Studio"><img class="header-fintech__icon" src="/-/media/adx/topnavigation/fintech-tv-studio.svg" alt="FinTech TV" width="20" height="20" aria-hidden="true"/><span class="header-fintech__label">FINTECH.TV Studio</span></a></div><div class="header-util-item header-util-accessibility d-none d-md-flex"><div class="accessbility-container accessbility-responsive-container"><div class="dropdown"><button type="button" id="dropdown-basic" aria-expanded="false" class="secondary-btn-no-border accessbility-btn dropdown-toggle btn"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none" class="" aria-hidden="true" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"><path d="M10.0003 18.3337C14.6027 18.3337 18.3337 14.6027 18.3337 10.0003C18.3337 5.39795 14.6027 1.66699 10.0003 1.66699C5.39795 1.66699 1.66699 5.39795 1.66699 10.0003C1.66699 14.6027 5.39795 18.3337 10.0003 18.3337Z"></path><path d="M10 6.25C10.3452 6.25 10.625 5.97017 10.625 5.625C10.625 5.27983 10.3452 5 10 5M10 6.25C9.65483 6.25 9.375 5.97017 9.375 5.625C9.375 5.27983 9.65483 5 10 5M10 6.25V5"></path><path d="M13.3337 7.5C12.4746 8.01549 11.2981 8.33333 10.0003 8.33333C8.70258 8.33333 7.52604 8.01549 6.66699 7.5"></path><path d="M10.833 11.6663L11.6663 14.9997M10.833 11.6663V8.33301M10.833 11.6663H9.99967M9.99967 11.6663H9.16634M9.99967 11.6663V8.33301M8.33301 14.9997L9.16634 11.6663M9.16634 11.6663V8.33301"></path></svg><span class="fw-normal">Accessibility</span><i class="icon-chevron-down"></i></button><button tabindex="0" class="adx-skipToContent">Skip to Content</button></div></div></div><div class="header-util-item header-util-language"><div class="component language-switcher language-selector initialized"><div class="language-selector-select-item" data-language-code="en" data-country-code="us"><img src="https://www.adx.ae/_next/static/media/Earth.5712b293.svg" alt="language-icon" height="20" width="20" class="icon-sphere"/><div class="language-selector-select-link" data-language-code="ar" data-country-code="ae"><button type="button" class="language-switcher-btn btn btn-primary">عربي</button></div></div></div></div><div class="header-util-item header-util-login d-none d-md-flex"></div></div></div></div><div class="gridcontainer pt-3"><div class="public-header-main-row"><div class="header-item header-logo"><div class="adx-logo"><a href="/en"><div class="adx-logo-img"><img alt="full-variant-logo" loading="eager" width="540" height="106" decoding="async" data-nimg="1" class="full-variant-logo" style="color:transparent" src="/-/media/adx/topnavigation/adx-logo/adx-white-logo.svg"/><img alt="light-variant-logo" loading="eager" width="540" height="106" decoding="async" data-nimg="1" class="light-variant-logo" style="color:transparent" src="/-/media/adx/topnavigation/adx-logo/adx-dark-logo.svg"/></div></a></div></div><div class="header-item header-spacer-desktop"></div><div class="header-item header-search"><div class="d-flex align-items-center gap-3 position-relative"><div class="search-btn-responsive secondary-btn search-btn flaot-r rounded-circle"><i data-testid="icon-search1" class="icon-search1"></i></div></div></div><div class="header-item header-mw-btn"><div class="mw-btn"><a class="primary-btn text-dark mw-btn-container " aria-label="marketWatchBtn" href="/en/all-equities"><span class="header-mw-btn__label">MARKET WATCH</span></a></div></div></div></div><!--/$--></div></div></header><main id="top" class="z-1"><div id="content" style="margin-top:120px;background:white"><!--$--><div style="position:sticky;top:0px;z-index:9" class="adx-market-watch header-main-ticker mainHeader-ticker "><div class="ticker-value overflow-hidden"><div class="inLoader-market-watch">Loading<!-- --> ...<span class="spinner-border spinner-border" role="status" aria-hidden="true"></span></div></div></div><!--/$--><!--$--><div class="component navigation "><div class="component-content container"><nav class="breadcrumbs-nav" aria-label="breadcrumbs"><ul class="clearfix m-0"><li class=""><div class="navigation-title"><a href="/">ADX</a><span class="separator">/</span></div></li><li class="active"><div class="navigation-title"><span>Issuers</span></div></li><li class=""></li><li class=""></li></ul></nav><div class="pageTitlediv"><h1 class="pageTitle mb-0">Issuers</h1></div></div></div><!--/$--><!--$--><div class="component adx-feature-hero-banner"><div class="container"><span class="adx-feature-hero-banner__glow adx-feature-hero-banner__glow--top" aria-hidden="true"></span><span class="adx-feature-hero-banner__glow adx-feature-hero-banner__glow--bottom" aria-hidden="true"></span><div class="adx-feature-hero-banner__inner"><div class="adx-feature-hero-banner__grid"><div class="adx-feature-hero-banner__content"><h1 class="adx-feature-hero-banner__title"><div>ADX Investor Relations Guide</div></h1><p class="adx-feature-hero-banner__description">A Strategic Framework for Listed Companies in Line with Global Best Practices. <br />
<br />
The ADX Investor Relations Guide establishes clear standards for how listed issuers engage with investors and the market. Combining<strong> six minimum compliance requirements</strong> with end-to-end best practices—from equity story design to ESG reporting and IPO lifecycles—it provides practical templates, checklists, and self-assessment tools to transform IR into a strategic corporate engine.</p><p class="adx-feature-hero-banner__secondary-description">Whether building a new IR function or benchmarking a mature one, the Guide provides a clear standard and a path to recognition among ADX's top performing IR teams.</p><a class="adx-feature-hero-banner__cta" href="/-/media/adx/related-documents/ir-guide/adx-investor-relations-guide-full-manual.pdf">Download Investor Relations Guide</a></div><div class="adx-feature-hero-banner__media"><img alt="" loading="lazy" width="640" height="480" decoding="async" data-nimg="1" class="adx-feature-hero-banner__media-image" style="color:transparent" src="/-/jssmedia/adx/banner/ir-guide-1.png?h=5260&amp;iar=0&amp;w=5980&amp;hash=0D5EFD6B7A0C33DB788779446373124C"/></div></div></div></div></div><!--/$--><!--$--><div class="component adx-icon-cards"><div class="container"><div class="adx-icon-cards__header"><span class="adx-icon-cards__eyebrow">Target Groups</span><h2 class="adx-icon-cards__header-title">Who is this for</h2></div><div class="row adx-icon-cards__grid"><div class="col-12 col-md-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/ai-ssp-subscription/ssp-cards-icons/bank-mandate-card4.svg?iar=0&amp;hash=C161B291D986B241F0AB47E17434A7E7"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Listed companies on the Main Market and Growth Market</h3><div class="adx-icon-cards__description"><div>The requirements and practices in the Guide apply to every issuer, calibrated to market category.</div></div></div></div></div><div class="col-12 col-md-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/ai-ssp-subscription/ssp-cards-icons/accessible-card2.svg?iar=0&amp;hash=CBDA2B6ECB621D868FFE6358B2FEDA90"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title"> Investor Relations Officers</h3><div class="adx-icon-cards__description"><div>The Guide's primary users, responsible for day-to-day implementation.</div></div></div></div></div><div class="col-12 col-md-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/ai-ssp-subscription/ssp-cards-icons/seamless-card2.svg?iar=0&amp;hash=EC5693A6D038B97D76F51D67195C1147"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">CFOs and Senior Management </h3><div class="adx-icon-cards__description"><div>Co-sign the Annual Commitment Form and oversee the IR function.<br /></div></div></div></div></div><div class="col-12 col-md-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/ir-guide-icons/bod.svg?iar=0&amp;hash=8173D5CA0753B3FE30E03535224E0B43"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Board of Directors</h3><div class="adx-icon-cards__description"><div>For governance oversight of investor communication.</div></div></div></div></div><div class="col-12 col-md-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/ir-guide-icons/cpfipo.svg?iar=0&amp;hash=D7A3B273F8DC80795F1EC867897D77CF"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Companies preparing for IPO</h3><div class="adx-icon-cards__description"><div> A dedicated chapter covers IR from pre-listing through maturity.</div></div></div></div></div></div></div></div><!--/$--><!--$--><div class="container adx-cta-banner" style="--adx-cta-banner-bg:#0E1B2E"><div class="adx-cta-banner__card"><span class="adx-cta-banner__glow adx-cta-banner__glow--top" aria-hidden="true"></span><span class="adx-cta-banner__glow adx-cta-banner__glow--bottom" aria-hidden="true"></span><span class="adx-cta-banner__sparkle" aria-hidden="true"></span><span class="adx-cta-banner__accent" aria-hidden="true"></span><div class="adx-cta-banner__content"><span class="adx-cta-banner__badge"><span>The form is available for download and should be submitted to <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="9cdff3eeecf3eefde8f9cef9f0fde8f5f3f2efdcfdf8e4b2fdf9">[email&#160;protected]</a></span></span><h2 class="adx-cta-banner__title">Each listed company is required to complete and submit the Annual Commitment Form, duly signed by the Investor Relations Officer and the Chief Financial Officer (CFO), or their designated equivalents, to confirm adherence to the minimum requirements.</h2></div><a class="adx-cta-banner__cta" href="/-/media/adx/related-documents/ir-guide/ir-commitment-form.pdf">Download Commitment Form</a></div></div><!--/$--><!--$?--><template id="B:0"></template><h4>Loading component...</h4><!--/$--><!--$?--><template id="B:1"></template><h4>Loading component...</h4><!--/$--><!--$?--><template id="B:2"></template><h4>Loading component...</h4><!--/$--><!--$?--><template id="B:3"></template><h4>Loading component...</h4><!--/$--><!--$?--><template id="B:4"></template><h4>Loading component...</h4><!--/$--><!--$--><div class="py-1 margin-bottom-40"><div class="richtext-wrapper container"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class=""><p>*The templates are provided for reference. Companies may use their own formats and designs, provided they capture at minimum the information set out here.</p></div></div></div></div></div><!--/$--><!--$?--><template id="B:5"></template><h4>Loading component...</h4><!--/$--></div></main><footer><button class="ScrollToTop"><i class="icon icon-top"></i></button><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="component adx-footer pt-0"><div class="component-content"><!--$?--><template id="B:6"></template><h4>Loading component...</h4><!--/$--><!--$?--><template id="B:7"></template><h4>Loading component...</h4><!--/$--></div></div></div></div></footer></div><div class="Toastify"></div></div><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>requestAnimationFrame(function(){$RT=performance.now()});</script><div hidden id="S:0"><div class="component adx-icon-cards" style="--adx-icon-cards-bg:#F0F2F7;--adx-icon-cards-card-bg:#FAFBFC"><div class="container"><div class="adx-icon-cards__header"><h2 class="adx-icon-cards__header-title">The Requirements</h2><p class="adx-icon-cards__header-description">Six minimum requirements apply to all listed companies:</p></div><div class="row adx-icon-cards__grid"><div class="col-12 col-md-6 col-lg-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/mcp-subscription/icons/numbers/number-1.svg?iar=0&amp;hash=CFC9FECEAA5E1ECEF982FB21A787A435"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Designated IR Officer</h3><div class="adx-icon-cards__description"><div>A named individual with direct access to the CEO, CFO, and board, responsible for coordinating disclosure, investor engagement, and market communication.</div></div></div></div></div><div class="col-12 col-md-6 col-lg-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/mcp-subscription/icons/numbers/number-2.svg?iar=0&amp;hash=077F55BDE783C0838F6635F2D9107DBA"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Dedicated IR webpage</h3><div class="adx-icon-cards__description"><div>A clearly labelled investor relations section on your corporate website, with public contact details, a three-year archive of financial reports, and a corporate calendar.</div></div></div></div></div><div class="col-12 col-md-6 col-lg-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/mcp-subscription/icons/numbers/number-3.svg?iar=0&amp;hash=BFA2AF0204DA919CA2F4F49B1FDD509B"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Current investor presentation</h3><div class="adx-icon-cards__description"><div>An up-to-date presentation of your equity story — business model, strategy, and value drivers — refreshed at least every six months and filed with ADX when updated.</div></div></div></div></div><div class="col-12 col-md-6 col-lg-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/mcp-subscription/icons/numbers/number-4.svg?iar=0&amp;hash=D40DB9C76E0F3F4E4B8760AA67C5BB51"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Timely disclosure</h3><div class="adx-icon-cards__description"><div>All disclosures made in line with ADX rules, released on the ADX platform first, published bilingually in Arabic and English, and submitted as searchable PDFs.</div></div></div></div></div><div class="col-12 col-md-6 col-lg-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/mcp-subscription/icons/numbers/number-5.svg?iar=0&amp;hash=2194638215E647AF6165CA8AF858596A"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Periodic reporting requirements</h3><div class="adx-icon-cards__description"><div>Financial statements published within 45 days of period end — quarterly for Main Market, semi-annually for Growth Market — each accompanied by a Management Discussion and Analysis.</div></div></div></div></div><div class="col-12 col-md-6 col-lg-4 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/mcp-subscription/icons/numbers/number-6.svg?iar=0&amp;hash=AACD11E2E40BEB611B00D25E8BDCB89F"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Annual reporting requirements</h3><div class="adx-icon-cards__description"><div>Audited annual financials within 90 days of year end, alongside the annual report, corporate governance report, and sustainability/ESG report for Main Market companies.</div></div></div></div></div></div><p class="adx-icon-cards__supporting-text">Full details, including how each requirement applies to Main Market and Growth Market companies, are set out in the ADX Investor Relations Guide.</p></div></div></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if("/$"===d||"/&"===d)if(0===h)break;else h--;else"$"!==d&&"$?"!==d&&"$~"!==d&&"$!"!==d&&"&"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data="$";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};
$RC=function(a,b){if(b=document.getElementById(b))(a=document.getElementById(a))?(a.previousSibling.data="$~",$RB.push(a,b),2===$RB.length&&("number"!==typeof $RT?requestAnimationFrame($RV.bind(null,$RB)):(a=performance.now(),setTimeout($RV.bind(null,$RB),2300>a&&2E3<a?2300-a:$RT+300-a)))):b.parentNode.removeChild(b)};$RC("B:0","S:0")</script><div hidden id="S:1"><div class="component adx-icon-cards"><div class="container"><div class="adx-icon-cards__header"><span class="adx-icon-cards__eyebrow">annual evaluation</span><h2 class="adx-icon-cards__header-title">Assessment &amp; Governance</h2><p class="adx-icon-cards__header-description">ADX assesses all listed companies against the Guide on an annual cycle:</p></div><div class="row adx-icon-cards__grid"><div class="col-12 col-md-6 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/derivatives-icons/settlement.svg?iar=0&amp;hash=E5CAAAE3D69EB0D9530AC69738E411E0"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Recognition</h3><div class="adx-icon-cards__description"><div>Companies that meet the minimum requirements and go above and beyond in adopting best practices qualify for ranking and awards as ADX's top performing IR teams.</div></div></div></div></div><div class="col-12 col-md-6 adx-icon-cards__col"><div class="adx-icon-cards__card"><img alt="" loading="lazy" width="40" height="40" decoding="async" data-nimg="1" style="color:transparent" src="/-/jssmedia/adx/ai-ssp-subscription/ssp-cards-icons/seamless-card2.svg?iar=0&amp;hash=EC5693A6D038B97D76F51D67195C1147"/><div class="adx-icon-cards__content"><h3 class="adx-icon-cards__title">Enforcement</h3><div class="adx-icon-cards__description"><div>Companies that do not comply with the minimum requirements receive warning letters, and potential monetary penalties may be applied to annual listing renewal fees at the discretion of ADX management, subject to the severity and degree of non-compliance.</div></div></div></div></div></div></div></div></div><script>$RC("B:1","S:1")</script><div hidden id="S:2"><div class="container adx-cta-banner" style="--adx-cta-banner-bg:#FFFFFF"><div class="adx-cta-banner__card"><span class="adx-cta-banner__glow adx-cta-banner__glow--top" aria-hidden="true"></span><span class="adx-cta-banner__glow adx-cta-banner__glow--bottom" aria-hidden="true"></span><span class="adx-cta-banner__sparkle" aria-hidden="true"></span><span class="adx-cta-banner__accent" aria-hidden="true"></span><div class="adx-cta-banner__content"><h2 class="adx-cta-banner__title">A Strategic Framework for Listed Companies in Line with Global Best Practices</h2></div><a class="adx-cta-banner__cta" href="/-/media/adx/related-documents/ir-guide/adx-investor-relations-guide-full-manual.pdf">Download the ADX Investor Relations Guide</a></div></div></div><script>$RC("B:2","S:2")</script><div hidden id="S:3"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="component adx-relatedDocuments css-0" style="opacity:0;animation-delay:700ms"><div class="component-content container"><h2 class="adx-aboutHead">Main Documents</h2><ul class="related-docs-cont"><li class="sec"><div class="row g-0"><div class="col-8 d-flex align-items-center"><i class="icon"><img alt="fileIcon" loading="lazy" width="34" height="34" decoding="async" data-nimg="1" style="color:transparent" src="https://www.adx.ae/_next/static/media/PDF.886f1cbb.svg"/></i><span class="ms-2">ADX Investor Relations Guide - Summary</span></div><div class="col-4 downloadBx">pdf<!-- -->(2113.2KB)<button class="icon-download1 icon border-0"></button></div></div></li><li class="sec"><div class="row g-0"><div class="col-8 d-flex align-items-center"><i class="icon"><img alt="fileIcon" loading="lazy" width="34" height="34" decoding="async" data-nimg="1" style="color:transparent" src="https://www.adx.ae/_next/static/media/PDF.886