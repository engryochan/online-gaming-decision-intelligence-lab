                                                                                                                                                                                                                                                                                                                              <div class="pt-4">
                                                                                        <a class="cursor-pointer select-none rounded-sm px-4 py-2 uppercase shadow-md text-center flex font-medium text-20  text-white bg-purple hover:bg-purple-hover group-hover:bg-purple-hover transition-all duration-200" href="https://www.lbma.org.uk/articles/lbma-publishes-its-2026-sustainability-responsible-sourcing-report">
