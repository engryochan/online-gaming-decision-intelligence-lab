					<button class="cursor-pointer select-none rounded-sm px-4 py-2 uppercase shadow-md inline-flex font-medium text-13 text-white bg-purple hover:bg-purple-hover group-hover:bg-purple-hover transition-all duration-200" id="clear_all_filters" onclick="clearAllFilters()">Clear filters</button>
