			<div class="p-6 flex flex-col justify-between items-start text-white">
																																																							
				<div>
					<h3 class="mb-6 font-semibold leading-tight text-white text-20">LBMA Security Feature Requirements</h3>
									</div>

										    


		
	<span class="cursor-pointer select-none rounded-sm px-4 py-2 uppercase shadow-md inline-flex font-medium text-13 text-white bg-turquoise hover:bg-turquoise-hover group-hover:bg-turquoise-hover transition-all duration-200">
		Find out more
	</span>

							</div>
			
