                    group: 'Other registers',
                    url: '"uri": "https://connectonline.asic.gov.au/RegistrySearch/faces/landing/panelSearch.jspx?searchTab=search&searchType=Doc&searchText='
                },
                {
                    title: 'Registrable superannuation entities document register',
                    description: 'This register contains certain documents lodged with ASIC by registrable superannuation entity licensees (RSE licensees) for registrable superannuation entities (RSEs).',
                    helptext: 'Issuer name or ABN',
                    group: 'Other registers',
                    url: 'https://www.asic.gov.au/online-services/search-asic-registers/registrable-superannuation-entities-document-register/#!search='
                }
            ];

            const defaultLocation = searchLocations[0];

            let isDropdownOpen = false;
            let selectedLocation = defaultLocation;

            // toggles visibility of cusom dropdown
            function toggleDropdown(show) {
                const dropdownList = document.getElementById('dropdown-list');
                const dropdownToggle = document.getElementById('dropdown-toggle');

                if (!dropdownList || !dropdownToggle) return;

                const willShow = (show !== undefined) ? show : dropdownList.classList.contains('hidden');

                if (willShow) {
                    dropdownList.classList.remove('hidden');
                    dropdownToggle.setAttribute('aria-expanded', 'true');

                    // Set focus to the first selectable option for keyboard users
                    const firstOption = document.querySelector('#dropdown-list [role="option"]');
                    if (firstOption) {
                        firstOption.focus();
                    }
                } else {
                    dropdownList.classList.add('hidden');
                    dropdownToggle.setAttribute('aria-expanded', 'false');
                    dropdownToggle.focus(); // Return focus to the main button
                }
                isDropdownOpen = willShow;
            }

            function selectOption(locationTitle) {
                const selected = searchLocations.find(loc => loc.title === locationTitle);
                if (!selected) return;

                selectedLocation = selected;

                const displayElement = document.getElementById('selected-location-display');
                if (displayElement) {
                    displayElement.innerHTML = `<span class="selected-text">${selectedLocation.title}</span>`;
                }

                // update help text
                const helpTextContainer = document.getElementById('search-helptext-container');
                if (helpTextContainer) {
                    helpTextContainer.innerHTML = `
                        <span id="search-hint-text" class="asic-field__hint">
                            <strong>Expected search format:</strong> ${selectedLocation.helptext}
                        </span>`;
                    helpTextContainer.classList.remove('hidden');
                }

                // Hide the dropdown
                toggleDropdown(false);
            }

            function performSearch() {
                const queryInput = document.getElementById('inpRegisterSearch');
                const originalQuery = queryInput ? queryInput.value.trim() : '';

                // these registers have special cases
                const titlesRequiringNameSplit = [
                    'Business names holder - person',
                    'Banned and disqualified'
                ];

                if (titlesRequiringNameSplit.includes(selectedLocation.title)) {
                    const nameParts = originalQuery.split(/\s+/).filter(part => part.length > 0);

                    // assume first word is the first name
                    const firstName = nameParts[0];
                    // assume remaining words (if any) are last name and join with a single space
                    const lastName = nameParts.slice(1).join(' ');

                    const encodedFirstName = encodeURIComponent(firstName);
                    const encodedLastName = encodeURIComponent(lastName);

                    // this url is special case when we need to pass firstname and lastname
                    const finalUrl = `${selectedLocation.url}&searchFirstName=${encodedFirstName}&searchSurname=${encodedLastName}`;

                    window.open(finalUrl, '_blank');
                    return;
                }

                let targetUrl = selectedLocation.url;
                let finalQuery = originalQuery;

                // Sanitize the query by removing all spaces for the number-only check
                const sanitizedQuery = originalQuery.replace(/\s/g, '');

                // Check if the SANITIZED query consists only of digits and is not empty
                const isNumericQueryIgnoringSpaces = sanitizedQuery !== '' && /^\d+$/.test(sanitizedQuery);

                // If the query is purely numeric (ignoring spaces), use the sanitized version for the URL.
                if (isNumericQueryIgnoringSpaces) {
                    // Apply this space-stripping to the query for ALL registers if the content is numeric
                    finalQuery = sanitizedQuery;
                }
                // If not numeric (i.e., contains letters or symbols), finalQuery remains originalQuery.

                // these registers have different urls for abn/acn search
                const titlesForIdSearch = [
                    'Business names',
                    'Business name holder - organisation'
                ];

                const isIdSearchTarget = titlesForIdSearch.includes(selectedLocation.title);

                if (isIdSearchTarget && isNumericQueryIgnoringSpaces) {
                    // For these specific registers, if the content is numeric, use the ID search URL
                    if (selectedLocation.urlById) {
                        targetUrl = selectedLocation.urlById;
                    }
                }

                const finalUrl = targetUrl + encodeURIComponent(finalQuery);

                window.open(finalUrl, '_blank');
            }

            // Handles keyboard navigation (Arrow Up/Down, Enter/Space) within the dropdown.
            function handleOptionKeydown(e) {
                const options = Array.from(document.querySelectorAll('#dropdown-list [role="option"]'));
                const focusedElement = document.activeElement;
                const currentIndex = options.findIndex(option => option === focusedElement);

                if (e.key === 'ArrowDown') {
                    e.preventDefault();
                    const nextIndex = (currentIndex + 1) % options.length;
                    options[nextIndex].focus();
                } else if (e.key === 'ArrowUp') {
                    e.preventDefault();
                    const prevIndex = (currentIndex - 1 + options.length) % options.length;
                    options[prevIndex].focus();
                }
            }

            function generateDropdownOptions() {
                // Group locations by the 'group' property
                const groups = searchLocations.reduce((acc, loc) => {
                    if (!acc[loc.group]) {
                        acc[loc.group] = [];
                    }
                    acc[loc.group].push(loc);
                    return acc;
                }, {});

                let html = '';
                let isFirstGroup = true;

                for (const groupName in groups) {
                    // Group Header
                    const borderClass = isFirstGroup ? '' : 'border-t';
                    html += `
                        <div class="group-header ${borderClass}" aria-hidden="true">
                            ${groupName}
                        </div>
                    `;
                    isFirstGroup = false;

                    // Options
                    groups[groupName].forEach((loc) => {
                        html += `
                            <div role="option" tabindex="0"
                                 data-title="${loc.title}"
                                 class="location-option"
                                 title="${loc.title}: ${loc.description.replace(/<[^>]*>/g, '')}">
                                <div class="option-title">${loc.title}</div>
                                <p>${loc.description}</p>
                            </div>
                        `;
                    });
                }
                return html;
            }
