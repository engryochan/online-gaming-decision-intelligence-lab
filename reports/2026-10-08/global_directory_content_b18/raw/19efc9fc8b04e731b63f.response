/* REGISTER SEARCH CSS BELOW HERE */
#registerSearch { padding: 1.5rem; background-color: #f7f7f7; }
#registerSearch input { max-width: 100%; }
#registerSearch .hidden {
    display: none;
}
#registerSearch  .search-content-wrapper > div { margin-bottom: 1rem; }
#registerSearch  h3 { margin: 0 0 .5rem 0; }

/* Custom Dropdown Styling */
#registerSearch .dropdown-container { 
    position: relative; 
    z-index: 10; 
}
#registerSearch .dropdown-list {
    position: absolute;
    width: 100%;
    max-height: 35rem; /* Increased height for more visibility */
    overflow-y: auto;
    background: #fff;
    border: 1px solid #ccc;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    margin-top: 2px;
    font-size: 1rem; 
}
#registerSearch .location-option {
    padding: 12px 16px; 
    cursor: pointer;
    border-bottom: 1px solid #f0f0f0;
    transition: background-color 0.1s;
}
#registerSearch .location-option:last-child {
    border-bottom: none;
}
#registerSearch .location-option:hover, 
#registerSearch .location-option:focus {
    background-color: #b2e2f5; 
}
#registerSearch .option-title { 
    font-weight: 600; 
    color: #004F71; 
    margin-bottom: 2px;
    display: block;
}
#registerSearch .group-header { 
    padding: 1rem; 
    background-color: #0072d5; 
    color: #fff; 
}
#registerSearch .search-controls { 
    display: flex; 
    gap: 1rem; 
    align-items: flex-end; 
}
#registerSearch .search-controls > .asic-field {
    flex-grow: 1; 
}
#registerSearch .custom-asic-select {
    /* Reset native browser styles */
    -webkit-appearance: none;
    -moz-appearance: none;
    appearance: none;
    /* Base styles matching .asic-select */
    background-color: #fff;
    border: 1px solid #757575;
    border-radius: 4px;
    color: #333;
    cursor: pointer;
    font-size: 1rem;
    font-weight: 400;
    line-height: 24px;
    height: 48px; /* Fixed height for consistency */
    padding: 0 12px; 
    margin-bottom: 0 !important;
    display: flex;
    align-items: center;
    justify-content: space-between;
    transition: border-color 0.1s;
}
#registerSearch .custom-asic-select:hover, #registerSearch .custom-asic-select:focus {
    border-color: #0072ce;
    outline: 3px solid #0072ce;
    outline-offset: 1px;
}

