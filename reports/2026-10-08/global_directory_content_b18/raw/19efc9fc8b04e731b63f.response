        function initalliseFilters() {
            const filterButtons = document.querySelectorAll('[data-filter]');
            const cards = document.querySelectorAll('.asic-card-actions');
            console.log(filterButtons);
            console.log(cards);



            filterButtons.forEach((btn) => {
                btn.addEventListener('click', () => {
                    const filter = btn.getAttribute('data-filter');
                    console.log('CLICKED');
                    // Removes the current button from being 'active' and makes the clicked button 'active'
                    const current = document.querySelector('[data-filter][aria-current = "true"]');
                    if(current != btn) {
                        current.setAttribute('aria-current', 'false');
                    }
                    btn.setAttribute('aria-current', 'true');

                    cards.forEach(card => {
                        const categories = card.getAttribute('data-category').split(" ");

                        card.style.display = filter === 'all' || categories.includes(filter) ? "" : "none";
                    });

                    displaySummary();

                    // TODO: decide if want to scroll to top?
                    document.getElementById("filter-buttons").scrollIntoView(true);
                })
            })
        }

        function displaySummary () {
            const cards = document.querySelectorAll('.asic-card-actions');
            const visibleItems = Array.from(cards).filter(el => el.checkVisibility());

            // display summary
            const summary = document.getElementById('filter-results-msg');
            let msg = `Showing ${visibleItems.length} item${visibleItems.length===1 ? '':'s'}`;
            if (summary != null) {
                summary.innerText = msg;
            } else {
                document.getElementById('filter-buttons').insertAdjacentHTML('afterend', `<p role="status" aria-atomic="true" id="filter-results-msg" class="" aria-label="">${msg}</p>`);
            }
        }

        function initializeApp() {
            const contentWrapper = document.getElementById('registerSearch');
            if (contentWrapper) {
                contentWrapper.innerHTML = generateAppHtml();
            }

            const dropdownToggle = document.getElementById('dropdown-toggle');
            const searchInput = document.getElementById('inpRegisterSearch');
            const searchButton = document.getElementById('search-button');
            const dropdownList = document.getElementById('dropdown-list');

            selectOption(defaultLocation.title);

            if (dropdownToggle) {
                dropdownToggle.addEventListener('click', () => toggleDropdown());
            }

            if (searchButton) {
                searchButton.addEventListener('click', performSearch);
            }

            if (searchInput) {
                searchInput.addEventListener('keydown', (event) => {
                    if (event.key === 'Enter') {
                        performSearch();
                        event.preventDefault();
                    }
                });
            }

            if (dropdownList) {
                dropdownList.addEventListener('click', handleOptionInteraction);
                dropdownList.addEventListener('keydown', handleOptionInteraction);
            }

            function handleOptionInteraction(event) {
                const target = event.target.closest('[role="option"]');
                if (!target) return;

                const isClick = event.type === 'click';
                const isKeySelection = event.type === 'keydown' && (event.key === 'Enter' || event.key === ' ');

                if (isClick || isKeySelection) {
                    event.preventDefault();
                    const title = target.getAttribute('data-title');
                    selectOption(title);
                } else if (event.type === 'keydown') {
                    handleOptionKeydown(event);
                }
            }

            document.addEventListener('click', (event) => {
                const selectorContainer = document.getElementById('location-selector-container');
                if (selectorContainer && !selectorContainer.contains(event.target) && isDropdownOpen) {
                    toggleDropdown(false);
                }
            });

            document.addEventListener('keydown', (event) => {
                if (event.key === 'Escape' && isDropdownOpen) {
                    toggleDropdown(false);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            initializeApp();
            initalliseFilters();
            displaySummary();
        });
        })();

		</script>			
	</head>

