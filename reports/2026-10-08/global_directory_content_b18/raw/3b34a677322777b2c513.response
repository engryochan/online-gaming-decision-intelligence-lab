    <script type="application/ld+json">
      {"@context":"http://schema.org","@graph":[{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-07T16:01:12.516Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":6},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_four-alberta-securities-commission-leaders-activity-7513629513554092032-Q8zQ","text":"Four Alberta Securities Commission leaders on how regulation is adapting to a changing capital market.\n\nOn October 27, Katrina Prokopy, Lynn Tsutsumi, and Denise Weeres joins Samir Sabharwal on the ASC Connect stage to discuss \"Evolution in our capital market: The ASC’s perspective\"\n\nRegister now and secure your seat at ASC Connect: https://lnkd.in/e-fiCVhA\n\nYour registration includes a breakfast buffet, a catered networking lunch, a cocktail reception, and a full day of discussion with the people shaping what comes next.","url":"https://www.linkedin.com/posts/alberta-securities-commission_four-alberta-securities-commission-leaders-activity-7513629513554092032-Q8zQ"},{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-07T15:20:57.873Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":6},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_an-asc-panel-has-found-that-shahin-sonny-activity-7513619385811431424-ncz4","text":"An ASC panel has found that Shahin “Sonny” Mottahed of Calgary, AB, breached Alberta securities laws. The panel found that, while CEO of a reporting issuer formerly known as Target Capital Inc., Mottahed perpetrated a fraud on Target's investors. He also caused Target to issue false or misleading disclosure documents, including certain financial statements and news releases.\nhttps://lnkd.in/dppJuEpa","url":"https://www.linkedin.com/posts/alberta-securities-commission_an-asc-panel-has-found-that-shahin-sonny-activity-7513619385811431424-ncz4"},{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-06T17:49:48.125Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":11},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_an-alberta-securities-commission-asc-panel-activity-7513294454334734349-jxxu","text":"An Alberta Securities Commission (ASC) panel has found that Terrance Anthony Sweeney breached Alberta securities laws by perpetrating a fraud on investors and making misleading or untrue statements to ASC staff.\nhttps://lnkd.in/e_cHKh-y","url":"https://www.linkedin.com/posts/alberta-securities-commission_an-alberta-securities-commission-asc-panel-activity-7513294454334734349-jxxu"},{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-06T15:05:17.268Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":0},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_as-canadians-increasingly-encounter-investment-activity-7513253052762730497-n6KJ","text":"As Canadians increasingly encounter investment information and opportunities online, the Canadian Securities Administrators (CSA) is marking Investor Education Month by encouraging investors to stay focused on long-term goals, critically assess and verify information they see online, and take steps to protect themselves from investment fraud.\nhttps://lnkd.in/ghX54irQ","url":"https://www.linkedin.com/posts/alberta-securities-commission_as-canadians-increasingly-encounter-investment-activity-7513253052762730497-n6KJ"},{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-05T22:24:31.051Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":23},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_what-will-it-take-to-build-an-innovation-activity-7513001200674504704-ExH_","text":"What will it take to build an innovation ecosystem that attracts capital, earns trust and helps companies scale?\n\nOn October 27, Claire Brownell, Eric Richmond, Louise Lee and Mark Zelmer joins Dr. Ryan Clements on the ASC Connect stage to discuss \"Building a leading and trusted innovation ecosystem in Canada\"\n\nRegister now and secure your seat at ASC Connect: https://lnkd.in/e-fiCVhA\n\nYour registration includes a breakfast buffet, a catered networking lunch, a cocktail reception, and a full day of discussion with the people shaping what comes next.","url":"https://www.linkedin.com/posts/alberta-securities-commission_what-will-it-take-to-build-an-innovation-activity-7513001200674504704-ExH_"},{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-05T15:58:11.806Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":10},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_yegstartupweek-startupweekyeg-albertainnovation-activity-7512903979874586624-82hI","text":"Heading to Edmonton Startup Week?\n\nKeep an eye out for Tonya Fleming from the Alberta Securities Commission, who will be attending events Monday to Wednesday and connecting with founders, entrepreneurs, investors and members of Alberta's innovation community.\n\nHave questions about securities regulation, capital raising or the ASC's work to support Alberta businesses? Say hello.\n\n#YEGStartupWeek #StartupWeekYEG #AlbertaInnovation","url":"https://www.linkedin.com/posts/alberta-securities-commission_yegstartupweek-startupweekyeg-albertainnovation-activity-7512903979874586624-82hI"},{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-02T16:30:01.890Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":4},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_canadafintechsymposium-fintech-innovation-activity-7511824827746324481-CzXY","text":"Heading to the Canada FinTech Symposium in Calgary on Oct. 7-8?\n \nStop by the Canadian Securities Administrators (CSA) - Autorités canadiennes en valeurs mobilières (ACVM) FinHub booth to connect with securities regulators and learn how we're working with startups, fintechs and other innovative businesses to protect investors, foster fair and efficient markets, and support responsible innovation across the country.\nWhether you're exploring digital assets or looking to grow your business, we'd love to talk to you.\n \nTonya Fleming Mohamed Z. Ryan Clements\n \n#CanadaFinTechSymposium #FinTech #Innovation #CapitalMarkets #CSAFinHub","url":"https://www.linkedin.com/posts/alberta-securities-commission_canadafintechsymposium-fintech-innovation-activity-7511824827746324481-CzXY"},{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-01T16:04:10.845Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":6},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_just-announced-new-speakers-and-early-bird-activity-7511455934326534144--UGW","text":"Just announced: new speakers and early bird rate extended\n\nOn October 27, Robert Johnston, Chris Seasons, and Hugh Sanderson join Deborah Yedlin on the ASC Connect stage to dig into one question: what will it take for Canadas energy sector to seize this generational opportunity?\n\nTicket prices will increase after October 11, so register now to lock in at a lower rate: https://lnkd.in/e7KbzYCC\n\nYour registration includes a breakfast buffet, a catered networking lunch, a cocktail reception, and a full day of discussion with the people shaping what comes next.\n\nWe look forward to welcoming you to ASC Connect 2026.","url":"https://www.linkedin.com/posts/alberta-securities-commission_just-announced-new-speakers-and-early-bird-activity-7511455934326534144--UGW"},{"@context":"http://schema.org","@type":"SocialMediaPosting","author":{"@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission"},"datePublished":"2026-10-01T15:30:00.088Z","interactionStatistic":{"@type":"InteractionCounter","interactionType":"http://schema.org/LikeAction","userInteractionCount":2},"mainEntityOfPage":"https://www.linkedin.com/posts/alberta-securities-commission_the-canadian-securities-administrators-today-activity-7511447332832542720-abya","text":"The Canadian Securities Administrators today published for comment proposed National Instrument 26-101 Information Technology System Integrity, which would establish a single framework for the information technology systems of market infrastructure entities.\n\nhttps://lnkd.in/gCpQDKdp","url":"https://www.linkedin.com/posts/alberta-securities-commission_the-canadian-securities-administrators-today-activity-7511447332832542720-abya"},{"@context":"http://schema.org","@type":"Organization","name":"Alberta Securities Commission","url":"https://ca.linkedin.com/company/alberta-securities-commission","address":{"type":"PostalAddress","streetAddress":"Suite 600, 250–5th St. SW","addressLocality":"Calgary","addressRegion":"Alberta","postalCode":"T2P 0R4","addressCountry":"CA"},"description":"The Alberta Securities Commission (ASC) is the regulatory agency responsible for administering the province's securities laws. It is entrusted to foster a fair and efficient capital market in Alberta and to protect investors.  As a member of the Canadian Securities Administrators, the ASC works to improve, coordinate and harmonize the regulation of Canada's capital markets.","numberOfEmployees":{"value":264,"@type":"QuantitativeValue"},"logo":{"contentUrl":"https://media.licdn.com/dms/image/v2/D4E0BAQGXMogCKBsCKg/company-logo_200_200/B4EZ84TkC9KQAI-/0/1783356080684/alberta_securities_commission_logo?e=2147483647&v=beta&t=hXvzM0204sSxfBeysKnGpAAkHo7lhgSxvsY9r-74D3s","description":"Alberta Securities Commission","@type":"ImageObject"},"sameAs":"https://www.asc.ca/"}]}
    </script>
  
  
      
