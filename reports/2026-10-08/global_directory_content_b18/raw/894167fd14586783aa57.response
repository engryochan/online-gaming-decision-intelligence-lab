  .light-nav .navbar-inner:before
  	{ background: var(--black); } 
    
  .light-nav .menu-button-line,
	.nav-search-button
		{ background-color: white; }   
    
  .light-nav:has([data-nav-menu-open]) .iex-group-navbar-logo { display: block; }
  .light-nav:has([data-nav-menu-open]) .iex-group-navbar-logo.white { display: none; } 
  .light-nav:has([data-nav-menu-open]) .menu-button-line { background: var(--black); }
  .light-nav .navbar-dropdown-list-bg { background: var(--black); }
  
@media only screen and (min-width: 992px) {     
  
  .light-nav .iex-group-navigation-link,
  .light-nav .navbar-search-component > .icon-button,
  .light-nav .nav-search-trigger-wrap,
