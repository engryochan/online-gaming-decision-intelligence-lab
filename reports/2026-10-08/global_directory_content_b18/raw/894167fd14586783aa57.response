<script>
// On Mozilla Firefox, update nav colors based on if mobile menu is open
document.addEventListener("DOMContentLoaded", function () {
  var isFirefox = navigator.userAgent.indexOf("Firefox") !== -1;
  if (!isFirefox) return;

  var targetElement = document.querySelector(".w-nav-menu");
  if (!targetElement) return; // guard if element isn't on the page

  var updateState = function () {
    var isOpen = targetElement.hasAttribute("data-nav-menu-open");

    // .iex-group-navbar-logo
    document.querySelectorAll(".iex-group-navbar-logo").forEach(function (el) {
      el.style.display = isOpen ? "block" : "none";
    });

    // .iex-group-navbar-logo.white
    document.querySelectorAll(".iex-group-navbar-logo.white").forEach(function (el) {
      el.style.display = isOpen ? "none" : "block";
    });

    // If you need to toggle menu button line color, uncomment and adjust:
    // document.querySelectorAll(".menu-button-line").forEach(function (el) {
    //   el.style.backgroundColor = isOpen ? "black" : "white";
    // });
  };

  // Run once on load in case attribute is already present
  updateState();

  // Observe changes to [data-nav-menu-open]
  var observer = new MutationObserver(function (mutations) {
    for (var i = 0; i < mutations.length; i++) {
      if (mutations[i].type === "attributes" && mutations[i].attributeName === "data-nav-menu-open") {
        updateState();
      }
    }
  });

  observer.observe(targetElement, {
    attributes: true,
    attributeFilter: ["data-nav-menu-open"]
  });
});
</script></div></div><div class="page-styles w-embed"><style>
  .glow-header-outer {
    -webkit-mask-image: linear-gradient(to right, black 0%, transparent 50%, black 100%);
    mask-image: linear-gradient(to right, black 0%, transparent 50%, black 100%);
  }
@media screen and (max-width: 767px) {
  .glow-header-outer {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 100%);
  }
}
