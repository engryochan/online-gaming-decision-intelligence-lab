// Set max character count on podcast titles
  
$(function () {
  $('.podcast-title').each(function() {
    var maxLength = 100;  // Set your desired max length
    var str = $(this).text();
    if (str.length > maxLength) {
      str = str.substr(0, maxLength) + '...';
      $(this).text(str);
    }
  });

  // Open links in new window for specific types
  const currentDomain = window.location.hostname;

  $('a[href]').each(function () {
    const $link = $(this);
    const href = $link.attr('href');

    // Skip empty or invalid hrefs
    if (!href || href.startsWith('#') || href.startsWith('javascript:')) return;

    const isDocumentLink = href.toLowerCase().startsWith('/documents/');
    const isDisciplinaryLink = href.toLowerCase().startsWith('/disciplinary-actions/');

    let isExternal = false;
    try {
      const url = new URL(href, window.location.origin);
      isExternal = url.hostname !== currentDomain;
    } catch (e) {
      // Ignore invalid URLs
    }

    // If it's already set to _blank OR matches our conditions, make sure it has the right attributes
    if ($link.attr('target') === '_blank' || isDocumentLink || isDisciplinaryLink || isExternal) {
      $link.attr('target', '_blank').attr('rel', 'noopener noreferrer');
    }
  });
});
</script>

<script>
document.querySelector("[data-js='copyright-year']").innerHTML = new Date().getFullYear();
// Sent body to overflow hidden on first click of hamburger icon
$('.nav-menu-button').click(function() {
  var clicks = $(this).data('clicks');
  if (clicks) {
     $("body").css("overflow", "auto");
  } else {
     $("body").css("overflow", "hidden");
  }
  $(this).data("clicks", !clicks);
});

// Click on the hamburger icon whenever you click on the greyed out part  
if (window.matchMedia('(max-width: 991px)').matches) {  
	$( ".navigation-link" ).click(function() {
		$( ".nav-menu-button" ).click();
	});
}  
</script>

<script>
// jQuery code to add/remove class "is-active" to elements with [mobile-search="content"] attribute

$(document).ready(function() {
  // When input with [mobile-search="trigger"] is focused or active
  $('[mobile-search="trigger"]').on('focus', function() {
    $('[mobile-search="content"]').addClass('is-active');
  });

  // When input with [mobile-search="trigger"] is no longer focused or active
  $('[mobile-search="trigger"]').on('blur', function() {
    $('[mobile-search="content"]').removeClass('is-active');
  });
});
  
// Fix superscript elements
document.addEventListener('DOMContentLoaded', () => {
  const walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT);
  const toPatch = [];
  while (walker.nextNode()) {
    const n = walker.currentNode;
    if (n.nodeValue.includes('™')) toPatch.push(n);
  }
  toPatch.forEach(n => {
    const span = document.createElement('span');
    span.innerHTML = n.nodeValue.replace(/™/g, '<span class="tm-mark">™</span>');
    n.parentNode.replaceChild(span, n);
  });
});
</script>

<!-- TEMP Domain Handler -->
<script>
(function () {
  "use strict";
  if (location.hostname !== "iex-project-harmony.webflow.io") return;
  document.querySelectorAll("a[href]").forEach((link) => {
    try {
      const url = new URL(link.href);
      if (["iex.io", "www.iex.io", "iexexchange.io", "www.iexexchange.io"].includes(url.hostname)) {
        url.hostname = "iex-project-harmony.webflow.io";
        link.href = url.toString();
      }
    } catch (e) {
    }
  });
})();
</script></body></html>