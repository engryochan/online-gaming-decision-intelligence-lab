ext-gray-500 text-xs mt-0.5 line-clamp-1">Open a support ticket</div></div><svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg></a></div></div></div></div></div></div></header><div class="transition-all ease-out " style="opacity:0;transform:translateY(25px);transition-duration:500ms;transition-timing-function:cubic-bezier(0.16, 1, 0.3, 1)"><section class="pt-32 pb-4 bg-gradient-to-b from-gray-50 to-white"><div class="max-w-7xl mx-auto px-6 text-center"><nav class="flex items-center space-x-2 text-sm text-white/60 mb-6"><a class="hover:text-brand-gold-400 transition-colors flex items-center" href="/"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 576 512" class="w-4 h-4" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M280.37 148.26L96 300.11V464a16 16 0 0 0 16 16l112.06-.29a16 16 0 0 0 15.92-16V368a16 16 0 0 1 16-16h64a16 16 0 0 1 16 16v95.64a16 16 0 0 0 16 16.05L464 480a16 16 0 0 0 16-16V300L295.67 148.26a12.19 12.19 0 0 0-15.3 0zM571.6 251.47L488 182.56V44.05a12 12 0 0 0-12-12h-56a12 12 0 0 0-12 12v72.61L318.47 43a48 48 0 0 0-61 0L4.34 251.47a12 12 0 0 0-1.6 16.9l25.5 31A12 12 0 0 0 45.15 301l235.22-193.74a12.19 12.19 0 0 1 15.3 0L530.9 301a12 12 0 0 0 16.9-1.6l25.5-31a12 12 0 0 0-1.7-16.93z"></path></svg></a><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 320 512" class="w-3 h-3" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z"></path></svg><a class="hover:text-brand-gold-400 transition-colors" href="/listing">Listing</a><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 320 512" class="w-3 h-3" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z"></path></svg><span class="text-white/40">Compare Markets</span></nav><h1 class="text-4xl md:text-6xl font-light mb-6 text-gray-900 leading-tight tracking-tight">Compare Markets</h1><p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed font-light">Compare different listing options and market segments available on MERJ Exchange.</p></div></section></div><main class="max-w-7xl mx-auto px-6 pb-12 "><div class="space-y-12"><div class="bg-white/90 backdrop-blur-lg rounded-2xl p-8 border border-gray-200 shadow-sm"><h3 class="text-2xl font-bold text-gray-900 mb-6">Entry Requirements</h3><div class="overflow-x-auto"><table class="w-full text-left"><thead><tr class="border-b border-white/20"><th class="text-white font-semibold p-3">Requirement</th><th class="text-white font-semibold p-3">VCAP Board</th><th class="text-white font-semibold p-3">SME Board</th><th class="text-white font-semibold p-3">Main Board</th></tr></thead><tbody class="text-gray-700"><tr class="border-b border-white/10"><td class="p-3 font-medium">Domicile</td><td class="p-3">Recognized Jurisdictions</td><td class="p-3">Any</td><td class="p-3">Any</td></tr><tr class="border-b border-white/10"><td class="p-3 font-medium">Admission</td><td class="p-3">Listing Particulars or Prospectus to FSA</td><td class="p-3">Listing Particulars or Prospectus to FSA</td><td class="p-3">Listing Particulars or Prospectus to FSA</td></tr><tr class="border-b border-white/10"><td class="p-3 font-medium">Duration</td><td class="p-3">N/A</td><td class="p-3">1 Year</td><td class="p-3">3 Years</td></tr><tr class="border-b border-white/10"><td class="p-3 font-medium">Financial Statements</td><td class="p-3">N/A</td><td class="p-3">Most recent year audited</td><td class="p-3">Most recent 3 years audited</td></tr><tr class="border-b border-white/10"><td class="p-3 font-medium">Minimum Free Float*</td><td class="p-3">10% (min. 5 persons)</td><td class="p-3">15% (min. 20 persons)</td><td class="p-3">25% (min. 60 persons)</td></tr><tr class="border-b border-white/10"><td class="p-3 font-medium">Lock-in Period</td><td class="p-3">Until funding milestones reached</td><td class="p-3">First 6 months of listing</td><td class="p-3">N/A</td></tr><tr class="border-b border-white/10"><td class="p-3 font-medium">Revenue Criteria</td><td class="p-3">N/A</td><td class="p-3">N/A</td><td class="p-3">N/A</td></tr><tr><td class="p-3 font-medium">Regulation</td><td class="p-3">Regulated by MERJ and FSA</td><td class="p-3">Regulated by MERJ and FSA</td><td class="p-3">Regulated by MERJ and FSA</td></tr></tbody></table></div><p class="text-gray-600 text-sm mt-4">*A derogation from these fixed requirements may be permitted where the issue is anticipated to trade at a rate that allows for sufficient liquidity.</p></div><div class="bg-white/90 backdrop-blur-lg rounded-2xl p-8 border border-gray-200 shadow-sm"><h3 class="text-2xl font-bold text-gray-900 mb-6">Ongoing Obligations</h3><div class="overflow-x-auto"><table class="w-full text-left"><thead><tr class="border-b border-white/20"><th class="text-white font-semibold p-3">Obligation</th><th class="text-white font-semibold p-3">VCAP Board</th><th class="text-white font-semibold p-3">SME Board</th><th class="text-white font-semibold p-3">Main Board</th></tr></thead><tbody class="text-gray-700"><tr class="border-b border-white/10"><td class="p-3 font-medium">Corporate Governance</td><td class="p-3">Corporate Governance Report (Directive on Corporate Governance)</td><td class="p-3">Corporate Governance Report (Directive on Corporate Governance)</td><td class="p-3">Corporate Governance Report (Directive on Corporate Governance)</td></tr><tr class="border-b border-white/10"><td class="p-3 font-medium">Transactions</td><td class="p-3">Directive on Ad Hoc Reporting</td><td class="p-3">Directive on Ad Hoc Reporting</td><td class="p-3">Directive on Ad Hoc Reporting</td></tr><tr><td class="p-3 font-medium">Regular Reporting</td><td class="p-3">Directive on Regular Reporting Obligations</td><td class="p-3">Directive on Regular Reporting Obligations</td><td class="p-3">Directive on Regular Reporting Obligations</td></tr></tbody></table></div></div><div class="grid grid-cols-1 md:grid-cols-3 gap-6"><div class="bg-white/90 backdrop-blur-lg rounded-2xl p-8 border border-gray-200 shadow-sm"><h3 class="text-2xl font-bold text-gray-900 mb-4">Speed to Market</h3><p class="text-gray-700 mb-4">List in as little as 30 days compared to 6+ months elsewhere.</p><ul class="text-gray-600 space-y-2"><li>• Listing Committee available 5 days per week</li><li>• Streamlined application process</li><li>• Fast-track options available</li><li>• Dedicated support team</li></ul></div><div class="bg-white/90 backdrop-blur-lg rounded-2xl p-8 border border-gray-200 shadow-sm"><h3 class="text-2xl font-bold text-gray-900 mb-4">Cost Efficiency</h3><p class="text-gray-700 mb-4">Competitive listing fees and ongoing costs.</p><ul class="text-gray-600 space-y-2"><li>• Competitive listing and CSD fees</li><li>• Transparent fee structure</li><li>• No hidden costs</li><li>• Value-for-money proposition</li></ul></div><div class="bg-white/90 backdrop-blur-lg rounded-2xl p-8 border border-gray-200 shadow-sm"><h3 class="text-2xl font-bold text-gray-900 mb-4">Global Reach</h3><p class="text-gray-700 mb-4">Access to international investor base.</p><ul class="text-gray-600 space-y-2"><li>• 180+ countries permitted</li><li>• International recognition</li><li>• Cross-border accessibility</li><li>• Global trading hours</li></ul></div></div><div class="bg-white/90 backdrop-blur-lg rounded-2xl p-8 border border-gray-200 shadow-sm"><h3 class="text-2xl font-bold text-gray-900 mb-6">International Recognition</h3><div class="grid grid-cols-1 md:grid-cols-2 gap-6"><div><h4 class="text-lg font-semibold text-gray-900 mb-3">UK HMRC Recognition</h4><p class="text-gray-700 mb-4">The UK tax authority, His Majesty&#x27;s Revenue &amp; Customs (HMRC) has designated MERJ Exchange a &quot;Recognised Stock Exchange&quot; under Section 1005 of the Income Tax Act 2007.</p><p class="text-gray-600">This permits UK pensions and SIPPs to trade securities on our Debt Market without incurring tax liability in the UK.</p></div><div><h4 class="text-lg font-semibold text-gray-900 mb-3">US OTC Markets</h4><p class="text-gray-700 mb-4">MERJ Exchange is a &quot;Qualified Foreign Exchange&quot; by the US OTC Markets (the largest OTC Market in the USA). Non-US companies listed on MERJ qualify for expedited quotation processes.</p><p class="text-gray-600">MERJ-listed issuers only need to meet MERJ Listing Rules requirements without additional US reporting obligations.</p></div></div></div><div class="bg-gradient-to-r from-brand-gold-400/10 to-brand-gold-600/10 rounded-2xl p-8 border border-brand-gold/30"><h3 class="text-2xl font-bold text-gray-900 mb-6">Need Help Choosing?</h3><p class="text-gray-700 mb-6">Use our Compare Markets tool to help you decide which market segment is best suited for your company&#x27;s specific needs and circumstances.</p><div class="flex flex-col sm:flex-row gap-4"><a class="btn-primary" href="/listing/compare-markets#comparison">Compare Markets Tool</a><a class="btn-secondary" href="/contact">Contact Support</a></div></div></div></main></div><!--$--><!--/$--></main></div></div><footer class="relative z-10 mt-auto bg-white border-t border-gray-100 overflow-hidden"><div class="absolute inset-0 bg-gradient-to-b from-gray-50/50 to-white pointer-events-none"></div><div class="max-w-7xl mx-auto py-8 lg:py-12 px-6 relative z-10"><div class="grid grid-cols-1 lg:grid-cols-6 gap-8 lg:gap-10"><div class="flex flex-col items-center lg:items-start"><img alt="MERJ Exchange" width="72" height="90" decoding="async" data-nimg="1" class="h-18 w-auto mb-6" style="color:transparent" srcSet="/_next/image?url=%2Fimages%2Ffavicon%2Fmerj-logo.png&amp;w=96&amp;q=75 1x, /_next/image?url=%2Fimages%2Ffavicon%2Fmerj-logo.png&amp;w=256&amp;q=75 2x" src="/_next/image?url=%2Fimages%2Ffavicon%2Fmerj-logo.png&amp;w=256&amp;q=75"/><div class="flex space-x-4 mb-12"><a href="https://sc.linkedin.com/company/merj-x" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-50 hover:bg-gray-100 transition-colors"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" class="text-gray-600 hover:text-gray-900 transition-colors text-lg" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"></path></svg></a><a href="mailto:investor.relations@merj.exchange" aria-label="Email" class="h-10 w-10 flex items-center justify-center rounded-full bg-gray-100 hover:bg-brand-gold/20 transition-colors"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" class="text-gray-700 hover:text-brand-gold transition-colors" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill="none" d="M0 0h24v24H0z"></path><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"></path></svg><