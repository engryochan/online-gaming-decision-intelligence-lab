/* 2. FORCE MOBILE PAGINATION VISIBILITY (Fixes hidden buttons) */
@media only screen and (max-width: 768px) {
    .pagination, .wp-pagenavi, .nav-links, .page-numbers {
        display: block !important;
        visibility: visible !important;
        height: auto !important;
        clear: both !important;
        margin-top: 20px !important;
    }
}

/* 3. HORIZONTAL SCROLL FOR TABLE (Fixes cut-off content in portrait) */
@media screen and (max-width: 768px) {
    /* Apply ONLY if we are NOT on the calculator or homepage */
    /* We target the container directly */
    .searchdatabox {
        width: 100% !important;
        max-width: 100vw !important;
        overflow-x: auto !important;
