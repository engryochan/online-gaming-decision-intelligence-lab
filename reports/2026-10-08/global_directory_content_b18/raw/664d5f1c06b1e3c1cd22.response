    .fixed-section-header {
        position: static !important; 
        width: 100% !important;
    }
}

/* 4. EMERGENCY FIX FOR CALCULATOR PAGE */
/* This specifically resets the calculator layout if it gets broken by the above */
.page-id-805 .searchdatabox, .page-id-805 .headersearchdata, /* Adjust ID if needed */
.home .searchdatabox, .home .headersearchdata {
    width: auto !important;
    min-width: 0 !important;
