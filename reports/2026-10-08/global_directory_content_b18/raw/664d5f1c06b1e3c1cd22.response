	var divToPrint1 = document.getElementById('divToPrint1');  
	
	var popupWin = window.open('', '', 'width=800,height=600');
	
	popupWin.document.open();
	
	popupWin.document.write('<div>' + divToPrint1.innerHTML + '</div>');
	
	popupWin.location.reload();
	popupWin.focus();
	popupWin.print();
	popupWin.close();
	}
	</script>

