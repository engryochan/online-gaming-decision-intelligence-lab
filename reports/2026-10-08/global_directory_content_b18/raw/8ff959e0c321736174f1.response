                      <ul class="publications">
                              <li class="library-item publication-item post">

  <div class="library-item__heading">

    <span class="library-item__date library-item__date--publish">
      29 April 2024

          </span>

    <h3 class="library-item__title"><a href="/en/2024/04/new-sftr-emir-procedures-available-for-notification-forms-and-intra-group-exemption-requests/">New SFTR &#038; EMIR procedures available for notification forms and intra-group exemption requests</a></h3>
          <div class="library-item__excerpt">
        <span class="subtitle"></span>
      </div>
      </div>

