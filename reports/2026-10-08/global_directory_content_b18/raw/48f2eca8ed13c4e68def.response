<script>
$(function() {
  var sliderAlways = null;
  var sliderSponly = null;
  // =========================
  // 取扱実績　スライダー
  // =========================
  function initSliderAlways() {
    var winW = $(window).width();

    if (sliderAlways) {
        sliderAlways.destroySlider();
        sliderAlways = null;
    }

    width = winW * 0.9;
    if (winW >= 768) {
        sliderAlways = $('.slider-always').bxSlider({
            mode:'horizontal',
            moveSlides:1,
            touchEnabled:false,
            minSlides:3,
            maxSlides:3,
            slideMargin:20,
            infiniteLoop:true,
            slideWidth:300,
            startSlide: 0,// 1番目のスライドを初期位置に設定（0から始まる）
            moveSlides: 1,
            auto:false,
            speed:400,
            nextText:'',
            prevText:'',
            pager:true,
            pagerType:'full',
            controls:true,
            useCSS:'false',
        });
    } else {
        sliderAlways = $('.slider-always').bxSlider({
            mode:'horizontal',
            moveSlides:1,
            touchEnabled:false,
            minSlides:1,
            maxSlides:1,
            slideMargin:0,
            infiniteLoop:true,
            slideWidth:width,
            moveSlides: 1,
            auto:false,
            speed:400,
            nextText:'',
            prevText:'',
            pager:true,
            pagerType:'full',
            controls:true,
            useCSS:'false',
        });
    }
  }
  // =========================
  // お申し込み方法　スライダー（スマホのみ）
  // =========================
  function initSliderSponly() {
    var winW = $(window).width();

    if (sliderSponly) {
        sliderSponly.destroySlider();
        sliderSponly = null;
    }

    width = winW * 0.9;
    // スマホのみ
    if (winW < 768) {
      // 一度破棄されている場合でも再生成する
      sliderSponly = $('.slider-sponly').bxSlider({
            mode:'horizontal',
            moveSlides:1,
            touchEnabled:false,
            minSlides:1,
            maxSlides:1,
            slideMargin:0,
            infiniteLoop:false, //ループ無し
            slideWidth:width,
            moveSlides: 1,
            auto:false,
            speed:400,
            nextText:'',
            prevText:'',
            pager:true,
            pagerType:'full',
            controls:true,
            useCSS:'false',
      });
    }
  }
  // =========================
  // 初回実行
  // =========================
  initSliderAlways();
  initSliderSponly();
  // =========================
  // リサイズ対応（デバウンス）
  // =========================
  var timer;
  $(window).on('resize orientationchange', function() {
    clearTimeout(timer);
    timer = setTimeout(function() {
      initSliderAlways();
      initSliderSponly();
    }, 150);
  });
});

</script>
<!-- ======================== JavaScript =================================== -->

