<script>
$(document).ready(function () {
    // Initially hide the section
    $('.latest-update-section').hide();
});
// Set a timeout to show the section after 5 seconds (5000ms)

window.onload = function () {
//    setTimeout(function () {
    $('.quick-link').fadeIn();  // You can use fadeIn for a smooth transition
//    }, 1000);
};
$(window).on('scroll', function () {
    var windowHeight = $(window).height();
    var scrollTop = $(window).scrollTop();

    // Welcome Section
    var welcomeSection = $('.welcome-sec');
    var welcomeSectionTop = welcomeSection.offset().top;
    if (scrollTop + windowHeight > welcomeSectionTop) {
        welcomeSection.fadeIn();
    }

    // Latest Update Section
    var latestUpdateSection = $('.latest-update-section');
    var latestUpdateSectionTop = latestUpdateSection.offset().top;
    if (scrollTop + windowHeight > latestUpdateSectionTop) {
        latestUpdateSection.fadeIn();
    }

    // Publication Section
    var publicationSection = $('.publication-section');
    var publicationSectionTop = publicationSection.offset().top;
    if (scrollTop + windowHeight > publicationSectionTop) {
        publicationSection.fadeIn();
    }

    // Services Section
    var servicesSection = $('.services-sec');
    var servicesSectionTop = servicesSection.offset().top;
    if (scrollTop + windowHeight > servicesSectionTop) {
        servicesSection.fadeIn();
    }

    // Footer Section
    var footerSection = $('.footer-section');
    var footerSectionTop = footerSection.offset().top;
    if (scrollTop + windowHeight > footerSectionTop) {
        footerSection.fadeIn();
    }
});


</script>
        
        <script>
