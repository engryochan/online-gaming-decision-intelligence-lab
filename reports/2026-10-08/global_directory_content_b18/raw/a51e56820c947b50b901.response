        <script>
            $(window).scroll(function () {
                if ($(this).scrollTop() > 80) {
                    $('#back-top').css("display", "flex");
                } else {
                    $('#back-top').css("display", "none");
                }
            });
            $('#back-top').click(function () {
                $('body,html').animate({
                    scrollTop: 0
                }, 500);
                return false;
            });
        </script>
