<!DOCTYPE html>
<html>
<head>
  <title>The page you were looking for doesn't exist (404)</title>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <link href='https://fonts.googleapis.com/css?family=Roboto:300,100' rel='stylesheet' type='text/css'>

  <style>
  body {
    background-color: #2c3d4b;
    color: white;
    text-align: center;
    font-family: 'Roboto', sans-serif;
    width: 100%;
    margin: 0;
  }

  .dialog {
    margin: auto;
    margin-top: 12%;
  }

  h1.error-no {
    color: white;
    display: inline-block;
    border-bottom: 1px solid #ddd;
    font-weight: 300;
    font-size: 153px;
    margin-top: 0;
    margin-bottom: 0;
    line-height: 180px;
  }

  h1.error-msg {
    font-weight: normal;
  }

  p.content {
    padding-left: 20px;
    padding-right: 20px;
  }

  .btn-group {
    margin-top: 50px;
  }

  .btn-group a {
    background-color: #00AACF;
    color: white;
    padding: 10px 50px;
    display: inline-block;
    margin-left: 20px;
    margin-right: 20px;
    border-radius: 10px;
    text-decoration: none;
    margin-bottom: 20px;
  }

  .btn-group a:hover {
    background-color: #00D1FF;
  }

  .btn-group a.previous {
    background-color: #608EB4;
  }

  .btn-group a.previous:hover{
    background-color: #4A93CF;
  }

  div.footer {
    font-size: 12px;
    margin-top: 30px;
    padding-bottom: 50px;
  }

  </style>
</head>

<body>
  <!-- This file lives in public/404.html -->
  <div class="dialog">
    <div>
      <h1 class="error-no">404</h1>
      <h1 class="error-msg">PAGE NOT FOUND</h1>
      <p class="content">
        Unfortunately we’re having trouble loading the page you are looking for.<br>
        Please wait a moment and try again or use action below.
      </p>
    </div>

    <div class="btn-group">
      <a href="/">
        Back to Home
      </a>

      <a href="javascript:history.go(-1)" class="previous">
        Previous Page
      </a>
    </div>

    <div class="footer">
      Copyright ©All rights Reserved. UZSE
    </div>
  </div>
</body>
</html>
