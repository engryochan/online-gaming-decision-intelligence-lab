                                    <td><strong  >Purchase Information</strong></td>
                                    <td><ul  > <li>Third-party marketing and advertising technology providers</li> <li>Third-party advertising partners including social media platforms</li> <li>Data analytics providers</li> </ul></td>
                                </tr>
                                <tr>
                                    
                                    <td><strong  >Biometric Information</strong></td>
                                    <td><ul  > <li>None</li> </ul></td>
                                </tr>
                                <tr>
                                    
                                    <td><strong  >Internet or Online Information</strong></td>
                                    <td><ul  > <li>Third-party marketing and advertising technology providers</li> <li>Third-party advertising partners including social media platforms</li> <li>Data analytics providers</li> </ul></td>
                                </tr>
                                <tr>
                                    
                                    <td><strong  >Geolocation Data</strong></td>
                                    <td><ul  > <li>Third-party marketing and advertising technology providers</li> <li>Third-party advertising partners including social media platforms</li> </ul> <ul  > <li>Data analytics providers</li> </ul></td>
                                </tr>
                                <tr>
                                    
                                    <td><strong  >Audio and Visual Information</strong></td>
                                    <td><ul  > <li>None</li> </ul></td>
                                </tr>
