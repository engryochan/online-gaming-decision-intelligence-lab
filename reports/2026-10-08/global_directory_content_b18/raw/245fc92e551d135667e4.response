                                </tr>
                                <tr>
                                    
                                    <td><strong  >Personal Information</strong></td>
                                    <td><ul  > <li>Third-party marketing and advertising technology providers</li> <li>Third-party advertising partners including social media platforms</li> </ul> <ul  > <li>Data analytics providers</li> </ul></td>
                                </tr>
                                <tr>
                                    
                                    <td><strong  >Characteristics of Protected Classes</strong></td>
                                    <td><ul  > <li>None</li> </ul></td>
                                </tr>
