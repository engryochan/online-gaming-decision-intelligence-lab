                                    <td><ul  > <li>Third-party marketing and advertising technology providers</li> <li>Third-party advertising partners including social media platforms</li> <li>Data analytics providers</li> </ul></td>
                                </tr>
                                <tr>
                                    
                                    <td><strong  >Sensitive Personal Information</strong></td>
                                    <td><ul  > <li>None</li> </ul></td>
                                </tr>
