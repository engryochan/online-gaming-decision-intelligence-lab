                        <tr>
                            <td>
                                {{emisora}}
                            </td>
                            <td>
                                <a class="lbxButton" href="{{documentoHtml}}">{{descripcionTipoValor}}</a>
                            </td>
                            <td data-order="{{fechaRecepcion}}">{{prettyDate}}</td>
                        </tr>
                    </tbody>
                </table>
                    
                    
            </div>
            <div class="procedures">
                <div class="content-area">
                    <h3>Listing Filings</h3>
                    <table id='proceduresTable' class="table">
                        <thead>
                            <tr>
                                <th class="cell-01">RECEPTION DATE</th>
                                <th class="cell-26">TICKER</th>
                                <th class="cell-03">ISSUER</th>
                                <th class="cell-04">SETTLOR</th>
                                <th class="cell-05">Market & Asset Class</th>
                                <th class="cell-25">NO.</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td data-order="{{fechaRecepcion}}">{{prettyDate}}</td>
                                <td>{{cveEmisor}}</td>
                                <td>{{emisor}}</td>
                                <td>{{fideicomitente}}</td>
                                <td><strong>{{mercado}}</strong> {{tipoValor}}</td>
                                <td style="width:122px !important;">
                                    <strong class="number">{{numFolio}}</strong>
                                    <a href="#" class="ico-search">search</a>
                                    <input type="hidden" value='{{params}}'/>
                                    <input class="idSolicitud" type="hidden" value='{{idSolicitud}}'/>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
                
            </div>
        </div>
    </div>
</div>

