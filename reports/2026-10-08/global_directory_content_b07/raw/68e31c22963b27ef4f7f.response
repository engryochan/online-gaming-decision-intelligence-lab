-framer-name="Right"><div class="framer-k3c8v4" data-framer-name="Top"><div class="ssr-variant"><div class="framer-1hkplgl-container"><div class="framer-jKdaA framer-vKaqi framer-yFxCB framer-1i4pe8t framer-v-z4w8ge" data-framer-name="Left" style="max-width:100%;width:100%"><div class="framer-jrmxcu-container" style="will-change:transform;opacity:0;transform:translateY(6px)"><div class="framer-AJkeJ framer-o1d2vb framer-v-173zn24" data-framer-name="Blue" style="background-color:var(--token-c5c9aa95-f17d-48cf-a689-d68163939d3c, rgba(14, 165, 233, 0.1));border-bottom-left-radius:20px;border-bottom-right-radius:20px;border-top-left-radius:20px;border-top-right-radius:20px"><div class="framer-7e1p87" data-framer-component-type="RichTextContainer" style="--extracted-tcooor:var(--token-fc964bdf-75a2-46d8-b021-325d92ab4404, rgb(2, 132, 199));--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;transform:none"><div class="framer-text" style="--font-selector:SW50ZXItTWVkaXVt;--framer-font-size:calc(var(--framer-root-font-size, 1rem) * 0.65);--framer-font-weight:500;--framer-text-color:var(--extracted-tcooor, var(--token-fc964bdf-75a2-46d8-b021-325d92ab4404, rgb(2, 132, 199)))">Rebalancing &amp; FX hedging</div></div></div></div><div class="framer-1uq3tjv" data-framer-component-type="RichTextContainer" style="--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;will-change:transform;opacity:0;transform:translateY(6px)"><h2 class="framer-text framer-styles-preset-eq3mzy" data-styles-preset="QjlcTNH7l" style="--framer-text-alignment:left">Alloq</h2></div><div class="framer-15is7j1" data-framer-component-type="RichTextContainer" style="--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;will-change:transform;opacity:0;transform:translateY(6px)"><p class="framer-text framer-styles-preset-1qn0p29" data-styles-preset="RPKMKmWdI" style="--framer-text-alignment:left">Europe's #1 SaaS for rebalancing and currency overlay in Europe. Now available in Australia, Singapore, New Zealand and Canada.</p></div></div></div></div></div><div class="framer-tsdt36" data-border="true" data-framer-name="Bottom"><div class="ssr-variant"><div class="framer-1n752bs-container"><div class="framer-UrGNg framer-2xHQ9 framer-ybbBp framer-ijuywu framer-v-ijuywu" data-framer-name="Left" style="width:100%;will-change:transform;opacity:0;transform:translateY(6px)"><div class="framer-1sy10md" data-framer-component-type="RichTextContainer" style="--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;transform:none"><h3 class="framer-text framer-styles-preset-hvov9g" data-styles-preset="aInK7WMHV" dir="auto">Allocation and Rebalancing</h3></div><div class="framer-1o2rcza" data-framer-component-type="RichTextContainer" style="--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;transform:none"><p class="framer-text framer-styles-preset-1c3tlav" data-styles-preset="eJ4RZIpPO">The Alloq module that performs the entire asset allocation process for multi-asset portfolios. From proxy-based rebalancing to illiquid compensations for the total portfolio, with support for a Total Portfolio Approach (TPA).</p></div></div></div></div><div class="ssr-variant"><div class="framer-sqfn2l-container"><div class="framer-UrGNg framer-2xHQ9 framer-ybbBp framer-ijuywu framer-v-ijuywu" data-framer-name="Left" style="width:100%;will-change:transform;opacity:0;transform:translateY(6px)"><div class="framer-1sy10md" data-framer-component-type="RichTextContainer" style="--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;transform:none"><h3 class="framer-text framer-styles-preset-hvov9g" data-styles-preset="aInK7WMHV" dir="auto">FX Hedging and Overlay</h3></div><div class="framer-1o2rcza" data-framer-component-type="RichTextContainer" style="--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;transform:none"><p class="framer-text framer-styles-preset-1c3tlav" data-styles-preset="eJ4RZIpPO">Manage and control your FX risk by providing real-time insight into the current exposure, hedge and mismatch. Alloq can create orders to minimize currency risk, all through Straight-Through Processing (STP)</p></div></div></div></div></div></div></div></div><section class="framer-qkuc57" data-framer-name="KPIs van Alloq" id="statistics-1"><div class="framer-ssw4h8" data-framer-name="Content"><div class="framer-nfow9i" data-framer-name="Statistics"><div class="framer-8knuws" data-framer-name="Left"><div class="ssr-variant"><div class="framer-1vw14wg-container"><div class="framer-jKdaA framer-vKaqi framer-yFxCB framer-1i4pe8t framer-v-17b7or2" data-framer-name="Left No Badge" style="max-width:100%;width:100%"><div class="framer-1uq3tjv" data-framer-component-type="RichTextContainer" style="--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;will-change:transform;opacity:0;transform:translateY(6px)"><h2 class="framer-text framer-styles-preset-eq3mzy" data-styles-preset="QjlcTNH7l" style="--framer-text-alignment:left">In numbers</h2></div><div class="framer-15is7j1" data-framer-component-type="RichTextContainer" style="--framer-link-text-color:rgb(0, 153, 255);--framer-link-text-decoration:underline;will-change:transform;opacity:0;transform:translateY(6px)"><p class="framer-text framer-styles-preset-1qn0p29" data-styles-preset="RPKMKmWdI" style="--framer-text-alignment:left">Alloq Institutional is responsible for rebalancing and FX hedging the total portfolio of our clients with no limits in asset classes. With support of EDM-like functionalities for data handling.</p></div></div></div></div></div><div class="framer-84m8a2" data-framer-name="Right"><div class="ssr-variant hidden-cuogo0"><div class="framer-b2edtn-container"><div class="framer-6ifs6 framer-Ozw3q framer-ybbBp framer-1w22sas framer-v-1w22sas" data-framer-name="Left" style="width:100%"><di