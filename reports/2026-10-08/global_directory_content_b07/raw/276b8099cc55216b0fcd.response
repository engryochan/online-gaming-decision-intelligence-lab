            <div class="col-lg-8 content-page-wrapper" id="content-wrapper">
                <h1>Reporting Issuers List</h1>

                
                

                
                <p>Listed below are reporting issuers that must make periodic filings with the BC Securities Commission under the <em>Securities Act</em>, R.S.B.C. 1996, c. 418, the Securities Regulation, B.C. Reg. 196/97 and the Securities Rules, B.C. Reg. 194/97.</p>
<p>Information on management cease trade orders and failure to file cease trade orders are found on SEDAR+ under the &ldquo;Regulatory Actions&rdquo; tab of an issuers profile.  <a href="https://www.sedarplus.ca/home/" target="_blank">SEDAR+</a> includes cease trade orders for failure to file as well as cease trade orders found in enforcement decisions, settlements, and temporary orders from companies and individuals from BC and other Canadian jurisdictions. Historical company CTO coverage begins in 1971 for some jurisdictions.</p>
<p>Research issuer information using <a href="/search">Advanced Search</a>. You can customize your search by category to retrieve information about issuers only.</p>
<p><a href="https://eservices.bcsc.bc.ca/eservices/docview/temp/BCSC_ReportingIssuers.pdf?t=1591900504955" target="_blank">View a PDF of the BCSC Reporting Issuers List</a></p>
<p><strong>Note:</strong> List below shows the company or person(s) that currently report in B.C. To view a complete listing select their name.</p>

                


<div class="main-search-wrapper">
    <form id="inlineSearchBoxForm" class="single-search-wrapper clearfix" data-searchUrl="https://gateway.bcsc.bc.ca/api/Search" data-searchTableUrl="https://gateway.bcsc.bc.ca/api/SearchTable" data-searchIndexName="sitecore_pub_index_MainAlias" data-autoCompleteUrl="https://gateway.bcsc.bc.ca/api/AutoComplete">
        <label>Reporting Issuers List</label>
        <div class="input-group">
            <input name="inlineSearchBox" id="search-box-term" autocomplete="off" class="ui-autocomplete-input form-control" type="text" placeholder="Search" aria-label="Search">
            <button class="close-icon hidden" type="reset">X</button>

            <div class="input-group-append d-block d-sm-none">
                <button id="inlineSearchSubmit" class="btn btn-outline search-icon-link" type="submit">
                </button>
            </div>

            <button id="inlineSearchSubmit" class="btn btn-primary d-none d-sm-block" type="submit">
                Search
            </button>

        </div>
        <div id="inline-refine-search-wrapper" class="inline-refine-search-wrapper clearfix">
            
        </div>
    </form>
    
    <div class="search-sync-last-updated"></div>
    <div class="search-results-wrapper clearfix">
        <div class="table-wrapper width-100 ">
            <table id="inlineSearchTable" class="display ui celled width-100">
                <thead><tr></tr></thead>
            </table>
        </div>
    </div>
</div>

<script>
    var searchUrl = $("#inlineSearchBoxForm").data("searchurl");
    var searchTableUrl = $("#inlineSearchBoxForm").data("searchtableurl");
    var searchIndexName = $("#inlineSearchBoxForm").data("searchindexname");
    var autoCompleteUrl = $("#inlineSearchBoxForm").data("autocompleteurl");

    var searchTable;
    var columnData = [];
    var columnDefData = [];
    var filterTags = [];
    var templateIds = [];
    var flags = [];
    var searchFields = [];
    var orderBy = [];
    var facets = [];
    var facetDivs = [];
    var autoSearchFields = [];

    columnData = [{ "data": "title", "displayName": "Issuer Name" },{ "data": "reportingIssuerPrincipal", "displayName": "Principal" },{ "data": "reportingIssuerDefaultFlag", "displayName": "Default" }];
templateIds = ['{D9FFB8AF-C457-4144-AB56-FE7ECFADFA81}'];
flags = ['reportingflag_b=true'];
orderBy = [[0,'asc']];
columnDefData = [
            {
                targets: [0],
                render: function (data, type, row) {
                    return "<a href='" + row.url + "'>" + data + "</a>";
                }
            }
        ];

    $(document).ready(function () {

        // load the facets specified on the page
        $(".facet").each(function (facet, value) {
            var newFacet = {
                DivId: $(value).attr('id'),
                Title: $(value).data("title"),
                FieldName: $(value).data("fieldname"),
                SelectedValues: new Array(),
                IsCollectionField: $(value).data("is-collection-field"),
                UsesAndOperator: $(value).data("uses-and-operator")
            };
            facets[newFacet.FieldName] = newFacet;
            facetDivs[newFacet.DivId] = newFacet.FieldName;
        });
        loadFacets();

        //column headers must exist in order to generate datatables
        if (columnData.length) {
            loadDataTable();
        } else {
            console.log("Datatable cannot be generated - Column data(data & displayName) is missing from the control's rendering parameters");
        }

        $("#search-box-term").autocomplete({
            minLength: 3,
            select: function (event, ui) {
                //trigger search on autocomplete selection
                $("#search-box-term").val(ui.item.value);
                $("#inlineSearchSubmit").focus();
            },
            source: function (request, response) {
                if(autoCompleteUrl == null)
                    autoCompleteUrl = $("#inlineSearchBoxForm").data("autocompleteurl");

                var jsonQueryData = {
                    MaxResults: 5,
                    Term: request.term,
                    IndexName: searchIndexName,
                    Tags: filterTags,
                    TemplateIds: templateIds,
                    Flags: flags,
                    Facets: buildFacetQuery(true),
                    SearchFields: autoSearchFields
                };

                $.ajax({
                    type: "POST",
                    url: autoCompleteUrl,
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify(jsonQueryData),
                    dataType: "json",
                    success: function (msg) {
                        response(msg.results);
                    },
                    error: function (msg) {
                        console.log(msg.status + ' ' + msg.statusText);
                    }
                });
            }
        });
        jQuery.ui.autocomplete.prototype._resizeMenu = function () {
            var ul = this.menu.element;
            ul.outerWidth($("#search-box-term").outerWidth());
        }

        // create a listener on the flag checkboxes
        $('.flag-checkbox[type=checkbox]').change(function (event) {
            event.preventDefault();
            var checkboxValue = $(this).attr("value");
            var operator = checkboxValue.indexOf("!=") >= 0 ? '!=' : '=';
            var selectedItem = checkboxValue.split(operator);
            if (selectedItem.length == 2) {
                var matchingIndex = flags.findIndex(function(item) { return item.startsWith(selectedItem[0] + operator) });
                if (matchingIndex < 0) {
                    if ($(this).is(':checked')) 
                        flags.push(checkboxValue);
                } else {
                    if ($(this).is(':checked')) {
                        //add to existing flag
                        if (flags[matchingIndex].indexOf(checkboxValue) < 0)
                            flags[matchingIndex] = (flags[matchingIndex] + "||" + checkboxValue);
                    } else {
                        //remove from existing flag
                        if (flags[matchingIndex] == checkboxValue) {
                            flags.splice(matchingIndex, 1);
                        }
                        else if (flags[matchingIndex].indexOf(checkboxValue) >= 0) {
                            if (flags[matchingIndex].startsWith(checkboxValue)) {
                                flags[matchingIndex] = flags[matchingIndex].replace(checkboxValue + "||", "");
                            } else {
                                flags[matchingIndex] = flags[matchingIndex].replace("||" + checkboxValue, "");
                            }
                        }
                    }
                }
            }

            //if any items selected - show filter icon & clear all
            var flagGroup = $(this).closest(".flag-group");
            if (flagGroup.find("input[type='checkbox']:checked").length) {
                flagGroup.find(".clear-filters").show();
                flagGroup.find(".icon-filter").show();
            } else {
                flagGroup.find(".clear-filters").hide();
                flagGroup.find(".icon-filter").hide();
            }
            searchTable.ajax.reload();
        });

        // create a listener on the flag clear all
        $(".flag-group .clear-filters").click(function (event) {
            event.preventDefault();
            var flagGroup = $(this).closest(".flag-group");
            flagGroup.find("input[type='checkbox']:checked").each(function () {
                $(this).prop('checked', false);
                var checkboxValue = $(this).attr("value");
                var operator = checkboxValue.indexOf("!=") >= 0 ? '!=' : '=';
                var selectedItem = checkboxValue.split(operator);
                if (selectedItem.length == 2) {
                    var matchingIndex = flags.findIndex(function (item) { return item.startsWith(selectedItem[0] + operator) });
                    if (matchingIndex >= 0) flags.splice(matchingIndex, 1);
                }
            });
            flagGroup.find(".clear-filters").hide();
            flagGroup.find(".icon-filter").hide();
            searchTable.ajax.reload();
        });
        loadLastUpdated();
    });

    function loadDataTable() {
        var headerColumns = '';
        if(searchIndexName == null)
            searchIndexName = $("#inlineSearchBoxForm").data("searchindexname");

            $.each(columnData,
                function (key, value) {
                    headerColumns += "<th>" + value.displayName + "</th>";
                });
            //append table columns
            $("#inlineSearchTable > thead tr").append(headerColumns);

            //load datatable
            searchTable = $('#inlineSearchTable').DataTable({
                serverSide: true,
                ordering: false,
                searchDelay: 600,
                lengthMenu: [10, 25, 50, 75, 100],
                pagingType: "full_numbers",
                language: {
                    info: 'Results _START_-_END_ of _TOTAL_',
                    infoEmpty: 'Results 0-0 of 0',
                    emptyTable: "No matching records found",
                    sLengthMenu: "View Results _MENU_",
                },
                ajax: {
                    url: searchTableUrl,
                    cache: false,
                    type: 'POST',
                    data: function(d) {
                        var initialOrder = orderBy == null || !orderBy.length ? [[0, 'asc']] : orderBy;
                        d.order = initialOrder.map(function(o) {
                            return { column: o[0], dir: o[1] };
                        });
                        d.IndexName = searchIndexName;
                        d.FilterTags = filterTags;
                        d.TemplateIds = templateIds;
                        d.Flags = flags;
                        d.SearchFields = searchFields;
                        d.Facets = buildFacetQuery(false);
                    }
                },
                dom: '<"dataTables_controls clearfix"ip><t><"dataTables_controls clearfix"ilp>',
                columnDefs: columnDefData,
                columns: columnData,
                drawCallback: function(settings) {
                    var api = this.api();
                    var pagination = $(api.table().container()).find('.dataTables_paginate');
                    
                    // Set attributes for the pagination container
                    pagination.attr('role', 'navigation');
                    pagination.attr('aria-label', 'Pagination');

                    // Find and fix aria-role on pagination links
                    pagination.find('a').each(function() {
                        if ($(this).attr('aria-role') === 'link') {
                            $(this).attr('role', 'link').removeAttr('aria-role');
                        }
                    });
                }
            });
    }

    function buildFacetQuery(selectedItemsAsList) {
        // load the facets for the query
        var queryFacets = new Array();
        if (Object.keys(facets).length > 0) {
            $.each(Object.keys(facets), function (index, value) {
                queryFacets.push({
                    FieldName: facets[value].FieldName,
                    SortOrder: "desc",
                    DisplayCount: 100, //facets[value].ShowMaxValues + 1, //to support mobile always return all facet values
                    SelectedValues: selectedItemsAsList ? facets[value].SelectedValues : facets[value].SelectedValues.join("|"),
                    FieldType: facets[value].IsCollectionField === "True" ? "Collection" : "String",
                    UsesAndOperator: facets[value].UsesAndOperator === "True" ? true : false
                });
            });
        }
        return queryFacets;
    }

    function loadFacets() {
        // get the search query term
        var searchTerm = $('#inlineSearchBoxForm').find("[name=inlineSearchBox]").val();
        if(searchIndexName == null)
            searchIndexName = $("#inlineSearchBoxForm").data("searchindexname");
        if(searchUrl == null)
            searchUrl = $("#inlineSearchBoxForm").data("searchurl");

        // build the query data
        var jsonQueryData = {
            TemplateIds: templateIds,
            Flags: flags,
            SearchFields: searchFields,
            Facets: buildFacetQuery(true),
            SearchQuery: searchTerm,
            IndexName: searchIndexName,
            Tags: filterTags,
            FacetsOnly: true
        };

        $.ajax({
            method: "POST",
            url: searchUrl,
            data: JSON.stringify(jsonQueryData),
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            traditional: true,
            async: true,
            success: function (result) {
                processFacetResults(result.facets);
            },
            error: function (jqxhr, textStatus, e) {
            }
        });
    };

    function processFacetResults(facetResults) {
        $(facetResults).each(function (index, value) {
            // if the facet is configured on the page, display it
            if (value.fieldName in facets) {
                //console.log("Adding facet to page: " + value.fieldName);

                var facet = facets[value.fieldName];
                var facetFilterList = '';

                $(value.values).each(function (index, value) {
                    facetFilterList += '<li class="list-item"><div class="checkbox-btn"><input class="' + facet.DivId + '-checkbox filter-checkbox" id=' + facet.DivId + '-' + value.value + ' type="checkbox" name="' + facet.DivId + '-FilterCheckbox[]" value="' + value.value + '"><label for=' + facet.DivId + '-' + value.value + '>' + value.value + '</label></div></li>';

                    // if the facet is selected then add it to the list
                    if (value.selected === true) {
                        facet.SelectedValues.push(value.value);
                    }
                });

                $("#" + facet.DivId).find(".filter-list").html(facetFilterList);

                // create a listener on the checkboxes
                $('#' + facet.DivId + " :checkbox").change(function (event) {
                    event.preventDefault();
                    var selectedFacet = $(this).closest(".facet");
                    var selectedValues = selectedFacet.find("input:checkbox:checked").map(function () {
                        return $(this).val();
                    }).get();

                    //if any items selected - show filter icon & clear all
                    if (selectedValues.length > 0) {
                        selectedFacet.find(".clear-filters").show();
                        selectedFacet.find(".icon-filter").show();
                    } else {
                        selectedFacet.find(".clear-filters").hide();
                        selectedFacet.find(".icon-filter").hide();
                    }
                    facets[selectedFacet.data("fieldname")].SelectedValues = selectedValues;
                    searchTable.ajax.reload();
                });

                // create a listener on the clear all
                $('#' + facet.DivId + " .clear-filters").click(function (event) {
                    var selectedFacet = $(this).closest(".facet");
                    selectedFacet.find("input:checkbox:checked").prop('checked', false);
                    selectedFacet.find(".clear-filters").hide();
                    selectedFacet.find(".icon-filter").hide();
                    facets[selectedFacet.data("fieldname")].SelectedValues = new Array();
                    searchTable.ajax.reload();
                });
            }
        });
    }

    function processSearchBox(dataTable) {
        var filterString = $("#search-box-term").val();
        if (filterString.length > 2) {
            dataTable.search(filterString);
            if (columnData[0].data == "relevance") //if search term change and table has relevance column order by score
                dataTable.order([0, 'desc']);
            dataTable.draw();
        } else if (filterString.length == 0) {
            dataTable.search("").draw();
        }
    };

    // configure the search button
    $(document).on("click", "#inlineSearchSubmit", function (e) {
        e.preventDefault();
        processSearchBox(searchTable);
    });
    // configure the change of the search term box
    $(document).on("change", "#search-box-term", function (e) {
        e.preventDefault();
        $(".ui-autocomplete").hide(); //on search close auto suggest box
        processSearchBox(searchTable);
    });
    //configure search term box show hide clear all
    $(document).on("keyup", "#search-box-term", function (e) {
        showHideClearSearch(this);
    });
    //configure search term box clear all X
    $(document).on("click", "#inlineSearchBoxForm button[type='reset']", function (e) {
        e.preventDefault();
        $("#search-box-term").val('');
        showHideClearSearch($("#search-box-term"));
        processSearchBox(searchTable);
    });

    function showHideClearSearch(searchBox) {
        if (searchBox.value != null && searchBox.value.length) {
            $(searchBox).siblings('button[type="reset"]').show();
        } else {
            $(searchBox).siblings('button[type="reset"]').hide();
        }
    }

    function returnFileIconClass(fileType) {
        if (fileType == null)
            return "document-icon";

        if (fileType.toLowerCase() == "pdf") {
            return "pdf-icon";
        } else if (fileType.toLowerCase() == "word") {
            return "word-icon";
        } else if (fileType.toLowerCase() == "excel") {
            return "excel-icon";
        } else if (fileType.toLowerCase() == "powerpoint") {
            return "powerpoint-icon";
        } else if (fileType.toLowerCase() == "text") {
            return "document-icon";
        } else if (fileType.toLowerCase() == "mpeg") {
            return "video-icon";
        } else if (fileType.toLowerCase() == "generaldocument") {
            return "document-icon";
        }
        return "document-icon";
    };

    function loadLastUpdated() {
        var searchSyncWrapper = $(".search-sync-last-updated");
        if (searchSyncWrapper.length) {
            $.ajax({
                method: "GET",
                url: '/DataSync/LastUpdated',
                success: function (result) {
                    if (result != null)
                        searchSyncWrapper.text('Updated as of ' + result);
                },
                error: function (jqxhr, textStatus, e) {
                    searchSyncWrapper.text('');
                }
            });
        }
    };

</script>


                
                

                
                

                
                
            </div>
        </div>
    </div>
</main>

