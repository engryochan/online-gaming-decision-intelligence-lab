	<script>
	(function () {
		var modal = document.querySelector('[data-country-gated-popup]');
		if (!modal) { return; }

		var COOKIE = "gb_country_gated_access";
		var LOCATION_COOKIE = "gb_country_gated_location";
		var ROLE_COOKIE = "gb_country_gated_role";
		var DAYS = 30;
		var FORM_ID = 5;
		var PAGE_SLUG = "global-smaller-companies";
		var html = document.documentElement;
		var body = document.body;
		var selectedLocation = '';
		var selectedRole = '';

		function hasAccess() {
			return document.cookie.indexOf(COOKIE + '=') > -1;
		}

		function normalizeKey(value) {
			return String(value || '')
				.trim()
				.toLowerCase()
				.replace(/\s+/g, '-');
		}

		function getCookieValue(name) {
			var parts = document.cookie.split(';');
			for (var i = 0; i < parts.length; i++) {
				var part = parts[i].trim();
				if (part.indexOf(name + '=') === 0) {
					return part.substring(name.length + 1);
				}
			}
			return '';
		}

		// Blocks opt in with "visible-{location}" (any role) or
		// "visible-{location}--{role}" (that location and role). Multiple classes
		// on one block are OR'd. Without a known location every restricted block
		// stays hidden.
		function applyVisibility(locationValue, roleValue) {
			var locationKey = normalizeKey(locationValue);
			var roleKey = normalizeKey(roleValue);
			var targets = document.querySelectorAll('[class*="visible-"], [class*="VISIBLE-"]');
			if (!targets.length) { return; }

			Array.prototype.forEach.call(targets, function (node) {
				var classes = Array.prototype.slice.call(node.classList || []);
				var visibleClasses = classes.filter(function (cls) {
					return /^visible-/i.test(cls);
				});

				if (!visibleClasses.length) { return; }

				var isMatch = !!locationKey && visibleClasses.some(function (cls) {
					var parts = cls.replace(/^visible-/i, '').split('--');
					var classLocation = normalizeKey(parts[0]);
					var classRole = normalizeKey(parts[1]);
					return classLocation === locationKey && (!classRole || classRole === roleKey);
				});

				if (isMatch) {
					node.classList.remove('always-hidden');
				} else {
					node.classList.add('always-hidden');
				}

				node.classList.toggle('country-gated-accordion-shown', isMatch && node.classList.contains('fxb-accordion-block'));
			});

			applyAnchorLinkVisibility();
		}

		// Hide in-page links (e.g. Quicklinks) whose #anchor target sits inside a
		// hidden block, along with a <p>/<li> that holds nothing but the link.
		function applyAnchorLinkVisibility() {
			var links = document.querySelectorAll('a[href*="#"]');

			Array.prototype.forEach.call(links, function (link) {
				if (!link.hash || link.hash.length < 2 || link.pathname !== window.location.pathname) { return; }

				var id;
				try {
					id = decodeURIComponent(link.hash.slice(1));
				} catch (e) {
					return;
				}

				var target = document.getElementById(id);
				if (!target) { return; }

				var wrapper = link.parentElement;
				var hideNode = wrapper && /^(P|LI)$/.test(wrapper.tagName) &&
					wrapper.textContent.trim() === link.textContent.trim() ? wrapper : link;

				if (target.closest('.always-hidden')) {
					hideNode.classList.add('always-hidden');
					hideNode.setAttribute('data-gated-link-hidden', '');
				} else if (hideNode.hasAttribute('data-gated-link-hidden')) {
					hideNode.classList.remove('always-hidden');
					hideNode.removeAttribute('data-gated-link-hidden');
				}
			});
		}

		function grantAccess() {
			var expires = new Date();
			expires.setTime(expires.getTime() + (DAYS * 24 * 60 * 60 * 1000));
			document.cookie = COOKIE + '=1; expires=' + expires.toUTCString() +
				'; path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');

			if (selectedLocation) {
				var locationCookieValue = normalizeKey(selectedLocation);
				document.cookie = LOCATION_COOKIE + '=' + encodeURIComponent(locationCookieValue) +
					'; expires=' + expires.toUTCString() +
					'; path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
			}

			if (selectedRole) {
				var roleCookieValue = normalizeKey(selectedRole);
				document.cookie = ROLE_COOKIE + '=' + encodeURIComponent(roleCookieValue) +
					'; expires=' + expires.toUTCString() +
					'; path=/; SameSite=Lax' + (location.protocol === 'https:' ? '; Secure' : '');
			}

			html.classList.add('country-gated-access-granted');
			applyVisibility(selectedLocation, selectedRole);
		}

		function findSelectByLabel(pattern) {
			var fields = modal.querySelectorAll('.gfield');
			for (var i = 0; i < fields.length; i++) {
				var label = fields[i].querySelector('.gfield_label, legend, label');
				var select = fields[i].querySelector('select');
				if (select && label && pattern.test(label.textContent || '')) {
					return select;
				}
			}
			return null;
		}

		function captureSelectedLocation() {
			// Preferred field name from the provided form, then safe fallbacks.
			var locationField =
				modal.querySelector('select[name="input_11"]') ||
				modal.querySelector('select[name*="location"]') ||
				findSelectByLabel(/location|country/i) ||
				modal.querySelector('.ginput_container_select select');

			if (locationField) {
				selectedLocation = (locationField.value || '').trim();
			}

			var roleField =
				findSelectByLabel(/role/i) ||
				modal.querySelector('select[name*="role"]');

			if (roleField && roleField !== locationField) {
				selectedRole = (roleField.value || '').trim();
			}
		}

		function lockScroll() {
			body.classList.add('report-popup-open');
			html.classList.add('report-popup-open');
		}

		function unlockScroll() {
			body.classList.remove('report-popup-open');
			html.classList.remove('report-popup-open');
		}

		function openPopup() {
			lockScroll();
			modal.removeAttribute('hidden');
			modal.classList.add('is-visible');
		}

		function closePopup() {
			modal.classList.remove('is-visible');
			unlockScroll();
			window.setTimeout(function () {
				modal.setAttribute('hidden', 'hidden');
			}, 250);
		}

		if (hasAccess()) {
			var existingLocation = decodeURIComponent(getCookieValue(LOCATION_COOKIE) || '');
			var existingRole = decodeURIComponent(getCookieValue(ROLE_COOKIE) || '');
			applyVisibility(existingLocation, existingRole);
			html.classList.add('country-gated-access-granted');
			if (modal.parentNode) {
				modal.parentNode.removeChild(modal);
			}
			return;
		}

		modal.addEventListener('submit', function () {
			captureSelectedLocation();
		}, true);

		modal.addEventListener('click', function (event) {
			if (!event.target.closest('input[type="submit"], button[type="submit"], .gform_button')) { return; }
			captureSelectedLocation();
		});

		window.setTimeout(function () {
			if (modal.hasAttribute('hidden')) {
				openPopup();
			}
		}, 1100);

		
		var confirmed = false;

		function onConfirmed(formId) {
			if (confirmed) { return; }
			if (FORM_ID && parseInt(formId, 10) !== FORM_ID) { return; }
			confirmed = true;
			grantAccess();
			closePopup();
			pushSubmissionEvent();
		}

		function pushSubmissionEvent() {
			window.dataLayer = window.dataLayer || [];
			window.dataLayer.push({
				event: 'country_gated_form_submit',
				gated_page_slug: PAGE_SLUG,
				gated_country: selectedLocation,
				gated_role: selectedRole,
				gated_form_id: FORM_ID
			});
		}

		var boundInstances = [];

		function bindConfirmation() {
			var jq = window.jQuery;
			if (!jq || boundInstances.indexOf(jq) !== -1) { return; }
			boundInstances.push(jq);
			jq(document).on('gform_confirmation_loaded', function (_, formId) {
				onConfirmed(formId);
			});
		}

		bindConfirmation();
		var rebindTries = 0;
		var rebindTimer = window.setInterval(function () {
			bindConfirmation();
			if (confirmed || ++rebindTries > 40) {
				window.clearInterval(rebindTimer);
			}
		}, 500);
	})();
	</script>
