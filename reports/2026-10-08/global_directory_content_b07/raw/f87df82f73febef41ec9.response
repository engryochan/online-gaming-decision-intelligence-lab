		<div class="o-grid">
				<div class="u-area ">
<div id="id-e2f55720-e1ea-400e-981d-541c99f89214" class="c-title txt-align-center">
    <h2 class="">
    Have you already made an application?
    </h2>
</div><div id="id-2c6ebe80-6d05-453e-bf5a-c07a459d6352" class="c-assets-list g-list-max2">
    <div class="c-list c-list-cards c-list-cards-tp2">
        <ul class="list list-cards list-cards-tp2">
                <li class="item">
<div class="c-card c-card-tp2" id="card-8c2b3c748b3d4cb28968da5fcb3acd7a">
    <div class="media">
        <div class="media__txt">
<h3 class="item__title">See the progress of your application</h3>                <div class="item__summary">
                    <p>Review the progress of your application</p>
                </div>
                <div class="c-cta">
                    <div id="id-e3818339-15dc-4ba9-8d62-b5c29c69f495" class="cta-group ">
    <a id="id-4fb51523-8da0-4ed0-bdb4-0f020d0694d9" class="cta cta-button" href="/borrower-area/manage-your-application/" target="_self">
    <span class="cta__text">Check your Application</span>
</a>
</div>
                </div>
                <!-- o-cta -->

        </div><!-- /media__txt -->

    </div><!-- media -->
</div><!-- /.item-card -->                </li>
                <!-- /.item -->
                <li class="item">
<div class="c-card c-card-tp2" id="card-b6637a0653ee459bbc1b15a4622f29ab">
    <div class="media">
        <div class="media__txt">
<h3 class="item__title">Upload documentation</h3>                <div class="item__summary">
                    <p>Upload any necessary documents online such as photo identity, proof of address, and proof of PPSN</p>
                </div>
