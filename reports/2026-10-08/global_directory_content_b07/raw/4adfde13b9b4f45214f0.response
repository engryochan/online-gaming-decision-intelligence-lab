-arrow-small-down" aria-hidden="true"></i></button></div><ul id="submenu-hipotecas1-1" class="menuDropdown-submenu" hidden="hidden"><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/inversion/que-necesitas-para-invertir/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="¿Qué necesitas para invertir?">¿Qué necesitas para invertir?</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/inversion/que-son-los-fondos-de-inversion/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="¿Qué son los fondos de inversión?">¿Qué son los fondos de inversión?</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/inversion/preguntas-frecuentes-inversion/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="FAQs sobre inversión">FAQs sobre inversión</a></div></li></ul></li></ul></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Planes de Pensiones">Planes de Pensiones</a> <button type="button" class="menuDropdown-toggle btn btn-icon-xs btn-neutral1-invisible ab_clickElement" aria-expanded="false" aria-controls="submenu-c4ca1d32-15e0-495c-ad1b-4ef801fa42a4" aria-haspopup="true"><span class="sr-only">Abrir submenú</span> <i class="icon-16 icon-ic-arrow-small-down" aria-hidden="true"></i></button></div><ul id="submenu-c4ca1d32-15e0-495c-ad1b-4ef801fa42a4" class="menuDropdown-submenu" hidden="hidden"><li class="menuDropdown-elem has-children js-a11y-dd menuDropdown-hover"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Planes de Pensiones">Planes de Pensiones</a> <button type="button" class="menuDropdown-toggle btn btn-icon-xs btn-neutral1-invisible" aria-expanded="false" aria-controls="submenu-hipotecas1-1" aria-haspopup="true"><span class="sr-only">Abrir submenú</span> <i class="icon-16 icon-ic-arrow-small-down" aria-hidden="true"></i></button></div><ul id="submenu-hipotecas1-1" class="menuDropdown-submenu" hidden="hidden"><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/planes-de-pensiones/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Plan de Pensiones">Plan de Pensiones</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/autonomos/plan-pensiones/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Plan de pensiones para Autónomos">Plan de pensiones para Autónomos</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/epsv/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="EPSV">EPSV</a></div></li></ul></li><li class="menuDropdown-elem has-children js-a11y-dd menuDropdown-hover"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/plan-para-ahorrar/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Cómo ahorrar con un Plan de Pensiones ">Cómo ahorrar con un Plan de Pensiones</a></div></li></ul></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/banca-personal/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Banca Personal">Banca Personal</a> <button type="button" class="menuDropdown-toggle btn btn-icon-xs btn-neutral1-invisible ab_clickElement" aria-expanded="false" aria-controls="submenu-3a636cfd-7fe1-456d-af82-14486ed0c399" aria-haspopup="true"><span class="sr-only">Abrir submenú</span> <i class="icon-16 icon-ic-arrow-small-down" aria-hidden="true"></i></button></div><ul id="submenu-3a636cfd-7fe1-456d-af82-14486ed0c399" class="menuDropdown-submenu" hidden="hidden"><li class="menuDropdown-elem has-children js-a11y-dd menuDropdown-hover"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/banca-personal/tarjeta-abanca-personal/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Tarjeta ABANCA Personal">Tarjeta ABANCA Personal</a></div></li></ul></li></ul></nav><nav id="menu-empresas" class="header-categories menuDropdown-nav" aria-label="Enlaces a las páginas de las distintas categorias de productos" data-section="empresas" data-mega-height="400" aria-hidden="false"><ul><li class="menuDropdown-elem hidden-lg hidden-md"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Inicio">Inicio</a></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/autonomos/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Autónomos y Negocios">Autónomos y Negocios</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/pymes-gran-empresa/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Pymes y Grandes Empresas">Pymes y Grandes Empresas</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/abanca-agro/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="ABANCA Agro">ABANCA Agro</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/abanca-mar/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="ABANCA Mar">ABANCA Mar</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/abanca-turismo/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="ABANCA Turismo">ABANCA Turismo</a></div></li></ul></nav><nav id="menu-banca-privada" class="header-categories menuDropdown-nav" aria-label="Enlaces a las páginas de las distintas categorias de productos" data-section="banca-privada" data-mega-height="400" aria-hidden="false"><ul><li class="menuDropdown-elem hidden-lg hidden-md"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/banca-privada/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Inicio Banca Privada">Inicio Banca Privada</a></li></ul></nav></div><div class="header-bottom-actions"><nav class="header-buttons" aria-label="Menú de acciones"><ul><li><a href="/es/cuentas/cuenta-online/" aria-label="Hazte cliente" title="Hazte cliente" data-abaction="click-menu" data-abcategory="header-primary|nav-bar" data-abvalue="Hazte cliente" class="ab_clickElement header-buttons-hazte-cliente btn btn-primary"><span>Hazte cliente</span></a></li><li><a href="https://bancaelectronica.abanca.com/" aria-label="Área cliente" title="Área cliente" data-abaction="click-menu" data-abcategory="header-primary|nav-bar" data-abvalue="Área cliente" class="ab_clickElement header-buttons-area-cliente-desktop btn btn-neutral10"><span>Área cliente</span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></nav></div></header><main id="contenido" class="mainContent" tabindex="-1"><section class="container-fluid pb-10 mb-xs" id="breadcrumb-generico"><nav class="breadcrumbs" aria-label="Breadcrumbs"><ol><li><a href="/es/"><span>Inicio</span></a></li><li class="breadcrumb-sep" aria-hidden="true"><i class="icon-16 icon-ic-slash-right" aria-hidden="true"></i></li><li><a href="/es/inversion/">Inversion</a></li><li class="breadcrumb-sep" aria-hidden="true"><i class="icon-16 icon-ic-slash-right" aria-hidden="true"></i></li><li><span aria-current="page">Broker online</span></li></ol></nav></section><section class="container-fluid pb-10 mb-xs"><div class="hero-banner template4 rounded bgr-gradient-horizontal-primary"><div class="hero-wrapper flex-row-reverse-desk"><div class="hero-multimedia"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/_mediaformats/slider-broker-mob-8042554e.png 700w" media="(prefers-color-scheme: light) and (max-width: 767px)" sizes="700px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/_mediaformats/slider-broker-mob-8042554e.png 700w" media="(prefers-color-scheme: dark) and (max-width: 767px)" sizes="700px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/_mediaformats/slider-broker-tab-344dffec.png 970w" media="(prefers-color-scheme: light) and (min-width: 768px) and (max-width: 1024px)" sizes="970px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/_mediaformats/slider-broker-tab-344dffec.png 970w" media="(prefers-color-scheme: dark) and (min-width: 768px) and (max-width: 1024px)" sizes=""><source type="image/jpeg" srcset="//www.abanca.com/img/internas/slider-broker-c26a0e78.png 1600w" media="(prefers-color-scheme: light)" sizes="1600px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/slider-broker-c26a0e78.png 1600w" media="(prefers-color-scheme: dark)" sizes="1600px"><img loading="lazy" src="//www.abanca.com/img/internas/slider-broker-c26a0e78.png" alt=""></picture></div><div class="hero-cont"><div class="hero-info"><h1 class="hero-tit text-h5 txt-neutral10 text-light">Opera con el Bróker Online</h1><div class="hero-txt text-p2 txt-neutral10 text-light">Consulta las <strong>tarifas</strong> para operar con valores desde tu móvil.</div><div class="cta-btns"><a class="btn btn-primary cta-btn ab_clickElement" href="/es/inversion/broker-online/#tarifas" title="Consultar tarifas" data-abaction="click-cta" data-abcategory="hero-button|primary|0" data-abvalue="Consultar tarifas"><span>Consultar tarifas</span> </a><a class="btn btn-neutral10 cta-btn ab_clickElement" href="https://bancaelectronica.abanca.com/?url=abro" title="Empieza a invertir" data-abaction="click-cta" data-abcategory="hero-button|secondary|1" data-abvalue="Empieza a invertir"><span>Empieza a invertir</span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></div></div></div></div></div></section><section class="container-fluid pb-10 mb-xs"><div class="benefits has-swiper component-benefits"><h2 class="benefits-title text-h5 txt-primary text-light">Características de nuestro bróker online</h2><div class="swiper"><div class="swiper-wrapper"><div class="swiper-slide"><div class="benefit bgr-neutral10 bdr-1 bdr-primary rounded txt-neutral1 justify-content"><div class="benefit-img"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/ico-informacion-broker-cc568bfb.svg 49w" media="(prefers-color-scheme: light)" sizes="49px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/ico-informacion-broker-cc568bfb.svg 49w" media="(prefers-color-scheme: dark)" sizes="49px"><img src="//www.abanca.com/img/internas/ico-informacion-broker-cc568bfb.svg" alt="" class="acc-iconos"></picture></div><h3 class="benefit-tit text-p1 txt-primary text-light">Obtén toda la información</h3><div class="benefit-txt text-p2 txt-neutral1 text-light">Sobre tu cartera, su rentabilidad y tus <strong>operaciones en curso</strong>.</div></div></div><div class="swiper-slide"><div class="benefit bgr-neutral10 bdr-1 bdr-primary rounded txt-neutral1 justify-content"><div class="benefit-img"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/ico-broker-correo-c5084ed6.svg 49w" media="(prefers-color-scheme: light)" sizes="49px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/ico-broker-correo-c5084ed6.svg 49w" media="(prefers-color-scheme: dark)" sizes="49px"><img src="//www.abanca.com/img/internas/ico-broker-correo-c5084ed6.svg" alt="" class="acc-iconos"></picture></div><h3 class="benefit-tit text-p1 txt-primary text-light">Tu correspondencia</h3><div class="benefit-txt text-p2 txt-neutral1 text-light">Te enviaremos tus contratos de <strong>fondos y valores</strong> así como los <strong>justificantes de tus operaciones</strong> a tu buzón de banca móvil y electrónica.</div></div></div><div class="swiper-slide"><div class="benefit bgr-neutral10 bdr-1 bdr-primary rounded txt-neutral1 justify-content"><div class="benefit-img"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/ico-broker-lupa-05ca0f6c.svg 49w" media="(prefers-color-scheme: light)" sizes="49px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/ico-broker-lupa-05ca0f6c.svg 49w" media="(prefers-color-scheme: dark)" sizes="49px"><img src="//www.abanca.com/img/internas/ico-broker-lupa-05ca0f6c.svg" alt="" class="acc-iconos"></picture></div><h3 class="benefit-tit text-p1 txt-primary text-light">Busca valores</h3><div class="benefit-txt text-p2 txt-neutral1 text-light">Localiza <strong>acciones, ETFs y fondos</strong> interesantes para ti de forma eficaz desde cualquier dispositivo.</div></div></div><div class="swiper-slide"><div class="benefit bgr-neutral10 bdr-1 bdr-primary rounded txt-neutral1 justify-content"><div class="benefit-img"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/ico-broker-barras-e8d60abc.svg 49w" media="(prefers-color-scheme: light)" sizes="49px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/ico-broker-barras-e8d60abc.svg 49w" media="(prefers-color-scheme: dark)" sizes="49px"><img src="//www.abanca.com/img/internas/ico-broker-barras-e8d60abc.svg" alt="" class="acc-iconos"></picture></div><h3 class="benefit-tit text-p1 txt-primary text-light">Favoritos</h3><div class="benefit-txt text-p2 txt-neutral1 text-light">Puedes incluir tus <strong>índices, valores y fondos favoritos</strong> y hacer seguimiento sobre su evolución.</div></div></div></div><div class="swiper-button-prev btn btn-carousel" tabindex="0" role="button" aria-label="Anterior slide"><i class="icon-32 icon-ic-arrow-before"></i></div><div class="swiper-button-next btn btn-carousel" tabindex="0" role="button" aria-label="Siguiente slide"><i class="icon-32 icon-ic-arrow-after"></i></div><div class="swiper-pagination pagination-fraction"></div></div></div></section><section class=""><div id="2026-texto-que-es-un-broker-online" class="complex-content bgr-neutral10"><div class="cta-cont"><h2 class="cta-tit text-h5 txt-primary text-light">¿Qué es un bróker online?</h2><div class="cta-txt text-p2 txt-neutral1 text-light text-left"><p>Un bróker online es una plataforma digital a través de la que puedes comprar y vender productos financieros directamente. Si antes necesitabas acudir a una oficina para invertir, hoy el bróker de ABANCA pone la Bolsa y operar con acciones, ETFs y fondos en la palma de tu mano.</p><p>Sus funciones básicas son:</p><ul><li><p><strong>Órdenes</strong>: Tramita tus órdenes de compra o venta de acciones de renta variable, ETFs o fondos de inversión.</p></li><li><p><strong>Información</strong>: Te ofrece informes de análisis, gráficas y cotizaciones actualizadas para apoyar la toma de tus decisiones de inversión.</p></li></ul></div></div></div></section><section class=""><div id="2026-texto-para-que-sirve-broker-online" class="complex-content bgr-neutral10"><div class="cta-cont"><h2 class="cta-tit text-h5 txt-primary text-light">¿Para qué sirve un bróker online?</h2><div class="cta-txt text-p2 txt-neutral1 text-light text-left"><p>La utilidad principal es darte el <strong>control total de tu salud financiera</strong>. No es solo "invertir por invertir", sino gestionar tu patrimonio de forma autónoma.</p><ul><li><p><strong>Inversión a tu medida</strong>: te permite comprar desde acciones de empresas hasta ETFs y fondos de inversión.</p></li><li><p><strong>Pasaporte a los mercados</strong>: con un solo clic, accedes al IBEX 35, al mercado europeo o a las bolsas estadounidenses (NYSE, NASDAQ), diversificando tus ahorros para no "poner todos los huevos en la misma cesta".</p></li></ul></div></div></div></section><section class="container"><div class="carrousel carrousel-left component-carrousel"><div class="carrousel-info"><h2 class="carrousel-tit text-h5 text-light txt-primary">¿Cómo funciona el bróker de ABANCA?</h2><div class="carrousel-desc text-p2 txt-neutral1 text-light"><p>Empezar a operar es un proceso ágil y totalmente digital. Estos son los pasos para activar tu bróker online:</p></div></div><div class="cards-product-m-grid has-swiper pt-0 pb-0"><div class="swiper has-handlers swiper-horizontal swiper-backface-hidden" id="cards-product-m1"><div class="swiper-wrapper"><div class="swiper-slide"><div class="card-product-m bdr-1 bdr-primary bgr-neutral10 rounded"><div class="card-cont"><div class="card-cont-top"><h3 class="card-tit text-p1 txt-primary text-light">1. Registro y acceso</h3><div class="card-txt text-p2 txt-neutral1 text-light"><p>Entra en tu banca a distancia o <a href="![LINK-UUID[https://www.abanca.com/es/banca-a-distancia/banca-movil/]]">app de ABANCA</a>.</p></div></div></div></div></div><div class="swiper-slide"><div class="card-product-m bdr-1 bdr-primary bgr-neutral10 rounded"><div class="card-cont"><div class="card-cont-top"><h3 class="card-tit text-p1 txt-primary text-light">2. Verificación de datos</h3><div class="card-txt text-p2 txt-neutral1 text-light"><p>En caso de no tener completo tu <a href="![LINK-UUID[https://www.cuentasclaras.es/como-funciona/que-es-kyc-know-your-customer/]]">KYC</a>, confirmamos tu identidad y situación fiscal.</p></div></div></div></div></div><div class="swiper-slide"><div class="card-product-m bdr-1 bdr-primary bgr-neutral10 rounded"><div class="card-cont"><div class="card-cont-top"><h3 class="card-tit text-p1 txt-primary text-light">3. Clasificación MiFID</h3><div class="card-txt text-p2 txt-neutral1 text-light"><p>Y firma del Acuerdo Básico para la prestación de servicios de inversión, así como del Contrato de Valores y/o del Contrato Marco de fondos de inversión.</p></div></div></div></div></div><div class="swiper-slide"><div class="card-product-m bdr-1 bdr-primary bgr-neutral10 rounded"><div class="card-cont"><div class="card-cont-top"><h3 class="card-tit text-p1 txt-primary text-light">4. Activación de cuenta y depósito</h3><div class="card-txt text-p2 txt-neutral1 text-light"><p>Vincula tu cuenta corriente o de ahorro con tu contrato de valores o fondos y aporta el dinero que quieras destinar a hacer tus inversiones.</p></div></div></div></div></div></div><div class="swiper-button-prev btn btn-carousel" tabindex="0" role="button" aria-label="Anterior slide"><i class="icon-32 icon-ic-arrow-before"></i></div><div class="swiper-button-next btn btn-carousel" tabindex="0" role="button" aria-label="Siguiente slide"><i class="icon-32 icon-ic-arrow-after"></i></div><div class="swiper-pagination pagination-fraction swiper-pagination-custom"></div></div></div></div></section><section class=""><div id="2026-texto-requisitos-broker-online" class="complex-content bgr-neutral10"><div class="cta-cont"><h2 class="cta-tit text-h5 txt-primary text-light">Requisitos y consideraciones antes de empezar</h2><div class="cta-txt text-p2 txt-neutral1 text-light text-left"><p>Para cumplir con la normativa vigente y ofrecerte un proceso transparente y adaptado a la legislación, necesitaremos:</p><ul><li><p><strong>Documentación vigente</strong>: Tener tu DNI o NIE actualizado y tus datos de residencia fiscal en España.</p></li><li><p><strong>Cuenta bancaria en ABANCA</strong>: Es el soporte donde se liquidarán tus operaciones, abono de dividendos…</p></li></ul></div></div></div></section><section class=""><div id="2026-texto-importancia-economica-broker-online" class="complex-content bgr-neutral10"><div class="cta-cont"><h2 class="cta-tit text-h5 txt-primary text-light">Importancia económica y personal de elegir un bróker online</h2><div class="cta-txt text-p2 txt-neutral1 text-light text-left"><p>Elegir un bróker online no es solo abrir una cuenta más, es una decisión estratégica para tus finanzas personales.</p><p>Invertir a través de una plataforma ágil te permite:</p><ul><li><p><strong>Planificación a largo plazo</strong>: Construir un patrimonio para el futuro o la jubilación de forma disciplinada.</p></li><li><p><strong>Agilidad financiera</strong>: Reaccionar a las oportunidades del mercado cuando ocurren, sin esperas ni burocracias lentas.</p></li></ul><p>Al integrar tu bróker en tu banco de confianza, unificas tu gestión diaria con tu estrategia de inversión, logrando una visión 360° de tu dinero.</p></div></div></div></section><section class="container-fluid pb-10 mb-xs"><div class="faqs container"><h2 class="faqs-tit text-h5 txt-primary text-light">Opera con el Bróker online con valores y fondos de inversión</h2><div class="row"><div class="col-sm-6"><div class="faqs-txt"><p>Todos nuestros clientes tienen a su disposición un <strong>Bróker online</strong> para operar en acciones y ETFs, y con fondos de inversión de la forma más fácil y ágil. Se trata de una plataforma web y app con todo lo que necesitas para moverte por la bolsa, buscar, comprar y vender acciones, ETFs y fondos de inversión.</p></div></div><div class="col-sm-6"><div class="faqs-txt"><p>También encontrarás <strong>noticias de actualidad</strong> relacionadas con economía, mercados y empresas que te ayudarán a estar al día de toda la información.</p></div></div></div><h3 class="faqs-sub txt-primary"><span></span></h3><div class="faqs-collapse"><div class="collapse bgr-neutral10 bdr-1 bdr-primary" data-group="faq-results"><button id="faq1-button" class="collapse-root btn-lnk-p1" type="button" aria-expanded="false" aria-controls="faq1-panel"><span class="collapse-tit text-p1 text-light txt-primary">El bróker online y los fondos de inversión</span> <i class="icon-24 icon-ic-arrow-big-down txt-primary" aria-hidden="true"></i></button><div id="faq1-panel" class="collapse-cont text-p2" role="region" aria-labelledby="faq1-button" style="" hidden="hidden"><p>Si lo que quieres es diversificar tu patrimonio de forma fácil y tenemos un amplio catálogo de <strong>fondos de inversión</strong>, en el que puedes elegir entre fondos nacionales e internacionales, los que mejor se adapten a tu perfil financiero y a ti. Además, no necesitas ser un experto, porque los fondos de inversión son administrados por gestores profesionales.</p><p>Tú decides el riesgo que estás dispuesto a asumir, desde un <strong>nivel bajo de riesgo</strong> hasta un <strong>riesgo más elevado</strong>. Si te interesa, te contamos todos los detalles. O desde nuestro bróker online, tienes a tu disposición toda la información de los fondos de inversión disponibles. También puedes consultar tu posición y, también, buscar o hacer un seguimiento sobre los fondos internacionales que te resulten más relevantes.</p><p>Los detalles sobre las principales características y riesgos de cada fondo, puedes consultarlas en el folleto informativo y en el documento de datos fundamentales para el inversor de cada fondo, que está a tu disposición, junto con el resto de documentación legal exigible, en la información detallada de cada fondo, en nuestro broker y en nuestras oficinas, en la sociedad gestora, y en la web de la Comisión Nacional del Mercado de Valores. Consultar la documentación de los fondos es imprescindible antes de tomar cualquier decisión de inversión.</p></div></div><div class="collapse bgr-neutral10 bdr-1 bdr-primary" data-group="faq-results"><button id="faq2-button" class="collapse-root btn-lnk-p1" type="button" aria-expanded="false" aria-controls="faq2-panel"><span class="collapse-tit text-p1 text-light txt-primary">El bróker online y los valores</span> <i class="icon-24 icon-ic-arrow-big-down txt-primary" aria-hidden="true"></i></button><div id="faq2-panel" class="collapse-cont text-p2" role="region" aria-labelledby="faq2-button" style="" hidden="hidden"><p>Podrás agrupar todas tus operaciones en los mercados en tu <strong>Cuenta Valores</strong> y aprovecharte de una tarifa plana para la <strong>compra y venta de valores nacionales</strong>.</p></div></div><div class="collapse bgr-neutral10 bdr-1 bdr-primary" data-group="faq-results"><button id="faq3-button" class="collapse-root btn-lnk-p1" type="button" aria-expanded="false" aria-controls="faq3-panel"><span class="collapse-tit text-p1 text-light txt-primary">¿Qué necesitas para empezar a utilizar el bróker online?</span> <i class="icon-24 icon-ic-arrow-big-down txt-primary" aria-hidden="true"></i></button><div id="faq3-panel" class="collapse-cont text-p2" role="region" aria-labelledby="faq3-button" style="" hidden="hidden"><p>Si eres cliente de ABANCA, <strong>solo necesitas tus claves de banca electrónica</strong> para darte de alta, si aún no las tienes puedes solicitarlas y te las enviamos rápidamente. Si todavía no eres cliente de ABANCA puedes abrir una cuenta corriente online desde esta misma web, ¡en solo unos minutos! ¡Te lo aseguramos!</p></div></div></div></div></section><section class="container-fluid pb-10 mb-xs"><div class="hero-banner template4 rounded bgr-neutral10"><div class="hero-wrapper flex-row-reverse-desk"><div class="hero-multimedia"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/_mediaformats/banner-broker-pestana-mob-49e5ccd0.png 700w" media="(prefers-color-scheme: light) and (max-width: 767px)" sizes="700px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/_mediaformats/banner-broker-pestana-mob-49e5ccd0.png 700w" media="(prefers-color-scheme: dark) and (max-width: 767px)" sizes="700px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/_mediaformats/banner-broker-pestana-tab-596a6447.png 1600w" media="(prefers-color-scheme: light) and (min-width: 768px) and (max-width: 1024px)" sizes="1600px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/_mediaformats/banner-broker-pestana-tab-596a6447.png 1600w" media="(prefers-color-scheme: dark) and (min-width: 768px) and (max-width: 1024px)" sizes=""><source type="image/jpeg" srcset="//www.abanca.com/img/internas/banner-broker-pestana-8eccc8ed.png 9600w" media="(prefers-color-scheme: light)" sizes="9600px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/banner-broker-pestana-8eccc8ed.png 9600w" media="(prefers-color-scheme: dark)" sizes="9600px"><img loading="lazy" src="//www.abanca.com/img/internas/banner-broker-pestana-8eccc8ed.png" alt="Ventana de broker online"></picture></div><div class="hero-cont"><div class="hero-info"><h2 class="hero-tit text-h5 txt-neutral10 text-light"></h2><div class="hero-txt text-p2 txt-neutral10 text-light"></div></div></div></div></div></section><section class="container-fluid pb-10 mb-xs"><div class="featured-cont"><div class="featured-cont-wrapper justify-content"><div class="row"><div class="col-sm-6"><h2 class="featured-cont-tit text-h5 txt-primary text-light">Antes de invertir en bolsa…</h2></div></div><div class="row"><div class="col-sm-6"><div class="featured-cont-txt text-p2 txt-neutral1 text-light"><p>Para invertir en bolsa lo primero que necesitas es una <strong>Cuenta valores</strong> desde la que administrarás tu cartera de acciones. Tendrás todos tus movimientos con valores agrupados y ordenados para que los consultes cuando quieras.</p></div></div><div class="col-sm-6"><div class="featured-cont-txt text-p2 txt-neutral1 text-light"><p>La Cuenta de Valores y el contrato marcos de fondos de inversión están asociados a una cuenta corriente o de ahorro, a la que cargaremos el importe de tus órdenes de compra, las comisiones relacionadas con las operaciones y custodia de los valores que deposites, etc. También será ahí donde <strong>se te ingresará el dinero procedente de la venta de los valores y derechos</strong>, o el cobro de dividendos. ¿Aún no tienes la tuya? Contrátala ya desde Bróker online con el usuario y la contraseña de tu banca a distancia.</p></div></div></div></div></div></section><section class="container-fluid pb-10 mb-xs"><div id="tarifas" class="complex-content bgr-neutral10"><div class="cta-cont"><h2 class="cta-tit text-h5 txt-primary text-light">Las tarifas de tu bróker online</h2></div></div></section><br><section class="container-fluid pb-10 mb-xs"><div id="tabla" class="tabla-compleja"><table class="rounded bdr-1 bdr-neutral8 text-p3"><thead class="bgr-neutral8"><tr><th class="">Importe</th><th class="">Comisión por operación</th></tr></thead><tbody><tr class="group bgr-primary txt-neutral10 text-left"><th colspan="100">Mercado nacional</th></tr><tr class="values"><td class="bdr-b1 bdr-neutral8"><span>Hasta 3000 €</span></td><td class="bdr-b1 bdr-neutral8"><span>6 €</span></td></tr><tr class="values"><td class="bdr-b1 bdr-neutral8"><span>Hasta 10.000 €</span></td><td class="bdr-b1 bdr-neutral8"><span>9 €</span></td></tr><tr class="values"><td class="bdr-b1 bdr-neutral8"><span>Hasta 30.000 €</span></td><td class="bdr-b1 bdr-neutral8"><span>15 €</span></td></tr><tr class="values"><td class="bdr-b1 bdr-neutral8"><span>Resto operaciones</span></td><td class="bdr-b1 bdr-neutral8"><span>0,15%</span></td></tr></tbody><tbody><tr class="group bgr-green txt-neutral10 text-left"><th colspan="100">Mercados internacionales</th></tr><tr class="values"><td class="bdr-b1 bdr-neutral8"><span>Hasta 20.000 €</span></td><td class="bdr-b1 bdr-neutral8"><span>20 €</span></td></tr><tr class="values"><td class="bdr-b1 bdr-neutral8"><span>Resto operaciones</span></td><td class="bdr-b1 bdr-neutral8"><span>0,30 %</span></td></tr></tbody><tfoot class="text-p4"><tr><td colspan="100"><p>Si eres cliente de ABANCA y realizas tus operación a través del bróker online desde tu banca electrónica o app, tendrás una <strong>tarifa plana por operación</strong>, en función del volumen de la compraventa y del mercado en el que quieras operar.</p><p>Recuerda que, como en cualquier operación bursátil, <strong>deberás abonar las tasas y cánones de la Bolsa</strong>, que son comunes a todas las entidades, además de los gastos de correo si aún no has activado el servicio gratuito de e-correspondencia. Además debes de tener en cuenta los costes vinculados a la custodia de los valores.</p><p>Para más información sobre costes y gastos puedes ponerte en contacto con nosotros o <a href="/files/documents/es-tarifa-valores-8d45ee84.pdf">consultar este documento.<span class='accessible_hidden'>Ver archivo PDF</span></a></p><p>Además, debes de tener en cuenta que algunos productos, como los ETFs y fondos de inversión tiene sus propios costes que minoran la rentabilidad de los mismos. Antes de tomar cualquier decisión de inversión debes tener en cuenta este aspecto. Puedes consultar los costes y gastos en la documento de información de datos fundamentales del propio fondo así como en el documento de costes y gastos que ABANCA pone a tu disposición.</p></td></tr></tfoot></table></div></section><section class="mt-xs mb-xs"><div class="faqs container"><h2 class="faqs-tit text-h5 txt-primary text-light">¿Tienes dudas sobre el Broker Online de ABANCA? Nosotros tenemos las respuestas</h2><h3 class="faqs-sub text-p2 txt-bold txt-primary">Dudas</h3><div class="faqs-collapse"><div class="collapse bgr-neutral10 bdr-1 bdr-primary" data-group="faq-results"><button id="faq1-button" class="collapse-root collapseToggle eventocollapse" aria-expanded="false" type="button" data-action="inbentaClick" data-target="parent-next" aria-controls="faq1-panel"><span class="collapse-tit text-p1 txt-primary text-light">¿Puedo programar inversiones automáticas con el Bróker Online de ABANCA?</span> <i class="icon-24 icon-ic-arrow-big-down txt-primary" aria-hidden="true"></i></button><div id="faq1-panel" class="collapse-cont text-p2 text-light txt-neutral1" role="region" aria-labelledby="faq1-button" style="" hidden="hidden"><p>Actualmente, el Bróker Online de ABANCA está diseñado para que seas tú quien decida las órdenes de compra y venta que quieras realizar en tiempo real según tus estrategias. Si buscas automatización operativa, puedes dar una orden de aportación periódica sobre algunos fondos de inversión pero para ello debes acudir a una oficina.&nbsp;</p></div></div><div class="collapse bgr-neutral10 bdr-1 bdr-primary" data-group="faq-results"><button id="faq2-button" class="collapse-root collapseToggle eventocollapse" aria-expanded="false" type="button" data-action="inbentaClick" data-target="parent-next" aria-controls="faq2-panel"><span class="collapse-tit text-p1 txt-primary text-light">¿Qué herramientas de análisis ofrece el Bróker Online de ABANCA?</span> <i class="icon-24 icon-ic-arrow-big-down txt-primary" aria-hidden="true"></i></button><div id="faq2-panel" class="collapse-cont text-p2 text-light txt-neutral1" role="region" aria-labelledby="faq2-button" style="" hidden="hidden"><p></p><meta charset="utf-8"><p></p><p style="line-height:1.3800000000000001;margin-bottom:0;margin-top:0" dir="ltr"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap">Para ayudarte a tomar tus decisiones de inversión, el</span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"><strong> Bróker Online de ABANCA</strong></span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"> pone a tu disposición una plataforma avanzada con:</span></span></p><ul style="margin-bottom:0;margin-top:0;padding-inline-start:48px"><li style="background-color:transparent;color:#000;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre" dir="ltr" aria-level="1"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"><strong>Gráficos interactivos</strong></span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"> para realizar el seguimiento de la evolución de los activos analizados.</span></span></li><li style="background-color:transparent;color:#000;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre" dir="ltr" aria-level="1"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"><strong>Fichas detalladas</strong></span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"> de cada valor con información fundamental y técnica.</span></span></li><li style="background-color:transparent;color:#000;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre" dir="ltr" aria-level="1"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"><strong>Buscadores avanzados</strong></span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"> para filtrar acciones o fondos según tus preferencias.</span></span></li><li style="background-color:transparent;color:#000;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre" dir="ltr" aria-level="1"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"><strong>Información de mercado</strong></span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap"> actualizada para seguir la evolución y tendencias del entorno financiero.</span></span></li></ul></div></div><div class="collapse bgr-neutral10 bdr-1 bdr-primary" data-group="faq-results"><button id="faq3-button" class="collapse-root collapseToggle eventocollapse" aria-expanded="false" type="button" data-action="inbentaClick" data-target="parent-next" aria-controls="faq3-panel"><span class="collapse-tit text-p1 txt-primary text-light">¿Se puede combinar el Bróker Online de ABANCA con otros productos de inversión?</span> <i class="icon-24 icon-ic-arrow-big-down txt-primary" aria-hidden="true"></i></button><div id="faq3-panel" class="collapse-cont text-p2 text-light txt-neutral1" role="region" aria-labelledby="faq3-button" style="" hidden="hidden"><p></p><meta charset="utf-8"><p></p><p style="line-height:1.3800000000000001;margin-bottom:0;margin-top:0" dir="ltr"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap">¡Por supuesto! El Bróker Online de ABANCA es la herramienta de la Banca Móvil para operar en algunos productos de inversión como acciones, ETFs y fondos de inversión, así como consultar las posiciones en dichos productos, en planes de pensiones o&nbsp; en el servicio de Carteras Gestionadas. Además, desde la banca móvil o electrónica podrás consultar y operar también sobre tus cuentas corrientes. Así tendrás una visión global de todo tu patrimonio y podrás utilizar el disponible que tengas en tus cuentas corrientes para operar en el bróker de forma inmediata.</span></span></p><p style="line-height:1.3800000000000001;margin-bottom:0;margin-top:0" dir="ltr"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap">La inmediatez de movimientos aplica exclusivamente al efectivo disponible. Recuerda que la venta o reembolso de instrumentos financieros (como acciones o fondos de inversión) y la liquidez de los planes de pensiones están sujetas a los plazos de liquidación y a las condiciones normativas o fiscales específicas de cada producto.</span></span></p></div></div><div class="collapse bgr-neutral10 bdr-1 bdr-primary" data-group="faq-results"><button id="faq4-button" class="collapse-root collapseToggle eventocollapse" aria-expanded="false" type="button" data-action="inbentaClick" data-target="parent-next" aria-controls="faq4-panel"><span class="collapse-tit text-p1 txt-primary text-light">¿Existen recursos educativos para aprender a invertir con el Bróker Online de ABANCA?</span> <i class="icon-24 icon-ic-arrow-big-down txt-primary" aria-hidden="true"></i></button><div id="faq4-panel" class="collapse-cont text-p2 text-light txt-neutral1" role="region" aria-labelledby="faq4-button" style="" hidden="hidden"><p></p><meta charset="utf-8"><p></p><p style="line-height:1.3800000000000001;margin-bottom:0;margin-top:0" dir="ltr"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap">Sí, en ABANCA promovemos la educación financiera para que conozcas a fondo el funcionamiento de los mercados. Por eso, acompañamos el uso del Bróker Online de ABANCA con:</span></span></p><ul style="margin-bottom:0;margin-top:0;padding-inline-start:48px"><li style="background-color:transparent;color:#000;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre" dir="ltr" aria-level="1"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap">Videos formativos sobre actualidad económica y operativa bursátil general.</span></span></li><li style="background-color:transparent;color:#000;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre" dir="ltr" aria-level="1"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap">Guías didácticas que explican conceptos clave (como qué es un dividendo o cómo aprender a leer un gráfico).</span></span></li><li style="background-color:transparent;color:#000;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;list-style-type:disc;text-decoration:none;vertical-align:baseline;white-space:pre" dir="ltr" aria-level="1"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap">Análisis de mercado de carácter genérico para ayudarte a comprender el contexto macroeconómico y financiero de forma global.</span></span></li></ul><p style="line-height:1.3800000000000001;margin-bottom:0;margin-top:0" dir="ltr"><span><span style="background-color:transparent;font-family:Arial,sans-serif;font-size:11pt;font-style:normal;font-variant:normal;font-weight:400;text-decoration:none;vertical-align:baseline;white-space:pre-wrap">Todos los recursos formativos, análisis, seminarios y materiales didácticos ofrecidos tienen una finalidad exclusivamente educativa e informativa. No constituyen, ni deben interpretarse como asesoramiento financiero, recomendaciones personalizadas de inversión, ni una invitación o solicitud de compraventa de ningún instrumento financiero.</span></span></p></div></div></div><div class="faqs-link"><a class="btn-lnk btn-lnk-p1 lnk-primary text-light text-underline" href="/es/ayuda/productos/" title="" target="_blank">Más preguntas y respuestas sobre Broker Online<span class='accessible_hidden'>Se abrirá en una nueva ventana</span></a></div></div></section><section class="container-fluid pb-10 mb-xs" id="disclaimer"><div class="legales container"><div class="collapse bgr-neutral10 bdr-1 bdr-primary collapse-on" data-group="legal-results"><h2><button id="btn-disclaimer" class="collapse-root" type="button" aria-expanded="true" aria-controls="panel-disclaimer"><span class="collapse-tit text-p1 txt-primary text-light">Más información </span><i class="icon-24 icon-ic-arrow-big-down txt-primary" aria-hidden="true"></i></button></h2><div id="panel-disclaimer" class="collapse-cont text-p2 txt-neutral1 text-light" role="region" aria-labelledby="btn-disclaimer"><p>ABANCA Corporación Bancaria S.A. (ABANCA) advierte que toda la información publicada en esta sección ha sido elaborada por ABANCA tomando como fuente para determinados contenidos a terceros, y se ha elaborado sin tomar en cuenta la información personal y específica del usuario, por lo que en ningún caso representa opinión, estimación, predicción, recomendación o asesoramiento en materia de inversión por parte de ABANCA ni de terceros.</p><p><strong>La información se proporciona exclusivamente a efectos informativos y publicitarios sin que pueda estimarse como elemento determinante para la toma de decisiones por parte del usuario.</strong></p><p>ABANCA no responderá por las pérdidas, directas o indirectas, ocasionadas por el uso de la información aquí expuesta.</p><p>Queda completamente prohibida la reproducción o distribución de la información aquí contenida por cualquier medio sin la previa autorización de ABANCA.</p><p>La <strong>adquisición de instrumentos financieros conlleva riesgos</strong> de diversa tipología que deben ser asumidos por el inversor.</p><p>La naturaleza y alcance del riesgo dependerá del tipo de instrumento. A modo de resumen, los principales riesgos que ha de asumir un inversor son los siguientes: de precio, de tipo de cambio, de crédito, de interés y de falta de liquidez. Otros riesgos atienden a muy diversos orígenes y circunstancias: entornos políticos, económicos y sociales en general.</p></div></div></div></section></main><footer class="mainFooter rounded bgr-gradient-vertical-primary"><div class="footer-top"><div class="footer-tit text-h4 text-center">¿En qué podemos ayudarte?</div><div class="container-p0"><div class="row"><div class="col-md-8 offset-md-2 col-sm-10 offset-sm-1"><form class="footer-finder form-style1" action="/es/resultados-busqueda/" role="search"><div class="form-group form-group-block input-group1"><label for="formBuscadorFooter" class="sr-only">Buscar</label><div class="input-group"><input class="form-control" type="search" id="formBuscadorFooter" name="q" placeholder="Buscar" aria-label="Buscar" enterkeyhint="search" inputmode="search"> <button type="submit" class="input-group-icon" aria-label="Buscar"><i class="icon-24 icon-ic-search" aria-hidden="true"></i></button></div></div></form></div></div></div></div><div class="footer-middle"><div class="footer-blqs"><div class="footer-blq collapse collapseCustom" data-group="footer-menu"><button id="footer-menu0-button" class="collapse-root lnk-neutral1 footer-menu-button" type="button" aria-expanded="false" aria-controls="footer-menu0-panel"><span class="footer-tit btn-lnk lnk-primary text-bold text-p2">Sobre ABANCA</span> <i class="icon-24 icon-ic-arrow-small-down" aria-hidden="true"></i></button><div id="footer-menu0-panel" class="collapse-cont" role="region" aria-labelledby="footer-menu0-button" hidden><div><a href="https://comunicacion.abanca.com/es/" class="btn-lnk btn-lnk-p3" rel="nofollow">Sala de comunicación<span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></div><div><a href="https://www.abancacorporacionbancaria.com/es/" class="btn-lnk btn-lnk-p3" rel="nofollow">Información corporativa<spa