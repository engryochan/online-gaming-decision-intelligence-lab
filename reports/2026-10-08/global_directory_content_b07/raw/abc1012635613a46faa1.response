<style id="wp-custom-css">
.jet-listing-grid--7147 {
  justify-content: center;
}

strong {
  font-weight: bold !important;
}

:root{
  --icon-size: 56px;
  --gap: 16px;
  --fg: #0f172a;
  --muted: #475569;
  --accent: #2563eb;
  --bg: #ffffff;
  --ring: rgba(37,99,235,.25);
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#0b1020;
    --fg:#e5e7eb;
    --muted:#94a3b8;
    --accent:#60a5fa;
    --ring: rgba(96,165,250,.25);
  }
}

.month-icons{
  display:grid;
  grid-template-columns: repeat(6, minmax(0,1fr));
  gap: var(--gap);
  align-items: start;
}
@media (max-width: 900px){
  .month-icons{ grid-template-columns: repeat(4, minmax(0,1fr)); }
}
@media (max-width: 600px){
  .month-icons{ grid-template-columns: repeat(3, minmax(0,1fr)); }
}

.mi-item{
  display:flex; flex-direction:column; align-items:center; gap:8px;
  text-align:center;
}
.mi-icon{
  width: var(--icon-size); height: var(--icon-size);
  display:grid; place-items:center;
  border-radius: 14px;
  background: linear-gradient(180deg, var(--bg), #f8fafc);
  border: 1px solid #e2e8f0;
  box-shadow:
    0 1px 1px rgba(0,0,0,.06),
    0 6px 12px rgba(0,0,0,.04);
  transition: transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  position:relative;
}
@media (prefers-color-scheme: dark){
  .mi-icon{
    background: linear-gradient(180deg, #0b1020, #0f172a);
    border-color:#1f2937;
    box-shadow: 0 1px 1px rgba(0,0,0,.35), 0 8px 14px rgba(0,0,0,.35);
  }
}
.mi-item:hover .mi-icon{
  transform: translateY(-2px);
  box-shadow:
    0 2px 4px rgba(0,0,0,.10),
    0 12px 20px rgba(37,99,235,.10);
  border-color: var(--ring);
}
.mi-title{
  font: 600 12px/1.2 system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji", "Segoe UI Emoji";
  color: var(--muted);
  letter-spacing:.02em;
}
/* Tooltip */
.mi-icon::after{
  content: attr(data-month);
  position:absolute; bottom: calc(100% + 8px); left:50%; transform:translateX(-50%);
  font: 600 12px/1 system-ui, -apple-system, Segoe UI, Roboto, Arial;
  color:#fff; background:#111827; padding:6px 8px; border-radius:8px;
  opacity:0; pointer-events:none; white-space:nowrap;
  transition: opacity .15s ease, transform .15s ease;
  box-shadow: 0 6px 20px rgba(0,0,0,.25);
}
.mi-item:hover .mi-icon::after{ opacity:1; transform:translate(-50%, -2px); }
/* SVG defaults */
.mi-icon svg{ width: 62%; height:62%; display:block; }
.stroke{ stroke: var(--accent); stroke-width:2; fill: none; stroke-linecap:round; stroke-linejoin:round; }
.fill{ fill: var(--accent); }

/* Inline month icon style (emoji-based) */
.ym-icon{
  display:inline-block;
  width:1.4em; height:1.4em;
  line-height:1;
  margin-right:.5em;
  vertical-align:-0.15em; /* nudges icon to align with text */
  font-size:1.25em;       /* adjust to taste */
}

</style>
</head>
