<script>
	jQuery( document ).ready(function() {
		jQuery('#swiperAwardsSlider .e-con-inner').addClass('swiper-wrapper');
		jQuery('#swiperAwardsSlider .e-con-inner').removeClass('e-con-inner');
		jQuery('#swiperAwardsSlider').append('<div class="swiper-button-prev"></div><div class="swiper-button-next"></div><div class="swiper-scrollbar"></div>');
		jQuery('#swiperAwardsSlider .elementor-widget-image-box').each(function() {
			jQuery(this).addClass('swiper-slide');
		});
		var swiperElement = document.getElementById('swiperAwardsSlider');
		var scrollbar = {
			'el' : '.swiper-scrollbar',
			'enabled' : true,
			'hide' : false
		};
		var navigation = {
			nextEl: '.swiper-button-next',
			prevEl: '.swiper-button-prev'
		};
		var swiperConfig = {
			'slidesPerView': 'auto',
			'spaceBetween': 32,
			'breakpoints': {
				0: {
					spaceBetween: 12,
					'scrollbar': scrollbar
				},
				768: {
					spaceBetween: 32,
					'scrollbar': scrollbar
				}
			},
			'scrollbar': scrollbar,
			'pagination': false,
			'navigation': navigation
		};
		
		if ( 'undefined' === typeof Swiper ) {
			const asyncSwiper = elementorFrontend.utils.swiper;
			new asyncSwiper( swiperElement, swiperConfig ).then( ( newSwiperInstance ) => {
				mySwiper = newSwiperInstance;
			});
		} else {
			mySwiper = new Swiper( swiperElement, swiperConfig );
		}
		
		//Testimonal Slider
		function Observer(o, property){
			var _this = this;
			var value = o[property];
			this.observers = [];

			this.Observe = function (notifyCallback){
				_this.observers.push(notifyCallback);
			}

			Object.defineProperty(o, property, {
				set: function(val){
					_this.value = val;
					for(var i = 0; i < _this.observers.length; i++) _this.observers[i](val);
				},
				get: function(){
					return _this.value;
				}
			});
		}

		const swiperTarget = document.querySelector('#testimonialSlider .swiper'); 
		var observer = new Observer(swiperTarget, 'swiper');
		observer.Observe(function(newValue){
			jQuery('#testimonialSlider .swiper').append('<div class="swiper-scrollbar"></div>');
				const swiperNeigh = newValue;
				swiperNeigh.on('afterInit', function() {
					swiperNeigh.params.breakpoints[0].slidesPerView = 1;
					swiperNeigh.params.breakpoints[0].spaceBetween = 0;
					swiperNeigh.params.scrollbar.el = '.swiper-scrollbar';
					swiperNeigh.params.scrollbar.enabled = false;
					swiperNeigh.params.scrollbar.hide = false;

					swiperNeigh.params.breakpoints[0].scrollbar = {
						'el' : '.swiper-scrollbar',
						'enabled' : true,
						'hide' : false
					}
					
					swiperNeigh.params.breakpoints[767].scrollbar = {
						'el' : '.swiper-scrollbar',
						'enabled' : true,
						'hide' : false
					}
					
					swiperNeigh.params.breakpoints[1024].scrollbar = {
						'el' : '.swiper-scrollbar',
						'enabled' : true,
						'hide' : false
					}

					swiperNeigh.currentBreakpoint = false;
					swiperNeigh.update();
				});
				swiperNeigh.on('slideChangeTransitionEnd', function() {
					jQuery('html, body').animate({
						scrollTop: jQuery("#testimonial-container").offset().top - 120
					}, 500);
				});
		});
	});
</script>
<script src="https://boards.greenhouse.io/embed/job_board/js?for=drivewealth"></script>
	</body>
</html>
