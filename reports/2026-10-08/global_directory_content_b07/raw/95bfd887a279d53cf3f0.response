ems-center "><div class="d-sm-none"><a class="Button-module-scss-module__l3L4kG__button Button-module-scss-module__l3L4kG__secondary undefined d-flex align-items-center justify-content-center" href="/#contact-section">Contact us</a></div><div class="d-sm-none"><a class="Button-module-scss-module__l3L4kG__button Button-module-scss-module__l3L4kG__outlined undefined d-flex align-items-center justify-content-center" href="https://accounts.finstreet.ae" target="_blank">Login</a></div><div class="d-sm-none"><a class="Button-module-scss-module__l3L4kG__button Button-module-scss-module__l3L4kG__primary undefined d-flex align-items-center justify-content-center" href="https://accounts.finstreet.ae/signup" target="_blank">Register</a></div><div class="Header-module-scss-module__EgdGsq__burger d-flex align-items-center"><a type="button"><svg viewBox="0 0 24 24" style="width:2.3rem;height:2.3rem" role="presentation"><path d="M3,6H21V8H3V6M3,11H21V13H3V11M3,16H21V18H3V16Z" style="fill:currentColor"></path></svg></a><style data-emotion="css 14yoxd">.css-14yoxd{z-index:1200;}</style></div></div></div></header></div><main class="layout-module-scss-module__82Yv0W__layoutContent"><div class="page-module-scss-module__o_b0MG__homepage d-flex flex-column"><section id="video-section" class="section1-module-scss-module__jXag4a__videoSection d-flex align-items-center justify-content-center"><video autoPlay="" loop="" muted="" playsInline="" preload="auto"><source src="Home/finstreetVideo.mp4" type="video/mp4"/>Your browser does not support the video tag.</video><div class="section1-module-scss-module__jXag4a__gradient"></div><div class="section1-module-scss-module__jXag4a__content d-flex flex-column justify-content-between"><div class="section1-module-scss-module__jXag4a__text"><h1 class="section1-module-scss-module__jXag4a__title d-flex flex-column"><div>One Platform</div><div class="section1-module-scss-module__jXag4a__line2 d-flex align-items-center justify-content-center"><span>All Markets</span></div></h1></div><div class="section1-module-scss-module__jXag4a__tag"><p class="section1-module-scss-module__jXag4a__first">#<span class="bold">Changing</span>Markets</p></div><div class="section1-module-scss-module__jXag4a__disclaimer d-flex justify-content-center align-items-center"><img src="Reusable/check.svg" alt="check.svg"/><p>Regulated by <span class="underline">FSRA</span> in ADGM</p></div></div></section><section id="overview-section" class="section2-module-scss-module__khCvfG__overviewSection d-flex align-items-center justify-content-center"><div class="section2-module-scss-module__khCvfG__sectionCore d-flex align-items-start justify-content-between"><div class="section2-module-scss-module__khCvfG__left"><p class="section2-module-scss-module__khCvfG__title d-flex align-items-center"><span class="section2-module-scss-module__khCvfG__line line"></span><span>Overview</span></p><div><div style="opacity:0;visibility:hidden"><div class="section2-module-scss-module__khCvfG__content d-flex flex-column"><h2 class="section2-module-scss-module__khCvfG__head">We Are Finstreet. We Are<!-- --> <div class="d-i-block">#<span class="bold">Changing</span></div>Markets.</h2><p class="section2-module-scss-module__khCvfG__text">Demands of the global capital markets and international trade are constantly evolving - the need for speed, efficiency, global coverage and innovation are greater than ever before. Yet market infrastructure is lacking.</p><div class="section2-module-scss-module__khCvfG__text">By leveraging next-generation technology, Finstreet unlocks for issuers and investors  (Professional Clients) access to global markets, through providing financing solutions for tomorrow, today. It&#x27;s time to start<!-- --> <div class="d-i-block">#<span class="bold">Changing</span></div>Markets.</div><div class="section2-module-scss-module__khCvfG__solutions d-flex align-items-end"><a class="section2-module-scss-module__khCvfG__item" href="#investors-section">Investors</a><span class="section2-module-scss-module__khCvfG__line"></span><a class="section2-module-scss-module__khCvfG__item" href="#issuers-section">Issuers</a><span class="section2-module-scss-module__khCvfG__line"></span><a class="section2-module-scss-module__khCvfG__item" href="#asset-section">Asset Servicing</a></div></div></div></div></div><div class="section2-module-scss-module__khCvfG__right"><img src="Home/Infinite.png" alt="infinite.png"/></div></div></section><section id="investors-section" class="template-module-scss-module__wJoqNG__slidersSection d-flex align-items-center justify-content-center"><div class="template-module-scss-module__wJoqNG__sectionCore"><div class="template-module-scss-module__wJoqNG__paragraph"><div class="template-module-scss-module__wJoqNG__top d-flex justify-content-between align-items-center"><p class="template-module-scss-module__wJoqNG__title">Investors</p><div class="template-module-scss-module__wJoqNG__line line"></div></div><div class="template-module-scss-module__wJoqNG__content d-flex align-items-start justify-content-between"><div class="template-module-scss-module__wJoqNG__left"><p class="template-module-scss-module__wJoqNG__text">For Investors</p><div class="template-module-scss-module__wJoqNG__bullets d-flex flex-column"><div class="template-module-scss-module__wJoqNG__bullet template-module-scss-module__wJoqNG__active d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/bank.svg" alt="bank.svg"/></div><span>Access to trade exempt offers </span></div><div class="template-module-scss-module__wJoqNG__bullet  d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/note.svg" alt="note.svg"/></div><span>Greater Liquidity </span></div><div class="template-module-scss-module__wJoqNG__bullet  d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/marker.svg" alt="marker.svg"/></div><span>360 Trading </span></div></div></div><div class="template-module-scss-module__wJoqNG__right"><div class="slider-module-scss-module__QuSg7q__sliderWrapper"><div class="swiper slider-module-scss-module__QuSg7q__slider"><div class="swiper-wrapper"><div class="swiper-slide"><img src="Home/Slide1/Card1.jpg" alt="Card1.jpg"/><p class="slider-module-scss-module__QuSg7q__description">Finstreet offers a unique proposition for investors (Professional Clients), providing access to greater liquidity, global connectivity and trading across all stages of financing, seamlessly from one centralized platform.</p></div><div class="swiper-slide"><img src="Home/Slide1/Card2.jpg" alt="Card2.jpg"/><p class="slider-module-scss-module__QuSg7q__description">Finstreet enables the world’s leading investors and issuers to drive liquidity and value-accretive exit opportunities, unlock access to cutting-edge deal flow, and risk-weighted return on capital.</p></div><div class="swiper-slide"><img src="Home/Slide1/Card3.jpg" alt="Card3.jpg"/><p class="slider-module-scss-module__QuSg7q__description">Finstreet provides a 360 degree offering, linking East and West to maximize investment opportunities from one centralized global marketplace. All assets are held in secure custody within our own Central Securities Depository directly, or through our network of international partners.</p></div></div></div><div class="slider-module-scss-module__QuSg7q__arrows d-flex justify-content-end"><button class="slider-module-scss-module__QuSg7q__arrow slider-module-scss-module__QuSg7q__disabled d-flex align-items-center justify-content-center"><svg viewBox="0 0 24 24" style="width:2.4rem;height:2.4rem" role="presentation"><path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" style="fill:currentColor"></path></svg></button><button class="slider-module-scss-module__QuSg7q__arrow  d-flex align-items-center justify-content-center"><svg viewBox="0 0 24 24" style="width:2.4rem;height:2.4rem" role="presentation"><path d="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" style="fill:currentColor"></path></svg></button></div></div></div></div></div></div></section><section id="issuers-section" class="template-module-scss-module__wJoqNG__slidersSection d-flex align-items-center justify-content-center"><div class="template-module-scss-module__wJoqNG__sectionCore"><div class="template-module-scss-module__wJoqNG__paragraph"><div class="template-module-scss-module__wJoqNG__top d-flex justify-content-between align-items-center"><p class="template-module-scss-module__wJoqNG__title">Issuers</p><div class="template-module-scss-module__wJoqNG__line line"></div></div><div class="template-module-scss-module__wJoqNG__content d-flex align-items-start justify-content-between"><div class="template-module-scss-module__wJoqNG__left"><p class="template-module-scss-module__wJoqNG__text">For Issuers</p><div class="template-module-scss-module__wJoqNG__bullets d-flex flex-column"><div class="template-module-scss-module__wJoqNG__bullet template-module-scss-module__wJoqNG__active d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/note.svg" alt="note.svg"/></div><span class="undefined">Enhanced Liquidity </span></div><div class="template-module-scss-module__wJoqNG__bullet  d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/globe2.svg" alt="globe2.svg"/></div><span>A Gateway to Global Markets</span></div><div class="template-module-scss-module__wJoqNG__bullet  d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/chart.svg" alt="chart.svg"/></div><span>Long-Term Value Creation </span></div></div></div><div class="template-module-scss-module__wJoqNG__right"><div class="slider-module-scss-module__QuSg7q__sliderWrapper"><div class="swiper slider-module-scss-module__QuSg7q__slider"><div class="swiper-wrapper"><div class="swiper-slide"><img src="Home/Slide2/Card1.jpg" alt="Card1.jpg"/><p class="slider-module-scss-module__QuSg7q__description">Finstreet offers a flexible and powerful solution for issuers worldwide seeking to unlock liquidity and institutional capital to fuel future growth. Our platform provides access to a widespread pool of financing at different stages of growth.</p></div><div class="swiper-slide"><img src="Home/Slide2/Card2.jpg" alt="Card2.jpg"/><p class="slider-module-scss-module__QuSg7q__description">Through our extensive global network, we connect issuers to investors(Professional Client) not only within Abu Dhabi but across key international markets, enabling efficient capital-raising and strategic partnerships.</p></div><div class="swiper-slide"><img src="Home/Slide2/Card3.jpg" alt="Card3.jpg"/><p class="slider-module-scss-module__QuSg7q__description">With our cutting-edge technology, issuers can streamline the capital-raising process and maximize the potential of their financing strategies. Finstreet is your partner in accelerating the next phase of your growth journey.</p></div></div></div><div class="slider-module-scss-module__QuSg7q__arrows d-flex justify-content-end"><button class="slider-module-scss-module__QuSg7q__arrow slider-module-scss-module__QuSg7q__disabled d-flex align-items-center justify-content-center"><svg viewBox="0 0 24 24" style="width:2.4rem;height:2.4rem" role="presentation"><path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" style="fill:currentColor"></path></svg></button><button class="slider-module-scss-module__QuSg7q__arrow  d-flex align-items-center justify-content-center"><svg viewBox="0 0 24 24" style="width:2.4rem;height:2.4rem" role="presentation"><path d="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" style="fill:currentColor"></path></svg></button></div></div></div></div></div></div></section><section id="asset-section" class="template-module-scss-module__wJoqNG__slidersSection d-flex align-items-center justify-content-center"><div class="template-module-scss-module__wJoqNG__sectionCore"><div class="template-module-scss-module__wJoqNG__paragraph"><div class="template-module-scss-module__wJoqNG__top d-flex justify-content-between align-items-center"><p class="template-module-scss-module__wJoqNG__title">Asset Servicing</p><div class="template-module-scss-module__wJoqNG__line line"></div></div><div class="template-module-scss-module__wJoqNG__content d-flex align-items-start justify-content-between"><div class="template-module-scss-module__wJoqNG__left"><p class="template-module-scss-module__wJoqNG__text">For Asset Servicing</p><div class="template-module-scss-module__wJoqNG__bullets d-flex flex-column"><div class="template-module-scss-module__wJoqNG__bullet template-module-scss-module__wJoqNG__active d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/globe.svg" alt="globe.svg"/></div><span class="undefined">An Intelligent Ecosystem for Tomorrow’s Market</span></div><div class="template-module-scss-module__wJoqNG__bullet  d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/pointer.svg" alt="pointer.svg"/></div><span>End-to-End Servicing Through One Platform</span></div><div class="template-module-scss-module__wJoqNG__bullet  d-flex align-items-center"><div class="template-module-scss-module__wJoqNG__box d-flex justify-content-center align-items-center"><img class="template-module-scss-module__wJoqNG__icon" src="Reusable/locker.svg" alt="locker.svg"/></div><span>Regulatory and Investor Protection</span></div></div></div><div class="template-module-scss-module__wJoqNG__right"><div class="slider-module-scss-module__QuSg7q__sliderWrapper"><div class="swiper slider-module-scss-module__QuSg7q__slider"><div class="swiper-wrapper"><div class="swiper-slide"><img src="Home/Slide3/Card1.jpg" alt="Card1.jpg"/><p class="slider-module-scss-module__QuSg7q__description">In addition to facilitating global trading through<!-- --> <span class="bold">Finstreet Global Markets Ltd</span>, Finstreet’s Central Securities Depository holds global assets securely, for both inbound and outbound clients.</p></div><div class="swiper-slide"><img src="Home/Slide3/Card2.jpg" alt="Card2.jpg"/><p class="slider-module-scss-module__QuSg7q__description">Our platform covers the full lifecycle of transaction services including settlement, safekeeping, and the processing of income and corporate action events. In addition, Finstreet provides the ability to pledge and block your assets in favour of lenders globally.</p></div><div class="swiper-slide"><img src="Home/Slide3/Card3.jpg" alt="Card3.jpg"/><p class="slider-module-scss-module__QuSg7q__description">Being regulated by the FSRA in Abu Dhabi’s ADGM, Finstreet’s three regulated entities meet the highest global standards.</p></div></div></div><div class="slider-module-scss-module__QuSg7q__arrows d-flex justify-content-end"><button class="slider-module-scss-module__QuSg7q__arrow slider-module-scss-module__QuSg7q__disabled d-flex align-items-center justify-content-center"><svg viewBox="0 0 24 24" style="width:2.4rem;height:2.4rem" role="presentation"><path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" style="fill:currentColor"></path></svg></button><button class="slider-module-scss-module__QuSg7q__arrow  d-flex align-items-center justify-content-center"><svg viewBox="0 0 24 24" style="width:2.4rem;height:2.4rem" role="presentation"><path d="M4,11V13H16L10.5,18.5L11.92,19.92L19.84,12L11.92,4.08L10.5,5.5L16,11H4Z" style="fill:currentColor"></path></svg></button></div></div></div></div></div></div></section><section id="contact-section" class="section6-module-scss-module__NjTCZG__contactSection d-flex align-items-center justify-content-center"><div class="section6-module-scss-module__NjTCZG__sectionCore d-flex justify-content-between"><div class="section6-module-scss-module__NjTCZG__formWrapper"><div class="form-module-scss-module__zMgb4W__form"><h3 class="form-module-scss-module__zMgb4W__title false">Interested in <div class="d-i-block">#<span class="bold">Changing</span></div>Markets?<br/> Feel free to reach out</h3><form class="false"><div class="form-module-scss-module__zMgb4W__formContent d-flex flex-column "><div class="form-module-scss-module__zMgb4W__row d-flex"><style data-emotion="css 1pv2xcc">.css-1pv2xcc{display:-webkit-inline-box;display:-webkit-inline-flex;display:-ms-inline-flexbox;display:inline-flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;position:relative;min-width:0;padding:0;margin:0;border:0;vertical-align:top;}</style><div class="MuiFormControl-root MuiTextField-root form-module-scss-module__zMgb4W__input css-1pv2xcc"><style data-emotion="css aqpfg7">.css-aqpfg7{display:block;transform-origin:top left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:100%;position:absolute;left:0;top:0;-webkit-transform:translate(0, 20px) scale(1);-moz-transform:translate(0, 20px) scale(1);-ms-transform:translate(0, 20px) scale(1);transform:translate(0, 20px) scale(1);-webkit-transition:color 200ms cubic