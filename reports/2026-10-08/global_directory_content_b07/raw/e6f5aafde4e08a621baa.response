</section>
<script src="https://code.jquery.com/jquery-3.7.1.js" crossorigin="anonymous"></script>
<script src="https://cdn.datatables.net/2.0.5/js/dataTables.js" crossorigin="anonymous"></script>
<script>
   // Show current table and mark button as selected by default
   document.addEventListener('DOMContentLoaded', function () {
           var currentTable = document.getElementById('currentTable');
           var currentButton = document.querySelector('.table-buttons.selected');
           currentTable.style.display = 'block';
           currentButton.classList.add('selected');
   });

   function showTable(tableId, button) {
           // Hide all tables first
           var tables = document.querySelectorAll('.Current, .Previous');
           tables.forEach(function (table) {
                   table.style.display = 'none';
           });

           // Remove 'selected' class from all buttons
           var buttons = document.querySelectorAll('.table-buttons');
           buttons.forEach(function (btn) {
                   btn.classList.remove('selected');
           });

           // Show the selected table
           var selectedTable = document.getElementById(tableId);
           if (selectedTable) {
                   selectedTable.style.display = 'block';
           }

           // Add 'selected' class to clicked button
           button.classList.add('selected');
   }
</script>
<script>
   function scrollToDiv() {
           // Get the position of the target div
           var divPosition = document.querySelector('.page-no-div').offsetTop;

           // Scroll the page to the position of the div
           window.scrollTo({
                   top: divPosition,
                   behavior: 'smooth' // Optional: Smooth scrolling effect
           });
   }
</script>
