<script>
   function openInNewTab(url) {
           var win = window.open(url, '_blank');
           win.focus();
   }
</script>
<script type="text/javascript">
   // When the document is ready
   document.addEventListener("DOMContentLoaded", function () {
           // Get modal element
           var modal = document.getElementById('pdfModal');

           // Get <span> element that closes the modal
           var span = modal.querySelector(".close");

           // When the user clicks on <span> (x), close the modal
           span.onclick = function () {
                   modal.style.display = "none";
           };

           // Function to open modal with PDF
           function openPdfModal(pdfUrl) {
                   // Set the PDF URL in the iframe
                   document.getElementById('pdfViewer').src = pdfUrl;
                   // Display the modal
                   modal.style.display = "block";
           }

           // Event listener for the "View" button click
           var viewButtons = document.querySelectorAll('.view-rulebook');
           viewButtons.forEach(function (button) {
                   button.addEventListener('click', function () {
                           // Get the PDF URL from the viewPdf attribute
                           var pdfUrl = this.getAttribute('viewPdf');
                           // Open modal with PDF
                           openPdfModal(pdfUrl);
                   });
           });
   });
</script>
