<script>
document.addEventListener('DOMContentLoaded', function () {
    function runArchivedSearch(form) {
        var input = form.querySelector('input[name="q"]');
        var query = input ? input.value.trim() : '';
        if (query) window.location.href = '/search-results/?q=' + encodeURIComponent(query);
    }
    document.querySelectorAll('form[action="/search-results/"]').forEach(function (form) {
        form.addEventListener('submit', function (event) {
            event.preventDefault();
            runArchivedSearch(form);
        });
    });
    document.addEventListener('keydown', function (event) {
        if (event.key === 'Enter' && event.target.matches('form[action="/search-results/"] input[name="q"]')) {
            event.preventDefault();
            event.stopImmediatePropagation();
            runArchivedSearch(event.target.form);
        }
    }, true);
    document.querySelectorAll('.search-submit').forEach(function (button) {
        button.addEventListener('click', function () {
            var form = button.closest('.search-contain').querySelector('form[action="/search-results/"]');
            if (form && form.querySelector('input[name="q"]').value.trim()) runArchivedSearch(form);
        });
    });
    document.querySelectorAll('form[data-archived-form="true"]').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      window.alert('This archived form is unavailable.');
    });
  });
});
</script>
