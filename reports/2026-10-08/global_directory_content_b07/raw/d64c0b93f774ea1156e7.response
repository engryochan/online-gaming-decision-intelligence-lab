<div id="capaFiltros" class="div-formulario" data-nohide data-clear>
    <span data-navegacion="Todos" data-tipohechosrelevantes="participanteNoRnvi" data-tipoexpedientes="participantesNoRnvi" data-tipoinfofinanciera="participantesNoRnvi"></span>
    <form id="formConsultaPrincipal" data-alias-consulta="GeneralPorNombreOtrosParticipantes" data-alias-get>
        <input name="__RequestVerificationToken" type="hidden" value="vL3gpy0yuOUWbvl4ZDEE-ujtYg3CEPPuLvAH-TFoaDvcloSDMkes912PrIUaIqJ_Cfk0NeDR-wr8ypNnnGJiwXPzPwDpYvnBHN9yMoIVfMQ1" />
        
        <div id="divFiltrosPrincipales">
            <div class="row">
                <div class="col">
                    <div class="alert alert-primary alert-aliceblue" role="alert">
                            <p class="font-italic">
                                Esta sección de Otros Participantes permite consultar el listado de entidades que
                                operan en nuestro mercado de valores, según el rol que se les ha autorizado. Una vez escogido un participante, encontrará para este;
                                información general, integración de juntas directivas y comités, hechos relevantes, información financiera,
                                medidas disciplinarias y expedientes de trámites ante Sugeval.
                            </p>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-10">
                    <div class="form-group">
                        <input class="form-control" data-parameter-order="1" id="Criterio" name="Criterio" placeholder="Ingrese el criterio de búsqueda del participante" required="" type="text" value="" />
                    </div>
                </div>
                <div class="col-2">
                    <button type="submit" id="principalConsultar" class="btn btn-primary form-control">Consultar</button>
                </div>
            </div>

        </div>
    </form>
    <hr data-nohide class="ocultar-filtro" />
</div>
<div id="dockerNavegacion"></div>
<div id="dockerEncabezado"></div>
<div id="capaPrincipal"></div>
<div id="capaDetalles"></div>
<div id="capaGED"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    



