<script type="text/javascript" nonce="/a9r+me4weWgenTwKDYSWQ==">
document.addEventListener('DOMContentLoaded', function() {
   document.addEventListener('click', function(e) {
      var link = e.target.closest('[data-redirect]');
      if (link) {
         e.preventDefault();
         var redirectType = link.getAttribute('data-redirect');
         if (typeof redirectUrl === 'function') {
            redirectUrl(redirectType);
         }
      }
   });

   var searchInput = document.getElementById('searchByKeyword');
   if (searchInput) {
      searchInput.addEventListener('keypress', function(event) {
         if (typeof searchTextFn === 'function') {
            return searchTextFn(event);
         }
      });
   }
});
</script>
