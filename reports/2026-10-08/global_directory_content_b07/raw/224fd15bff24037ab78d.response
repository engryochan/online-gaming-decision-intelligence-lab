<!-- --------------------------------------
     LEGAL OVERLAY SCRIPT
--------------------------------------- -->
<script nonce="/a9r+me4weWgenTwKDYSWQ==">
(function () {
  var overlay = document.getElementById('lglOverlay');
  if (!overlay || overlay.dataset.bound) return;
  overlay.dataset.bound = '1';
  var titleEl = document.getElementById('lglTitle');
  var bodyEl  = document.getElementById('lglBody');
  var docs    = overlay.querySelectorAll('[data-legal-doc]');
  var TITLES  = { terms: 'Terms of Use', privacy: 'Privacy Policy & Cookie Notice' };

  function open(which) {
    docs.forEach(function(d) { d.hidden = d.getAttribute('data-legal-doc') !== which; });
    titleEl.textContent = TITLES[which] || 'Legal';
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    if (bodyEl) bodyEl.scrollTop = 0;
  }
  function close() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('[data-legal]').forEach(function(a) {
    a.addEventListener('click', function(e) {
      e.preventDefault();
      open(a.getAttribute('data-legal'));
    });
  });

  overlay.querySelector('.lgl-close').addEventListener('click', close);
  overlay.addEventListener('click', function(e) { if (e.target === overlay) close(); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.classList.contains('open')) close();
  });
})();
</script>

