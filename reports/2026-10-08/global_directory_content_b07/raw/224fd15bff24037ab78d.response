<!-- -- HEADER SCRIPTS -- -->
<script nonce="/a9r+me4weWgenTwKDYSWQ==">
// Mobile drawer
(function() {
  var trigger  = document.getElementById('mobTrigger');
  var drawer   = document.getElementById('mobDrawer');
  var backdrop = document.getElementById('mobBackdrop');
  function openMenu() {
    var otBanner = document.getElementById('onetrust-banner-sdk');
    if (otBanner) { otBanner.style.display = 'none'; }
    document.body.classList.add('nav-open');
    trigger.setAttribute('aria-expanded', 'true');
    drawer.classList.add('open');
    backdrop.classList.add('open');
    document.body.style.overflow = 'hidden';
  }
  function closeMenu() {
    var otBanner = document.getElementById('onetrust-banner-sdk');
    if (otBanner) { otBanner.style.display = ''; }
    document.body.classList.remove('nav-open');
    trigger.setAttribute('aria-expanded', 'false');
    drawer.classList.remove('open');
    backdrop.classList.remove('open');
    document.body.style.overflow = '';
  }
  trigger.addEventListener('click', function() {
    document.body.classList.contains('nav-open') ? closeMenu() : openMenu();
  });
  backdrop.addEventListener('click', closeMenu);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMenu(); });
}());

function mobToggle(id) {
  var item = document.getElementById(id);
  var wasOpen = item.classList.contains('open');
  document.querySelectorAll('.mob-drw-item').forEach(function(el) { el.classList.remove('open'); });
  if (!wasOpen) item.classList.add('open');
}
document.querySelectorAll('[data-mob-toggle]').forEach(function (btn) {
  btn.addEventListener('click', function () { mobToggle(btn.getAttribute('data-mob-toggle')); });
});
</script>

<script nonce="/a9r+me4weWgenTwKDYSWQ==">
// Nav dropdown click-to-open
(function() {
  var navItems = document.querySelectorAll('.nav-item');
  navItems.forEach(function(item) {
    if (!item.querySelector('.dropdown')) return;
    item.querySelector('.nav-link').addEventListener('click', function(e) {
      e.preventDefault();
      var isOpen = item.classList.contains('open');
      navItems.forEach(function(i) { i.classList.remove('open'); });
      if (!isOpen) item.classList.add('open');
    });
  });
  document.addEventListener('click', function(e) {
    if (!e.target.closest('.nav-item')) navItems.forEach(function(i) { i.classList.remove('open'); });
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') navItems.forEach(function(i) { i.classList.remove('open'); });
  });
}());
</script>

<script nonce="/a9r+me4weWgenTwKDYSWQ==">
// Header search expand
(function () {
  var header = document.querySelector('.site-header');
  var btns = [document.getElementById('headerSearchBtn'), document.getElementById('mobSearchBtn')].filter(Boolean);
  var input = document.getElementById('headerSearchInput');
  if (!header || !btns.length) return;
  function setAria(open) {
    btns.forEach(function(b) {
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      b.setAttribute('aria-label', open ? 'Close search' : 'Search');
    });
  }
  function openSearch()  { header.classList.add('searching'); setAria(true); if (input) input.focus(); }
  function closeSearch() { header.classList.remove('searching'); setAria(false); if (input) { input.value = ''; input.blur(); } }
  btns.forEach(function(b) {
    b.addEventListener('click', function(e) {
      e.preventDefault();
      header.classList.contains('searching') ? closeSearch() : openSearch();
    });
  });
  if (input) {
         input.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeSearch();
            if (typeof searchTextFn === 'function') {
               searchTextFn(event);
            }
         });
      }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && header.classList.contains('searching')) closeSearch();
  });
}());
</script>

<style nonce="/a9r+me4weWgenTwKDYSWQ==">
  /* Sticky header stack - utility bar hides on scroll-down, reappears on scroll-up */
  .header-stack { position: sticky; top: 0; z-index: 150; transition: transform 0.3s ease; }
  .header-stack > .site-header { position: static; }
  .header-stack.util-hidden { transform: translateY(var(--util-shift, -35px)); }
  @media (max-width: 768px) { .header-stack.util-hidden { transform: none; } }
</style>
<script nonce="/a9r+me4weWgenTwKDYSWQ==">
(function () {
  var utility = document.querySelector('.utility-bar');
  var header  = document.querySelector('.site-header');
  if (!utility || !header) return;
  var stack = document.createElement('div');
  stack.className = 'header-stack';
  utility.parentNode.insertBefore(stack, utility);
  stack.appendChild(utility);
  stack.appendChild(header);
  var UTIL_H = utility.offsetHeight || 35;
  stack.style.setProperty('--util-shift', '-' + UTIL_H + 'px');
  var lastY = window.scrollY || window.pageYOffset || 0;
  var ticking = false;
  function update() {
    var y = window.scrollY || window.pageYOffset || 0;
    if (y <= UTIL_H)      stack.classList.remove('util-hidden');
    else if (y > lastY + 2) stack.classList.add('util-hidden');
    else if (y < lastY - 2) stack.classList.remove('util-hidden');
    lastY = y; ticking = false;
  }
  window.addEventListener('scroll', function() {
    if (!ticking) { window.requestAnimationFrame(update); ticking = true; }
  }, { passive: true });
}());
</script>

<style nonce="/a9r+me4weWgenTwKDYSWQ==">
  /* Utility-bar Sign-in dropdown */
  .utility-login { position: relative; margin-left: 0; height: 35px; display: flex; align-items: center; }
  .utility-login-trigger { font-size: 12px; font-weight: 400; color: #48617b; text-decoration: none; height: 35px; display: flex; align-items: center; gap: 5px; cursor: pointer; transition: color 0.15s; padding-left: 10px; }
  .utility-login-trigger:hover, .utility-login.open .utility-login-trigger { color: var(--blue-500); }
  .utility-login-caret { transition: transform 0.16s ease; }
  .utility-login.open .utility-login-caret { transform: rotate(180deg); }
  .utility-login-menu { position: absolute; top: 100%; right: 0; min-width: 230px; background: var(--neutral-0); border-radius: 6px; border: 1px solid var(--neutral-150, #d8dce8); box-shadow: 0 8px 32px rgba(3,8,26,0.14), 0 2px 8px rgba(3,8,26,0.06); padding: 8px 0; opacity: 0; visibility: hidden; transform: translateY(-4px); transition: opacity 0.16s ease, transform 0.16s ease, visibility 0.16s; pointer-events: none; z-index: 200; }
  .utility-login.open .utility-login-menu { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: all; }
  @media (max-width: 768px) { .utility-login { display: none; } }
</style>
<script nonce="/a9r+me4weWgenTwKDYSWQ==">
(function () {
  var wrap = document.querySelector('.utility-login');
  if (!wrap) return;
  var trigger = wrap.querySelector('.utility-login-trigger');
  function close() { wrap.classList.remove('open'); trigger.setAttribute('aria-expanded', 'false'); }
  function open()  { wrap.classList.add('open');    trigger.setAttribute('aria-expanded', 'true'); }
  trigger.addEventListener('click', function(e) { e.preventDefault(); wrap.classList.contains('open') ? close() : open(); });
  document.addEventListener('click', function(e) { if (!e.target.closest('.utility-login')) close(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') close(); });
}());
</script>

