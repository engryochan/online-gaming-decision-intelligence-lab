			let editorInstance5;

			let activeEditor = null;
			let editorInstances = {}; // Object to store editor instances by their index

			// Ensure the global object exists
			window.editorInstances = window.editorInstances || {};

			// ClassicEditor.create(document.querySelector('.ckeditor5'), editorConfig);
			$(".ckeditor5").each(function(index,element) {
				ClassicEditor.create(element, editorConfig)
				.then(editor => {
		      // editorInstance5 = editor;
		      editorInstances[index] = editor; // Store editor instance with index as key
        	  window.editorInstances[index] = editor; // Also store globally
		      element.dataset.editorId = index; // Assign a unique id to each instance
		      editor.id = index;

		      // // Just to show which elements have which ids for debugging purposes
		      // console.log(index);
		      // console.log(element);

		      // element.addEventListener('click', () => {
		      //     activeEditor = editor; // Set active editor when clicked
		      //     console.log(activeEditor);
		      // });

		      // Trigger autosave when editor loses focus
		      editor.model.document.on('change:data', function() {
		        clearTimeout(editor.autosaveTimeout);
		        editor.autosaveTimeout = setTimeout(function() {
		          // const $field = $(editor.sourceElement);
		          const correctField = $(editor.sourceElement).attr('name');
		          const surroundedForm = $(editor.sourceElement.form).attr('id');
		          const surroundedFormAction = $(editor.sourceElement.form).attr('action');

		          // alert('autosave should run');
		          const validForms = ['report-form', 'mc-form', 'or-form','myForm'];

							if (validForms.includes(surroundedForm)) {
		          	handleAutoSave(correctField, editor.getData(),surroundedForm,surroundedFormAction);
		          }
		        }, 2000); // save 2 seconds after user stops typing
		      });
		    });
			});

			// Function to update the editor data
		  function updateEditorData(newData,index) {
		  	index = index !== undefined ? index : 0;
		  	if (editorInstances[index]) {
		        editorInstances[index].setData(newData);
		    } else {
		        console.error(`Editor instance with index ${index} is not ready.`);
		    }
		      // if (editorInstance5) {
		      //     editorInstance5.setData(newData);
		      //     // console.log(newData);
		      // } else {
		      //     console.error('Editor instance is not ready.');
		      // }
		  }
		  window.updateEditorData = updateEditorData;
		  // document.getElementById('UpdateButton').addEventListener('click', updateEditorData());

		  function handleAutoSave($field, overrideValue,formType,formAction) {
			  // const form = $('#autosave-form');
			  const formData = {};

			  // Get ID (use your hidden input)
			  if(formType == 'report-form'){ //K
			  	var controllerName = 'report-forms';
			  } else if(formType == 'mc-form'){ //MC
			  	var controllerName = 'notification-of-material-changes';
			  } else if(formType == 'or-form'){
			  	var controllerName = 'or-quarterly-reports';
			  } else if(formAction.includes('properties')){
			  	var controllerName = 'properties';
			  } else if(formAction.includes('director-meetings')){
			  	var controllerName = 'director-meetings';
			  } else if(formAction.includes('other-matters-voted-upons')){
			  	var controllerName = 'other-matters-voted-upons';
			  } else if(formAction.includes('other-matter-details')){
			  	var controllerName = 'other-matter-details';
			  } else if(formAction.includes('market-reporting-issuers-equity-stockholders')){
			  	var controllerName = 'market-reporting-issuers-equity-stockholders';
			  } else if(formAction.includes('risk-factor-disclosures')){
			  	var controllerName = 'risk-factor-disclosures';
			  } else if(formAction.includes('securities-and-use-of-protocol-changes')){
			  	var controllerName = 'securities-and-use-of-protocol-changes';
			  }

			  formData['id'] = $('#form-id').val();
			  formData['field'] = $field;

			  // Determine the value
			  if (overrideValue !== undefined) {
			    formData['value'] = overrideValue;
			  } else if ($field.is(':checkbox')) {
			    formData['value'] = $field.is(':checked') ? 1 : 0;
			  } else {
			    formData['value'] = $field.val();
			  }

			  // Disable field briefly while saving
			  // $field.prop('disabled', true);
			  
			  $.ajax({
			    url: '/co/ecsin/'+controllerName+'/autosave', // adjust to your controller action
			    method: 'POST',
			    data: formData,
			    headers: {
			      'X-CSRF-Token': $('[name="_csrfToken"]').val() // ignore if CakePHP 2.x
			    },
			    success: function(response) {
			      console.log('Saved:', formData['field']);
			    },
			    error: function(xhr) {
			      console.error('Autosave failed:', xhr.responseText);
			    },
			    complete: function() {
			      $field.prop('disabled', false);
			    }
			  });
			}

		</script>

