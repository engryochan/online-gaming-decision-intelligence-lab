			class CustomFileBrowser {
			    constructor(editor) {
			        this.editor = editor;
			    }

			    init() {
			        const editor = this.editor;

			        editor.ui.componentFactory.add('customFileBrowser', locale => {
			            const view = new /*editor.ui.button.*/ButtonView(locale);

			            view.set({
			                label: 'Open File Manager',
			                icon: '<svg xmlns="http://www.w3.org/2000/svg" class="" width="24" height="24" viewBox="0 0 24 24"><path d="M11.627 16.5zm5.873-.196zm0-7.001V8h-13v8.5h4.341c.191.54.457 1.044.785 1.5H2a1.5 1.5 0 0 1-1.5-1.5v-13A1.5 1.5 0 0 1 2 2h4.5a1.5 1.5 0 0 1 1.06.44L9.122 4H16a1.5 1.5 0 0 1 1.5 1.5v1A1.5 1.5 0 0 1 19 8v2.531a6.027 6.027 0 0 0-1.5-1.228zM16 6.5v-1H8.5l-2-2H2v13h1V8a1.5 1.5 0 0 1 1.5-1.5H16z"></path><path d="M14.5 19.5a5 5 0 1 1 0-10 5 5 0 0 1 0 10zM15 14v-2h-1v2h-2v1h2v2h1v-2h2v-1h-2z"></path></svg>',
			                withText: false,
			                tooltip: true
			            });

			            view.on('execute', () => {
			                this.openFileManager();
			            });

			            return view;
			        });

			        // Add the event listener only once
			        window.addEventListener('message', (event) => {
			            this.handleMessage(event);
			        });
			    }

			    openFileManager() {
			        const editor = this.editor;
			        // console.log('My Editor ID: '+editor.id);
			        const url = '/js/filemanager/dialog.php?type=2&editor=ckeditor5&fldr=&akey=' +'&editor_id='+editor.id; //+ ""
			        this.fileManagerWindow = window.open(url, 'FileManager', 'width=900,height=600');
			    }

			    // getUrlParameter(sParam,windowUrl) {
					//     var sPageURL = windowUrl.search.substring(1),
					//         sURLVariables = sPageURL.split('&'),
					//         sParameterName,
					//         i;

					//     for (i = 0; i < sURLVariables.length; i++) {
					//         sParameterName = sURLVariables[i].split('=');

					//         if (sParameterName[0] === sParam) {
					//             return sParameterName[1] === undefined ? true : decodeURIComponent(sParameterName[1]);
					//         }
					//     }
					//     return false;
					// };

					getUrlParameter(name, url) {
					    name = name.replace(/[\[\]]/g, '\\$&');
					    var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
					        results = regex.exec(url);
					    if (!results) return null;
					    if (!results[2]) return '';
					    return decodeURIComponent(results[2].replace(/\+/g, ' '));
					}



			    // Listen for a message from the file browser
			    handleMessage(event) {
			      const editor = this.editor;

			        // Make sure the message comes from the correct origin
			        if (event.origin === 'https://www.ecsin.com' && event.data.sender == 'responsivefilemanager') {

				        	let originFullUrl = event.source.window.location.href;
				        	let correctEditorId = this.getUrlParameter('editor_id',originFullUrl);
				        	// console.log(correctEditorId);
				        	// console.log(editor.id);
				        	// console.log('editor type: '+this.getUrlParameter('type',originFullUrl));
				        	// console.log('the key: '+this.getUrlParameter('akey',originFullUrl));

				        	if(editor.id == correctEditorId){ // ensure is correct editor and files aren't being added to all editors on page
				            const fileUrl = event.data.url; // The URL of the selected file
				            const fileExt = fileUrl.substr(fileUrl.lastIndexOf('.') + 1);

				            const imageTypes = ['jpg','jpeg','gif','svg','webp','png','apng','bmp','ico'];
				            const fileTypes = ['doc','docx','pdf','xls','xlsx','ppt','pptx','css','txt'];


				            const selection = editor.model.document.selection;
			              const selectedContent = editor.model.getSelectedContent(selection);

			              let selectedText = '';
			              for (const item of selectedContent.getChildren()) {
			                  if (item.is('text')) {
			                      selectedText += item.data;
			                  }
			              }

				            const displayedText = selectedText || event.data.name;

				            // check file type to input accordingly
				            if($.inArray(fileExt,fileTypes) !== -1){ //document type

				            	editor.model.change(writer => {
				                  const insertPosition = editor.model.document.selection.getFirstPosition();
				                            
				                  // Create a link element
				                  const linkElement = writer.createElement('linkHref', {
				                      linkHref: fileUrl
				                  });

				                  // Insert the link element into the editor
				                  writer.insertText(displayedText, { linkHref: fileUrl }, insertPosition);
				              });
				            }else if($.inArray(fileExt,imageTypes) !== -1){ //image type
					            // Insert the image into the editor
					            editor.model.change(writer => {
					                const imageElement = writer.createElement('imageBlock', {
					                    src: fileUrl
					                });

					                editor.model.insertContent(imageElement, editor.model.document.selection);
					            });
					          }else{ //default insertion
					          	editor.model.change(writer => {
					          		editor.model.insertContent(writer.createText(fileUrl), editor.model.document.selection);
					          	});

					          }
					        }
			        }
			    }
			}

