</div><div class="col-sm-6 sublayout--content">    <div class="promobox" data-component="PromoBox">

        <div class="promobox__container background-light-gray promobox__has-background   "
					>
                <div class="promobox__media">
<picture>
<source media="(max-width:768px)" srcset="/-/files/hsbc/news-and-insight/2023/thumbnail-images/230705-we-are-fighting-the-cyber-criminals-of-the-future-768x576.jpg">
<source srcset="/-/files/hsbc/news-and-insight/2023/thumbnail-images/230705-we-are-fighting-the-cyber-criminals-of-the-future-768x576.jpg">
<img src="/-/files/hsbc/news-and-insight/2023/thumbnail-images/230705-we-are-fighting-the-cyber-criminals-of-the-future-768x576.jpg?la=en-GB&amp;h=576&amp;w=768&amp;hash=819FDA90813226BF9B8D50AEC79EFC58" alt="" /></picture>
                </div>
            
            <div class="promobox__content "
							>
