    			<div class="video-transcript collapse" role="region" id="id_154679f7-da5f-49a6-ba49-490e289b4a53" aria-labelledby="transcriptButton_154679f7-da5f-49a6-ba49-490e289b4a53">
			<div class="video-transcript__container">
				<div class="video-transcript__content"><style type="text/css">
