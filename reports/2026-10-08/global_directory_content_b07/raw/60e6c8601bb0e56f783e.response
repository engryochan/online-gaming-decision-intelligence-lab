								document.querySelector('.apple-business-chat-fallback-container').style.visibility = "visible";
							}
						}
					}
	        
	            });
            
            
            function iOS() {
              return [
                'iPad Simulator',
                'iPhone Simulator',
                'iPod Simulator',
                'iPad',
                'iPhone',
                'iPod'
              ].includes(navigator.platform)
              // iPad on iOS 13 detection
              || (navigator.userAgent.includes("Mac") && "ontouchend" in document)
            }
			
          }, 3000);
		  
