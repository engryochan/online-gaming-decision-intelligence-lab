					var valueDD = $(this).find('[data-id="dynamicDropdownDD"]');
				
					selectDD.on("change",function(){
						var thisSelect = $(this);
						selectDDD.removeAttr("disabled");
						selectDDD.val("");
						valueDD.val("");
					    selectDDD.find("option").addClass("hide");
					    selectDDD.find("option").prop("disabled", true);
						selectDDD.find("option[value='"+thisSelect.val()+"']").removeClass("hide");
						selectDDD.find("option[value='"+thisSelect.val()+"']").prop("disabled", false);
					});
					
					selectDDD.on("change",function(){
						valueDD.val(selectDD.val()+" |"+$(this).find("option:selected").text());
					});
				});
			});
