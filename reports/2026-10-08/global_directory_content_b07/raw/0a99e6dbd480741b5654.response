opdown-border"></div><div class="mobile-submenu-item-text">Settlements</div></div></a><a href="/charity" class="mobile-dropdown-link w-inline-block"><div id="w-node-_133469bc-ef95-b7b5-00e1-08658a36cf0e-c5656983" data-w-id="133469bc-ef95-b7b5-00e1-08658a36cf0e" class="mobile-dropdown-text-wrapper"><div class="mobile-dropdown-border"></div><div class="mobile-submenu-item-text">Charity</div></div></a></div></div></nav></div><div data-hover="false" data-delay="200" data-w-id="6ed5a864-93f5-2ff7-b3b9-95e12169609e" class="mobile_menu-dropdown w-dropdown"><div class="dropdown-toggle w-dropdown-toggle"><div class="mobile-menu-item-text">Login</div></div><nav class="mobile-dropdown-list w-dropdown-list"><div class="mobile-dropdown-content"><div class="mobile-dropdown-link-list"><a href="https://portal.afsenergy.nl/auth" target="_blank" class="mobile-dropdown-link w-inline-block"><div id="w-node-_6ed5a864-93f5-2ff7-b3b9-95e1216960a6-c5656983" data-w-id="6ed5a864-93f5-2ff7-b3b9-95e1216960a6" class="mobile-dropdown-text-wrapper"><div class="mobile-dropdown-border"></div><div class="mobile-submenu-item-text">Client Portal</div></div></a><a href="/electronic-venues/vennex" class="mobile-dropdown-link w-inline-block"><div id="w-node-_6ed5a864-93f5-2ff7-b3b9-95e1216960ab-c5656983" data-w-id="6ed5a864-93f5-2ff7-b3b9-95e1216960ab" class="mobile-dropdown-text-wrapper"><div class="mobile-dropdown-border"></div><div class="mobile-submenu-item-text">Vennex</div></div></a></div></div></nav></div><div class="mobile_nav_search-wrapper"><form action="/search" class="search-mobile w-form"><input class="search-input w-input" maxlength="256" name="query" placeholder="" type="search" id="search-2" required=""/><input type="submit" class="search-button w-button" value="Search"/></form></div></div></div></div></div><div class="main-wrapper"><section class="section-hero"><div class="hero-wrapper"><div class="hero-content-wrapper hero-without-get-in-touch"><h1 class="hero-section-title">Leading financial and environmental intermediary</h1><a href="/contact" class="btn-primary hero-section w-button">Contact Us</a></div></div><div class="hero-bg-video-wrapper"><div class="hero-bg-overlay"></div><div data-poster-url="https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b%2F67cec0fd86da4ebcf8ee0775_AFS%20Group%20-%20Corporate%20Video%2020252-poster-00001.jpg" data-video-urls="https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b%2F67cec0fd86da4ebcf8ee0775_AFS%20Group%20-%20Corporate%20Video%2020252-transcode.mp4,https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b%2F67cec0fd86da4ebcf8ee0775_AFS%20Group%20-%20Corporate%20Video%2020252-transcode.webm" data-autoplay="true" data-loop="true" data-wf-ignore="true" class="hero-bg-video w-background-video w-background-video-atom"><video id="d1bef4fc-8880-80b2-7f7c-d6df99c58bd3-video" autoplay="" loop="" style="background-image:url(&quot;https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b%2F67cec0fd86da4ebcf8ee0775_AFS%20Group%20-%20Corporate%20Video%2020252-poster-00001.jpg&quot;)" muted="" playsinline="" data-wf-ignore="true" data-object-fit="cover"><source src="https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b%2F67cec0fd86da4ebcf8ee0775_AFS%20Group%20-%20Corporate%20Video%2020252-transcode.mp4" data-wf-ignore="true"/><source src="https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b%2F67cec0fd86da4ebcf8ee0775_AFS%20Group%20-%20Corporate%20Video%2020252-transcode.webm" data-wf-ignore="true"/></video></div></div></section><section Market-Insights="" class="section bg-accent"><div class="contact-page-wrapper"><h1 class="heading2">Regulators &amp; Memberships</h1><div class="text-memberships">AFS Group subsidiaries AFS Interest, AFS Execution services and AFS E-Venues operate under supervision of the Dutch Central Bank (DNB) and are in the possession of all required licences of the Netherlands Authority for the Financial Markets (AFM). AFS Group also has memberships of the ICMA (International Capital Market Association), ACI Nederland (The Financial Markets Association). The company is also a participant in DSI (Dutch Securities Institute) and its traders have been registered at DSI. The activities of the Zurich branch are regulated by the FINMA.<br/></div></div><div class="div-regulations"><h2>Permits Dutch Authority for the Financial Markets (AFM)</h2><div class="div-regulation-devider"></div><div class="w-layout-grid grid-regulations-memberships"><h1 id="w-node-_4b838bfe-eb4f-860f-412d-6afa8baaca3a-67f16e7c" data-w-id="4b838bfe-eb4f-860f-412d-6afa8baaca3a" class="heading-memberships">AFS Interest B.V.</h1><img src="https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b/67d01323fdc24b1ec53044b7_blue%20arrow.png" loading="lazy" width="15" style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" alt="blue downward pointing arrow" id="w-node-_4d0b91af-63dc-5855-af50-8fd370086988-67f16e7c" class="downward-arrow"/><div id="w-node-_998314df-4540-0fb6-093e-4e7bd0e15eb1-67f16e7c" style="display:none" class="div-memberships"><div class="text-memberships">Investment firm license, with:<br/></div><div id="w-node-_1e78ec81-c157-f8dc-3b2a-9e3da2f1ebb0-67f16e7c" class="w-layout-grid grid-memberships"><div class="text-memberships">investment activity:<br/></div><div class="text-memberships"><em>b</em> <br/></div><div class="text-memberships">Georganiseerde handelsfaciliteit (OTF) </div><div class="text-memberships">investment services:<br/></div><div class="text-memberships"><em>b</em>   <br/></div><div class="text-memberships">Uitvoeren orders voor rekening cliënten  </div><div class="text-memberships"><br/></div><div class="text-memberships"><em>d</em> <br/></div><div class="text-memberships">Beleggingsadvies</div><div class="text-memberships"><br/></div><div class="text-memberships"><em>f</em> <br/></div><div class="text-memberships">Plaatsen zonder plaatsingsgarantie</div><div class="text-memberships">Ancillary services:<br/></div><div class="text-memberships"><em>c</em> <br/></div><div class="text-memberships">Bedrijfsadvisering</div></div><div id="w-node-bbcdc732-4166-c74a-96ff-9987bd45f994-67f16e7c" class="text-memberships">*Memberships are Dutch so they are also written in Dutch   <br/></div></div></div><div class="div-regulation-devider"></div><div class="w-layout-grid grid-regulations-memberships"><h1 id="w-node-_4f7902d6-684f-3284-bb6b-5e51f4d16c27-67f16e7c" data-w-id="4f7902d6-684f-3284-bb6b-5e51f4d16c27" class="heading-memberships">AFS Execution Services B.V.</h1><img src="https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b/67d01323fdc24b1ec53044b7_blue%20arrow.png" loading="lazy" width="15" style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" alt="blue downward pointing arrow" id="w-node-_4f7902d6-684f-3284-bb6b-5e51f4d16c29-67f16e7c" class="downward-arrow"/><div id="w-node-_4f7902d6-684f-3284-bb6b-5e51f4d16c2a-67f16e7c" style="display:none" class="div-memberships"><div id="w-node-_4f7902d6-684f-3284-bb6b-5e51f4d16c2c-67f16e7c" class="text-memberships">Execution &amp; custody departments Investment firm license, with:<br/></div><div id="w-node-_4f7902d6-684f-3284-bb6b-5e51f4d16c2b-67f16e7c" class="w-layout-grid grid-memberships grid-reguatory-membership-2"><div id="w-node-_4f7902d6-684f-3284-bb6b-5e51f4d16c33-67f16e7c" class="text-memberships">Investment activity:<br/></div><div class="text-memberships"><em>a</em><br/></div><div id="w-node-_4f7902d6-684f-3284-bb6b-5e51f4d16c3b-67f16e7c" class="text-memberships">Handel voor eigen rekening / Dealing on own account</div><div class="text-memberships">Investment services:<br/></div><div class="text-memberships"><em>a</em><br/></div><div class="text-memberships">Ontvangen en doorgeven orders / Reception and transmission of orders</div><div class="text-memberships"><br/></div><div class="text-memberships"><em>b</em><br/></div><div class="text-memberships">Uitvoeren orders voor rekening clienten / Execution of orders on behalf of clients</div><div class="text-memberships"><br/></div><div class="text-memberships"><em>c</em><br/></div><div class="text-memberships">Beleggingsadvies / Investment advice</div><div class="text-memberships"><br/></div><div class="text-memberships"><em>d</em><br/></div><div class="text-memberships">Plaatsen zonder plaatsingsgarantie / Placing without a commitment basis</div><div class="text-memberships">Ancillary Services<br/></div><div class="text-memberships"><em>a</em><br/></div><div id="w-node-fefbe310-3dff-466b-c085-a7aa6dce77be-67f16e7c" class="text-memberships">Bewaring / Safekeeping</div><div class="text-memberships"><br/></div><div class="text-memberships"><em>b</em><br/></div><div id="w-node-_668e8fcf-b769-b246-1b1b-7a81acca1590-67f16e7c" class="text-memberships">Kredietverlening / Granting credit or loans</div><div class="text-memberships"><br/></div><div class="text-memberships"><em>c</em><br/></div><div id="w-node-_0a440a96-b622-f3bc-15d6-fb12690e2847-67f16e7c" class="text-memberships">Valutawisseldiensten / Foreign exchange services</div></div><div id="w-node-_4f7902d6-684f-3284-bb6b-5e51f4d16c63-67f16e7c" class="text-memberships">* To ensure regulatory consistency, categories remain in Dutch as per the regulator’s website.<br/></div></div></div><div class="div-regulation-devider"></div><div class="w-layout-grid grid-regulations-memberships"><h1 id="w-node-e91c89ba-0eda-0769-2bff-93584ef62fb9-67f16e7c" data-w-id="e91c89ba-0eda-0769-2bff-93584ef62fb9" class="heading-memberships">AFS E-Venues B.V.</h1><img src="https://cdn.prod.website-files.com/67862b2b918229aaf5b0e12b/67d01323fdc24b1ec53044b7_blue%20arrow.png" loading="lazy" width="15" style="-webkit-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-moz-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);-ms-transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0);transform:translate3d(0, 0, 0) scale3d(1, 1, 1) rotateX(0) rotateY(0) rotateZ(0) skew(0, 0)" alt="blue downward pointing arrow" id="w-node-e91c89ba-0eda-0769-2bff-93584ef62fbb-67f16e7c" class="downward-arrow"/><div id="w-node-e91c89ba-0eda-0769-2bff-93584ef62fbc-67f16e7c" style="display:none" class="div-memberships"><div id="w-node-e91c89ba-0eda-0769-2bff-93584ef62fbe-67f16e7c" class="text-memberships">Investment firm license, with:<br/></div><div id="w-node-e91c89ba-0eda-0769-2bff-93584ef62fbd-67f16e7c" class="w-layout-grid grid-memberships"><div class="text-memberships">investment activity:         <br/></div><div class="text-memberships"><em>c</em><br/></div><div class="text-memberships">Multilaterale handelsfaciliteit (MTF)</div></div><div id="w-node-e91c89ba-0eda-0769-2bff-93584ef62ff7-67f16e7c" class="text-memberships">*Memberships are Dutch so they are also written in Dutch   <br/></div></div></div><div class="div-regulation-devider"></div></div><div class="div-regulations"><h2>Industry Memberships</h2><div class="div-regulation-devider"></div><div class="w-layout-grid grid-regulations-memberships"><h1 id="w-node-a375b03a-6da0-d031-721f-1d9105bcd843-67f16e7c" data-w-id="a375b03a-6da0-d031-721f-1d9105bcd843" class="heading-memberships"><strong>DSI (Dutch Securities Institute)</strong></h1><img src="https://cdn.prod.website-files.com/678