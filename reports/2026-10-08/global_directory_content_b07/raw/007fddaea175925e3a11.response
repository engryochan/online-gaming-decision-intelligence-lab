        if (cats.analytics) loadHubSpot();
        if (cats.advertisement) loadLinkedIn();
      }
      function loadGated() {
        if (!hasCmp) {
          loadHubSpot();
          loadLinkedIn();
          return;
        }
        applyConsent();
        document.addEventListener('cookieyes_consent_update', applyConsent);
      }

      // CookieYes itself (~170 KB with its banner + config) also waits for
      // load: injected first so its consent API and banner precede the tags.
