<section id= "0" class="f--background-f u--pt-10 u--pt-tabletm-15 u--pb-4 u--pb-tabletm-7">
  <div class="f--container">
    <div class="f--row f--row--gap-second f--gap-b">

      <div class="f--col-12 f--col-tabletl-7">
        
                  <h2 class="f--font-b f--color-a f--sp-c">Equity Sales & Trading</h2>
        
                  <p class="f--font-c f--color-b f--sp-d u--font-regular">An experienced team of salespeople and traders working with our analysts to provide timely information to clients worldwide.</p>
        
                  <div class="c--content-a"><p>The institutional equity sales and trading group is responsible for delivering Stifel’s award-winning research, banking, corporate access, and other products to clients worldwide. Through our team of experienced professionals, we cover all major markets in North America and Europe. We place particular emphasis on differentiated, research-driven products, and pride ourselves on offering exceptional service with unparalleled value.</p>
</div>
        
              </div>

      <div class="f--col-12 f--col-tabletl-5">
                  
<div class="c--cta-b c--sticky-a ">
            <p class="c--cta-b__content">Learn more about Stifel’s Alternative Trading System powered by Nasdaq technology</p>
    
            <a href="https://stifelinstitutional.com/wp-content/uploads/2025/06/STI-X-v7_equities.mp4" target="_blank" rel="noopener noreferrer" aria-label="Watch Video, opens a new window" class="c--cta-b__link">
            Watch Video             <svg viewBox="0 0 6 10">
    <path d="M0.8,10c0.1,0,0.3,0,0.4-0.1l4.4-4.5C5.8,5.3,5.8,5.1,5.8,5S5.6,4.7,5.6,4.6L1.1,0.1C0.9,0,0.6,0,0.4,0.2s-0.2,0.5,0,0.7
