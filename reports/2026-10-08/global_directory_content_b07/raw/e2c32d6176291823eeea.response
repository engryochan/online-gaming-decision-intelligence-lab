      <h3 style=" text-align: center;">Fees and Charges</h3><br><br>
      <p>
        <a style="font-size: 20px !important;" href="/AWEX-price-list.pdf" target="_blank">Fees and charges 2026-27</a>
        <br><br>
        <a style="font-size: 20px !important;" href="/Subscriptions-price-schedule.pdf" target="_blank">Subscriptions Price Schedule 2026-27</a>
      </p>
    </div>
