jQuery(document).ready(function($) {

 AOS.init({
 offset: 120,
 easing: 'ease',
 once: false,
});
setTimeout(() => {
  AOS.refreshHard();
}, 100);
console.log("refreshed");

$.fn.increment = function (from, to, duration, easing, complete) {
                        var params = $.speed(duration, easing, complete);
                        return this.each(function(){
                            var self = this;
                            params.step = function(now) {
                                self.innerText = now << 0;
                            };
                            $({number: from}).animate({number: to}, params);
                        });
                    };

        document.addEventListener('aos:in', ({ detail }) => {
                   $(detail).children('.graph-content').children('.barlist').children('.bar-item').each(function(k,v){
                            $(this).addClass("animated");
                    });

                    var limit =  $(detail).children('.active-value').children('.animate-number').attr("data-val");
                          $(detail).children('.active-value').children('.animate-number').increment(0,limit,3000, 'swing');
         });

          document.addEventListener('aos:out', ({ detail }) => {
                   $(detail).children('.graph-content').children('.barlist').children('.bar-item').each(function(k,v){
                            $(this).removeClass("animated");
          });

     });
    $(window).on('unload', function() {
           $(window).scrollTop(0);
     });
    }); 
});document.addEventListener("DOMContentLoaded", function(event) { 
    jQuery(document).ready(function( $ ){
var $card = $('.card-item');
var lastCard = $(".card-container .card-item").length - 1;
var totalItem = $('.card-container .card-item').length;
var css= "";


$('.card-container .card-item').each(function (index) {
var childNum= index+1;
    var scale = totalItem > 1 ? 0.6 + (index / (totalItem - 1)) * 0.4  : 1;
          scale = Math.min(Math.max(scale, 0.6), 1);

    var translateY = (totalItem -index) * 60;
             css += ".card-container .card-item:nth-child("+ childNum+ ") { transform: scale("+scale.toFixed(3) +") translateY(-"+translateY.toFixed(1)+"px); }\n";


    });
   $("#vertical-card-widths").html(css);


$('.next-button, .card-container').click(function(){ 
	var prependList = function() {
		if( $('.card-item').hasClass('activeNow') ) {
			var $slicedCard = $('.card-item').slice(lastCard).removeClass('transformThis activeNow');
			$('.card-container').prepend($slicedCard);
		}
	}
	$('.card-item').last().removeClass('transformPrev').addClass('transformThis').prev().addClass('activeNow');
	setTimeout(function(){prependList(); }, 150);
});

$('.prev').click(function() {
	var appendToList = function() {
		if( $('.card-item').hasClass('activeNow') ) {
			var $slicedCard = $('.card-item').slice(0, 1).addClass('transformPrev');
			$('.card-container').append($slicedCard);
		}}
	
$('.card-item').removeClass('transformPrev').last().addClass('activeNow').prevAll().removeClass('activeNow');
	setTimeout(function(){appendToList();}, 250);
});

});
});document.addEventListener("DOMContentLoaded", function(event) { 
    jQuery(document).ready(function( $ ){

const $tabs = $(".coh-style-horizontal-tab-panel .tab-button-title");
const $contents = $(".coh-style-horizontal-tab-panel .content-item");

  $tabs.first().addClass("active");
  $contents.first().show().addClass("active");

  $(".coh-style-horizontal-tab-panel .tab-button-title").on("click", function (e) {
    e.preventDefault();
    var index = $(this).index();
    const $currentTab = $(".tab-button-title.active");
    const $nextTab = $(this);
    let $currentContent = $(".content-item.active");
    let $nextContent = $contents.eq(index);

    if ($nextTab.hasClass("active")) return; //do nothing if active

     $(".coh-style-horizontal-tab-panel .tab-button-title").removeClass("active");
     $nextTab.addClass("active");

    $(".coh-style-horizontal-tab-panel .content-item").hide().removeClass("active");
    $nextContent.fadeIn(500).addClass("active");


  });


  //for mobile
  $(".coh-style-horizontal-tab-panel .mobile-tab-title").on("click", function (e) {
    e.preventDefault();
    const parent = $(this).parent(".content-item");
    if (parent.hasClass("active")) {
        return;
    }else{
      $(".content-item").removeClass("active");
      parent.addClass("active");
    } 

  });
  
  
  
  




});
});document.addEventListener("DOMContentLoaded", function () {
  const wrapper = document.querySelector(".vertical-accordion-wrapper");
  if (!wrapper) return;

  const items = wrapper.querySelectorAll(".vertical-accordion-item");
  const collapsedWidth = 60;
  const totalItems = items.length;

  /* ===============================
     OUTER ACCORDION
  =============================== */
  function updateArrowDirections(activeIndex) {
    items.forEach((item, i) => {
      item.classList.remove("arrow-left", "arrow-right");

      if (i < activeIndex) {
        item.classList.add("arrow-right");
      } else if (i > activeIndex) {
        item.classList.add("arrow-left");
      }
    });
  }
  function initAccordion() {
    const containerWidth = wrapper.offsetWidth;
    const expandedWidth = containerWidth - collapsedWidth * (totalItems - 1);

    items.forEach((item, index) => {
      const content = item.querySelector(
        ".vertical-accordion-content-container",
      );
      const animTargets = content.querySelectorAll(
        ".content-title, .content-wysiwyg",
      );

      /* Remove Site Studio inline display:none */
      content.style.display = "block";

      if (index === 0) {

        item.classList.add("active");
        updateArrowDirections(index);

        gsap.set(item, { width: expandedWidth });
        gsap.set(content, { opacity: 1 });
        gsap.set(animTargets, { y: 0, opacity: 1 });
      } else {
        item.classList.remove("active");

        gsap.set(item, { width: collapsedWidth });
        gsap.set(content, { opacity: 0 });
        gsap.set(animTargets, { y: 40, opacity: 0 });
      }
    });
  }

  function expandItem(activeItem) {
    const containerWidth = wrapper.offsetWidth;
    const expandedWidth = containerWidth - collapsedWidth * (totalItems - 1);

    items.forEach((item) => item.classList.remove("active"));
    activeItem.classList.add("active");

    items.forEach((item) => {
      const content = item.querySelector(
        ".vertical-accordion-content-container",
      );
      const animTargets = content.querySelectorAll(
        ".content-title, .content-wysiwyg",
      );

      if (item === activeItem) {
        gsap.to(item, {
          width: expandedWidth,
          duration: 0.8,
          ease: "power3.inOut",
        });

        gsap.to(content, {
          opacity: 1,
          duration: 0.4,
          delay: 0.3,
        });

        gsap.to(animTargets, {
          y: 0,
          opacity: 1,
          duration: 0.6,
          ease: "power3.out",
          stagger: 0.06,
          delay: 0.4,
        });
      } else {
        gsap.to(item, {
          width: collapsedWidth,
          duration: 0.8,
          ease: "power3.inOut",
        });

        gsap.to(content, {
          opacity: 0,
          duration: 0.3,
        });

        gsap.to(animTargets, {
          y: 40,
          opacity: 0,
          duration: 0.3,
        });
      }
    });
  }

  items.forEach((item, index) => {
    item.addEventListener("click", function (e) {
      /* Prevent inner accordion clicks from triggering outer */
      if (e.target.closest(".item-accordion")) return;

      if (!item.classList.contains("active")) {
        expandItem(item);
        updateArrowDirections(index);
      }
    });
  });

  

  initAccordion();
  window.addEventListener("resize", initAccordion);
});document.addEventListener('DOMContentLoaded', function () {
  const table = document.getElementById('venue-product-table');
  if (!table) return;

  const tbody = table.querySelector('tbody');
  const rows = Array.from(tbody.querySelectorAll('tr'));

  const isIvcm = (row) => row.cells[0].textContent.trim().toUpperCase() === 'IVCM';

  rows.sort((a, b) => {
    const aIvcm = isIvcm(a);
    const bIvcm = isIvcm(b);

    // Pin IVCM to the bottom.
    if (aIvcm && !bIvcm) return 1;   // a goes after b
    if (!aIvcm && bIvcm) return -1;  // a goes before b
    if (aIvcm && bIvcm) return 0;    // both IVCM — keep as-is

    // Neither is IVCM — normal alphabetical sort.
    const aText = a.cells[0].textContent.trim();
    const bText = b.cells[0].textContent.trim();
    return aText.localeCompare(bText);
  });

  tbody.innerHTML = '';
  rows.forEach((row) => tbody.appendChild(row));
});</script> 

  </div>


