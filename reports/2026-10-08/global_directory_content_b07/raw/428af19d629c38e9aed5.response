<script>
    function eventCardAlignment() {
        const eventCard = document.querySelectorAll('adgm-event-card');

        if (eventCard) {
            eventCard.forEach(item => {
                item.shadowRoot.querySelector('.date').setAttribute("style", "width: 90px !important;");
