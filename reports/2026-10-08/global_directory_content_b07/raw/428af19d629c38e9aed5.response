                                                                                                                                                                                                      <adgm-image slot="image" fit="cover" src='https://assets.adgm.com/images/assets/announcement_banner_new3_871x491.jpg/Zz0zZjE3ZmYwMmFmZGQxMWYwYWJlNmFlZjJkNzcwOThkNg==' blur-hash="" alt="ADGM Registration Authority Publishes Consultation Paper on Enhanced Strata Regulations"></adgm-image>
