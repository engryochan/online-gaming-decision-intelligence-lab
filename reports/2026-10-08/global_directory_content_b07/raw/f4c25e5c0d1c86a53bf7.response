  <script>
    tobii();
    const tobii11 = new Tobii({captions: false,nav:"auto",draggable:true,zoom:true,closeLabel:"Kapat",navLabel:["Önceki", "Sonraki"]});
    tobii11.on("close", function(){tobii11.reset();});        

    document.addEventListener("DOMContentLoaded", function() {
      [].forEach.call(document.querySelectorAll('a[href$=".pdf"]'), function(link) {
       	 link.setAttribute("target", "_blank");
      });

      [].forEach.call(document.querySelectorAll('a[href^="http"]'), function(link) {          
          if(!link.hostname.includes("spk.gov.tr")){
       	    link.setAttribute("target", "_blank");
          }
      });
    });
    
  </script>
    
