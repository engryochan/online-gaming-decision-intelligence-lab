    <h2>Blended Learning</h2><div class="table-wrapper"><table class="table-dark k-table" summary="Table 1: QB4 December 2025 Forecast Summary and Revisions from September 2025 Baseline Projections" tabindex="0" style="width:820px;"><colgroup><col /><col /><col /><col /></colgroup>
 <caption></caption><thead><tr><th style="width:270px;" data-role="resizable">Course / Programme Name</th><th colspan="2" style="text-align:center;width:30px;" data-role="resizable">Provider</th><th style="text-align:center;width:245px;" data-role="resizable">Duration</th><th style="text-align:center;width:170px;" data-role="resizable">Qualification</th></tr></thead><tbody><tr><td style="text-align:left;width:270px;"><a href="https://iob.ie/programme/sustainable-compliance-professionals" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">Professional Diploma in Sustainable Finance for GRC Professionals</a>&nbsp; </td><td colspan="2" style="text-align:center;width:30px;">IOB/Compliance Institute&nbsp;</td><td style="text-align:center;width:245px;">3 trimesters</td><td style="text-align:center;width:170px;">Level 8&nbsp; Professional Diploma</td></tr><tr><td style="text-align:left;width:270px;"><a href="https://www.lia.ie/courses/postgraduate-certificate-in-financial-management-and-sustainability" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">Postgraduate Certificate in Financial Management and Sustainability</a></td><td colspan="2" style="text-align:center;width:30px;">LIA</td><td style="text-align:center;width:245px;">Jan-May</td><td style="text-align:center;width:170px;">Certificate from ATU Sligo</td></tr><tr><td style="text-align:left;width:270px;"><a href="https://www.lia.ie/courses/master-of-business-in-financial-planning-and-sustainability" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">Master of Business in Financial Planning and Sustainability</a></td><td colspan="2" style="text-align:center;width:30px;">LIA</td><td style="text-align:center;width:245px;">Jan-May</td><td style="text-align:center;width:170px;">Level 9 Post Grad</td></tr><tr><td style="text-align:left;width:270px;"><a href="https://www.ucc.ie/en/mscisu/" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">MSc International Sustainable Business</a></td><td colspan="2" style="text-align:center;width:30px;">Cork University Business School, UCC</td><td style="text-align:center;width:245px;">1 Year full-time; 2 years part-time</td><td style="text-align:center;width:170px;">Level 9 MSc (Postgraduate Diploma)</td></tr><tr><td style="text-align:left;width:270px;"><a href="https://www.maynoothuniversity.ie/study-maynooth/postgraduate-studies/courses/msc-sustainable-financial-technology-and-innovation" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">MSc / Postgrad Diploma in Sustainable Financial Technology &amp; Innovation</a></td><td colspan="2" style="text-align:center;width:30px;">Maynooth University</td><td style="text-align:center;width:245px;">1 year part-time</td><td style="text-align:center;width:170px;">MSc or Postgrad Diploma in Sustainable Finance Technology &amp; Innovation</td></tr><tr><td style="text-align:left;width:270px;"><a href="https://springboardcourses.ie/details/15945/introduction-to-sustainability-in-business" data-sf-ec-immutable="">Introduction to Sustainability in Business</a> </td><td colspan="2" style="text-align:center;width:30px;">UCC Sustainability Academy</td><td style="text-align:center;width:245px;">12 weeks (2 hour weekly classes)</td><td style="text-align:center;width:170px;">NFQ Level 8</td></tr><tr><td style="text-align:left;width:270px;"><a href="https://springboardcourses.ie/details/15949/leading-for-sustainability-(organisational-and-personal)" data-sf-ec-immutable="">Leading for Sustainability (Organisational and Personal)</a> </td><td colspan="2" style="text-align:center;width:30px;">UCC Sustainability Academy</td><td style="text-align:center;width:245px;">12 weeks (2 hour weekly classes)</td><td style="text-align:center;width:170px;">NFQ Level 8</td></tr></tbody></table></div>
    
   

    
    <h2>Online</h2><div class="table-wrapper"><table class="table-dark k-table" summary="Table 1: QB4 December 2025 Forecast Summary and Revisions from September 2025 Baseline Projections" tabindex="0" style="width:820px;height:1652.44px;"><colgroup><col /><col /><col /><col /></colgroup>
 <caption></caption><thead><tr style="height:52px;"><th style="width:270px;" data-role="resizable">Course / Programme Name</th><th colspan="2" style="text-align:center;width:30px;" data-role="resizable">Provider</th><th style="text-align:center;width:245px;" data-role="resizable">Duration</th><th style="text-align:center;width:170px;" data-role="resizable">Qualification</th></tr></thead><tbody><tr style="height:44px;"><td style="text-align:left;width:270px;"><a href="https://iob.ie/programme/sustainable-compliance-professionals" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">Graduate Diploma in Sustainable Transformational Leadership</a> </td><td colspan="2" style="text-align:center;width:30px;">IOB</td><td style="text-align:center;width:245px;">3 trimesters</td><td style="text-align:center;width:170px;">Level 9&nbsp; Graduate Diploma</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://iob.ie/programme/esg-and-sustainable-finance-leadership-in-financial-services" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">Professional Diploma in ESG and Sustainable Finance Leadership</a></td><td colspan="2" style="text-align:center;width:30px;">IOB</td><td style="text-align:center;width:245px;">3 trimesters</td><td style="text-align:center;width:170px;">Level 9&nbsp; Professional Diploma</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://iob.ie/programme/esg-in-financial-services" target="_blank" title="Link will open in new window" data-sf-ec-immutable="">Professional Certificate in ESG in Financial Services</a></td><td colspan="2" style="text-align:center;width:30px;">IOB</td><td style="text-align:center;width:245px;">1 trimester</td><td style="text-align:center;width:170px;">Level 7 Professional Certificate</td></tr><tr style="height:83px;"><td style="text-align:left;width:270px;"><a href="https://www.charteredaccountants.ie/professional-development/specialist-qualifications/certificate-in-sustainability-strategy-risk-reporting" target="_blank" data-sf-ec-immutable="" data-sf-marked="">Certificate in Sustainability Strategy, Risk &amp; Reporting</a></td><td colspan="2" style="text-align:center;width:30px;">Chartered Accountants Ireland (CAI)</td><td style="text-align:center;width:245px;">8 weeks</td><td style="text-align:center;width:170px;">Certificate in Sustainability Strategy, Risk and Reporting</td></tr><tr style="height:83px;"><td style="text-align:left;width:270px;"><a href="https://www.charteredaccountants.ie/professional-development/specialist-qualifications/sustainability-diplomas" data-sf-ec-immutable="">Diploma in Sustainability Reporting &amp; Assurance</a></td><td colspan="2" style="text-align:center;width:30px;">Chartered Accountants Ireland (CAI)</td><td style="text-align:center;width:245px;">6 months</td><td style="text-align:center;width:170px;">Diploma in Sustainability Reporting &amp; Assurance</td></tr><tr style="height:83px;"><td style="text-align:left;width:270px;"><a href="https://greentechskillnet.com/courses/sustainability-reporting-for-smes/" data-sf-ec-immutable="">Sustainability Reporting for SMEs</a> </td><td colspan="2" style="text-align:center;width:30px;">UCC Sustainability Academy &amp; ENSO</td><td style="text-align:center;width:245px;">8 weeks (2 hour weekly classes)</td><td style="text-align:center;width:170px;">Digital Badge</td></tr><tr style="height:64px;"><td style="text-align:left;width:270px;"><a href="https://www.iii.ie/programmes/specialty-programmes/certificate-in-climate-risk" data-sf-ec-immutable="">Certificate in Climate Risk For Financial Services Professionals</a></td><td colspan="2" style="text-align:center;width:30px;">Insurance Institute of Ireland</td><td style="text-align:center;width:245px;">14 weeks</td><td style="text-align:center;width:170px;">Level 7 Certificate in Climate Risk</td></tr><tr style="height:83px;"><td style="text-align:left;width:270px;"><a href="https://www.garp.org/scr" data-sf-ec-immutable="">Sustainability &amp; Climate Risk (SCR&reg;) Certificate</a></td><td colspan="2" style="text-align:center;width:30px;">GARP (Global Association of Risk Professionals)</td><td style="text-align:center;width:245px;">100+ hours of study - can take 3 to 4 months</td><td style="text-align:center;width:170px;">Professional Cert - SCR</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://fundsacademy.ie/micro-credentials/sustainable-finance-and-esg/" data-sf-ec-immutable="">Sustainable Finance &amp; ESG Micro‑credentials</a></td><td colspan="2" style="text-align:center;width:30px;">Funds Academy / Partner HEIs</td><td style="text-align:center;width:245px;">20-24 hours lectures</td><td style="text-align:center;width:170px;">Level 7</td></tr><tr style="height:83px;"><td style="text-align:left;width:270px;"><a href="https://www.charteredaccountants.ie/professional-development/specialist-qualifications/diploma-in-auditing-and-assuring-sustainability-reporting" data-sf-ec-immutable="">Diploma in Auditing &amp; Assuring Sustainability Reporting</a></td><td colspan="2" style="text-align:center;width:30px;">&nbsp;</td><td style="text-align:center;width:245px;">6 months</td><td style="text-align:center;width:170px;">Diploma in Auditing &amp; Assuring Sustainability Reporting</td></tr><tr style="height:64px;"><td style="text-align:left;width:270px;"><a href="https://priacademy.org/courses/?v=25400724d737" data-sf-ec-immutable="">PRI Academy (Responsible Investment / Climate Risk modules)</a></td><td colspan="2" style="text-align:center;width:30px;">PRI Academy (UN PRI)</td><td style="text-align:center;width:245px;">Ranges from 1 hour - 15 hours</td><td style="text-align:center;width:170px;">Professional training certificates</td></tr><tr style="height:64px;"><td style="text-align:left;width:270px;"><a href="https://www.icaew.com/learning-and-development/icaew-sustainability-accelerator-programme" data-sf-ec-immutable="">ICAEW Sustainability Certificate &amp; Accelerator</a></td><td colspan="2" style="text-align:center;width:30px;">ICAEW (UK)</td><td style="text-align:center;width:245px;">84 hours</td><td style="text-align:center;width:170px;">Sustainability learning excellence badge from ICAEW</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://www.maynoothuniversity.ie/study-maynooth/postgraduate-studies/courses/micro-credential-climate-risk-climate-investing" data-sf-ec-immutable="">Micro Credential in Climate Risk &amp; Climate Investing</a></td><td colspan="2" style="text-align:center;width:30px;">Maynooth University</td><td style="text-align:center;width:245px;">10 weeks</td><td style="text-align:center;width:170px;">Level 9 Micro Credential</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://www.tcd.ie/courses/microcredentials/by-school/micro-credentials---business/creating-value-with-esg---micro-credential" data-sf-ec-immutable="">Creating Value with ESG - Micro credential</a></td><td colspan="2" style="text-align:center;width:30px;">Trinity College Dublin</td><td style="text-align:center;width:245px;">6 weeks</td><td style="text-align:center;width:170px;">Level 9 Micro Credential</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://www.lia.ie/courses/sustainable-financial-adviser-course" data-sf-ec-immutable="">Sustainable Finance&nbsp; - Micro Credential</a></td><td colspan="2" style="text-align:center;width:30px;">LIA</td><td style="text-align:center;width:245px;">12 weeks</td><td style="text-align:center;width:170px;">Micro Credential</td></tr><tr style="height:102px;"><td style="text-align:left;width:270px;"><a href="https://www.ifsskillnet.ie/course-list.html?category=38" data-sf-ec-immutable="">Certificate in Climate Risk</a></td><td colspan="2" style="text-align:center;width:30px;">Insurance Institute of Ireland in conjunction with IFS Skillnet</td><td style="text-align:center;width:245px;">14 weeks</td><td style="text-align:center;width:170px;">Level 7 Certificate in Climate Risk</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://compliance.ie/Public/iCore/Events/Event_display.aspx?EventKey=EV24SP0372" data-sf-ec-immutable="">Sustainability Regulatory Reporting (short course)</a></td><td colspan="2" style="text-align:center;width:30px;">Compliance Institute</td><td style="text-align:center;width:245px;">4 weeks</td><td style="text-align:center;width:170px;"><br /></td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://www.unepfi.org/learning-and-development-for-finance-professionals/risk-management/esra-online-course/" data-sf-ec-immutable="">Environmental &amp; Social Risk Analysis (ESRA) Online Course</a></td><td colspan="2" style="text-align:center;width:30px;">United Nations EP FI</td><td style="text-align:center;width:245px;">3 weeks</td><td style="text-align:center;width:170px;"><br /></td></tr><tr style="height:64px;"><td style="text-align:left;width:270px;"><a href="https://www.unepfi.org/learning-and-development-for-finance-professionals/risk-management/climate-change-training/" data-sf-ec-immutable="">Climate Change: Risk Management in the Banking Sector Online Course</a></td><td colspan="2" style="text-align:center;width:30px;">United Nations EP FI</td><td style="text-align:center;width:245px;">3 weeks</td><td style="text-align:center;width:170px;"><br /></td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://www.skillnetclimatereadyacademy.ie/sustainability-leaders-programme/" data-sf-ec-immutable="">Sustainability Leaders Programme</a></td><td colspan="2" style="text-align:center;width:30px;">Skillnet Climate Ready Academy</td><td style="text-align:center;width:245px;">8 weeks</td><td style="text-align:center;width:170px;"><br /></td></tr><tr style="height:64px;"><td style="text-align:left;width:270px;"><a href="https://priacademy.org/courses/climate-risk-for-investors/?v=25400724d737" data-sf-ec-immutable="">Climate Risk for investors (training for leadership, boards and senior management)</a></td><td colspan="2" style="text-align:center;width:30px;">PRI Academy (UN PRI)</td><td style="text-align:center;width:245px;">2 hours</td><td style="text-align:center;width:170px;">Certification of Completion</td></tr><tr style="height:64px;"><td style="text-align:left;width:270px;"><a href="https://priacademy.org/courses/responsible-investment-for-boards-and-trustees/?v=25400724d737" data-sf-ec-immutable="">Responsible Investment (training for leadership, boards and senior management)</a></td><td colspan="2" style="text-align:center;width:30px;">PRI Academy (UN PRI)</td><td style="text-align:center;width:245px;">1.5 hours</td><td style="text-align:center;width:170px;">Certification of Completion</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://effas.com/professional-certificates/effas-certified-esg-analyst-cesga/" data-sf-ec-immutable="">Certified ESG Analyst Program</a></td><td colspan="2" style="text-align:center;width:30px;">EFFAS</td><td style="text-align:center;width:245px;">Online self-learning c.2-4 months</td><td style="text-align:center;width:170px;">Professional designation</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://effas.com/certifications/effas-certified-climate-risk-analyst-ecra/" target="_blank" data-sf-ec-immutable="" data-sf-marked="">Certified Climate Risk Analyst Program</a></td><td colspan="2" style="text-align:center;width:30px;">EFFAS</td><td style="text-align:center;width:245px;">Online self-learning c.6 months</td><td style="text-align:center;width:170px;">Professional designation</td></tr><tr style="height:45px;"><td style="text-align:left;width:270px;"><a href="https://effas.com/professional-certificates/effas-esg-essentials/" data-sf-ec-immutable="">EFFAS ESG Essentials</a></td><td colspan="2" style="text-align:center;width:30px;">EFFAS</td><td style="text-align:center;width:245px;">Online self-learning c.20 Hours of study</td><td style="text-align:center;width:170px;">Professional designation</td></tr><tr style="height:102px;"><td style="text-align:left;width:270px;"><a href="https://www.cisl.cam.ac.uk/education/learn-online/business-sustainability-management-online-short-course" data-sf-ec-immutable="">Business Sustainability Management</a></td><td colspan="2" style="text-align:center;width:30px;">Cambridge Institute for Sustainability Leadership (CISL)</td><td style="text-align:center;width:245px;">8 weeks</td><td style="text-align:center;width:170px;">Certificate of completion</td></tr><tr style="height:24px;"><td style="text-align:left;width:270px;"><a href="https://www.cisl.cam.ac.uk/education/graduate-study/pgcerts/postgraduate-certificate-sustainable" data-sf-ec-immutable="">Postgraduate Certificate in Sustainable Business (PCSB) Online</a>&nbsp;</td><td colspan="2" style="text-align:center;width:30px;">Cambridge Institute for Sustainability Leadership (CISL)</td><td style="text-align:center;width:245px;">Part 1: 8 weeks <br />Part 2: 10 months</td><td style="text-align:center;width:170px;">Postgraduate Certificate, equivalent to 1/3 of a Master&rsquo;s degree</td></tr><tr style="height:25px;"><td style="text-align:left;width:270px;"><a href="https://www.cisl.cam.ac.uk/education/learn-online/sustainability-leadership-executive-programme-online-short-course" data-sf-ec-immutable="">Sustainability Leadership Executive Programme</a></td><td colspan="2" style="text-align:center;width:30px;">Cambridge Institute for Sustainability Leadership (CISL)&nbsp;</td><td style="text-align:center;width:245px;">27 weeks</td><td style="text-align:center;width:170px;">Certificate of completion</td></tr><tr style="height:25px;"><td style="text-align:left;width:270px;"><a href="https://www.cisl.cam.ac.uk/education/learn-online/self-paced-courses" data-sf-ec-immutable="">Cambridge Institute for Sustainability Leadership (CISL) Self-paced sustainability courses designed for business leaders and professionals</a></td><td colspan="2" style="text-align:center;width:30px;">Cambridge Institute for Sustainability Leadership (CISL)&nbsp;</td><td style="text-align:center;width:245px;">self-paced</td><td style="text-align:center;width:170px;">Certificate of completion</td></tr><tr style="height:25px;"><td style="text-align:left;width:270px;"><a href="https://execed-online.imperial.ac.uk/sustainability-leadership-value-creation-strategies?utm_source=Google&amp;utm_network=g&amp;utm_medium=c&amp;utm_term=imperial%20college%20sustainable%20development&amp;utm_location=1007850&amp;utm_campaign_id=17050332157&amp;utm_adset_id=133875958217&amp;utm_ad_id=789102740606&amp;gad_source=1&amp;gad_campaignid=17050332157&amp;gclid=Cj0KCQjwiJvQBhCYARIsAMjts3JGpbdzJX_TED6IA-uAIwVT2f9WDPN5320qQGsnwdMKAzp_dFhIRrQaAqrcEALw_wcB" data-sf-ec-immutable="">Sustainability Leadership: Value-Creation Strategies for a Regenerative Future</a></td><td colspan="2" style="text-align:center;width:30px;">Imperial College London</td><td style="text-align:center;width:245px;">12 weeks</td><td style="text-align:center;width:170px;">Certificate of completion</td></tr><tr style="height:25px;"><td style="text-align:left;width:270px;"><a href="https://www.cfainstitute.org/programs/sustainable-investing-certificate/curriculum" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">Sustainable Investing Certificate</a></td><td colspan="2" style="text-align:center;width:30px;">CFA Institute</td><td style="text-align:center;width:245px;">100+ hours of study - can take 3 to 4 months</td><td style="text-align:center;width:170px;">Sustainable Investing Certificate</td></tr><tr style="height:25px;"><td style="text-align:left;width:270px;"><a href="https://www.cfainstitute.org/programs/climate-investing-certificate" target="_blank" title="Link will open in a new window" data-sf-ec-immutable="">Climate Risk, Valuation, and Investing Certificate</a></td><td colspan="2" style="text-align:center;width:30px;">CFA Institute</td><td style="text-align:center;width:245px;">100+ hours of study - can take 3 to 4 months</td><td style="text-align:center;width:170px;">Sustainable Investing Certificate</td></tr></tbody></table><p>&nbsp;</p></div>
    
   

    
