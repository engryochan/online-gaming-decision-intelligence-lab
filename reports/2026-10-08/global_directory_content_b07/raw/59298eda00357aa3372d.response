<script id="jquery-js-after">
	jQuery(document.body).ready(function(){
    	jQuery('.tablepress tbody tr').click('.column-3', function(){
			
			switch ('equities') {
				case "equities":
					symbol = jQuery(this).find('td:nth-last-child(2)').html()
				break;

				case "corporate":
					symbol = jQuery(this).find('td:nth-last-child(6)').html()
				break;
				
				default:
				symbol = jQuery(this).find('td:nth-last-child(6)').html()			

			}		
			
            if(!symbol) return

            window.location.href = '/profiles/'.concat(symbol,'?type=equities');
    	 });

        var t = jQuery('.tablepress').find('tr td[data-country]')
        if(t) t.click(function(){
					if (this.tagName == 'A') return true;
					
        	 var self =jQuery(this).closest('tr').toggleClass('country-collapse').nextUntil(jQuery('td[data-country]').closest('tr')).toggle();
        })
    });
//# sourceURL=jquery-js-after
</script>
<script id="video_popup_main_modal-js-extra">
var theVideoPopupGeneralOptions = {"wrap_close":"false","no_cookie":"false","debug":"0"};
//# sourceURL=video_popup_main_modal-js-extra
</script>
