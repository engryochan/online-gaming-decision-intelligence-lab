    categories: {
      necessary: {
        readOnly: true
      },
      functionality: { },
      analytics: { },
      marketing: { }
    },
      language: {
        default: 'cs',
        autoDetect: "browser",
        translations: {
          'cs': {
            consentModal: {
              title: "We use cookies!",
