1e6269\",\"originalFilename\":\"Supply Shift to Renewables.jpg\",\"size\":1158969,\"extension\":\"jpg\",\"url\":\"https://cdn.sanity.io/images/bpyvas7v/production/e8e523193053812b0f76124414062607c67629b3-723x977.jpg\"}},\"title\":\"Supply Shift to Renewables\u2028\"},{\"_key\":\"1b9f65a0a5da\",\"_type\":\"steps\",\"paragraph\":\"Demand for electricity is increasing at an unprecedented pace, with AI and data centers consuming a growing percentage of the global power supply, and the electrification of consumer products requiring more electricity produced per individual than ever before.\",\"stepImage\":{\"_type\":\"image\",\"alt\":\"high-demand\",\"asset\":{\"_ref\":\"image-a64ccfd335c07945e243e47c35c7bb19ac627ef4-687x922-jpg\",\"_type\":\"reference\"},\"data\":{\"blurHash\":\"dfH_S%InNcoe~9WEsmof?boes;s:xCt6RjjZE1xaagbH\",\"lqip\":\"data:image/jpeg;base64,\",\"dominantColor\":\"#707592\",\"originalFilename\":\"steps2.jpg\",\"size\":799663,\"extension\":\"jpg\",\"url\":\"https://cdn.sanity.io/images/bpyvas7v/production/a64ccfd335c07945e243e47c35c7bb19ac627ef4-687x922.jpg\"}},\"title\":\"High Demand on the Grid\u2028\"},{\"_key\":\"9be1a308f40c\",\"_type\":\"steps\",\"paragraph\":\"The cost of electricity now spikes wildly in times of high demand, and power users in renewable-friendly locations such as Texas and California are severely impacted in these scenarios. Unusually hot days see prices jump exponentially as available supply is choked.\",\"stepImage\":{\"_type\":\"image\",\"alt\":\"short-term\",\"asset\":{\"_ref\":\"image-9bc8062644b4522ee70e7c8642d763dec7739324-6240x4160-jpg\",\"_type\":\"reference\"},\"data\":{\"blurHash\":\"VKKcq20O58?Y~A04R*OF9IM}%KNI=^oeNI%1jZNHofof\",\"lqip\":\"data:image/jpeg;base64,\",\"dominantColor\":\"#f9dc83\",\"originalFilename\":\"shutterstock_2206559863 (2).jpg\",\"size\":19046478,\"extension\":\"jpg\",\"url\":\"https://cdn.sanity.io/images/bpyvas7v/production/9bc8062644b4522ee70e7c8642d763dec7739324-6240x4160.jpg\"}},\"title\":\"Short-Term Price Exposure\u2028\"}]}]\n"])</script><script>self.__next_f.push([1,"19:[\"$\",\"$L34\",null,{\"_key\":\"b88a60d0e367\",\"_type\":\"blue-slide-text\",\"subtitle\":\"Trade | Hedge | Monetize\",\"text\":[{\"_key\":\"65948129e8dd\",\"_type\":\"block\",\"children\":[{\"_key\":\"0c42bdc76180\",\"_type\":\"span\",\"marks\":[],\"text\":\"ElectronX offers \"},{\"_key\":\"9aa2b1d99fdd\",\"_type\":\"span\",\"marks\":[\"blue\"],\"text\":\"small-sized, short-duration products,\"},{\"_key\":\"73290b45602a\",\"_type\":\"span\",\"marks\":[],\"text\":\" including bounded futures and binary options for hourly periods, on a platform structured \"},{\"_key\":\"ebcb643f8fc2\",\"_type\":\"span\",\"marks\":[\"blue\"],\"text\":\"to manage electricity price risk against short-term volatility.\"}],\"markDefs\":[],\"style\":\"normal\"},{\"_key\":\"5047538f2029\",\"_type\":\"block\",\"children\":[{\"_key\":\"686a58e6ccdc\",\"_type\":\"span\",\"marks\":[\"gray\"],\"text\":\"\"}],\"markDefs\":[],\"style\":\"normal\"}],\"title\":\"Precision \\nTrading for\\nPower Volatility\"}]\n36:T472,data:image/png;base64,:T866,"])</script><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"38:T7c2,"])</script><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"39:T752,"])</script><script>self.__next_f.push([1,"data:image/png;base64,"])</script><script>self.__next_f.push([1,"1a:[\"$\",\"$L35\",null,{\"_key\":\"2f7826596ee2\",\"_type\":\"blue-list\",\"items\":[{\"_key\":\"797655ea3185\",\"_type\":\"item\",\"image\":{\"_type\":\"image\",\"alt\":\"a blue square with white lines around it on a black background\",\"asset\":{\"_ref\":\"image-26ac27ef6fd729d0c94773b0eb128d8da58af162-2511x2472-png\",\"_type\":\"reference\"},\"data\":{\"blurHash\":\"eH9Q,kt74TM|-@j]j@ayayfR4TWB%ixaxVaxayazoeoe-@oexVWCD%\",\"lqip\":\"$36\",\"dominantColor\":\"#6673b3\",\"originalFilename\":\"Frame 49.png\",\"size\":1349515,\"extension\":\"png\",\"url\":\"https://cdn.sanity.io/images/bpyvas7v/production/26ac27ef6fd729d0c94773b0eb128d8da58af162-2511x2472.png\"}},\"text\":\"Participate without brokers or high capital requirements, and trade via our web-based trading application, third-party trading applications, or API\",\"title\":\"Highly accessible market for all users\"},{\"_key\":\"79008d8fd5c1\",\"_type\":\"item\",\"image\":{\"_type\":\"image\",\"alt\":\"a blue and white square with a black background\",\"asset\":{\"_ref\":\"image-158e6158e6a3bc2db2908b84908d50647b5c64d7-2265x2264-png\",\"_type\":\"reference\"},\"data\":{\"blurHash\":\"e8HVuz_200~n00?ct9RpRpWX00Iu-;ax%f~oRkNG%FIU00NM%gIpkY\",\"lqip\":\"$37\",\"dominantColor\":\"#a4abc7\",\"originalFilename\":\"Frame 51.png\",\"size\":4755682,\"extension\":\"png\",\"url\":\"https://cdn.sanity.io/images/bpyvas7v/production/158e6158e6a3bc2db2908b84908d50647b5c64d7-2265x2264.png\"}},\"text\":\"Sized in single megawatt-hours over hourly periods across many locations\",\"title\":\"Granular contracts to fit intraday volatility\"},{\"_key\":\"774285e78022\",\"_type\":\"item\",\"image\":{\"_type\":\"image\",\"alt\":\"a blue and white background with circles on it\",\"asset\":{\"_ref\":\"image-0e61ddfcf41e6e2292b791fc70ab191466f5b1ec-2310x2324-png\",\"_type\":\"reference\"},\"data\":{\"blurHash\":\"eGHCdCo#00og00xtfQt2j@Rk00ay~mj?S7RpfQobfQoc4TaytSay-:\",\"lqip\":\"$38\",\"dominantColor\":\"#1c55ea\",\"originalFilename\":\"Frame 50.png\",\"size\":4161139,\"extension\":\"png\",\"url\":\"https://cdn.sanity.io/images/bpyvas7v/production/0e61ddfcf41e6e2292b791fc70ab191466f5b1ec-2310x2324.png\"}},\"text\":\"Trade with the full scope of market participants, regardless of balance sheet size\",\"title\":\"Deep liquidity via diverse participant base\"},{\"_key\":\"08fbf2e89e57\",\"_type\":\"item\",\"image\":{\"_type\":\"image\",\"alt\":\"a blue circle with white squares in it\",\"asset\":{\"_ref\":\"image-ecb1de644a94dd2afe452d9d093c39a85be689a1-2327x2327-png\",\"