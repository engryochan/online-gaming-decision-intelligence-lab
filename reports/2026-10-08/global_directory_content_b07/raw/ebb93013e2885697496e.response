(function(){
  var fig=document.querySelector('.hero-globe'); if(!fig) return;
  var canvas=fig.querySelector('.hg-canvas'); if(!canvas) return;
  var ctx=canvas.getContext('2d'); if(!ctx) return;
  var labelLayer=fig.querySelector('.hg-labels');
  var stage=fig.querySelector('.hg-stage')||fig;
  var chip=document.createElement('div');chip.className='hg-time';chip.setAttribute('aria-hidden','true');chip.innerHTML='<span class="c"></span><span class="hq">HQ</span><span class="t"></span>';stage.appendChild(chip);
  var chipCity=chip.querySelector('.c'),chipTime=chip.querySelector('.t'),chipHQ=chip.querySelector('.hq');
  var OFF=[
    ['London',51.5074,-0.1278,'Europe/London'],
    ['Paris',48.8566,2.3522,'Europe/Paris'],
    ['Geneva',46.2044,6.1432,'Europe/Zurich'],
    ['Monaco',43.7384,7.4246,'Europe/Monaco'],
    ['Dubai',25.2048,55.2708,'Asia/Dubai'],
    ['Hong Kong',22.3193,114.1694,'Asia/Hong_Kong'],
    ['Sydney',-33.8688,151.2093,'Australia/Sydney']
  ];
  var OKEY={'London':'london','Paris':'paris','Geneva':'geneva','Monaco':'monaco','Dubai':'dubai','Hong Kong':'hongkong','Sydney':'sydney'};
  var HUB=0;
  function v3(lat,lon){var a=lat*Math.PI/180,b=lon*Math.PI/180;return [Math.cos(a)*Math.sin(b),Math.sin(a),Math.cos(a)*Math.cos(b)];}
  var ovecs=OFF.map(function(o){return v3(o[1],o[2]);});
  var labels=OFF.map(function(o){var el=document.createElement('span');el.className='hg-label';el.textContent=o[0];if(labelLayer)labelLayer.appendChild(el);return {el:el,cur:0};});
  function arcPts(va,vb,n){var d=Math.max(-1,Math.min(1,va[0]*vb[0]+va[1]*vb[1]+va[2]*vb[2]));var w=Math.acos(d);if(w<1e-6)return[va,vb];var sw=Math.sin(w);var p=[];for(var i=0;i<=n;i++){var t=i/n;var s1=Math.sin((1-t)*w)/sw,s2=Math.sin(t*w)/sw;p.push([va[0]*s1+vb[0]*s2,va[1]*s1+vb[1]*s2,va[2]*s1+vb[2]*s2]);}return p;}
  var arcs=[];for(var ai=0;ai<OFF.length;ai++){if(ai!==HUB)arcs.push(arcPts(ovecs[HUB],ovecs[ai],64));}
  var clens=[],ctotal=0;for(var c0=0;c0<COAST.length;c0++){clens.push(COAST[c0].length/2);ctotal+=COAST[c0].length/2;}
  var csrc=new Float32Array(ctotal*3),crot=new Float32Array(ctotal*3);
  (function(){var idx=0;for(var c=0;c<COAST.length;c++){var f=COAST[c];for(var p=0;p<f.length;p+=2){var v=v3(f[p+1]/10,f[p]/10);csrc[idx*3]=v[0];csrc[idx*3+1]=v[1];csrc[idx*3+2]=v[2];idx++;}}})();
  var grat=[];for(var la=-80;la<=80;la+=12){for(var lo=-180;lo<180;lo+=12){grat.push(v3(la,lo));}}
