    <p class="ft-base">&copy; 2026 Forte Securities Limited. All rights reserved.</p>
  </div>
</footer>

<script>
(function(){
  document.documentElement.classList.add('js');
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
    document.querySelectorAll('.rv').forEach(function(el){ el.classList.add('in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, {threshold: .12, rootMargin: '0px 0px -5% 0px'});
  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });
  /* safety: never leave content hidden */
  setTimeout(function(){
    document.querySelectorAll('.rv:not(.in)').forEach(function(el){
      if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('in');
    });
  }, 1200);
})();

/* ===== hero word reveal — ported from beui.dev TextReveal (vanilla) ===== */
(function(){
  var h1   = document.getElementById('hero-h');
  var lede = document.querySelector('.hero .lede');
  var targets = [];
  if (h1) targets.push(h1);
  if (lede) targets.push(lede);
  if (!targets.length) return;

  function reveal(){ targets.forEach(function(t){ t.classList.add('tr-ready','tr-in'); }); }

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches){ reveal(); return; }

  /* base timing in ms at 1.0×; SPEED scales all of it (lower = slower/classier) */
  var BASE = { headStart:120, headStagger:78, ledeGap:150, ledeStagger:13, durOpacity:720, durTransform:820, durFilter:900 };
  var SPEED = 0.6;

  /* wrap each word in <span.tr-word><span.tr-word-i>…</span></span>, preserving inline tags like <em> */
  function split(node, out){
    var kids = Array.prototype.slice.call(node.childNodes);
    kids.forEach(function(child){
      if (child.nodeType === 3){
        var parts = child.textContent.split(/(\s+)/);
        var frag = document.createDocumentFragment();
        parts.forEach(function(p){
          if (p === '') return;
          if (/^\s+$/.test(p)){ frag.appendChild(document.createTextNode(p)); return; }
          var w = document.createElement('span'); w.className = 'tr-word';
          var inner = document.createElement('span'); inner.className = 'tr-word-i';
          inner.textContent = p;
          w.appendChild(inner); frag.appendChild(w); out.push(inner);
        });
        node.replaceChild(frag, child);
      } else if (child.nodeType === 1){
        split(child, out);
      }
    });
  }

  var headInners = [], ledeInners = [];
  try {
    if (h1) split(h1, headInners);
    if (lede) split(lede, ledeInners);
  } catch (e){ reveal(); return; }

  function durStr(k){ return (BASE.durOpacity*k)+'ms, '+(BASE.durTransform*k)+'ms, '+(BASE.durFilter*k)+'ms'; }

  /* set each word's duration + delay, scaled by SPEED (lower = slower) */
  var k = 1 / Math.max(0.1, SPEED);
  headInners.forEach(function(inner, i){
    inner.style.transitionDuration = durStr(k);
    inner.style.transitionDelay = ((BASE.headStart + i*BASE.headStagger) * k) + 'ms';
  });
  var ledeStart = (BASE.headStart + Math.min(headInners.length, 6)*BASE.headStagger + BASE.ledeGap) * k;
  ledeInners.forEach(function(inner, i){
    inner.style.transitionDuration = durStr(k);
    inner.style.transitionDelay = (ledeStart + i*BASE.ledeStagger*k) + 'ms';
  });

  requestAnimationFrame(function(){ requestAnimationFrame(reveal); });
})();

/* stat count-up on scroll */
(function(){
  var nums = document.querySelectorAll('.stat .n');
  if (!nums.length) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (!e.isIntersecting) return;
      io.unobserve(e.target);
      var el = e.target;
      var m = el.textContent.trim().match(/^(\d+)(\D*)$/);
      if (!m) return;
      var target = parseInt(m[1],10);
      var suffix = m[2] || '';
      var from = parseInt(el.getAttribute('data-from') || '0', 10);
      var dur = 1500, t0 = null;
      function step(ts){
        if (t0 === null) t0 = ts;
        var p = Math.min((ts - t0)/dur, 1);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(from + (target - from)*eased) + suffix;
        if (p < 1) { requestAnimationFrame(step); } else { el.textContent = m[1] + suffix; }
      }
      requestAnimationFrame(step);
    });
  }, {threshold:.5});
  nums.forEach(function(el){ io.observe(el); });
})();

/* pointer-tracked border glow */
(function(){
  var cards = document.querySelectorAll('.stat,.cp,.model,.svc');
  if(!cards.length) return;
  cards.forEach(function(card){
    card.addEventListener('pointermove', function(e){
      var r = card.getBoundingClientRect();
      card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
      card.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  });
})();
</script>

<script>
(function(){
  var btn = document.getElementById('menuToggle');
  var ov  = document.getElementById('navOverlay');
  if(!btn || !ov) return;
  function open(){
    document.body.classList.add('nav-open');
    btn.setAttribute('aria-expanded','true');
    ov.removeAttribute('hidden');
    document.body.style.overflow='hidden';
  }
  function close(){
    document.body.classList.remove('nav-open');
    btn.setAttribute('aria-expanded','false');
    document.body.style.overflow='';
    setTimeout(function(){ if(!document.body.classList.contains('nav-open')) ov.setAttribute('hidden',''); }, 420);
  }
  btn.addEventListener('click', function(){
    document.body.classList.contains('nav-open') ? close() : open();
  });
  document.addEventListener('keydown', function(e){
    if(e.key==='Escape' && document.body.classList.contains('nav-open')) close();
  });
  // close when a link is chosen (same-page anchors / navigation)
  ov.querySelectorAll('a[href]').forEach(function(a){
    a.addEventListener('click', function(){ close(); });
  });
})();
</script>
<script>
(function(){
  var header = document.querySelector('header.site');
  if(!header) return;
  var hero = document.querySelector('.hero');
  var feather = document.querySelector('.hero-feather');
  function update(){
    var hh = header.offsetHeight;
    var t = hero ? (hero.offsetHeight - hh) : 40;
    if(window.scrollY > Math.max(t, 8)) header.classList.add('solid');
    else header.classList.remove('solid');
    // Feather is active only while the hero is scrolling under the header,
    // i.e. from the first pixel of scroll until the hero bottom reaches the header.
    if(feather && hero){
      var heroBottom = hero.offsetTop + hero.offsetHeight; // == start of MARKETS
      var active = window.scrollY > 6 && window.scrollY < (heroBottom - hh);
      feather.classList.toggle('on', active);
    }
  }
  update();
  window.addEventListener('scroll', update, {passive:true});
  window.addEventListener('resize', update);
})();
</script>
