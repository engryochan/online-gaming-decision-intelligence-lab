  var rot=REST,tilt=0.34;
  var DPR=Math.max(1,Math.min(window.devicePixelRatio||1,2));
  var W=0,H=0,R=0,cx=0,cy=0,bgGrad=null;
  function resize(){var r=canvas.getBoundingClientRect();W=Math.max(1,Math.round(r.width));H=Math.max(1,Math.round(r.height));canvas.width=Math.round(W*DPR);canvas.height=Math.round(H*DPR);ctx.setTransform(DPR,0,0,DPR,0,0);R=Math.min(W,H)*0.42;cx=W/2;cy=H/2;bgGrad=ctx.createRadialGradient(cx-R*0.28,cy-R*0.30,R*0.1,cx,cy,R*1.02);bgGrad.addColorStop(0,'rgba(58,102,168,0.15)');bgGrad.addColorStop(0.68,'rgba(35,34,88,0.08)');bgGrad.addColorStop(1,'rgba(35,34,88,0)');}
  var cr,sr,ct,st;
  function R3(p){var x=p[0]*cr+p[2]*sr;var z=-p[0]*sr+p[2]*cr;var y=p[1];return [x,y*ct-z*st,y*st+z*ct];}
  function fmtLocal(tz){try{return new Intl.DateTimeFormat('en-GB',{hour:'2-digit',minute:'2-digit',timeZone:tz,hour12:false}).format(new Date());}catch(e){return '';}}
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var mq=window.matchMedia?window.matchMedia('(max-width:1020px)'):{matches:false};
  var smallScreen=mq.matches;
  var hint=fig.querySelector('.hg-hint');
  var hoverI=-1,lastOD=[];
  var dragging=false,lastX=0,lastY=0,moved=0,raf=null,vRot=0;
  /* motion state machine: 'intro' eases one revolution to rest (London front); 'drag' while held; 'settling' returns to London front */
  var mode='rest', t0=0, INTRO_MS=5200, SETTLE_MS=1100, IDLE_SPEED=0.0017;
  var settleFrom=0, settleTo=0, settleTiltFrom=0, settleStart=0;
  function easeInOut(t){return t<0.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2;}
  function easeOut(t){return 1-Math.pow(1-t,3);}
  function nearestFront(r){return REST+2*Math.PI*Math.round((r-REST)/(2*Math.PI));}
  function hideHint(){if(hint)hint.classList.add('is-hidden');}
  function wake(){if(raf==null&&!reduce)raf=requestAnimationFrame(loop);}
  function clamp(v,a,b){return v<a?a:(v>b?b:v);}
  function relPos(e){var r=canvas.getBoundingClientRect();return [e.clientX-r.left,e.clientY-r.top];}
  function hitTest(mx,my){var best=-1,bd=20*20;for(var m=0;m<lastOD.length;m++){var d=lastOD[m];if(d.z<=0.05)continue;var dx=d.x-mx,dy=d.y-my,dd=dx*dx+dy*dy;if(dd<bd){bd=dd;best=d.i;}}return best;}
  function updateChipText(){if(hoverI<0)return;var o=OFF[hoverI];chipCity.textContent=o[0];chipHQ.style.display=(hoverI===HUB)?'inline-block':'none';chipTime.textContent=fmtLocal(o[3]);}
  canvas.addEventListener('pointerdown',function(e){if(reduce)return;dragging=true;mode='drag';vRot=0;hideHint();lastX=e.clientX;lastY=e.clientY;moved=0;canvas.style.cursor='grabbing';try{canvas.setPointerCapture(e.pointerId);}catch(_){}wake();e.preventDefault();});
  canvas.addEventListener('pointermove',function(e){
    if(dragging){var dx=e.clientX-lastX,dy=e.clientY-lastY;lastX=e.clientX;lastY=e.clientY;moved+=Math.abs(dx)+Math.abs(dy);rot+=dx*0.005;tilt=clamp(tilt+dy*0.005,-1.2,1.2);vRot=dx*0.005;frame();return;}
    var p=relPos(e),hit=hitTest(p[0],p[1]);
    if(hit!==hoverI){hoverI=hit;updateChipText();if(reduce)frame();else wake();}
    canvas.style.cursor=hit>=0?'pointer':'grab';
  });
  function endDrag(e){if(!dragging)return;dragging=false;canvas.style.cursor='grab';try{canvas.releasePointerCapture(e.pointerId);}catch(_){}
    if(moved<6){var p=relPos(e),hit=hitTest(p[0],p[1]);
      if(hit>=0){var ok=OKEY[OFF[hit][0]];if(ok){window.location.href='offices.html#'+ok;return;}}
      hoverI=(hoverI===hit&&hit>=0)?-1:hit;updateChipText();vRot=0;mode='idle';wake();return;}
    mode='inertia';wake();}
  canvas.addEventListener('pointerup',endDrag);canvas.addEventListener('pointercancel',endDrag);
  canvas.addEventListener('pointerleave',function(e){if(dragging){endDrag(e);}else{if(hoverI>=0){hoverI=-1;if(reduce)frame();}canvas.style.cursor='grab';}});
  function drawCoast(minF,alpha){ctx.beginPath();var idx=0;for(var c=0;c<clens.length;c++){var n=clens[c],pen=false;for(var k=0;k<n;k++){var b=(idx+k)*3;var z=crot[b+2];if(z>minF){var sx=cx+crot[b]*R,sy=cy-crot[b+1]*R;if(pen)ctx.lineTo(sx,sy);else{ctx.moveTo(sx,sy);pen=true;}}else pen=false;}idx+=n;}ctx.strokeStyle='rgba(150,196,205,'+alpha+')';ctx.lineWidth=1;ctx.stroke();}
  function placeChip(od){if(hoverI<0){chip.style.opacity='0';return;}var d=od[hoverI];if(!d||d.z<=0.05){chip.style.opacity='0';return;}var nx=d.x,ny=d.y;chip.style.left=nx.toFixed(1)+'px';chip.style.top=ny.toFixed(1)+'px';var right=(nx<W*0.58);chip.style.transform=right?'translate(14px,-50%)':'translate(calc(-100% - 14px),-50%)';chip.style.opacity='1';}
  function frame(){
    cr=Math.cos(rot);sr=Math.sin(rot);ct=Math.cos(tilt);st=Math.sin(tilt);
    ctx.clearRect(0,0,W,H);
    ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.fillStyle=bgGrad;ctx.fill();
    ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.strokeStyle='rgba(143,198,201,0.22)';ctx.lineWidth=1;ctx.stroke();
    for(var i=0;i<grat.length;i++){var gp=grat[i];var r=R3(gp);if(r[2]<=0)continue;ctx.beginPath();ctx.arc(cx+r[0]*R,cy-r[1]*R,1.0,0,Math.PI*2);ctx.fillStyle='rgba(112,158,188,'+(0.05+0.15*r[2])+')';ctx.fill();}
    for(var q=0;q<ctotal;q++){var b=q*3;var x=csrc[b],y=csrc[b+1],z0=csrc[b+2];var X=x*cr+z0*sr;var Z=-x*sr+z0*cr;crot[b]=X;crot[b+1]=y*ct-Z*st;crot[b+2]=y*st+Z*ct;}
    drawCoast(0.05,0.12);drawCoast(0.22,0.30);
    var od=[];for(var m=0;m<ovecs.length;m++){var rr=R3(ovecs[m]);od.push({i:m,x:cx+rr[0]*R,y:cy-rr[1]*R,z:rr[2]});}lastOD=od;
    ctx.lineWidth=1.5;
    for(var k2=0;k2<arcs.length;k2++){var pts=arcs[k2];for(var jj=0;jj<pts.length-1;jj++){var r1=R3(pts[jj]),r2=R3(pts[jj+1]);var f=Math.min(r1[2],r2[2]);if(f<=0.02)continue;var t2=jj/(pts.length-1);var cR=Math.round(58+85*t2),cG=Math.round(102+96*t2),cB=Math.round(168+33*t2);var al=0.26+0.6*f;ctx.beginPath();ctx.moveTo(cx+r1[0]*R,cy-r1[1]*R);ctx.lineTo(cx+r2[0]*R,cy-r2[1]*R);ctx.strokeStyle='rgba('+cR+','+cG+','+cB+','+al+')';ctx.stroke();}}
    var tms=Date.now()*0.0015;
    for(var n2=0;n2<od.length;n2++){var d=od[n2];if(d.z<=0)continue;var a=d.z,hub=(d.i===HUB),isH=(d.i===hoverI),pulse=0.5+0.5*Math.sin(tms+d.i);
      if(isH){ctx.beginPath();ctx.arc(d.x,d.y,(hub?9:7.5)+2,0,Math.PI*2);ctx.strokeStyle='rgba(182,234,238,'+(0.6*a)+')';ctx.lineWidth=1.4;ctx.stroke();}
      ctx.beginPath();ctx.arc(d.x,d.y,(hub?8:6.5)+(isH?3:0),0,Math.PI*2);ctx.fillStyle='rgba(143,198,201,'+((0.14+0.15*pulse)*a+(isH?0.14:0))+')';ctx.fill();
      ctx.beginPath();ctx.arc(d.x,d.y,hub?3.4:2.6,0,Math.PI*2);ctx.fillStyle=hub?('rgba(190,215,238,'+(0.88*a+0.12)+')'):('rgba(150,205,208,'+(0.85*a+0.15)+')');ctx.fill();
      if(isH){ctx.beginPath();ctx.arc(d.x,d.y,hub?4.2:3.5,0,Math.PI*2);ctx.fillStyle='rgba(214,238,255,'+(0.9*a)+')';ctx.fill();}
    }
    var placed=[],vis={},MIND=48,SEQ=[1,3,2],EU={1:1,2:1,3:1};
    if(od[HUB].z>0.15){vis[HUB]=Math.min(1,(od[HUB].z-0.15)/0.4);placed.push(od[HUB]);}
    var cdeg=-rot*180/Math.PI;cdeg=((cdeg+180)%360+360)%360-180;
    var dl=cdeg-3.95;dl=((dl+180)%360+360)%360-180;
    var euA=-1,euEdge=0;
    if(dl>=-36&&dl<=36){var pq=(36-dl)/72;euA=SEQ[Math.min(SEQ.length-1,Math.floor(pq*SEQ.length))];euEdge=Math.max(0,Math.min(1,(36-Math.abs(dl))/6));}
    if(euA>=0){var de=od[euA],okEU=de.z>0.15;for(var pj0=0;pj0<placed.length;pj0++){var pp0=placed[pj0],ax=de.x-pp0.x,ay=de.y-pp0.y;if(ax*ax+ay*ay<MIND*MIND){okEU=false;break;}}if(okEU){vis[euA]=Math.max(0,Math.min(1,(de.z-0.2)/0.45))*euEdge;placed.push(de);}}
    var order=od.filter(function(d){return d.z>0.2&&!EU[d.i]&&d.i!==HUB;}).sort(function(a,b){return b.z-a.z;});
    for(var oi=0;oi<order.length;oi++){var d=order[oi],ok=true;for(var pj=0;pj<placed.length;pj++){var pp=placed[pj],ddx=d.x-pp.x,ddy=d.y-pp.y;if(ddx*ddx+ddy*ddy<MIND*MIND){ok=false;break;}}if(ok){placed.push(d);vis[d.i]=Math.max(0,Math.min(1,(d.z-0.2)/0.45));}}
    if(hoverI>=0&&od[hoverI].z>0.1){vis[hoverI]=Math.max(vis[hoverI]||0,Math.max(0.25,Math.min(1,(od[hoverI].z-0.1)/0.4)));}
    for(var li=0;li<labels.length;li++){var L=labels[li],d=od[li],target=vis[li]||0;L.cur+=(target-L.cur)*((reduce||smallScreen)?1:0.15);if(L.cur<0.003){L.el.style.opacity='0';L.el.classList.remove('is-active');continue;}var rad=(li===HUB?9:7),above=d.y>46,ty=above?(d.y-rad):(d.y+rad),shift=above?'translate(-50%,-120%)':'translate(-50%,20%)';L.el.style.transform='translate('+d.x.toFixed(1)+'px,'+ty.toFixed(1)+'px) '+shift;L.el.style.opacity=L.cur.toFixed(3);L.el.classList.toggle('is-active',li===hoverI);}
    placeChip(od);
  }
  var lastT=0, onScreen=true;
  function loop(){
    var now=performance.now(),e;
    /* delta-time factor (1 at 60fps): keeps the idle spin at a constant real-time speed
       regardless of refresh rate or dropped frames — fixes machine-dependent jitter/slowness */
    var f=lastT?(now-lastT)/16.6667:1; if(f>4)f=4; if(f<0)f=0; lastT=now;
    if(mode==='intro'){e=(now-t0)/INTRO_MS;if(e>=1){rot=REST+2*Math.PI;mode='idle';}else rot=REST+2*Math.PI*easeInOut(e);}
    else if(mode==='inertia'){rot+=vRot*f;vRot*=Math.pow(0.95,f);if(Math.abs(vRot)<IDLE_SPEED){vRot=0;mode='idle';}}
    else if(mode==='idle'){if(!dragging&&hoverI<0)rot+=IDLE_SPEED*f;}
    frame();
    if(mode==='rest'&&!dragging&&hoverI<0){raf=null;lastT=0;}
    else if(onScreen){raf=requestAnimationFrame(loop);}
    else{raf=null;lastT=0;}
  }
  function start(){resize();if(reduce||smallScreen){rot=REST;mode='rest';frame();if(hint)hint.style.display='none';}else{rot=REST;mode='intro';t0=performance.now();lastT=0;raf=requestAnimationFrame(loop);}
    if('IntersectionObserver' in window){new IntersectionObserver(function(es){onScreen=es[0].isIntersecting;if(onScreen){if(!reduce&&!smallScreen&&mode!=='rest')wake();}else if(raf){cancelAnimationFrame(raf);raf=null;lastT=0;}},{threshold:0}).observe(fig);}
    setInterval(function(){if(hoverI>=0)updateChipText();},1000);}
  window.addEventListener('resize',function(){
    var was=smallScreen;smallScreen=mq.matches;resize();
    if(reduce||smallScreen){if(raf){cancelAnimationFrame(raf);raf=null;}rot=nearestFront(rot);tilt=0.34;mode='rest';frame();if(hint)hint.style.display='none';}
    else if(was){rot=REST;tilt=0.34;mode='intro';t0=performance.now();if(hint)hint.style.display='';wake();}
    else{frame();}
  });
  start();
})();
</script>
<script>
(function(){
  var KEY='forte-theme', el=document.documentElement;
  var bL=document.getElementById('segLight'), bD=document.getElementById('segDark');
  function apply(m){
    if(m==='dark'){el.setAttribute('data-theme','dark');} else {el.removeAttribute('data-theme');}
    var d=(m==='dark');
    if(bL)bL.setAttribute('aria-pressed',d?'false':'true');
    if(bD)bD.setAttribute('aria-pressed',d?'true':'false');
  }
  var cur=el.getAttribute('data-theme')==='dark'?'dark':'light';
  apply(cur);
  function set(m){cur=m;apply(m);try{localStorage.setItem(KEY,m);}catch(e){}}
  if(bL)bL.addEventListener('click',function(){set('light');});
  if(bD)bD.addEventListener('click',function(){set('dark');});
})();
</script>
<script>
/* Clients pills: click a pill to reveal its description; click away or Esc to close. */
(function(){
  var pills=document.querySelectorAll('#cpPills .pill');
  var detail=document.getElementById('cpDetail');
  if(!pills.length||!detail) return;
  var inner=detail.querySelector('.cp-detail-inner');
  var label=detail.querySelector('.cp-detail-label');
  var body=detail.querySelector('.cp-detail-body');
  var open=null, swapT=null;

  function fill(p){ label.textContent=p.textContent.trim(); body.textContent=p.getAttribute('data-d')||''; }
  function natural(){ var prev=inner.style.height; inner.style.height='auto'; var h=inner.scrollHeight; inner.style.height=prev; return h; }

  inner.addEventListener('transitionend',function(e){
    if(e.propertyName!=='height') return;
    if(open) inner.style.height='auto';   // let it reflow once settled
  });

  function expand(p){
    if(open===p){ collapse(); return; }
    if(open){ open.classList.remove('is-active'); open.setAttribute('aria-expanded','false'); }
    p.classList.add('is-active'); p.setAttribute('aria-expanded','true');

    if(open){                              // already open -> swap content + reflow height
      var lock=inner.offsetHeight; inner.style.height=lock+'px'; inner.getBoundingClientRect();
      detail.classList.add('is-swapping');
      clearTimeout(swapT);
      swapT=setTimeout(function(){
        fill(p);
        var target=natural();
        inner.style.height=lock+'px'; inner.getBoundingClientRect();
        inner.style.height=target+'px';
        detail.classList.remove('is-swapping');
      },150);
    } else {                               // closed -> open
      fill(p);
      inner.style.height='0px'; inner.getBoundingClientRect();
      inner.style.height=inner.scrollHeight+'px';
      detail.classList.add('is-open');
    }
    open=p;
  }
  function collapse(){
    if(!open) return;
    open.classList.remove('is-active'); open.setAttribute('aria-expanded','false');
    open=null; clearTimeout(swapT); detail.classList.remove('is-swapping');
    inner.style.height=inner.offsetHeight+'px'; inner.getBoundingClientRect();
    inner.style.height='0px';
    detail.classList.remove('is-open');
  }

  for(var i=0;i<pills.length;i++){(function(p){
    p.setAttribute('role','button'); p.setAttribute('tabindex','0');
    p.setAttribute('aria-expanded','false'); p.setAttribute('aria-controls','cpDetail');
    p.addEventListener('click',function(e){ e.stopPropagation(); expand(p); });
    p.addEventListener('keydown',function(e){ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); expand(p); } });
  })(pills[i]);}

  document.addEventListener('click',function(e){
    if(!open) return;
    if(e.target.closest('#cpPills')||e.target.closest('#cpDetail')) return;
    collapse();
  });
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') collapse(); });
})();
</script>

<script>
/* Clients — scrolling logo strip: real logos via a tokenless logo API, clean typeset names where a logo isn't available */
(function(){
  var track=document.getElementById('clTrack');
  if(!track) return;
  var BANKS=[
    {n:'J.P. Morgan'},
    {n:'Goldman Sachs'},
    {n:'Morgan Stanley',d:'morganstanley.com'},
    {n:'Bank of America',d:'bankofamerica.com'},
    {n:'Citi',d:'citi.com'},
    {n:'HSBC',d:'hsbc.com'},
    {n:'Barclays',d:'barclays.com'},
    {n:'Deutsche Bank',d:'db.com'},
    {n:'UBS',d:'ubs.com'},
    {n:'BNP Paribas'},
    {n:'Soci\u00e9t\u00e9 G\u00e9n\u00e9rale',d:'societegenerale.com'},
    {n:'Cr\u00e9dit Agricole'},
    {n:'Nomura'},
    {n:'Mizuho'},
    {n:'Standard Chartered',d:'sc.com'},
    {n:'Santander',d:'santander.com'}
  ];
  // ── Logo hosting ────────────────────────────────────────────────────────────
  // false (shipped default): the 10 banks with a domain pull their logo from a free
  //   logo API at runtime; the other six show their name in type. Zero setup needed.
  // true: serve every logo from this site's own /logos folder (recommended for a
  //   production, dependency-free site). Add the files first — see logos/README.txt.
  var USE_LOCAL_LOGOS = false;
  function slugify(s){ return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/(^-|-$)/g,''); }
  function logoSources(b){
    var s=[];
    if(USE_LOCAL_LOGOS){ var g=slugify(b.n); s.push('logos/'+g+'.svg','logos/'+g+'.png'); }
    if(b.d){ s.push('https://logos.hunter.io/'+b.d); }
    return s;
  }
  function makeChip(b,dup){
    var c=document.createElement('span');
    c.className='cl-chip';
    if(dup) c.setAttribute('aria-hidden','true');
    var srcs=logoSources(b), idx=0;
    if(srcs.length){
      var img=document.createElement('img');
      img.className='cl-logo'; img.alt='';
      img.addEventListener('load',function(){
        var local=img.getAttribute('src').indexOf('logos/')===0;
        if(local || img.naturalWidth>=48){
          c.classList.add('has-logo');
          c.classList.add(img.naturalWidth/img.naturalHeight>=2 ? 'cl-word' : 'cl-icon');
        } else { advance(); }
      });
      img.addEventListener('error', advance);
      function advance(){ idx++; if(idx<srcs.length){ img.src=srcs[idx]; } else { c.classList.add('is-text'); } }
      img.src=srcs[0];
      c.appendChild(img);
    } else {
      c.classList.add('is-text');
    }
    var nm=document.createElement('span');
    nm.className='cl-name'; nm.textContent=b.n;
    c.appendChild(nm);
    return c;
  }
  var i;
  for(i=0;i<BANKS.length;i++) track.appendChild(makeChip(BANKS[i],false));
  for(i=0;i<BANKS.length;i++) track.appendChild(makeChip(BANKS[i],true));

  // Continuous auto-scroll — JS-driven so it runs even when the OS "reduce motion"
  // setting is on (a pure-CSS animation gets disabled there). Pauses on hover.
  var vp=track.parentElement, x=0, speed=60, last=null, paused=false;
  vp.addEventListener('mouseenter',function(){paused=true;});
  vp.addEventListener('mouseleave',function(){paused=false;});
  function tick(ts){
    if(last===null) last=ts;
    var dt=Math.min((ts-last)/1000,0.05); last=ts;
    if(!paused){
      x-=speed*dt;
      var h=track.children[BANKS.length]?track.children[BANKS.length].offsetLeft:track.scrollWidth/2;
      if(h>0 && -x>=h) x+=h;
      track.style.transform='translateX('+x+'px)';
    }
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();
</script>
<template id="__bundler_thumbnail"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><rect width="100" height="100" fill="#0A0913"/><rect x="35" y="35" width="30" height="30" fill="#79B1B6" transform="rotate(45 50 50)"/></svg></template>
</body>
</html>
