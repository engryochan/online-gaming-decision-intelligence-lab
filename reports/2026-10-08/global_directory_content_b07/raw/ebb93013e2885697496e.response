<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<script>
/* hero word-reveal: hide targets before first paint (JS only) + safety backstop */
document.documentElement.classList.add('tr-js');
setTimeout(function(){
  var t=document.querySelectorAll('.tr-target');
  for(var i=0;i<t.length;i++){t[i].classList.add('tr-ready');t[i].classList.add('tr-in');}
},1800);
</script>
<title>Forte Securities — Independent Inter-Dealer Broker &amp; OTF Operator</title>
<meta name="description" content="Forte Securities Limited is an FCA-authorised inter-dealer broker and OTF operator for Professional Clients and Eligible Counterparties.">
<link rel="canonical" href="https://www.fortesecurities.com/">
<meta name="theme-color" content="#0A0913">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Forte Securities">
<meta property="og:title" content="Forte Securities &mdash; Independent Inter-Dealer Broker &amp; OTF Operator">
<meta property="og:description" content="Forte Securities Limited is an FCA-authorised inter-dealer broker and OTF operator for Professional Clients and Eligible Counterparties.">
<meta property="og:url" content="https://www.fortesecurities.com/">
<meta name="twitter:card" content="summary">
<link rel="icon" href="/favicon.ico?v=2" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2">
<link rel="stylesheet" href="forte-base.css">
<style>
section[id],footer[id]{scroll-margin-top:calc(var(--head-h) + 4px)}

.section-head .rule{
  flex:1;height:2px;min-width:60px;align-self:center;position:relative;overflow:hidden;
  background:linear-gradient(90deg,var(--indigo),var(--royal) 30%,var(--steel) 60%,var(--teal) 100%);
  border-radius:2px;
}

/* override the generic .rv transform/opacity for rules: draw via scaleX only */
html.js .section-head .rule.rv{
  opacity:1;transform:scaleX(0);transform-origin:left center;
  box-shadow:0 0 0 rgba(121,177,182,0);
  transition:transform .9s cubic-bezier(.22,1,.36,1),box-shadow .9s ease;
}

html.js .section-head .rule.rv.in{
  transform:scaleX(1);
  box-shadow:0 0 10px -1px rgba(121,177,182,.55),0 0 18px -4px rgba(58,102,168,.45);
}

/* a single shimmer sweep travels along the line just after it draws */
.section-head .rule.in::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,.8),transparent);
  width:40%;transform:translateX(-120%);
  animation:rule-shimmer 1.5s ease-out .6s 1 both;
}

@keyframes rule-shimmer{to{transform:translateX(320%)}}

@media (prefers-reduced-motion:reduce){
  html.js .section-head .rule.rv{transform:scaleX(1);transition:none}
  .section-head .rule.in::after{animation:none;display:none}
}

/* ---------- header ---------- */
header.site{
  position:sticky;top:0;z-index:50;
  background:transparent;
  transition:background-color .3s ease,box-shadow .3s ease,backdrop-filter .3s ease;
}

/* once scrolled clear of the hero, the bar returns: white, blurred, hairline rule */
header.site.solid{
  background:rgba(255,255,255,.94);
  backdrop-filter:blur(10px);
  box-shadow:inset 0 -1px 0 var(--line);
}

/* keep the toggle (now an X) above the overlay and clickable */
body.nav-open header.site{z-index:210;background:transparent;box-shadow:none;backdrop-filter:none}

/* logo: white lockup over the hero image, colour lockup once the bar turns solid */
.logo-link{position:relative;display:flex;align-items:center;flex:none}

.logo-link img{height:58px;width:auto;display:block;transition:opacity .35s ease}

.logo-link .logo-c{position:absolute;left:0;top:50%;transform:translateY(-50%);opacity:0}

header.site.solid .logo-link .logo-w{opacity:0}

header.site.solid .logo-link .logo-c{opacity:1}

.menu-toggle{margin-left:auto}

/* ---------- hero ---------- */
.hero{
  background:#0A0913;
  color:#fff;border-top:none;
  padding:calc(96px + var(--head-h)) 0 104px;
  margin-top:calc(var(--head-h) * -1);
  position:relative;overflow:hidden;
}

.hero h1 em{font-style:normal;color:inherit}

/* ---------- hero word reveal — ported from beui.dev TextReveal ---------- */
html.tr-js .tr-target{opacity:0}
html.tr-js .tr-target.tr-ready{opacity:1}
.tr-word{display:inline-block}
.tr-word-i{
  display:inline-block;will-change:transform,opacity,filter;
  opacity:0;transform:translateY(42%);filter:blur(12px);
  transition:opacity .72s cubic-bezier(.22,1,.36,1),
             transform .82s cubic-bezier(.22,1,.36,1),
             filter .9s cubic-bezier(.22,1,.36,1);
}
.hero .lede .tr-word-i{filter:none;transition:opacity .72s cubic-bezier(.22,1,.36,1),
             transform .82s cubic-bezier(.22,1,.36,1)}
.tr-in .tr-word-i{opacity:1;transform:none;filter:blur(0)}
@media (prefers-reduced-motion:reduce){
  html.tr-js .tr-target{opacity:1}
  .tr-word-i{opacity:1;transform:none;filter:none;transition:none}
}

/* hero brand mark */
.hero-visual{position:relative;min-height:380px;display:flex;align-items:center;justify-content:center}

.hero-mark{position:relative;z-index:2;width:min(450px,88%);height:auto;filter:drop-shadow(0 18px 50px rgba(0,0,0,.40))}

@media (max-width:1020px){
  .hero-grid{grid-template-columns:1fr}
  .hero-visual{min-height:0;margin-top:42px;align-items:center;justify-content:center}
  .hero-visual .hg-stage{max-width:300px}
}

td.desk{white-space:nowrap;width:1%}

td.cov{color:var(--text-soft)}

.model .mlinks{margin-top:14px;font-size:13px;font-weight:600}

.office{background:var(--paper);padding:24px 24px 22px}

.office.hq{grid-row:span 2;background:var(--indigo);color:#fff}

.office .oc{font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--steel);margin-bottom:8px}

.office h3{font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;font-weight:700;font-size:17px;color:var(--indigo);margin-bottom:6px}

.office p{font-size:13px;color:var(--text-soft);line-height:1.55}

.office.hq p{color:#C9CCDF}

/* ---------- fraud notice ---------- */
.fraud{padding:0;background:var(--paper)}

.fraud .inner{margin:64px 0;border-top:1px solid var(--line);padding-top:24px}

.fraud h3{font-size:12px;font-weight:700;letter-spacing:.14em;color:var(--royal);margin:0 0 12px;text-transform:uppercase}

.fraud p{font-size:14px;line-height:1.68;color:var(--text-soft);max-width:86ch;margin:0}

/* ---------- group services 4-up ---------- */
.grp4{grid-template-columns:repeat(4,1fr)}

@media (max-width:980px){.grp4{grid-template-columns:1fr 1fr}}

@media (max-width:560px){.grp4{grid-template-columns:1fr}}

/* ---------- pointer-tracked border highlight ---------- */
.stat,.cp,.model{position:relative;isolation:isolate}

/* the glowing border lives on a ::before that is masked to a 1.5px ring;
   a radial-gradient centred on the cursor (--mx,--my) lights only the
   nearest edge. opacity fades the whole thing in/out on hover. */
.stat::before,.cp::before,.model::before{
  content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;
  background:radial-gradient(180px circle at var(--mx,50%) var(--my,50%),
    rgba(121,177,182,.95),rgba(58,102,168,.75) 35%,rgba(43,42,110,0) 70%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:0;transition:opacity .35s ease;pointer-events:none;z-index:3;
}

.stat:hover::before,.cp:hover::before,.model:hover::before{opacity:1}

@media (prefers-reduced-motion:reduce){
  .stat::before,.cp::before,.model::before{transition:none}
}

/* ---------- menu button (boxed, wordless) + full-screen overlay ---------- */
/* default = over the hero image: white outline + white bars for contrast */
.menu-toggle{
  margin-left:auto;position:relative;isolation:isolate;
  width:50px;height:50px;display:inline-flex;align-items:center;justify-content:center;
  cursor:pointer;background:none;color:#fff;
  border:1px solid rgba(255,255,255,.45);border-radius:12px;-webkit-tap-highlight-color:transparent;
  transition:background-color .25s ease,border-color .3s ease;
}

.menu-toggle:hover{background:rgba(255,255,255,.10)}

/* brand-gradient ring fades in on hover — the same masked-ring language as the site's cards */
.menu-toggle::before{
  content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;
  background:linear-gradient(135deg,var(--royal),var(--steel) 48%,var(--teal-bright));
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:0;transition:opacity .3s ease;pointer-events:none;
}

.menu-toggle:focus-visible{outline:2px solid var(--teal-bright);outline-offset:3px}

.menu-toggle .mt-bars i{
  position:absolute;left:0;height:2px;border-radius:2px;background:#fff;
  transform:skewX(-16deg);transform-origin:left center;
  transition:width .4s cubic-bezier(.4,0,.2,1),transform .4s cubic-bezier(.4,0,.2,1),background-color .25s ease;
}

/* hover: bars square up and brighten */
.menu-toggle:hover .mt-bars i{background:var(--teal-bright);transform:skewX(0)}

/* solid bar (scrolled clear of hero): ink outline + ink bars on white */
header.site.solid .menu-toggle{border-color:var(--line-strong);color:var(--ink)}

header.site.solid .menu-toggle:hover{background:var(--paper-2)}

header.site.solid .menu-toggle:focus-visible{outline-color:var(--royal)}

header.site.solid .menu-toggle .mt-bars i{background:var(--ink)}

header.site.solid .menu-toggle:hover .mt-bars i{background:var(--royal)}

/* open state: box reframes for the dark overlay, bars fade to the white X (beats .solid) */
body.nav-open header.site .menu-toggle{border-color:rgba(255,255,255,.28);background:transparent}
</style>
<style>
.hero-visual .hero-globe{margin:0;width:100%;display:flex;flex-direction:column;align-items:center;gap:24px}
.hero-visual .hg-stage{position:relative;width:100%;max-width:430px;aspect-ratio:1/1}
.hero-visual .hg-canvas{width:100%;height:100%;display:block;cursor:grab;touch-action:none}
.hero-visual .hg-labels{position:absolute;inset:0;pointer-events:none;overflow:visible}
.hero-visual .hg-label{position:absolute;left:0;top:0;white-space:nowrap;font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:rgba(233,240,247,.96);text-shadow:0 1px 7px rgba(0,0,0,.9),0 0 2px rgba(0,0,0,.75);opacity:0;will-change:transform,opacity}
.hero-visual .hg-hint{font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;font-size:10px;font-weight:600;letter-spacing:.18em;text-transform:uppercase;color:rgba(143,198,201,.6);text-align:center;transition:opacity .6s ease}
.hero-visual .hg-hint.is-hidden{opacity:0}
@media (max-width:1020px){.hero-visual .hg-hint{display:none}.hg-time{display:none!important}}

/* DARK MODE — index keeps a transparent header over the dark hero; only .solid goes dark glass */
[data-theme="dark"] header.site:not(.solid){background:transparent;backdrop-filter:none;box-shadow:none}
[data-theme="dark"] header.site:not(.solid) .logo-link .logo-w{filter:none}


/* index light mode: toggle sits on a transparent header over the dark hero -> white glyph */
header.site:not(.solid) .theme-toggle{border-color:rgba(255,255,255,.22);color:#fff}
header.site:not(.solid) .theme-toggle:hover{background:rgba(255,255,255,.10);border-color:rgba(255,255,255,.4)}

/* === FORTE-DARK-THEME START === */

[data-theme="dark"] body{
  background:
    radial-gradient(1200px 600px at 78% -8%, rgba(143,178,242,.10), transparent 60%),
    radial-gradient(900px 500px at 0% 8%, rgba(143,211,216,.06), transparent 55%),
    var(--paper);
  background-attachment:fixed;
  color:var(--text);
}

/* tables: one step up from base, indigo-gradient header, hairline rows */
[data-theme="dark"] table.register{background:var(--surf-1);border:1px solid var(--line)}
[data-theme="dark"] table.register thead,
[data-theme="dark"] table.register tr:first-child th{background:linear-gradient(180deg,#23305A,#1B2647)}
[data-theme="dark"] table.register tr:hover td{background:rgba(160,176,225,.06)}
[data-theme="dark"] table.register td{border-color:var(--line)}

/* cards get elevation + hairline that brightens on hover */
[data-theme="dark"] .model,
[data-theme="dark"] .cp,
[data-theme="dark"] .office,
[data-theme="dark"] .adj-item,
[data-theme="dark"] .doc{
  background:var(--paper-2);
  border:1px solid var(--line);
  box-shadow:0 1px 0 rgba(255,255,255,.03) inset, 0 10px 30px -18px rgba(0,0,0,.8);
}
[data-theme="dark"] .model{border-top:3px solid var(--indigo)}
[data-theme="dark"] .model:hover,
[data-theme="dark"] .cp:hover,
[data-theme="dark"] .office:hover,
[data-theme="dark"] .doc:hover{border-color:var(--line-strong)}
[data-theme="dark"] .adjacent{background:transparent}
[data-theme="dark"] .adj-item{color:var(--indigo)}

/* stat strip + accent dividers */
[data-theme="dark"] .stats{background:transparent}
[data-theme="dark"] .eyebrow .rule,
[data-theme="dark"] .section-rule{background:linear-gradient(90deg,var(--teal-bright),transparent)}
[data-theme="dark"] .facet{filter:saturate(1.15) brightness(1.1)}

/* notice/fraud panel */
[data-theme="dark"] .fraud h3{color:var(--teal-bright)}

/* office card text + the white text-shadow that broke on dark */
[data-theme="dark"] .office h3{color:var(--indigo)}
[data-theme="dark"] .office p{text-shadow:none;color:var(--text-soft)}

/* buttons keep dark text on bright fills */

/* selection + footer */
[data-theme="dark"] ::selection{background:rgba(182,234,238,.30);color:#fff}
[data-theme="dark"] footer{background:var(--ink);color:#D6DAE6}
[data-theme="dark"] .foot-ids{color:#C2C8DA}
[data-theme="dark"] .foot-base{color:#AEB6CC}
[data-theme="dark"] .foot-base a,[data-theme="dark"] .foot-base .li{color:#D6DAE6}
[data-theme="dark"] .foot-base .li:hover{color:#fff}
[data-theme="dark"] .foot-ids .pending{color:var(--teal-bright)}
[data-theme="dark"] footer .foot-logo,[data-theme="dark"] footer img{filter:brightness(0) invert(1)}

/* INDEX header: transparent over hero, dark glass once .solid */
[data-theme="dark"] header.site.solid{
  background:rgba(11,16,32,.82);
  backdrop-filter:blur(14px) saturate(1.2);
  box-shadow:inset 0 -1px 0 var(--line);
}
[data-theme="dark"] header.site.solid .logo-link .logo-c{filter:brightness(0) invert(1)}
[data-theme="dark"] header.site.solid .menu-toggle{border-color:var(--line-strong);color:var(--text)}
[data-theme="dark"] header.site.solid .menu-toggle:hover{background:rgba(160,176,225,.10)}
[data-theme="dark"] header.site.solid .menu-toggle .mt-bars i{background:var(--text)}
[data-theme="dark"] header.site.solid .theme-toggle{border-color:var(--line-strong);color:var(--text)}
[data-theme="dark"] header.site.solid .theme-toggle:hover{background:rgba(160,176,225,.10)}
[data-theme="dark"] header.site:not(.solid){background:transparent;backdrop-filter:none;box-shadow:none}
[data-theme="dark"] header.site:not(.solid) .logo-link .logo-w{filter:none}
[data-theme="dark"] header.site:not(.solid) .theme-toggle{border-color:rgba(255,255,255,.22);color:#fff}
/* === FORTE-DARK-THEME END === */

/* === FORTE-HERO-FEATHER START === */
/* Feather-blur scrim: softly defocuses hero content as it scrolls under the
   sticky header, so the logo/headline never appear to collide. Fades to clear
   at its lower edge; disabled once past the hero (before MARKETS). Theme-agnostic. */
.hero-feather{
  position:fixed; left:0; right:0; top:0; z-index:40;   /* under header (z-50), over hero */
  height:calc(var(--head-h) + 70px);
  pointer-events:none;
  opacity:0; transition:opacity .25s ease;
  -webkit-backdrop-filter:blur(0px); backdrop-filter:blur(0px);
  /* fade the blur strength out toward the bottom edge for a feathered finish */
  -webkit-mask-image:linear-gradient(to bottom, #000 0, #000 calc(var(--head-h) - 6px), rgba(0,0,0,.55) calc(var(--head-h) + 18px), transparent 100%);
          mask-image:linear-gradient(to bottom, #000 0, #000 calc(var(--head-h) - 6px), rgba(0,0,0,.55) calc(var(--head-h) + 18px), transparent 100%);
}
.hero-feather.on{ opacity:1; -webkit-backdrop-filter:blur(9px); backdrop-filter:blur(9px); }
@media (prefers-reduced-motion: reduce){ .hero-feather{transition:none} }
/* === FORTE-HERO-FEATHER END === */

/* === OPT-B === */
.ov-appearance{
  display:flex;align-items:center;justify-content:space-between;gap:18px;
  width:100%;padding-bottom:22px;margin-bottom:22px;
  border-bottom:1px solid rgba(255,255,255,.14);
}
.ov-appearance-label{
  font-family:var(--mono,ui-monospace,monospace);
  font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;
  color:rgba(255,255,255,.62);
}
.seg{display:inline-flex;border:1px solid rgba(255,255,255,.22);border-radius:999px;padding:3px;gap:2px;background:rgba(255,255,255,.04)}
.seg-btn{
  display:inline-flex;align-items:center;gap:7px;
  padding:7px 14px;border:0;border-radius:999px;cursor:pointer;
  background:transparent;color:rgba(255,255,255,.66);
  font:inherit;font-size:.86rem;line-height:1;letter-spacing:.01em;
  transition:background .2s ease,color .2s ease;
}
.seg-btn svg{opacity:.85}
.seg-btn:hover{color:#fff}
.seg-btn[aria-pressed="true"]{background:#fff;color:#0B1020}
.seg-btn[aria-pressed="true"] svg{opacity:1}
.seg-btn:focus-visible{outline:2px solid var(--teal-bright,#B6EAEE);outline-offset:2px}
@media (prefers-reduced-motion: reduce){ .seg-btn{transition:none} }
@media (max-width:520px){ .ov-appearance{flex-direction:column;align-items:flex-start;gap:12px} }
/* === /OPT-B === */
/* === FORTE-DARK-BTN START === */
/* Dark mode: buttons reuse the fixed brand hex from forte-base.css (purple #2B2A6E,
   teal #79B1B6, white, transparent) in every state. Only the outline button's
   REST text/border switch to white so it is legible on the dark background. */
[data-theme="dark"] .btn:not(.solid):not(.on-dark){color:#fff;border-color:rgba(255,255,255,.42)}
[data-theme="dark"] .btn:not(.solid):not(.on-dark):hover{color:#fff}
[data-theme="dark"] .btn:focus-visible{outline:2px solid #79B1B6;outline-offset:3px}
/* === FORTE-DARK-BTN END === */
/* === FORTE-SEAMLESS-DARK START === */
/* Header: only the scrolled (.solid) state matches the page body — flat colour, no band, no hairline, no blur. Over the hero the header stays transparent (see :not(.solid) rule above). */
[data-theme="dark"] header.site.solid{
  background:#0B1020 !important;
  -webkit-backdrop-filter:none !important; backdrop-filter:none !important;
  box-shadow:none !important;
  border-bottom:0 !important; border-bottom-color:transparent !important;
}
/* Page-head hero band: same flat colour, no gradient, no seam into the body. */
[data-theme="dark"] .page-head{
  background:#0B1020 !important;
  border-bottom:0 !important;
}
/* Menu overlay: one uniform tone — drop the two-tone gradient + glows in dark mode. */
[data-theme="dark"] .nav-overlay{
  background:#0B1020 !important;
}
/* Keep the header seamless while the menu is open too. */
[data-theme="dark"] body.nav-open header.site{
  background:#0B1020 !important; box-shadow:none !important;
}
/* === FORTE-SEAMLESS-DARK END === */

/* === FORTE-HERO-ALIGN START === */
/* Make both hero columns full-height and bottom-align their content so the
   left CTA row and the globe's "View our seven offices" button share a baseline. */
@media (min-width:1021px){
  .hero-grid{align-items:stretch}
  /* left text column: column flex, content top, CTAs pushed to bottom */
  .hero-grid > div:first-child{display:flex;flex-direction:column}
  .hero-grid > div:first-child .hero-ctas{margin-top:auto}
  /* right visual column: globe centered (fills space), button pinned to bottom */
  .hero-visual{align-items:stretch;justify-content:flex-start}
  .hero-visual .hero-globe{flex:1;justify-content:center;gap:0}
  .hero-visual .hero-globe .hg-stage{margin-bottom:auto}
  .hero-visual .hero-globe > .btn{margin-top:24px}
}
/* === FORTE-HERO-ALIGN END === */

</style>
<style id="forte-index-refine">
/* ===== INDEX REFINE — clients as pills, group services as spaced rounded cards ===== */

/* Clients (#coverage): flowing counterparty pills */
.cp-pills{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:12px;max-width:920px}
.cp-pills .pill{
  display:inline-flex;align-items:center;
  padding:13px 24px;
  font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;
  font-size:14.5px;font-weight:600;letter-spacing:-.004em;line-height:1;
  color:var(--indigo);
  background:var(--paper);
  border:1px solid var(--line-strong);
  border-radius:999px;
  cursor:default;
  transition:transform .28s cubic-bezier(.22,1,.36,1),border-color .28s ease,box-shadow .28s ease;
}
.cp-pills .pill:hover{
  transform:translateY(-2px);
  border-color:var(--indigo);
  box-shadow:0 12px 26px -16px rgba(43,42,110,.55);
}
[data-theme="dark"] .cp-pills .pill{background:var(--paper-2);border-color:var(--line-strong);color:#EAF2FF}
[data-theme="dark"] .cp-pills .pill:hover{border-color:var(--teal-bright);box-shadow:0 14px 30px -16px rgba(0,0,0,.85)}

/* Group services (#adjacent): four spaced rounded cards */
.adjacent .svc-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:2px}
.svc{
  position:relative;isolation:isolate;
  display:flex;flex-direction:column;gap:12px;
  padding:28px 26px 26px;
  background:var(--paper);
  border:1px solid var(--line);
  border-radius:16px;
  box-shadow:0 1px 2px rgba(43,42,110,.04);
  transition:transform .3s cubic-bezier(.22,1,.36,1),border-color .3s ease,box-shadow .3s ease;
}
.svc::before{
  content:"";position:absolute;inset:0;border-radius:inherit;padding:1.5px;
  background:radial-gradient(180px circle at var(--mx,50%) var(--my,50%),
    rgba(121,177,182,.95),rgba(58,102,168,.75) 35%,rgba(43,42,110,0) 70%);
  -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
  -webkit-mask-composite:xor;mask-composite:exclude;
  opacity:0;transition:opacity .35s ease;pointer-events:none;z-index:3;
}
.svc .facet{width:15px;height:15px;transform:rotate(45deg)}
.svc h3{font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;font-size:17px;font-weight:600;color:var(--text);letter-spacing:-.01em;line-height:1.2}
.svc p{font-size:13.5px;line-height:1.62;color:var(--text-soft);margin:0}
.svc:hover{transform:translateY(-3px);border-color:var(--line-strong);box-shadow:0 18px 40px -24px rgba(43,42,110,.5)}
.svc:hover::before{opacity:1}
[data-theme="dark"] .svc{background:var(--paper-2);border-color:var(--line);box-shadow:0 1px 0 rgba(255,255,255,.03) inset,0 12px 34px -20px rgba(0,0,0,.85)}
[data-theme="dark"] .svc:hover{border-color:var(--line-strong);box-shadow:0 1px 0 rgba(255,255,255,.04) inset,0 20px 46px -24px rgba(0,0,0,.9)}

/* small polish: tabular figures for data */
.stat .n,table.register td,table.register th{font-variant-numeric:tabular-nums}

@media (max-width:900px){.adjacent .svc-grid{grid-template-columns:1fr 1fr;gap:16px}}
@media (max-width:560px){
  .adjacent .svc-grid{grid-template-columns:1fr;gap:14px}
  .cp-pills .pill{padding:11px 18px;font-size:13.5px}
}
@media (prefers-reduced-motion:reduce){
  .cp-pills .pill,.svc,.svc::before{transition:none}
  .cp-pills .pill:hover,.svc:hover{transform:none}
}

/* Firm at a glance: balance spacing + four spaced rounded stat boxes */
.stats{padding:56px 0 44px}        /* push the row down off the hero edge */
#markets{padding-top:52px}         /* close the large gap below the row */
.stats .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;border:none}
.stats .wrap .stat{
  border:1px solid var(--line);
  border-radius:16px;
  background:var(--paper-2);
  padding:30px 22px 28px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;
  text-align:center;
  transition:transform .3s cubic-bezier(.22,1,.36,1),border-color .3s ease;
}
.stats .wrap .stat .n{margin:0;font-size:clamp(30px,3vw,38px)}
.stats .wrap .stat .l{margin:0}
.stats .wrap .stat .n::after{
  content:"";display:block;width:26px;height:3px;margin:12px auto 0;border-radius:3px;
  background:linear-gradient(90deg,var(--indigo),var(--royal) 45%,var(--teal));
}
.stats .wrap .stat:hover{transform:translateY(-2px);border-color:var(--line-strong)}
[data-theme="dark"] .stats .wrap .stat{
  background:var(--paper-2);border-color:var(--line);
  box-shadow:0 1px 0 rgba(255,255,255,.03) inset,0 12px 34px -22px rgba(0,0,0,.85);
}
[data-theme="dark"] .stats .wrap .stat:hover{border-color:var(--line-strong)}
@media (max-width:860px){
  .stats .wrap{grid-template-columns:repeat(2,1fr);gap:14px}
  .stats .wrap .stat{border:1px solid var(--line)}
}
@media (max-width:480px){.stats .wrap{grid-template-columns:1fr}}
@media (prefers-reduced-motion:reduce){
  .stats .wrap .stat{transition:none}
  .stats .wrap .stat:hover{transform:none}
}
/* button arrow (signals navigation to another page) */
.btn:has(.btn-arrow){display:inline-flex;align-items:center}
.btn .btn-arrow{margin-left:9px;flex:none;vertical-align:middle;transition:transform .3s cubic-bezier(.22,1,.36,1)}
.btn:hover .btn-arrow{transform:translateX(4px)}
@media (prefers-reduced-motion:reduce){.btn .btn-arrow{transition:none}.btn:hover .btn-arrow{transform:none}}
</style>
<style id="forte-tierd-chip">.hg-stage{position:relative;overflow:visible}.hg-time{position:absolute;left:0;top:0;pointer-events:none;white-space:nowrap;display:flex;align-items:center;gap:9px;padding:7px 13px;border:1px solid rgba(143,211,216,.42);border-radius:999px;background:rgba(11,16,32,.82);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);box-shadow:0 8px 26px rgba(0,0,0,.5);opacity:0;transition:opacity .2s ease;z-index:6}.hg-time .c{font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;font-size:10.5px;font-weight:600;letter-spacing:.13em;text-transform:uppercase;color:#fff}.hg-time .hq{display:none;font-size:8.5px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--ink);background:var(--teal-bright);border-radius:4px;padding:2px 6px}.hg-time .t{font-size:13px;font-weight:600;color:var(--teal-bright);font-variant-numeric:tabular-nums}.hg-label.is-active{color:#fff;text-shadow:0 1px 8px rgba(0,0,0,.95),0 0 12px rgba(143,211,216,.55)}</style>

<style id="forte-cta-purple">
/* Re-enable the fill slide for hero buttons (outline buttons fill from the bottom too) */
.hero-ctas .btn::before{transition:transform .4s cubic-bezier(.4,0,.2,1)}
/* "View our seven offices" secondary CTA: fill teal on hover (not purple) */
.hero-ctas .btn.on-dark::before{background:#79B1B6}
.hero-ctas .btn.on-dark:hover{color:#1E1433;border-color:#79B1B6}
/* Hero primary CTA: Forte purple at rest; teal fills the pill bottom-up on hover.
   Hard-coded hex so it is identical in dark mode (the dark theme remaps the palette vars). */
.hero-ctas .btn.solid,[data-theme="dark"] .hero-ctas .btn.solid{
  background:linear-gradient(to top, #79B1B6 50%, #2B2A6E 50%);
  background-size:100% 200%;
  background-position:0 0;
  border-color:#2B2A6E;
  color:#fff;
  transition:background-position .4s cubic-bezier(.4,0,.2,1), color .3s ease, border-color .3s ease;
}
.hero-ctas .btn.solid::before,[data-theme="dark"] .hero-ctas .btn.solid::before{display:none}
.hero-ctas .btn.solid:hover,[data-theme="dark"] .hero-ctas .btn.solid:hover{
  background-position:0 100%;
  border-color:#79B1B6;
  color:#1E1433;
}
@media (prefers-reduced-motion: reduce){
  .hero-ctas .btn.solid,[data-theme="dark"] .hero-ctas .btn.solid{transition:color .2s ease,border-color .2s ease}
  .hero-ctas .btn::before{transition:none}
}
</style>
<style id="forte-menu-variant">
.menu-toggle{border-radius:50%}
.menu-toggle::before{border-radius:50%}
.menu-toggle .mt-bars i{top:8.5px;left:50%;transform:translateX(-50%);width:3.4px;height:3.4px;border-radius:50%;background:#fff}
.menu-toggle .mt-bars i:nth-child(1){top:2.5px;width:3.4px;background:#fff;box-shadow:-6px 0 0 0 var(--teal-bright),6px 0 0 0 #fff}
.menu-toggle .mt-bars i:nth-child(2){top:8.5px;width:3.4px;background:var(--teal-bright);box-shadow:-6px 0 0 0 #fff,6px 0 0 0 #fff}
.menu-toggle .mt-bars i:nth-child(3){top:14.5px;width:3.4px;background:#fff;box-shadow:-6px 0 0 0 #fff,6px 0 0 0 var(--teal-bright)}
.menu-toggle:hover .mt-bars i{transform:translateX(-50%);width:3.4px;background:var(--teal-bright);box-shadow:-6px 0 0 0 var(--teal-bright),6px 0 0 0 var(--teal-bright)}
.menu-toggle:hover .mt-bars i:nth-child(2){width:3.4px;box-shadow:-6px 0 0 0 var(--teal-bright),6px 0 0 0 var(--teal-bright)}
.menu-toggle:hover .mt-bars i:nth-child(3){width:3.4px;box-shadow:-6px 0 0 0 var(--teal-bright),6px 0 0 0 var(--teal-bright)}
header.site.solid .menu-toggle .mt-bars i:nth-child(1){background:var(--ink);box-shadow:-6px 0 0 0 var(--teal),6px 0 0 0 var(--ink)}
header.site.solid .menu-toggle .mt-bars i:nth-child(2){background:var(--teal);box-shadow:-6px 0 0 0 var(--ink),6px 0 0 0 var(--ink)}
header.site.solid .menu-toggle .mt-bars i:nth-child(3){background:var(--ink);box-shadow:-6px 0 0 0 var(--ink),6px 0 0 0 var(--teal)}
[data-theme="dark"] header.site.solid .menu-toggle .mt-bars i:nth-child(1){background:var(--text);box-shadow:-6px 0 0 0 var(--teal-bright),6px 0 0 0 var(--text)}
[data-theme="dark"] header.site.solid .menu-toggle .mt-bars i:nth-child(2){background:var(--teal-bright);box-shadow:-6px 0 0 0 var(--text),6px 0 0 0 var(--text)}
[data-theme="dark"] header.site.solid .menu-toggle .mt-bars i:nth-child(3){background:var(--text);box-shadow:-6px 0 0 0 var(--text),6px 0 0 0 var(--teal-bright)}
</style>
<style id="forte-stats-variant">
.stats{background:var(--paper);padding:56px 0 48px}
.stats .wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:0;border:none}
.stats .wrap .stat{position:relative;border:none;border-radius:0;background:none;padding:30px 26px;display:block;text-align:center;transform:none}
.stats .wrap .stat:hover{transform:none;box-shadow:none;border-color:transparent}
.stat::before{content:none}
.stats .wrap .stat .n{color:var(--indigo);font-weight:600;font-size:clamp(30px,3vw,38px);margin:0;line-height:1}
.stats .wrap .stat .n::after{content:none}
.stats .wrap .stat .l{color:var(--text-soft);font-size:11px;letter-spacing:.13em;text-transform:uppercase;margin-top:9px;line-height:1.4}
.stats .wrap .stat::after{content:"";position:absolute;top:50%;right:0;transform:translateY(-50%);width:2px;height:30px;border-radius:2px;background:linear-gradient(180deg,var(--indigo),var(--royal) 45%,var(--teal))}
.stats .wrap .stat:last-child::after{display:none}
[data-theme="dark"] .stats .wrap .stat{background:none;border:none;box-shadow:none}
[data-theme="dark"] .stats .wrap .stat:hover{background:none;box-shadow:none;border-color:transparent;transform:none}
[data-theme="dark"] .stats .wrap .stat::after{background:linear-gradient(180deg,var(--teal-bright),var(--teal))}
@media (max-width:860px){
.stats .wrap{grid-template-columns:repeat(2,1fr);gap:0}
.stats .wrap .stat{padding:26px 22px}
.stats .wrap .stat:nth-child(2)::after,.stats .wrap .stat:nth-child(4)::after{display:none}
.stats .wrap .stat:nth-child(1),.stats .wrap .stat:nth-child(2){border-bottom:1px solid var(--line)}
}
@media (max-width:480px){
.stats .wrap{grid-template-columns:1fr}
.stats .wrap .stat::after{display:none}
.stats .wrap .stat{border-bottom:1px solid var(--line);padding:22px 16px}
.stats .wrap .stat:last-child{border-bottom:none}
}
</style>
<style id="forte-stats-cta">
.stats .wrap{display:flex;align-items:center;gap:clamp(28px,4vw,60px)}
.stats .stats-cta{flex:none}
.stats .stats-grid{flex:1;display:grid;grid-template-columns:repeat(4,1fr)}
@media (max-width:860px){
  .stats .wrap{flex-direction:column;align-items:stretch;gap:30px}
  .stats .stats-cta{display:flex;justify-content:center}
  .stats .stats-grid{grid-template-columns:repeat(2,1fr)}
}
@media (max-width:480px){
  .stats .stats-grid{grid-template-columns:1fr}
}
</style>
<style id="forte-svc-variant">
.adjacent{background:var(--paper-2)}
.adjacent .svc-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px 40px;margin-top:6px}
.adjacent .svc{position:relative;display:flex;flex-direction:column;gap:9px;padding:2px 0 2px 20px;background:none;border:none;box-shadow:none;transform:none}
.adjacent .svc .facet{display:none}
.adjacent .svc h3{margin:0}
.adjacent .svc p{margin:0}
.adjacent .svc::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;padding:0;border-radius:3px;background:linear-gradient(180deg,var(--indigo),var(--royal) 45%,var(--teal));opacity:1;-webkit-mask:none;mask:none;transition:none}
.adjacent .svc:hover{transform:none;box-shadow:none;border-color:transparent}
.adjacent .svc:hover::before{opacity:1}
[data-theme="dark"] .adjacent{background:transparent}
[data-theme="dark"] .adjacent .svc{background:none;border:none;box-shadow:none}
[data-theme="dark"] .adjacent .svc:hover{background:none;box-shadow:none;border-color:transparent;transform:none}
[data-theme="dark"] .adjacent .svc::before{background:linear-gradient(180deg,var(--teal-bright),var(--teal))}
@media (max-width:600px){.adjacent .svc-grid{grid-template-columns:1fr;gap:22px}}
</style>
<style id="forte-markets-variant">
.table-scroll{border:none;overflow-x:auto}
table.register{min-width:0;background:none}
table.register thead,table.register thead tr,table.register tr:first-child th{background:none}
table.register th{background:none;color:var(--text-soft);font-weight:600;text-align:left;padding:0 20px 11px 0;border:none;border-bottom:2px solid var(--indigo)}
table.register th:first-child{padding-left:0}
table.register th:last-child{padding-right:0}
table.register td{border-top:none;border-bottom:1px solid var(--line);padding:17px 20px 17px 0;vertical-align:top}
table.register td:first-child{padding-left:0}
table.register td:last-child{padding-right:0}
table.register tbody tr:last-child td{border-bottom:none}
table.register tr:hover td{background:none}
td.desk{width:38%}
td.desk .dname{color:var(--indigo);font-weight:600;font-size:16px;gap:0}
td.desk .dname .facet{display:none}
td.cov{color:var(--text-soft);font-size:13.5px;line-height:1.62}
[data-theme="dark"] .table-scroll{border:none}
[data-theme="dark"] table.register{background:none;border:none}
[data-theme="dark"] table.register thead,[data-theme="dark"] table.register tr:first-child th{background:none}
[data-theme="dark"] table.register td{border-color:var(--line)}
[data-theme="dark"] table.register tr:hover td{background:none}
@media (max-width:600px){
table.register td,table.register th{padding-right:14px}
td.desk{white-space:normal;width:38%}
}
</style>
<style id="forte-clients-expand">
/* ===== Clients pills — click to expand description ===== */
.cp-pills .pill{cursor:pointer;-webkit-tap-highlight-color:transparent;user-select:none}
.cp-pills .pill:focus-visible{outline:2px solid var(--royal);outline-offset:3px}
/* affordance chevron — rotates when the pill is open */
.cp-pills .pill::after{
  content:"";flex:none;width:12px;height:12px;margin-left:9px;
  background:currentColor;opacity:.5;
  -webkit-mask:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M6%209l6%206%206-6'%20fill='none'%20stroke='%23000'%20stroke-width='2.6'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3C/svg%3E") center/contain no-repeat;
  mask:url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2024%2024'%3E%3Cpath%20d='M6%209l6%206%206-6'%20fill='none'%20stroke='%23000'%20stroke-width='2.6'%20stroke-linecap='round'%20stroke-linejoin='round'/%3E%3C/svg%3E") center/contain no-repeat;
  transition:transform .32s cubic-bezier(.22,1,.36,1),opacity .25s ease;
}
.cp-pills .pill:hover::after{opacity:.8}
.cp-pills .pill.is-active{
  color:#fff;background:var(--indigo);border-color:var(--indigo);
  box-shadow:0 12px 26px -16px rgba(43,42,110,.55);
}
.cp-pills .pill.is-active::after{transform:rotate(180deg);opacity:1}
.cp-pills .pill.is-active:hover{transform:translateY(-2px);border-color:var(--indigo)}
[data-theme="dark"] .cp-pills .pill.is-active{
  color:var(--ink);background:var(--teal-bright);border-color:var(--teal-bright);
  box-shadow:0 16px 34px -18px rgba(0,0,0,.9);
}
[data-theme="dark"] .cp-pills .pill.is-active:hover{border-color:var(--teal-bright)}

/* expanding detail — E: two-column (label left) */
.cp-detail{max-width:680px}
.cp-detail-inner{height:0;overflow:hidden;transition:height .42s cubic-bezier(.22,.61,.36,1)}
.cp-detail-panel{
  position:relative;margin-top:22px;padding-top:18px;
  background:transparent;border:0;border-top:1px solid var(--line);border-radius:0;
  display:grid;grid-template-columns:128px 1fr;gap:30px;align-items:start;
  opacity:0;transform:translateY(8px);
  transition:opacity .42s ease .05s,transform .46s cubic-bezier(.22,.61,.36,1) .05s;
}
.cp-detail.is-open .cp-detail-panel{opacity:1;transform:none}
.cp-detail-label{
  font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;
  font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;
  color:var(--royal);padding-top:4px;line-height:1.45;transition:opacity .16s ease;
}
.cp-detail-body{
  font-size:16px;line-height:1.72;color:var(--text);
  font-weight:400;letter-spacing:-.002em;transition:opacity .16s ease;
}
.cp-detail.is-swapping .cp-detail-label,
.cp-detail.is-swapping .cp-detail-body{opacity:0}
[data-theme="dark"] .cp-detail-label{color:var(--teal-bright)}
[data-theme="dark"] .cp-detail-body{color:#EAF2FF}
@media (max-width:560px){
  .cp-detail-panel{grid-template-columns:1fr;gap:7px}
  .cp-detail-body{font-size:15px}
}
@media (prefers-reduced-motion:reduce){
  .cp-pills .pill::after,.cp-detail-inner,.cp-detail-panel,.cp-detail-label,.cp-detail-body{transition:none}
}
</style>
