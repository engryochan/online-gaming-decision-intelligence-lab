<style id="forte-hero-shader-css">
.hero{position:relative;overflow:hidden;min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:center}
.hero-shader{position:absolute;inset:0;width:100%;height:100%;display:block;z-index:0;border:0;cursor:crosshair}
.hero-scrim{position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(900px 480px at 86% -10%, rgba(58,102,168,.12), transparent 60%),linear-gradient(128deg, rgba(8,8,16,.78) 0%, rgba(10,10,22,.46) 46%, rgba(14,16,32,.20) 100%),linear-gradient(180deg, rgba(8,8,16,.26) 0%, transparent 30%, transparent 70%, rgba(8,8,16,.42) 100%)}
.hero > .wrap{position:relative;z-index:2}
.hero-visual .hg-stage{will-change:transform,filter}
@media (prefers-reduced-motion:reduce){.hero-visual .hg-stage{transform:none!important;transition:none}}
</style>
<style id="forte-large-screens">
/* === LARGE & ULTRAWIDE SCALING ===
   Below 1280px nothing changes. Above it, the content container and type scale
   fluidly with the viewport (capped) instead of freezing at the 1180px max — so
   the homepage keeps filling the screen as the window widens on large and
   34-inch ultrawide displays, rather than shrinking into a narrow centred column.
   Every floor equals the existing value, so there is no jump at the breakpoint. */
@media (min-width:1280px){
  :root{ --max:clamp(1180px, 84vw, 1820px); }
  .wrap{ padding:0 clamp(28px, 2.6vw, 56px); }

  section{ padding:clamp(84px, 6vw, 132px) 0; }

  .hero h1{ font-size:clamp(58px, 4.4vw, 88px); max-width:14ch; }
  .hero p.lede{ font-size:clamp(17.5px, 1.2vw, 23px); max-width:56ch; }
  .hero-grid{ gap:clamp(64px, 5vw, 120px); }

  h2.display{ font-size:clamp(38px, 3vw, 56px); }
  .section-intro{ font-size:clamp(16.5px, 1.15vw, 21px); max-width:62ch; }

  .stat{ padding:clamp(34px, 2.4vw, 52px) clamp(28px, 2vw, 46px); }
  .stat .n{ font-size:clamp(34px, 2.7vw, 58px); }
  .stat .l{ font-size:clamp(12px, .78vw, 15px); }

  .cp-pills .pill{ font-size:clamp(14.5px, 1vw, 17px); padding:clamp(13px,1vw,17px) clamp(24px,1.7vw,32px); }
  .svc h3{ font-size:clamp(17px, 1.15vw, 21px); }
  .svc p{ font-size:clamp(13.5px, .92vw, 16px); }
}
</style>
<style id="forte-client-logos">
/* ===== Clients — scrolling logo strip beneath the type pills ===== */
.client-logos{margin-top:44px;padding:22px 0;background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.cl-viewport{position:relative;width:100%;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.cl-track{display:flex;align-items:center;gap:18px;width:max-content;will-change:transform}
.cl-chip{position:relative;display:flex;align-items:center;justify-content:center;flex:none;width:188px;height:72px;padding:0 16px}
.cl-logo{display:none;max-height:52px;max-width:164px;width:auto;height:auto;object-fit:contain;filter:grayscale(1);opacity:.82;mix-blend-mode:multiply;transition:filter .4s ease,opacity .4s ease,transform .4s cubic-bezier(.22,1,.36,1)}
.cl-chip.has-logo .cl-logo{display:block}
.cl-chip.has-logo:hover .cl-logo{filter:none;opacity:1}
.cl-chip.cl-icon:hover .cl-logo{transform:translateY(-9px)}
.cl-name{position:absolute;left:0;right:0;bottom:8px;text-align:center;font-family:'Montserrat','Segoe UI',system-ui,-apple-system,sans-serif;font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#6E6D86;opacity:0;transform:translateY(5px);transition:opacity .3s ease,transform .4s cubic-bezier(.22,1,.36,1);pointer-events:none}
.cl-chip.cl-icon:hover .cl-name{opacity:1;transform:none}
.cl-chip.cl-word .cl-name{display:none}
.cl-chip.is-text .cl-name{position:static;opacity:1;transform:none;font-size:14.5px;font-weight:600;letter-spacing:-.01em;text-transform:none;color:#5A5975;transition:color .3s ease}
.cl-chip.is-text:hover .cl-name{color:#2B2A6E}
@media (max-width:600px){.cl-chip{width:158px;height:64px}.cl-logo{max-width:132px;max-height:44px}.cl-name{font-size:13px}}
</style>
<style id="forte-hero-flat">
/* HERO — no background graphic. Flat near-black brand field (option A); globe is the sole focal point. */
.hero{
  background:
    radial-gradient(900px 480px at 86% -10%, rgba(58,102,168,.15), transparent 60%),
    linear-gradient(128deg,#0A0913 0%,#0E0C1C 45%,#100F21 100%);
}
.hero-visual .hg-stage{max-width:490px}
@media (max-width:1020px){.hero-visual .hg-stage{max-width:345px}}
</style>
<style id="forte-footer-clean">
/* FOOTER — page background, one hairline above; logo centred, LinkedIn right. Works in both themes. */
footer.ft{
  background:var(--paper);color:var(--text-soft);
  border-top:1px solid var(--line);
  padding:40px 0 30px;font-size:12.5px;line-height:1.7;
}
footer.ft .ft-top{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:24px}
footer.ft .ft-brand{justify-self:center}
footer.ft .ft-brand .foot-logo{width:118px;height:auto;display:block}
[data-theme="dark"] footer.ft .ft-brand .foot-logo{filter:brightness(0) invert(1)}
footer.ft .ft-li{
  justify-self:end;display:inline-flex;align-items:center;
  color:var(--text-soft);transition:color .25s ease;
}
footer.ft .ft-li:hover{color:var(--indigo)}
footer.ft .ft-links{display:flex;justify-content:center;flex-wrap:wrap;gap:10px 26px;margin-top:34px}
footer.ft .ft-links a{font-size:11.5px;color:var(--text-soft);text-decoration:none;transition:color .25s ease}
footer.ft .ft-links a:hover{color:var(--indigo)}
footer.ft .ft-base{margin:14px 0 0;text-align:center;font-size:11.5px;color:var(--text-soft)}
@media (max-width:900px){footer.ft .ft-top{gap:16px}}
@media (max-width:600px){
  footer.ft{padding:32px 0 24px}
  footer.ft .ft-links{gap:8px 18px;margin-top:28px}
}
</style>
<style id="forte-darkhead-flat">
/* DARK: bar and footer are unfilled — the page's own background shows through.
   The bar takes the base surface only once content scrolls beneath it. */
[data-theme="dark"] header.site{
  background:transparent !important;
  -webkit-backdrop-filter:none !important;backdrop-filter:none !important;
  box-shadow:none !important;border-bottom-color:transparent !important;
}
[data-theme="dark"] header.site.scrolled,
[data-theme="dark"] header.site.solid{
  background:var(--paper) !important;
  -webkit-backdrop-filter:none !important;backdrop-filter:none !important;
  box-shadow:none !important;
}
[data-theme="dark"] footer.ft{background:transparent !important;box-shadow:none !important}
</style>
<style id="forte-hero-wide">
/* HERO WIDE — the whole page hugs the edges; display-scale headline. */
html{background:#0A0913}
.wrap{max-width:none;padding:0 clamp(36px, 4.5vw, 96px)}
/* iPhone notch/safe areas: let backgrounds paint edge-to-edge, keep content clear */
@supports(padding:max(0px)){
  .wrap{padding-left:max(clamp(36px, 4.5vw, 96px), env(safe-area-inset-left));padding-right:max(clamp(36px, 4.5vw, 96px), env(safe-area-inset-right))}
}
.hero > .wrap{width:100%}
@media (min-width:721px){
  header.site .wrap{transition:transform .35s cubic-bezier(.4,0,.2,1)}
  header.site:not(.solid):not(.scrolled) .wrap{transform:translateY(14px)}
}
section.hero h1{font-size:clamp(54px, 5vw, 96px);max-width:15ch;line-height:1.05;letter-spacing:-.02em}
section.hero p.lede{font-size:clamp(18px, 1.35vw, 25px);max-width:56ch}
@media (min-width:1021px){
  .hero-grid{grid-template-columns:1.4fr 1fr;gap:clamp(48px, 4.5vw, 96px)}
  .hero-grid > div:first-child .hero-ctas{margin-top:auto}
}
@media (max-width:1020px){
  .hero-ctas{margin-top:36px}
}
</style>
<style id="globe-xl">
/* HERO — oversized side globe, full-viewport dark field. Desktop only. */
@media (min-width:1021px){
  .hero.globe-xl{min-height:100vh;min-height:100svh;display:flex;flex-direction:column;justify-content:center}
  .hero.globe-xl > .wrap{position:static;width:100%}
  .hero.globe-xl .hero-grid{grid-template-columns:1fr;gap:0}
  .hero.globe-xl .hero-grid > div:first-child{position:relative;z-index:3;max-width:62%}
  .hero.globe-xl .hero-visual{
    position:absolute;top:50%;right:calc(min(140vh,72vw) * -0.26);
    transform:translateY(-50%);z-index:2;min-height:0;margin:0;
    align-items:center;justify-content:center;
  }
  .hero.globe-xl .hero-visual .hero-globe{flex:none;width:auto;gap:0}
  .hero.globe-xl .hero-visual .hg-stage{width:min(140vh,72vw);max-width:none;margin:0}
  .hero.globe-xl .hg-hint{display:none}
}
</style>
</head>
