    <div class="nav-overlay-foot">
            <span>Professional Clients &amp; Eligible Counterparties only &middot; FCA FRN 478424</span>
      <a class="ov-li" href="https://www.linkedin.com/company/forte-securities---eighth-wonder-capital/" target="_blank" rel="noopener" aria-label="Forte Securities on LinkedIn"><svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a>
    </div>
  </div>
</div>

<main>
<!-- ============ HERO ============ -->
<section class="hero globe-xl" aria-labelledby="hero-h">
  <div class="wrap hero-grid">
    <div>
      <h1 id="hero-h" class="tr-target">Independent execution for <em>institutional</em> markets.</h1>
      <p class="lede tr-target">Forte Securities provides institutional market access, deep liquidity and trading expertise across fixed income, equity derivatives and FX.</p>
      <div class="hero-ctas">
        <a class="btn on-dark solid" href="#markets">View market coverage<svg class="btn-arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg></a>
        <a class='btn on-dark' href='/offices'>View our seven offices<svg class="btn-arrow" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg></a>
      </div>
    </div>
        <div class="hero-visual">
      <figure class="hero-globe" aria-label="Forte Securities operates from seven offices worldwide: London, Paris, Geneva, Monaco, Dubai, Hong Kong and Sydney">
        <div class="hg-stage">
          <canvas class="hg-canvas"></canvas>
          <div class="hg-labels" aria-hidden="true"></div>
        </div>
        <figcaption class="hg-hint">Drag to explore &middot; select an office</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- ============ STATS ============ -->
<section class="stats" aria-label="Firm at a glance">
  <div class="wrap">
    <div class="stats-cta">
      <a class='btn' href='/firm'>Who we are<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h13M12.5 6l6 6-6 6"/></svg></a>
    </div>
    <div class="stats-grid">
      <div class="stat rv"><div class="n" data-from="1900">2008</div><div class="l">Founded in London</div></div>
      <div class="stat rv"><div class="n">90+</div><div class="l">Market professionals</div></div>
      <div class="stat rv"><div class="n">7</div><div class="l">Offices worldwide</div></div>
      <div class="stat rv"><div class="n">200+</div><div class="l">Institutional counterparties</div></div>
    </div>
  </div>
</section>

<!-- ============ MARKETS ============ -->
<section id="markets">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Markets</p><span class="rule rv" aria-hidden="true"></span>
    </div>
    <h2 class="display">Market coverage</h2>
    <p class="section-intro">Each desk covers its asset class through the firm&rsquo;s network of bank, market-maker and buy-side counterparties in developed and emerging markets.</p>
    <div class="table-scroll rv">
      <table class="register">
        <thead>
          <tr><th scope="col">Desk</th><th scope="col">Coverage</th></tr>
        </thead>
        <tbody>
          <tr>
            <td class="desk"><span class="dname"><span class="facet i" aria-hidden="true"></span>Fixed Income &amp; Rates</span></td>
            <td class="cov">Sovereign, SSA and corporate credit; emerging-market hard- and local-currency debt; rates and repo products.</td>
          </tr>
          <tr>
            <td class="desk"><span class="dname"><span class="facet r" aria-hidden="true"></span>Equities &amp; Equity Derivatives</span></td>
            <td class="cov">Index and single-stock options, ETFs, delta-one, variance and correlation products; cash equities in developed and emerging markets.</td>
          </tr>
          <tr>
            <td class="desk"><span class="dname"><span class="facet t" aria-hidden="true"></span>FX &amp; Money Markets</span></td>
            <td class="cov">G10 and emerging-market spot, forwards and swaps; deposits and short-dated instruments.</td>
          </tr>
          <tr>
            <td class="desk"><span class="dname"><span class="facet s" aria-hidden="true"></span>Structured Products</span></td>
            <td class="cov">Equity-, rate- and credit-linked notes; certificates and repackaged issuance, intermediated between issuers and professional investors.</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="table-note">Instrument scope on the Forte OTF is limited to the firm&rsquo;s FCA permissions. Availability varies by jurisdiction and counterparty classification.</p>
  </div>
</section>

<!-- ============ COUNTERPARTIES ============ -->
<section id="coverage">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Clients</p><span class="rule rv" aria-hidden="true"></span>
    </div>
    <h2 class="display">Who we work with</h2>
    <p class="section-intro">Forte acts only for clients classified as Professional Clients or Eligible Counterparties under MiFID II. We do not provide services to retail clients.</p>
    <ul class="cp-pills rv" id="cpPills" aria-label="Counterparty types Forte works with">
      <li class="pill" data-d="Flow and structured desks that need liquidity and anonymity in credit, rates and derivatives.">Investment banks</li>
      <li class="pill" data-d="Long-only institutions that execute in size in developed and emerging markets.">Asset managers</li>
      <li class="pill" data-d="Managers that need access to volatility, credit and emerging-market liquidity.">Hedge funds</li>
      <li class="pill" data-d="Official institutions and sovereign funds that transact through regulated intermediaries.">Sovereign &amp; supranational</li>
      <li class="pill" data-d="Single and multi-family offices that meet the professional-client tests.">Family offices</li>
      <li class="pill" data-d="Individuals who qualify for, and choose, professional-client treatment under MiFID II.">UHNW professional clients</li>
    </ul>
    <div class="cp-detail" id="cpDetail" role="region" aria-live="polite">
      <div class="cp-detail-inner">
        <div class="cp-detail-panel">
          <span class="cp-detail-label"></span>
          <span class="cp-detail-body"></span>
        </div>
      </div>
    </div>
  </div>
  <div class="client-logos" aria-label="A selection of the institutions Forte works with">
    <div class="cl-viewport">
      <div class="cl-track" id="clTrack"></div>
    </div>
  </div>
</section>

<!-- ============ GROUP SERVICES ============ -->
<section class="adjacent" id="adjacent">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Group services</p><span class="rule rv" aria-hidden="true"></span>
    </div>
    <h2 class="display">Services beyond broking</h2>
    <p class="section-intro">Four further capabilities sit alongside the broking business. Each operates apart from the firm&rsquo;s broking and OTF activity, and some are provided by affiliated entities under their own regulatory permissions.</p>
    <div class="svc-grid">
      <article class="svc rv"><span class="facet t" aria-hidden="true"></span><h3>Custody</h3><p>Safekeeping and settlement of client assets, with segregated accounts and asset servicing for institutional holders.</p></article>
      <article class="svc rv"><span class="facet s" aria-hidden="true"></span><h3>Asset management</h3><p>Discretionary portfolio management for professional investors and family offices, run separately from the broking desks.</p></article>
      <article class="svc rv"><span class="facet r" aria-hidden="true"></span><h3>Private markets</h3><p>Arranged access to private placements and unlisted opportunities for professional investors able to bear illiquidity.</p></article>
      <article class="svc rv"><span class="facet i" aria-hidden="true"></span><h3>Securitisation</h3><p>Arranging and structuring of asset-backed issuance for originators and the institutional investors who fund them.</p></article>
    </div>
    <p class="table-note">Counterparty documentation names the relevant entity and its permissions before any business is done. Enquiries: <a href="mailto:info@fortesecurities.com">info@fortesecurities.com</a>.</p>
  </div>
</section>

<!-- ============ FRAUD NOTICE ============ -->
<div class="fraud">
  <div class="wrap">
    <div class="inner rv">
      <div>
        <h3>Fraud &amp; impersonation notice</h3>
        <p>Forte Securities does not solicit retail clients, operate trading apps or messaging-group investment schemes, or request payments to personal accounts. If you receive a communication claiming to come from the firm, verify it independently on +44&nbsp;20&nbsp;7099&nbsp;4950 or via info@fortesecurities.com, and check our entry on the FCA Financial Services Register before acting.</p>
      </div>
    </div>
  </div>
</div>
</main>

<!-- ============ FOOTER ============ -->
<footer id="legal" class="ft">
  <div class="wrap">
    <div class="ft-top">
      <span aria-hidden="true"></span>
      <div class="ft-brand">
        <img class="foot-logo" src="data:image/png;base64," alt="Forte Securities" width="118">
      </div>
      <a class="ft-li" href="https://www.linkedin.com/company/forte-securities---eighth-wonder-capital/" target="_blank" rel="noopener" aria-label="Forte Securities on LinkedIn"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a>
