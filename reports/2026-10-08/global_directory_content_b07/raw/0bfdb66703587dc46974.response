	<header class="hero-banner">
    <!DOCTYPE html>
<html lang="en">
<img src="/images/header_img.png" alt="Spotex Header Image">
</html>
	<div class="hero-content">
		<div class="hero-feature-list">
            <div class="hero-feature-item">
                <h2>Crypto-vs-Fiat Flexibility</h2>
                <div class="hero-feature-text">
                    Support for both native and synthetic crypto/fiat trading through our FX-driven infrastructure, providing greater 
                    flexibility for institutional participants.
                </div>
            </div>
            <div class="hero-feature-item">
                <h2>Fully Automated Trade Lifecycle</h2>
                <div class="hero-feature-text">
                    End-to-end workflow automation from risk checks through seamless integration with custodians, settlement 
                    providers, and banking systems.
                </div>
            </div>
        </div>
    </div>
</header>

<section class="broker-platform-section">
    <div class="cm-container">
        <h2 class="cm-title broker-platform-title">
            Trade on Low Latency ECN or Disclosed Custodian Liquidity Hub
        </h2>
        <div class="cm-grid broker-platform-grid">
            <div class="cm-card broker-platform-card">
                <div class="cm-image-center">
                <img src="/images/Low_Latency_ECN.png" alt="Low Latency ECN" class="img-responsive">
                </div>
            </div>
            <div class="cm-card broker-platform-card">
                <div class="cm-image-center">
                <img src="/images/Liquidity_Hub.png" alt="Disclosed Broker Liquidity Hub" class="img-responsive">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cm-split-section cm-section-blue cm-turnkey-section">
    <div class="cm-container">
        <div class="cm-turnkey-ring">
        <img src="images/key-ring.png" alt="Turn Key Solution">
        </div>
        <div class="cm-row cm-turnkey-row">
            <div class="col-md-10"></div>
            <div class="col-md-14">
                <div class="cm-turnkey-content">
                    <div class="cm-subtitle">TURN-KEY SOLUTION</div>
                    <h2 class="cm-heading">
                        Complete,<br>
                        Turn-Key White-Label<br>
                        Broker Suite
                    </h2>
                    <div class="cm-text">
                        Spotex provides a full range of proprietary technology,
                        liquidity, and credit options to enable brokers to configure
                        an out-of-the-box or bespoke operating environment that best
                        supports their business strategy and market position.
                    </div>
                    <div class="cm-text cm-text-space">
                        Brokers benefit by quick-to-market, complete,
                        end-to-end interoperability and best-in-class
                        uptime performance.
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cm-split-section cm-section-white cm-modules-section">
    <div class="cm-container">
        <div class="cm-row cm-split-layout">
            <div class="col-md-10">
                <div class="cm-content">
                    <h2 class="cm-heading">Modules and<br>Liquidity Solutions</h2>
                    <div class="cm-text">
                        All system modules are 100% Spotex built. This approach ensures stable,
                        fully integrated operation and high performance upon implementation.
                    </div>
                </div>
            </div>
            <div class="col-md-14">
                <div class="cm-image-center">
                <img src="images/Modules.png" alt="Modules and Liquidity Solutions" class="cm-split-image">
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cm-split-section cm-section-grey cm-asset-section">
    <div class="cm-container">
        <div class="cm-row cm-split-layout">
            <div class="col-md-10">
                <div class="cm-image-center">
                <img src="images/Asset Managers.png" alt="Asset Managers" class="cm-split-image">
                </div>
            </div>
            <div class="col-md-14">
                <div class="cm-content">
                    <h2 class="cm-heading">Asset Managers</h2>
                    <h3 class="cm-text">
                        Streamlined Workflows for FX Executions Across Multiple Portfolios
                    </h3>
                    <div class="cm-text">
                        <ul class="disc">
                            <li>
                                Enhanced PAMM
                                <ul class="circle">
                                    <li>Streamlined Allocations Across Multiple Portfolios</li>
                                    <li>Supports Multi-Currency Trading Accounts</li>
                                </ul>
                            </li>
                            <li>Highly competitive, negotiated commission</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
