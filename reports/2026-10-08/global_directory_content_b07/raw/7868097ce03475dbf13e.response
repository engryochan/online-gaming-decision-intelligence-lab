<script id="google-tag-manager-js-before">
window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}

        // Google Consent Mode default: deny ad/analytics storage until Cookiebot
        // (configured as a tag inside this GTM container) records the visitor's
        // choice. Runs before gtm.js loads so tags start denied even if the
        // in-container Cookiebot tag is slow to fire or its trigger is off.
        gtag('consent', 'default', {
            'ad_storage': 'denied',
            'analytics_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied',
            'personalization_storage': 'denied',
            'functionality_storage': 'denied',
            'security_storage': 'granted',
            'wait_for_update': 500
        });

        window.dataLayer.push({
            'gtm.start': new Date().getTime(),
            event: 'gtm.js'
        });
    
//# sourceURL=google-tag-manager-js-before
