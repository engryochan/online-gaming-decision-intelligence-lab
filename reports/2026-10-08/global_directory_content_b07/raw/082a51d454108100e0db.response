		<div class="hero__text">
			<h1 class="hero__title">Securities Services</h1>
					</div>
	</div>
	<noscript>
    <!-- data-location="hero-img" -->
    <img src="https://usa.bnpparibas/app/uploads/sites/9/cache/2021/09/banner-securities-services/2524907445.jpg" class="lazyload hero__img" alt="" />
</noscript>
<picture>
    <source data-srcset="https://usa.bnpparibas/app/uploads/sites/9/cache/2021/09/banner-securities-services/2609141098.jpg, https://usa.bnpparibas/app/uploads/sites/9/cache/2021/09/banner-securities-services/3102907311.jpg 2x" media="(max-width: 768px)" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />
<source data-srcset="https://usa.bnpparibas/app/uploads/sites/9/cache/2021/09/banner-securities-services/1763065170.jpg, https://usa.bnpparibas/app/uploads/sites/9/cache/2021/09/banner-securities-services/2524907445.jpg 2x" srcset="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" />

    <img data-no-lazy="" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" class="lazyload hero__img" alt=""/>
