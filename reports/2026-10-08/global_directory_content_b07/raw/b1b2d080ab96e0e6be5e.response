<script>
const dropdownWrapper = document.getElementById('productDropdownWrapper');
const dropdownMenu = document.getElementById('productDropdownMenu');
const selectedProductsSpan = document.getElementById('selectedProducts');
let selectedProducts = [];

// Toggle dropdown menu visibility inside modal
dropdownWrapper.addEventListener('click', function() {
    dropdownWrapper.classList.toggle('active');
});

// Event listener for checkboxes in the dropdown
dropdownMenu.addEventListener('change', function(e) {
    const checkbox = e.target;
    const value = checkbox.value.trim();

    if (checkbox.checked) {
        // Add the item to selectedProducts if checked
        if (!selectedProducts.includes(value)) {
            selectedProducts.push(value);
        }
    } else {
        // Remove the item from selectedProducts if unchecked
        selectedProducts = selectedProducts.filter(item => item !== value);
    }

    // Update the selected items display
    if (selectedProducts.length > 0) {
        selectedProductsSpan.textContent = selectedProducts.join(', ');
    } else {
        selectedProductsSpan.textContent = 'Select Products';
    }
});

// Prevent dropdown from closing when clicking checkboxes
dropdownMenu.addEventListener('click', function(e) {
    e.stopPropagation();
});

// Close the dropdown when clicking outside the custom select box
window.addEventListener('click', function(e) {
    if (!dropdownWrapper.contains(e.target)) {
        dropdownWrapper.classList.remove('active');
    }
});
</script>
</body>

</html>