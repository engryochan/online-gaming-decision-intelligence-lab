    let count = element.querySelectorAll('.b3-header__nav-menu-item-sencod-level button.b3-header__nav-menu-item-second-level').length;
  });
  const menuSecondLevel = document.querySelectorAll('.b3-header__nav-menu-item-sencod-level button.b3-header__nav-menu-item-second-level');
  const tertiaryLevel = document.querySelectorAll('.b3-header__nav-menu-item-sencod-level .b3-header__overflow-second');
  const fastAcess = document.querySelectorAll('.menu-fast-access');

  const closeMenus = (selectedIndex) => {
    menuDesktop.forEach((el, index) => {
      if (selectedIndex !== index) el.classList.remove('open');
    });
  };

  const closeAllMenuSecondLevel = (secondLevel, tertiaryLevel, currentSelected) => {
    secondLevel.forEach((button, index) => {
      tertiaryLevel[index].classList.remove('open');
    });
  };

  const handleSecondLevelClick = (listTertiary , buttonSecond, indexSecond) => {
    closeAllMenuSecondLevel(menuSecondLevel, tertiaryLevel, indexSecond);
    listTertiary.classList.toggle('open');
    listTertiary.classList.contains('open')
      ? buttonSecond.setAttribute('aria-expanded', 'true')
      : buttonSecond.setAttribute('aria-expanded', 'false');
  };

  const toggleMenuFirstElement = () => {
    listMenu.forEach((element, index) => {
      const button = element.querySelector('#b3-header-menu .b3-header__nav-menu-item-button');
      const listSecond = element.querySelectorAll('.b3-header__nav-menu-item-sencod-level');
      button.addEventListener('click', (event) => {
        closeMenus(index);
        button.classList.toggle('open');
        button.classList.contains('open')
          ? button.setAttribute('aria-expanded', 'true')
          : button.setAttribute('aria-expanded', 'false');

        if (listSecond) {
          listSecond.forEach((elementSecond , indexSecond) => {
            const buttonSecond = elementSecond.querySelector('button.b3-header__nav-menu-item-second-level');
            const listTertiary = elementSecond.querySelector('.b3-header__overflow-second')
            if(indexSecond == 0 && listTertiary){
              handleSecondLevelClick(listTertiary , buttonSecond , indexSecond);
            }
          });
        }
      });
    });
  };

  const toggleMenuSecondLevel = () => {
    const menuSecondLevel = document.querySelectorAll(
      '.b3-header__nav-menu-item-sencod-level button.b3-header__nav-menu-item-second-level'
    );
    const tertiaryLevel = document.querySelectorAll(
      '.b3-header__nav-menu-item-sencod-level .b3-header__overflow-second'
    );

    menuSecondLevel?.forEach((button, index) => {
      button.addEventListener('click', () => {
        closeAllMenuSecondLevel(menuSecondLevel, tertiaryLevel, index)
        tertiaryLevel[index].classList.toggle('open');

        tertiaryLevel[index].classList.contains('open')
          ? button.setAttribute('aria-expanded', 'true')
          :  button.setAttribute('aria-expanded', 'false');
      });
    });
  };

  const clickOutside = () => {
    document.addEventListener('click', (e) => {
      let clickInside = false;
      const targetSecondLevel = document.querySelectorAll('.b3-header__desktop-overflow');

      menuDesktop.forEach(menu => {
        if (menu.contains(e.target)) {
          clickInside = true;
          fastAcess.forEach(access => {
            access.style.display = 'none';
          });
        } else {
          targetSecondLevel.forEach(subMenu => {
            if (subMenu.contains(e.target)) {
              clickInside = true;
            }
          });
        }
      });

      menuDesktop.forEach(menu => {
        if (!clickInside || !menu.classList.contains('open')) {
          menu.classList.remove('open');
          fastAcess.forEach(access => {
            access.style.display = 'block';
          });
        }
      });
    });
  };

  if (window.innerWidth > 1024) {
    toggleMenuFirstElement();
    toggleMenuSecondLevel();
    clickOutside();
  }
};
</script>
			
			
		
	
	
	
	


	
	
					
				
			
		
	
	


	</div>

