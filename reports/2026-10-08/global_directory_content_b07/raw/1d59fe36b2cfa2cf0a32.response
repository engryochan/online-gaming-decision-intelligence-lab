  <style>
    .b3-mobile-menu__intern-item-link,
    .b3-mobile-menu__intern-item-link-title {
      width: 100%;
      display: flex;
      justify-content: space-between;
      padding-block: 14px;
      padding-inline: 24px;

      border-left: 3px solid transparent;

      color: var(--b3-bsm-green-500)
    }

    .b3-mobile-menu__intern-menu-3 .b3-mobile-menu__intern-item-link-title {
      padding-inline: var(--b3-spacing-2-xl) var(--b3-spacing-lg);
    }

    .b3-mobile-menu__intern-menu-2,
    .b3-mobile-menu__intern-menu-3 {
      flex-direction: column;
      display: flex;
    }

    .b3-mobile-menu__intern-item-link--open {
      background-color: var(--b3-bsm-green-100);
      border-color: #27826B;
    }

    .b3-mobile-menu__intern-item-link .b3-mobile-menu__intern-icon {
      transform: rotate(-90deg);
      transition: rotate 300ms ease-in-out;
    }

    .b3-mobile-menu__intern-item-link--open .b3-mobile-menu__intern-icon {
      transform: rotate(0deg);
    }

    .b3-mobile-menu__intern {
      overflow: scroll;
      max-height: calc(100vh - 70px);
    }

    .b3-mobile-menu__intern-2 {
      display: none;
      max-height: 0;
      overflow: hidden;
      transition: max-height 300ms ease-in-out;
    }

    .b3-mobile-menu__intern-2--open {
      display: block;
      max-height: 500px;
      overflow-y: scroll;
    }

    .b3-mobile-menu__intern-menu-2 {
      padding-block: 0;
    }

    .b3-mobile-menu__intern-item-link-2 {
      padding-inline: calc(var(--b3-spacing-xl) + var(--b3-spacing-sm)) var(--b3-spacing-lg);
    }

    .b3-mobile-menu__mobile {
      display: flex;
      flex-direction: column;
      justify-content: space-between;

