  button.classList.add('open');
  button.setAttribute('aria-selected', true);
  panel.classList.add('open');
  panel.setAttribute('aria-hidden', false);
  const url = new URL(window.location);
  url.searchParams.set("section", configuration.idTab);
  window.history.pushState({}, '', url);
}

const disableTab = (button, panel) => {
  button.classList.remove('open');
  button.setAttribute('aria-selected', false);
  panel.classList.remove('open');
  panel.setAttribute('aria-hidden', true);
}

const disableAllTabs = () => {
  const btnList = fragmentElement.closest('.tabs__wrapper-buttons');
  const buttons = btnList.querySelectorAll('button');
  const panelsList = fragmentElement.closest('.tabs__container').querySelector('.tabs__context');
  const panels = panelsList.querySelectorAll('.tabs__result');
  for (let i = 0; i < buttons.length; i++) {
    disableTab(buttons[i], panels[i]);
  }
}


createPanel();
const url = new URL(window.location);
const openTab = url.searchParams.get("section");

const buttonFragment = document.getElementById(`btn-${configuration.idTab}`);
const panelFragment = document.getElementById(`panel-${configuration.idTab}`);

if ((configuration.isStandard && openTab === null) || openTab === configuration.idTab) {
  activeTab(buttonFragment, panelFragment)
}

buttonFragment.addEventListener('click', () => {
  disableAllTabs();
  activeTab(buttonFragment, panelFragment);
});;</script></div><div class="lfr-layout-structure-item-menu-lateral-item lfr-layout-structure-item-8526f600-2360-3b25-e37e-5aa38feaac7b "><div id="fragment-9d001af4-d7ee-afc2-b9d3-340a5d34b911"> <button id="btn-diligencia-e-responsabilidades" role="tab" aria-selected="false" aria-controls="panel-bdrs-diligencia-e-responsabilidades" class="menu-lateral__button menu-lateral__button--diligencia-e-responsabilidades">
  Diligência e responsabilidades
</button>
<div id="content-diligencia-e-responsabilidades">
  <div id="panel-diligencia-e-responsabilidades" role="tabpanel" aria-labelledby="btn-diligencia-e-responsabilidades" aria-hidden="true" class="tabs__result tabs__result--diligencia-e-responsabilidades">
    <div><div class="lfr-layout-structure-item-0623f54c-ea67-67ee-c007-24c5c5da5c9d lfr-layout-structure-item-container "><div class="lfr-layout-structure-item-basic-component-heading lfr-layout-structure-item-155af696-8cf0-0af8-02e4-c52aa6c65022 title-processos"><div id="fragment-7f7f149f-4e11-5cf8-91d0-a1fda0d847b4"> <h2 class="component-heading mb-0 text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="text">Diligência e Responsabilidades</h2></div><style>.fragment-heading-text-colored a {
	color: inherit;
}</style></div><div class="lfr-layout-structure-item-basic-component-paragraph lfr-layout-structure-item-a87c49e8-ccc2-127c-301c-6c58624925a9 paragraph-processos"><div id="fragment-5b1e8c5c-111d-33a4-5f5a-79100a3e2bc4"> <div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text">Caso as análises realizadas apontem para irregularidades ou deficiências de controles e processos, poderão ser adotados procedimentos visando sua correção e evitando sua reincidência. Para a determinação das medidas a serem adotadas, são utilizadas as seguintes premissas:
<ul>
	<li>gravidade da irregularidade identificada;</li>
	<li>recorrência de infrações e falhas de controle;</li>
	<li>total relativo de infrações e de falhas de controle observados (quantidade e relevância);</li>
	<li>existência de Processo Administrativo Disciplinar em andamento ou recente sobre o mesmo assunto;</li>
	<li>tempo de reação do Participante frente à recomendações anteriormente fornecidas pela BSM Supervisão de Mercados;</li>
	<li>modelo de negócio do Participante (risco para mercado/terceiros);</li>
	<li>relevância do Participante (volume);</li>
	<li>diligência:</li>
</ul>
</div></div><style>.component-paragraph img {
	max-width: 100%;
}</style></div><div class="lfr-layout-structure-item-basic-component-paragraph lfr-layout-structure-item-fb098b24-7e6b-5384-8c94-2172734be305 paragraph-processos"><div id="fragment-485ecf94-48bb-abe3-2a1f-30289866aee3"> <div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text"><ul>
	<li>qualidade das ações propostas, inclusive gastos com controle;</li>
	<li>tempo de reação;</li>
	<li>ações realizadas;</li>
	<li>melhoria da classificação ou da nota da auditoria.</li>
</ul>
</div></div></div><div class="lfr-layout-structure-item-basic-component-paragraph lfr-layout-structure-item-3b6e222d-4e49-c024-93b7-68fe714d44ab paragraph-processos"><div id="fragment-7a8f140e-fdee-bcae-7e92-e45cf2c5c21a"> <div class="clearfix component-paragraph text-break" data-lfr-editable-id="element-text" data-lfr-editable-type="rich-text"><ul>
	<li>histórico do Participante na BSM Supervisão de Mercados;</li>
	<li>julgamento do Diretor de Autorregulação sobre a qualidade da governança;</li>
	<li>encerramento de atividades do Participante.</li>
</ul>
</div></div></div></div></div>
  </div>
