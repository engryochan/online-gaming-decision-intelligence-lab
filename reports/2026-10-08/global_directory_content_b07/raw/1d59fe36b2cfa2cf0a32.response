const tabSelectedTitleMob = fragmentElement.querySelector(
  '.sub-menu__mobile-selected'
);
const menuButtons = fragmentElement.querySelectorAll(
  `.sub-menu__button--${configuration.idMenu}`
);
const changeSelected = (buttons) => {
  buttons.forEach((button, i) => {
    button.classList.remove('open');
    button.setAttribute('aria-selected', false);
    const splitLink = button.href.split('/');
    if (
      window.location.href.includes(
        splitLink[splitLink.length - 1].toLowerCase()
      )
    ) {
      menuButtons[i].classList.add('open');
      button.setAttribute('aria-selected', true);
    }
  });
};
const changeTabSelectedMob = (buttonSelected) => {
  const containerButtons = fragmentElement.querySelector(
    '.sub-menu__wrapper-buttons'
  );
  if (buttonSelected.classList.contains('open')) {
    tabSelectedTitleMob.textContent = buttonSelected.textContent;
    containerButtons.classList.remove('open');
  }
};
const openTabsMob = () => {
  const openTab = fragmentElement.querySelector(
    '.sub-menu__mobile-wrapper-select'
  );
  openTab.addEventListener('click', () => {
    const titleTab = fragmentElement.querySelector(
      '.sub-menu__wrapper-buttons'
    );
    titleTab.classList.toggle('open');
  });
};
changeSelected(menuButtons);
if (windowSize < 768) {
  menuButtons.forEach((button, i) => {
    changeTabSelectedMob(button);
  });
  openTabsMob();
};</script></div></div><div class="lfr-layout-structure-item-4d16df26-2d4d-ce7e-9ae0-416b0b79b4f0 lfr-layout-structure-item-container "><div class="lfr-layout-structure-item-menu-lateral lfr-layout-structure-item-ba0080e1-385d-f04c-d464-b80c95137d05 "><div id="fragment-d59b508c-c179-b9db-1e03-2eda1b0f363b" > <article class="tabs">
