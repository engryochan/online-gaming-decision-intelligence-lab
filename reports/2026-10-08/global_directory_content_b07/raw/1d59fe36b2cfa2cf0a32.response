    letter-spacing: 20%;
    color: var(--b3-bsm-green-300);
  }

  .institutional-card__icon {
    display: flex;
    align-items: center;
  }

  .anchor-container .b3-icon {
    background-color: var(--b3-bsm-green-300);
  }

  .anchor-container--border {
    border: var(--b3-border-width-md) solid var(--b3-bsm-green-500);
    border-radius: 6.25rem;
    color: var(--b3-bsm-green-300);
    background-color: var(--b3-bsm-green-100);
  }

