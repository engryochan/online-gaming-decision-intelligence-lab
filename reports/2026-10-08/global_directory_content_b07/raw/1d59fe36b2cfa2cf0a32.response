const menuButtons = fragmentElement.querySelectorAll(
  `.menu-lateral__button--${configuration.idTab}`
);

const contentButtons = fragmentElement.querySelectorAll(
  `.tabs__result--${configuration.idTab}`
);

const changeSelected = (buttons, results) => {
  buttons.forEach((button, i) => {
    button.classList.remove('open');
    button.setAttribute('aria-selected', false);
    results[i].classList.remove('open');
    results[i].setAttribute('aria-hidden', true);
  });
};

const selectFirstElement = () => {
  const selectAllButtonsTabsChildren = document.querySelectorAll(
    `.tabs__result--${configuration.idTab}.open .menu-lateral__button`
  );
  const selectAllResultTabsChildren = document.querySelectorAll(
    `.tabs__result--${configuration.idTab}.open .tabs__result`
  );

  selectAllButtonsTabsChildren.forEach((button, i) => {
    button.classList.remove('open');
    selectAllResultTabsChildren[i].classList.remove('open');

    if (button.classList.contains('menu-lateral__button-1')) {
      button.classList.add('open');
      button.setAttribute('aria-selected', true);
      selectAllResultTabsChildren[i].classList.add('open');
      selectAllResultTabsChildren[i].setAttribute('aria-hidden', false);
    }
  });
};

menuButtons.forEach((button, i) => {
  button.addEventListener('click', () => {
    changeSelected(menuButtons, contentButtons);
    button.classList.add('open');
    button.setAttribute('aria-selected', true);
    contentButtons[i].classList.add('open');
    contentButtons[i].setAttribute('aria-hidden', false);

    selectFirstElement();
  });
});;</script></div></div><div class="lfr-layout-structure-item-1444053d-9a3f-77cb-aabf-f2249a43ca14 lfr-layout-structure-item-container  container-fluid container-fluid-max-xl"><div class="lfr-layout-structure-item-menu-lateral-container lfr-layout-structure-item-304bd7c7-fe74-3638-cd3b-bec8105f4077 "><div id="fragment-0ae611a2-c30c-ab72-a917-2055c537c851" > <article id="tabs--">
