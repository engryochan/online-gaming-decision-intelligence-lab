  background-color: var(--b3-navy-500);
  color: var(--b3-white);
}

.footer__container {
  max-width: var(--b3-breakpoint-2-xl-down);
  margin: 0 auto;
  padding: var(--b3-spacing-2-xl);
}

.footer__wrapper {
  display: flex;
  flex-direction: column;
  gap: var(--b3-display-3-size);
}

.footer__wrapper-content {
  display: flex;
  gap: var(--b3-header-3-size);
  font-family: var(--b3-body-small);
  text-align: left;
  justify-content: space-between;
}

.footer_firt-column,
.footer_third-column {
  gap: var(--b3-header-4-size);
  display: flex;
  flex-direction: column;
}

.footer_second-column,
.footer_third-column-first,
.footer_third-column-second,
.footer_forth-column,
.footer_fith-column {
  gap: var(--b3-spacing-sm);
  display: flex;
  flex-direction: column;
}

.footer__title-strong {
  font-weight: bold;
}

.footer__subtitle {
  font-size: var(--b3-button-small-size);
  font: var(--b3-body);
  color: var(--b3-white-200);
}

.footer__subtitle:hover {
  opacity: 0.8;
}

.footer__left,
.footer__right {
  display: flex;
  justify-content: space-between;
}

.footer__select-language {
  position: relative;
}

.footer__language-selected {
  display: flex;
  align-items: center;
  gap: var(--b3-spacing-sm);
  cursor: pointer;
}

.footer__language-selected--text {
  font: var(--b3-body-bold);
  color: var(--b3-white-100);
}

.footer__language-options {
  max-height: 0;
  overflow: hidden;
  position: absolute;
  top: 2.188rem;
  right: 0;
  width: 15.625rem;
  border-radius: var(--b3-corner-radius-sm);
  background: var(--b3-white);
}

.footer__language-options.open {
  max-height: 31.25rem;
  overflow: visible;
}

.footer__language-options li:first-child {
  border-bottom: var(--b3-spacing-3-xs) solid var(--b3-gray-1000);
}

.footer__language--link {
  font: var(--b3-body);
  color: var(--b3-text-light);
  padding: var(--b3-spacing-xs);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.footer__language--link:hover {
  font: var(--b3-body-bold);
  background-color: var(--b3-white-300);
  color: var(--b3-text-light);
}

.footer__language-button {
  padding: var(--b3-ds3-type-captions-caption-size);
  gap: var(--b3-ds3-type-captions-caption-size);
  display: flex;
  align-items: center;
  width: 100%;
  font: var(--b3-body);
  color: var(--b3-text-light);
  transition: background 500ms;
  position: relative;
}

.footer__language-button:hover {
  background: var(--b3-focus-hover-light);
}

.footer__encrypt-link {
  font: var(--b3-tag);
  font-weight: 400;
  color: var(--b3-white-100);
}

.footer__encrypt-link:hover {
  color: var(--b3-white-100);
  text-decoration: none;
}

.footer__encrypt {
  color: var(--b3-white-200);
  font: var(--b3-tag);
  font-weight: 400;
}

@media (max-width: 998px) {
  .footer__select-language {
    width: 100%;
    border-bottom: var(--b3-spacing-3-xs) solid var(--b3-gray-500);
    padding-bottom: var(--b3-subtitle-size);
  }

  .footer__language-options {
    width: 100%;
  }

  .footer__right {
    display: flex;
    align-items: center;
    flex-direction: column;
  }
}

@media (max-width: 576px) {
  .footer__container {
    padding: var(--b3-spacing-lg);
    height: 15rem;
  }

  .footer__wrapper {
    gap: 0;
  }

  .footer__left {
    flex-direction: column-reverse;
    align-items: center;
    gap: var(--b3-spacing-lg);
    padding-bottom: var(--b3-spacing-md);
  }

  .footer__select-language {
    display: flex;
    width: 100%;
    border-bottom: var(--b3-border-width-sm) solid var(--b3-white-200);
    padding-bottom: var(--b3-spacing-lg);
  }

  .footer__language-selected {
    width: 100%;
    justify-content: flex-start;
    gap: var(--b3-spacing-sm);
  }

  .footer__right {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--b3-spacing-md);
  }

  .footer_second-column,
  .footer_third-column-first,
  .footer_third-column-second,
  .footer_forth-column,
  .footer_fith-column,
  .footer_firt-column,
  .footer_third-column {
    display: none;
  }
