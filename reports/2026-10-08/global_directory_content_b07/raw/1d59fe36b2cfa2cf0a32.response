.b3-search {
  display: none;

  background: var(--b3-white);
  position: fixed;
  left: 0;
  right: 0;
  z-index: 1200;
  transform: translateY(-200%);
  transition:
    transform 0.2s ease-in-out,
    opacity 0.2s ease-in-out;
  border-bottom: 0.063rem solid var(--b3-gray-300);
  opacity: 0;
}

.b3-search--open {
  transform: translateY(0);
  opacity: 1;
  display: block;
  height: 5.5rem;
}

.b3-search__container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--b3-spacing-md) var(--b3-spacing-2-xl);
  min-height: 5.5rem;
  max-width: var(--b3-breakpoint-2-xl-down);
  margin: 0 auto;
}

.b3-search__title {
  font: var(--b3-header-4);
  color: var(--b3-bsm-blue-700);
  padding-left: var(--b3-spacing-sm);
}

.b3-search__liferay-suggestion-box {
  flex: 1;
  max-width: 39rem;
}

.b3-search__liferay-suggestion-box .input-group {
  width: 100%;
  background-color: color-mix(in srgb, var(--b3-bsm-gray-100), #ffffff 50%);
  border-bottom: 1.5px solid var(--b3-bsm-green-300);
  border-radius: var(--b3-border-width-xl);
}

.b3-search__liferay-suggestion-box .search-bar-keywords-input {
  background-color: transparent;
  border-color: transparent;
  color: var(--b3-bsm-gray);
  height: 3.5rem;
}

.b3-search__liferay-suggestion-box .input-group-inset-item-after {
  border: 0;
  background-color: transparent;
}

.b3-search__liferay-suggestion-box
  .input-group-inset:focus
  ~ .input-group-inset-item,
.b3-search__liferay-suggestion-box
  .input-group-inset.focus
  ~ .input-group-inset-item {
  background-color: transparent;
}

.b3-search__liferay-suggestion-box .btn {
  border: 0;
  background-color: transparent;
  border-left: var(--b3-border-width-sm) solid #c8c8c880;
  border-radius: 0;
}

.b3-search__liferay-suggestion-box .btn .lexicon-icon {
  fill: var(--b3-bsm-green-300);
}

.b3-header {
  width: 100%;
  position: relative;
}

.b3-header__desktop {
  border-bottom: var(--b3-border-width-sm) solid var(--b3-gray-600);
  position: fixed;
  z-index: 900;
  background: #fff;
}

.b3-header__logo-link {
  text-align: center;
  width: 90px;
}

.b3-header__queriesMRP {
  flex: 1;
  text-align: center;
  margin-inline: var(--b3-spacing-sm);
  background-color: var(--b3-bsm-yellow-600);
  color: var(--b3-navy-500);
  font-size: var(--b3-tags-tag-size);
  font-weight: 700;
  text-transform: uppercase;

  border-radius: var(--b3-corner-radius-pill);
  padding-inline: 0.75rem;
  padding-block: var(--b3-spacing-sm);
  max-width: 12.5rem;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--b3-spacing-sm);
  margin-left: 3.25rem;
}

.b3-header__desktop-container {
  max-width: var(--b3-breakpoint-2-xl-down);
  width: 100%;
  margin: 0 auto;
  padding: 0 3rem;
}

.b3-header__nav-container {
  display: flex;
  justify-content: space-between;
  align-items: center;

  position: relative;
}

.b3-header__nav-container .portlet {
  position: unset;
}

.b3-header__nav-menu-item-search {
  border-right: var(--b3-border-width-sm) solid var(--b3-gray-600);
}

.b3-mobile-nav {
  background: var(--b3-white-100);
  position: absolute;
  bottom: 0;
  width: 100%;
  position: fixed;
  z-index: 1005;
  box-shadow: -3px 0px 19px -2px rgba(0, 0, 0, 0.75);
  background-color: var(--b3-bsm-blue-700);
}

.b3-mobile-nav__container {
  display: flex;
  justify-content: space-between;
  max-width: 25rem;
  margin: 0 auto;
}

.b3-mobile-menu__button {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  height: 100%;
  flex: 1;
  padding: var(--b3-spacing-md) 0;
  font: var(--b3-tags-tag-small);
  color: var(--b3-white-100);
  text-transform: uppercase;
  letter-spacing: 1.5px;
}

.b3-mobile-menu__container {
  position: fixed;
  top: 0;
  background: var(--b3-white-100);
  left: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  z-index: 1004;
  display: none;
}

.b3-mobile-menu__menu--open,
.b3-mobile-fast-menu--open {
  display: block;
}

.b3-mobile-menu,
.header__header-mob {
  display: none;
}

.header__header-mob {
  padding: var(--b3-spacing-md);
  text-align: center;
}

.dropdown-menu {
  z-index: 1200;
}

@media (max-width: 998px) {
  .b3-mobile-menu,
  .header__header-mob {
    display: block;
  }

  .b3-mobile-fast-menu__desktop {
    display: none;
  }

  .b3-header__desktop {
    position: unset;
  }
}
</style><script type="module" >const configuration = {"showContentTitle":false,"linkMRP":""}; const fragmentElement = document.querySelector('#fragment-ee64dc14-430e-8e95-e987-c38869c2ccc2'); const fragmentEntryLinkNamespace = 'geyj'; const fragmentNamespace = 'geyj'; const layoutMode = 'view';Liferay.on('allPortletsReady', function () {
  const containerMenuMobile = document.querySelector('.b3-mobile-menu__menu');
  const containerFastMenu = document.querySelector('.b3-mobile-fast-menu');
  const windowSize = document.documentElement.clientWidth || window.innerWidth;
  const closeMenuBtn = document.querySelector('.b3-mobile-menu__header-close');
  const closeFastAccessBtn = document.querySelector(
    '.b3-mobile-menu-fast-access__header-close'
  );
  const buttonFastMenuToggle = document.querySelector('#b3-fast-menu');
  function menuMobileToggleChildren() {
    const menuMobileWithChildren = document.querySelectorAll(
      'button.b3-mobile-menu__intern-item-link'
    );

    menuMobileWithChildren.forEach((item) => {
      item.addEventListener('click', () => {
        item.classList.toggle('b3-mobile-menu__intern-item-link--open');
        item.nextElementSibling.classList.toggle(
          'b3-mobile-menu__intern-2--open'
        );

        item.classList.contains('b3-mobile-menu__intern-item-link--open')
          ? (item.ariaExpanded = true)
          : (item.ariaExpanded = false);
      });
    });
  }

  function closeMenuMobile() {
    const buttonCloseMenu = containerMenuMobile.querySelector(
      '.b3-mobile-menu__header-close'
    );
    if (buttonCloseMenu != null && buttonCloseMenu != undefined) {
      buttonCloseMenu.addEventListener('click', () => {
        containerMenuMobile.classList.remove('b3-mobile-menu__menu--open');
      });
    }
  }

  function closeMenuFastAcessMobile() {
    const buttonCloseMenuMobileFastAccess = containerFastMenu.querySelector(
      '.b3-mobile-menu-fast-access__header-close'
    );
    if (
      buttonCloseMenuMobileFastAccess != null &&
      buttonCloseMenuMobileFastAccess != undefined
    ) {
      buttonCloseMenuMobileFastAccess.addEventListener('click', () => {
        containerFastMenu.classList.remove('b3-mobile-fast-menu--open');
      });
    }
  }

  function menuMobileToggle() {
    const buttonMenuMobileToggle = document.querySelector('#b3-menu-mobile');
    buttonMenuMobileToggle.addEventListener('click', () => {
      containerMenuMobile.classList.toggle('b3-mobile-menu__menu--open');
      navigationBetweenMenus(containerFastMenu, 'b3-mobile-fast-menu--open');
      closeMenuBtn.focus();
    });

    closeMenuMobile();
    menuMobileToggleChildren();
  }

  function fastMenuToggle() {
    buttonFastMenuToggle.addEventListener('click', () => {
      containerFastMenu.classList.toggle('b3-mobile-fast-menu--open');
      navigationBetweenMenus(containerMenuMobile, 'b3-mobile-menu__menu--open');
      // const buttonCloseMenuMobileFastAccess = document.querySelector('#menu-fast-acess__button-close')
      closeFastAccessBtn.focus();
      // if(containerFastMenu.classList.contains('b3-mobile-fast-menu--open')){
      //   buttonCloseMenuMobileFastAccess.focus();
      // }
    });
    closeMenuFastAcessMobile();
  }

  buttonFastMenuToggle.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      closeFastAccessBtn.focus();
    }
  });

  function navigationBetweenMenus(menu, clas) {
    menu.classList.remove(clas);
  }

  function closeSearch(containerSearch) {
    const iconCloseSearch = document.querySelector('.b3-search__close-button');
    const buttonSearch = document.querySelector(
      '.b3-header__nav-menu-item-button-search'
    );
    iconCloseSearch.addEventListener('click', () => {
      containerSearch.classList.remove('b3-search--open');

      buttonSearch.focus();
    });
  }
  const containerSearch = document.querySelector('.b3-search');
  const menuContainer = fragmentElement.querySelector(
    '.b3-mobile-menu__container'
  );
  function openSearch() {
    const iconOpenSearch = document.querySelector(
      '.b3-header__nav-menu-item-search'
    );
    iconOpenSearch.addEventListener('click', () => {
      containerSearch.classList.add('b3-search--open');

      if (containerSearch.classList.contains('b3-search--open')) {
        const searchInput = document.querySelector(
          '.b3-search .search-bar-keywords-input'
        );
        searchInput.focus();
      }
    });

    adjustSearch();
    closeSearch(containerSearch);
  }

  const getFocusableElements = (container) => {
    return Array.from(
      container.querySelectorAll(
        'a[href]:not([tabindex="-1"]), button, textarea, input[type="text"], input[type="radio"], input[type="checkbox"], select'
      )
    );
  };

  const checkFocusableElements = function (event) {
    if (event.key != 'Tab') return;
    const focusableElements = getFocusableElements(this);
    const firstElement = focusableElements.shift();
    const lastElement = focusableElements.pop();
    if (event.shiftKey) {
      if (document.activeElement === firstElement) {
        event.preventDefault();
        lastElement.focus();
      }
    } else {
      if (document.activeElement === lastElement) {
        event.preventDefault();
        firstElement.focus();
      }
    }
  };

  containerSearch.addEventListener('keydown', checkFocusableElements);
  menuContainer.addEventListener('keydown', checkFocusableElements);

  function adjustSearch() {
    const toasters = document.querySelectorAll('.toast-alert');
    const search = document.getElementById('b3-search');

    let hasShowClass = false;

    toasters.forEach((toaster) => {
      if (toaster.classList.contains('show')) {
        hasShowClass = true;
      }
    });

    if (hasShowClass == true) {
      search.style.top = '54px';
    } else {
      search.style.top = '0';
    }
  }

  function adjustHeader() {
    const toasters = document.querySelectorAll('.toast-alert');
    const header = document.getElementById('b3-header__desktop');
    let hasShowClass = false;

    toasters.forEach((toaster) => {
      if (toaster.classList.contains('show')) {
        hasShowClass = true;
      }
    });

    if (hasShowClass == true) {
      header.style.top = '52px';
    } else {
      header.style.top = '0';
    }
  }

  function adjustHeaderLiferay() {
    const header = document.getElementById('b3-header__desktop');
    const liferayMenu = document.querySelector('.control-menu-container');
    const toasters = document.querySelectorAll('.toast-alert');

    let hasShowClass = false;
    let hasMenuLiferay = false;

    toasters.forEach((toaster) => {
      if (toaster.classList.contains('show')) {
        hasShowClass = true;
      }
    });

    if (liferayMenu) {
      hasMenuLiferay = true;
    }
    if (hasMenuLiferay == true && hasShowClass == true) {
      header.style.top = '108px';
    } else if (hasMenuLiferay == true) {
      header.style.top = '55px';
    }
  }

  function adjustSearchLiferay() {
    const search = document.getElementById('b3-search');
    const liferayMenu = document.querySelector('.control-menu-container');
    const toasters = document.querySelectorAll('.toast-alert');

    let hasShowClass = false;
    let hasMenuLiferay = false;

    toasters.forEach((toaster) => {
      if (toaster.classList.contains('show')) {
        hasShowClass = true;
      }
    });

    if (liferayMenu) {
      hasMenuLiferay = true;
    }
    if (hasMenuLiferay == true && hasShowClass == true) {
      search.style.top = '108px';
    } else if (hasMenuLiferay == true) {
      search.style.top = '55px';
    }
  }

  function adjustLogin() {
    const login = document.querySelector('.login-container');
    const header = document.getElementById('b3-header__desktop');

    let hasShowLogin = false;

    if (login) {
      hasShowLogin = true;
    }

    if (hasShowLogin == true) {
      header.style.position = 'unset';
    }
  }
  function adjustPage() {
    const page = document.getElementsByClassName('b3-content-main')[0];
    const toasters = document.querySelectorAll('.toast-alert');

    let hasShowClass = false;
    let hasShowpage = false;

    toasters.forEach((toaster) => {
      if (toaster.classList.contains('show')) {
        hasShowClass = true;
      }
    });

    if (page) {
      hasShowpage = true;
    }

    if (windowSize < 1000) {
      page.style.paddingTop = '0px';
    } else {
      if (hasShowpage == true && hasShowClass == true) {
        page.style.paddingTop = '189px';
      } else {
        page.style.paddingTop = '137px';
      }
    }
  }

  adjustPage();
  adjustLogin();
  adjustHeader();
  adjustHeaderLiferay();
  openSearch();
  adjustSearchLiferay();
  menuMobileToggle();
  fastMenuToggle();
});
;</script></div><div class="lfr-layout-structure-item-modal-consulta lfr-layout-structure-item-18c32033-b4da-12de-373a-14c3ccea1c32 "><div id="fragment-74cbe686-15ff-63e9-baed-d5c377f7b3da" > <section id="modal-consultaMRP" class="modal modal-consultaMRP">
