</style><script type="module" >const configuration = {}; const fragmentElement = document.querySelector('#fragment-74cbe686-15ff-63e9-baed-d5c377f7b3da'); const fragmentEntryLinkNamespace = 'rtow'; const fragmentNamespace = 'rtow'; const layoutMode = 'view';Liferay.on('allPortletsReady', function () {
  const btnAccess = document.querySelector('#acessarBtn');
  const modalContent = document.querySelector('.modal-consultaMRP__content');
  const closeModalBtn = document.getElementById('closeModal');
  const modal = document.getElementById('modal-consultaMRP');
  const openModalBtn = document.querySelector('.b3-header__queriesMRP');
  const selectedBtn = document.querySelector('.modal-consultaMRP__select');
  const switchOptions = {
    opcao1:'https://sistema-mrp.bsmsupervisao.com.br/',
	opcao2:'https://www.bsmsupervisao.com.br/w/sistema-utilizado-para-o-tratamento-dos-processos-de-mrp',
    opcao3:'/pesquisa-de-mrp'
  };

  let valueSelect = '';

  if (btnAccess) {
    btnAccess.classList.add('modal-button-disabled');
    btnAccess.disabled = true;
  }

  function selectOption(event) {
    const target = event.target;
    const selectedOptionElement = target.selectedOptions[0];
    if (selectedOptionElement) {
      valueSelect = selectedOptionElement.getAttribute('value');
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.remove('modal-consultaMRP--open');
    }
  }

  function openModal() {
    if (modal) {
      modal.classList.add('modal-consultaMRP--open');
      const focusableElements = getFocusableElements(modalContent);
      if (focusableElements.length > 0) {
        closeModalBtn.focus();
      }
    }
  }

  if (closeModalBtn) {
    closeModalBtn.addEventListener('click', closeModal);
    closeModalBtn.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        closeModal();
      }
    });
  }

  if (openModalBtn) {
    openModalBtn.addEventListener('click', openModal);
  }

  if (selectedBtn) {
    selectedBtn.addEventListener('change', function (event) {
      if (selectedBtn.value !== '') {
        if (btnAccess) {
          btnAccess.classList.remove('modal-button-disabled');
          btnAccess.classList.add('modal-button-enabled');
          btnAccess.disabled = false;
        }
        selectOption(event);
      } else {
        if (btnAccess) {
          btnAccess.classList.add('modal-button-disabled');
          btnAccess.disabled = true;
        }
      }
    });
  }

  if (btnAccess) {
    btnAccess.addEventListener('click', () => {
      if (valueSelect) {
        window.open(`${switchOptions[valueSelect]}`, '_blank');
        modal.classList.remove('modal-consultaMRP--open');
      }
    });
  }

  const checkFocusableElements = function (event) {
    if (event.key !== 'Tab') return;

    const focusableElements = getFocusableElements(this);
    if (focusableElements.length === 0) return; // Nenhum elemento focável

    const firstElement = focusableElements[0];
    const lastElement = focusableElements[focusableElements.length - 1];

    if (event.shiftKey) {
      if (document.activeElement === closeModalBtn) {
        event.preventDefault();
        lastElement.focus();
      }
    } else {
      if (document.activeElement === lastElement) {
        event.preventDefault();
        closeModalBtn.focus();
      }
    }
  };

  modalContent.addEventListener('keydown', checkFocusableElements);

  function getFocusableElements(container) {
    return Array.from(
      container.querySelectorAll(
        'a[href], button, textarea, input[type="text"], input[type="radio"], input[type="checkbox"], select'
      )
    ).filter(
      (el) => !el.hasAttribute('disabled') && !el.disabled && el.tabIndex !== -1
    );
  }
});;</script></div><div class="lfr-layout-structure-item-vlibras lfr-layout-structure-item-0d8c9ff3-6293-5a35-f35c-a1d400dc41aa "><div id="fragment-74799c60-bfb2-b021-880f-c1d6490351a0" > <div vw class="enabled">
