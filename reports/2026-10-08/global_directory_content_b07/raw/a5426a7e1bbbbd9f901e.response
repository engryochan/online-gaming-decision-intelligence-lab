        "displayNameHtml": "<style>a.cta:hover { color: #3d5198 !important; border-color: #3d5198 !important; } a.cta:active { color: #7085c0 !important; border-color: #7085c0 !important; }<\/style><div style=\"display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 16px; font-family: &quot;Lato&quot;, system-ui, -apple-system, &quot;Segoe UI&quot;, Roboto, &quot;Helvetica Neue&quot;, Arial;\"><span style=\"display: inline-block; padding: 8px 16px; border-radius: 9999px; background: #5065a6; font-size: 12px; font-weight: 400; line-height: 1.5; color: #fff;\">Upcoming<\/span><div style=\"display: flex; flex-direction: column; gap: 4px; width: 100%\"><h2 style=\"margin-bottom: 0; font-size: 32px; line-height: 1.25;\">33rd Investors\' Forum 2026<\/h2><h4 style=\"margin-bottom: 0; font-weight: 700;\">21 - 24 September (Monday - Thursday)<\/h4><div style=\"font-weight: 400;\">Hong Kong<\/div><\/div><div style=\"display: flex; gap: 16px; width: 100%; align-items: flex-start\"><p style=\"flex: 3; font-size: 14px; line-height: 1.43; color: rgba(0, 0, 0, 0.7)\">We are excited to announce an exceptional lineup of esteemed speakers who will offer insightful perspectives on the key issues shaping portfolios. Our event will merge senior executives and investors from across the globe, providing unparalleled corporate access through hundreds of one-on-one and group meetings with leading executives in the region.<\/p><img style=\"flex: 2; width: 33.333%; height: auto; border-radius: 12px\" alt=\"Event poster\" src=\"https://forumfiles.clsa.com/cms/IF26/forumThumbnail.jpeg\" /><\/div><a class=\"cta\" href=\"mailto:events.team@clsa.com\" style=\"display: flex; justify-content: center; align-items: center; width: 217px; height: 40px; padding: 0 24px; border-radius: 4px; border: 1px solid #006; background: transparent; font-weight: 700; color: #006; text-decoration: none;\">Contact Us<\/a><\/div>",
