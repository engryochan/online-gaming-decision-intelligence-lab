	    font-family: 'OpenSansbold', 'OpenSans', Arial, sans-serif;
}

/* Tablet */
@media (max-width: 1024px) {
	.clearfix.menu li a { font-size: 12px; }
	.innerpagemenu1 ul li a { font-size: 11px; padding: 10px 12px; }
}

/* Mobile */
@media (max-width: 768px) {
	html, body { overflow-x: hidden; }
	.clearfix.menu {
		        display: flex !important;
		        flex-direction: column;
		        align-items: center;
		        margin-top: 0 !important;
		        padding: 8px 5px 5px;
	}
	a.logo {
		        position: static !important;
		        left: auto !important;
		        float: none !important;
		        display: block !important;
		        text-align: center;
		        margin: 0 auto 6px;
		        order: -1;
	}
	a.logo img { max-width: 175px; height: auto; }
	ul.menuleft, ul.menuright {
		        display: flex !important;
		        flex-wrap: wrap;
		        justify-content: center;
		        float: none !important;
		        width: 100%;
		        margin: 0;
		        padding: 0;
	}
	ul.menuleft li, ul.menuright li { float: none !important; display: inline-flex; }
	ul.menuleft li a, ul.menuright li a { padding: 6px 8px; font-size: 11px; white-space: nowrap; }
	.innerpagemenu1 { height: auto !important; overflow-x: auto !important; }
	.innerpagemenu1 ul { height: auto !important; display: flex !important; flex-wrap: nowrap; overflow-x: auto; max-width: none !important; padding: 0; margin: 0; }
	.innerpagemenu1 ul li { flex-shrink: 0; float: none !important; }
	.innerpagemenu1 ul li a { white-space: nowrap; padding: 10px 12px; font-size: 11px; display: block; }
	body, p, li { font-size: 14px; line-height: 1.7; }
	h1 { font-size: 22px !important; }
	h2 { font-size: 18px !important; }
	h3 { font-size: 16px !important; }
	#popup2home { width: 100% !important; max-width: 100% !important; }
	#popup2home .clearfix > figure { width: 100% !important; }
	table { display: block; width: 100%; overflow-x: auto; }
	.leftbottom, .rightbottom { float: none !important; text-align: center !important; width: 100% !important; display: block; padding: 5px 0; }
}

/* Small phones */
@media (max-width: 480px) {
	a.logo img { max-width: 150px; }
	ul.menuleft li a, ul.menuright li a { padding: 5px 6px; font-size: 10px; }
