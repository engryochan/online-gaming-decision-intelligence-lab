<script>

    var lei = "LEI";
    var vrijednosni_papiri = "Instruments";

    $(window).on('load', function () {
        convertToMobile();
        handleMobileTableView();
    });

function convertToMobile() {
    $(".tableTemplate").each(function (i, table) {
        var html = "";
        var rows = '';
        table.rows.forEach(function (row, i) {
            if (i > 0) {

                rows += '<div class="mob-tbl-record" ' + '">';
                rows += '<ul class="mob-tbl-record-basic columns-3">';
                rows += '<li>' + row.cells[0].innerHTML + '</li>';
                rows += '<li>' + row.cells[3].innerHTML + '</li>';
                rows += '</ul>';

                rows += '<div class="mob-tbl-record-details">';
                rows += '<ul>';
                rows += '<li><span>' + lei + '</span><i>' + row.cells[1].innerHTML + '</i></li>';
                rows += '<li><span>' + vrijednosni_papiri + '</span><i>' + row.cells[2].innerHTML + '</i></li>';
                rows += '</ul>';
                rows += '</div></div>';

            }
        });

        html += rows + "<div>";
        $("#mobile_" + table.id).html(html);
    })
}

</script>





