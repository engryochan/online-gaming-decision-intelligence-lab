	<!-- <script defer src="https://cdnjs.cloudflare.com/ajax/libs/list.js/2.3.1/list.min.js"></script> -->
	<script>
		(function($) {

			/* =============================
			   Site Search (desktop + mobile)
			=============================*/
			function setupSearchToggle(triggerSel, containerSel) {
				const $trigger   = $(triggerSel);
				const $container = $(containerSel);

				if (!$trigger.length || !$container.length) return;

				$trigger.on('click tap', function() {
					$container.toggleClass('search-active');
					if ($container.hasClass('search-active')) {
						$container.find('input').first().focus();
					}
				});

				$('.close-search').on('click', function() {
					$container.removeClass('search-active');
				});

				$(document).on('click', function(event) {
					if (!$(event.target).closest(containerSel + ', ' + triggerSel).length) {
						$container.removeClass('search-active');
					}
				});
			}

			setupSearchToggle('#search-icon', '#search-container');
			setupSearchToggle('#mobile-search-icon', '#mobile-search-container');

			/* =============================
			   Fade-up on scroll
			=============================*/
			document.addEventListener('DOMContentLoaded', function () {
				function isElementInViewport(el) {
					const rect = el.getBoundingClientRect();
					const triggerPoint = (window.innerHeight || document.documentElement.clientHeight) / 1.5;
					return (rect.top <= triggerPoint && rect.bottom >= 0);
				}

				function onScroll() {
					const elements = document.querySelectorAll('.fade-up');
					elements.forEach((element) => {
						if (isElementInViewport(element)) {
							element.classList.add('show');
						}
					});
				}

				window.addEventListener('scroll', onScroll);
				onScroll();
			});

			/* =============================
			   Sticky header on scroll
			=============================*/
			function checkScroll() {
				if ($(window).scrollTop() > 10) {
					$('#top-bar-menu').addClass('scrolled');
				} else {
					$('#top-bar-menu').removeClass('scrolled');
				}
			}
			checkScroll();
			$(window).on('scroll', checkScroll);

			$('.edu-credit-icon').on('click tap', function(){
				$('.full-edu-tip').toggleClass('active');
			});

			/* =============================
			   Dropdown + Mega Menu (desktop)
			=============================*/
			function isDesktop() {
				return window.innerWidth >= 1024;
			}

			let hoverLock = false;

			// Hover over top-level links
			$('.menu-item a').on('mouseenter', function () {

				if (!isDesktop()) return;

				let $link = $(this);
				let mega = $link.data('mega-toggle');

				// Clear all panels / states from previous item
				$('div[data-menu-page]').removeClass('active');
				$('.menu-item').removeClass('active');
				$('.menu-item a[data-mega-toggle]').removeClass('active');
				$('.menu-overlay').removeClass('active');

				// --- MEGA MENU ITEM ---
				if (mega) {
					$('.menu-overlay').addClass('active');
					$link.addClass('active');

					$('div[data-menu-page="' + mega + '"]')
						.addClass('active')
						.show();

					return;
				}

				// --- REGULAR DROPDOWN ITEM ---
				let $li = $link.closest('li.menu-item-has-children.is-dropdown-submenu-parent');

				if ($li.length) {
					$li.addClass('active');
					$li.children('ul.sub-menu, ul.menu.vertical.submenu').addClass('active');
				}
			});

			// Leaving the top-level link
			$('.menu-item a').on('mouseleave', function () {

				if (!isDesktop()) return;
				if (hoverLock) return;

				let $link = $(this);
				let $li   = $link.closest('li.menu-item-has-children.is-dropdown-submenu-parent');
				let mega  = $link.data('mega-toggle');

				// IMPORTANT: do NOT close mega on link-leave.
				if (mega) {
					return; // keep mega open while we move toward the mega panel
				}

				// Regular dropdown cleanup
				if ($li.length) {
					$li.removeClass('active');
					$li.children('ul.sub-menu, ul.menu.vertical.submenu').removeClass('active');
				}
			});

			// Regular dropdown submenu hover
			$('#main-nav .sub-menu, #main-nav .menu.vertical.submenu')
				.on('mouseenter', function () {
					if (!isDesktop()) return;
					hoverLock = true;
					$(this).addClass('active');
					$(this).closest('li.menu-item-has-children').addClass('active');
				})
				.on('mouseleave', function () {
					if (!isDesktop()) return;
					hoverLock = false;
					$(this).removeClass('active');
					$(this).closest('li.menu-item-has-children').removeClass('active');
				});

			// Mega panel hover / leave
			$('.mega_menu')
				.on('mouseenter', function () {
					if (!isDesktop()) return;
					$('.menu-overlay').addClass('active');
				})
				.on('mouseleave', function () {
					if (!isDesktop()) return;
					$('.menu-overlay').removeClass('active');
					$('div[data-menu-page]').removeClass('active');
					$('.menu-item a[data-mega-toggle]').removeClass('active');
				});

			// Allow parent links to behave normally if they’re real URLs (desktop)
			$('.menu-item a[data-mega-toggle]').off('click').on('click', function (e) {
				if (!isDesktop()) return;

				let href = $(this).attr('href');
				if (href && href !== '#') return; // real URL: let it navigate

				e.preventDefault(); // only block dummy "#" links
			});


			/* =============================
			   ACF Mega Menu anchor click fix (for "#" links)
			   (keeps same behavior, but isolated)
			=============================*/
			(function ($) {
			  $(function () {
			    $('.menu-item a[data-mega-toggle]').off('click.megaHashFix');

			    $('.menu-item a[data-mega-toggle]').on('click.megaHashFix', function (e) {
			      var href = this.getAttribute('href') || '';

			      if (href && href !== '#') {
			        return;
			      }

			      e.preventDefault();
			    });
			  });
			})(jQuery);

			/* =============================
			   Hamburger / mobile menu
			=============================*/
			$('#hamburger').on('click tap', function(){
				$(this).toggleClass('menu-active');
				$('#mobile-menu, .header, body').toggleClass('menu-active');
			});

			/* =============================
			   FAQs (accordion w/ image)
			=============================*/
			$('#accordion-info #question').on('click tap', function(e) {
			    var accordionNum = $(this).data('faqs');

			    if ($(this).hasClass('active')) {
			        $('#accordion-info #question, #accordion-images #accordion-image').removeClass('active');
			    } else {
			        $('#accordion-info #question, #accordion-images #accordion-image').removeClass('active');
			        $(this).addClass('active');
			        $('#accordion-image[data-faqs="' + accordionNum + '"]').addClass('active');
			    }
			});

			/* =============================
			   FAQ Tabs
			=============================*/
			$('.faq-tabs').each(function() {
			    var $tabContainer = $(this);
			    var $parentSection = $tabContainer.closest('section');

			    $tabContainer.find('.tab-button').on('click tap', function(e) {
			        e.preventDefault();
			        var tabNum = $(this).data('tab');

			        $parentSection.find('.tab-button, .tab-content, .tab-details').removeClass('active');
			        $parentSection.find('[data-tab="' + tabNum + '"]').addClass('active');

			        $tabContainer.find('.tab-dropdown').val(tabNum);
			    });

			    $tabContainer.find('.tab-dropdown').on('change', function() {
			        var tabNum = $(this).val();

			        $parentSection.find('.tab-button, .tab-details, .tab-content').removeClass('active');
			        $parentSection.find('[data-tab="' + tabNum + '"]').addClass('active');
			    });

			    $tabContainer.find('.text-button').on('click tap', function(e) {
			        e.stopPropagation();
			    });
			});

			/* =============================
			   Safari detection
			=============================*/
			const isSafari = /^((?!chrome|android).)*safari/i.test(navigator.userAgent);
			if (isSafari) {
			    document.documentElement.classList.add('safari-browser');
			}

			/* =============================
			   Generic accordion
			=============================*/
			$('.accordion-header').on('click', function() {
				var content = $(this).next('.accordion-content');

				$('.accordion-header').not(this).removeClass('active');
				$('.accordion-content').not(content).slideUp();

				$(this).toggleClass('active');
				content.slideToggle();
			});

			/* =============================
			   Team Bios
			=============================*/
			$('html').on('click tap', 'a.show-bio', function(e) {
			    e.preventDefault();
			    var $this = $(this);
			    var memberNum = $this.data('member');

			    $('a.show-bio.collapse').not($this).toggleClass('expand collapse');
			    $('#team .grid .bio-container.active').removeClass('active');

			    if ($this.hasClass('expand')) {
			        $this.toggleClass('expand collapse');
			        $('.bio-container[data-member="' + memberNum + '"]').addClass('active');
			    } else {
			        $this.toggleClass('expand collapse');
			        $('.bio-container[data-member="' + memberNum + '"]').removeClass('active');
			    }
			});

			/* =============================
			   Logo Slider
			=============================*/
			$('.logo-slider').slick({
				infinite: true,
				slidesToShow: 7,
				slidesToScroll: 1,
				centerPadding: '40px',
				arrows: false,
				centerMode: false,
				dots: false,
				autoplay: true,
				autoplaySpeed: 0,
				pauseOnHover : false,
				speed: 3600,
				cssEase:'linear',
				responsive: [
					{
						breakpoint: 768,
						settings: {
							slidesToShow: 2
						}
					}
				]
			});

			/* =============================
			   Custom select-box filter
			=============================*/
			$('body').on('click tap', '#select-box', function (event) {
				event.stopPropagation();
				$(this).toggleClass('open');
			});

			$(document).on('click tap', function (event) {
				if (!$(event.target).closest('#select-box').length) {
					$('#select-box').removeClass('open');
				}
			});

			$('body').on('click tap', '#select-box .cat-list_item', function () {
				$('.cat-list_item').removeClass('active');
				$(this).addClass('active');
				var $thisTitle = $(this).text();
				$(this).parent().siblings('span.text').text($thisTitle);
			});

			/* =============================
			   Slide-toggle blocks
			=============================*/
			$(document).on('click', '.slide-toggle', function (e) {
				if ($(e.target).closest('a, button, input, label, textarea, select').length) return;

				e.stopPropagation();

				var $slide = $(this).closest('.block-slide');
				if (!$slide.length || $slide.hasClass('active')) return;

				var $container = $slide.closest('#block-slider-container, .block-slider-container');

				$container.find('.block-slide.active').removeClass('active');
				$slide.addClass('active');
			});

			/* =============================
			   Sticky in-page nav active state
			=============================*/
			document.addEventListener('DOMContentLoaded', () => {
				const OFFSET = 100;
				const links = Array.from(document.querySelectorAll('.stick-nav .nav-container a[href^="#"]'));
				const entries = links.map(link => {
					const id = decodeURIComponent(link.getAttribute('href')).slice(1);
					const section = document.getElementById(id);
					return section ? { link, section } : null;
				}).filter(Boolean);

				function updateActive() {
					const marker = window.scrollY + OFFSET;
					let current = null;

					for (const { link, section } of entries) {
						const rect = section.getBoundingClientRect();
						const top = rect.top + window.scrollY;
						const bottom = top + rect.height;
						if (marker >= top && marker < bottom) current = link;
					}

					links.forEach(a => a.classList.toggle('active', a === current));
				}

				let ticking = false;
				const onScroll = () => {
					if (!ticking) {
						requestAnimationFrame(() => { updateActive(); ticking = false; });
						ticking = true;
					}
				};

				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				window.addEventListener('load', updateActive);
				updateActive();

				links.forEach(link => {
					const hash = link.hash;
					if (!hash) return;
					const anchor = document.querySelector(`a[href="${hash}"]`);
					if (!anchor) return;
					anchor.addEventListener('click', e => {
						const target = document.getElementById(hash.slice(1));
						if (!target) return;
						e.preventDefault();
						const y = target.getBoundingClientRect().top + window.scrollY - OFFSET + 1;
						window.scrollTo({ top: y, behavior: 'smooth' });
					});
				});
			});

		})( jQuery );
	</script>
	<!-- Line Tracker -->
	<script src="https://cdnjs.cloudflare.com/ajax/libs/bodymovin/5.12.2/lottie.min.js"></script>
	<script>
		(function ($) {
			const $animatedLine = $(`
				<div id="animated-line" aria-hidden="true">
					<div class="line-glow-lottie"></div>
					<span class="line-core"></span>
				</div>
			`).appendTo('body');

			function buildZones() {
				const zones = [];

				const startInset = 120;
				const endInset = 30;

				$('section#copy-image.fifty-fifty.line-active').each(function (index) {
					const $section = $(this);
					const sectionTop = $section.offset().top;
					const sectionBottom = sectionTop + $section.outerHeight();

					zones.push({
						index: index,
						start: sectionTop + startInset,
						end: sectionBottom - endInset,
						$section: $section
					});
				});

				return zones;
			}

			function areConsecutiveActiveModules(currentZone, nextZone) {
				const $nextVisibleSibling = currentZone.$section.nextAll(':visible').first();

				if (!$nextVisibleSibling.length) {
					return false;
				}

				return $nextVisibleSibling.is(nextZone.$section);
			}

			function stitchZones(zones) {
				if (zones.length < 2) {
					return zones;
				}

				const stitched = zones.map(function (zone) {
					return {
						index: zone.index,
						start: zone.start,
						end: zone.end,
						$section: zone.$section
					};
				});

				for (let i = 0; i < stitched.length - 1; i++) {
					const current = stitched[i];
					const next = stitched[i + 1];

					// Only stitch if these are truly consecutive modules in the DOM
					if (!areConsecutiveActiveModules(current, next)) {
						continue;
					}

					if (current.end < next.start) {
						const midpoint = current.end + ((next.start - current.end) / 2);

						// tiny overlap prevents flicker
						current.end = midpoint + 2;
						next.start = midpoint - 2;
					}
				}

				return stitched;
			}

			function getActiveZone(zones, triggerLine) {
				for (let i = 0; i < zones.length; i++) {
					if (triggerLine >= zones[i].start && triggerLine <= zones[i].end) {
						return zones[i];
					}
				}
				return null;
			}

			function updateAnimatedLine() {
				const scrollTop = $(window).scrollTop();
				const viewportHeight = $(window).height();
				const triggerLine = scrollTop + (viewportHeight / 2);

				const rawZones = buildZones();
				const zones = stitchZones(rawZones);
				const activeZone = getActiveZone(zones, triggerLine);

				if (activeZone) {
					$animatedLine.css({
						top: '50%',
						opacity: 1
					});
				} else {
					$animatedLine.css({
						opacity: 0
					});
				}
			}

			$(window).on('scroll resize load', updateAnimatedLine);

			const glowEl = document.querySelector('#animated-line .line-glow-lottie');

			if (glowEl) {
				lottie.loadAnimation({
					container: glowEl,
					renderer: 'svg',
					loop: true,
					autoplay: true,
					path: '/wp-content/themes/Starter/assets/animations/Column-Glow-Teal_Lottie/glow-teal.json'
				});
			}
		})(jQuery);
	</script>
</html> <!-- end page -->
