  <div>
    
            <div data-item-count="1" data-field-entity-type="node" data-field-entity-bundle="update" data-field-entity-view-mode="full" data-field-name="field_header" data-field-type="entity_reference_revisions" class="field field--name--field_header field--type--entity_reference_revisions field--label--hidden node--update--full--field-header node--full--field-header field--name-field-header field--type-entity-reference-revisions field--label-hidden node--update--full--item node--full--item field--item">  <div class="paragraph paragraph-header paragraph--default paragraph-header-default spacing-section-vertical-default-top spacing-section-vertical-default-bottom update paragraph-background-1 section-background-white paragraph--type--header paragraph--view-mode--default modulo--header-layout--layout_6" data-entity-type="paragraph" data-bundle="header" data-view-mode="default" data-entity-id="12035" data-paragraph-type="header" data-paragraph-id="12035" data-fullwidth-paragraph style="--header-settings-bg: var(--color-1)">
    <div class="layout">
      <div class="section-content-container">
        <div class="layout narrow">
          <div class="row narrow">
            <div class="narrow col-12 col-sm-12 col-md-10 offset-md-1 col-lg-10 offset-lg-1">
              <div class="modulo--header-settings-container">

                <div class="modulo--header-settings-text--wrapper text--wrapper">
                  <div class="modulo--header-settings-text--container text--container">
                                          
                                                                
            <div data-item-count="1" data-field-entity-type="node" data-field-entity-bundle="update" data-field-entity-view-mode="_custom" data-field-name="title" data-field-type="string" class="field field--name--title field--type--string field--label--hidden node--update---custom--title node---custom--title field--name-title field--type-string field--label-hidden node--update--_custom--item node--_custom--item field--item">ADEX IDCM Member Workshop 1 – Presentation available</div>
      
                                                                                  
                                                              <div class="modulo--header-settings-extra-info--container extra-info--container">
                        11.09.2026
                      </div>
                                      </div>
