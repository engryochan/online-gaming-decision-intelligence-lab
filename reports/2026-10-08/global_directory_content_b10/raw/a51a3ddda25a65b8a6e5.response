                            <form id="AuthUidPwDialog" name="AuthUidPwDialog" method="POST" target="_self" action="" autocomplete="off" accept-charset="UTF-8" class="card__inner">
                                <h1 class="main-header"><strong>Login</strong></h1>
    

    <input type="hidden" name="icon" value="icon.bssweb">


    <input type="hidden" name="title" value="title.bssweb">


    <input type="hidden" name="logo" value="logo.bssweb">


    <input type="hidden" name="text" value="text.bssweb">


    <input type="hidden" name="contact" value="contact.bssweb">


    <input type="hidden" name="label.isiwebuserid" value="label.isiwebuserid.bssweb">


    <input type="hidden" name="hint.isiwebuserid" value="hint.isiwebuserid.bssweb">


 





<div class="form-group required gui-name--AuthUidPwDialog guiElem-type--text guiElem-name--isiwebuserid">
	

    <label class="field" for="isiwebuserid">
      <span class="title">Username / E-Mail</span>
      <span class="input">
          <input class="form-control" type="text" name="isiwebuserid" id="isiwebuserid"
                 maxlength=""
                 value="" tabindex="8">


      </span>
		</label>
 </div>


 





<div class="form-group required gui-name--AuthUidPwDialog guiElem-type--pw-text guiElem-name--isiwebpasswd">
	

    <label class="field" for="isiwebpasswd">
      <span class="title">Password</span>
      <span class="input password">
          <i class="password__icon--right material-icons" aria-hidden="true" data-js-password-visibility-toggle="">visibility</i>
          <input type="password" class="form-control" name="isiwebpasswd" id="isiwebpasswd"
                 maxlength=""
                 value="" tabindex="9" autocomplete="off" />



      </span>
		</label>
 </div>


		
    
    <div class="form-group gui-name--AuthUidPwDialog guiElem-type--info guiElem-name--forgot">
      
      <p id="forgot">
        <a href="/pwreset/?y=5C32pBMnkPK4fojjj-xtweup77xHXh5h">Forgot password?</a>
      </p>

      
      
      		</div>



		
    
    <div class="form-group gui-name--AuthUidPwDialog guiElem-type--info guiElem-name--change">
      
      <p id="change">
        <a href="/pwchange/?y=5C32pBMnkPK4fojjj-xtweup77xHXh5h">Change password</a>
      </p>

      
      
      		</div>
















 


 
    <div class="form-group form-group--buttons fieldset featured flex-end">


        <button name="verifypasswordsubmit" value="submit" class="btn btn-tertiary btn-info btn--full-width btn--type-button" onclick="if(event.detail > 1) event.preventDefault()">
          Next
        </button>
                <p class="buttons-separator">
      <span class="line"></span>
      Other Login Options
      <span class="line"></span>
    </p>


        <button name="saml" value="selected" class="btn btn-tertiary btn-info btn--full-width btn--type-button" onclick="if(event.detail > 1) event.preventDefault()">
          My Company Login
        </button>
                <p id="register">
      Not a user? <a href="https://sws.six-group.com/registration/Registration?LANG=EN">Register here.</a>
    </p>


        <button name="base" value="selected" class="btn btn-tertiary btn-info btn--full-width btn--type-button" onclick="if(event.detail > 1) event.preventDefault()">
          SIX Employee
        </button>
