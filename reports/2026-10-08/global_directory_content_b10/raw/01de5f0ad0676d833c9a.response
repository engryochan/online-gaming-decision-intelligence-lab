jQuery(function($){
if (history) {
    if (history.state && history.state.productID != null && history.state.productID != "" && history.state.loaded != null && history.state.loaded == 0) {   
        $('button[value="'+history.state.productID+'"]:eq(0)').each(function(){
            var bt = this;
            var f = $(this).closest('form').eq(0);      
            if (/#view/.test($(f).attr('action'))) {            
                $(f).attr('action', document.URL);  
                history.replaceState({"productID": history.state.productID, loaded: 1 }, "", document.URL);
                // console.log($(f));
                $(bt).trigger('click');
                return(false);
            }
        });
    }   
}

if (/#view_/.test(document.URL)) {
    var fragID = ("" + document.URL).split("#view_")[1];
    var fragURL = ("" + document.URL).split("#view_")[0];
    $('button[value="'+fragID+'"]:eq(0)').each(function(){
        var f = $(this).closest('form').eq(0);  
        if ($(this).attr('name') == 'submit') {
            history.replaceState({"productID": fragID, "loaded": 0}, "", fragURL);
            $(this).trigger('click');
        }
    });
} else if ("" != "281") {
    history.replaceState({"productID": "281", "loaded": 0}, "", document.URL);
}
$('div[id^="toggleByCategory"]').click(function() {
  var elID = 'byCategory' + $(this).attr('id').replace('toggleByCategory', '');
  $('#'+elID).eq(0).slideToggle( "slow", function() {
    var elID = $(this).attr('id');
    var pID = elID.split("_")[1];
    pID = "#toggleByCategory_" + pID;
    elID = "#" + elID;
    var vis = $(elID).css("display");
    if (vis == "block") {
        $(pID).find("span.fa")
            .removeClass("fa-angle-down")
            .addClass("fa-angle-up");
    } else {
        $(pID).find("span.fa")
            .removeClass("fa-area-chart")
            .removeClass("fa-angle-up")
            .addClass("fa-angle-down");
    }
  });
});

var mob_vw_h = Math.max(document.documentElement.clientHeight, window.innerHeight || 0);
mob_vw_h = Math.ceil((mob_vw_h) * 0.60)

$('div[id^="byCategory"]').each(function(){
    var elID = $(this).attr('id');
    if (/mob$/.test(elID)) {        
        $('div#'+elID)          
            .css({"overflow": "auto", "height": mob_vw_h+"px"})
            .niceScroll();
    }
});
$('[data-bs-toggle="tooltip"]').delay(5).tooltip(); 
    //custom popovers

    $('[data-bs-toggle="popover"]').each(function(){
        var self = $(this),
            customClass = self.data('bs-custom-class') || '',
            isHtml = !!self.data('bs-html');

        self.popover({
            html: isHtml,
            sanitize: !isHtml,
            template: '<div class="popover ' + customClass + '" role="tooltip"><div class="arrow"></div><h3 class="popover-title"></h3><div class="popover-content"></div></div>',

        }).on('hidden.bs.popover', function(e) {
            $($(this).data('bs.popover').$tip).hide();
        });
    });

    $(document).on('click', '[data-bs-dismiss-popover]', function() {
         $($(this).data('bs-dismiss-popover')).popover('hide');
    });
});
</script>
