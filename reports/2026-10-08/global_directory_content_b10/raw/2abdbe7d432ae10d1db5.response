<style id="wp-custom-css">
/*
 * Main General CSS
*/
body {
  font-family: "Roboto", sans-serif;
}

.color-primary {
	color: #0073A3
}
.color-secondary {
	color: #F36F37
}
a {
  color: #F36F37;
}
.acu-justify {
  text-align: justify;
  text-justify: inter-word;
}
.acu-bold-900{
	font-weight:900 !important;
}
.acu-bold-800{
	font-weight:800 !important;
}
.acu-bold-700{
	font-weight:700 !important;
}
.acu-bold-600{
	font-weight:600 !important;
}
.acu-bold-500{
	font-weight:500 !important;
}
.acu-bold-400{
	font-weight:400 !important;
}

.h1, h1, h1.consulting-custom-title, .h2, h2, h2.consulting-custom-title{
  font-family: "Roboto"; 
	font-weight:400;  
}

.h1, h1, h1.consulting-custom-title{
	font-size: 32px; 
}
.h2, h2, h2.consulting-custom-title{
	font-size: 24px;
	margin-bottom:0;
  
}
.h3, h3, h3.consulting-custom-title{
  text-transform: Capitalize;
	font-size: 20px;
	font-weight:300; 
  
}
.h4, h4, h4.consulting-custom-title{
  text-transform: Capitalize;
	font-size: 18px;
  
}
.h5, h5, h5.consulting-custom-title{
  text-transform: Capitalize;
	font-size: 16px;
  
}
.h6, h6, h6.consulting-custom-title{
  text-transform: Capitalize;
	font-size: 16px;  
}

body .h1::after, 
body h1::after,
.h1::after, h1::after{
	width: 55px;
  height: 1px;
  background-color: var(--e-global-color-secondary);
}
body .h2::after, 
body h2::after,
.h2::after, h1::after{
	width: 55px;
  height: 1px;
  background-color: var(--e-global-color-secondary);
}

.widget.widget_archive ul li.current-cat:hover > a, .widget.widget_archive ul li.current-cat > a, .widget.widget_archive ul li.current-menu-item:hover > a, .widget.widget_archive ul li.current-menu-item > a, .widget.widget_archive ul li.current_page_item:hover > a, .widget.widget_archive ul li.current_page_item > a, .widget.widget_archive ul li:hover > a, .widget.widget_categories ul li.current-cat:hover > a, .widget.widget_categories ul li.current-cat > a, .widget.widget_categories ul li.current-menu-item:hover > a, .widget.widget_categories ul li.current-menu-item > a, .widget.widget_categories ul li.current_page_item:hover > a, .widget.widget_categories ul li.current_page_item > a, .widget.widget_categories ul li:hover > a, .widget.widget_meta ul li.current-cat:hover > a, .widget.widget_meta ul li.current-cat > a, .widget.widget_meta ul li.current-menu-item:hover > a, .widget.widget_meta ul li.current-menu-item > a, .widget.widget_meta ul li.current_page_item:hover > a, .widget.widget_meta ul li.current_page_item > a, .widget.widget_meta ul li:hover > a, .widget.widget_nav_menu ul li.current-cat:hover > a, .widget.widget_nav_menu ul li.current-cat > a, .widget.widget_nav_menu ul li.current-menu-item:hover > a, .widget.widget_nav_menu ul li.current-menu-item > a, .widget.widget_nav_menu ul li.current_page_item:hover > a, .widget.widget_nav_menu ul li.current_page_item > a, .widget.widget_nav_menu ul li:hover > a, .widget.widget_pages ul li.current-cat:hover > a, .widget.widget_pages ul li.current-cat > a, .widget.widget_pages ul li.current-menu-item:hover > a, .widget.widget_pages ul li.current-menu-item > a, .widget.widget_pages ul li.current_page_item:hover > a, .widget.widget_pages ul li.current_page_item > a, .widget.widget_pages ul li:hover > a, .widget.widget_product_categories ul li.current-cat:hover > a, .widget.widget_product_categories ul li.current-cat > a, .widget.widget_product_categories ul li.current-menu-item:hover > a, .widget.widget_product_categories ul li.current-menu-item > a, .widget.widget_product_categories ul li.current_page_item:hover > a, .widget.widget_product_categories ul li.current_page_item > a, .widget.widget_product_categories ul li:hover > a {
  border-left-color: #F36F37;
}

.widget.widget_archive ul li, .widget.widget_categories ul li, .widget.widget_meta ul li, .widget.widget_nav_menu ul li, .widget.widget_pages ul li, .widget.widget_product_categories ul li {
  border-bottom: 2px solid #fff;
  background: #e5f7ff;
  color: #0073A3
}



.rbss-top a{
	  text-decoration: none;
}
.rbss-top a:hover{
	  color: #0073A3;
}

.rbss-top-b a{
	  text-decoration: none;
	color: #fff;
}
.rbss-top-b a:hover{
	  color: #F36F37
}


.button, .post-password-form input[type="submit"], .woocommerce a.button, .woocommerce button.button, .woocommerce input.button, .woocommerce input.button.alt, .woocommerce-cart .wc-proceed-to-checkout a.checkout-button {  
  padding: 6px 40px !important;
  color: #fff;
  background: #0073A3;
  border: 3px solid #0073A3;
}

.button:active, .button:focus, .button:hover, .post-password-form input[type="submit"]:active, .post-password-form input[type="submit"]:focus, .post-password-form input[type="submit"]:hover, .woocommerce a.button:active, .woocommerce a.button:focus, .woocommerce a.button:hover, .woocommerce button.button:active, .woocommerce button.button:focus, .woocommerce button.button:hover, .woocommerce input.button.alt:active, .woocommerce input.button.alt:focus, .woocommerce input.button.alt:hover, .woocommerce input.button:active, .woocommerce input.button:focus, .woocommerce input.button:hover, .woocommerce-cart .wc-proceed-to-checkout a.checkout-button:active, .woocommerce-cart .wc-proceed-to-checkout a.checkout-button:focus, .woocommerce-cart .wc-proceed-to-checkout a.checkout-button:hover {
  background: #F36F37;
  border-color: #F36F37;
}

/* ACU SERVICES */
.acu-services .icon_box.style_5::after, 
.acu-services .icon_box.style_5::before {
  background-color: #0073a3;
}


.acu-services .icon_box.style_5 {
  min-height: 279px !important;
	
}
.vc_custom_heading .icon,
.vc_custom_heading mark {
  color: #f36f37;
}


blockquote {
  border-left: 5px solid #0073A3;
}

.consulting_posts_box.date_boxed_two li.post_item .post_inner .date-wrap {
  font-family: Roboto;
	font-size: 11px !important;
  font-weight: 300 !important;
}

.stm_post_details ul li i {
  color: #0073A3  !important;
}

article.post .wpb_text_column p{
	text-align: justify
}

/** Lists **/

.elementor-default .elementor-tab-content ul:not(.elementor-editor-element-settings) li, .elementor-default .elementor-text-editor ul:not(.elementor-editor-element-settings) li, .elementor-default .elementor-widget-text-editor ul:not(.elementor-editor-element-settings) li {
  padding: 0 0 0 18px;
  margin: 0 0 5px 20px;
	font-size: inherit;
}


.elementor-default .elementor-tab-content ul:not(.elementor-editor-element-settings) li::before, .elementor-default .elementor-text-editor ul:not(.elementor-editor-element-settings) li::before, .elementor-default .elementor-widget-text-editor ul:not(.elementor-editor-element-settings) li::before {
  content: "\f111";
  display: inline-block;
  vertical-align: top;
  font-size: 6px;
  transform: none;
}

.elementor-default .elementor-tab-content ol > li, .elementor-default .elementor-text-editor ol > li, .elementor-default .elementor-widget-text-editor ol > li {
  margin-left:28px;
}






.wpb_text_column ul,
.wpb_text_column ol{
	list-style:decimal;
  margin:0 0 20px !important;
  list-style:none;
  padding:0
}

.wpb_text_column ul > li,
.wpb_text_column ol > li{
  position:relative;
  padding:0 0 0 16px;
  margin:0 0 14px 40px;
  color:#222;
  border:none;
}
.wpb_text_column ul li:before {
  left:-13px;
  top:6px;
  font-size:9px;
  color:#333;
}

/** Start Block Kit CSS: 141-3-1d55f1e76be9fb1a8d9de88accbe962f **/

.envato-kit-138-bracket .elementor-widget-container > *:before{
	content:"[";
	color:#ffab00;
	display:inline-block;
	margin-right:4px;
	line-height:1em;
	position:relative;
	top:-1px;
}

.envato-kit-138-bracket .elementor-widget-container > *:after{
	content:"]";
	color:#ffab00;
	display:inline-block;
	margin-left:4px;
	line-height:1em;
	position:relative;
	top:-1px;
}

/** End Block Kit CSS: 141-3-1d55f1e76be9fb1a8d9de88accbe962f **/

#main {
  padding: 30px 0 60px;
  z-index: 10;
}

.icon-paragraph{
	text-align: justify
}

/*==== ACU-SHORTCUTS =====*/

.acu-shortcuts .elementor-image-box-img{
	width: 56% !important;
}
.acu-shortcuts .elementor-image-box-title{
	font-size: 18px;
	margin-top: 8px;		
}
.acu-shortcuts .elementor-image-box-description{
	font-family: "Roboto";
	margin-top: 8px;		
}
.acu-shortcuts .elementor-image-box-description i{
	color: var(--e-global-color-secondary);
}


/*==== ACU SLIDESHOW =====*/
.acu-slideshow{
  position:relative;
}

.acu-slideshow:after{
    content:"";
    position:absolute;
    z-index:-1;
    -webkit-box-shadow:0 0 30px rgba(0,0,0,0.6);
    box-shadow:0 0 30px rgba(0,0,0,0.6);
    bottom:0px;
    left:1%;
    right:1%;
    width:98%;
    height:30%;
    -moz-border-radius:100%;
    border-radius:100%;
}

.acu-news .news_item_title{
  min-height:90px;
}
.acu-news .post_item{
	
}
.acu-news .img-wrap img{
box-shadow: 25px 0 20px -20px rgba(0, 0, 0, 0.2);
}
.acu-news .consulting_posts_box .consulting_posts li {
  position: relative;
	text-align:center;
}


.acu-news .news_item_info:hover {
  background: rgba(0, 115, 163, 0.05);
}

.acu-news .news_item_info .category{
  font-family: var(--con_secondary_font_family);
  margin: 0px;
	padding:0;	
}
.news_item_info .category a{
	text-transform: uppercase;
	text-wrap: nowrap;
}

.news_item_info .category a:before {
    content: '\f30b';
    font-family: FontAwesome;
    font-style: normal;
    font-weight: normal;
    text-decoration: inherit;
    margin-right:6px;
}




/*==== ACU SLIDESHOW =====*/
.acu-title-hd:after{
    content:"";
    position:absolute;
    z-index:-1;
    -webkit-box-shadow:0 0 14px rgba(0,0,0,0.6);
    box-shadow:0 0 9px rgba(0,0,0,0.4);
    bottom:0px;
    left:15%;
    right:15%;
    width:70%;
    height:30%;
    -moz-border-radius:-100%;
    border-radius:-100%;
}



/*== SPACE ABOVE FOOTER ===*/
#main {
  padding-bottom: 0px;
}

/*== Tribunal Judgements ===*/
.awsm-job-form,
.acu-judgements .date-wrap {
  display: none;
	visibility: hidden;
}
.acu-judgements .news_item_title {
  bottom: -32px !important;
  font-size: 20px !important;
	line-height: 22px !important;
}
.acu-judgements li .news_item_button {
	color: red;
	margin-left:10px;
	top:55px;
	position:absolute;
	transition: all 600ms;
}
.acu-judgements li:hover .news_item_button {
	margin-left:82px;
}
.acu-judgements li .news_item_button svg {
	fill: white;
}
.acu-judgements .consulting_posts li .image  a::after {
  visibility: hidden !important;
}

/*== Smart Consumer ===*/
.smart-consumer .elementor-posts article{
	padding-left:24px;
	position: relative;
}
.smart-consumer .elementor-posts article a{
	position: relative;
}
.smart-consumer .elementor-posts article a:hover{
	text-decoration:none;
	font-weight:500;
}
.smart-consumer .elementor-posts article a:before  {
	position: absolute;
	top:0px;
	left: -24px;
	content: '\f0a9';
	font-size:80%;
	font-family: FontAwesome;
	font-style: normal;
	font-weight: normal;
	text-decoration: inherit;
}
.smart-consumer .elementor-posts article a:hover:before  {
	color: #F36F37
}
/*== Hidden Elements ===*/
.stm_post_details .comments_num, 
.acu-filebird .fbdl-search-control .fbdl-title,
.master-filebird .fbdl-search-control .fbdl-title{
	display: none;
	width:0;
	height:0;
	visibility: hidden;
	margin:0;
	padding:0;
}
/*== LIbrary Document ===*/
.acu-filebird .fbdl-dropdown-toggle.root {
  padding: 7px 4px 3px !important;
	border: 1px solid #ccc !important;
	margin-right: 10px;
	border-radius: 10px;
}

.acu-filebird .fbdl-dropdown-toggle.root svg{
	fill: #0073a3;
	margin:0 4px 4px 4px;
}
.acu-filebird .fbdl-dropdown-toggle.root span{
	margin-left:4px;
}
.acu-filebird .fbdl-layout-control{
	width:100%;
	background: #eee;
	overflow: hidden;
	clear:both;
	padding:6px 12px 4px;
}
.acu-filebird .fbdl-search-control {
	width: 250px;
	float: right;
	margin:0;
	padding: 0;
}

.acu-filebird .fbdl-breadcrumb{
	width: 550px;
	float: left;	
}
.master-filebird .fbdl-search-control {
	float: left;
	margin-left: -10px;
}

.acu-filebird .fbdl-gridview-container .fbdl-grid .fbdl-grid-item {
  padding: 24px 10px !important;
}

.acu-filebird .fbdl-download-button {
  padding: 7px 18px !important;
}

.acu-filebird a.fbdl-page-number {
	padding: 4px 12px !important;
	border-radius: 5px !important; 
	line-height: 18px !important;
	margin-left: 12px;
  color: var(--fb-color-primary-1);
	border: 1px solid #ddd!important;
}

.acu-filebird .fbdl-pagination-wrapper .fbdl-pagination-page-number a.fbdl-page-number.fbdl-selected {
  background: #e9e9e9 !important;
}

.acu-filebird a.fbdl-page-number:hover {
	border: 1px solid #0073A3!important;
}
.acu-filebird .fbdl-grid-item-info {
	margin-bottom: 12px !important;
}
.acu-filebird .fbdl-grid-icon img {
}
.acu-forms-no-hd .fbdl-layout-control, .acu-forms-no-hd .fbdl-layout-control, .acu-forms-no-hd .fbdl-search-control {
	display: none;
	visibility: hidden
}

.form-control, .input-group .form-control, .post-password-form input[type="password"], .woocommerce form .form-row input.input-text, .woocommerce form .form-row textarea, .wpcf7-form-control, body .woocommerce-cart table.cart td.actions .coupon .input-text,
.select2-container.select2-container--default .select2-selection--single .select2-selection__rendered{
  font-size: 13px;
  line-height: 18px;
  color: #222;
  background: #def5ff;
  border: 1px solid #28BDFC;
  box-shadow: none;
  outline: 0;
  padding: 16px 30px 15px;
  border-radius: 0;
  transition: all .3s ease;
  box-sizing: border-box !important;
  width: 100%;
  display: block;
  height: 49px;
}

#filebird-document-library .fbdl-nested-folders {
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
}


/*== Complaint Procedure ===*/
.acu-complaint-procedure .steps_box.style-2 .item .step_title {
  font-size: 19px;
  color: #fff;
	padding: 0 30px;
}
.acu-complaint-procedure  .steps_box.style-2 .item .step_description {
	font-family: 'Roboto';
	text-align: left;
  font-size: 14px;
  line-height: 22px;
  padding: 0 14px;
	color: #fff;
}

.acu-complaint-procedure  .steps_box.style-2 .item .step_title::after {
  border: 2px solid #F36F37;
  background-color: #F36F37;
	font-size: 16px;
}
.acu-complaint-procedure .elementor-progress-wrapper .elementor-progress-bar {
  height: 2px !important;
}
.acu-complaint-procedure .elementor-progress-percentage,
.acu-complaint-procedure .elementor-progress-text {
	display: none;
	visibility: hidden
}

/*== Complaint Procedure ===*/
.acu-footer ul{
	padding-left: 0;
	margin-bottom:0;
}
.acu-footer i{
padding-right: 5px	
}


.staff_list.grid .staff_social_media_card .staff_inner .staff_info .staff_department {
  color: #F36F37;
	text-align: center;
	padding: 0 10px;
}

.acu-vetting-steps-a .steps_box.style-2 .item .step_title,
.acu-vetting-steps-a   .steps_box.style-2 .item .step_description {
	color: #555;
}




/*== histoty icons ===*/
.point_icon {
  width: 44px;
  height: 44px;
	color: red;
}

.point_icon path {
  fill: #0073A3 ;
}


/*== FORM SELECT ===*/
.widget_archive .select2-container.select2-container--default .select2-selection--single .select2-selection__rendered {
  line-height: 18px;
}


/*== GALLERY ===*/
ul.filebird-block-filebird-gallery li{
	padding:0;
	margin:0;
	background:#000;
}
ul.filebird-block-filebird-gallery li::before {
  content: "";
}

ul.filebird-block-filebird-gallery li:hover {
	opacity:0.8;
}

/*== CHAT BOX ===*/

.mwai-timeless-theme .mwai-input button,
.mwai-timeless-theme .mwai-trigger .mwai-icon-text-container .mwai-icon-text-close,
.mwai-timeless-theme.mwai-window .mwai-header {
  background: #0069A7 !important;
}
.mwai-timeless-theme .mwai-trigger .mwai-icon-text-container .mwai-icon-text {
  background: #0073A3 !important;
  font-size: 16px !important;
}
.mwai-timeless-theme .mwai-trigger .mwai-icon-text-container .mwai-icon-text:before {
  content: " ";
  position: absolute;
  display: block;
  background: #0073A3 ;
  height: 14px; 
  width: 14px;
	right: 20px;
  bottom: 58px;
	-webkit-transform: rotate(45deg);
	transform: rotate(45deg);
}
.mwai-timeless-theme .mwai-conversation .mwai-reply.mwai-ai {
  background: #e3f8ff !important;
	border: 1px solid #c3f1ff !important;
}

.mwai-timeless-theme .mwai-conversation .mwai-user{
  background: #ececec !important;
	color: #000 !important;
	border: 1px solid #e1e1e1 !important;
}
.mwai-timeless-theme button {
  background:  #BBEFFF! important;
  color:  #BBEFFF! important;

}

.mwai-timeless-theme .mwai-input button img {
	filter: brightness(0) saturate(100%) invert(100%) sepia(41%) saturate(2968%) hue-rotate(169deg) brightness(100%) contrast(102%) !important;
}


.mwai-timeless-theme .mwai-reply-actions .mwai-copy-button {
  fill: #fff !important;
  background: #0069A7 !important;
}
.mwai-name small{
	padding-top: 3px;
	color: #e3f8ff !important;
	line-height:0.5em !important;
}


/*== News + Media ===*/
.acu-date-wrap {
  display: block;
	margin: -10px 0 0 80px;
	background-color: #0073A3; 
  font-size: 11px;  
  padding: 4px 15px;
  transform: translatex(-50%);
  transition:all .25s ease;
  border-radius: 20px;
	color: #fff !important;
}

.acu-news_item_title .elementor-heading-title.elementor-size-default::after {
  display:none;
	visibility: hidden;
}
.acu-categories-1 {}
.page-numbers{
	display: inline-block;
		padding: 4px 12px !important;
	border-radius: 5px !important; 
	line-height: 18px !important;
	margin-left: 12px;
  
	border: 1px solid #ddd!important;
}

.acu-read-more{}

.acu-img-hover:hover {
  position: relative;
  background: rgba(0, 105, 167, 0.1);
	border-radius: 0 15px 0 15px;
  transition: .2s;
}

/*== JOBS ===*/
.awsm-job-item h2.awsm-job-post-title {
  margin: 0 0 15px;
  line-height: 1.5rem;
  text-align: left;
}

.awsm-job-more-container{
	margin-top:10px
}
a.awsm-job-item .awsm-job-specification-item {
  color: #666;
	font-style: italic;
}
.awsm-job-specification-job-type {
  font-weight: bold;
}

/*== JOBS ===*/
.wp-block-file:not(.wp-element-button) {
  font-size: 1.0em;
	font-weight: bold;
}

.fbdl-list-item div,
.fbdl-list-item-title div a{
font-size: 13px;
}
