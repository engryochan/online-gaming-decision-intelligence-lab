</div></div></footer><div class="w-embed w-script"><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css">

<style>
/* ===== Blog Slider - Keep Webflow defaults ===== */
.blog_slider .swiper-slide,
.blog_slider .blog_slide {
  opacity: 1 !important;
  transform: none !important;
  filter: none !important;
  width: calc(33.33% - 14px) !important;
  flex-shrink: 0 !important;
}

/* Mobile - full width card */
@media (max-width: 991px) {
  .blog_slider .swiper-slide,
  .blog_slider .blog_slide {
    width: 100% !important;
  }
}

/* Link overlay for clickable cards */
.link_overlaping {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  pointer-events: auto !important;
}
.link_overlaping a {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  pointer-events: auto !important;
}
.blog_slide {
  position: relative;
}
.blog_slide > * {
  position: relative;
  z-index: 5;
  pointer-events: none;
}

/* ✅ Allow clicks on mobile */
@media (max-width: 991px) {
  .blog_slide > * {
    pointer-events: auto !important;
  }
  .link_overlaping {
    pointer-events: auto !important;
  }
  .link_overlaping a {
    pointer-events: auto !important;
    opacity: 0;
  }
}

/* ===== Both sliders: arrow buttons – no background ===== */
.blog_slider .blog_button-prev,
.blog_slider .blog_button-next,
.blog_slider .blog_button-prev *,
.blog_slider .blog_button-next *,
.section-project .swiper-button-prev,
.section-project .swiper-button-next,
.section-project .swiper-button-prev *,
.section-project .swiper-button-next * {
  background: none !important;
  background-color: transparent !important;
  box-shadow: none !important;
  outline: none !important;
}
.blog_slider .blog_button-prev::before,
.blog_slider .blog_button-prev::after,
.blog_slider .blog_button-next::before,
.blog_slider .blog_button-next::after,
.blog_slider .blog_button-prev *::before,
.blog_slider .blog_button-prev *::after,
.blog_slider .blog_button-next *::before,
.blog_slider .blog_button-next *::after,
.section-project .swiper-button-prev::before,
.section-project .swiper-button-prev::after,
.section-project .swiper-button-next::before,
.section-project .swiper-button-next::after,
.section-project .swiper-button-prev *::before,
.section-project .swiper-button-prev *::after,
.section-project .swiper-button-next *::before,
.section-project .swiper-button-next *::after {
  background: none !important;
  background-color: transparent !important;
  box-shadow: none !important;
}
.blog_slider .blog_button-prev:hover,
.blog_slider .blog_button-prev:focus,
.blog_slider .blog_button-prev:focus-visible,
.blog_slider .blog_button-prev:active,
.blog_slider .blog_button-next:hover,
.blog_slider .blog_button-next:focus,
.blog_slider .blog_button-next:focus-visible,
.blog_slider .blog_button-next:active,
.blog_slider .blog_button-prev:hover *,
.blog_slider .blog_button-prev:active *,
.blog_slider .blog_button-next:hover *,
.blog_slider .blog_button-next:active *,
.section-project .swiper-button-prev:hover,
.section-project .swiper-button-prev:focus,
.section-project .swiper-button-prev:focus-visible,
.section-project .swiper-button-prev:active,
.section-project .swiper-button-next:hover,
.section-project .swiper-button-next:focus,
.section-project .swiper-button-next:focus-visible,
.section-project .swiper-button-next:active,
.section-project .swiper-button-prev:hover *,
.section-project .swiper-button-prev:active *,
.section-project .swiper-button-next:hover *,
.section-project .swiper-button-next:active * {
  background: none !important;
  background-color: transparent !important;
  box-shadow: none !important;
  outline: none !important;
}
.blog_slider .blog_button-prev.swiper-button-disabled,
.blog_slider .blog_button-next.swiper-button-disabled,
.blog_slider .blog_button-prev.swiper-button-disabled *,
.blog_slider .blog_button-next.swiper-button-disabled *,
.section-project .swiper-button-prev.swiper-button-disabled,
.section-project .swiper-button-next.swiper-button-disabled,
.section-project .swiper-button-prev.swiper-button-disabled *,
.section-project .swiper-button-next.swiper-button-disabled * {
  background: none !important;
  background-color: transparent !important;
}

/* ===== Blog Slider pagination — mobile only ===== */
.blog_slider .swiper-pagination {
  display: none;
  justify-content: center;
  gap: 6px;
  margin-top: 16px;
  position: relative;
  bottom: auto;
}
@media (max-width: 991px) {
  .blog_slider .swiper-pagination {
    display: flex !important;
  }
}
.blog_slider .swiper-pagination-bullet {
  width: 24px !important;
  height: 3px !important;
  border-radius: 2px !important;
  background: rgba(0, 0, 0, 0.2) !important;
  opacity: 1 !important;
  transition: width 0.3s ease, background 0.3s ease;
}
.blog_slider .swiper-pagination-bullet-active {
  width: 36px !important;
  background: #1a1a1a !important;
}

/* ===== Testimonial Slider ===== */
.section-project .swiper-container {
  cursor: grab;
}
.blog_slider {
  cursor: grab;
}
@media (max-width: 991px) {
  .blog_slider,
  .section-project .swiper-container {
    cursor: grab;
  }
}

.section-project .swiper-slide {
  opacity: 0.4;
  transform: scale(0.92);
  transition: opacity 0.5s ease, transform 0.5s ease, filter 0.5s ease;
  filter: blur(1px);
  width: 100% !important;
}
.section-project .swiper-slide-active {
  opacity: 1;
  transform: scale(1);
  filter: blur(0px);
}
.section-project .swiper-slide-prev,
.section-project .swiper-slide-next {
  opacity: 0.6;
  transform: scale(0.95);
  filter: blur(0px);
}

/* ✅ Remove margin-right on desktop */
.section-project .swiper-slide {
  margin-right: 0 !important;
}

/* ✅ Fix card heights + pagination on mobile */
@media (max-width: 991px) {
  .section-project .swiper-wrapper {
    align-items: stretch !important;
  }
  .section-project .swiper-slide {
    height: auto !important;
    display: flex !important;
    align-items: stretch !important;
    margin-right: 24px !important;
  }
  .section-project .swiper-slide > *,
  .section-project .swiper-slide .testimonial_card,
  .section-project .swiper-slide [class*="card"],
  .section-project .swiper-slide [class*="testimonial"] {
    height: auto !important;
    display: flex !important;
    flex-direction: column !important;
  }
  .section-project .swiper-slide,
  .section-project .swiper-slide-active,
  .section-project .swiper-slide-prev,
  .section-project .swiper-slide-next {
    opacity: 1 !important;
    transform: none !important;
    filter: none !important;
  }
  .section-project .swiper-pagination {
    position: relative !important;
    bottom: auto !important;
    margin-top: 16px !important;
    padding-bottom: 4px !important;
  }
}

/* Testimonial pagination */
.section-project .swiper-pagination {
  display: flex;
  justify-content: center;
  gap: 6px;
}
.section-project .swiper-pagination-bullet {
  width: 24px !important;
  height: 3px !important;
  border-radius: 2px !important;
  background: rgba(0, 0, 0, 0.2) !important;
  opacity: 1 !important;
  transition: width 0.3s ease, background 0.3s ease;
}
.section-project .swiper-pagination-bullet-active {
  width: 36px !important;
  background: #1a1a1a !important;
}

/* Testimonial arrows */
.section-project .swiper-button-prev,
.section-project .swiper-button-next {
  all: unset !important;
  cursor: pointer !important;
}
.section-project .swiper-button-prev::after,
.section-project .swiper-button-next::after {
  display: none !important;
}
@media (max-width: 991px) {
  .section-project .swiper-button-prev,
  .section-project .swiper-button-next {
    display: none !important;
  }
}
</style>

<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" type="eb77ae47049bfeb333139241-text/javascript"></script>

<script type="eb77ae47049bfeb333139241-text/javascript">
document.addEventListener('DOMContentLoaded', () => {

  // ===== Blog Slider =====
  const blogSwiper = new Swiper('.blog_slider', {
    slidesPerView: 3,
    spaceBetween: 20,
    grabCursor: false,
    simulateTouch: true,
    breakpoints: {
      0: { slidesPerView: 1 },
      992: { slidesPerView: 3 }
    },
    navigation: {
      nextEl: '.blog_button-next',
      prevEl: '.blog_button-prev',
    },
    pagination: {
      el: '.blog_slider .swiper-pagination',
      clickable: true,
    },
  });

  // ✅ Blog cards clickable — desktop + mobile
  document.querySelectorAll('.blog_slide').forEach(slide => {
    const link = slide.querySelector('.link_overlaping a');
    if (!link) return;

    // Desktop
    let isDragging = false;
    slide.addEventListener('mousedown', () => { isDragging = false; });
    slide.addEventListener('mousemove', () => { isDragging = true; });
    slide.addEventListener('mouseup', () => {
      if (!isDragging) link.click();
      isDragging = false;
    });

    // ✅ Mobile touch
    let startX = 0;
    let startY = 0;
    let touchDragging = false;

    slide.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      touchDragging = false;
    }, { passive: true });

    slide.addEventListener('touchmove', (e) => {
      const dx = Math.abs(e.touches[0].clientX - startX);
      const dy = Math.abs(e.touches[0].clientY - startY);
      if (dx > 8 || dy > 8) touchDragging = true;
    }, { passive: true });

    slide.addEventListener('touchend', () => {
      if (!touchDragging) {
        link.click();
      }
      touchDragging = false;
    });
  });

  // ===== Testimonial Slider =====
  const testimonialSwiper = new Swiper('.section-project .swiper-container', {
    loop: true,
    speed: 800,
    slidesPerView: 1,
    spaceBetween: 0,
    centeredSlides: true,
    grabCursor: false,
    simulateTouch: true,
    autoHeight: true,
    breakpoints: {
      0: { spaceBetween: 24 },
      992: { spaceBetween: 0 }
    },
    navigation: {
      nextEl: '.section-project .swiper-button-next',
      prevEl: '.section-project .swiper-button-prev',
    },
    pagination: {
      el: '.section-project .swiper-pagination',
      clickable: true,
    },
  });

});
</script></div><script src="https://d3e54v103j8qbb.cloudfront.net/js/jquery-3.5.1.min.dc5e7f18c8.js?site=68c59605946d2fed8ac8bcbd" type="eb77ae47049bfeb333139241-text/javascript" integrity="sha256-9/aliU8dGd2tb6OSsuzixeV4y/faTqgFtohetphbbj0=" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/js/zerohash.schunk.f2efb3c5440a81cf.js" type="eb77ae47049bfeb333139241-text/javascript" integrity="sha384-VK02VJvMib7ytrF5M2joPWNtDQs366FZgEQ5B+Iwnjx0WBnwQXfootyziSYxdrmS" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/js/zerohash.schunk.61a53318d9881d3f.js" type="eb77ae47049bfeb333139241-text/javascript" integrity="sha384-Q8kYexmi0tQU8rLpy8T2JPBWjZmCy2IvKo1IbZ87rxrH2u+d0OOqNyFevnKEkH6E" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/js/zerohash.schunk.c4c37e48ebc8026b.js" type="eb77ae47049bfeb333139241-text/javascript" integrity="sha384-po7JpTBh2b8j+ja0Y+xqIprMtUfpSdHlPJRp426cC3GCi/QHUq/BlQMOb03MdPw+" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/js/zerohash.a1ec099d.71766fa44bfce69d.js" type="eb77ae47049bfeb333139241-text/javascript" integrity="sha384-IMNtGT8PB5yDWCDZuhpCTUHr8pT97oKGw+rzWRjhWdC7kYOGyiP3/D1q6G6FRmBh" crossorigin="anonymous"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/gsap.min.js" type="eb77ae47049bfeb333139241-text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/ScrollTrigger.min.js" type="eb77ae47049bfeb333139241-text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/Flip.min.js" type="eb77ae47049bfeb333139241-text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/SplitText.min.js" type="eb77ae47049bfeb333139241-text/javascript"></script><script src="https://cdn.prod.website-files.com/gsap/3.15.0/Draggable.min.js