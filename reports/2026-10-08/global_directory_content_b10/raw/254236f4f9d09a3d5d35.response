    var img=face.querySelector("img"), incoming=next.querySelector("img");
    if(!img||!incoming) return;
    tile.setAttribute("data-zh-busy","1");
    tile.setAttribute("data-zh-brand",String(idx));
    var tag=tile.querySelector(".zh-cgrid_mcase");
    if(tag) tag.style.opacity="0";
    incoming.src=brand.src;
    if(brand.srcset) incoming.srcset=brand.srcset; else incoming.removeAttribute("srcset");
    incoming.alt=brand.name||"Customer logo";
    park(face,"0"); park(next,"110%");
    requestAnimationFrame(function(){ requestAnimationFrame(function(){
      put(face,"transition","transform "+SLIDE+"ms "+EASE);
      put(next,"transition","transform "+SLIDE+"ms "+EASE);
      put(face,"transform","translate3d(0,-110%,0)");
      put(next,"transform","translate3d(0,0,0)");
    })});
    window.setTimeout(function(){
      img.src=brand.src;
      if(brand.srcset) img.srcset=brand.srcset; else img.removeAttribute("srcset");
      img.alt=brand.name||"Customer logo";
      park(face,"0"); park(next,"110%");
      label(tile);
      if(tag) tag.style.opacity="";
      tile.removeAttribute("data-zh-busy");
    },SLIDE+40);
  }
  var slot=0;
  function rotate(){
    if(headOwns()||!mobile()||document.hidden||still()) return;
    if(!brands){ brands=collect(); if(!brands) return }
    var list=tiles(), taken={}, n=Math.min(SHOWN,list.length), tile=null;
    if(!n) return;
    for(var i=0;i<n;i++) taken[list[i].getAttribute("data-zh-brand")]=1;
    for(var k=0;k<n;k++){
      var candidate=list[(slot+k)%n];
      if(candidate&&candidate.getAttribute("data-zh-busy")!=="1"&&!candidate.classList.contains("is-swapping")){
        tile=candidate; slot=(slot+k+1)%n; break;
      }
    }
    if(!tile) return;
    var pool=[];
    for(var j=0;j<brands.length;j++) if(!taken[String(j)]) pool.push(j);
    if(!pool.length) return;
    swap(tile,pool[0]);
  }
  function labels(){
    if(headOwns()||!mobile()) return;
    if(!brands) brands=collect();
    var list=tiles();
    for(var i=0;i<list.length&&i<SHOWN;i++){
      if(list[i].getAttribute("data-zh-busy")==="1") continue;
      label(list[i]);
    }
  }
  labels();
  window.addEventListener("resize",labels);
  if(!still()) window.setInterval(rotate,EVERY);
})();
</script></div><div data-zh-cgrid-source="" aria-hidden="true" class="zh-cgrid_source"><div data-zh-cgrid-pool="" class="zh-cgrid_source w-dyn-list"><div role="list" class="w-dyn-items"><div role="listitem" class="w-dyn-item"><img alt="Alinea" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69c66eaa780bd47627be8f13_Gusto-drak.svg" class="zh-cgrid_hide"/><div class="zh-cgrid_hide">Alinea</div><img loading="lazy" src="" alt="" class="zh-cgrid_hide w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69c66ed005135a9b1fad2acc_alina.svg" alt="" class="zh-cgrid_hide"/></div><div role="listitem" class="w-dyn-item"><img alt="BlackRock" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/6930f4a0b48c86d7aeec6d22_blackrock.svg" class="zh-cgrid_hide"/><div class="zh-cgrid_hide">BlackRock</div><img loading="lazy" src="" alt="" class="zh-cgrid_hide w-dyn-bind-empty"/><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69af2f8bd6c23a362b9f2da1_BlackRock.svg" alt="" class="zh-cgrid_hide"/></div><div role="listitem" class="w-dyn-item"><img alt="Bolt" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/693064be3606d1a18743fdae_bolt.svg" class="zh-cgrid_hide"/><div class="zh-cgrid_hide">Bolt</div><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/68cc7c9f97d207e4209b8b81_bolt.svg" alt="" class="zh-cgrid_hide"/><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69af2e1ed652abefa5e2eaa8_Bolt.svg" alt="" class="zh-cgrid_hide"/></div><div role="listitem" class="w-dyn-item"><img alt="Current" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/693064a9caf15f0118c25b89_current.svg" class="zh-cgrid_hide"/><div class="zh-cgrid_hide">Current</div><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb