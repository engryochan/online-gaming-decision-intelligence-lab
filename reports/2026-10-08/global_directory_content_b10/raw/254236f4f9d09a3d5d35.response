<style id="dg-consent-custom-style">
  /* ========== DataGrail Cookie Banner - Glass Blur Style ========== */
  
  /* CSS Variables */
  :host(.dg-consent-banner) {
    --dg-primary-font: 'Hauora', sans-serif;
    --dg-secondary-font: 'Hauora', sans-serif;
    --dg-consent-background-color: rgba(0, 0, 0, 0.35);
    --dg-consent-background-border: 1px solid rgba(255, 255, 255, 0.1);
    --consent-border-radius: 16px;
    --dg-title-font-size: 14px;
    --dg-title-font-weight: 600;
    --dg-title-font-color: #ffffff;
    --dg-heading-font-size: 11px;
    --dg-heading-font-weight: 400;
    --dg-heading-font-color: rgba(255, 255, 255, 0.7);
    --dg-heading-line-height: 1.4;
    --dg-body-font-size: 11px;
    --dg-body-font-weight: 400;
    --dg-body-font-color: rgba(255, 255, 255, 0.7);
    --dg-body-line-height: 1.4;
    --dg-button-font-size: 12px;
    --dg-button-font-weight: 500;
    --dg-button-color: #ffffff;
    --dg-button-background: rgba(255, 255, 255, 0.1);
    --dg-button-border: 1px solid rgba(255, 255, 255, 0.15);
    --dg-button-radius: 100px;
    --dg-consent-dropdown-color: transparent;
  }

  /* width */
  :host(.dg-consent-banner.dg-left),
  :host(.dg-consent-banner.dg-right) {
    width: 374px !important;
  }
  
  /* Glass blur on main container */
  :host(.dg-consent-banner) .dg-app {
    background: rgba(0, 0, 0, 0.35) !important;
    backdrop-filter: blur(20px) saturate(180%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
    border: 1px solid rgba(255, 255, 255, 0.1) !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
    border-radius: 16px !important;
    font-family: 'Hauora', sans-serif !important;
    padding: 16px !important;
    outline: none !important;
    max-width: 340px !important;
  }

  /* Remove focus outline from all elements */
  :host(.dg-consent-banner) .dg-app:focus,
  :host(.dg-consent-banner) .dg-app *:focus {
    outline: none !important;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3) !important;
  }

  /* All text - Hauora font, white, tight spacing */
  :host(.dg-consent-banner) .dg-app *,
  :host(.dg-consent-banner) .dg-main-content-explanation {
    color: rgba(255, 255, 255, 0.85) !important;
    font-family: 'Hauora', sans-serif !important;
    letter-spacing: -0.01em !important;
  }

  /* SVGs white */
  :host(.dg-consent-banner) .dg-app svg,
  :host(.dg-consent-banner) .dg-app svg * {
    fill: rgba(255, 255, 255, 0.7) !important;
  }

  /* Title */
  :host(.dg-consent-banner) .dg-text-title {
    color: #ffffff !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    margin-bottom: 6px !important;
  }

  /* Body/header text - smaller, tighter */
  :host(.dg-consent-banner) .dg-text-header {
    color: rgba(255, 255, 255, 0.65) !important;
    font-size: 11px !important;
    line-height: 1.4 !important;
    font-weight: 400 !important;
    margin-bottom: 8px !important;
  }

  /* Links */
  :host(.dg-consent-banner) .dg-link {
    color: rgba(255, 255, 255, 0.5) !important;
    font-size: 11px !important;
  }

  /* Reduce spacing on links container */
  :host(.dg-consent-banner) .dg-links {
    padding: 0 !important;
    margin-bottom: 8px !important;
    gap: 8px !important;
  }

  /* Buttons glass pill - tighter padding */
  :host(.dg-consent-banner) .dg-button {
    background: rgba(255, 255, 255, 0.1) !important;
    backdrop-filter: blur(10px) !important;
    -webkit-backdrop-filter: blur(10px) !important;
    border: 1px solid rgba(255, 255, 255, 0.15) !important;
    border-radius: 100px !important;
    color: #ffffff !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    padding: 8px 16px !important;
    margin-bottom: 4px !important;
    cursor: pointer !important;
    transition: all 0.25s ease !important;
    transform: translateY(0) !important;
  }

  :host(.dg-consent-banner) .dg-button:hover {
    background: rgba(255, 255, 255, 0.2) !important;
    border-color: rgba(255, 255, 255, 0.3) !important;
    transform: translateY(-1px) !important;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2) !important;
  }

  :host(.dg-consent-banner) .dg-button:active {
    transform: translateY(0) scale(0.98) !important;
    background: rgba(255, 255, 255, 0.12) !important;
  }

  /* Accept All brighter */
  :host(.dg-consent-banner) .dg-button.accept_all {
    background: rgba(255, 255, 255, 0.18) !important;
  }

  /* Language dropdown trigger - no background */
  :host(.dg-consent-banner) .language-dropdown-trigger {
    color: rgba(255, 255, 255, 0.7) !important;
    font-size: 11px !important;
    background: transparent !important;
