<script type="eb77ae47049bfeb333139241-text/javascript">
(function () {
  function init() {
    document.querySelectorAll('.nav_menu_link-small[data-w-tab]').forEach(function (link) {
      link.addEventListener('pointerdown', function (e) {
        if (e.button !== 0 || e.metaKey || e.ctrlKey) return;
        var href = link.getAttribute('data-href');
        if (href) window.location.href = href;
      });
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>


<script data-cfasync="false">
(function() {
  'use strict';
  
  const isDesktop = window.innerWidth >= 992;
  
  if (isDesktop) {
    document.documentElement.style.setProperty('--navbar-visible', '1');

    function initNavbar() {
      const navbar = document.querySelector('.navigation_container');
      const allDefaultLogos = document.querySelectorAll('.nav_logo_item:not(.signle_brand):not(.light)');
      const lightLogo = document.querySelector('.nav_logo_item.light');
      const singleBrand = document.querySelector('.signle_brand');
      const navItems = document.querySelectorAll('.nav_link, .nav_taggle');
      const christmasElements = document.querySelectorAll('.christmas, .christmashat');
      
      if (!navbar || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initNavbar, 5);
        return;
      }
      
      navbar.style.opacity = '1';
      navbar.style.visibility = 'visible';
      navbar.style.display = 'flex';

      allDefaultLogos.forEach(logo => { logo.style.display = 'none'; logo.style.opacity = '0'; logo.style.visibility = 'hidden'; });
      if (lightLogo) { lightLogo.style.display = 'none'; lightLogo.style.opacity = '0'; lightLogo.style.visibility = 'hidden'; }
      if (singleBrand) { singleBrand.style.display = 'none'; singleBrand.style.opacity = '0'; }
      christmasElements.forEach(el => { el.style.display = 'none'; el.style.opacity = '0'; });

      // ── State ──
      var isScrolled = false;
      var currentSection = null;
      var navHidden = false;
      var scrollTicking = false;
      var lastScroll = window.pageYOffset || 0;
      var dirAnchor = lastScroll;
      var lastDir = 0;
      var resetToken = 0;
      var HIDE_PX = 8;
      var PILL_ENTER = 50;
      var PILL_LEAVE = 50;

      // ── Helpers ──
      var navSections = [];
      var bodyNavMode = document.body.getAttribute('data-navbar') || null;
      function cacheNavSections() {
        navSections = Array.prototype.slice.call(document.querySelectorAll('[data-navbar]'));
        bodyNavMode = document.body.getAttribute('data-navbar') || null;
      }
      cacheNavSections();

      function getPageNavbarMode() {
        for (var i = 0; i < navSections.length; i++) {
          var r = navSections[i].getBoundingClientRect();
          if (r.top <= 100 && r.bottom > 100) return navSections[i].getAttribute('data-navbar');
        }
        if (navSections.length > 0) {
          var fr = navSections[0].getBoundingClientRect();
          if (fr.top <= 0 && fr.bottom > 0) return navSections[0].getAttribute('data-navbar');
        }
        return bodyNavMode;
      }

      function applyLogoForMode(mode) {
        if (mode === 'light') {
          if (lightLogo) { lightLogo.style.display = 'flex'; lightLogo.style.opacity = '1'; lightLogo.style.visibility = 'visible'; }
          allDefaultLogos.forEach(function(l) { l.style.display = 'none'; l.style.opacity = '0'; l.style.visibility = 'hidden'; });
        } else {
          if (lightLogo) { lightLogo.style.display = 'none'; lightLogo.style.opacity = '0'; lightLogo.style.visibility = 'hidden'; }
          allDefaultLogos.forEach(function(l) { l.style.display = 'flex'; l.style.opacity = '1'; l.style.visibility = 'visible'; });
        }
      }

      function applyTopState() {
        if (isScrolled) return;
        var m = getPageNavbarMode();
        navbar.classList.remove('is-light', 'is-dark');
        if (m === 'light' || m === 'dark') navbar.classList.add('is-' + m);
        
        applyLogoForMode(m);
      }

      function applyModeFromViewport() {
        if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.update();
        var m = getPageNavbarMode();
        navbar.classList.remove('is-light', 'is-dark');
        if (m === 'light' || m === 'dark') {
          currentSection = m;
          navbar.classList.add('is-' + m);
        } else {
          currentSection = null;
        }
       
        applyLogoForMode(m);
      }

      function clearNavInlineStyles() {
        gsap.set(navbar, { clearProps: 'backgroundColor,background,maxWidth,borderRadius,borderColor,boxShadow,transform' });
      }

      // ── Pill enter ──
      function enterPill() {
        resetToken++;
        isScrolled = true;
        navHidden = false;
        navbar.classList.add('is-scrolled');
        navbar.classList.remove('is-light', 'is-dark');

        gsap.to(navbar, {
          y: 0, backgroundColor: 'rgba(0,0,0,0.45)', maxWidth: '60rem', borderRadius: '100px', borderColor: 'rgba(255,255,255,0.08)',
          duration: 0.25, ease: 'power2.out', overwrite: 'auto'
        });

        allDefaultLogos.forEach(function(l) { gsap.to(l, { opacity: 0, duration: 0.2, overwrite: true, onComplete: function() { l.style.display = 'none'; l.style.visibility = 'hidden'; } }); });
        if (lightLogo) gsap.to(lightLogo, { opacity: 0, duration: 0.2, overwrite: true, onComplete: function() { lightLogo.style.display = 'none'; lightLogo.style.visibility = 'hidden'; } });

        if (singleBrand) {
          singleBrand.style.display = 'flex';
          singleBrand.style.visibility = 'visible';
          gsap.to(singleBrand, { opacity: 1, duration: 0.3, delay: 0.1, overwrite: true });
        }

        christmasElements.forEach(function(el) { el.style.display = 'block'; gsap.to(el, { opacity: 1, duration: 0.3, delay: 0.2, overwrite: true }); });
       
      }

      // ── Pill leave ──
      function leavePill() {
        resetToken++;
        var token = resetToken;
        isScrolled = false;
        navHidden = false;
        navbar.classList.remove('is-scrolled');

        gsap.to(navbar, {
          y: 0, backgroundColor: 'rgba(0,0,0,0)', maxWidth: '75rem', borderRadius: '0px', borderColor: 'rgba(255,255,255,0)',
          duration: 0.3, ease: 'power2.out', overwrite: 'auto',
          onComplete: function() {
            if (token !== resetToken) return;
            if (!navbar.classList.contains('is-scrolled')) clearNavInlineStyles();
          }
        });

        setTimeout(function() {
          if (token !== resetToken) return;
          if (!navbar.classList.contains('is-scrolled')) clearNavInlineStyles();
        }, 400);

        if (singleBrand) gsap.to(singleBrand, { opacity: 0, duration: 0.2, overwrite: true, onComplete: function() { singleBrand.style.display = 'none'; singleBrand.style.visibility = 'hidden'; } });
        christmasElements.forEach(function(el) { gsap.to(el, { opacity: 0, duration: 0.2, overwrite: true, onComplete: function() { el.style.display = 'none'; } }); });

        applyModeFromViewport();
        requestAnimationFrame(function() { requestAnimationFrame(applyModeFromViewport); });
      }

      // ── Initial state ──
      if (lastScroll > PILL_ENTER) {
        isScrolled = true;
        navbar.classList.add('is-scrolled');
        gsap.set(navbar, { y: 0, backgroundColor: 'rgba(0,0,0,0.45)', maxWidth: '60rem', borderRadius: '100px', borderColor: 'rgba(255,255,255,0.08)' });
        
        if (singleBrand) { singleBrand.style.display = 'flex'; singleBrand.style.opacity = '1'; }
        allDefaultLogos.forEach(function(l) { l.style.display = 'none'; l.style.visibility = 'hidden'; });
        if (lightLogo) { lightLogo.style.display = 'none'; lightLogo.style.visibility = 'hidden'; }
        christmasElements.forEach(function(el) { el.style.display = 'block'; el.style.opacity = '1'; });
      } else {
        applyTopState();
      }

      // ── Single scroll handler, RAF-gated ──
      function processScroll() {
        scrollTicking = false;
        var scroll = window.pageYOffset || window.scrollY || 0;
        var delta = scroll - lastScroll;
        var dir = delta > 0 ? 1 : delta < 0 ? -1 : lastDir;

        if (dir !== lastDir) { dirAnchor = lastScroll; lastDir = dir; }

        var travel = scroll - dirAnchor;

        // ── 1. Pill enter / leave ──
        if (scroll > PILL_ENTER && !isScrolled) enterPill();
        else if (scroll <= PILL_LEAVE && isScrolled) leavePill();

        // ── 2. Hide / show (only in pill mode, with threshold) ──
        if (isScrolled) {
          if (scroll <= 60) {
            if (navHidden) { navHidden = false; gsap.to(navbar, { y: 0, duration: 0.2, ease: 'power2.out', overwrite: 'auto' }); }
          } else if (travel > HIDE_PX && !navHidden) {
            navHidden = true;
            gsap.to(navbar, { y: -120, duration: 0.25, ease: 'power2.out', overwrite: 'auto' });
          } else if (travel < -HIDE_PX && navHidden) {
            navHidden = false;
            gsap.to(navbar, { y: 0, duration: 0.2, ease: 'power2.out', overwrite: 'auto' });
          }
        }

        lastScroll = scroll;
      }

      window.addEventListener('scroll', function() {
        if (!scrollTicking) { scrollTicking = true; requestAnimationFrame(processScroll); }
      }, { passive: true });

      // ── ScrollTrigger section-based nav mode ──
      ['light', 'dark'].forEach(function(mode) {
        document.querySelectorAll('[data-navbar="' + mode + '"]').forEach(function(section) {
          ScrollTrigger.create({
            trigger: section, start: 'top 100px', end: 'bottom 100px',
            onEnter: function()     { currentSection = mode; if (!isScrolled) { navbar.classList.add('is-' + mode); navbar.classList.remove('is-' + (mode === 'light' ? 'dark' : 'light')); applyLogoForMode(mode); } },
            onLeave: function()     { navbar.classList.remove('is-' + mode); currentSection = null; if (!isScrolled) { var n = getPageNavbarMode(); applyLogoForMode(n); } },
            onEnterBack: function() { currentSection = mode; if (!isScrolled) { navbar.classList.add('is-' + mode); navbar.classList.remove('is-' + (mode === 'light' ? 'dark' : 'light')); applyLogoForMode(mode); } },
            onLeaveBack: function() { navbar.classList.remove('is-' + mode); currentSection = null; if (!isScrolled) { var n = getPageNavbarMode(); applyLogoForMode(n); } }
          });
        });
      });

      function reapplyTopStateWhenReady() {
        cacheNavSections();
        if (!isScrolled && navbar) applyTopState();
      }
      if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', reapplyTopStateWhenReady); }
      else { setTimeout(reapplyTopStateWhenReady, 0); }
      window.addEventListener('load', function() {
        cacheNavSections();
        reapplyTopStateWhenReady();
        ScrollTrigger.refresh();
        setTimeout(function() { cacheNavSections(); reapplyTopStateWhenReady(); ScrollTrigger.refresh(); }, 150);
      });
    }
    
    initNavbar();

    // ========== UPDATED initHoverClick ==========
    function initHoverClick() {
      var menuLinks = document.querySelectorAll('.nav_menu_link_small');
      if (menuLinks.length === 0) { setTimeout(initHoverClick, 50); return; }

      const blurOverlay = document.createElement('div');
      blurOverlay.className = 'nav-blur-overlay';
      document.body.appendChild(blurOverlay);
      blurOverlay.style.cssText = 'display:block;position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:999;opacity:0;pointer-events:none;background-color:rgba(0,0,0,0.12);backdrop-filter:blur(6px) saturate(120%);-webkit-backdrop-filter:blur(6px) saturate(120%);transition:opacity 0.3s ease;';

      function showOverlay() { blurOverlay.style.opacity = '1'; blurOverlay.style.pointerEvents = 'auto'; }
      function hideOverlay() { blurOverlay.style.opacity = '0'; blurOverlay.style.pointerEvents = 'none'; }

      // Map data-w-tab values to URLs
      const tabUrlMap = {
        'Tab 1': '/solutions/trade',
        'Tab 2': '/solutions/transact',
        'Tab 3': '/solutions/tokenize'
      };

      let navigating = false;

      // Single document-level listener using data-w-tab attribute
      document.addEventListener('click', function(e) {
        if (navigating) return;
        const link = e.target.closest('.nav_menu_link_small');
        if (!link) return;
        const tab = link.getAttribute('data-w-tab');
        const url = tabUrlMap[tab];
        if (!url) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        window.location.href = url;
      }, true);

      menuLinks.forEach(link => {
        const parentItem = link.closest('.nav_item_dropdown');
        if (!parentItem) return;
        const hasBlurOverlay = parentItem.hasAttribute('blur-overlay');

        // Hover → Webflow tab switch only
        link.addEventListener('mouseenter', () => {
          navigating = true;
          link.click();
          navigating = false;
          if (hasBlurOverlay) showOverlay();
        });

        parentItem.addEventListener('mouseleave', () => {
          const isOpen = parentItem.querySelector('.w--open') !== null;
          if (isOpen) {
            navigating = true;
            link.click();
            navigating = false;
            const anyOpen = document.querySelector('[blur-overlay] .w--open');
            if (!anyOpen) hideOverlay();
          }
        });
      });

      blurOverlay.addEventListener('click', () => {
        menuLinks.forEach(link => {
          const parentItem = link.closest('.nav_item_dropdown');
          if (parentItem && parentItem.querySelector('.w--open')) {
            navigating = true;
            link.click();
            navigating = false;
          }
        });
        hideOverlay();
      });
    }
    initHoverClick();

  } else {
    // ========== MOBILE NAVBAR ==========
    window.addEventListener('scroll', function() {
      if (document.documentElement.classList.contains('zh-nav-open')) return;
      const navbar = document.querySelector('.navigation_container');
      if (!navbar) return;
      const currentScroll = window.pageYOffset || window.scrollY || 0;
      if (currentScroll > 50) {
        navbar.classList.add('is-scrolled-mobile');
      } else {
        navbar.classList.remove('is-scrolled-mobile');
      }
    }, { passive: true });

    const menuButton = document.querySelector('.nav_taggle, .w-nav-button, .menu-button');
    const navOverlay = document.querySelector('.w-nav-overlay');
    if (menuButton) {
      menuButton.addEventListener('click', () => {
        setTimeout(() => {
          const isMenuOpen = document.querySelector('.w--nav-menu-open') !== null;
          document.body.classList.toggle('menu-open', isMenuOpen);
        }, 50);
      });
    }
    if (navOverlay) {
      navOverlay.addEventListener('click', e => { if (e.target === navOverlay) document.body.classList.remove('menu-open'); });
    }
  }
  function whenGsapReady(fn, tries) {
    tries = tries || 0;
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      fn();
    } else if (tries < 500) { // ~2s at 10ms steps, tune as needed
      setTimeout(function () { whenGsapReady(fn, tries + 1); }, 10);
    } else {
      console.warn('GSAP failed to load in time; animations skipped.');
    }
  }
  // ========== DOM READY INTERACTIONS (Desktop Only) ==========
  document.addEventListener('DOMContentLoaded', () => {
    if (!isDesktop) return;
    (function() {
      const overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed;top:0;left:0;width:100vw;height:100vh;z-index:999;opacity:0;pointer-events:none;background:rgba(0,0,0,0.12);backdrop-filter:blur(6px) saturate(120%);-webkit-backdrop-filter:blur(6px) saturate(120%);transition:opacity 0.3s ease;';
      document.body.appendChild(overlay);
      document.querySelectorAll('[blur-overlay]').forEach(el => {
        el.addEventListener('mouseenter', () => { overlay.style.opacity = '1'; overlay.style.pointerEvents = 'auto'; });
        el.addEventListener('mouseleave', () => { overlay.style.opacity = '0'; overlay.style.pointerEvents = 'none'; });
      });
      overlay.addEventListener('click', () => { overlay.style.opacity = '0'; overlay.style.pointerEvents = 'none'; });
    })();

    whenGsapReady(() => {  

    document.querySelectorAll('[arrow-hover]').forEach(element => {
      const arrow = element.querySelector('.arrow_hide');
      if (!arrow) return;
      gsap.set(arrow, { opacity: 0, scale: 0.5 });
      let isHovering = false;
      element.addEventListener('mouseenter', () => { isHovering = true; gsap.to(arrow, { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(1.7)' }); });
      element.addEventListener('mouseleave', () => { isHovering = false; setTimeout(() => { if (!isHovering) gsap.to(arrow, { opacity: 0, scale: 0.5, duration: 0.3, ease: 'power2.in' }); }, 50); });
    });

    document.querySelectorAll('[card-hover]').forEach(card => {
      const solutionAnim = card.querySelector('.solution_animation');
      if (!solutionAnim) return;
      gsap.set(solutionAnim, { opacity: 0, scale: 0.5 });
      card.addEventListener('mouseenter', () => gsap.to(solutionAnim, { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(1.7)' }));
      card.addEventListener('mouseleave', () => gsap.to(solutionAnim, { opacity: 0, scale: 0.5, duration: 0.3, ease: 'power2.in' }));
    });

    document.querySelectorAll('[slide-left]').forEach(element => {
      const slideElement = element.querySelector('.slide_element');
      if (!slideElement) return;
      gsap.set(slideElement, { opacity: 0, x: 20 });
      let isHovering = false;
      element.addEventListener('mouseenter', () => { isHovering = true; gsap.to(slideElement, { opacity: 1, x: 0, duration: 0.25, ease: 'power2.out' }); });
      element.addEventListener('mouseleave', () => { isHovering = false; setTimeout(() => { if (!isHovering) gsap.to(slideElement, { opacity: 0, x: 20, duration: 0.2, ease: 'power2.in' }); }, 50); });
    });

    document.querySelectorAll('[slide-right]').forEach(element => {
      const slideElement = element.querySelector('.slide_element_right');
      if (!slideElement) return;
      gsap.set(slideElement, { opacity: 0, x: -20 });
      let isHovering = false;
      element.addEventListener('mouseenter', () => { isHovering = true; gsap.to(slideElement, { opacity: 1, x: 0, duration: 0.25, ease: 'power2.out' }); });
      element.addEventListener('mouseleave', () => { isHovering = false; setTimeout(() => { if (!isHovering) gsap.to(slideElement, { opacity: 0, x: -20, duration: 0.2, ease: 'power2.in' }); }, 50); });
    });
  

    const navItems = document.querySelectorAll('[data-dropdown="item"]');
    const dropdowns = document.querySelectorAll('[data-dropdown="menu"]');
    let currentIndex = null;
    let previousIndex = null;
    let isInNavigation = false;

    navItems.forEach((navItem, index) => {
      const trigger = navItem.querySelector('[data-dropdown="trigger"]');
      if (!trigger) return;
      navItem.addEventListener('mouseenter', () => {
        isInNavigation = true;
        previousIndex = currentIndex;
        currentIndex = index;
        if (isInNavigation && previousIndex !== null && previousIndex !== currentIndex) {
          const direction = currentIndex > previousIndex ? 'right' : 'left';
          const oldDropdown = dropdowns[previousIndex];
          const newDropdown = dropdowns[currentIndex];
          if (oldDropdown && newDropdown) {
            const slideAmount = 35;
            const slideOut = direction === 'right' ? -slideAmount : slideAmount;
            const slideIn = direction === 'right' ? slideAmount : -slideAmount;
            gsap.killTweensOf([oldDropdown, newDropdown]);
            const tl = gsap.timeline();
            tl.to(oldDropdown, { x: slideOut, opacity: 0, duration: 0.3, ease: 'power2.inOut' }, 0);
            tl.fromTo(newDropdown, { x: slideIn, opacity: 0 }, { x: 0, opacity: 1, duration: 0.3, ease: 'power2.out', onComplete: () => gsap.set(oldDropdown, { x: 0, opacity: 1 }) }, 0.05);
          }
        }
      });
      navItem.addEventListener('mouseleave', e => {
        const goingToAnother = e.relatedTarget?.closest('[data-dropdown="item"]');
        if (!goingToAnother) {
          isInNavigation = false; currentIndex = null; previousIndex = null;
          dropdowns.forEach(dropdown => gsap.set(dropdown, { x: 0, opacity: 1 }));
        }
      });
    });
})
    const tabLinks = document.querySelectorAll('[data-w-tab]:not(.nav_menu_link_small)');
    let hoverTimer;
    tabLinks.forEach(tab => {
      tab.addEventListener('mouseenter', () => { clearTimeout(hoverTimer); hoverTimer = setTimeout(() => tab.click(), 150); });
      tab.addEventListener('mouseleave', () => clearTimeout(hoverTimer));
    });

    function isLightBackground(element) {
      const bg = getComputedStyle(element).backgroundColor.match(/\d+/g);
      if (!bg || bg.length < 3) return false;
      return (0.299 * bg[0] + 0.587 * bg[1] + 0.114 * bg[2]) > 128;
    }
    function createRipple(e) {
      const el = e.currentTarget;
      const rect = el.getBoundingClientRect();
      if (isLightBackground(el)) el.setAttribute('data-light-bg', '');
      else el.removeAttribute('data-light-bg');
      const old = el.querySelector('.ripple-wave');
      if (old) old.remove();
      const ripple = document.createElement('span');
      ripple.className = 'ripple-wave';
      const x = (e.touches ? e.touches[0].clientX : e.clientX) - rect.left;
      const y = (e.touches ? e.touches[0].clientY : e.clientY) - rect.top;
      const size = Math.max(rect.width, rect.height) * 2.5;
      ripple.style.cssText = `width:${size}px;height:${size}px;left:${x-size/2}px;top:${y-size/2}px;`;
      el.appendChild(ripple);
      setTimeout(() => ripple.remove(), 800);
    }
    document.querySelectorAll('[ripple-effect]').forEach(el => {
      el.addEventListener('mousedown', createRipple);
      el.addEventListener('mouseenter', createRipple);
      el.addEventListener('touchstart', createRipple);
    });

    const menuItems = document.querySelectorAll('[data-solution]');
    const contentItems = document.querySelectorAll('[data-content]');
    const allLogos = document.querySelectorAll('[data-brand-name]');

    function showLogos(brandList) {
      if (!brandList) { allLogos.forEach(logo => logo.style.display = 'block'); return; }
      const brands = brandList.toLowerCase().split(',').map(b => b.trim());
      allLogos.forEach(logo => {
        const brandName = logo.getAttribute('data-brand-name').toLowerCase();
        logo.style.display = brands.includes(brandName) ? 'block' : 'none';
      });
    }

    if (contentItems.length > 0) {
      contentItems[0].style.display = 'block';
      menuItems[0].classList.add('is-active');
      showLogos(menuItems[0].getAttribute('data-brands'));
    }

    menuItems.forEach(item => {
      item.addEventListener('mouseenter', function() {
        const solutionId = this.getAttribute('data-solution');
        const brandList = this.getAttribute('data-brands');
        contentItems.forEach(content => content.style.display = 'none');
        menuItems.forEach(menu => menu.classList.remove('is-active'));
        const targetContent = document.querySelector(`[data-content="${solutionId}"]`);
        if (targetContent) targetContent.style.display = 'block';
        showLogos(brandList);
        this.classList.add('is-active');
      });
    });
  });
})();
</script>


<!-- zh-mobile-burger-ux:start -->
<!--
  Mobile nav menu button UX (m05)
  ================================
  WHY: Navbar embed CSS had a stray `}` before this @media, so browsers
  discarded the whole burger block — hit target stayed ~28×21.

  Ship as its OWN <style> (site Footer custom code OR separate Navbar embed).
  Do NOT paste after another unfinished CSS block.
-->
<style id="zh-mobile-burger-ux">
@media screen and (max-width: 991px) {

  /* —— CLOSED: ≥44×44 tap target + press feedback —— */
  .navbar2_menu-button.w-nav-button:not(.w--open) {
    position: relative !important;
    width: auto !important;
    height: auto !important;
    min-width: 44px !important;
    min-height: 44px !important;
    padding: 8px !important;
    margin: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    box-sizing: border-box !important;
    cursor: pointer !important;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    overflow: visible !important;
    z-index: 5 !important;
    transition: transform 0.12s ease, opacity 0.12s ease;
  }

  .navbar2_menu-button.w-nav-button:not(.w--open)::before {
    content: "" !important;
    position: absolute !important;
    inset: -6px !important;
    z-index: 1 !important;
  }

  .navbar2_menu-button.w-nav-button:not(.w--open):active {
    transform: scale(0.92);
    opacity: 0.85;
  }

  .navbar2_menu-button:not(.w--open) .menu_buttom,
  .navbar2_menu-button:not(.w--open) [class*="menu-icon2"] {
    position: relative !important;
    z-index: 2 !important;
    width: 22px !important;
    max-width: 22px !important;
    pointer-events: none;
  }

  .navbar2_menu-button:not(.w--open) .menu-icon2_line-top,
  .navbar2_menu-button:not(.w--open) .menu-icon2_line-middle,
  .navbar2_menu-button:not(.w--open) .menu-icon2_line-bottom {
    height: 2.5px !important;
    border-radius: 2px !important;
    pointer-events: none;
  }

  /* —— OPEN X: leave Webflow animation alone —— */
  .navbar2_menu-button.w-nav-button.w--open {
    width: auto !important;
    height: auto !important;
    min-width: 44px !important;
    min-height: 44px !important;
    padding: 8px !important;
    margin: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer !important;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    z-index: 5 !important;
    transition: transform 0.12s ease, opacity 0.12s ease;
  }

  .navbar2_menu-button.w-nav-button.w--open::before {
    content: "" !important;
    position: absolute !important;
    inset: -6px !important;
    z-index: 1 !important;
  }

  .navbar2_menu-button.w-nav-button.w--open:active {
    transform: scale(0.92);
    opacity: 0.85;
  }

  .navbar2_button-wrapper {
    gap: 16px !important;
    align-items: center !important;
  }

  /* Open: pin header, solid menu, lock page scroll */
  html.zh-nav-open .navigation.navbar.w-nav,
  html.zh-nav-open .navigation.navbar {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    width: 100% !important;
    height: 56px !important;
    min-height: 56px !important;
    margin: 0 !important;
    padding: 0 !important;
    z-index: 1001 !important;
    background-color: #070a08 !important;
    overflow: visible !important;
  }

  html.zh-nav-open .navbaer_home,
  html.zh-nav-open .navigation_container {
    position: relative !important;
    z-index: 2 !important;
    background-color: #070a08 !important;
  }

  html.zh-nav-open .navbar2_button-wrapper .buttom_arrow.mobile-only,
  html.zh-nav-open .navbar2_button-wrapper a.buttom_arrow {
    color: #85f382 !important;
  }

  html.zh-nav-open .w-nav-overlay {
    position: fixed !important;
