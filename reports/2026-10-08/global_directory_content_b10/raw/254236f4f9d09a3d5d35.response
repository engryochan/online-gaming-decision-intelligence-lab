    background-color: #143720 !important;
  }

  /* White hamburger when scrolled */
  .navigation_container.is-scrolled-mobile .menu-icon2_line-top,
  .navigation_container.is-scrolled-mobile .menu-icon2_line-middle,
  .navigation_container.is-scrolled-mobile .menu-icon2_line-bottom {
    background-color: #ffffff !important;
  }

  /* Dark color for menu-link-copy when data-navbar="light" on mobile */
  body[data-navbar="light"] .nav_link.menu-link-copy {
    color: #143720 !important;
  }

  .navigation_container:not(.is-scrolled-mobile) .signle_brand {
    display: none !important;
    opacity: 0 !important;
  }
  .navigation_container.is-scrolled-mobile .nav_logo_item:not(.signle_brand) {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
  }
  .navigation_container.is-scrolled-mobile .signle_brand {
    display: flex !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  .navigation_container:not(.is-scrolled-mobile) .christmas,
  .navigation_container:not(.is-scrolled-mobile) .christmashat {
    display: none !important;
    opacity: 0 !important;
  }
  .navigation_container.is-scrolled-mobile .christmas,
  .navigation_container.is-scrolled-mobile .christmashat {
    display: block !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  body.menu-open {
    overflow: hidden !important;
