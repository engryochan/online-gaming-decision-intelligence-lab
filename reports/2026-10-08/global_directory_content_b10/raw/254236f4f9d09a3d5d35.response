  }

  /* Chevron icons in policy options */
  :host(.dg-consent-banner) .dg-main-content-policy-option svg,
  :host(.dg-consent-banner) .dg-main-content-policy-option svg * {
    fill: rgba(255, 255, 255, 0.5) !important;
  }
</style>


<script type="eb77ae47049bfeb333139241-text/javascript">
(function () {
  function updateSwitcherUI() {
    var region = sessionStorage.getItem('userRegion') || 'global';
    var label = document.getElementById('region-label');
    var flag = document.getElementById('region-flag');
    var checkGlobal = document.getElementById('check-global');
    var checkEU = document.getElementById('check-eu');
    if (region === 'eu') {
      if (label) label.textContent = 'Europe (EU)';
      if (flag) flag.textContent = '🇪🇺';
      if (checkGlobal) checkGlobal.style.display = 'none';
      if (checkEU) checkEU.style.display = 'inline';
    } else {
      if (label) label.textContent = 'Global';
      if (flag) flag.textContent = '🌎';
      if (checkGlobal) checkGlobal.style.display = 'inline';
      if (checkEU) checkEU.style.display = 'none';
    }
  }

  updateSwitcherUI();
  var attempts = 0;
  var poll = setInterval(function () {
    updateSwitcherUI();
    if (++attempts >= 10) clearInterval(poll);
  }, 150);

  window.toggleRegionDropdown = function () {
    var dropdown = document.getElementById('region-dropdown');
    var chevron = document.getElementById('region-chevron');
    var isOpen = dropdown.classList.contains('open');
    if (isOpen) {
      dropdown.classList.remove('open');
      chevron.style.transform = 'rotate(0deg)';
    } else {
      dropdown.classList.add('open');
      chevron.style.transform = 'rotate(180deg)';
    }
  };

window.switchRegion = function (region) {
    sessionStorage.setItem('userRegion', region);
    sessionStorage.setItem('userChose', 'true');
    var path = window.location.pathname;

    if (region === 'eu') {
      if (path === '/' || path === '') {
        // On global home → go to EU home
        window.location.replace('/eu');
      } else if (path.startsWith('/eu')) {
        // Already on EU, just reload
        window.location.reload();
      } else {
        // On any other page (CMS, products, etc) → just reload, sessionStorage handles region display
        window.location.reload();
      }
    } else {
      if (path === '/eu' || path === '/eu/') {
        // On EU home → go to global home
        window.location.replace('/');
      } else if (path.startsWith('/eu/')) {
        // On an /eu/ subpage → strip prefix
        window.location.replace(path.replace(/^\/eu/, ''));
      } else {
        // On any other page → just reload
        window.location.reload();
      }
    }

    document.getElementById('region-dropdown').classList.remove('open');
  };


  document.addEventListener('click', function (e) {
    var switcher = document.getElementById('region-switcher');
    if (switcher && !switcher.contains(e.target)) {
      var dropdown = document.getElementById('region-dropdown');
      var chevron = document.getElementById('region-chevron');
      if (dropdown) dropdown.classList.remove('open');
      if (chevron) chevron.style.transform = 'rotate(0deg)';
    }
  });
})();
</script>




