 (hover:none){.zh-cs-cta-icon{opacity:1;margin-left:0!important;transform:none}}.zh-cs-cta-icon .w-embed{display:flex;width:1.15rem;height:1.15rem;align-items:center;justify-content:center}.zh-cs-cta-icon svg.zh-cs-arrow{display:block;width:1.15rem;height:1.15rem}</style><svg class='zh-cs-arrow' viewBox='0 0 27 27' fill='none' aria-hidden='true'><path d='M19.6625 16.3861V6.55469H9.83107' stroke='#111111' stroke-width='1.83521' stroke-linecap='round' stroke-linejoin='round'/><path d='M6.8276 19.3916L18.5707 7.64844' stroke='#111111' stroke-width='1.83521' stroke-linecap='round' stroke-linejoin='round'/></svg></div></div></a></div></div></div></div><div role="listitem" class="swiper-slide zh-cs-slide w-dyn-item"><div class="testimonial_card zh-cs-figma"><div class="zh-cs-logo-panel"><img alt="Erik Schluter" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce877a2177a5ee9f9fe321_Interactive%20Brokers.png" class="tesimonial_image zh-cs-logo"/></div><div class="testimonial_text zh-cs-copy"><div class="div-block-19"><div class="button-group"><p class="chip_lab margin-bottom margin-small grey">Interactive Brokers</p></div><p class="text-size-regular zh-cs-body">“Investment returns are not just about picking the right trades. They are influenced by the costs you pay, the prices you get, and how efficiently your capital is put to work. When investors pay less in fees and trade with efficient execution, those advantages add up and compound over time.”
</p></div><div class="flex-b left"><div class="flex-small center small"><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce8d7cc2b4b1013287e932_Thomas%20Pefferty.png" alt="" sizes="(max-width: 991px) 100vw, 1175px" srcset="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce8d7cc2b4b1013287e932_Thomas%20Pefferty-p-500.png 500w, https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce8d7cc2b4b1013287e932_Thomas%20Pefferty.png 626w" class="icon_arrow ruonder"/><div><div class="text-weight-bold">Thomas Pefferty</div><div class="text-size-small text-color-gery">Founder and Chairman of Interactive Brokers</div></div></div><a aria-label="Read Lossdog case study" href="/case-studies/interactive-brokers-transact" class="zh-cs-cta w-inline-block"><div class="zh-cs-cta-pill">READ CASE STUDY</div><div class="zh-cs-cta-icon"><div class="w-embed w-script"><script type="eb77ae47049bfeb333139241-text/javascript"> (function(){ if(window.__zhCsLinkFix) return; window.__zhCsLinkFix=1; var map={ 'tom-sosnoff':'/case-studies/lossdog', 'manuel-godoy':'/case-studies/felix-pago', 'job-van-der-voort':'/case-studies/remote', 'joel-ippoliti':'/case-studies/republic', 'john-wang':'/case-studies/kalshi', 'john-tullis':'/case-studies/gusto', 'thomas-peterffy':'/case-studies/interactive-brokers-transact', 'anam-lakhani':'/case-studies/alinea-invest', 'stephen-sikes':'/case-studies/public', 'steve-sanders':'/case-studies/interactive-brokers-trading', 'milan-galik':'/case-studies/interactive-brokers-trading', 'fliex':'/case-studies/felix-pago', 'moneylion':'/case-studies/moneylion-2', 'kalshi':'/case-studies/kalshi' }; function fix(){ var links=document.querySelectorAll('a.zh-cs-cta'); for(var i=0;i<links.length;i++){ var a=links[i]; var href=a.getAttribute('href')||''; var parts=href.split('/').filter(function(p){return p}); var slug=parts.length?parts[parts.length-1]:''; var next=map[slug]; if(!next) continue; if(a.getAttribute('href')!==