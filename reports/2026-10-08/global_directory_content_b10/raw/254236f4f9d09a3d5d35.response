<style>
  /* FAQ X */
  .section_faqs .accordion-item-title {
    cursor: pointer;
    gap: 1rem;
    align-items: center;
  }

  .section_faqs .accordion-item-icon {
    cursor: pointer !important;
    flex: 0 0 auto !important;
    flex-shrink: 0 !important;
    width: 28px !important;
    height: 28px !important;
    max-height: none !important;
    /* larger tap target without shifting layout much */
    padding: 8px;
    margin: -8px;
    box-sizing: content-box;
    display: inline-flex !important;
    align-items: center;
    justify-content: center;
    color: #143720;
    position: relative;
    z-index: 2;
    pointer-events: auto !important;
  }

  .section_faqs .accordion-item-icon svg {
    width: 28px;
    height: 28px;
    display: block;
    overflow: visible;
  }

  /* Force visible × / + on light FAQ cards */
  .section_faqs .accordion-item-icon svg path {
    stroke: #143720 !important;
    stroke-width: 2 !important;
  }
</style>
<script type="eb77ae47049bfeb333139241-text/javascript">
(function () {
  'use strict';

  function paintStrokes() {
    document.querySelectorAll('.section_faqs .accordion-item-icon svg path').forEach(function (path) {
      path.setAttribute('stroke', '#143720');
      path.style.stroke = '#143720';
    });
  }

  function ensureTitleA11y() {
    document.querySelectorAll('.section_faqs .accordion-item-title').forEach(function (title) {
      if (!title.hasAttribute('role')) title.setAttribute('role', 'button');
      if (!title.hasAttribute('tabindex')) title.setAttribute('tabindex', '0');
    });
  }

  function boot() {
    paintStrokes();
    ensureTitleA11y();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
  window.addEventListener('load', boot);

  // CMS / IX may re-inject SVG — keep stroke dark
  var n = 0;
  var t = setInterval(function () {
    paintStrokes();
    if (++n >= 20) clearInterval(t);
  }, 200);

  if (typeof MutationObserver !== 'undefined') {
    document.addEventListener('DOMContentLoaded', function () {
      var section = document.querySelector('.section_faqs');
      if (!section) return;
      var timer = null;
      new MutationObserver(function () {
        clearTimeout(timer);
        timer = setTimeout(paintStrokes, 50);
      }).observe(section, { childList: true, subtree: true });
    });
  }
})();
</script>

<!--
  CMS Rich Text consistency (wo07 + c01 overlap)
  ─────────────────────────────────────────────
  Shared class on all these templates: .disclosures_richtext

  Paste ONCE into Site Settings → Custom Code → Head
  OR paste the same embed on each template near the RT:
    • Blog Posts Template
    • Presses Template
    • Resources Template
    • Whitepapers Template
    • Disclosures Template
    • Case studies Template

  Designer (recommended permanent):
  1. Select .disclosures_richtext on Blog template
  2. Style All H2 / H3 / Paragraph / Link / List / Blockquote / Image tags
  3. Sync those tag styles — this CSS keeps them consistent until then
-->
<style id="zh-cms-richtext">
  /* ========== Base article measure ========== */
  .disclosures_richtext.w-richtext,
  .disclosures_richtext {
    color: #5d5d5d;
    font-size: 1.125rem;          /* 18px */
    line-height: 1.7;
    font-weight: 500;
    max-width: 42rem;             /* ~readable measure */
    width: 100%;
  }

  /* ========== Paragraphs ========== */
  .disclosures_richtext p {
    margin: 0 0 1.25rem !important;
    color: #5d5d5d;
    font-size: inherit;
    line-height: 1.7;
    font-weight: 500;
  }

  .disclosures_richtext > :last-child {
    margin-bottom: 0 !important;
  }

  /* ========== Headings ========== */
  .disclosures_richtext h1,
  .disclosures_richtext h2,
  .disclosures_richtext h3,
  .disclosures_richtext h4,
  .disclosures_richtext h5,
  .disclosures_richtext h6 {
    color: #1c1c1c !important;
    font-weight: 600 !important;
    letter-spacing: -0.01em;
    line-height: 1.25 !important;
    margin: 2rem 0 0.85rem !important;
  }

  .disclosures_richtext h1 { font-size: clamp(1.75rem, 2.5vw, 2.25rem) !important; }
  .disclosures_richtext h2 { font-size: clamp(1.5rem, 2vw, 2rem) !important; }      /* ~32–36 */
  .disclosures_richtext h3 { font-size: clamp(1.25rem, 1.6vw, 1.5rem) !important; }  /* ~24 */
  .disclosures_richtext h4 { font-size: 1.125rem !important; }
  .disclosures_richtext h5,
  .disclosures_richtext h6 { font-size: 1rem !important; text-transform: none; }

  .disclosures_richtext > h1:first-child,
  .disclosures_richtext > h2:first-child,
  .disclosures_richtext > h3:first-child {
    margin-top: 0 !important;
  }

  /* ========== Links ========== */
  .disclosures_richtext a {
    color: #198f19 !important;           /* brand green already in use */
    font-weight: 600;
    text-decoration: underline !important;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: rgba(25, 143, 25, 0.45);
    transition: color 0.15s ease, text-decoration-color 0.15s ease;
  }

  .disclosures_richtext a:hover {
    color: #143720 !important;
    text-decoration-color: #143720;
  }

  .disclosures_richtext a:focus-visible {
    outline: 2px solid #85F382;
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ========== Lists ========== */
  .disclosures_richtext ul,
  .disclosures_richtext ol {
    margin: 0 0 1.35rem !important;
    padding-left: 1.35rem !important;
  }

  .disclosures_richtext li {
    margin: 0 0 0.55rem !important;
    color: #5d5d5d;
    line-height: 1.65;
    padding-left: 0.25rem;
  }

  .disclosures_richtext li:last-child {
    margin-bottom: 0 !important;
  }

  .disclosures_richtext ul { list-style-type: disc; }
  .disclosures_richtext ol { list-style-type: decimal; }

  .disclosures_richtext li > ul,
  .disclosures_richtext li > ol {
    margin-top: 0.45rem !important;
    margin-bottom: 0.25rem !important;
  }

  /* ========== Blockquote ========== */
  .disclosures_richtext blockquote {
    margin: 1.75rem 0 !important;
    padding: 1rem 0 1rem 1.25rem !important;
    border-left: 3px solid #85F382 !important;
    color: #1c1c1c !important;
    font-size: 1.2rem !important;
    font-weight: 500;
    line-height: 1.55 !important;
    background: transparent;
  }

  .disclosures_richtext blockquote p {
    margin-bottom: 0.5rem !important;
    color: inherit !important;
  }

  .disclosures_richtext blockquote p:last-child {
    margin-bottom: 0 !important;
  }

  /* ========== Figures / images ========== */
  .disclosures_richtext figure,
  .disclosures_richtext .w-richtext-figure-type-image {
    margin: 1.75rem 0 !important;
    max-width: 100%;
  }

  .disclosures_richtext img,
  .disclosures_richtext figure img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 12px;
  }

  .disclosures_richtext figcaption,
  .disclosures_richtext .w-richtext-figcaption {
    margin-top: 0.6rem !important;
    font-size: 0.875rem !important;
    line-height: 1.45 !important;
    color: #7a7a7a !important;
    font-weight: 500;
  }

  /* ========== Misc ========== */
  .disclosures_richtext hr {
    border: 0;
    border-top: 1px solid #e7e7e7;
    margin: 2rem 0 !important;
  }

  .disclosures_richtext strong,
  .disclosures_richtext b {
    color: #1c1c1c;
    font-weight: 700;
  }

  .disclosures_richtext em,
  .disclosures_richtext i {
    font-style: italic;
  }

  .disclosures_richtext code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
    background: #f4f4f4;
    padding: 0.1em 0.35em;
    border-radius: 4px;
  }

  .disclosures_richtext pre {
    margin: 1.5rem 0 !important;
    padding: 1rem 1.15rem !important;
    background: #0f1a14;
    color: #e8f5e9;
    border-radius: 12px;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .disclosures_richtext pre code {
    background: transparent;
    padding: 0;
    color: inherit;
  }

  /* Callout / key findings boxes sometimes pasted as nested divs */
  .disclosures_richtext .w-richtext-align-center {
    text-align: center;
  }

  /* ========== Mobile ========== */
  @media (max-width: 767px) {
    .disclosures_richtext.w-richtext,
    .disclosures_richtext {
      font-size: 1.0625rem; /* 17px */
      line-height: 1.65;
      max-width: 100%;
    }

    .disclosures_richtext h2 {
      font-size: 1.4rem !important;
      margin-top: 1.6rem !important;
    }

    .disclosures_richtext h3 {
      font-size: 1.2rem !important;
    }

    .disclosures_richtext p {
      margin-bottom: 1.1rem !important;
    }
  }
</style>

<script type="eb77ae47049bfeb333139241-text/javascript">
(function () {
  'use strict';
  // Light hygiene: empty href="#" in rich text → not pretend-links
  function scrub() {
    document.querySelectorAll('.disclosures_richtext a[href="#"], .disclosures_richtext a[href=""]').forEach(function (a) {
      a.setAttribute('role', 'text');
      a.style.cursor = 'text';
      a.style.textDecoration = 'none';
      a.addEventListener('click', function (e) { e.preventDefault(); });
    });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', scrub);
  else scrub();
})();
</script>

