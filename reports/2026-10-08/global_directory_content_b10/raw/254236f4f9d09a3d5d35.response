    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.2) !important;
  }

  /* Hide ALL logos by default */
  .nav_logo_item:not(.signle_brand) {
