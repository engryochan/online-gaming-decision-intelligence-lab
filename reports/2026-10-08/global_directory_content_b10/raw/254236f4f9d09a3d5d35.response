  }

  /* Dark hamburger when data-navbar="light" and not scrolled */
  body[data-navbar="light"] .navigation_container:not(.is-scrolled-mobile) .menu-icon2_line-top,
  body[data-navbar="light"] .navigation_container:not(.is-scrolled-mobile) .menu-icon2_line-middle,
