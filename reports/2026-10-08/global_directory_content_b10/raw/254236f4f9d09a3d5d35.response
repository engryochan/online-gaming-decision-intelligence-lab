w-dyn-item"><div class="testimonial_card zh-cs-figma"><div class="zh-cs-logo-panel"><img alt="Erik Schluter" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce96a301f3a81ecd4ff2bb_Kalshi.svg" class="tesimonial_image zh-cs-logo"/></div><div class="testimonial_text zh-cs-copy"><div class="div-block-19"><div class="button-group"><p class="chip_lab margin-bottom margin-small grey">Kalshi</p></div><p class="text-size-regular zh-cs-body">“Blockchain technology is essential for unlocking the next phase of growth and innovation in prediction markets.” </p></div><div class="flex-b left"><div class="flex-small center small"><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce969444d6f60b25ece0e7_John%20Wang.png" alt="" sizes="(max-width: 991px) 100vw, 1175px" srcset="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce969444d6f60b25ece0e7_John%20Wang-p-500.png 500w, https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce969444d6f60b25ece0e7_John%20Wang.png 626w" class="icon_arrow ruonder"/><div><div class="text-weight-bold">John Wang</div><div class="text-size-small text-color-gery">Head of Crypto</div></div></div><a aria-label="Read Lossdog case study" href="/case-studies/kalshi" class="zh-cs-cta w-inline-block"><div class="zh-cs-cta-pill">READ CASE STUDY</div><div class="zh-cs-cta-icon"><div class="w-embed w-script"><script type="eb77ae47049bfeb333139241-text/javascript"> (function(){ if(window.__zhCsLinkFix) return; window.__zhCsLinkFix=1; var map={ 'tom-sosnoff':'/case-studies/lossdog', 'manuel-godoy':'/case-studies/felix-pago', 'job-van-der-voort':'/case-studies/remote', 'joel-ippoliti':'/case-studies/republic', 'john-wang':'/case-studies/kalshi', 'john-tullis':'/case-studies/gusto', 'thomas-peterffy':'/case-studies/interactive-brokers-transact', 'anam-lakhani':'/case-studies/alinea-invest', 'stephen-sikes':'/case-studies/public', 'steve-sanders':'/case-studies/interactive-brokers