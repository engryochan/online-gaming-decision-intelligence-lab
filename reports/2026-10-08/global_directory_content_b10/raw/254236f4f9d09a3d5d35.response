    transition: background 0.2s ease !important;
    border-radius: 8px !important;
    margin: 2px 4px !important;
  }

  :host(.dg-consent-banner) .language-dropdown-menu-option:hover {
    background: rgba(255, 255, 255, 0.12) !important;
  }

  :host(.dg-consent-banner) .language-dropdown-menu-option:active {
    background: rgba(255, 255, 255, 0.08) !important;
  }

  :host(.dg-consent-banner) .language-dropdown-menu-option span {
    color: rgba(255, 255, 255, 0.8) !important;
  }

  :host(.dg-consent-banner) .language-dropdown-menu-option:hover span {
