<script type="eb77ae47049bfeb333139241-text/javascript">
(function(){
if(window.__zhNavMobAcc)return;window.__zhNavMobAcc=1;
function mob(){return window.matchMedia('(max-width:991px)').matches}
function closeDrop(d){
  var t=d.querySelector('.w-dropdown-toggle');
  var l=d.querySelector('.w-dropdown-list');
  d.classList.remove('w--open');
  if(t){t.classList.remove('w--open');t.setAttribute('aria-expanded','false')}
  if(l){l.classList.remove('w--open');l.style.display='none'}
  var $=window.jQuery;
  if($){var i=$(d).data('w-dropdown')||($(d).data()||{})['.wDropdown'];if(i){i.open=false;i.hovering=false}}
}
function drops(){return [].slice.call(document.querySelectorAll('.nav_menu_item .nav_item_dropdown.w-dropdown:not(.is-desktop)'))}
function bind(){
  if(!mob())return;
  drops().forEach(function(d){
    var t=d.querySelector('.w-dropdown-toggle');
    if(!t||t.dataset.zhAcc)return;
    t.dataset.zhAcc='1';
    t.addEventListener('click',function(){
      setTimeout(function(){
        if(!d.classList.contains('w--open'))return;
        drops().forEach(function(o){if(o!==d)closeDrop(o)});
      },0);
    });
  });
  document.querySelectorAll('.nav_menu_link-small[data-w-tab]').forEach(function(el){
    el.addEventListener('pointerdown',function(e){
      if(mob()){e.preventDefault();e.stopImmediatePropagation();}
    },true);
  });
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',bind);else bind();
})();
