)||light.currentSrc||'';if(!src||src.indexOf('placeholder')!==-1||src.indexOf('data:')===0)return;darkImg.parentNode.insertBefore(light,darkImg);});el.querySelectorAll('.zh-cgrid_next img.zh-cgrid_logo').forEach(function(img){img.classList.add('zh-cgrid_logo-light');img.classList.remove('zh-cgrid_logo-dark');});});</script><style>html body [data-zh-cgrid-theme=light] img.zh-cgrid_logo.zh-cgrid_logo-light{display:none!important}html body [data-zh-cgrid-theme=dark].zh-cgrid_section{background-color:var(--_colors-system---green-deep-2--deep-linear-1,#0d1710)!important}html body [data-zh-cgrid-theme=dark] img.zh-cgrid_logo.zh-cgrid_logo-dark{display:none!important}html body [data-zh-cgrid-theme=dark] .zh-cgrid_logo,html body [data-zh-cgrid-theme=dark] .zh-cgrid_face img,html body [data-zh-cgrid-theme=dark] .zh-cgrid_cell img.zh-cgrid_logo{width:min(var(--zh-logo-w),100%)!important;height:var(--zh-logo-h)!important;max-width:100%!important;margin:0 auto!important;object-fit:contain!important;object-position:center!important;filter:none!important;opacity:1!important;transform:none!important;-webkit-font-smoothing:antialiased;image-rendering:auto}html body [data-zh-cgrid-theme=dark] img.zh-cgrid_logo.zh-cgrid_logo-light{display:block!important;visibility:visible!important}html body [data-zh-cgrid-theme=dark] .zh-cgrid_cell.is-open .zh-cgrid_face:not(.zh-cgrid_next) img,html body [data-zh-cgrid-theme=dark] .zh-cgrid_cell.is-hoverable:hover .zh-cgrid_face:not(.zh-cgrid_next) img,html body [data-zh-cgrid-theme=dark] .zh-cgrid_cell.is-hoverable:focus-within .zh-cgrid_face:not(.zh-cgrid_next) img{opacity:0!important;filter:none!important;transform:none!important;transition:opacity 220ms ease!important}html body [data-zh-cgrid-theme=dark] .zh-cgrid_cell a.zh-cgrid_mcase,html body [data-zh-cgrid-theme=dark] a.zh-cgrid_mcase{color:var(--_colors-system---green--green-1,#85f382)!important}html body [data-zh-cgrid-theme=dark] .zh-cgrid_cta{background-color:var(--_colors-system---gree