tant;max-width:100%!important}.section_casestudies .blog_slider.zh-cs-view .testimonial_card.zh-cs-figma{grid-template-columns:1fr!important}}</style><script type="eb77ae47049bfeb333139241-text/javascript">function zhCsCards(){var cards=document.querySelectorAll('.section_casestudies .testimonial_card');for(var i=0;i<cards.length;i++){var chip=cards[i].querySelector('.chip_lab');if(chip&&!chip.textContent.trim()){chip.textContent='tastylive';chip.classList.remove('w-dyn-bind-empty');}var role=cards[i].querySelector('.text-color-gery');if(role&&role.textContent.indexOf('CEO of of')!==-1){role.textContent=role.textContent.replace('CEO of of','CEO of');}var body=cards[i].querySelector('.zh-cs-body');if(body){var t=body.textContent.trim();if(t&&t.charAt(0)!=='\u201c'&&t.charAt(0)!=='"'){body.textContent='\u201c'+t.replace(/[.\s]+$/,'')+'.\u201d';}}}}function zhCsBoot(){zhCsCards();if(typeof Swiper==='undefined')return;if(window.matchMedia('(max-width:991px)').matches)return;var nodes=document.querySelectorAll('.section_casestudies .blog_slider.zh-cs-view');for(var i=0;i<nodes.length;i++){var el=nodes[i];if(el.swiper&&el.swiper.params&&el.swiper.params.slidesPerView==='auto'&&!el.hasAttribute('data-zh-one')){el.swiper.params.resistanceRatio=0;el.swiper.update();continue;}var root=el.closest('section')||el.parentElement;var slides=el.querySelectorAll('.swiper-slide'),j,props=['width','max-width','flex-basis','margin-right','margin-left'];el.style.removeProperty('overflow');for(j=0;j<slides.length;j++){for(var p=0;p<props.length;p++)slides[j].style.removeProperty(props[p]);}if(el.swiper){try{el.swiper.destroy(true,true)}catch(e){}}el.removeAttribute('data-zh-one');new Swiper(el,{slidesPerView:'auto',spaceBetween:20,resistanceRatio:0,speed:550,watchOverflow:true,observer:true,observeParents:true,navigation:{nextEl:root.querySelector('.blog_button-next'),prevEl:root.querySelector('.blog_button-prev')}});}}document.addEventListener('DOMContentLoaded',zhCsBoot);window.addEvent