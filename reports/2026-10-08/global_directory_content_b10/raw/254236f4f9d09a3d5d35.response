(function(){
  if(window.__zhCgridMobileOwn) return;
  window.__zhCgridMobileOwn=1;
  var SHOWN=6, EVERY=2200, SLIDE=700, EASE="cubic-bezier(0.22,1,0.36,1)";
  var STUDY={alinea:"/case-studies/alinea-invest",felix:"/case-studies/felix-pago",kalshi:"/case-studies/kalshi",moneylion:"/case-studies/moneylion-2"};
  function mobile(){ return window.matchMedia("(max-width:767px)").matches }
  function still(){ return window.matchMedia("(prefers-reduced-motion: reduce)").matches }
  function headOwns(){ return !!window.__zhCgridMobileV34 }
  function tiles(){
    var root=document.querySelector("[data-zh-cgrid]");
    if(!root) return [];
    var grid=root.querySelector(".zh-cgrid.w-dyn-items")||root.querySelector(".w-dyn-items");
    return grid?[].slice.call(grid.children):[];
  }
  function ensure(tile){
    var img=tile.querySelector("img.zh-cgrid_logo")||tile.querySelector("img");
    if(!img) return null;
    var stage=tile.querySelector(".zh-cgrid_stage");
    var face=tile.querySelector(".zh-cgrid_face:not(.zh-cgrid_next)");
    if(!stage||!face){
      stage=document.createElement("div"); stage.className="zh-cgrid_stage";
      face=document.createElement("div"); face.className="zh-cgrid_face";
      img.parentNode.insertBefore(stage,img); face.appendChild(img); stage.appendChild(face);
    }
    var next=stage.querySelector(".zh-cgrid_next");
    if(!next){
      next=document.createElement("div"); next.className="zh-cgrid_face zh-cgrid_next";
      next.setAttribute("aria-hidden","true");
      var im=document.createElement("img"); im.className="zh-cgrid_logo"; im.alt=""; im.decoding="async";
      next.appendChild(im); stage.appendChild(next);
    }
    return {face:face, next:next};
  }
  function study(item,name){
    var pill=item.querySelector(".zh-cgrid_cta");
    var href=pill?(pill.getAttribute("href")||"").trim():"";
    if(href&&href!=="#") return href;
    var el=item.querySelector("[data-zh-study-slug]")||item.querySelector(".zh-cgrid_study-slug")||item.querySelector("span.zh-cgrid_hide");
    var slug=el?((el.getAttribute("data-zh-study-slug")||el.textContent||"").trim()):"";
    slug=slug.replace(/^\/+/,"").replace(/^case-studies\/+/i,"");
    if(slug&&slug!=="#"&&slug.toLowerCase()!=="null") return "/case-studies/"+slug;
    var key=(name||"").toLowerCase().replace(/[^a-z0-9]/g,"");
    return STUDY[key]||"";
  }
  function label(tile){
    var cell=tile.querySelector(".zh-cgrid_cell")||tile;
    var a=cell.querySelector(".zh-cgrid_mcase");
    if(!a){
