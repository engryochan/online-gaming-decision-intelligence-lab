    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* Show default dark logo when not scrolled */
  .navigation_container:not(.is-scrolled-mobile) .nav_logo_item:not(.signle_brand):not(.light) {
    display: flex !important;
    opacity: 1 !important;
    visibility: visible !important;
  }

  /* If data-navbar="light" → show light logo, hide default */
  body[data-navbar="light"] .navigation_container:not(.is-scrolled-mobile) .nav_logo_item:not(.signle_brand):not(.light) {
    display: none !important;
    opacity: 0 !important;
    visibility: hidden !important;
  }
  body[data-navbar="light"] .navigation_container:not(.is-scrolled-mobile) .nav_logo_item.light {
    display: flex !important;
