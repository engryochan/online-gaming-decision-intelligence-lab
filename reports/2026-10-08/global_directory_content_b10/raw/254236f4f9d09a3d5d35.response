<script type="eb77ae47049bfeb333139241-text/javascript">
(function () {
  if (window.__zhMobileNavScrollLock) return;
  window.__zhMobileNavScrollLock = true;

  var scrollY = 0;

  function mobile() {
    return window.matchMedia('(max-width: 991px)').matches;
  }

  function btn() {
    return document.querySelector('.navbar2_menu-button.w-nav-button, .w-nav-button');
  }

  function isOpen() {
    var b = btn();
    return !!(b && b.classList.contains('w--open'));
  }

  function freeze() {
    window.scrollTo(0, scrollY);
  }
  //helper 
  function applyScrolledLook(on) {
    var nav = document.querySelector('.navigation_container');
    if (nav) nav.classList.toggle('is-scrolled-mobile', on);
  }
  function lock() {
    if (document.documentElement.classList.contains('zh-nav-open')) return;
    scrollY = window.scrollY || window.pageYOffset || 0;
    var b = document.body;
    b.style.setProperty('top', '-' + scrollY + 'px', 'important');
    b.style.setProperty('position', 'fixed', 'important');
    b.style.setProperty('width', '100%', 'important');
    b.style.setProperty('left', '0', 'important');
    b.style.setProperty('right', '0', 'important');
    document.documentElement.classList.add('zh-nav-open');
    applyScrolledLook(true);
  }

  function unlock() {
    if (!document.documentElement.classList.contains('zh-nav-open')) return;
    var y = scrollY;
    document.documentElement.classList.remove('zh-nav-open');
    var b = document.body;
    b.style.removeProperty('top');
    b.style.removeProperty('position');
    b.style.removeProperty('width');
    b.style.removeProperty('left');
    b.style.removeProperty('right');
    window.scrollTo(0, y);
    applyScrolledLook(y > 50);
  }

  function sync() {
    if (mobile() && isOpen()) lock();
    else unlock();
  }

  function onMenuTap(e) {
    var t = e.target && e.target.closest && e.target.closest('.navbar2_menu-button, .w-nav-button');
    if (!t || !mobile()) return;
    // scrollY = window.scrollY || window.pageYOffset || 0; "M"
    if (!t.classList.contains('w--open')) lock();
    requestAnimationFrame(function () {
      freeze();
      sync();
    });
  }

  function bind() {
    var b = btn();
    if (b && !b.getAttribute('aria-label')) b.setAttribute('aria-label', 'Menu');
    if (b && window.MutationObserver) {
      new MutationObserver(sync).observe(b, { attributes: true, attributeFilter: ['class'] });
    }
    sync();
  }

  document.addEventListener('pointerdown', onMenuTap, true);
  document.addEventListener('click', onMenuTap, true);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bind);
  } else {
    bind();
  }

  window.addEventListener('resize', sync);
})();
</script>
