;width:1.15rem;height:1.15rem;align-items:center;justify-content:center}.zh-cs-cta-icon svg.zh-cs-arrow{display:block;width:1.15rem;height:1.15rem}</style><svg class='zh-cs-arrow' viewBox='0 0 27 27' fill='none' aria-hidden='true'><path d='M19.6625 16.3861V6.55469H9.83107' stroke='#111111' stroke-width='1.83521' stroke-linecap='round' stroke-linejoin='round'/><path d='M6.8276 19.3916L18.5707 7.64844' stroke='#111111' stroke-width='1.83521' stroke-linecap='round' stroke-linejoin='round'/></svg></div></div></a></div></div></div></div><div role="listitem" class="swiper-slide zh-cs-slide w-dyn-item"><div class="testimonial_card zh-cs-figma"><div class="zh-cs-logo-panel"><img alt="Erik Schluter" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/68cc7be7b9d5aee9c63da0e5_testaytrad.svg" class="tesimonial_image zh-cs-logo"/></div><div class="testimonial_text zh-cs-copy"><div class="div-block-19"><div class="button-group"><p class="chip_lab margin-bottom margin-small grey">tastylive</p></div><p class="text-size-regular zh-cs-body">“The demand from our clients for crypto and digital assets is huge. Innovators across payments, finTechs, trading platforms, brands and more turn to zerohash to seamlessly launch crypto and stablecoin products.”</p></div><div class="flex-b left"><div class="flex-small center small"><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/68c59606946d2fed8ac8bfed_a0b005c39423c0455292e9c3de2543f5-279x300.png" alt="" class="icon_arrow ruonder"/><div><div class="text-weight-bold">Tom Sosnoff</div><div class="text-size-small text-color-gery">CEO of tastylive</div></div></div></div></div></div></div><div role="listitem" class="swiper-slide zh-cs-slide w-dyn-item"><div class="testimonial_card zh-cs-figma"><div class="zh-cs-logo-panel"><img alt="Erik Schluter" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce8cc2ee10a87a23aeb874_moneylion.svg" class="tesimonial_image zh-cs-logo"/></div><div class="testimonial_text zh-cs-copy"><div class="div-block-19"><div class="button-group"><p class="chip_lab margin-bottom margin-small grey">MoneyLion</p></div><p class="text-size-regular zh-cs-body">“Through our partnership with zerohash, the MoneyLion crypto offering provides members an intuitive way to own digital currencies within seamless and secure environment.”
</p></div><div class="flex-b left"><div class="flex-small center small"><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce8cbc6739d3082951be2b_Dee%20Choubey.png" alt="" sizes="(max-width: 991px) 100vw, 1175px" srcset="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce8cbc6739d3082951be2b_Dee%20Choubey-p-500.png 500w, https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce8cbc6739d3082951be2b_Dee%20Choubey.png 626w" class="icon_arrow ruonder"/><div><div class="text-weight-bold">Dee Choubey</div><div class="text-size-small text-color-gery">Co-Founder &amp; CEO of MoneyLion</div></div></div><a aria-label="Read Lossdog case study" href="/case-studies/moneylion-2" class="zh-cs-cta w-inline-block"><div class="zh-cs-cta-pill">READ CASE STUDY</div><div class="zh-cs-cta-icon"><div class="w-embed w-script"><script type="eb77ae47049bfeb333139241-text/javascript"> (function(){ if(window.__zhCsLinkFix) return; window.__zhCsLinkFix=1; var map={ 'tom-sosnoff':'/case-studies/lossdog', 'manuel-godoy':'/case-studies/felix-pago', 'job-van-der-voort':'/case-studies/remote', 'joel-ippoliti':'/case-studies/republic', 'john-wang':'/case-studies/kalshi', 'john-tullis':'/case-studies/gusto', 'thomas-peterffy':'/case-studies/interactive-brokers-transact', 'anam-lakhani':'/case-studies/alinea-invest', 'stephen-sikes':'/case-studies/public', 'steve-sanders':'/case-studies/interactive-brokers-trading', 'milan-galik':'/case-studies/interactive-brokers-trading', 'fliex':'/case-studies/felix-pago', 'moneylion':'/case-studies/moneylion-2', 'kalshi':'/case-studies/kalshi' }; function fix(){ var links=document.querySelectorAll('a.zh-cs-cta'); for(var i=0;i<links.length;i++){ var a=links[i]; var href=a.getAttribute('href')||''; var parts=href.split('/').filter(function(p){return p}); var slug=parts.length?parts[parts.length-1]:''; var next=map[slug]; if(!next) continue; if(a.getAttribute('href')!==next) a.setAttribute('href', next); var slide=a.closest('.zh-cs-slide'); var chip=slide&&slide.querySelector('.chip_lab'); var name=chip?chip.textContent.trim():''; if(name) a.setAttribute('aria-label','Read '+name+' case study'); } } function boot(){ fix(); var lists=document.querySelectorAll('.zh-cs-view'); for(var i=0;i<lists.length;i++){ if(lists[i].__zhCsObs) continue; lists[i].__zhCsObs=1; new MutationObserver(fix).observe(lists[i],{childList:true,subtree:true}); } } if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', boot); else boot(); })(); </script> <style id='zh-cs-cta-hover'>.testimonial_card.zh-cs-figma .zh-cs-cta{opacity:1;pointer-events:auto;transform:none}.zh-cs-cta{gap:0!important;column-gap:0!important}.zh-cs-cta-pill{position:relative;z-index:2}.zh-cs-cta-icon{position:relative;z-index:1;width:3.25rem!important;min-width:3.25rem!important;max-width:3.25rem!important;height:3.25rem!important;opacity:0;overflow:hidden;margin-left:-3.25rem!important;transform:scale(.8);transform-origin:left center;pointer-events:none;transition:margin-left .5s cubic-bezier(.22,1,.36,1),opacity .4s ease,transform .5s cubic-bezier(.22,1,.36,1)!important}.zh-cs-cta:hover .zh-cs-cta-icon,.zh-cs-cta:focus-visible .zh-cs-cta-icon{opacity:1;margin-left:0!important;transform:scale(1)}@media (hover:none){.zh-cs-cta-icon{opacity:1;margin-left:0!important;transform:none}}.zh-cs-cta-icon .w-embed{display:flex;width:1.15rem;height:1.15rem;align-items:center;justify-content:center}.zh-cs-cta-icon svg.zh-cs-arrow{display:block;width:1.15rem;height:1.15rem}</style><svg class='zh-cs-arrow' viewBox='0 0 27 27' fill='none' aria-hidden='true'><path d='M19.6625 16.3861V6.55469H9.83107' stroke='#111111' stroke-width='1.83521' stroke-linecap='round' stroke-linejoin='round'/><path d='M6.8276 19.3916L18.5707 7.64844' stroke='#111111' stroke-width='1.83521' stroke-linecap='round' stroke-linejoin='round'/></svg></div></div></a></div></div></div></div></div></div></div></div><div class="hide-me w-embed w-sc