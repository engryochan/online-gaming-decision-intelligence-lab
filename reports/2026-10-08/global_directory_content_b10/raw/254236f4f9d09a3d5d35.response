</p></div><div class="flex-b left"><div class="flex-small center small"><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce875f28fb5abec6fe4947_Milan%20Galik.png" alt="" sizes="(max-width: 991px) 100vw, 1175px" srcset="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce875f28fb5abec6fe4947_Milan%20Galik-p-500.png 500w, https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce875f28fb5abec6fe4947_Milan%20Galik.png 626w" class="icon_arrow ruonder"/><div><div class="text-weight-bold">Milan Galik</div><div class="text-size-small text-color-gery">CEO</div></div></div><a aria-label="Read Lossdog case study" href="/case-studies/interactive-brokers-trading" class="zh-cs-cta w-inline-block"><div class="zh-cs-cta-pill">READ CASE STUDY</div><div class="zh-cs-cta-icon"><div class="w-embed w-script"><script type="eb77ae47049bfeb333139241-text/javascript"> (function(){ if(window.__zhCsLinkFix) return; window.__zhCsLinkFix=1; var map={ 'tom-sosnoff':'/case-studies/lossdog', 'manuel-godoy':'/case-studies/felix-pago', 'job-van-der-voort':'/case-studies/remote', 'joel-ippoliti':'/case-studies/republic', 'john-wang':'/case-studies/kalshi', 'john-tullis':'/case-studies/gusto', 'thomas-peterffy':'/case-studies/interactive-brokers-transact', 'anam-lakhani':'/case-studies/alinea-invest', 'stephen-sikes':'/case-studies/public', 'steve-sanders':'/case-studies/interactive-brokers-trading', 'milan-galik':'/case-studies/interactive-brokers-trading', 'fliex':'/case-studies/felix-pago', 'moneylion':'/case-studies/moneylion-2', 'kalshi':'/case-studies/kalshi' }; function fix(){ var links=document.querySelectorAll('a.zh-cs-cta'); for(var i=0;i<links.length;i++){ var a=links[i]; var href=a.getAttribute('href')||''; var parts=href.split('/').filter(function(p){return p}); var slug=parts.length?parts[parts.length-1]:''; var next=map[slug]; if(!next) continue; if(a.getAttribute('href')!==next) a.setAttribute('href', next); var slide=a.closest('