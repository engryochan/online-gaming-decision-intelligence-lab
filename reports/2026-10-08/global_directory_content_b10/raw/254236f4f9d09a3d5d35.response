ext-color-withe">My Privacy Choices</p></div></a></div><div class="flex-1 margin-bottom"><img alt="English" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/69aae464690c84df27584cee_SOC%201.svg" class="icon-1x1-medium"/><img alt="English" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/69aae464d1df66fe05b46a47_SOC%202.svg" class="icon-1x1-medium"/><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/69aae464801b8a8ebc7d5511_ISO.svg" alt="" class="icon-1x1-medium"/><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/69aae4f0a9b5abfdcd014ae8_Mask%20group.png" alt="" class="icon-1x1-medium"/><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/69aae464d0b026c72fca47ce_MICAR.svg" alt="" class="icon-1x1-medium"/><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd/69aae4645769965206a05840_DDRA.svg" alt="" class="icon-1x1-medium"/></div></div></div></div><div class="footer-last-block"><div class="footer-bottom-wrap"><div class="footer-bottom-wrap"><div class="footer-last-block none"><div class="flex-b"><div class="label small margin-bottom none">© all rights reserved, zerohash llc 2026. NMLS ID# 1699379</div></div></div></div></div></div><p class="text-size-small small-2 text-opcity-60 margin-bottom">In the United States, zerohash llc is a FinCen-registered Money Service Business and a regulated Money Transmitter that can operate in 51 U.S. jurisdictions. zerohash llc and its affiliate, zerohash liquidity services llc, are licensed to engage in virtual currency business activity by the New York State Department of Financial Services (visit the zerohash website <a target="_blank" href="https://docs.zerohash.com/page/new-york-bitlicense-risk-disclosure-and-complaint-procedure" class="link linkinder">here</a> for zerohash&#x27;s New York BitLicense Risk Disclosure and Complaint Procedure). In Canada, zerohash llc is registered as a Money Service Business with FINTRAC. For a complete list of zerohash llc’s and zerohash liquidity services llc’s licenses, visit the zerohash website <a target="_blank" href="https://docs.zerohash.com/page/faq" class="link linkinder">here</a>.<br/></p><div class="flex-1 _16 left"><a href="https://zerohash.com/disclosures/pricing-and-fees" data-region="eu" target="_blank" class="text-size-small small-2 text_small">Pricing and fees</a><a href="https://docs.zerohash.com/page/terms-of-service" target="_blank" class="text-size-small small-2 text_small">Terms and Conditions</a><a href="https://zerohash.zendesk.com/hc/en-us/articles/35651106443283-zerohash-Privacy-Policy" target="_blank" class="text-size-small small-2 text_small">Privacy Policy</a></div><div class="footer-last-block none"><div class="footer-bottom-wrap"><div class="footer-bottom-wrap"><div class="footer-last-block none"><div class="flex-b"></div></div></div></div></div></div></div><div data-poster-url="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd%2F69b433788e1dcc855a8f3788_260309_ZH_Footer_03_poster.0000000.jpg" data-video-urls="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd%2F69b433788e1dcc855a8f3788_260309_ZH_Footer_03_mp4.mp4,https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd%2F69b433788e1dcc855a8f3788_260309_ZH_Footer_03_webm.webm" data-autoplay="true" data-loop="true" data-wf-ignore="true" scroll-reveal-item="" class="earth_footer w-background-video w-background-video-atom"><video id="856a8b85-dba0-2414-76b4-4924527a733e-video" autoplay="" loop="" style="background-image:url(&quot;https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd%2F69b433788e1dcc855a8f3788_260309_ZH_Footer_03_poster.0000000.jpg&quot;)" muted="" playsinline="" data-wf-ignore="true" data-object-fit="cover"><source src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd%2F69b433788e1dcc855a8f3788_260309_ZH_Footer_03_mp4.mp4" data-wf-ignore="true"/><source src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bcbd%2F69b433788e1dcc855a8f3788_260309_ZH_Footer_03_webm.webm" data-wf-ignore="true"/></video></div></div><div class="footer_embeds"><div class="footer_code hide-me w-embed w-script"><!--
  Footer places spacing + mobile accordion fix (wo09)
  ====================================================
  Clash root cause: .menu-links-wrap stays height:0 while links
  still paint (overflow visible) → overlaps next accordion place.

  - Desktop: even gutters between 5 places, no column stretch
  - Mobile: 1-col accordion stack; height synced to content when open

  Paste: Site Settings → Custom Code → Footer (replace prior version)
-->
<style id="zh-footer-spacing">
  .footer_item_flex.footer_padding {
    --zh-place-gap: 24px;
    --zh-row-gap: 32px;
    --zh-link-gap: 12px;
  }

  .footer-halves {
    align-items: start !important;
    column-gap: var(--zh-place-gap) !important;
    row-gap: var(--zh-place-gap) !important;
    width: 100% !important;
  }

  .footer-right:not(.hide-me) {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    column-gap: var(--zh-place-gap) !important;
    row-gap: var(--zh-place-gap) !important;
    justify-content: stretch !important;
    align-items: start !important;
    width: 100% !important;
  }

  .footer-right:not(.hide-me) > .menu-divider {
    display: none !important;
  }

  /* places: no stretch / no extra pad — DESKTOP only for menu-links-wrap height
     (mobile accordion must own height:0 ↔ scrollHeight) */
  .footer-right:not(.hide-me) > .navigation-link-wrap,
  .footer-right:not(.hide-me) .menu-links-column.footer-column,
  .footer-right:not(.hide-me) .footer-column {
    width: 100% !important;
    max-width: none !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    margin: 0 !important;
    border-left: none !important;
  }

  @media (min-width: 992px) {
    .footer-right:not(.hide-me) > .navigation-link-wrap,
    .footer-right:not(.hide-me) .menu-links-wrap,
    .footer-right:not(.hide-me) .menu-links-column.footer-column,
    .footer-right:not(.hide-me) .footer-column {
      height: auto !important;
    }
  }

  .footer-right:not(.hide-me) .menu-links-column.footer-column {
    gap: 16px !important;
  }

  .footer-right:not(.hide-me) > .navigation-link-wrap.footer-column,
  .footer-right:not(.hide-me) > .navigation-link-wrap {
    padding-left: 0 !important;
    border-left: none !important;
  }

  .footer-right:not(.hide-me) .footer-links-column,
  .footer-right:not(.hide-me) .w-dyn-items {
    display: flex !important;
    flex-direction: column !important;
    gap: var(--zh-link-gap) !important;
  }

  .footer-right:not(.hide-me) .footer-link,
  .footer-right:not(.hide-me) a.footer-link {
    margin: 0 !important;
    padding: 0 !important;
    line-height: 1.4 !important;
  }

  .footer-right:not(.hide-me) .flex-small.footer-link {
    gap: 8px !important;
    align-items: center !important;
  }

  .footer-left {
    gap: 24px !important;
  }

  /* desktop only — remove flex/gap stack on mobile */
  @media (min-width: 992px) {
    .footer_item_flex.footer_padding > .container-large {
      display: flex !important;
      flex-direction: column !important;
      gap: var(--zh-row-gap) !important;
    }
  }

  .footer_item_flex.footer_padding > .container-large > .footer-halves,
  .footer_item_flex.footer_padding > .container-large > .footer-bottom-tile,
  .footer_item_flex.footer_padding > .container-large > .text-size-small {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  .footer-bottom-tile {
    display: flex !important;
    flex-direction: column !important;
    gap: var(--zh-row-gap) !important;
  }

  .footer-bottom-tile .footer-last-block {
    margin-bottom: 0 !important;
    gap: 16px !important;
    width: 100% !important;
  }

  .footer-bottom-tile .flex-b {
    align-items: center !important;
    width: 100% !important;
  }

  .footer-bottom-tile .flex-b .flex-small,
  .footer-bottom-tile .flex-b .flex-1 {
    align-items: center !important;
  }

  /* ---- MOBILE accordion: 1 place per row, no clash ---- */
  @media (max-width: 991px) {
    .footer_item_flex.footer_padding > .container-large > .text-size-small,
    .footer_item_flex.footer_padding .text-size-small.small-2 {
      text-align: left !important;
    }

    .footer_item_flex.footer_padding {
      --zh-row-gap: 24px;
      --zh-link-gap: 10px;
      --zh-acc-pad: 16px;
    }

    .footer-halves {
      display: flex !important;
      flex-direction: column !important;
      gap: 32px !important;
    }

    .footer-right:not(.hide-me) {
      display: flex !important;
      flex-direction: column !important;
      grid-template-columns: none !important;
      gap: 0 !important;
      width: 100% !important;
    }

    .footer-right:not(.hide-me) > .navigation-link-wrap {
      width: 100% !important;
      height: auto !important;
      border-top: 1px solid rgba(255, 255, 255, 0.1) !important;
      overflow: visible !important;
    }

    .footer-right:not(.hide-me) > .navigation-link-wrap:first-of-type {
      border-top: none !important;
    }

    .footer-right:not(.hide-me) .navigation-label-mobile {
      display: flex !important;
      align-items: center !important;
      justify-content: space-between !important;
      width: 100% !important;
      padding: var(--zh-acc-pad) 0 !important;
      margin: 0 !important;
      gap: 12px !important;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    /* CRITICAL: overflow hidden so height:0 actually clips (no clash).
       Height itself is owned by JS (0 ↔ scrollHeight px). */
    .footer-right:not(.hide-me) .menu-links-wrap {
      display: block !important;
      overflow: hidden !important;
      padding: 0 !important;
      margin: 0 !important;
      transition: height 0.28s ease;
    }

    .footer-right:not(.hide-me) .menu-links-column,
    .footer-right:not(.hide-me) .menu-links-column.footer-column {
      height: auto !important;
      padding-top: 0 !important;
      padding-bottom: var(--zh-acc-pad) !important;
      padding-left: 0 !important;
      gap: 12px !important;
    }

    .footer-right:not(.hide-me) .footer-links-column,
    .footer-right:not(.hide-me) .w-dyn-items {
      gap: var(--zh-link-gap) !important;
    }

    .footer-right:not(.hide-me) .menu-links-column > .label {
      display: none !important;
    }

    /* accordion + icons → primary green */
    .footer-right:not(.hide-me) .navigation-icon-line-vertical,
    .footer-right:not(.hide-me) .navigation-icon-line-vertical.light,
    .footer-right:not(.hide-me) .navigation-icon-line-horizontal,
    .footer-right:not(.hide-me) .navigation-icon-line-horizontal.ligh,
    .footer-right:not(.hide-me) .navigation-icon-line-horizontal.light {
      background-color: #85F382 !important;
      background: #85F382 !important;
    }

    /* + → − when open (hide vertical bar) */
    .footer-right:not(.hide-me) > .navigation-link-wrap.zh-acc-open .navigation-icon-line-vertical {
      opacity: 0 !important;
    }
  }

  @media (max-width: 767px) {
    .footer_item_flex.footer_padding {
      --zh-row-gap: 20px;
      --zh-acc-pad: 14px;
    }

    .footer-halves {
      gap: 28px !important;
    }

    .footer-bottom-tile .flex-b {
      flex-wrap: wrap !important;
      gap: 16px !important;
      justify-content: space-between !important;
    }
  }
</style>

<script type="eb77ae47049bfeb333139241-text/javascript">
(function () {
  var MQ = "(max-width: 991px)";

  function places() {
    return document.querySelectorAll(".footer-right:not(.hide-me) > .navigation-link-wrap");
  }

  function setClosed(wrap) {
    var menu = wrap.querySelector(".menu-links-wrap");
    if (!menu) return;
    wrap.classList.remove("zh-acc-open");
    menu.style.height = "0px";
    menu.style.overflow = "hidden";
  }

  function setOpen(wrap) {
    var menu = wrap.querySelector(".menu-links-wrap");
    if (!menu) return;
    wrap.classList.add("zh-acc-open");
    // measure full content, then lock px height so layout reserves space
    menu.style.height = "auto";
    var h = menu.scrollHeight;
    menu.style.height = "0px";
    // force reflow then expand
    void menu.offsetHeight;
    menu.style.height = h + "px";
    menu.style.overflow = "hidden";
  }

  function closeAll(except) {
    places().forEach(function (wrap) {
      if (wrap !== except) setClosed(wrap);
    });
  }

  function onLabelClick(e) {
    if (!window.matchMedia(MQ).matches) return;
    var label = e.currentTarget;
    var wrap = label.closest(".navigation-link-wrap");
    if (!wrap) return;
    e.preventDefault();
    e.stopPropagation();
    if (typeof e.stopImmediatePropagation === "function") e.stopImmediatePropagation();

    if (wrap.classList.contains("zh-acc-open")) {
      setClosed(wrap);
    } else {
      closeAll(wrap); // one open at a time — cleaner, no clash pile-up
      setOpen(wrap);
    }
  }

  function bind() {
    places().forEach(function (wrap) {
      var label = wrap.querySelector(".navigation-label-mobile");
      var menu = wrap.querySelector(".menu-links-wrap");
      if (!label || !menu) return;
      if (label.dataset.zhAccBound === "1") return;
      label.dataset.zhAccBound = "1";
      // capture = beat Webflow IX that leaves height:0 while open
      label.addEventListener("click", onLabelClick, true);
    });
  }

  function applyMode() {
    var mobile = window.matchMedia(MQ).matches;
    places().forEach(function (wrap) {
      var menu = wrap.querySelector(".menu-links-wrap");
      if (!menu) return;
      if (!mobile) {
        wrap.classList.remove("zh-acc-open");
        menu.style.height = "";
        menu.style.overflow = "";
      } else {
        setClosed(wrap);
      }
    });
  }

  // hygiene
  document.querySelectorAll(".zh-footer-dense").forEach(function (el) {
    el.classList.remove("zh-footer-dense");
  });
  document.querySelectorAll(".footer-right a.footer-link.hide:not([data-region])").forEach(function (a) {
    if (/disclosures/i.test(a.textContent || "")) a.remove();
  });

  function boot() {
    bind();
    applyMode();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
  window.addEventListener("load", boot);
  window.addEventListener("resize", function () {
    clearTimeout(window.__zhFooterAccResize);
    window.__zhFooterAccResize = setTimeout(applyMode, 100);
  });
})();
</script>
</div><div class="footer_pills_css w-embed"><style id="zh-footer-pills-fix">
