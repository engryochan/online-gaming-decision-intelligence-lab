ro pillars w-embed w-script">
<style>
  .videro_hero .us-wrapper,
  .us-wrapper {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
    background: transparent;
    display: block;
    object-fit: contain;
    object-position: center;
  }

  /* Fade/slide in once video is actually ready (not a blind 1s wait) */
  .videro_hero video.us-wrapper,
  video.us-wrapper.down_elemnt {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
    will-change: opacity, transform;
    background: transparent !important;
  }

  .videro_hero video.us-wrapper.is-ready,
  video.us-wrapper.down_elemnt.is-ready {
    opacity: 1;
    transform: translateY(0);
  }

  /* Legacy Unicorn Studio wrapper — keep if still used on some industries */
  .us-wrapper [data-us-project] {
    width: 100%;
    height: 100%;
    background: transparent !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .videro_hero video.us-wrapper,
    video.us-wrapper.down_elemnt {
      display: none !important;
    }
  }

  /* Mobile: hero video is decorative — don't paint/decode heavy frames */
  @media (max-width: 991px) {
    .videro_hero video.us-wrapper,
    video.backruond_overlap.us-wrapper {
      /* keep layout if parent depends on it, but JS will skip network */
      opacity: 0.35;
    }
  }
</style>

<!--
  preload="none" + no autoplay attr → won't fight LCP.
  type must match file (live assets are often .mp4 even if labeled webm).
  Keep your CMS binding.
-->
<video
  class="backruond_overlap z-index-1 us-wrapper down_elemnt"
  muted
  loop
  playsinline
  preload="none"
  disablePictureInPicture
  data-zh-industry-hero
>
  <source src="https://firebasestorage.googleapis.com/v0/b/unicorn-studio.appspot.com/o/mqpvozYjXYV2xi4AsyasBXBDt9I2%2F260609_Trading_01.mp4?alt=media&token=a0546f03-b59e-412c-b17d-32ecd17f01f6" type="video/mp4" />
</video>

<script type="eb77ae47049bfeb333139241-text/javascript">
(function () {
  'use strict';

  var video = document.querySelector('video[data-zh-industry-hero]') ||
    document.querySelector('.videro_hero video.us-wrapper') ||
    document.querySelector('video.backruond_overlap.us-wrapper');
  if (!video) return;

  var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var saveData = navigator.connection && navigator.connection.saveData;
  var isMobile = window.matchMedia('(max-width: 991px)').matches;

  function markReady() {
    video.classList.add('is-ready');
  }

  function nukeSources() {
    video.removeAttribute('autoplay');
    video.pause();
    video.removeAttribute('src');
    video.querySelectorAll('source').forEach(function (s) { s.removeAttribute('src'); });
    try { video.load(); } catch (e) {}
    video.style.display = 'none';
  }

  // Mobile / save-data / a11y: skip hero video download
  if (reduceMotion || saveData || isMobile) {
    nukeSources();
    return;
  }

  function playSafe() {
    video.muted = true;
    var p = video.play();
    if (p && typeof p.catch === 'function') {
      p.then(markReady).catch(function () {});
    } else {
      markReady();
    }
  }

  video.addEventListener('loadeddata', markReady, { once: true });

  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            if (video.preload === 'none') {
              video.preload = 'metadata';
              video.load();
            }
            playSafe();
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '100px 0px', threshold: 0.1 }
    );
    io.observe(video.closest('.videro_hero') || video.closest('.hero_have_section') || video);
  } else {
    video.preload = 'metadata';
    playSafe();
  }
})();
</script>

<!-- ========== OPTIONAL: Industry page hygiene (paste once on Industry template) ========== -->
<script id="zh-industry-page-opt" type="eb77ae47049bfeb333139241-text/javascript">
(function () {
  'use strict';
  if (window.__zhIndustryOpt) return;
  window.__zhIndustryOpt = true;

  if (!/^\/industries(\/|$)/i.test(location.pathname)) return;

  function ready(fn) {
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fn);
    else fn();
  }

  ready(function () {
    // 1) Hide homepage logo ticker leftovers
    document.querySelectorAll('.logo_carousel_wapper, .logo_carousal').forEach(function (el) {
      el.setAttribute('hidden', '');
      el.style.display = 'none';
    });

    // 2) Lazy below-fold images left as eager
    var vh = window.innerHeight || 800;
    document.querySelectorAll('img').forEach(function (img) {
      if (img.getBoundingClientRect().top > vh * 1.1) {
        img.loading = 'lazy';
        img.setAttribute('decoding', 'async');
        if (img.fetchPriority === 'high') img.fetchPriority = 'auto';
      }
    });

    // 3) Footer / below-fold videos: defer until near viewport
    document.querySelectorAll('video').forEach(function (v) {
      if (v.hasAttribute('data-zh-industry-hero') || v.classList.contains('us-wrapper')) return;
      if (v.getBoundingClientRect().top <= vh) return;

      v.preload = 'none';
      v.autoplay = false;
      v.pause();

      if (!('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            v.preload = 'metadata';
            v.muted = true;
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
            io.disconnect();
          });
        },
        { rootMargin: '200px 0px' }
      );
      io.observe(v);
    });

    // 4) Dedupe Swiper CDN if injected twice (keep first)
    var swipers = [...document.querySelectorAll('script[src*="swiper"]')];
    swipers.slice(1).forEach(function (s) { s.remove(); });
  });
})();
</script>
