<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js" type="eb77ae47049bfeb333139241-text/javascript"></script>

<script type="eb77ae47049bfeb333139241-text/javascript">
document.addEventListener("DOMContentLoaded", () => {
    var root = document.querySelector(".section-media_coverage");
    if (!root) return;
    var slider = root.querySelector(".blog_slider");
    if (!slider || slider.swiper) return;

    var swiper = new Swiper(slider, {
        slidesPerView: 3,
        spaceBetween: 20,
        breakpoints: {
            0: {
                slidesPerView: 1,
            },
            768: {
                slidesPerView: 2,
            },
            992: {
                slidesPerView: 3,
            }
        },
        navigation: {
            nextEl: root.querySelector(".blog_button-next"),
            prevEl: root.querySelector(".blog_button-prev"),
        },
    });

    let isDragging = false;

    root.querySelectorAll('.blog_slide').forEach(slide => {
        const link = slide.querySelector('.link_overlaping a');

        if (link) {
            slide.addEventListener('mousedown', () => {
                isDragging = false;
            });

            slide.addEventListener('mousemove', () => {
                isDragging = true;
            });

            slide.addEventListener('mouseup', () => {
                if (!isDragging) {
                    link.click();
                }
                isDragging = false;
            });
        }
    });
});

</script></div></div></div></div></section></main></div><footer class="footer_item-component drak padding-section-medium _12 section-2"><div class="padding-global"><div class="w-layout-blockcontainer container-large w-container"><div class="w-layout-grid row_tow margin-bottom center top"><div class="flex left aline"><div class="heading-style-h2 margin-bottom center">Start Building With<br/><span class="zero-font">zerohash</span></div><a data-wf--buttom--variant="light" class="cta-main w-variant-9d60eeed-1b36-e57d-bff0-754fc4db9657 ripple w-inline-block" data-wf-event-ids="" href="/contact" data-modal-open="" hero-animate="" ripple-effect="" data-livestream="" arrow-hover=""><div class="button-text-mask w-variant-9d60eeed-1b36-e57d-bff0-754fc4db9657"><div class="text_buttom w-variant-9d60eeed-1b36-e57d-bff0-754fc4db9657 _2-2">GET a demo</div></div></a></div><div id="w-node-_87e89926-5b85-865b-fcdb-be1af1c91cd9-527a7211" class="card_footer_col"><div><div data-dotted-glow="true" class="card_footer_row margin-bottom huge"><div class="icon-1x1-large w-embed"><svg viewBox="0 0 234 234" fill="none" xmlns="http://www.w3.org/2000/svg">
