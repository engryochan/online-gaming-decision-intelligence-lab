center;justify-content:center}.zh-cs-cta-icon svg.zh-cs-arrow{display:block;width:1.15rem;height:1.15rem}</style><svg class='zh-cs-arrow' viewBox='0 0 27 27' fill='none' aria-hidden='true'><path d='M19.6625 16.3861V6.55469H9.83107' stroke='#111111' stroke-width='1.83521' stroke-linecap='round' stroke-linejoin='round'/><path d='M6.8276 19.3916L18.5707 7.64844' stroke='#111111' stroke-width='1.83521' stroke-linecap='round' stroke-linejoin='round'/></svg></div></div></a></div></div></div></div><div role="listitem" class="swiper-slide zh-cs-slide w-dyn-item"><div class="testimonial_card zh-cs-figma"><div class="zh-cs-logo-panel"><img alt="Erik Schluter" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce9573ddc32d84b8bd12b8_worldpay.svg" class="tesimonial_image zh-cs-logo"/></div><div class="testimonial_text zh-cs-copy"><div class="div-block-19"><div class="button-group"><p class="chip_lab margin-bottom margin-small grey">Worldpay</p></div><p class="text-size-regular zh-cs-body">“We’ve found ways to embed stablecoins into our products in ways that add value for our merchants.” </p></div><div class="flex-b left"><div class="flex-small center small"><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce954cd7ed8efb6f05c7b6_Nabil%20Manji.png" alt="" sizes="(max-width: 991px) 100vw, 1175px" srcset="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce954cd7ed8efb6f05c7b6_Nabil%20Manji-p-500.png 500w, https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce954cd7ed8efb6f05c7b6_Nabil%20Manji.png 626w" class="icon_arrow ruonder"/><div><div class="text-weight-bold">Nabil Manji</div><div class="text-size-small text-color-gery">SVP, Head of Fintech Growth &amp; Financial Partnerships</div></div></div></div></div></div></div><div role="listitem" class="swiper-slide zh-cs-slide w-dyn-item"><div class="testimonial_card zh-cs-figma"><div class="zh-cs-logo-panel"><img alt="Erik Schluter" loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce900c5ba8e844c752aa5c_Gusto.svg" class="tesimonial_image zh-cs-logo"/></div><div class="testimonial_text zh-cs-copy"><div class="div-block-19"><div class="button-group"><p class="chip_lab margin-bottom margin-small grey">Gusto</p></div><p class="text-size-regular zh-cs-body">“Stablecoins offer us an opportunity to better serve our customer base. We do payout in over 70 countries today and this really gives us an opportunity to offer many of those customers who want payouts in U.S. dollar equivalent, or who want payouts of other digital assets in the future, to receive that. This gives us that extensibility to be able to pay out in those forms.”</p></div><div class="flex-b left"><div class="flex-small center small"><img loading="lazy" src="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce9010c9c723e84985780e_John%20Tullis.png" alt="" sizes="(max-width: 991px) 100vw, 1175px" srcset="https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce9010c9c723e84985780e_John%20Tullis-p-500.png 500w, https://cdn.prod.website-files.com/68c59605946d2fed8ac8bccb/69ce9010c9c723e84985780e_John%20Tullis.png 626w" class="icon_arrow ruonder"/><div><div class="text-weight-bold"> John Tullis</div><div class="text-size-small text-color-gery">Product Management, Gusto</div></div></div><a aria-label="Read Lossdog case study" href="/case-studies/gusto" class="zh-cs-cta w-inline-block"><div class="zh-cs-cta-pill">READ CASE STUDY</div><div class="zh-cs-cta-icon"><div class="w-embed w-script"><script type="eb77ae47049bfeb333139241-text/javascript"> (function(){ if(window.__zhCsLinkFix) return; window.__zhCsLinkFix=1; var map={ 'tom-sosnoff':'/case-studies/lossdog', 'manuel-godoy':'/case-studies/felix-pago', 'job-van-der-voort':'/case-studies/remote', 'joel-ippoliti':'/case-studies/republic', 'john-wang':'/case-studies/kalshi', 'john-tullis':'/case-studies/gusto', 'thomas-peterffy':'/case-studies/interact