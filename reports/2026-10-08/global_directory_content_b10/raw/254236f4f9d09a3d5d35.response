  }

  :host(.dg-consent-banner) .language-dropdown-menu-option svg,
  :host(.dg-consent-banner) .language-dropdown-menu-option svg * {
    fill: rgba(255, 255, 255, 0.8) !important;
  }

  /* Tighter header spacing */
  :host(.dg-consent-banner) .dg-header {
    margin-bottom: 4px !important;
    padding-bottom: 0 !important;
  }

  /* ===== Customize Choices Layer - Glass + Dark ===== */
  
  /* Policy categories container */
  :host(.dg-consent-banner) .dg-main-content-policies {
    background: transparent !important;
  }

  /* Each policy option row - no background */
  :host(.dg-consent-banner) .dg-main-content-policy-option {
    background: transparent !important;
    border: none !important;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;
  }

  /* Policy option heading */
  :host(.dg-consent-banner) .dg-main-content-policy-option-heading {
    color: #ffffff !important;
    background: transparent !important;
  }

  :host(.dg-consent-banner) .dg-main-content-policy-option-heading * {
    color: rgba(255, 255, 255, 0.9) !important;
    background: transparent !important;
  }

  /* Policy option description */
  :host(.dg-consent-banner) .dg-main-content-policy-option-description {
    color: rgba(255, 255, 255, 0.6) !important;
    background: transparent !important;
  }

  :host(.dg-consent-banner) .dg-main-content-policy-option-description * {
    color: rgba(255, 255, 255, 0.6) !important;
    background: transparent !important;
  }

  /* Slider toggle - CSS variables only, let DataGrail handle sizing */
  :host(.dg-consent-banner) {
    --dg-slider-enabled-primary: #85F382;
    --dg-slider-enabled-secondary: #ffffff;
    --dg-slider-primary: rgba(255, 255, 255, 0.25);
    --dg-slider-secondary: rgba(255, 255, 255, 0.8);
    --dg-policy-option-heading-enabled-color: #85F382;
    --dg-policy-option-essential-label-font-color: rgba(255, 255, 255, 0.5);
    --dg-policy-option-essential-label-font-size: 11px;
    --dg-option-info-background: transparent;
  }

  /* Slider input container - no background */
  :host(.dg-consent-banner) .dg-main-content-policy-option-input {
