<style>
/* Items with [scroll-reveal-item] reveal one by one, smooth and fast */
[scroll-reveal-item] {
  opacity: 0;
  transform: translateY(20px);
  will-change: opacity, transform;
}
[scroll-reveal-item].is-visible {
  opacity: 1;
  transform: translateY(0);
}
@media (min-width: 992px) {
  [scroll-reveal-item] {
    transition: opacity 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
}
@media (max-width: 991px) {
  [scroll-reveal-item] {
    opacity: 1;
    transform: none;
  }
}
</style>


<script type="eb77ae47049bfeb333139241-text/javascript">
(function() {
  function init() {
    if (window.innerWidth < 991) {
      document.querySelectorAll('[scroll-reveal-item]').forEach(el => {
        el.classList.add('is-visible');
        el.style.opacity = '1';
        el.style.transform = 'none';
      });
      return;
    }
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
      setTimeout(init, 50);
      return;
    }

    // Group by parent: each section that has [scroll-reveal-item] children
    const byParent = new Map();
    document.querySelectorAll('[scroll-reveal-item]').forEach(item => {
      const parent = item.parentElement;
      if (!byParent.has(parent)) byParent.set(parent, []);
      byParent.get(parent).push(item);
    });

    byParent.forEach((items, section) => {
      gsap.set(items, { opacity: 0, y: 20 });

      ScrollTrigger.create({
        trigger: section,
        start: 'top 85%',
        once: true,
        onEnter: () => {
          items.forEach(i => i.classList.add('is-visible'));
          gsap.to(items, {
            opacity: 1,
            y: 0,
            duration: 0.42,
            stagger: 0.12,
            ease: 'power3.out',
            overwrite: true
          });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>


<script type="eb77ae47049bfeb333139241-text/javascript">

// footer style
document.addEventListener('DOMContentLoaded', function () {

  document.querySelectorAll('[data-scroll-reveal]').forEach(function(el) {
    var delay = parseFloat(el.getAttribute('data-reveal-delay') || '0');
    var y     = parseFloat(el.getAttribute('data-reveal-y') || '60');
    var dur   = parseFloat(el.getAttribute('data-reveal-duration') || '1.1');
    var start = el.getAttribute('data-reveal-start') || 'top 88%';

    gsap.set(el, { opacity: 0, y: y });

    gsap.to(el, {
      opacity: 1,
      y: 0,
      duration: dur,
      delay: delay,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: el,
        start: start,
        toggleActions: 'play none none none'
      }
    });
  });
});
</script>
