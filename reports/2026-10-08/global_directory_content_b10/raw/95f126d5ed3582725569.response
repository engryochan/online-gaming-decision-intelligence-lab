              /* Paint a light canvas on the FIRST frame. globals.css carries the
                 same rule, but experimental.optimizeCss can defer it — without
                 this inline copy the browser shows its default (dark in a
                 dark-OS lab) canvas first, causing a black→white flash that
                 inflates Speed Index. ThemeScript flips these to dark inline
                 for users with the dark theme saved, so there is no flash. */
              html { background: #F7F9FF; color-scheme: light; }
              body { background: #F7F9FF; }
              html.dark { background: #00061A; color-scheme: dark; }
              html.dark body { background: #00061A; }
              body {
                font-family: var(--font-ibm-plex-sans), system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
