orage\n        function getTheme() {\n          // Try cookie first (matches server logic)\n          var cookies = document.cookie.split(';');\n          for (var i = 0; i \u003c cookies.length; i++) {\n            var cookie = cookies[i].trim();\n            if (cookie.startsWith('darkTheme=')) {\n              return cookie.substring('darkTheme='.length) === 'true';\n            }\n          }\n          \n          // Fallback to localStorage\n          var stored = localStorage.getItem('darkTheme');\n          if (stored !== null) {\n            return stored === 'true';\n          }\n          \n          // Fallback to server-provided theme\n          return false;\n        }\n        \n        // Apply theme classes immediately\n        var isDarkTheme = getTheme();\n        // Landing page is always light: avoid white text flash on refresh when user has dark theme saved\n        var pathname = typeof window !== 'undefined' ? (window.location.pathname || '').replace(/\\/$/, '') : '';\n        var isLanding = pathname === '' || pathname === '/' || (pathname.indexOf('/') === 0 \u0026\u0026 pathname.indexOf('/', 1) === -1);\n        if (isLanding) isDarkTheme = false;\n        var html = document.documentElement;\n\n        // Apply the theme marker to \u003chtml\u003e ONLY. This script runs inside \u003chead\u003e,\n        // before \u003cbody\u003e is parsed, so document.body is null here — any\n        // body.classList call would throw and abort the rest of this script\n        // (that was the source of the light-theme flash). Body classes are set\n        // post-hydration by updateDOMClasses; the CSS keys the pre-paint canvas\n        // off these \u003chtml\u003e markers, so setting them here is enough to prevent\n        // the flash. color-scheme-light / color-scheme-dark are the load-bearing\n        // markers the globals.css OS-fallback rules look for.\n        if (isDarkTheme) {\n          html.classList.add('dark', 'color-scheme-dark');\n          html.classList.remove('light', 'color-scheme-light');\n        } else {\n          html.classList.add('light', 'color-scheme-light');\n          html.classList.remove('dark', 'color-scheme-dark');\n        }\n\n        // Set CSS custom properties + inline background so the very first frame\n        // paints the correct canvas before any stylesheet loads. Colors match\n        // globals.css / the .color-scheme-* class rules exactly, so there is no\n        // repaint when the full CSS arrives.\n        html.style.setProperty('--background', isDarkTheme ? '#00061A' : '#F7F9FF');\n        html.style.setProperty('--foreground', isDarkTheme ? '#F7F9FF' : '#00061A');\n        html.style.setProperty('--nav-bg', isDarkTheme ? '#020202' : '#ffffff');\n        html.style.colorScheme = isDarkTheme ? 'dark' : 'light';\n        html.style.backgroundColor = isDarkTheme ? '#00061A' : '#F7F9FF';\n\n      } catch (e) {\n        // Silent fail - theme will be applied by React\n      }\n    })();\n  2:[\"$\",\"html\",null,{\"lang\":\"en\",\"className\":\"notranslate\",\"translate\":\"no\",\"suppressHydrationWarning\":true,\"children\":[[\"$\",\"head\",null,{\"children\":[[\"$\",\"meta\",null,{\"name\":\"google\",\"content\":\"notranslate\"}],[\"$\",\"meta\",null,{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1, viewport-fit=cover\"}],[\"$\",\"script\",null,{\"dangerouslySetInnerHTML\":{\"__html\":\"$1a\"},\"suppressHydrationWarning\":true}],\"$L1b\",\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",false,\"$L20\",\"$L21\"]}],\"$L22\"]}]\n24:I[752572,[\"/_next/static/chunks/2b3sj9yt2vymb.js\",\"/_next/static/chunks/3ptpzt2-_j87j.js\",\"/_next/static/chunks/3gitqisqv2wxj.js\",\"/_next/static/chunks/1km3sqkh10maa.js\",\"/_next/static/chunks/2l4qydplnk8z8.js\",\"/_next/static/chunks/3nvs_rkj6mhhz.js\",\"/_next/static/chunks/17-0h93q3t0lx.js\",\"/_next/static/chunks/0jr0qmxdmb0m3.js\",\"/_next/static/chunks/2yvopc-7bi7rz.js\",\"/_next/static/chunks/3i4mhpa-j_czl.js\",\"/_ne