    <div id="container-310aa13666" class="cmp-container">
        
        <div class="text table-scroll">
<div data-cmp-data-layer="{&#34;text-affc5a6823&#34;:{&#34;@type&#34;:&#34;sugeval/components/text&#34;,&#34;repo:modifyDate&#34;:&#34;2026-09-21T21:04:08Z&#34;,&#34;xdm:text&#34;:&#34;&lt;table border=\&#34;1\&#34; cellspacing=\&#34;0\&#34; cellpadding=\&#34;1\&#34;>\r\n&lt;tbody>&lt;tr>&lt;th>Norma&lt;/th>\r\n&lt;th>Contenido&lt;/th>\r\n&lt;th>Estados&lt;/th>\r\n&lt;th>Observaciones&lt;/th>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; target=\&#34;_blank\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-10-2026.docx\&#34; aria-label=\&#34;SGV-A-10-2026\&#34; title=\&#34;SGV-A-10-2026\&#34;>SGV-A-10-2026&lt;/a>&lt;/td>\r\n&lt;td>Ajuste al capital social suscrito y pagado de entidades supervisadas.&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>Rige a partir del 30 de junio del 2026.&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-4-2024.docx\&#34; target=\&#34;_blank\&#34; title=\&#34;SGV-A-4-2024\&#34; aria-label=\&#34;SGV-A-4-2024\&#34;>SGV-A-4-2024&lt;/a>&lt;/td>\r\n&lt;td>Lineamientos para el uso del Sistema “Team Mate+ Audit”&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&amp;nbsp;&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-272.docx\&#34; target=\&#34;_blank\&#34; title=\&#34;SGV-A-272\&#34; aria-label=\&#34;SGV-A-272\&#34;>SGV-A-272&lt;/a>&lt;/td>\r\n&lt;td>Lineamientos relacionados con la documentación en soporte físico a partir de la Declaración de la Cesación del Estado de Emergencia&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&amp;nbsp;&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-257texref.docx\&#34; title=\&#34;SGV-A-257\&#34; aria-label=\&#34;SGV-A-257\&#34; target=\&#34;_blank\&#34;>SGV-A-257&lt;/a>&lt;/td>\r\n&lt;td>Información básica de las entidades reguladas y supervisadas por la Superintendencia General de Valores.&amp;nbsp;&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&lt;p>Incluye las reformas del Acuerdo del Superintendente:&lt;/p>\r\n&lt;ul>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-264.docx\&#34; title=\&#34;SGV-A-264\&#34; aria-label=\&#34;SGV-A-264\&#34; target=\&#34;_blank\&#34;>SGV-A-264​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; aria-label=\&#34;SGV-A-267​\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-267.docx\&#34; target=\&#34;_blank\&#34;>SGV-A-267​&lt;/a>​&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-269.docx\&#34; aria-label=\&#34;SGV-A-​​269​\&#34; target=\&#34;_blank\&#34;>SGV-A-​​269​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; target=\&#34;_blank\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-274.docx\&#34; title=\&#34;SGV-A-274\&#34; aria-label=\&#34;SGV-A-274\&#34;>SGV-A-274&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; target=\&#34;_blank\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-279.docx\&#34; title=\&#34;SGV-A-279\&#34; aria-label=\&#34;SGV-A-279\&#34;>SGV-A-279&lt;/a>​&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-282.docx\&#34; title=\&#34;SGV-A-282\&#34; aria-label=\&#34;SGV-A-282\&#34;>SGV-A-282&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; aria-label=\&#34;SGV-A-6-2024​  ​​​\&#34; target=\&#34;_blank\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-6-2024.docx\&#34;>SGV-A-6-2024&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-9-2026.docx\&#34; title=\&#34;SGVA-9-2026\&#34;>SGVA-9-2026&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; aria-label=\&#34;SGV-A-6-2024​  ​​​\&#34; target=\&#34;_blank\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-6-2024.docx\&#34;>&lt;/a>&lt;a title=\&#34;SGV-A-14-2026\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-14-2026.docx\&#34;>SGV-A-14-2026&lt;/a>​&lt;ul>\r\n&lt;li>&lt;a title=\&#34;Matriz de observacion del  SGV-A-14-2026\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-14-26-matriz-observaciones.docx\&#34;>Matriz de observaciones&amp;nbsp;&lt;/a>&lt;/li>\r\n&lt;/ul>\r\n&lt;/li>\r\n&lt;/ul>\r\n&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-188texref.doc\&#34; title=\&#34;SGV-A-188\&#34; aria-label=\&#34;SGV-A-188\&#34; target=\&#34;_blank\&#34;>SGV-A-188&lt;/a>&lt;/td>\r\n&lt;td>Directriz para la implementación del sistema de mensajería de documentos electrónicos (Mendocel)​&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&lt;p>​​Incluye las reformas de los Acuerdos del Superintendente:​​&lt;/p>\r\n&lt;ul>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-194.docx\&#34; title=\&#34;SGV-A-194\&#34; aria-label=\&#34;SGV-A-194\&#34; target=\&#34;_blank\&#34;>SGV-A-194&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-244.docx\&#34; aria-label=\&#34;SGV-A-244​\&#34; target=\&#34;_blank\&#34;>SGV-A-244​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-263.docx\&#34; aria-label=\&#34;SGV-A-263​\&#34; target=\&#34;_blank\&#34;>SGV-A-263​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; href=\&#34;/con