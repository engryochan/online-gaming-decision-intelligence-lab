    <div class="cmp-accordion__item" data-cmp-hook-accordion="item" data-cmp-data-layer="{&#34;accordion-019613076e-item-e09852a960&#34;:{&#34;@type&#34;:&#34;sugeval/components/accordion/item&#34;,&#34;dc:title&#34;:&#34;Acuerdo&#34;}}" id="accordion-019613076e-item-e09852a960">
