        <div data-cmp-hook-accordion="panel" id="accordion-019613076e-item-e09852a960-panel" class="cmp-accordion__panel cmp-accordion__panel--hidden" role="region" aria-labelledby="accordion-019613076e-item-e09852a960-button"><div class="container responsivegrid">

    
    
    
    <div id="container-e09852a960" class="cmp-container">
        
        <div class="text table-scroll">
<div data-cmp-data-layer="{&#34;text-4b1ff9c3d8&#34;:{&#34;@type&#34;:&#34;sugeval/components/text&#34;,&#34;repo:modifyDate&#34;:&#34;2026-09-21T21:13:09Z&#34;,&#34;xdm:text&#34;:&#34;&lt;table cellpadding=\&#34;1\&#34; cellspacing=\&#34;0\&#34; border=\&#34;1\&#34;>\r\n&lt;tbody>&lt;tr>&lt;th>Norma&lt;/th>\r\n&lt;th>Contenido&lt;/th>\r\n&lt;th>Estados&lt;/th>\r\n&lt;th>Observaciones&lt;/th>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; title=\&#34;sgv-a-10-2026\&#34; aria-label=\&#34;sgv-a-10-2026\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-10-2026.docx\&#34; target=\&#34;_blank\&#34;>SGV-A-10-2026&lt;/a>&lt;/td>\r\n&lt;td>Ajuste al capital social suscrito y pagado de entidades supervisadas.​​&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>Rige a partir del 30 de junio del 2026.&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a title=\&#34;SGV-A-257\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-257texref.docx\&#34;>SGV-A-257&lt;/a>&lt;/td>\r\n&lt;td>Información básica de las entidades reguladas y supervisadas por la Superintendencia General de Valores.&amp;nbsp;&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&lt;p>Incluye las reformas del Acuerdo del Superintendente:&lt;/p>\r\n&lt;ul>\r\n&lt;li>&lt;a title=\&#34;SGV-A-264\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-264.docx\&#34;>SGV-A-264​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-267.docx\&#34;>SGV-A-267​&lt;/a>​&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-269.docx\&#34;>SGV-A-​​269​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a title=\&#34;SGV-A-274\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-274.docx\&#34;>SGV-A-274&lt;/a>&lt;/li>\r\n&lt;li>&lt;a title=\&#34;SGV-A-279\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-279.docx\&#34;>SGV-A-279&lt;/a>​&lt;/li>\r\n&lt;li>&lt;a title=\&#34;SGV-A-282\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-282.docx\&#34;>SGV-A-282&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-6-2024.docx\&#34;>SGV-A-6-2024&lt;/a>&lt;/li>\r\n&lt;li>&lt;a title=\&#34;SGVA-9-2026\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-9-2026.docx\&#34;>SGVA-9-2026&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-6-2024.docx\&#34;>&lt;/a>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-14-2026.docx\&#34; title=\&#34;SGV-A-14-2026\&#34;>SGV-A-14-2026&lt;/a>​&lt;ul>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-14-26-matriz-observaciones.docx\&#34; title=\&#34;Matriz de observacion del  SGV-A-14-2026\&#34;>Matriz de observaciones&amp;nbsp;&lt;/a>&lt;/li>\r\n&lt;/ul>\r\n&lt;/li>\r\n&lt;/ul>\r\n&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a title=\&#34;SGV-A-188\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-188texref.doc\&#34;>SGV-A-188&lt;/a>&lt;/td>\r\n&lt;td>Directriz para la implementación del sistema de mensajería de documentos electrónicos (Mendocel)​&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&lt;p>Incluye las reformas de los Acuerdos del Superintendente:​​&lt;/p>\r\n&lt;ul>\r\n&lt;li>&lt;a title=\&#34;SGV-A-194\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-194.docx\&#34;>SGV-A-194&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-244.docx\&#34;>SGV-A-244​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-263.docx\&#34;>SGV-A-263​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-6-2024.docx\&#34;>SGV-A-6-2024&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-6-2024.docx\&#34;>&lt;/a>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-14-2026.docx\&#34; title=\&#34;SGV-A-14-2026\&#34;>SGV-A-14-2026&lt;/a>​&amp;nbsp;&lt;ul>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-14-26-matriz-observaciones.docx\&#34; title=\&#34;Matriz de observacion del  SGV-A-14-2026\&#34;>Matriz de observaciones&amp;nbsp;&lt;/a>&amp;nbsp;​​​&amp;nbsp; ​​&lt;/li>\r\n&lt;/ul>\r\n&lt;/li>\r\n&lt;/ul>\r\n&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; aria-label=\&#34;SGV-A-75\&#34; title=\&#34;SGV-A-75\&#34; target=\&#34;_blank\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-75texref.doc\&#34;>SGV-A-75&lt;/a>&lt;/td>\r\n&lt;td>&lt;p>Suministro de información periódica​&lt;/p>\r\n&lt;ul>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; aria-label=\&#34;Anexos para el envío de información\&#34; title=\&#34;Anexos para el envío de información\&#34; target=\&#34;_self\&#34; style=\&#34;background-color: rgb(255,255,255);\&#34; href=\&#34;/content/sugeval/cr/es/normativa/anexo-para-el-envio-de-informacion.html\&#34;>Anexos para el envío de información&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; aria-label=\&#34;Cronograma 2026\&#34; title=\&#34;Cronograma 2026\&#34; target=\&#34;_blank\&#34; style=\&#34;background-color: rgb(255,255,255);\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/anexos-sgv-a-75/cronogramas2026.xlsx\&#34;>Cronograma para el envío de información 2026&lt;/a>&lt;/li>\r\n&lt;li>&lt;a rel=\&#34;noopener noreferrer\&#34; aria-label=\&#34;Cuadro informacion periodica 2026\&#34; title=\&#34;Cuadro informacion periodica 2026\&#34; target=\&#34;_blank\&#34; style=\&#34;background-color: rgb(255,255,255);\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/anexos-sgv-a-75/cuadro-inf-periodica2026.xlsx\&#34;>Detalle de los informes que debe remitir cada tipo de participante​&lt;/a>&lt;/li>\r\n&lt;/ul>\r\n&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&lt;p>Incluye las reformas de los&amp;nbsp;Acuerdos del Superintendente:&lt;/p>\r\n&lt;ul>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-203.docx\&#34;>SGV-A-203&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-214.docx\&#34;>SGV-A-214​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-218.docx\&#34;>SGV-A-218&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-220.docx\&#34;>SGV-A-220​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-222.docx\&#34;>SGV-A-222&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-231.docx\&#34;>SGV-A-231&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-235.docx\&#34;>SGV-A-235&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-237.docx\&#34;>SGV-A-237​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-239.docx\&#34;>SGV-A-239​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-243.docx\&#34;>SGV-A-243​​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-249.docx\&#34;>SGV-A-249​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-256.docx\&#34;>SGV-A-256&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-260.docx\&#34;>SGV-A-​​260​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-269.docx\&#34;>SGV-A-​​269​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-278.docx\&#34;>SGV-A-278​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-3-2025.docx\&#34;>SGV-A-3-2025​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-6-2025.docx\&#34;>SGV-A-6-2025​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-14-2026.docx\&#34; title=\&#34;SGV-A-14-2026\&#34;>SGV-A-14-2026&lt;/a>&lt;ul>\r\n&lt;li>&lt;a title=\&#34;Matriz de observacion del  SGV-A-14-2026\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-14-26-matriz-observaciones.docx\&#34;>Matriz de observaciones&amp;nbsp;&lt;/a>&lt;/li>\r\n&lt;/ul>\r\n&lt;/li>\r\n&lt;/ul>\r\n&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a title=\&#34;SGV-A-61\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/consulta-sgv-a-61y75.docx\&#34;>SGV-A-61&lt;/a>&lt;/td>\r\n&lt;td>​Acuerdo sobre hechos relevantes&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&lt;p>Incluye las reforma​s de los Acuerdos del Superintendente:​&lt;/p>\r\n&lt;ul>\r\n&lt;li>&lt;a title=\&#34;SGV-A-196\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-196.docx\&#34;>SGV-A-196&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-218.docx\&#34;>SGV-A-218​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-249.docx\&#34;>SGV-A-249​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-259.docx\&#34;>SGV-A-259​&lt;/a>&lt;/li>\r\n&lt;li>&lt;a title=\&#34;SGV-A-274\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-274.docx\&#34;>SGV-A-274&amp;nbsp;&l