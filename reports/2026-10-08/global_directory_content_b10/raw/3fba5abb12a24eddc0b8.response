<div id="accordion-83537b9f6d" class="cmp-accordion" data-cmp-is="accordion" data-cmp-data-layer="{&#34;accordion-83537b9f6d&#34;:{&#34;shownItems&#34;:[],&#34;@type&#34;:&#34;sugeval/components/accordion&#34;,&#34;repo:modifyDate&#34;:&#34;2026-07-10T20:36:54Z&#34;}}" data-cmp-single-expansion data-placeholder-text="false">
    <div class="cmp-accordion__item" data-cmp-hook-accordion="item" data-cmp-data-layer="{&#34;accordion-83537b9f6d-item-dcbddb7ca2&#34;:{&#34;@type&#34;:&#34;sugeval/components/accordion/item&#34;,&#34;dc:title&#34;:&#34;Acuerdo &#34;}}" id="accordion-83537b9f6d-item-dcbddb7ca2">
