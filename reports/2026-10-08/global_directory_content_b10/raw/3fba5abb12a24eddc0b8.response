</div></div>
<div class="title align-center component-loose aem-GridColumn aem-GridColumn--default--12"><div data-cmp-data-layer="{&#34;title-07a374e4db&#34;:{&#34;@type&#34;:&#34;sugeval/components/title&#34;,&#34;repo:modifyDate&#34;:&#34;2026-07-30T21:51:17Z&#34;,&#34;dc:title&#34;:&#34;Aplica a: 3 - Emisores de Valores&#34;}}" id="title-07a374e4db" class="cmp-title">
    <h3 class="cmp-title__text">Aplica a: 3 - Emisores de Valores</h3>
</div>

    

</div>
<div class="accordion panelcontainer compact-container aem-GridColumn aem-GridColumn--default--12">
<div id="accordion-e483bed39b" class="cmp-accordion" data-cmp-is="accordion" data-cmp-data-layer="{&#34;accordion-e483bed39b&#34;:{&#34;shownItems&#34;:[],&#34;@type&#34;:&#34;sugeval/components/accordion&#34;,&#34;repo:modifyDate&#34;:&#34;2026-05-11T21:04:44Z&#34;}}" data-cmp-single-expansion data-placeholder-text="false">
    <div class="cmp-accordion__item" data-cmp-hook-accordion="item" data-cmp-data-layer="{&#34;accordion-e483bed39b-item-eba946d6be&#34;:{&#34;@type&#34;:&#34;sugeval/components/accordion/item&#34;,&#34;dc:title&#34;:&#34;Acuerdo &#34;}}" id="accordion-e483bed39b-item-eba946d6be">
        <h3 class="cmp-accordion__header">
            <button id="accordion-e483bed39b-item-eba946d6be-button" class="cmp-accordion__button" type="button" aria-controls="accordion-e483bed39b-item-eba946d6be-panel" data-cmp-hook-accordion="button">
                <span class="cmp-accordion__title">Acuerdo </span>
                <span class="cmp-accordion__icon"><i class="icon icon-CaretDown" aria-hidden="true"></i></span>
            </button>
        </h3>
        <div data-cmp-hook-accordion="panel" id="accordion-e483bed39b-item-eba946d6be-panel" class="cmp-accordion__panel cmp-accordion__panel--hidden" role="region" aria-labelledby="accordion-e483bed39b-item-eba946d6be-button"><div class="container responsivegrid">

    
    
    
    <div id="container-eba946d6be" class="cmp-container">
        
        <div class="text table-scroll">
<div data-cmp-data-layer="{&#34;text-6a4a97d8e7&#34;:{&#34;@type&#34;:&#34;sugeval/components/text&#34;,&#34;repo:modifyDate&#34;:&#34;2026-09-29T20:59:41Z&#34;,&#34;xdm:text&#34;:&#34;&lt;table border=\&#34;1\&#34; cellspacing=\&#34;0\&#34; cellpadding=\&#34;1\&#34;>\r\n&lt;tbody>&lt;tr>&lt;th>Norma&lt;/th>\r\n&lt;th>Contenido&lt;/th>\r\n&lt;th>Estados&lt;/th>\r\n&lt;th>Observaciones&lt;/th>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-17-2026.docx\&#34; aria-label=\&#34;SGV-A-17\&#34; title=\&#34;SGV-A-17\&#34;>SGV-A-17-2026&lt;/a>&lt;/td>\r\n&lt;td>Reporte de acreditación de las ofertas privadas de valores y formato del consentimiento de cada inversionista&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&amp;nbsp;&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; target=\&#34;_blank\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-8-2026.docx\&#34; aria-label=\&#34;SGV-A-8-2026\&#34; title=\&#34;SGV-A-8-2026\&#34;>SGV-A-8-2026&lt;/a>&lt;/td>\r\n&lt;td>Proceso de desmaterialización de acciones.​&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&amp;nbsp;&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a rel=\&#34;noopener noreferrer\&#34; aria-label=\&#34;SGV-A-272\&#34; title=\&#34;SGV-A-272\&#34; target=\&#34;_blank\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-272.docx\&#34;>SGV-A-272&lt;/a>&lt;/td>\r\n&lt;td>Lineamientos relacionados con la documentación en soporte físico a partir de la Declaración de la Cesación del Estado de Emergencia&lt;/td>\r\n&lt;td>Vigente&lt;/td>\r\n&lt;td>&amp;nbsp;&lt;/td>\r\n&lt;/tr>&lt;tr>&lt;td>&lt;a aria-label=\&#34;SGV-A-257\&#34; title=\&#34;SGV-A-257\&#34; href=\&#34;/content/dam/sugeval/normativa/acuerdos-superintendente/sgv-a-257texref.docx\&#34;>SGV-A-257&lt;/a>&lt;/td>\r\n&lt;td>Información básica de las entidades reguladas y supervisadas por la Superintendencia General de Valores&lt;/td>\r\n&lt;td