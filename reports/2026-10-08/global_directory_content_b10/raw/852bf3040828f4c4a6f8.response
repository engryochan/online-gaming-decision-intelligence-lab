<script>
	$(document).on("scroll", function(){
	    
	    console.log($(document).scrollTop());
		if ($(document).scrollTop() > 50){
			$("#header").addClass("shrink");
		} else {
			$("#header").removeClass("shrink");
		}

		$("#owl-demo").owlCarousel({
               loop:true,
                              
               margin:10,
               nav:true,
               dots: false,
               responsive:{
                   0:{
                       items:1
                   },
                   600:{
                       items:2
                   },
                   1000:{
                       items:3
                   }
               }
        });
        $("#owl-demo2").owlCarousel({
               loop:true,
                             margin:30,
               nav:true,
               dots: false,
               rewind: true,
               autoplay: false,
               responsive:{
                   0:{
                       items:1
                   },
                   600:{
                       items:2
                   },
                   1000:{
                       items:3
                   }
               }
       });
        $("#owl-demo3").owlCarousel({
              loop:true,
                             margin:30,
               nav:false,
               dots: false,
               rewind: true,
               autoplay: true,
               responsive:{
                   0:{
                       items:3
                   },
                   600:{
                       items:5
                   },
                   1000:{
                       items:7
                   }
               }
        });
       
	});
</script>
