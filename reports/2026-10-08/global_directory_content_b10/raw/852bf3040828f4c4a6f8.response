                    for (i in optoin_json) {
                           inputElement += '<option value="' + optoin_json[i].value + '" >' + optoin_json[i].value + '</option>';
                    }
                   console.log(inputElement );
            }
            /*$('table').DataTable({
            	"searching": false,
            	"pageLength": 20,
            	"bLengthChange": false,
			    "bFilter": true,
			    "bInfo": false,
            });*/
            $.ajaxSetup({
			    beforeSend: function(jqXHR, settings) {
