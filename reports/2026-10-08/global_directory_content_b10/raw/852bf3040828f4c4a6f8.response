<script>
(function($){
    var $QFCFirm_dd = $('[name="Reporter-QFCFirm"]');
    var $AINumber_dd = $('[name="Reporter-AppAI"]');
    var all_values; // will hold all AppAI values

    // AJAX fetch all AppAI values once on page load
    function fetchAppAIData() {
        $.ajax({
            url: "https://www.qfcra.com/wp-admin/admin-ajax.php",
            method: "POST",
            data: { action: "cf7_populate_values" },
            dataType: "json",
            success: function(response){
			 $QFCFirm_dd.html('');	
			 $QFCFirm_dd.append($('<option>').val('').text('-- select QFC Firm Name / الشركة العاملة في مركز قطر للمال --'));
        $QFCFirm_dd.append($('<option>').val('Other').text('Other / آخر'));
	
		  if(response.QFCFirm){
        response.QFCFirm.forEach(function(val){
        val = val.trim(); 
            $QFCFirm_dd.append($('<option>').val(val).text(val));
        });
    }
                all_values = response.AppAI;
                populateAppAI(); // populate on page load
            }
        });
    }

    // Populate Reporter-AppAI based on selected QFCFirm
    function populateAppAI() {
        var selectedQFC = $QFCFirm_dd.val() || "";
        var arr = selectedQFC.split(" - ");
        var AIoptions = [];

        if(all_values) {
            for(var i=0; i<all_values.length; i++) {
                if(all_values[i].CFDesc && arr[1] && all_values[i].CFDesc.includes(arr[1])) {
                    AIoptions.push(all_values[i].AIName);
                }
            }
        }

        // Reset dropdown
        $AINumber_dd.html('');
        $AINumber_dd.append($('<option>').val('').text('-- select Individual / الفرد --'));
        $AINumber_dd.append($('<option>').val('Other').text('Other / آخر'));
	
	

        // Add filtered options
        AIoptions.forEach(function(val){
        val = val.trim(); 
            $AINumber_dd.append($('<option>').val(val).text(val));
        });
    }

    // On page load
    fetchAppAIData();

    // On QFCFirm change
    $QFCFirm_dd.on('change', function(){
        populateAppAI();
    });

})(jQuery);

</script>

</body>
</html>