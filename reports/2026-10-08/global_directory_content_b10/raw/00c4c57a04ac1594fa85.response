rent px-4 text-sm focus:outline-hidden xl:px-8"><div class="border-b-4 group-hover:border-black group-focus:border-black admin:group-hover:border-black admin:group-focus:border-black border-transparent">Market Data</div></button><div class="hidden"></div><button disabled="" type="button" class="group cursor-pointer border-0 bg-transparent px-4 text-sm focus:outline-hidden xl:px-8"><div class="border-b-4 group-hover:border-black group-focus:border-black admin:group-hover:border-black admin:group-focus:border-black border-transparent">Insights</div></button><div class="hidden"></div><button disabled="" type="button" class="group cursor-pointer border-0 bg-transparent px-4 text-sm focus:outline-hidden xl:px-8"><div class="border-b-4 group-hover:border-black group-focus:border-black admin:group-hover:border-black admin:group-focus:border-black border-transparent">About</div></button><div class="hidden"></div><div class="hidden"></div></nav></div><div class="absolute right-0 flex items-center gap-x-4 bg-white"><div class="hidden"></div><form method="GET" class="relative m-0 flex items-center text-black" action="/site-search"><div class="text-base right-0"><input type="search" name="q" disabled="" placeholder="Search" class="border-0 border-b-2 border-solid p-2 pr-10 text-base duration-100 focus:outline-hidden focus:border-primary border-black bg-white" value=""/><div class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 px-4"><svg role="img" width="1em" height="1em" viewBox="0 0 18 18"><g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd"><g transform="translate(-1362.000000, -104.000000)" fill="currentColor"><path d="M1379.00496,121.06904 C1378.86456,121.20944 1378.68096,121.28 1378.49736,121.28 C1378.31376,121.28 1378.13088,121.20944 1377.99048,121.06904 L1372.48032,115.538 C1371.37584,116.42576 1369.9776,116.96 1368.45552,116.96 C1364.89584,116.96 1362,114.05336 1362,110.48072 C1362,106.90736 1364.89584,104 1368.45552,104 C1372.0152,104 1374.91104,106.90736 1374.91104,110.48072 C1374.91104,112.00784 1374.37896,113.41112 1373.4948,114.51992 L1379.00496,120.05096 C1379.28504,120.33248 1379.28504,120.78752 1379.00496,121.06904 Z M1368.45552,105.44 C1365.6864,105.44 1363.43424,107.70152 1363.43424,110.48072 C1363.43424,113.2592 1365.6864,115.52 1368.45552,115.52 C1371.22392,115.52 1373.4768,113.2592 1373.4768,110.48072 C1373.4768,107.70152 1371.22392,105.44 1368.45552,105.44 Z"></path></g></g></svg></div></div></form></div></div></div></div></div><div></div><div></div></div></header><section><div id="integration-id-a453658"><img class="w-full max-h-screen select-none object-cover" alt="Hinge Health IPO - Celebrating in front of the NYSE facade" src="https://www.nyse.com/publicdocs/images/Hero-NYSE-Listings-Hinge-1920x550.jpg"/><div class="-mt-20 md:-mt-32 lg:-mt-40"><div data-testid="belt" class="px-3 lg:px-24"><div class="flex flex-col items-stretch gap-4 lg:flex-row lg:gap-8"><div class="my-8 flex-2 p-8 bg-black text-white"><div id="integration-id-fef7c3d" class=""><h1 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-4xl imt:text-[2rem] md:text-6xl md:imt:text-5xl imt:mb-6">Listings </h1></div><div class="h-6"></div><div id="integration-id-8a6fac9" class=""><h3 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-2xl imt:text-[1.5rem] md:text-4xl md:imt:text-[2rem] imt:mb-6">Why list on the NYSE?</h3></div><div class="h-6"></div><div id="integration-id-d10df7f" class=""><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">The New York Stock Exchange is the world’s largest equities exchange and the gold standard for trading technology – and has been for over 200 years. Our community of NYSE-listed global business icons and innovators in every industry includes 74% of the publicly listed Fortune 500 and 70% of the S&amp;P 500 (as of 5/12/2025). We support our community with best-in-class services, public company advocacy, better trading, and an expansive media network.</p><div class="mb-4"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Contact us about joining the world&#x27;s largest exchange.</p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a data-is-button="true" href="#new-ipo" data-checked="false" class="font-medium justify-center items-center no-underline focus-within:outline-hidden focus:outline-hidden focus-within:ring-3 focus:ring-3 focus:bg-gray-200 focus:text-black admin:focus:bg-gray-200 admin:focus:text-black leading-tight align-middle duration-75 active:shadow-none active:translate-y-px max-w-full select-none bg-black admin:bg-primary greentrace:bg-primary-500 greentrace-acr:bg-acr-500 greentrace-art:bg-art-500 text-white border-black greentrace:border-primary-500 greentrace-acr:border-acr-500 greentrace-art:border-art-500 shadow-lg hover:bg-white greentrace:hover:bg-white greentrace-acr:hover:bg-white greentrace-art:hover:bg-white hover:text-black admin:hover:text-white greentrace:hover:text-primary-500 greentrace-acr:hover:text-acr-500 greentrace-art:hover:text-art-500 hover:border-black greentrace:hover:border-primary-500 greentrace-acr:hover:border-acr-500 greentrace-art:hover:border-art-500  greentrace:active:bg-primary-100 greentrace-acr:active:bg-acr-100 greentrace-art:active:bg-art-100 active:text-primary admin:hover:text-white greentrace:active:text-primary-500 greentrace-acr:active:text-acr-500 greentrace-art:active:text-art-500 greentrace:active:border-primary-500 greentrace-acr:active:border-acr-500 greentrace-art:active:border-art-500 active:shadow-none  checked:text-primary   text-xs md:text-sm gap-1 md:gap-4 border rounded-tl rounded-tr rounded-bl rounded-br inline-flex px-6 md:px-12 py-1 md:py-2 greentrace:py-2 greentrace-acr:py-2 greentrace-art:py-2 md:greentrace:py-4 md:greentrace-acr:py-4 md:greentrace-art:py-4 cursor-pointer uppercase flex-row-reverse break-words"><span><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span><span>Contact Us</span></a></p></div></div><div class="my-8 flex-1 self-stretch p-8 bg-primary lg:self-end"><div class="flex flex-1 flex-col items-center justify-center duration-300 hidden"><svg viewBox="0 0 66 66" class="w-full max-w-20" role="progressbar" data-testid="spinner" aria-label="Loading..." aria-busy="true" aria-live="polite"><g><g><circle fill="none" stroke-width="6" stroke-linecap="round" cx="33" cy="33" r="30" stroke-dasharray="187" stroke-dashoffset="0" transform-origin="center" stroke="currentColor"><animate attributeName="stroke-dashoffset" values="187;46.75;187" dur="1.4s" repeatCount="indefinite"></animate><animateTransform attributeName="transform" attributeType="XML" type="rotate" values="0 0 0;135 0 0;450 0 0" dur="1.4s" repeatCount="indefinite"></animateTransform></circle></g><animateTransform attributeName="transform" attributeType="XML" type="rotate" from="0 33 33" to="270 33 33" dur="1.4s" repeatCount="indefinite"></animateTransform></g><g class="duration-300 opacity-0"><path stroke-width="6" stroke="currentColor" d="M33,10 L33,40 M33,45 L33,55"></path></g></svg></div><div class="h-6"></div><div id="integration-id-6618948" class=""><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">2025 was another history-making year for the NYSE. We hosted seven of the ten largest US IPOs and led in large tech IPOs, representing nearly 70% of proceeds raised. We also launched NYSE Texas, the first securities exchange in Texas, and reached a milestone of 100 dual listings. <span class="italic">Welcome to the public market.</span></p></div></div></div></div></div></div></section><main><div data-testid="belt" class="px-3 lg:px-24"><div class="h-10"></div><div class="pb-16"><div class="flex gap-8 flex-col xl:flex-row"><div style="max-width:100vw" class="flex flex-col justify-center flex-1"><img src="/publicdocs/images/NYSE_Logo_Primary.svg" alt="NYSE logo" class="w-32"/><div class="h-10"></div><div class=""><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"></p><h3 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-2xl imt:text-[1.5rem] md:text-4xl md:imt:text-[2rem] imt:mb-6">The NYSE Advantage</h3><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"></p><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">NYSE’s <a href="/community" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">community</a> and the <a href="/global-advisory" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">resources and services</a> we provide them are unparalleled. And as the world’s largest primary listings exchange, we have invested heavily in our industry-leading technology, Pillar, which underpins much of today’s highly sophisticated electronic marketplace. While Pillar leans heavily on speed and automation, our trading model pairs cutting-edge technology with human discretion for the most important liquidity events each trading day, the opening and closing auctions. This unique approach leads to larger, more flexible auctions with the broadest possible participation, contributing to lower volatility and tighter spreads around these key events. When our issuers need us most – on IPO day, a major index rebalance, or when unexpected volatility surfaces – we are there to deliver in ways that technology alone could not. </p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a href="/data-insights/its-academic-nyse-listed-stocks-receive-superior-market-quality" data-icon="MoveRightIcon" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">Learn more about listing on the <span class="whitespace-nowrap">NYSE<!-- --> <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span></a></p></div></div><div style="max-width:100vw" class="flex flex-col justify-center flex-1"><img src="/publicdocs/images/Rubrik_Experience_Square.jpg" alt="Rubrik at Experience Square" class=""/></div></div></div><div id="integration-id-b664680" class="pb-10 xl:pb-20"><div id="integration-id-af836d7" class="bg-gray text-black flex pt-10 pr-10 pb-10 pl-10 gap-4 flex-col w-full xl:pt-12 xl:pr-0 xl:pb-12 xl:pl-0 xl:w-full"><div id="integration-id-761d572" data-testid="belt" class="px-3 lg:px-24"><div class="flex flex-col overflow-y-auto items-center"><img src="/publicdocs/images/NYSE_Logo_Primary.svg" alt="NYSE logo" class="w-20"/></div><div class="h-10"></div><div id="integration-id-ba4437f" class=""><div class="text-center"><h2 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-2xl imt:text-[1.5rem] md:text-4xl md:imt:text-[2rem] imt:mb-6">The world&#x27;s critical trading infrastructure runs on ICE.</h2><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">NYSE, the world’s largest equities exchange, is part of Intercontinental Exchange (NYSE:ICE). The <a href="https://www.ice.com/about/exchanges-clearing" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-black hover:text-black font-bold inline [&amp;_svg]:inline">ICE family of exchanges</a> includes some of the world’s largest derivatives exchanges. ICE is the largest energy exchange in the world and its markets offer trading in commodities, environmental derivatives and interest rates. ICE is also the seventh largest index provider globally, with over $2 trillion in global assets benchmarked to ICE indices.</p></div></div></div></div></div><div class="!mt-10 !mb-10 xl:!mb-20"><div id="integration-id-ea12686" data-testid="belt" class="-mx-3 lg:-mx-24"><div class="bg-black pt-10 pb-10 xl:pt-16 xl:pb-16"><div id="integration-id-e141a2a" data-testid="belt" class="px-3 lg:px-24"><div class="flex gap-10 flex-col lg:flex-row"><div style="max-width:100vw" class="flex flex-col flex-1"><div class="text-white"><div class=""><div class="text-left"><h3 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-2xl imt:text-[1.5rem] md:text-4xl md:imt:text-[2rem] imt:mb-6">The meaning of NYSE-Listed</h3><h3 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-2xl imt:text-[1.5rem] md:text-4xl md:imt:text-[2rem] imt:mb-6"><span class="text-[1rem] md:text-[1.25rem]"></span></h3><div class="mb-4"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Reddit (<a href="/quote/XNYS:RDDT" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-primary hover:text-primary font-bold inline [&amp;_svg]:inline">NYSE:RDDT</a>) is on a mission to bring community belonging and empowerment to everyone in the world. They brought that mission to Wall Street for their public debut, transforming the NYSE into a playground for Reddit employees to celebrate their listing day, with Snoo hunts and ‘easter eggs’ throughout the building, and a mini golf course that traced Reddit’s history and celebrated some of its favorite subreddits.</p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">At the center of everything they do is the Reddit community. In a twist on how most companies choose to open the markets on their Listing Day, it was Snoo, and not the executive team, who rang the Opening Bell. </p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">The possibilities do not end there. NYSE is part of Intercontinental Exchange (NYSE: ICE), which separately agreed with Reddit to <a href="https://ir.theice.com/press/news-details/2025/Intercontinental-Exchange-and-Reddit-Collaborate-to-Create-and-Distribute-Data-Products-for-Capital-Markets/default.aspx" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-white hover:text-white font-bold inline [&amp;_svg]:inline"><span class="underline">leverage their data API</span></a> to develop new products for the financial industry.</p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a data-is-button="true" data-variant="black" href="#reddit" data-checked="false" class="font-medium justify-center items-center no-underline focus-within:outline-hidden focus:outline-hidden focus-within:ring-3 focus:ring-3 focus:bg-gray-200 focus:text-black admin:focus:bg-gray-200 admin:focus:text-black leading-tight align-middle duration-75 active:shadow-none active:translate-y-px max-w-full select-none bg-black text-white border-white shadow-lg  hover:text-primary    active:text-primary  active:shadow-none  checked:text-primary   text-xs md:text-sm gap-1 md:gap-2 border rounded-tl rounded-tr rounded-bl rounded-br inline-flex px-2 md:px-3 greentrace:px-3 greentrace-acr:px-3 greentrace-art:px-3 md:greentrace:px-4 md:greentrace-acr:px-4 md:greentrace-art:px-4 py-1 md:py-2 greentrace:py-2 greentrace-acr:py-2 greentrace-art:py-2 md:greentrace:py-4 md:greentrace-acr:py-4 md:greentrace-art:py-4 cursor-pointer uppercase flex-row-reverse break-words"><span><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span><span>Watch now </span></a></p><div></div></div></div></div></div><div style="max-width:100vw" class="flex flex-col flex-1"><img src="/publicdocs/images/Reddit_bell.png" alt="Reddit Snoo ringing the NYSE Opening Bell" class=""/><div class="flex flex-1 flex-col items-center justify-center duration-300 hidden"><svg viewBox="0 0 66 66" class="w-full max-w-20" role="progressbar" data-testid="spinner" aria-label="Loading..." aria-busy="true" aria-live="polite"><g><g><circle fill="none" stroke-width="6" stroke-linecap="round" cx="33" cy="33" r="30" stroke-dasharray="187" stroke-dashoffset="0" transform-origin="center" stroke="currentColor"><animate attributeName="stroke-dashoffset" values="187;46.75;187" dur="1.4s" repeatCount="indefinite"></animate><animateTransform attributeName="transform" attributeType="XML" type="rotate" values="0 0 0;135 0 0;450 0 0" dur="1.4s" repeatCount="indefinite"></animateTransform></circle></g><animateTransform attributeName="transform" attributeType="XML" type="rotate" from="0 33 33" to="270 33 33" dur="1.4s" repeatCount="indefinite"></animateTransform></g><g class="duration-300 opacity-0"><path stroke-width="6" stroke="currentColor" d="M33,10 L33,40 M33,45 L33,55"></path></g></svg></div></div></div></div></div></div></div><div class="flex gap-10 flex-col lg:flex-row"><div style="max-width:100vw" class="flex flex-col flex-1"><div class=""><h3 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-2xl imt:text-[1.5rem] md:text-4xl md:imt:text-[2rem] imt:mb-6">Recently Listed</h3><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"></p><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"></p><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Standards are higher here. 70% of US IPOs in 2024 did not qualify to list on the NYSE. Of the ones that did, we hosted two of the three largest U.S. IPOs in 2024, Viking Holdings (<a href="/quote/XNYSE:VIK" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:VIK</a>) and Standard Aero (<a href="/quote/XNYSE:SARO" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:SARO</a>).</p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Recently listed tech companies include Karman Space &amp; Defense (<a href="/quote/XNYSE:KRMN" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:KRMN</a>), Ingram Micro (<a href="/quote/XNYSE:INGM" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:INGM</a>), Oklo (<a href="/quote/XNYS:OKLO" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:OKLO</a>), Rubrik (<a href="/quote/XNYS:RBRK" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:RBRK</a>), Ibotta (<a href="/quote/XNYS:IBTA" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:IBTA</a>), and Reddit (<a href="/quote/XNYS:RDDT" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:RDDT</a>).</p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Iconic brands that recently listed NYSE include GE Aerospace (<a href="/quote/XNYS:GE" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:GE</a>), GE Vernova (<a href="/quote/XNYS:GEV" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:GEV</a>), Viking (<a href="/quote/XNYS:VIK" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:VIK</a>), Flutter Entertainment (<a href="/quote/XNYS:FLUT" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:FLUT</a>), and Amer Sports (<a href="/quote/XNYS:AMER" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">NYSE:AS</a>), the owner of sports brands Arc’teryx, Salomon, Wilson and others. </p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">These companies joined our community of over 2,400 public companies representing icons and innovators across every industry, including <a href="/listings/international-listings" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">over 530</a> of the world’s largest and most influential international companies.</p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a href="/listings/gallery" data-icon="MoveRightIcon" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">View our gallery of recent <span class="whitespace-nowrap">IPOs<!-- --> <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span></a></p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a href="/community" data-icon="MoveRightIcon" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-secondary hover:text-secondary font-bold inline [&amp;_svg]:inline">Learn more about the NYSE <span class="whitespace-nowrap">Community<!-- --> <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span></a></p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"></p><div class="text-center"></div></div></div><div style="max-width:100vw" class="flex flex-col flex-1"><img src="/publicdocs/images/NYSE_Trading_Floor_New_Branding-alt.jpg" alt="NYSE Trading Floor" class=""/></div></div><div id="integration-id-cf0cfc4" data-testid="belt" class="-mx-3 lg:-mx-24"><div class="bg-black pt-10 pb-10 !mt-10 xl:pt-16 xl:pb-16 xl:!mt-20"><div id="integration-id-f7b8765" data-testid="belt" class="px-3 lg:px-24"><div class="flex gap-10 flex-col lg:flex-row"><div style="max-width:100vw" class="flex flex-col flex-1"><div class="text-white xl:text-white"><div class=""><div class="text-left"><h3 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-2xl imt:text-[1.5rem] md:text-4xl md:imt:text-[2rem] imt:mb-6">Resources &amp; Services</h3><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Founded on six pillars of excellence, NYSE Global Advisory delivers unparalleled knowledge on topics that can help guide your decision-making, navigate uncertainties and capitalize on trends. </p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">Access a suite of expertise and services that can help you excel as a public company, including <a href="/board-services" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-primary hover:text-primary font-bold inline [&amp;_svg]:inline">Board Services</a>, <a href="/esg/resource-center" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-primary hover:text-primary font-bold inline [&amp;_svg]:inline">ESG Advisory</a>, <a href="/nyse-institute" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-primary hover:text-primary font-bold inline [&amp;_svg]:inline">Issuer Advocacy</a>, <a href="/corporate-services" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-primary hover:text-primary font-bold inline [&amp;_svg]:inline">Corporate Services</a>, <a href="/research#mac-desk" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-primary hover:text-primary font-bold inline [&amp;_svg]:inline">Market Insights,</a> and <a href="/global-advisory#index-services" class="text-left no-underline hover:underline cursor-pointer print:text-black print:underline text-primary hover:text-primary font-bold inline [&amp;_svg]:inline">Index Advisory</a>. Global Advisory services are included in your NYSE listing. </p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a data-is-button="true" data-variant="black" href="/global-advisory" data-checked="false" class="font-medium justify-center items-center no-underline focus-within:outline-hidden focus:outline-hidden focus-within:ring-3 focus:ring-3 focus:bg-gray-200 focus:text-black admin:focus:bg-gray-200 admin:focus:text-black leading-tight align-middle duration-75 active:shadow-none active:translate-y-px max-w-full select-none bg-black text-white border-white shadow-lg  hover:text-primary    active:text-primary  active:shadow-none  checked:text-primary   text-xs md:text-sm gap-1 md:gap-4 border rounded-tl rounded-tr rounded-bl rounded-br inline-flex px-6 md:px-12 py-1 md:py-2 greentrace:py-2 greentrace-acr:py-2 greentrace-art:py-2 md:greentrace:py-4 md:greentrace-acr:py-4 md:greentrace-art:py-4 cursor-pointer uppercase flex-row-reverse break-words"><span><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span><span>Learn more </span></a></p></div></div></div></div><div style="max-width:100vw" class="flex flex-col flex-1"><img src="/publicdocs/images/Hero-Professional_Settings-16x9-39.jpg" alt="ESG Office building and employees" class="object-cover"/></div></div></div></div></div><div id="integration-id-b46933e" data-testid="belt" class="-mx-3 lg:-mx-24"><div class="bg-primary pt-10 pb-10 xl:pt-16 xl:pb-16"><div id="integration-id-2ba7b83" data-testid="belt" class="px-3 lg:px-24"><div id="integration-id-7477b5b" class=""><h3 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-2xl imt:text-[1.5rem] md:text-4xl md:imt:text-[2rem] imt:mb-6">Exchange Traded Products</h3><h2 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-3xl imt:text-[1.75rem] md:text-5xl md:imt:text-4xl imt:mb-6"></h2><div class="mb-6"></div><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"></p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">The U.S. ETF marketplace has grown to over $10 trillion in assets under management, providing investors access to over 4,000 ETFs, spanning across different types of assets, including historically difficult to access asset classes, contributing to the continuing the democratization of investing. The NYSE lists more ETPs than any other exchange in the world. </p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">The NYSE has been at the forefront of product development in ETFs, one of the most transformative investment vehicles of the last century since their inception back in 1993. As a center of innovation, the NYSE has been the listing venue of choice for many “firsts,” including the first mutual fund to ETF conversion, the first multi share class ETF, the first digital currency futures ETF and the first private credit ETF. </p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0">The NYSE operates two ETF listing venues which collectively offer the largest liquidity enhancement programs and greatest depth of liquidity across all US ETFs. The combination of liquidity, innovative technology solutions and a superior market model provide issuers with the best trading experience in US ETFs.</p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"></p><p class="print:orphans-3 print:widows-3 print:text-black mb-6 last:mb-0"><a data-is-button="true" data-variant="black" href="/products/exchange-traded-products" data-checked="false" class="font-medium justify-center items-center no-underline focus-within:outline-hidden focus:outline-hidden focus-within:ring-3 focus:ring-3 focus:bg-gray-200 focus:text-black admin:focus:bg-gray-200 admin:focus:text-black leading-tight align-middle duration-75 active:shadow-none active:translate-y-px max-w-full select-none bg-black text-white border-white shadow-lg  hover:text-primary    active:text-primary  active:shadow-none  checked:text-primary   text-xs md:text-sm gap-1 md:gap-4 border rounded-tl rounded-tr rounded-bl rounded-br inline-flex px-6 md:px-12 py-1 md:py-2 greentrace:py-2 greentrace-acr:py-2 greentrace-art:py-2 md:greentrace:py-4 md:greentrace-acr:py-4 md:greentrace-art:py-4 cursor-pointer uppercase flex-row-reverse break-words"><span><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 16 16" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M10.072 8.024L5.715 3.667l.618-.62L11 7.716v.618L6.333 13l-.618-.619 4.357-4.357z"></path></svg></span><span>Learn more</span></a></p></div></div></div><div id="integration-id-7103f2a" data-testid="belt" class="-mx-3 lg:-mx-24"><div class="bg-black text-white pt-10 pb-10 lg:pt-16 lg:pb-16"><div id="integration-id-b747755" data-testid="belt" class="px-3 lg:px-24"><div id="integration-id-210914b" class=""><div class="text-center"><h2 class="m-0 font-headings border-0 pb-0 print:orphans-3 print:widows-3 font-medium normal-case leading-none print:break-after-avoid text-3xl imt:text-[1.75rem] md:text-5xl md:imt:text-4xl imt:mb-6 !mb-0">Join our mailing list</h2><div class="mb-6"></div><div>Sign up for our Capital Markets Update, a monthly newsletter with insights, updates and invitations from the NYSE.</div>