}</style></div></div><script>(function(w){const CMS2 = w.CMS2 = w.CMS2 || {hydrationQueue:[]};CMS2.hydrationQueue.push({"pageId":90068,"renderContext":{"isCmsAdmin":false,"isCmsEditor":false,"isCmsPreview":false,"isCmsDemo":false,"publishDate":1784638432593,"pageId":90068,"pageTitle":"Listing at NYSE","pageBreadCrumbTitle":"","pageStatus":"published","urlPath":"/listings","query":{},"siteId":10622,"siteDomain":"nyse.com","siteName":"nyse","cdnBaseUrl":"https://static.nyse.com","requestPath":"/listings","version":"41.10.17","theme":"nyse","ssoBaseUrl":"https://sso.ice.com","injectable":true,"gtmId":"GTM-N6K229P","hydrate":true,"favicon":"/publicdocs/images/favicon_nyse_2022.gif","faviconType":"image/gif","appBaseUrl":"http://localnyse:3000","appProxyUrl":"/api/sites/nyse/proxy"},"featureFlags":{"removeInjectedHeadElements":true},"headTags":[{"id":"title","type":"title","props":{"children":"Listing at NYSE"}},{"id":"2361c329-346f-46e2-b458-57636ca8984b","name":"og:description","type":"meta","value":"At the NYSE, we spend a lot of time thinking about the unique needs of every potential listing. No two companies are identical. We work hard to provide the best IPO experience and ongoing support for every company, large or small, from every industry sector. Businesses today need flexibility and transparency to meet evolving customer, talent and market demands. "},{"id":"https://static.nyse.com/cms/41.10.17/assets/nyse.css","type":"link","props":{"rel":"stylesheet","href":"https://static.nyse.com/cms/41.10.17/assets/nyse.css"}},{"id":"https://static.nyse.com/cms/41.10.17/hydrate.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/hydrate.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/demos-DhThR4g2.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/demos-DhThR4g2.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/date-fns@2-30-0/node_modules/date-fns/addYears/index-js-commonjs-es-import-wvD8i_oy.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/date-fns@2-30-0/node_modules/date-fns/addYears/index-js-commonjs-es-import-wvD8i_oy.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/@theice-pushpop@3-5-0_@types-express@4-17-25/node_modules/@theice/pushpop/build/array/replace-BIxldC1J.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/@theice-pushpop@3-5-0_@types-express@4-17-25/node_modules/@theice/pushpop/build/array/replace-BIxldC1J.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/shared/utils/shouldUseProxy-Bv9cgI89.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/shared/utils/shouldUseProxy-Bv9cgI89.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks//var/opt/jenkins/workspace/ont-end-monorepo_release_2026-40/packages/website-components/build/components/feedback/Spinner-DWFnkFxu.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks//var/opt/jenkins/workspace/ont-end-monorepo_release_2026-40/packages/website-components/build/components/feedback/Spinner-DWFnkFxu.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/react-router@6-30-4_react@18-3-1/node_modules/react-router/dist/index-js-commonjs-proxy-DScuS9fV.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/react-router@6-30-4_react@18-3-1/node_modules/react-router/dist/index-js-commonjs-proxy-DScuS9fV.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/main-B_XpGw9E.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/main-B_XpGw9E.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/meta-8QECb7rV.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/meta-8QECb7rV.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/shared/breadcrumb-context/BreadCrumbContext-Ciq78Fk2.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/shared/breadcrumb-context/BreadCrumbContext-Ciq78Fk2.js"}},{"id":"https://static.nyse.com/cms/41.10.17/chunks/shared/utils/isCmsTemplateName-CHdGwdya.js","type":"link","props":{"rel":"modulepreload","href":"https://static.nyse.com/cms/41.10.17/chunks/shared/utils/isCmsTemplateName-CHdGwdya.js"}},{"id":"__cms__site-favicon","type":"link","props":{"rel":"shortcut icon","href":"/publicdocs/images/favicon_nyse_2022.gif","type":"image/gif"}}],"scriptTags":[],"template":{"id":"32db9f3b-b257-4b83-8bff-a9ab6eb0b236","name":"cms-template-nyse-page","props":{"slots":{"body":[{"id":"cf8e43e4-63b3-42e4-853a-9d18216831ec","name":"cms-component-layout-nyse-page-2022","props":{"slots":{"hero":[{"id":"a4536586-5438-4641-9cf0-51cc09c674d6","name":"cms-component-hero","props":{"slots":{"contentA":[{"id":"fef7c3df-9c49-462b-9622-00703803abcf","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h1","children":[{"text":"Listings "}]}]}},{"id":"9cbb6fc6-00a4-421c-8f5e-77b90a69887b","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"8a6fac99-b7f1-4609-9be0-dc79a63d5252","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h3","children":[{"text":"Why list on the NYSE?"}]}]}},{"id":"805f1ffe-e5b5-4046-a8fb-566ab9ff9afa","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"d10df7f8-4608-48f0-bb4f-9d82f4c1a62a","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{"text":"The New York Stock Exchange is the world’s largest equities exchange and the gold standard for trading technology – and has been for over 200 years. Our community of NYSE-listed global business icons and innovators in every industry includes 74% of the publicly listed Fortune 500 and 70% of the S&P 500 (as of 5/12/2025). We support our community with best-in-class services, public company advocacy, better trading, and an expansive media network."}]},{"size":"sm","type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Contact us about joining the world's largest exchange."}]},{"type":"paragraph","children":[{},{"href":"#new-ipo","icon":"MoveRightIcon","type":"link","wide":true,"children":[{"text":"Contact Us"}],"isButton":true},{}]}]}}],"contentB":[{"id":"54b20aaf-f5db-4b4f-b606-184e61c267f3","name":"cms-component-popup-video","props":{"slots":{"trigger-container":[]},"hash":"#play","size":"large","bgColor":"dark","launchOn":"thumbnail-click","accountId":"5805274531001","contentId":"6386556833112"}},{"id":"470a8560-63c4-4da7-bfd6-21fe997178f8","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"6618948b-6dc0-4fe4-a209-ac851d81bddb","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{"text":"2025 was another history-making year for the NYSE. We hosted seven of the ten largest US IPOs and led in large tech IPOs, representing nearly 70% of proceeds raised. We also launched NYSE Texas, the first securities exchange in Texas, and reached a milestone of 100 dual listings. "},{"text":"Welcome to the public market.","italic":true}]}]}}]},"box1bg":"black","box2bg":"primary","variant":"multi-box","box1Text":"white","imageAlt":"Hinge Health IPO - Celebrating in front of the NYSE facade","imageFit":"cover","imageSrc":"https://www.nyse.com/publicdocs/images/Hero-NYSE-Listings-Hinge-1920x550.jpg","alignBoxes":"alignBoxBottoms"}}],"main":[{"id":"ff56638b-5e56-45cb-8e5b-e587ba5ef2ba","name":"cms-component-spacer","props":{"slots":{},"size":"lg"}},{"id":"75dd5334-f02f-43e5-85ba-efde419a5f32","name":"cms-component-flex-row","props":{"slots":{"234f4e35-064c-4665-81d4-47f6a6c8e567":[{"id":"2a0de46b-657f-40d9-9dc0-f9f25de3d844","name":"cms-component-image","props":{"slots":{},"alt":"Rubrik at Experience Square","src":"/publicdocs/images/Rubrik_Experience_Square.jpg","openInNewWindow":false}}],"27048f07-719a-403e-8df5-e07f769d2f2e":[{"id":"5b6663ef-d815-4a5e-9bbf-b582d08f7fcf","name":"cms-component-image","props":{"slots":{},"alt":"NYSE logo","src":"/publicdocs/images/NYSE_Logo_Primary.svg","width":"32"}},{"id":"15cc1dcf-de3d-4f24-8ea0-ba29d52703d1","name":"cms-component-spacer","props":{"slots":{},"size":"lg"}},{"id":"36f6f5e3-a611-48b4-856f-4f8d5966f98e","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{}]},{"type":"h3","children":[{"text":"The NYSE Advantage"}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"NYSE’s "},{"href":"/community","type":"link","children":[{"text":"community"}]},{"text":" and the "},{"href":"/global-advisory","type":"link","children":[{"text":"resources and services"}]},{"text":" we provide them are unparalleled. And as the world’s largest primary listings exchange, we have invested heavily in our industry-leading technology, Pillar, which underpins much of today’s highly sophisticated electronic marketplace. While Pillar leans heavily on speed and automation, our trading model pairs cutting-edge technology with human discretion for the most important liquidity events each trading day, the opening and closing auctions. This unique approach leads to larger, more flexible auctions with the broadest possible participation, contributing to lower volatility and tighter spreads around these key events. When our issuers need us most – on IPO day, a major index rebalance, or when unexpected volatility surfaces – we are there to deliver in ways that technology alone could not. "}]},{"type":"paragraph","children":[{},{"href":"/data-insights/its-academic-nyse-listed-stocks-receive-superior-market-quality","icon":"MoveRightIcon","type":"link","wide":false,"children":[{"text":"Learn more about listing on the NYSE"}],"isButton":false},{}]}]}}]},"gap":8,"rowCols":[{"id":"27048f07-719a-403e-8df5-e07f769d2f2e","gap":0,"flex":"1","justify":"center","advanced":{"basis":0}},{"id":"234f4e35-064c-4665-81d4-47f6a6c8e567","gap":0,"flex":"1","justify":"center","advanced":{"basis":0}}],"columnBreakpoint":"xl","removeGapOnColumnBreakpoint":false},"layout":{"default":{"pb":16}}},{"id":"b664680a-2393-4475-968a-aad6e6b2d7c0","name":"cms-component-box","props":{"slots":{"content":[{"id":"af836d74-010b-49b1-b922-2c382f9dab3a","name":"cms-component-box","props":{"slots":{"content":[{"id":"761d572f-1e4c-41ad-8c52-fda314dcef92","name":"cms-component-belt","props":{"slots":{"content":[{"id":"1a9ef7da-f5c5-4393-8ab1-b2b7840b6cae","name":"cms-component-flex-column","props":{"slots":{"content":[{"id":"1c630679-3ae2-42bd-9dae-adb97e0258ca","name":"cms-component-image","props":{"slots":{},"alt":"NYSE logo","src":"/publicdocs/images/NYSE_Logo_Primary.svg","width":"20"}}]},"gap":0,"items":"center"}},{"id":"545b3a18-773f-4002-a21f-e4a98be91540","name":"cms-component-spacer","props":{"slots":{},"size":"lg"}},{"id":"ba4437f9-be1f-4ee2-bb75-d1bc032ec6e9","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h2","children":[{"text":"The world's critical trading infrastructure runs on ICE."}]},{"size":"md","type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"NYSE, the world’s largest equities exchange, is part of Intercontinental Exchange (NYSE:ICE). The "},{"href":"https://www.ice.com/about/exchanges-clearing","type":"link","children":[{"text":"ICE family of exchanges"}],"linkColor":"black"},{"text":" includes some of the world’s largest derivatives exchanges. ICE is the largest energy exchange in the world and its markets offer trading in commodities, environmental derivatives and interest rates. ICE is also the seventh largest index provider globally, with over $2 trillion in global assets benchmarked to ICE indices."}]}]}]}}]},"spacing":"normal"}}]},"xl":{"width":"full","paddingTop":"12","paddingLeft":"0","paddingRight":"0","paddingBottom":"12"},"width":"full","presets":{"bgColor":"gray","display":"col","textColor":"black"},"paddingTop":"10","paddingLeft":"10","paddingRight":"10","paddingBottom":"10"}}]},"xl":{"paddingBottom":"20"},"paddingBottom":"10"}},{"id":"ea126865-d448-4cbd-918c-0a73432de29b","name":"cms-component-belt","props":{"slots":{"content":[{"id":"e141a2a3-0803-42fe-93b5-a55043f21a52","name":"cms-component-belt","props":{"slots":{"content":[{"id":"08a11416-894a-4eda-94f3-37964c4c27c8","name":"cms-component-flex-row","props":{"slots":{"234f4e35-064c-4665-81d4-47f6a6c8e567":[{"id":"677a49c9-eccb-4c35-97a4-d5e2feaa6e39","name":"cms-component-image","props":{"slots":{},"alt":"Reddit Snoo ringing the NYSE Opening Bell","src":"/publicdocs/images/Reddit_bell.png"}},{"id":"d6ce6e9e-ce79-4446-b31a-66cd120a095a","name":"cms-component-popup-video","props":{"slots":{"trigger-container":[]},"hash":"#reddit","size":"medium","launchOn":"launcher-click","contentId":"6349818083112","triggerId":"#reddit"}}],"27048f07-719a-403e-8df5-e07f769d2f2e":[{"id":"10ba7fd6-84d1-47d8-bae8-a0748f3c1d44","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"left","children":[{"type":"h3","children":[{"text":"The meaning of NYSE-Listed"}]},{"type":"h3","children":[{"textSize":"1.25"}]},{"size":"sm","type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Reddit ("},{"href":"/quote/XNYS:RDDT","type":"link","children":[{"text":"NYSE:RDDT"}],"linkColor":"primary"},{"text":") is on a mission to bring community belonging and empowerment to everyone in the world. They brought that mission to Wall Street for their public debut, transforming the NYSE into a playground for Reddit employees to celebrate their listing day, with Snoo hunts and ‘easter eggs’ throughout the building, and a mini golf course that traced Reddit’s history and celebrated some of its favorite subreddits."}]},{"type":"paragraph","children":[{"text":"At the center of everything they do is the Reddit community. In a twist on how most companies choose to open the markets on their Listing Day, it was Snoo, and not the executive team, who rang the Opening Bell. "}]},{"type":"paragraph","children":[{"text":"The possibilities do not end there. NYSE is part of Intercontinental Exchange (NYSE: ICE), which separately agreed with Reddit to "},{"href":"https://ir.theice.com/press/news-details/2025/Intercontinental-Exchange-and-Reddit-Collaborate-to-Create-and-Distribute-Data-Products-for-Capital-Markets/default.aspx","type":"link","children":[{"text":"leverage their data API","underlined":true}],"linkColor":"white"},{"text":" to develop new products for the financial industry."}]},{"type":"paragraph","children":[{},{"href":"#reddit","icon":"MoveRightIcon","type":"link","variant":"black","children":[{"text":"Watch now "}],"isButton":true},{}]},{"type":"div","children":[{}]}]}]},"layout":{"default":{"text":"white"}}}]},"gap":10,"rowCols":[{"id":"27048f07-719a-403e-8df5-e07f769d2f2e","gap":0,"flex":"1","advanced":{"basis":0}},{"id":"234f4e35-064c-4665-81d4-47f6a6c8e567","gap":0,"flex":"1","advanced":{"basis":0}}],"columnBreakpoint":"lg"}}]},"spacing":"normal"},"layout":{"default":{"bg":"black","pt":10,"pb":10},"xl":{"pt":16,"pb":16}}}]},"reverse":true},"layout":{"default":{"mt":10,"mb":10},"xl":{"mb":20}}},{"id":"57ad6704-e113-495d-a0f1-63a56a225c78","name":"cms-component-flex-row","props":{"slots":{"234f4e35-064c-4665-81d4-47f6a6c8e567":[{"id":"8289f46f-fb82-4b72-91f0-29c367485560","name":"cms-component-image","props":{"slots":{},"alt":"NYSE Trading Floor","src":"/publicdocs/images/NYSE_Trading_Floor_New_Branding-alt.jpg"}}],"27048f07-719a-403e-8df5-e07f769d2f2e":[{"id":"9eadc180-ad03-4c1c-941d-31d328dc2102","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h3","children":[{"text":"Recently Listed"}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Standards are higher here. 70% of US IPOs in 2024 did not qualify to list on the NYSE. Of the ones that did, we hosted two of the three largest U.S. IPOs in 2024, Viking Holdings ("},{"href":"/quote/XNYSE:VIK","type":"link","children":[{"text":"NYSE:VIK"}]},{"text":") and Standard Aero ("},{"href":"/quote/XNYSE:SARO","type":"link","children":[{"text":"NYSE:SARO"}]},{"text":")."}]},{"type":"paragraph","children":[{"text":"Recently listed tech companies include Karman Space & Defense ("},{"href":"/quote/XNYSE:KRMN","type":"link","children":[{"text":"NYSE:KRMN"}]},{"text":"), Ingram Micro ("},{"href":"/quote/XNYSE:INGM","type":"link","children":[{"text":"NYSE:INGM"}]},{"text":"), Oklo ("},{"href":"/quote/XNYS:OKLO","type":"link","children":[{"text":"NYSE:OKLO"}]},{"text":"), Rubrik ("},{"href":"/quote/XNYS:RBRK","type":"link","children":[{"text":"NYSE:RBRK"}]},{"text":"), Ibotta ("},{"href":"/quote/XNYS:IBTA","type":"link","children":[{"text":"NYSE:IBTA"}]},{"text":"), and Reddit ("},{"href":"/quote/XNYS:RDDT","type":"link","children":[{"text":"NYSE:RDDT"}]},{"text":")."}]},{"type":"paragraph","children":[{"text":"Iconic brands that recently listed NYSE include GE Aerospace ("},{"href":"/quote/XNYS:GE","type":"link","children":[{"text":"NYSE:GE"}]},{"text":"), GE Vernova ("},{"href":"/quote/XNYS:GEV","type":"link","children":[{"text":"NYSE:GEV"}]},{"text":"), Viking ("},{"href":"/quote/XNYS:VIK","type":"link","children":[{"text":"NYSE:VIK"}]},{"text":"), Flutter Entertainment ("},{"href":"/quote/XNYS:FLUT","type":"link","children":[{"text":"NYSE:FLUT"}]},{"text":"), and Amer Sports ("},{"href":"/quote/XNYS:AMER","type":"link","children":[{"text":"NYSE:AS"}]},{"text":"), the owner of sports brands Arc’teryx, Salomon, Wilson and others. "}]},{"type":"paragraph","children":[{"text":"These companies joined our community of over 2,400 public companies representing icons and innovators across every industry, including "},{"href":"/listings/international-listings","type":"link","children":[{"text":"over 530"}]},{"text":" of the world’s largest and most influential international companies."}]},{"type":"paragraph","children":[{},{"href":"/listings/gallery","icon":"MoveRightIcon","type":"link","wide":false,"children":[{"text":"View our gallery of recent IPOs"}],"isButton":false},{}]},{"type":"paragraph","children":[{},{"href":"/community","icon":"MoveRightIcon","type":"link","wide":false,"children":[{"text":"Learn more about the NYSE Community"}],"isButton":false},{}]},{"type":"paragraph","children":[{}]},{"type":"align","align":"center","children":[{}]}]}}]},"gap":10,"rowCols":[{"id":"27048f07-719a-403e-8df5-e07f769d2f2e","gap":0,"flex":"1","advanced":{"basis":0}},{"id":"234f4e35-064c-4665-81d4-47f6a6c8e567","gap":0,"flex":"1","advanced":{"basis":0}}],"columnBreakpoint":"lg"}},{"id":"cf0cfc47-dc56-4601-b2f7-1cb1868d7ef6","name":"cms-component-belt","props":{"slots":{"content":[{"id":"f7b8765c-ebbf-4d7d-9513-dae262e78f35","name":"cms-component-belt","props":{"slots":{"content":[{"id":"52558fda-0f7c-44a1-aa2c-1b8385f16dea","name":"cms-component-flex-row","props":{"slots":{"27048f07-719a-403e-8df5-e07f769d2f2e":[{"id":"87a75143-87d1-476f-9792-7de21e2a32cd","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"left","children":[{"type":"h3","children":[{"text":"Resources & Services"}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"Founded on six pillars of excellence, NYSE Global Advisory delivers unparalleled knowledge on topics that can help guide your decision-making, navigate uncertainties and capitalize on trends. "}]},{"type":"paragraph","children":[{"text":"Access a suite of expertise and services that can help you excel as a public company, including "},{"href":"/board-services","type":"link","children":[{"text":"Board Services"}],"linkColor":"primary"},{"text":", "},{"href":"/esg/resource-center","type":"link","children":[{"text":"ESG Advisory"}],"linkColor":"primary"},{"text":", "},{"href":"/nyse-institute","type":"link","children":[{"text":"Issuer Advocacy"}],"linkColor":"primary"},{"text":", "},{"href":"/corporate-services","type":"link","children":[{"text":"Corporate Services"}],"linkColor":"primary"},{"text":", "},{"href":"/research#mac-desk","type":"link","children":[{"text":"Market Insights,"}],"linkColor":"primary"},{"text":" and "},{"href":"/global-advisory#index-services","type":"link","children":[{"text":"Index Advisory"}],"linkColor":"primary"},{"text":". Global Advisory services are included in your NYSE listing. "}]},{"type":"paragraph","children":[{},{"href":"/global-advisory","icon":"MoveRightIcon","type":"link","wide":true,"variant":"black","children":[{"text":"Learn more "}],"isButton":true},{}]}]}]},"layout":{"default":{"text":"white"},"xl":{"text":"white"}}}],"c4e27c55-ffbb-44aa-a36a-13189b0b0394":[{"id":"1119cc26-3f36-4991-9f21-7f5724bd7328","name":"cms-component-image","props":{"slots":{},"alt":"ESG Office building and employees","src":"/publicdocs/images/Hero-Professional_Settings-16x9-39.jpg","objectFit":"cover"}}]},"gap":10,"rowCols":[{"id":"27048f07-719a-403e-8df5-e07f769d2f2e","gap":0,"flex":"1","advanced":{"basis":0}},{"id":"c4e27c55-ffbb-44aa-a36a-13189b0b0394","gap":0,"flex":"1","advanced":{"basis":0}}],"columnBreakpoint":"lg","removeGapOnColumnBreakpoint":false}}]}},"layout":{"default":{"bg":"black","mt":10,"pt":10,"pb":10},"xl":{"bg":"","mt":20,"pt":16,"pb":16}}}]},"reverse":true,"spacing":"normal"}},{"id":"b46933e9-caa8-4482-b226-f6779a250580","name":"cms-component-belt","props":{"slots":{"content":[{"id":"2ba7b83e-257d-43e3-8a1a-175f33422d2f","name":"cms-component-belt","props":{"slots":{"content":[{"id":"7477b5bf-5ddb-47fd-a475-58f6672acba0","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h3","children":[{"text":"Exchange Traded Products"}]},{"type":"h2","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{}]},{"type":"paragraph","children":[{"text":"The U.S. ETF marketplace has grown to over $10 trillion in assets under management, providing investors access to over 4,000 ETFs, spanning across different types of assets, including historically difficult to access asset classes, contributing to the continuing the democratization of investing. The NYSE lists more ETPs than any other exchange in the world. "}]},{"type":"paragraph","children":[{"text":"The NYSE has been at the forefront of product development in ETFs, one of the most transformative investment vehicles of the last century since their inception back in 1993. As a center of innovation, the NYSE has been the listing venue of choice for many “firsts,” including the first mutual fund to ETF conversion, the first multi share class ETF, the first digital currency futures ETF and the first private credit ETF. "}]},{"type":"paragraph","children":[{"text":"The NYSE operates two ETF listing venues which collectively offer the largest liquidity enhancement programs and greatest depth of liquidity across all US ETFs. The combination of liquidity, innovative technology solutions and a superior market model provide issuers with the best trading experience in US ETFs."}]},{"type":"paragraph","children":[{}]},{"type":"paragraph","children":[{},{"href":"/products/exchange-traded-products","icon":"MoveRightIcon","type":"link","wide":true,"variant":"black","children":[{"text":"Learn more"}],"isButton":true},{}]}]}}]}},"layout":{"default":{"bg":"primary","pt":10,"pb":10},"xl":{"pt":16,"pb":16}}},{"id":"7103f2a3-8c4f-426a-9240-7729581c46fe","name":"cms-component-belt","props":{"slots":{"content":[{"id":"b747755d-940d-41b7-b20e-d87bff5023e3","name":"cms-component-belt","props":{"slots":{"content":[{"id":"210914bf-694b-40fe-8c8b-1fc149272c30","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h2","children":[{"text":"Join our mailing list"}],"isBottomSpacingEnabled":false,"isHeadingAutoSizeEnabled":false},{"size":"md","type":"spacer","children":[{}]},{"type":"div","children":[{"text":"Sign up for our Capital Markets Update, a monthly newsletter with insights, updates and invitations from the NYSE."}]},{"type":"spacer","children":[{}]},{"type":"div","children":[{},{"href":"#newsletter","icon":"MoveRightIcon","type":"link","wide":true,"children":[{"text":"Subscribe now"}],"isButton":true,"buttonBorder":true},{}]}]}]}}]},"reverse":false,"spacing":"normal"},"layout":{"default":{"bg":"black","text":"white","pt":10,"pb":10},"lg":{"pt":16,"pb":16}}}]},"reverse":true,"spacing":"normal"}},{"id":"21f4859b-b31b-491b-bb24-58d20f878646","name":"cms-component-spacer","props":{"slots":{},"size":"xl"}}]},"reverse":true,"spacing":"normal"}},{"id":"7bdeb59d-22f5-4147-a420-0e1df8d7c7e8","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h2","children":[{"text":"NYSE Insights"}]},{"type":"h2","children":[{}]},{"type":"hr","color":"black","center":true,"narrow":true,"variant":"solid","children":[{}]},{"type":"paragraph","children":[{"text":"C-Suite perspectives, industry news, market insights, and other news you can use."}]}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"caca56fa-c633-41af-ad11-a9e7f4590de8","name":"cms-component-tile-row-2022","props":{"slots":{"content":[{"id":"a5a0143b-f40c-40be-8fa8-f3c823e3e8bc","name":"cms-component-tile-2022","props":{"slots":{"cta":[{"id":"fb2b276a-26e0-4f64-8b4c-ab83affae7a0","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"paragraph","children":[{},{"href":"/index#going-public","icon":"MoveRightIcon","type":"link","wide":true,"variant":"black","children":[{"text":"WAtch now"}],"isButton":true},{}]}]}]}}],"content":[{"id":"d3c27f14-c361-4950-bc97-5e9a89d19af3","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"paragraph","children":[{"text":"What does it take to go public in 2025? Ryan Hinkle draws on twenty years of investing at Insight Partners, one of the most prolific global software investors, and shares his advice for SaaS startups preparing to go public."}]}]}]}}]},"title":"Going Public","border":"primary","textCenter":true}},{"id":"78b8c775-a897-4657-91d9-e711aefada49","name":"cms-component-tile-2022","props":{"slots":{"cta":[{"id":"87c14fad-b4e0-43d6-ba12-ac92bb71b754","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"paragraph","children":[{},{"href":"/research/insights/the-early-bird-gets-the-worm-a-new-normal-in-off-hours-us-equities-trading","icon":"MoveRightIcon","type":"link","wide":true,"target":"_blank","variant":"black","children":[{"text":"Learn more"}],"isButton":true},{}]}]}]}}],"content":[{"id":"06c4073e-b01f-4cc4-82ca-984adfad1188","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"paragraph","children":[{"text":"NYSE announced plans to extend weekday US equities trading on NYSE Arca to 22 hours a day, subject to regulatory approval. Read how growing global demand for US-listed securities has led to a new normal in off-hours liquidity. "}]}]}]}}]},"title":"NYSE Research","border":"primary","textCenter":true,"linkUrlNewWindow":false}},{"id":"49ff610c-4e9b-43c6-a4e4-764f99176f32","name":"cms-component-tile-2022","props":{"slots":{"cta":[{"id":"bd048e82-e6fc-41e6-82ca-52a5460bc7fe","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"paragraph","children":[{},{"href":"https://www.cnbc.com/2025/04/14/nyse-president-systems-are-handling-record-volume-more-efficiently-than-during-covid-crash.html","icon":"MoveRightIcon","type":"link","wide":true,"target":"_blank","variant":"black","children":[{"text":"Read now "}],"isButton":true},{}]}]}]}}],"content":[{"id":"7713ae03-51f3-4663-a49c-fd9c64e5fa5d","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"paragraph","children":[{"text":"Purpose built for volatility. With swings in the Dow, S&P 500 and other major indices this April, NYSE witnessed a record volume of trades, messages, and participation in opening and closing auctions. Read how we are meeting the challenge posed by recent volatility."}]}]}]}}]},"title":"Interesting Times","border":"primary","textCenter":true}}]},"displayCol":false,"isCarousel":true}},{"id":"523dde17-87b4-41f1-ad00-258841bc8807","name":"cms-component-modal","props":{"slots":{"content":[{"id":"d170b9dc-0698-4ec2-8458-47268bd8ec84","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"deac08c7-a28c-45bf-aee1-28775d64f1cd","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h5","children":[{"bold":true,"text":"Sign up for our Capital Markets Update"}]}]}]}},{"id":"34d994c2-87ba-4780-9d7c-0f0edaaf2569","name":"cms-component-spacer","props":{"slots":{},"size":"md"}},{"id":"5a3b10eb-f957-43c6-841d-3663d87aa1f7","name":"cms-component-form-eloqua","props":{"slots":{"fields":[{"id":"e3fcb32e-16a6-45a1-ae9f-159b53bf15a3","name":"cms-component-form-field","props":{"slots":{},"name":"firstName","type":"TEXT","value":"","options":[],"isRequired":true,"displayName":"First Name"}},{"id":"03edfd94-9eab-4c9a-9a17-55a9c1aa7717","name":"cms-component-form-field","props":{"slots":{},"name":"las