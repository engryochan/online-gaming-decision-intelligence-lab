#accordeonck849 li.level3.parent.open > span span.toggler_icon { background: url(/) center center no-repeat !important;}
#accordeonck849 li.level1 > span {  } 
#accordeonck849 li.level1 > span a { padding-top: 8px;padding-right: 6px;padding-bottom: 8px;padding-left: 6px;color: #F7F8FF;font-size: 12px;font-weight: normal; } 
