];



$.watchlist = {
  cookie: "",
  init: function() {
    this.cookie = readCookie("watchlist");
    $(".watchlist.check").each(function(){$.watchlist.check(this)});
  },
  check: function(element) {
     let wkn = $(element).data("wkn");
     $.ajax({
           url: "/_rpc/json/.lstc/_shared/base/wlCheck",
                                data: {
                                wkn: wkn
                            },
                                type: 'POST',
           dataType: "json",
           success: function( response ) {
                 if(response.status) {
                    $(element).addClass("active").attr("title", "Von Watchlist entfernen");
           if($(element).find("button span.plusminus").hasClass("bi-plus-lg")) {
             $(element).find("button span.plusminus").removeClass("bi-plus-lg").addClass("bi-dash-lg");
           } else {
             $(element).find("button span.plusminus").removeClass("bi-plus").addClass("bi-dash");
           }
           $(element).find("button span:not(.plusminus)").removeClass("bi-eye-fill").addClass("bi-eye-slash-fill");
           }},
           error: function() {
           }
     });
  },
  handle: function(trigger) {
    if($(trigger).hasClass("active")) {
      this.remove($(trigger).data("wkn"));
      $(trigger).removeClass("active").attr("title", "Zur Watchlist hinzufügen");
      if($(trigger).find("button span.plusminus").hasClass("bi-dash-lg")) {
          $(trigger).find("button span.plusminus").removeClass("bi-dash-lg").addClass("bi-plus-lg");
      } else {
          $(trigger).find("button span.plusminus").removeClass("bi-dash").addClass("bi-plus");
      }
      $(trigger).find("button span:not(.plusminus)").removeClass("bi-eye-slash-fill").addClass("bi-eye-fill");
    } else {
      this.add($(trigger).data("wkn"));
      $(trigger).addClass("active").attr("title", "Von Watchlist entfernen");
      if($(trigger).find("button span.plusminus").hasClass("bi-plus-lg")) {
          $(trigger).find("button span.plusminus").removeClass("bi-plus-lg").addClass("bi-dash-lg");
      } else {
          $(trigger).find("button span.plusminus").removeClass("bi-plus").addClass("bi-dash");
      }
      $(trigger).find("button span:not(.plusminus)").removeClass("bi-eye-fill").addClass("bi-eye-slash-fill");
    }
  }
  ,add: function(wkn) {
     $.ajax({
           url: "/_rpc/json/.lstc/_shared/base/wlAdd",
                                data: {
                                wkn: wkn
                            },
                                type: 'POST',
           dataType: "json",
           success: function( response ) {
                 
           },
           error: function() {
           }
     });
  }
  ,remove: function(wkn) {
     $.ajax({
           url: "/_rpc/json/.lstc/_shared/base/wlRm",
                                data: {
                                wkn: wkn
                            },
                                type: 'POST',
           dataType: "json",
           success: function( response ) {
                 
           },
           error: function() {
           }
     });
  }
  ,save: function() {
     createCookie("watchlist", this.cookie, 3650);
  }
};

$.watchlist.init();


$("body").on("click", "span.watchlist", function(){
  $.watchlist.handle(this);
});
$("body").on("click", "span.watchlistremove", function(){
  $.watchlist.remove($(this).data("wkn"));$(this).parents("tr").remove();
});







var instruments = new Bloodhound({
    datumTokenizer: Bloodhound.tokenizers.obj.whitespace('displayname'),
    queryTokenizer: Bloodhound.tokenizers.whitespace,
    remote: '/_rpc/json/.lstc/instrument/search/main?q=%QUERY&' + "localeId=" + current_locale
});

instruments.initialize();

function searchProxy(q, sync) {
    if(q === '') {
        sync(searchDefaults);
    } else {
        instruments.ttAdapter()(q, sync);
    }
}

$('#globalsearch .typeahead').typeahead(
    {
        minLength: 0,
        highlight: true
    },
    {
    autoselect: true,
    name: 'instrumentsearch',
    displayKey: 'displayname',
    source: searchProxy, /*instruments.ttAdapter(),*/
    templates: {
        suggestion: Handlebars.compile("<span class=\"displayName\">{{displayname}}</span><span class=\"wkn\">{{wkn}}</span><span class=\"categoryName\">{{categoryName}}</span>")
    }
});

$('#globalsearch .typeahead').on("typeahead:cursorchanged typeahead:autocompleted", function (a, b, c) {
});
$('#globalsearch .typeahead').on("typeahead:selected", function (a, b, c) {
    document.location = b.link;
});

/* hack to show suggestions on entering the search the first time */
$('#globalsearch .typeahead').on('click', function (e) {
    var ev = $.Event("keydown");
    ev.keyCode = ev.which = 40;
    $(this).trigger(ev);
    return true;
});

$('#globalsearch .typeahead').on('keyup', function (e) {
    if (e.which == 13) {
        var suggestions = $("#globalsearch .tt-dataset-instrumentsearch .tt-suggestion");

        if (suggestions.length > 1) {
            suggestions.eq(0).trigger("mouseover");
        } else {
            suggestions.eq(0).trigger("click");
        }
    }
});
