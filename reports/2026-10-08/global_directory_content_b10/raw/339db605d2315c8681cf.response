var searchDefaults = [
  {wkn:"LUSDAX", displayname:"Dax", categoryName:"Index", link: "/de/index/lus-dax"},
  {wkn:"965515", displayname:"Gold", categoryName:"Rohstoff", link: "/de/rohstoff/goldpreis"},
