try {
  var mode = localStorage.getItem('theme-mode') || 'light';
  var colorScheme = '';
  if (mode === 'system') {
    // handle system mode
    var mql = window.matchMedia('(prefers-color-scheme: dark)');
    if (mql.matches) {
      colorScheme = localStorage.getItem('mui-color-scheme-dark') || 'dark';
    } else {
      colorScheme = localStorage.getItem('mui-color-scheme-light') || 'light';
    }
  }
  if (mode === 'light') {
    colorScheme = localStorage.getItem('mui-color-scheme-light') || 'light';
  }
  if (mode === 'dark') {
    colorScheme = localStorage.getItem('mui-color-scheme-dark') || 'dark';
  }
  if (colorScheme) {
    document.documentElement.setAttribute('data-mui-color-scheme', colorScheme);
  }
} catch(e){}})();</script><!--$--><!--/$--><div id="google_translate_element" style="width:100%;display:block"></div><!--$--><!--/$--><script src="/_next/static/chunks/webpack-aec6bf136daeb8aa.js" async=""></script><script>(self.__next_f=self.__next_f||[]).push([0]);self.__next_f.push([2,null])</script><script>self.__next_f.push([1,"1:HL[\"/_next/static/css/32ee734107546e5d.css\",\"style\"]\n2:HL[\"/_next/static/css/c48fbed12e974ff5.css\",\"style\"]\n"])</script><script>self.__next_f.push([1,"3:I[12846,[],\"\"]\n5:I[96595,[\"3572\",\"static/chunks/70e0d97a-d96315f369933dc4.js\",\"7902\",\"static/chunks/54a60aa6-7054243b57f51ee0.js\",\"2471\",\"static/chunks/2471-9d71c04aed0b6c04.js\",\"5047\",\"static/chunks/5047-5c34f8faf8deaec1.js\",\"2939\",\"static/chunks/2939-7053786d3a717ce9.js\",\"4940\",\"static/chunks/4940-434e40dddd1ea352.js\",\"3584\",\"static/chunks/3584-610182c0d22f7008.js\",\"1976\",\"static/chunks/1976-a362df452fd2116b.js\",\"2841\",\"static/chunks/2841-662426e10b776aa1.js\",\"4438\",\"static/chunks/4438-6fa0cb06360af70d.js\",\"7072\",\"static/chunks/7072-45fd77ce0bd343d0.js\",\"7995\",\"static/chunks/7995-3873bee4b7236bbd.js\",\"7798\",\"static/chunks/7798-568bb49c79b2e9aa.js\",\"7045\",\"static/chunks/7045-4c160d84cb88cb0e.js\",\"5845\",\"static/chunks/5845-5da773336aaa539f.js\",\"5371\",\"static/chunks/5371-45556adb11f70009.js\",\"2800\",\"static/chunks/2800-93f80538f5aa3de7.js\",\"8177\",\"static/chunks/8177-d8d06e06475e22da.js\",\"9287\",\"static/chunks/9287-ba8935b89e2a35af.js\",\"8285\",\"static/chunks/8285-d616bdf941e133d7.js\",\"9621\",\"static/chunks/9621-ae8f0e86995503c9.js\",\"2239\",\"static/chunks/2239-5d5a1d155f5e025d.js\",\"6637\",\"static/chunks/6637-f813c1cb83d0df00.js\",\"7552\",\"static/chunks/7552-e013c6442e98fea3.js\",\"5790\",\"static/chunks/5790-20124776485e436e.js\",\"6253\",\"static/chunks/app/auth/sign-in-broker/page-aef0e1561e0ea564.js\"],\"JwtSignInViewBroker\"]\n6:I[71398,[\"2471\",\"static/chunks/2471-9d71c04aed0b6c04.js