<div  class='container-fluid prefooter-cmc' >
<div  class='container' >
<div  class='row' >
<div  class='col-12' >
<div id="footer-container" class="js-cmc-footer-01"></div>
<p>
<script>
const temas = [
{ nombre: "Entorno económico", link: "/es/esfera/entorno-economico" },
{ nombre: "Bienestar", link: "/es/esfera/bienestar" },
{ nombre: "Aprender", link: "/es/esfera/aprender" },
{ nombre: "Emprender", link: "/es/esfera/emprender" },
{ nombre: "Compromiso", link: "/es/esfera/compromiso" },
{ nombre: "Innovación", link: "/es/esfera/innovacion" }
];
function generateUtagLinkCode(linkUrl, linkName, eventAction) {
if (typeof utag_data !== 'undefined') {
const obj = {
page_name: utag_data.page_name,
page_section: utag_data.page_section,
page_category: utag_data.page_category,
page_subcategory1: utag_data.page_subcategory1,
page_subcategory2: utag_data.page_subcategory2,
page_subcategory3: utag_data.page_subcategory3,
page_subcategory4: utag_data.page_subcategory4,
page_subcategory5: utag_data.page_subcategory5,
page_url: linkUrl,
category_name1: '',
category_name2: '',
category_name3: linkName,
tag_name: linkName,
section_name: 'footer',
event_category: 'clic en texto',
event_action: eventAction,
event_label: linkName,
page_name_event: utag_data.page_name,
page_language: utag_data.page_language,
events: 'clic_txt'
};
return `utag.link(${JSON.stringify(obj)}, null, [1])`;
} else {
return '';
}
}
function renderTemasStatic(container) {
const ul = document.createElement('ul');
ul.className = 'cmc-footer-01__list';
const liParent = document.createElement('li');
liParent.className = 'cmc-footer-01__list__item';
const spanParent = document.createElement('span');
spanParent.className = 'cmc-footer-01__list__item__link cmc-footer-01__list__item__link--parent';
spanParent.textContent = "Temas";
liParent.appendChild(spanParent);
ul.appendChild(liParent);
temas.forEach(item => {
const li = document.createElement('li');
li.className = 'cmc-footer-01__list__item';
const spanLink = document.createElement('span');
spanLink.className = 'cmc-footer-01__list__item__link cmc-footer-01__list__item__link--simulated';
spanLink.setAttribute('role', 'link');
spanLink.setAttribute('tabindex', '0');
spanLink.textContent = item.nombre;
const url = window.location.origin + item.link;
const utagCode = generateUtagLinkCode(url, item.nombre, "Temas");
/*if (utagCode) {
spanLink.setAttribute('onclick', `${utagCode};`);
}*/
spanLink.addEventListener('click', (e) => {
if (utagCode) eval(utagCode);
if (e.ctrlKey || e.metaKey) {
window.open(url, '_blank');
} else {
window.location.href = url;
}
});
spanLink.addEventListener('mousedown', (e) => {
if (e.button === 1) {
e.preventDefault();
if (utagCode) eval(utagCode);
window.open(url, '_blank');
}
});
spanLink.addEventListener('keypress', (e) => {
if (e.key === 'Enter') {
if (utagCode) eval(utagCode);
window.location.href = url;
}
});
li.appendChild(spanLink);
ul.appendChild(li);
});
container.appendChild(ul);
}
function decodeHTMLEntities(str) {
const textarea = document.createElement('textarea');
textarea.innerHTML = str;
return textarea.value;
}
function renderDynamicSections(data) {
const container = document.getElementById('footer-container');
const footerDiv = document.createElement('div');
footerDiv.className = 'cmc-footer-01';
renderTemasStatic(footerDiv);
const desiredOrder = ["1", "3", "5"];
const level1Categories = desiredOrder
.map(id => data.find(cat => cat.idTaxonomia === id && cat.level === "1" && cat.visiblePrefooter === "S"))
.filter(Boolean);
level1Categories.forEach(categoria => {
const ul = document.createElement('ul');
ul.className = 'cmc-footer-01__list';
const liParent = document.createElement('li');
liParent.className = 'cmc-footer-01__list__item';
const span = document.createElement('span');
span.className = 'cmc-footer-01__list__item__link cmc-footer-01__list__item__link--parent';
span.textContent = categoria.nombre;
liParent.appendChild(span);
ul.appendChild(liParent);
if (categoria.children) {
const visibleChildren = categoria.children
.filter(child => child.level === "2" && child.visiblePrefooter === "S")
.slice(0, 6); // <-- limit to 6 items
visibleChildren.forEach(child => {
const li = document.createElement('li');
li.className = 'cmc-footer-01__list__item';
const a = document.createElement('a');
a.className = 'cmc-footer-01__list__item__link';
a.href = child.link;
a.textContent = child.nombre;
const utagCode = generateUtagLinkCode(child.link, child.nombre, categoria.nombre);
/*if (utagCode) {
a.setAttribute('onclick', `${utagCode};`);
}*/
a.addEventListener('click', (e) => {
if (utagCode) eval(utagCode);
});
li.appendChild(a);
ul.appendChild(li);
});
}
const liSeeMore = document.createElement('li');
liSeeMore.className = 'cmc-footer-01__list__item';
const aSeeMore = document.createElement('a');
aSeeMore.className = 'cmc-footer-01__list__item__link cmc-footer-01__list__item__link--see-more';
const seeMoreUrl = `/es/esfera/taxonomia.html?cat=${categoria.idTaxonomia}`;
aSeeMore.href = seeMoreUrl;
aSeeMore.textContent = 'Explorar todos';
const utagCodeSeeMore = generateUtagLinkCode(seeMoreUrl, 'Explorar todos', categoria.nombre);
/*if (utagCodeSeeMore) {
aSeeMore.setAttribute('onclick', `${utagCodeSeeMore};`);
}*/
aSeeMore.addEventListener('click', (e) => {
if (utagCodeSeeMore) eval(utagCodeSeeMore);
});
liSeeMore.appendChild(aSeeMore);
ul.appendChild(liSeeMore);
footerDiv.appendChild(ul);
});
container.appendChild(footerDiv);
}
function prefooterAccesibility() {
const prefooter = document.querySelector('.js-cmc-footer-01');
if (!prefooter) return;
const links = prefooter.querySelectorAll('.cmc-footer-01__list__item__link');
links.forEach(link => {
link.addEventListener('keydown', function (e) {
if (e.code === 'Space' || e.key === ' ') {
e.preventDefault();
link.click();
}
});
});
}
const jsonServiceUrl = `${window.location.origin}/aplnr/contentmedia/json.taxonomias_es.html`;
fetch(jsonServiceUrl)
.then(response => response.text())
.then(text => {
const decodedText = decodeHTMLEntities(text);
try {
const data = JSON.parse(decodedText);
renderDynamicSections(data);
prefooterAccesibility();
} catch (err) {
console.error('JSON parsing error:', err);
}
})
.catch(error => console.error('Error fetching:', error));
</script>
</p>
</div>
</div>
</div>
</div>
