<div class="cmc-card__link__bd__media">
<img class="cmc-card__link__bd__media__image" src="{{mediaLink}}" alt="" />
</div>
</div>
{{/showMedia}}
<div class="cmc-card__link__ft">
<p class="cmc-card__link__ft__info">{{postNombreTipo}}</p>
<svg class="cmc-card__link__ft__icon" width="32" height="32" viewbox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
{{{iconTipoContenido}}}
</svg>
</div>
</a>
</article>
</div>
{{/linea_1}}
</div>
{{/esPrimeraCarga}}
<div class="cmc-grid-09 cmc-grid-09--second">
{{#linea_2_3}}
<div class="cmc-grid-09__item">
<article class="{{classArticle}}">
<a href="{{postLink}}" class="cmc-card__link" onclick="{{etiquetado}}">
<svg class="cmc-card__link__arrow" width="40" height="40" viewbox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"> <rect width="40" height="40" rx="20" fill="white"></rect> <path d="M28 19L12 19M28 19L22 25M28 19L22 13" stroke="#222222" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path> </svg>
<div class="cmc-card__link__hd">
{{#taxNombre}}
<p class="cmc-card__link__hd__tag">{{taxNombre}}</p>
{{/taxNombre}}
<h3 class="cmc-card__link__hd__title">{{postTitulo}}</h3>
</div>
{{#showMedia}}
<div class="cmc-card__link__bd">
<div class="cmc-card__link__bd__media">
<img class="cmc-card__link__bd__media__image" src="{{mediaLink}}" alt="{{mediaTitulo}}" />
</div>
</div>
{{/showMedia}}
<div class="cmc-card__link__ft">
<p class="cmc-card__link__ft__info">{{postNombreTipo}}</p>
<svg class="cmc-card__link__ft__icon" width="32" height="32" viewbox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
{{{iconTipoContenido}}}
</svg>
</div>
</a>
</article>
</div>
{{/linea_2_3}}
</div>
</script>
<script type="text/javascript">
document.addEventListener("DOMContentLoaded", () => {
const isPreEnvironment = window.location.hostname.includes("pre");
const baseUrl = "/aplnr/contentmedia/json.subportadillaContents_es.html";
const username = isPreEnvironment ? "userpre" : null;
const password = isPreEnvironment ? "userpre" : null;
let currentOffset = 1; // Current page offset
const numResultsPerPage = 9; // Results per page
let totalResults = 0; // Total results from server
//Ids exclude
const ids = "123409,123264,123080,122683,122562,";
const idsExclude = ids.substring(0, ids.length - 1); function decodeHTMLEntities(encodedString) {
const parser = new DOMParser();
const doc = parser.parseFromString(encodedString, "text/html");
return doc.documentElement.textContent;
}
function fetchAndRenderNews(titulo = "", fechaIni = "", fechaFin = "", idTaxTema = "", idTaxSector = "", idTaxTerritorio = "", append = false, currentOffset, isPageParamUrl = false) {
console.log("Fetching:", { titulo, fechaIni, fechaFin, idTaxTema, idTaxSector, idTaxTerritorio, currentOffset });
const idNav = 20;
let url = `${baseUrl}?num=${numResultsPerPage}&offset=${currentOffset}&idNav=${idNav}&idsExclude=${idsExclude}`;
if (titulo) { url += `&titulo=`+titulo;}
if (fechaIni) { url += `&fechaIni=`+fechaIni;}
if (fechaFin) { url += `&fechaFin=`+fechaFin;}
if (idTaxTema) { url += `&idTaxTema=`+idTaxTema;}
if (idTaxSector) { url += `&idTaxSector=`+idTaxSector;}
if (idTaxTerritorio) { url += `&idTaxTerritorio=`+idTaxTerritorio;}
console.log(url);
const headers = { "Accept": "application/json" };
if (isPreEnvironment && username && password) {
headers["Authorization"] = "Basic " + btoa(`${username}:${password}`);
}
return fetch(url, { method: "GET", headers })
.then(response => response.text())
.then(responseText => {
const decodedResponse = decodeHTMLEntities(responseText);
if(!isPageParamUrl)
renderNews(decodedResponse, append, currentOffset);
else{
return decodedResponse;
}
console.log(decodedResponse);
})
.catch(err => console.error("Error fetching JSON:", err));
}
document.querySelector('#aplicar').addEventListener('click', () => {
const titulo = document.querySelector('#buscar').value;
const tituloEncoded = encodeURIComponents(titulo);
const tituloParse = encodeURIComponents(titulo);
const dateInput = document.querySelector('.cmc-date-01__date').value;
const [start, end] = dateInput.split(" - ");
const fechaIni = start;
const fechaFin = end;
const idTaxTema = dropdownTemaHead.getAttribute('data-value') || ""; // Default to empty
const idTaxSector = dropdownSectorHead.getAttribute('data-value') || ""; // Default to empty
const idTaxTerritorio = dropdownTerritorioHead.getAttribute('data-value') || ""; // Default to empty
const divTema = document.querySelector('div[aria-labelledby="label-tema"]');
const tema = divTema.querySelector('.cmc-dropdown-01__selected').textContent;
const temaParse = encodeURIComponents(tema);
const divSector = document.querySelector('div[aria-labelledby="label-sectores"]');
const sector = divSector.querySelector('.cmc-dropdown-01__selected').textContent;
const sectorParse = encodeURIComponents(sector);
const divTerritorio = document.querySelector('div[aria-labelledby="label-territorio"]');
const territorio = divTerritorio.querySelector('.cmc-dropdown-01__selected').textContent;
const territorioParse = encodeURIComponents(territorio);
utag.link({section_name:'filtros', filter_search_term:tituloParse, filter_topic:temaParse, filter_sector:sectorParse, filter_territory:territorioParse, event_category:'clic en boton', event_action:'filtro', event_label:'aplicar', events:'clic_btn'},null,[1]);
currentOffset = 1;
fetchAndRenderNews(tituloEncoded, fechaIni, fechaFin, idTaxTema, idTaxSector, idTaxTerritorio, false, currentOffset, false);
const currentUrl = new URL(window.location.href);
// Elimina el parámetro "page" de la URL
currentUrl.searchParams.delete("page");
window.history.pushState({}, "", currentUrl.href); // Actualiza la URL sin recargar la página
});
var iconoDocGris = "<rect width='32' height='32' rx='16' fill='#EAEAEA'></rect><path d='M11 12H21M11 16H21M11 20H17M8 8H24V24H8V8Z' stroke='#222222' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'></path>";
var iconoDocAzul = "<rect width='32' height='32' rx='16' fill='#197EAE'></rect><path d='M11 12H21M11 16H21M11 20H17M8 8H24V24H8V8Z' stroke='white' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'></path>";
var iconoPodcast = "<rect width='32' height='32' rx='16' fill='white' fill-opacity='0.15'></rect><path d='M22 16C22 19.3137 19.3137 22 16 22M16 22C12.6863 22 10 19.3137 10 16M16 22V25M16 25H19M16 25H13M19 10V16C19 17.6569 17.6569 19 16 19C14.3431 19 13 17.6569 13 16V10C13 8.34315 14.3431 7 16 7C17.6569 7 19 8.34315 19 10Z' stroke='white' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'></path>";
var iconoVideo = "<rect width='32' height='32' rx='16' fill='white' fill-opacity='0.15'></rect> <path d='M20 13L25 11V21L20 19M8 9.5H19C19.5523 9.5 20 9.94772 20 10.5V21.5C20 22.0523 19.5523 22.5 19 22.5H8C7.44772 22.5 7 22.0523 7 21.5V10.5C7 9.94772 7.44772 9.5 8 9.5Z' stroke='white' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'></path>";
var iconoCita = "<rect width='32' height='32' rx='16' fill='white' fill-opacity='0.15'></rect> <path d='M15 17.5C15 15.567 13.433 14 11.5 14L8 10.5V17.5C8 19.433 9.567 21 11.5 21C13.433 21 15 19.433 15 17.5Z' stroke='white' stroke-width='1.5' stroke-linejoin='round'></path> <path d='M25 17.5C25 15.567 23.433 14 21.5 14L18 10.5V17.5C18 19.433 19.567 21 21.5 21C23.433 21 25 19.433 25 17.5Z' stroke='white' stroke-width='1.5' stroke-linejoin='round'></path>";
function inicializarMediaItem(item) {
//defecto, icono de contenido según tipo contenido
if (item.postIdTipo ==  1 || item.postIdTipo ==  2 || item.postIdTipo ==  3) { item.iconTipoContenido = iconoDocGris; } if (item.postIdTipo ==  4) { item.iconTipoContenido = iconoVideo; } if (item.postIdTipo ==  5) { item.iconTipoContenido = iconoPodcast; } //defecto, se muestra media
item.showMedia = true;
//upper taxNombre
item.taxNombreParse = encodeURIComponents(item.taxNombre);
item.taxNombre = item.taxNombre.toUpperCase();
//etiquetado
const taxNombreParse = item.taxNombreParse;
const titulo = item.postTitulo;
const tituloParseLabel = encodeURIComponents('Recursos para empresas');
const tituloParse = encodeURIComponents(titulo);
const postNombreTipo = item.postNombreTipo;
const postNombreTipoParse = encodeURIComponents(postNombreTipo);
item.etiquetado = "utag.link({section_name:'destacados', event_category:'clic en elementos', event_action:'"+tituloParseLabel+"', event_label:'"+tituloParse+"', events:'clic_destacado', content_type:'"+postNombreTipoParse+"'},null,[1]);"
return item;
}
var countLista1 = 1;
function processMediaLinea1(item) {
inicializarMediaItem(item);
if(countLista1==1) {
item.classArticle = "cmc-card cmc-card-06 cmc-card--fluid"; }
if(countLista1==2) {
item.classArticle = "cmc-card cmc-card-03 cmc-card--hr"; }
if(countLista1==3) { item.classArticle = "cmc-card cmc-card-02 cmc-card--hr cmc-card--second"; item.showMedia = false;
item.iconTipoContenido = iconoDocAzul;
}
countLista1 = countLista1 + 1;
}
var countLista2 = 1;
function processMediaLinea2_3(item) {
inicializarMediaItem(item);
if(countLista2==1 || countLista2==4 || countLista2==6) { item.classArticle = "cmc-card cmc-card-03";
}
if(countLista2==2) { item.classArticle = "cmc-card cmc-card-02";
item.showMedia = false;
}
if(countLista2==3 || countLista2==5) { //fondo imagen entera
item.classArticle = "cmc-card cmc-card-06";
}
countLista2 = countLista2 + 1;
}
function processMediaLineasCargarMas(item) {
inicializarMediaItem(item);
item.classArticle = "cmc-card cmc-card-03";
}
function renderNews(decodedResponseText, append, currentOffset) {
try {
const parsedJson = JSON.parse(decodedResponseText);
// Ensure items exist and are an array
if (!Array.isArray(parsedJson.items)) {
console.error("No items found in the response.");
parsedJson.items = [];
}
// Set total results if available, else default to a high number for initial fetch
if (parsedJson.total !== undefined) {
totalResults = parsedJson.total;
} else if (!append) {
totalResults = parsedJson.items.length; // Use items length as fallback
}
if (append) {
parsedJson.esPrimeraCarga = false;
parsedJson.linea_2_3 = parsedJson.items.slice(0, numResultsPerPage);
parsedJson.linea_2_3.forEach(processMediaLineasCargarMas);
} else {
countLista1 = 1; countLista2 = 1; parsedJson.esPrimeraCarga = true;
parsedJson.linea_1 =  parsedJson.items.slice(0, 3);
parsedJson.linea_1.forEach(processMediaLinea1);
parsedJson.linea_2_3 =  parsedJson.items.slice(3, numResultsPerPage);
parsedJson.linea_2_3.forEach(processMediaLinea2_3);
}
const template = $("#news-gridContent-template").html();
const rendered = Mustache.render(template, parsedJson);
if (append) {
$("#news-gridContent").append(rendered);
} else {
$("#news-gridContent").empty().append(rendered);
}
// Update "Load More" button visibility
const alreadyLoaded = (currentOffset - 1) * numResultsPerPage + parsedJson.items.length;
this.currentOffset = currentOffset;
if (alreadyLoaded >= totalResults) {
$("#load-more-button").attr("rel", "nofollow");
$("#load-more-button").hide();
} else {
$("#load-more-button").show().removeAttr("rel");
$("#load-more-button").show();
}
} catch (err) {
console.error("Error rendering response text:", err);
}
}
document.querySelector("#load-more-button").addEventListener("click", () => {
event.preventDefault(); // Evita la recarga de la página
// Get the current search query, location, and date range
const titulo = document.querySelector('#buscar').value || ""; // Default to empty
const tituloEncoded = encodeURIComponents(titulo);
const dateInput = document.querySelector('.cmc-date-01__date').value;
const [start, end] = dateInput ? dateInput.split(" - ") : ["", ""]; // Default to empty dates
const fechaIni = start;
const fechaFin = end;
const idTaxTema = dropdownTemaHead.getAttribute('data-value') || ""; // Default to empty
const idTaxSector = dropdownSectorHead.getAttribute('data-value') || ""; // Default to empty
const idTaxTerritorio = dropdownTerritorioHead.getAttribute('data-value') || ""; // Default to empty
// Increment the offset for the next page
this.currentOffset += 1;
// Fetch and append new results while maintaining filters
fetchAndRenderNews(tituloEncoded, fechaIni, fechaFin, idTaxTema, idTaxSector, idTaxTerritorio, true, this.currentOffset , false);
// Construir la nueva ruta relativa
const basePath = "https://www.caixabank.com/es/esfera/emprender/recursos-para-empresas";
const currentUrl = new URL(window.location.href);
currentUrl.searchParams.set("page", this.currentOffset);
window.history.pushState({}, "", currentUrl.href); // Actualiza la URL sin recargar la página
page++; // Incrementa el valor de page
let pageActual = this.currentOffset + 1;
const loadMoreBtn = document.getElementById("load-more-button");
loadMoreBtn.href = `${basePath}?page=${pageActual}`; // Actualiza el enlace dinámicamente
});
document.querySelector(".cmc-form-01__wrapper__bd__clear").addEventListener("click", () => {
const activeTag = document.querySelector(".cmc-layout-11__slider__track__tag--active");
const idTaxTema = activeTag.getAttribute('href');
// Buscar dentro del div con id 'cmc-dropdown-01__bd__tema'
const dropdownTemaItems = document.querySelectorAll("#cmc-dropdown-01__bd__tema .cmc-dropdown-01__item");
const dropdownSectoresItems = document.querySelectorAll("#cmc-dropdown-01__bd__sectores .cmc-dropdown-01__item");
const dropdownTerritorioItems = document.querySelectorAll("#cmc-dropdown-01__bd__territorio .cmc-dropdown-01__item");
// Si se ha seleccionado la etiqueta TODOS
if(idTaxTema == "#"){
// Llamada a función
fetchAndRenderNews("", "", "", "", "", "", false, 1, false);
dropdownTemaItems.forEach(function(item) {
if(item.getAttribute('tabindex') === "0") {
// Simular click sobre el elemento que coincide
item.click();
}
});
}
else{
// Llamada a función
fetchAndRenderNews("", "", "", idTaxTema, "", "", false, 1, false);
dropdownTemaItems.forEach(function(item) {
if(item.getAttribute('data-value') === idTaxTema) {
// Simular click sobre el elemento que coincide
item.click();
}
});
}
dropdownSectoresItems.forEach(function(item) {
if(item.getAttribute('tabindex') === "0") {
// Simular click sobre el elemento que coincide
item.click();
}
});
dropdownTerritorioItems.forEach(function(item) {
if(item.getAttribute('tabindex') === "0") {
// Simular click sobre el elemento que coincide
item.click();
}
});
document.querySelector('.cmc-date-01__date').value = '';
document.querySelector('.cmc-input-01__element').value = '';
const currentUrl = new URL(window.location.href);
// Elimina el parámetro "page" de la URL
currentUrl.searchParams.delete("page");
window.history.pushState({}, "", currentUrl.href); // Actualiza la URL sin recargar la página
});
document.querySelectorAll(".cmc-layout-11__slider__track__tag").forEach(function(tag) {
tag.addEventListener("click", function(e) {
page="2";
const currentUrl = new URL(window.location.href);
// Elimina el parámetro "page" de la URL
currentUrl.searchParams.delete("page");
window.history.pushState({}, "", currentUrl.href); // Actualiza la URL sin recargar la página
e.preventDefault();
// Quitar clase activa del que la tenga actualmente
const activeTag = document.querySelector(".cmc-layout-11__slider__track__tag--active");
if (activeTag) {
activeTag.classList.remove("cmc-layout-11__slider__track__tag--active");
}
// Agregar clase activa al clicado
this.classList.add("cmc-layout-11__slider__track__tag--active");
// Se recupera el idTaxTema clicado en etiqueta
const idTaxTema = this.getAttribute('href');
// Buscar dentro del div con id 'cmc-dropdown-01__bd__tema'
const dropdownTemaItems = document.querySelectorAll("#cmc-dropdown-01__bd__tema .cmc-dropdown-01__item");
const dropdownSectoresItems = document.querySelectorAll("#cmc-dropdown-01__bd__sectores .cmc-dropdown-01__item");
const dropdownTerritorioItems = document.querySelectorAll("#cmc-dropdown-01__bd__territorio .cmc-dropdown-01__item");
// Si se ha seleccionado la etiqueta TODOS
if(idTaxTema == "#"){
// Llamada a función
fetchAndRenderNews("", "", "", "", "", "", false, 1, false);
dropdownTemaItems.forEach(function(item) {
if(item.getAttribute('tabindex') === "0") {
// Simular click sobre el elemento que coincide
item.click();
}
});
}
else{
// Llamada a función
fetchAndRenderNews("", "", "", idTaxTema, "", "", false, 1, false);
dropdownTemaItems.forEach(function(item) {
if(item.getAttribute('data-value') === idTaxTema) {
// Simular click sobre el elemento que coincide
item.click();
}
});
}
dropdownSectoresItems.forEach(function(item) {
if(item.getAttribute('tabindex') === "0") {
// Simular click sobre el elemento que coincide
item.click();
}
});
dropdownTerritorioItems.forEach(function(item) {
if(item.getAttribute('tabindex') === "0") {
// Simular click sobre el elemento que coincide
item.click();
}
});
document.querySelector('.cmc-date-01__date').value = '';
document.querySelector('.cmc-input-01__element').value = '';
});
});
const dropdownTema = document.querySelector("#dropdownTema");
const dropdownTemaHead = dropdownTema.querySelector(".cmc-dropdown-01__hd");
const dropdownTemaList = dropdownTema.querySelector(".cmc-dropdown-01__bd");
const dropdownTemaItems = dropdownTema.querySelectorAll(".cmc-dropdown-01__item");
const selectedTemaSpan = dropdownTema.querySelector(".cmc-dropdown-01__selected");
dropdownTemaHead.addEventListener("click", () => {
const expanded = dropdownTema.getAttribute("aria-expanded") === "true";
dropdownTema.setAttribute("aria-expanded", !expanded);
dropdownTemaList.style.display = expanded ? "none" : "block";
});
dropdownTemaItems.forEach((item) => {
item.addEventListener("click", () => {
selectedTemaSpan.textContent = item.textContent;
dropdownTema.setAttribute("aria-expanded", "false");
dropdownTemaList.style.display = "none";
dropdownTemaHead.setAttribute("data-value", item.getAttribute("data-value"));
});
});
document.addEventListener("click", (event) => {
if (!dropdownTema.contains(event.target)) {
dropdownTema.setAttribute("aria-expanded", "false");
dropdownTemaList.style.display = "none";
}
});
const dropdownSector = document.querySelector("#dropdownSector");
const dropdownSectorHead = dropdownSector.querySelector(".cmc-dropdown-01__hd");
const dropdownSectorList = dropdownSector.querySelector(".cmc-dropdown-01__bd");
const dropdownSectorItems = dropdownSector.querySelectorAll(".cmc-dropdown-01__item");
const selectedSectorSpan = dropdownSector.querySelector(".cmc-dropdown-01__selected");
dropdownSectorHead.addEventListener("click", () => {
const expanded = dropdownSector.getAttribute("aria-expanded") === "true";
dropdownSector.setAttribute("aria-expanded", !expanded);
dropdownSectorList.style.display = expanded ? "none" : "block";
});
dropdownSectorItems.forEach((item) => {
item.addEventListener("click", () => {
selectedSectorSpan.textContent = item.textContent;
dropdownSector.setAttribute("aria-expanded", "false");
dropdownSectorList.style.display = "none";
dropdownSectorHead.setAttribute("data-value", item.getAttribute("data-value"));
});
});
document.addEventListener("click", (event) => {
if (!dropdownSector.contains(event.target)) {
dropdownSector.setAttribute("aria-expanded", "false");
dropdownSectorList.style.display = "none";
}
});
const dropdownTerritorio = document.querySelector("#dropdownTerritorio");
const dropdownTerritorioHead = dropdownTerritorio.querySelector(".cmc-dropdown-01__hd");
const dropdownTerritorioList = dropdownTerritorio.querySelector(".cmc-dropdown-01__bd");
const dropdownTerritorioItems = dropdownTerritorio.querySelectorAll(".cmc-dropdown-01__item");
const selectedTerritorioSpan = dropdownTerritorio.querySelector(".cmc-dropdown-01__selected");
dropdownTerritorioHead.addEventListener("click", () => {
const expanded = dropdownTerritorio.getAttribute("aria-expanded") === "true";
dropdownTerritorio.setAttribute("aria-expanded", !expanded);
dropdownTerritorioList.style.display = expanded ? "none" : "block";
});
dropdownTerritorioItems.forEach((item) => {
item.addEventListener("click", () => {
selectedTerritorioSpan.textContent = item.textContent;
dropdownTerritorio.setAttribute("aria-expanded", "false");
dropdownTerritorioList.style.display = "none";
dropdownTerritorioHead.setAttribute("data-value", item.getAttribute("data-value"));
});
});
document.addEventListener("click", (event) => {
if (!dropdownTema.contains(event.target)) {
dropdownTema.setAttribute("aria-expanded", "false");
dropdownTemaList.style.display = "none";
}
});
// --- Carga inicial respetando ?page=X (1 por defecto) ---
const urlParams = new URLSearchParams(window.location.search);
const pageParam = parseInt(urlParams.get("page"), 10);
const pageToLoad = (!isNaN(pageParam) && pageParam > 1) ? pageParam : 1;
const loadMoreBtn = document.getElementById("load-more-button");
initialPageLoad = pageToLoad;
if(pageToLoad ==1){  //si no es page=1 o si no viene con param url page.
fetchAndRenderNews("", "", "", "", "", "", true, 1, false);
if (loadMoreBtn) {
const nextPage = pageToLoad + 1;
const basePath = `https://www.caixabank.com/es/esfera/emprender/recursos-para-empresas`;
loadMoreBtn.href = `${basePath}?page=${nextPage}`;
}
}
else
{
(async function loadInitialPages() {
const promises = [];
for (let i = 1; i <= pageToLoad; i++) {
const append = i > 1;
promises.push(
fetchAndRenderNews("", "", "", "", "", "", true, i, true).then(decodedResponse => ({ index: i, append, decodedResponse }))
);
}
const results = await Promise.all(promises);
results
.sort((a, b) => a.index - b.index)
.forEach(r => {
renderNews(r.decodedResponse, r.append, r.index);
});
if (loadMoreBtn) {
const nextPage = pageToLoad + 1;
const basePath = `https://www.caixabank.com/es/esfera/emprender/recursos-para-empresas`;
loadMoreBtn.href = `${basePath}?page=${nextPage}`;
}
})();
}
});
/**
* Elimina todos los caracteres, excepto de la [a-z],[0-9] y espacios,
* pasa todo a minúsculas, elimina tildes y reconvierte ç a c, ñ a nh.
*/
function encodeURIComponents(texto) {
if (texto && texto.trim() !== '') {
// Convertir a minúsculas
texto = texto.toLowerCase();
// Reemplazar caracteres acentuados y especiales
texto = texto
.replace(/[áàäâ]/g, 'a')
.replace(/[éèëê]/g, 'e')
.replace(/[íìïî]/g, 'i')
.replace(/[óòöô]/g, 'o')
.replace(/[úùüû]/g, 'u')
.replace(/ç/g, 'c')
.replace(/ñ/g, 'nh');
// Eliminar todos los caracteres que NO sean letras, números o espacio
texto = texto.replace(/[^a-zA-Z0-9 ]/g, '');
return texto;
}
return null;
}
/*FIN Paginación Cargar más*/
</script>
