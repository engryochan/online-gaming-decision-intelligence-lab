<script type="text/javascript">
$(document).ready(function() {
if($('head').data('dynamic') || (typeof neoCurrentChannelDynamic !== 'undefined' && neoCurrentChannelDynamic )){
let isMetaVelocityLanguage = false;
$("head [rel='alternate']").each(function () {
if ($( this ).is("[hreflang]"))
isMetaVelocityLanguage = true;
});
if(isMetaVelocityLanguage) {
$(".links-group-panel .list-inline.language").each(function() {
let list = $(this).find("a");
list.each(function () {
var lang = $( this ).attr('hreflang');
var hlink=$('head link[rel="alternate"][hreflang='+lang+']');
if(typeof lang !== 'undefined' && typeof hlink !== 'undefined' && hlink.length === 0){
$( this ).remove();
} else if(typeof hlink !== 'undefined' && hlink.attr('href')) {
$(this).attr('href',hlink.attr('href'));
}
});
if( $(this).find("a").length ===0) {
$(this).hide();
}
});
}
else $(".links-group-panel .list-inline.language").hide();
}
if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Windows Phone/i.test(navigator.userAgent)){
$(".mobile-link-open").find("a").attr("aria-haspopup", "false");
}
else {
$(".mobile-link-open").find("a").attr("aria-expanded", "false");
}
});
</script>
