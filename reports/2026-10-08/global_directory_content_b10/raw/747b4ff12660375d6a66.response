root=\\\"1\\\"\u003eAnswers to common questions about SREC income opportunities and program eligibility\u003c/span\u003e\u003c/p\u003e\\n\",\"eyebrow\":null,\"hasBreadcrumbs\":false,\"heading\":\"Frequently Asked Questions\",\"headingTag\":[\"h2\"],\"button1\":{\"variant\":[\"primary\"],\"link\":null},\"button2\":{\"variant\":[\"secondary\"],\"link\":null},\"button3\":{\"variant\":[\"link\"],\"link\":null}},\"accordionItemsFaq\":[{\"rowType\":[\"faq\"],\"heading\":\"How do I register my solar system for SRECs?\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eXpansiv handles registration end-to-end, submitting required documentation to your state’s renewable program and ensuring timely approval.\u003c/span\u003e\u003c/p\u003e\\n\"},{\"rowType\":[\"faq\"],\"heading\":\"How do I receive payments for my SRECs?\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003e\u003cspan data-sheets-root=\\\"1\\\"\u003eOnce your system generates certified RECs, our automated platform manages the sale and sends direct payments based on market price or contract terms. You also have the option of choosing when and at what price to sell your SRECs.\u003c/span\u003e\u003c/p\u003e\\n\"},{\"rowType\":[\"faq\"],\"heading\":\"Can installers or developers integrate their systems with Xpansiv Managed Solutions?\",\"headingTag\":[\"h3\"],\"text\":\"\u003cp\u003eYes. Our API and partner tools allow solar companies to register customers, track status and manage payments seamlessly through our referral program.\u003c/p\u003e\\n\"}]}}]\n"])</script><script>self.__next_f.push([1,"34:[\"$\",\"div\",\"6\",{\"className\":\"logo-bar-module-scss-module__zZStIG__item\",\"children\":[\"$\",\"$L22\",null,{\"src\":\"https://www.xpansiv.com/wp-content/uploads/2025/11/XP_Dark_Solaredge.png?v=1763503797\",\"alt\":\"\",\"width\":440,\"height\":178,\"className\":\"$undefined\",\"priority\":false,\"sizes\":\"$undefined\",\"quality\":75}]}]\n35:[\"$\",\"div\",\"7\",{\"classNam