le-scss-module__EIOLdq__container container"><div class="image-5050-module-scss-module__EIOLdq__holder"><div class="image-5050-module-scss-module__EIOLdq__content"><div class="image-5050-module-scss-module__EIOLdq__header"><div class="text-block-module-scss-module__VAyP-q__header text-block-module-scss-module__VAyP-q__is-inside-carousel"><h2 class="text-block-module-scss-module__VAyP-q__heading heading3 gsap-text-block-heading">Learn More About Our SREC Expertise and Program</h2><div class="text-block-module-scss-module__VAyP-q__text body-m gsap-text-block-description"><p><span data-sheets-root="1">Only Xpansiv brings the experience gained from serving over 125,000 customers and managing 2,000 MW of clean energy assets. We are the nation’s leading SREC company.</span></p>
</div><div class="text-block-module-scss-module__VAyP-q__buttons gsap-text-block-buttons"><a target="_blank" class="btn btn--icon-wide text-block-module-scss-module__VAyP-q__button" href="https://www.srectrade.com/app/auth/register"><span>Register Now</span><svg xmlns="http://www.w3.org/2000/svg" width="16" height="6" fill="none" class=""><path fill="currentColor" d="M16 3 11 .113v5.774zM0 3v.5h11.5v-1H0z"></path></svg></a></div></div></div><div class="module-5050-module-scss-module__AAKDNq__items"></div></div><div class="image-5050-module-scss-module__EIOLdq__image-wrapper"><div class="media-renderer-module-scss-module__wcv5jq__wrapper image-5050-module-scss-module__EIOLdq__image-holder"><img alt="" loading="lazy" decoding="async" data-nimg="fill" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(min-width: 768px) 648px, 100vw" srcSet="/_next/image?url=https%3A%2F%2Fwww.xpansiv.com%2Fwp-content%2Fuploads%2F2025%2F12%2FXP_Solar_Residential_Rooftops.jpg%3Fv%3D1765160535&amp;w=640&amp;q=100 640w, /_next/image?url=https%3A%2F%2Fwww.xpansiv.com%2Fwp-content%2Fuploads%2F2025%2F12%2FXP_Solar_Residential_Rooftops.jpg%3Fv%3D1765160535&amp;w=750&amp;q=100 750w, /_next/image?url=https%3A%2F%2Fwww.xpansiv.com%2Fwp-content%2Fuploads%2F2025%2F12%2FXP_Solar_Residential_Rooftops.jpg%3Fv%3D1765160535&amp;w=828&amp;q=100 828w, /_next/image?url=https%3A%2F%2Fwww.xpansiv.com%2Fwp-content%2Fuploads%2F2025%2F12%2FXP_Solar_Residential_Rooftops.jpg%3Fv%3D1765160535&amp;w=1080&amp;q=100 1080w, /_next/image?url=https%3A%2F%2Fwww.xpansiv.com%2Fwp-content%2Fuploads%2F2025%2F12%2FXP_Solar_Residential_Rooftops.jpg%3Fv%3D1765160535&amp;w=1200&amp;q=100 1200w, /_next/image?url=https%3A%2F%2Fwww.xpansiv.com%2Fwp-content%2Fuploads%2F2025%2F12%2FXP_Solar_Residential_Rooftops.jpg%3Fv%3D1765160535&amp;w=1920&amp;q=100 1920w, /_next/image?url=https%3A%2F%2Fwww.xpansiv.com%2Fwp-content%2Fuploads%2F2025%2F12%2FXP_Solar_Residential_Rooftops.jpg%3Fv%3D