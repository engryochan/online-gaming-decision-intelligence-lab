</div>
</div>
</div>

<div style="margin-top: 35px;">
<div class="responsive_table">
<h4 class="table-heading">Public Consultation</h4>

<table class="table table-bordered">
	<thead>
		<tr>
			<th scope="col">Sr. No.</th>
