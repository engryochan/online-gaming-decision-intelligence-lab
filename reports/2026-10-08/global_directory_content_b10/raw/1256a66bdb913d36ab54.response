	<tbody>
		<tr>
			<td data-label="Sr. No."><span>1 </span></td>
			<td data-label="Date" style="text-align: center;"><span>03/05/2024 </span></td>
			<td data-label="Title"><span>Consultation Paper on proposed IFSCA (Listing) Regulations, 2024 </span></td>
			<td data-label="View"><span><a href="../../Document/ReportandPublication/consultation-paper-on-ifsca-listing-regulations-202404052024092753.pdf" rel="noopener noreferrer" target="_blank"><em class="mdi mdi-eye">&nbsp; </em> </a> </span></td>
		</tr>
