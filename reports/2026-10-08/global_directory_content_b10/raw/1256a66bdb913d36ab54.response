<script>
 (function () {
	function initDebtMarketTable() {
		var table = document.getElementById("debtMarketTable");
		if (!table) return;

		var searchInput = document.getElementById("debtMarketSearch");
		var currencyFilter = document.getElementById("debtCurrencyFilter");
		var labelFilter = document.getElementById("debtLabelFilter");
		var countEl = document.getElementById("debtRecordCount");
		var tbody = table.tBodies[0];
		var rows = Array.prototype.slice.call(tbody.rows);
		var totalRows = rows.length;
		var sortState = { index: -1, direction: 1 };

		function getCellValue(row, index, type) {
			var cell = row.cells[index];
			var value = cell.getAttribute("data-sort") || cell.textContent.trim();

			if (type === "number") {
				var numberValue = parseFloat(value.toString().replace(/,/g, ""));
				return isNaN(numberValue) ? 0 : numberValue;
			}

			if (type === "date") {
				return value || "0000-00-00";
			}

			return value.toString().toLowerCase();
		}

		function applyFilters() {
			var searchText = (searchInput ? searchInput.value : "").toLowerCase().trim();
			var currency = currencyFilter ? currencyFilter.value : "";
			var label = labelFilter ? labelFilter.value : "";
			var visibleCount = 0;

			rows.forEach(function (row) {
				var rowText = row.textContent.toLowerCase();
				var matchesSearch = !searchText || rowText.indexOf(searchText) !== -1;
				var matchesCurrency = !currency || row.getAttribute("data-currency") === currency;
				var matchesLabel = !label || row.getAttribute("data-label-type") === label;
				var showRow = matchesSearch && matchesCurrency && matchesLabel;

				row.style.display = showRow ? "" : "none";
				if (showRow) visibleCount++;
			});

			if (countEl) {
				countEl.textContent = "Showing " + visibleCount + " of " + totalRows + " records";
			}
		}

		Array.prototype.slice.call(table.tHead.rows[0].cells).forEach(function (header, index) {
			header.addEventListener("click", function () {
				var type = header.getAttribute("data-sort-type") || "text";
				sortState.direction = sortState.index === index ? sortState.direction * -1 : 1;
				sortState.index = index;

				rows.sort(function (a, b) {
					var aValue = getCellValue(a, index, type);
					var bValue = getCellValue(b, index, type);

					if (aValue < bValue) return -1 * sortState.direction;
					if (aValue > bValue) return 1 * sortState.direction;
					return 0;
				});

				rows.forEach(function (row) {
					tbody.appendChild(row);
				});

				applyFilters();
			});
		});

		if (searchInput) searchInput.addEventListener("input", applyFilters);
		if (currencyFilter) currencyFilter.addEventListener("change", applyFilters);
		if (labelFilter) labelFilter.addEventListener("change", applyFilters);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initDebtMarketTable);
	} else {
		initDebtMarketTable();
	}
})();
</script><script>
 (function () {
	function initDebtMarketTable() {
		var table = document.getElementById("debtMarketTable");
		if (!table) return;

		var searchInput = document.getElementById("debtMarketSearch");
		var currencyFilter = document.getElementById("debtCurrencyFilter");
		var labelFilter = document.getElementById("debtLabelFilter");
		var countEl = document.getElementById("debtRecordCount");
		var tbody = table.tBodies[0];
		var rows = Array.prototype.slice.call(tbody.rows);
		var totalRows = rows.length;
		var sortState = { index: -1, direction: 1 };

		function getCellValue(row, index, type) {
			var cell = row.cells[index];
			var value = cell.getAttribute("data-sort") || cell.textContent.trim();

			if (type === "number") {
				var numberValue = parseFloat(value.toString().replace(/,/g, ""));
				return isNaN(numberValue) ? 0 : numberValue;
			}

			if (type === "date") {
				return value || "0000-00-00";
			}

			return value.toString().toLowerCase();
		}

		function applyFilters() {
			var searchText = (searchInput ? searchInput.value : "").toLowerCase().trim();
			var currency = currencyFilter ? currencyFilter.value : "";
			var label = labelFilter ? labelFilter.value : "";
			var visibleCount = 0;

			rows.forEach(function (row) {
				var rowText = row.textContent.toLowerCase();
				var matchesSearch = !searchText || rowText.indexOf(searchText) !== -1;
				var matchesCurrency = !currency || row.getAttribute("data-currency") === currency;
				var matchesLabel = !label || row.getAttribute("data-label-type") === label;
				var showRow = matchesSearch && matchesCurrency && matchesLabel;

				row.style.display = showRow ? "" : "none";
				if (showRow) visibleCount++;
			});

			if (countEl) {
				countEl.textContent = "Showing " + visibleCount + " of " + totalRows + " records";
			}
		}

		Array.prototype.slice.call(table.tHead.rows[0].cells).forEach(function (header, index) {
			header.addEventListener("click", function () {
				var type = header.getAttribute("data-sort-type") || "text";
				sortState.direction = sortState.index === index ? sortState.direction * -1 : 1;
				sortState.index = index;

				rows.sort(function (a, b) {
					var aValue = getCellValue(a, index, type);
					var bValue = getCellValue(b, index, type);

					if (aValue < bValue) return -1 * sortState.direction;
					if (aValue > bValue) return 1 * sortState.direction;
					return 0;
				});

				rows.forEach(function (row) {
					tbody.appendChild(row);
				});

				applyFilters();
			});
		});

		if (searchInput) searchInput.addEventListener("input", applyFilters);
		if (currencyFilter) currencyFilter.addEventListener("change", applyFilters);
		if (labelFilter) labelFilter.addEventListener("change", applyFilters);
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initDebtMarketTable);
	} else {
		initDebtMarketTable();
	}
})();
</script>
									

