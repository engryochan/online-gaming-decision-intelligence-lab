order)] text-[var(--btn-secondary-text)] hover:border-[var(--btn-secondary-hover-border)] hover:bg-[var(--btn-secondary-hover-bg)] active:border-[var(--btn-secondary-hover-border)] active:bg-[var(--btn-secondary-active-bg)] mt-2 border-[var(--color-light-leather-500)] hover:border-[var(--color-light-leather-500)]" href="/contact?dept=listing"><span class="inline-grid place-items-center leading-[var(--btn-leading,1.5)]"><span class="[grid-area:1/1] group-active:font-medium">Contact the ETP Team</span><span aria-hidden="true" class="[grid-area:1/1] invisible font-medium">Contact the ETP Team</span></span><svg viewBox="0 0 14.75 11.0459" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="w-[15px] shrink-0"><path d="M14.5303 6.0533C14.8232 5.76041 14.8232 5.28553 14.5303 4.99264L9.75736 0.21967C9.46447 -0.0732236 8.98959 -0.0732236 8.6967 0.21967C8.40381 0.512563 8.40381 0.987437 8.6967 1.28033L12.9393 5.52297L8.6967 9.76561C8.40381 10.0585 8.40381 10.5334 8.6967 10.8263C8.98959 11.1192 9.46447 11.1192 9.75736 10.8263L14.5303 6.0533ZM0 5.52297V6.27297H14V5.52297V4.77297H0V5.52297Z" fill="currentColor"></path></svg></a></div></div></div></div></section></div></div><div data-sanity="id=page-listings;type=page;path=content:lcmqjqtk0712;base=%2Fstudio"><div style="opacity:0;transform:translateY(34px) scale(0.985);transition:opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0s, transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0s, clip-path 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0s;will-change:opacity, transform"><section class="bg-transparent text-foreground py-13 tablet:py-16 desktop:py-[4.7rem]"><div class="mx-auto w-full max-w-[1440px] px-4 tablet:px-8 desktop:px-22"><div data-theme="dark" style="background-image:linear-gradient(80deg, var(--color-deep-river-500) 4%, var(--color-horizon-turquoise-600) 52%, var(--color-deep-river-500) 96%)" class="promo-gradient-anim relative isolate overflow-hidden px-[8%] py-14 text-foreground tablet:py-16"><img src="/card/line.png" alt="" aria-hidden="true" class="absolute inset-0 -z-10 size-full scale-125 object-cover mix-blend-multiply"/><div class="flex max-w-[960px] flex-col gap-6 mx-auto items-center text-center"><h2 class="type-headline-6 text-balance tablet:type-headline-4 desktop:type-headline-3">Ready to <strong class="font-[400]">List with TXSE?</strong></h2><p class="type-body-2 text-foreground">Whether you&#x27;re exploring an IPO or considering a transfer, connect with the TXSE team to learn how we&#x27;re bringing greater transparency, alignment, and long-term value to the public markets.</p><div class="flex flex-wrap items-center gap-4 mt-2 justify-center"><a class="group inline-flex items-center justify-center whitespace-nowrap rounded-full transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background type-body-4 h-[53px] gap-4 px-[19px] no-underline bg-[var(--btn-primary-bg)] text-[var(--btn-primary-text)] hover:bg-[var(--btn-primary-hover-bg)] active:bg-[var(--btn-primary-active-bg)]" href="/contact?dept=listing"><span class="inline-grid place-items-center leading-[var(--btn-leading,1.5)]"><span class="[grid-area:1/1] group-active:font-medium">Get Started</span><span aria-hidden="true" class="[grid-area:1/1] invisible font-medium">Get Started</span></span><svg viewBox="0 0 14.75 11.0459" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="w-[15px] shrink-0"><path d="M14.5303 6.0533C14.8232 5.76041 14.8232 5.28553 14.5303 4.99264L9.75736 0.21967C9.46447 -0.0732236 8.98959 -0.0732236 8.6967 0.21967C8.40381 0.512563 8.40381 0.987437 8.6967 1.28033L12.9393 5.52297L8.6967 9.76561C8.40381 10.0585 8.40381 10.5334 8.6967 10.8263C8.98959 11.1192 9.46447 11.1192 9.75736 10.8263L14.5303 6.0533ZM0 5.52297V6.27297H14V5.52297V4.77297H0V5.52297Z" fill="currentColor"></path></svg></a></div></div></div></div></section></div></div></main></div><!--$--><!--/$--></