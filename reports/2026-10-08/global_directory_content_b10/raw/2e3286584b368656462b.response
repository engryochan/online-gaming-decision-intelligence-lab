and-supporting-text-10 text-and-supporting-text"> <a class="text-and-badge-3" href="https://taurushq.com/careers"> <div class="text-59 text-mdmedium">Careers</div> </a> </div> </div> </div> <div class="nav-menu-item-3 nav-menu-item" style="padding-left: 2rem;"> <div class="content-85"> <div class="text-and-supporting-text-10 text-and-supporting-text"> <a class="text-and-badge-3" href="/notices"> <div class="text-59 text-mdmedium">Notices</div> </a> </div> </div> </div> <div class="nav-menu-item-3 nav-menu-item" style="padding-left: 2rem;"> <div class="content-85"> <div class="text-and-supporting-text-10 text-and-supporting-text"> <a class="text-and-badge-3" href="/security"> <div class="text-59 text-mdmedium">Security</div> </a> </div> </div> </div> </div> </div> <footer class="footer hp"> <div class="navigation-actions-3"> <a class="buttons-button-28 buttons-button" href="https://app.t-dx.com/onboarding/start#en"> <div class="text-padding-12 text-padding"> <div class="text-58 text-mdmedium">Sign up</div> </div> </a> <a class="buttons-button-32 buttons-button" href="https://app.t-dx.com/login#en"> <div class="text-padding-12 text-padding"> <div class="text-65 text-mdmedium">Log in</div> </div> </a> </div> </footer> </div>  </div> <div class="scam-alert-banner"> <strong>Scam alert:</strong> A fraudulent AI trading application named “AI App Solution”,
    claiming to be provided by Taurus SA, is attempting to defraud individuals.
<strong>Taurus has not developed this app and does not endorse it.</strong> Please always verify
    that you are using our official websites and never share personal or financial information with
    suspicious parties. Taurus’ official websites are: <a href="https://taurushq.com">https://taurushq.com</a> and <a href="https://t-dx.com">https://t-dx.com</a> </div>  <div class="hero-header-section-1"> <div class="section-5 section"> <div class="container-12 container"> <div class="content-19"> <div class="x-and-s"> <div class="heading-and-badge-2 heading-and-badge"> <div class="badge-group-1"> <div class="badge-4 badge"> <div class="text-24 text-smregular"> Issuers </div> </div> <div class="content-20"> <div class="message-1 text-smregular"> TDX FOR ISSUERS </div> </div> </div> <h1 class="heading-10 display-mdsemibold"> Issue, manage and trade digital securities in an easy and secure way </h1> </div> <p class="supporting-text-7 supporting-text"> It&#39;s new and easy to get started </p> </div> <div class="actions-4 actions"> <a class="buttons-button-10 buttons-button" href="/contact?s=issuers"> <div class="text-padding-4 text-padding"> <div class="text-25 text-lgmedium">Contact us!</div> </div> <img class="arrow-narrow-right-1" src="/img/arrow-narrow-right-2@2x.png" alt="arrow-narrow-right"> </a> </div> </div> </div> <div class="container-13 container"> <div class="content-21"> <div class="macbook-pro-mockup-1"> <div class="overlap-group-1"> <img class="shadow-1" src="/img/logomark-5.png" alt="Shadow"> <img class="mac-book-pro-16-1" src="/img/macbook-pro-16.png" alt="MacBook Pro 16"> <img class="camera-1" src="/img/camera@2x.png" alt="Camera"> <img class="logo-1" src="/img/card-4@2x.png" alt="Logo"> <div class="screen-mockup-replace-fill-1"></div> </div> </div> </div> </div> </div> <img class="background-pattern-1" src="/img/background-pattern-1.png" alt="Background pattern"> </div> <div class="features-section-2 features-section"> <div class="container-14 container"> <div class="heading-and-supporting-text-5 heading-and-supporting-text"> <div class="subheading-2 subheading text-mdsemibold"> Secure and simple </div> <div class="heading-and-icon-1"> <div class="heading-11 roobert-medium-mirage-36px"> Tokenize for Growth </div> </div> <p class="supporting-text-7 supporting-text text-xllight"> Digitize your securities to access new possibilities. </p> </div> <div class="content-22"> <article class="feature-text-2 feature-text"> <div class="content-15"> <div class="text-and-supporting-text-8 text-and-supporting-text"> <div class="text-16 text-xlmedium">Tokenization</div> <p class="supporting-text-8 supporting-text text-mdlight"> Digitize equity, debt, employee incentive plans. </p> </div> </div> </article> <article class="feature-text-3 feature-text"> <div class="content-15"> <div class="text-and-supporting-text-9 text-and-supporting-text"> <div class="text-16 text-xlmedium">Administration</div> <p class="supporting-text-8 supporting-text text-mdlight"> Administer and transfer your securities 24/7. </p> </div> </div> </article> <article class="feature-text-4 feature-text"> <div class="content-15"> <div class="text-and-supporting-text-10 text-and-supporting-text"> <div class="text-16 text-xlmedium">Capital raise</div> <p class="supporting-text-8 supporting-text text-mdlight"> Fuel your growth fundraising with existing and new investors. </p> </div> </div> </article> <article class="feature-text-5 feature-text"> <div class="content-15"> <div class="text-and-supporting-text-11 text-and-supporting-text"> <div class="text-16 text-xlmedium"> Liquidity creation </div> <p class="supporting-text-8 supporting-text text-mdlight"> Launch a trading segment for your investors and employees. </p> </div> </div> </article> </div> </div> </div> <div class="features-section"> <div class="container-10 container"> <div class="content-16"> <div class="heading-and-supporting-text-6 heading-and-supporting-text"> <div class="heading-and-subheading-2 heading-and-subheading"> <div class="subheading-3 subheading text-mdsemibold"> Time for a change </div> <p class="heading-12 roobert-medium-mirage-36px"> Digital securities are here. <br>New access, new benefits </p> </div> <p class="supporting-text-7 supporting-text"> Exploring TDX&#39;s pioneering role in tokenized securities. </p> </div> </div> </div> <div class="container-15 container"> <div class="content-23"> <div class="frame-73 frame"> <div class="feature-text-6 feature-text"> <div class="featured-icon-1"> <div class="check-verified-01-1"></div> </div> <div class="text-and-supporting-text-12 text-and-supporting-text"> <div class="text-16 text-xlmedium">Digital</div> <p class="supporting-text-8 supporting-text text-mdlight"> Transfer in real time real securities anytime anywhere 24/7. </p> </div> </div> <div class="feature-text-7 feature-text"> <div class="featured-icon-1"> <img class="zap-1" src="/img/zap-9@2x.png" alt="zap"> </div> <div class="text-and-supporting-text-6 text-and-supporting-text"> <div class="text-16 text-xlmedium">Compliant</div> <p class="supporting-text-8 supporting-text text-mdlight"> Our ledger-based securities meet the Swiss Code of Obligations regulatory requirements. </p> </div> </div> </div> <div class="frame-7 frame"> <div class="feature-text-8 feature-text"> <div class="featured-icon-1"> <div class="shield-tick-1"></div> </div> <div class="text-and-supporting-text-6 text-and-supporting-text"> <div class="text-16 text-xlmedium">Secure</div> <p class="supporting-text-8 supporting-text text-mdlight"> Protect your assets with banking-grade security powered by Taurus technology, trusted by leading banks. </p> </div> </div> <div class="feature-text-9 feature-text"> <img class="featured-icon-2" src="/img/featured-icon-6@2x.png" alt="Featured icon"> <div class="text-and-supporting-text-6 text-and-supporting-text"> <div class="text-16 text-xlmedium">Private equity</div> <div class="supporting-text-8 supporting-text text-mdlight"> Easily turn your company shares into digital tokens to unlock both primary and secondary markets. </div> </div> </div> </div> <div class="frame-7 frame"> <div class="feature-text-10 feature-text"> <img class="featured-icon-2" src="/img/featured-icon@2x.png" alt="Featured icon"> <div class="text-and-supporting-text-6 text-and-supporting-text"> <div class="text-16 text-xlmedium">Private debt</div> <p class="supporting-text-8 supporting-text text-mdlight"> Digitize debt to streamline operational tasks including automated coupons payments. </p> </div> </div> <div class="feature-text-11 feature-text"> <img class="featured-icon-2" src="/img/featured-icon-2@2x.png" alt="Featured icon"> <div class="text-and-supporting-text-6 text-and-supporting-text"> <div class="text-16 text-xlmedium">Others</div> <div class="supporting-text-8 supporting-text text-mdlight"> Tokenizing assets beyond traditional boundaries ranging from funds, real estate, art and commodities </div> </div> </div> </div> </div> </div> </div> <img class="section-divider-1" src="/img/section-divider-2@2x.png" alt="Section divider "> <div class="pricing-page-header-1"> <img class="logomark-1" src="/img/logomark-1.png" alt="logomark"> <div class="header-section-1"> <div class="container-10 container"> <div class="content-16"> <div class="heading-and-supporting-text-7 heading-and-supporting-text"> <div class="heading-and-subheading-3 heading-and-subheading"> <div class="subheading-4 subheading text-mdsemibold"> TDX Pricing </div> <div class="heading-13 roobert-medium-mirage-36px"> Simple pricing </div> </div> </div> </div> </div> </div> <div class="section-6 section"> <div class="container-16 container"> <div class="content-24"> <div class="pricing-tier-card-1"> <div class="header-2 header"> <div class="heading-and-price"> <div class="heading-and-badge"> <div class="heading-7 text-lgsemibold"> Tokenize </div> <div class="badge-5 badge"> <div class="text-27 inter-medium-pink-flamingo-14px"> Start plan </div> </div> </div> <div class="price-2"> <div class="price-3 display-mdsemibold"> CHF 6,500 <span class="text-size: smaller"> setup</span> </div> <div class="period-wrap"></div> </div> <p class="supporting-text-8 supporting-