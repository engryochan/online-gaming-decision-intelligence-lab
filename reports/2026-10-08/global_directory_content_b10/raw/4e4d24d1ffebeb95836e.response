              <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}

        // Global row (GTM v84, Region blank). security_storage is always granted.
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'denied',
          personalization_storage: 'denied',
          security_storage: 'granted',
          wait_for_update: 2000
        });

        // US row (GTM v84, Region "US"). Grant-by-default for everything except
        // the two ad-identifier signals, which Lane A denied on 2026-09-21.
        gtag('consent', 'default', {
          region: ['US'],
          ad_storage: 'granted',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'granted',
          functionality_storage: 'granted',
          personalization_storage: 'granted',
          security_storage: 'granted',
          wait_for_update: 2000
        });

        // Equivalent to the template's "Redact ads data: Dynamic (match
        // ad_storage)" — redaction only takes effect while ad_storage is denied.
        gtag('set', 'ads_data_redaction', true);
      </script>
