<style id="wp-custom-css">
.text-white *{ color:#fff!important; }

.text-balance {text-wrap:balance;}

nav.main_menu.left {left:360px !important;}

/* COUNTER ADDITIONS */

/* Add "+" after the animated number */
.counter-plus .counter:after{
  content: "+";
  margin-left: 0.08em;
}

/* Add "B" after the animated number */
.counter-b .counter:after{
  content: "B";
  margin-left: 0.08em;
}

/* Add "M" after the animated number */
.counter-m .counter:after{
  content: "M";
  margin-left: 0.08em;
}

body .gform_wrapper input[type=email], body .gform_wrapper input[type=number], body .gform_wrapper input[type=password], body .gform_wrapper input[type=tel], body .gform_wrapper input[type=text], body .gform_wrapper input[type=url], body .gform_wrapper select, body .gform_wrapper textarea {
    color: #000 !important;
}

body .gform_wrapper .gform_footer input[type="submit"],
body .gform_wrapper .gform_footer input[type="button"] {
    background-color: #37436f;
    border: 1px solid #37436f;
    color: #000;
}

.fa-search,
.fa-bars {
	font-size:22px;
}

nav.main_menu > ul > li > a {
	font-size:15px;
}

@media (max-width:1000px) {
	header .header_bottom,
	nav.mobile_menu {
    background: #000 !important;
	}	
	
	.side_menu_button > a, .mobile_menu_button span {
		color:#fff !important;
	}
}

@media (max-width:768px) {
	.qbutton {
		height: auto;
		white-space: normal;
		text-align: center;
		line-height: 155%;
	}
	
	.vc_row.row-mobile-spacing {
			padding-right: 4rem !important;
			padding-left: 4rem !important;
	}
	
	.vc_row.mobile-logo-row {
		padding-top:0 !important;
		padding-bottom:0 !important;
	}
}
</style>
