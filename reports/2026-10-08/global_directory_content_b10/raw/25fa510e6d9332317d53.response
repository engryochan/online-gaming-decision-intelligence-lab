display: none;
}

/* X Twitter Icon Dupe */
.fa-x-twitter{         
 font-family:sans-serif; 
 }                       
 .fa-x-twitter::before{ 
 content:"𝕏";           
 font-size:1.2em;        
 }     
.post_info { 
    display: none !important; 
}.post_info_date, .date { 
    display: none !important; 
}
.blog_holder article {
    margin-bottom: -45px !important; 
}
.blog_holder article .qbutton {
    display: none !important; 
}
/*# sourceURL=bridge-style-dynamic-responsive-inline-css */
</style>
