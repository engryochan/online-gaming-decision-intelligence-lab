				<div class="pum-content popmake-content" tabindex="0">
			<section      data-speed="1" class="parallax_section_holder  " style = " height:612px; background-image:url('');"><div class="parallax_content center"><div class='parallax_section_inner_margin clearfix'><div class="wpb_column vc_column_container vc_col-sm-12 vc_col-has-fill"><div class="vc_column-inner"><div class="wpb_wrapper"><div      class="vc_row wpb_row section vc_row-fluid vc_inner " style=' text-align:center;'><div class=" full_section_inner clearfix"><div class="wpb_column vc_column_container vc_col-sm-12"><div class="vc_column-inner vc_custom_1768329746261"><div class="wpb_wrapper">
	<div class="wpb_text_column wpb_content_element ">
		<div class="wpb_wrapper">
			<h2 style="text-align: left;"><span style="color: #e8e8e8;">Ryan Mitchell</span></h2>
<h3 style="text-align: left;">Chief Operating Officer</h3>

		</div> 
	</div> 
	<div class="wpb_text_column wpb_content_element  text-white">
		<div class="wpb_wrapper">
			<p style="text-align: left;"><img decoding="async" class="wp-image-218 alignright" src="https://coda.globalliquidi1.wpenginepowered.com/wp-content/uploads/sites/2/2026/01/team-coda-ryannew.jpg" alt="" width="188" height="188" srcset="https://codamarkets.com/wp-content/uploads/sites/2/2026/01/team-coda-ryannew.jpg 300w, https://codamarkets.com/wp-content/uploads/sites/2/2026/01/team-coda-ryannew-150x150.jpg 150w" sizes="(max-width: 188px) 100vw, 188px" /><span style="font-weight: 400;">Ryan is Chief Operating Officer of CODA Markets, where he oversees trading operations, market connectivity, and strategic execution while helping drive the firm’s growth and business development initiatives. With over a decade of experience in U.S. equity markets, he specializes in algorithmic trading, smart order routing, direct market access, liquidity capture, and market microstructure. Ryan works closely with broker-dealer clients, liquidity providers, and technology partners to deliver scalable &amp; bespoke execution solutions. Outside of work, Ryan enjoys playing guitar, snowboarding, and traveling. He holds FINRA Series 7,24,57,66, and 99 licenses.</span></p>

		</div> 
	</div> </div></div></div></div></div></div></div></div></div></div></section><!-- Row Backgrounds --><div class="upb_grad" data-grad="background: -webkit-gradient(linear, left top, left bottom, color-stop(0%, #E3E3E3), color-stop(47%, #E3E3E3));background: -moz-linear-gradient(top,#E3E3E3 0%,#E3E3E3 47%);background: -webkit-linear-gradient(top,#E3E3E3 0%,#E3E3E3 47%);background: -o-linear-gradient(top,#E3E3E3 0%,#E3E3E3 47%);background: -ms-linear-gradient(top,#E3E3E3 0%,#E3E3E3 47%);background: linear-gradient(top,#E3E3E3 0%,#E3E3E3 47%);" data-bg-override="0" data-upb-overlay-color="" data-upb-bg-animation="" data-fadeout="" data-fadeout-percentage="30" data-parallax-content="" data-parallax-content-sense="30" data-row-effect-mobile-disable="true" data-img-parallax-mobile-disable="true" data-rtl="false"  data-custom-vc-row=""  data-vc="9.0.1"  data-is_old_vc=""  data-theme-support=""   data-overlay="false" data-overlay-color="" data-overlay-pattern="" data-overlay-pattern-opacity="" data-overlay-pattern-size=""    ></div>
