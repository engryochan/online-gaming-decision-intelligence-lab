<body class="wp-singular page-template page-template-full_width page-template-full_width-php page page-id-22 wp-theme-bridge wp-child-theme-iron-bridge-child vcwb bridge-core-3.2.0 mec-theme-bridge   vertical_menu_transparency vertical_menu_transparency_on qode-child-theme-ver-1.0.0 qode-theme-ver-30.6.1 qode-theme-bridge wpb-js-composer js-comp-ver-9.0.1 vc_responsive" itemscope itemtype="http://schema.org/WebPage">




<div class="wrapper">
	<div class="wrapper_inner">

    
		<!-- Google Analytics start -->
				<!-- Google Analytics end -->

		
	<header class=" scroll_header_top_area  stick transparent scrolled_not_transparent header_style_on_scroll menu_position_left page_header">
	<div class="header_inner clearfix">
		<form role="search" id="searchform" action="https://codamarkets.com/" class="qode_search_form" method="get">
    
            <i class="qode_icon_font_awesome fa fa-search qode_icon_in_search" ></i>            <input type="text" placeholder="Search" name="s" class="qode_search_field" autocomplete="off" />
            <input type="submit" value="Search" />

            <div class="qode_search_close">
                <a href="#">
                    <i class="qode_icon_font_awesome fa fa-times qode_icon_in_search" ></i>                </a>
            </div>
            </form>
		<div class="header_top_bottom_holder">
			
			<div class="header_bottom clearfix" style=' background-color:rgba(255, 255, 255, 0);' >
											<div class="header_inner_left">
																	<div class="mobile_menu_button">
		<span>
			<i class="qode_icon_font_awesome fa fa-bars " ></i>		</span>
	</div>
								<div class="logo_wrapper" >
	<div class="q_logo">
		<a itemprop="url" href="https://codamarkets.com/" >
             <img itemprop="image" class="normal" src="https://coda.globalliquidi1.wpenginepowered.com/wp-content/uploads/sites/2/2026/08/CODAwhite-new-325-f.png" alt="Logo"> 			 <img itemprop="image" class="light" src="https://coda.globalliquidi1.wpenginepowered.com/wp-content/uploads/sites/2/2026/08/CODAwhite-new-325-f.png" alt="Logo"/> 			 <img itemprop="image" class="dark" src="https://coda.globalliquidi1.wpenginepowered.com/wp-content/uploads/sites/2/2026/08/CODAwhite-new-325-f.png" alt="Logo"/> 			 <img itemprop="image" class="sticky" src="https://coda.globalliquidi1.wpenginepowered.com/wp-content/uploads/sites/2/2025/12/CODAwhite-new.png" alt="Logo"/> 			 <img itemprop="image" class="mobile" src="https://coda.globalliquidi1.wpenginepowered.com/wp-content/uploads/sites/2/2026/08/CODAwhite-new-325-f.png" alt="Logo"/> 					</a>
	</div>
	</div>															</div>
															<div class="header_inner_right">
									<div class="side_menu_button_wrapper right">
																														<div class="side_menu_button">
												<a class="search_button search_slides_from_window_top large" href="javascript:void(0)">
		<i class="qode_icon_font_awesome fa fa-search " ></i>	</a>

																							
										</div>
									</div>
