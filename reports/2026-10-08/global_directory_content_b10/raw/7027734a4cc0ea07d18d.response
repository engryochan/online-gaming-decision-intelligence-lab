    border-color: #000000;
}



.w3eden .media-body{
    color: #000000;
    font-weight: 700;
}
body.custom-background {
    background-color: #BD9A5F !important;
}


.header-inner .custom-container {
    float: right;
}
.footer-middle-wrap {
	  width:100% !important;
}

.elementor-tab-content {
    color: #000000;
    background-color: #ffffff;
    border: none !important;
}
