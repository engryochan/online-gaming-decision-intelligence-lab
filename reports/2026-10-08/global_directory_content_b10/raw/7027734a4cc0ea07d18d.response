    border: none !important;
}
.menu a {
	color: #ffffff !important;
}
.menu a:hover {
    color: #BD9A5F !important;
}


/*Complaints form*/
.nav-item-inner a.egovenz-popup-trigger.btn {
    vertical-align: inherit;
    background: #BD9A5F;
		color:#ffffff;
}
