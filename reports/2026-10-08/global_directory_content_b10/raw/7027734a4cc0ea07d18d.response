	margin-top: 20px !important;
}
.awsm-job-single-wrap strong {
    display: block;
}
.awsm-selectric .label, .awsm-selectric .label, .awsm-grid-item .awsm-job-item {
	font-family:arial !important;
}


.team-wrapper.team-modern.text-center.team-light.shortcode-rand-4 .team-member {
    margin: 10px; /* Adjust spacing between team members */
}

.team-wrapper.team-modern.text-center.team-light.shortcode-rand-4 .team-member img {
    border-radius: 50%; /* Makes the images circular if desired */
    width: 150px; /* Adjust size as needed */
    height: 150px; /* Adjust size as needed */
    object-fit: cover; /* Ensures the image fits within the given dimensions */
}


