(function (window, document) {
    "use strict";
    const getFiles = async () => {
        const response = await fetch(
            `https://api-v5.xtopia.io/clients/717d5286-17f8-4620-b852-83ca4ffcc30c/public/excel/files/data`,
            {
                method: "GET"
            }
        );
        let respJson = await response.json();

        if (respJson[0].fileName) {
            respJson = respJson.sort((a, b) => a.fileName.localeCompare(b.fileName));
        }

        const evt = new CustomEvent("filesLoaded", { detail: respJson });
        document.dispatchEvent(evt);
    };

    getFiles();
})(window, document);

