    <!-- list-css.html -->
<style>
  #pgn-excel-record.specific .hdr-record-file {
    display: none;
  }
  #pgn-excel-record.specific .btn-record-name {
    margin: 0 auto 0 auto;
  }
  .btn-record-name a.unclickable {
    color: rgba(72, 72, 72, 1);
    cursor: auto;
  }
  .btn-record-name a.unclickable:hover {
    color: rgba(72, 72, 72, 1);
  }
</style>

<!-- popup-css.html -->
<style>
  .slide-up-frame {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    backdrop-filter: blur(10px);
    pointer-events: none;
    opacity: 0;
    transition: all 0.5s;
  }
  .slide-up-frame.active {
    pointer-events: initial;
    opacity: 1;
  }
  .slide-up-info {
    position: fixed;
    opacity: 0;
    right: -100%;
    bottom: 0;
    top: 0;
    transition: all 0.5s;
  }
  .slide-up-info.select {
    right: 0;
    opacity: 1;
  }
  .slide-out-trigger a[href="javascript:void(0)"]:not([data-so*="webShare"]) {
    cursor: pointer;
  }
  .slide-out-trigger ~ .com {
    max-height: initial;
  }
  .aps-8002-so-wrapper {
    background-size: contain;
    background-position: 50% 100%;
  }
  .aps-8002-so-wrapper.ratio-1-1:not(.sm-gallery) {
    padding-bottom: 110%;
  }
  @media screen and (max-width: 1024px) {
    .slide-up-info {
      top: 72px;
    }
  }
  @media screen and (max-width: 767px) {
    .slide-up-info {
      top: 59px;
    }
  }
</style>

<!-- preloader-skeleton-css.html -->
<style>
  .skeleton {
    background: linear-gradient(
      -90deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.1) 50%,
      rgba(0, 0, 0, 0.05) 100%
    );
    background-size: 400% 400%;
    animation: pulse 1.2s ease-in-out infinite;
  }

  .skeleton .a-inner-text,
  .skeleton .aps-0208-rd-off,
  .skeleton .aps-0208-rd-on,
  .skeleton .aps-0208-rd-label {
    color: transparent !important;
    background-color: transparent !important;
    border-color: transparent !important;
  }

  .skeleton a {
    background-color: transparent !important;
    background-size: 0px !important;
  }

  .skeleton a picture {
    display: none;
  }

  @keyframes pulse {
    0% {
      background-position: 0% 0%;
    }
    100% {
      background-position: -135% 0%;
    }
  }
</style>
<style>
	.main-header{transition:all 0.5;}
    .main-header-mobile{transition:all 0.5s;}
    .main-header.active{background: white;}
    .main-header .row-menu{
        opacity: 1;
        pointer-events: all;
        transition:all .5s;
    }
    
    .main-header.active .row-menu{
        opacity: 0;
        pointer-events: none;
    }
	
    @media all and (max-width: 767px) {
        .main-header-mobile{transition:all 1.8s; max-height:0px; opacity: 0;}
        .main-header-mobile.fade-in{max-height:100px; opacity: 1;}
    }

    .st-accordion>.st-list>.st-item>.st-header>.st-arrow {top:26px!important}
    
    .hamburger-cb-inner, .hamburger-cb-inner:after, .hamburger-cb-inner:before {
        height: 2px!important;
    }
</style><style>
    #x-w-chat-control{
        background-color:rgba(0,0,0,0)!important;
    }
    .x-w-chat-control-input-wrapper, .x-w-chat-control-trigger-wrapper{
        box-shadow:0px 5px 14px -1px rgba(66, 68, 90, 0.21)!important;
        border-radius:50px;
    }
</style><style>
    .main-header{position:absolute}
    .menu-frame{top:72px; position:absolute; opacity:0; pointer-events:none; transform:translate(0,-24px); transition:all .5s}
    .menu-frame.select{pointer-events:initial;  transform:translate(0); opacity:1}
    .menu-trigger.select .aps-0030-so-wrapper {color:rgba(37,99,235,1); background:rgba(221,239,246,1)}
    .menu-content{display:none}
</style><!-- preloader-skeleton-css.html -->
