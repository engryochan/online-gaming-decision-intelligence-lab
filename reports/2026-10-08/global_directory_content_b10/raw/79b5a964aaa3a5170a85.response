/*
 * search-bar.js
 */
(function (window, document) {
  "use strict";

  const fragments = {
      topic: null,
      section: null,
    },
    qsQuery = fn_get_query_string("q"),
    qsSections = fn_get_query_string("s"),
    qsTopics = fn_get_query_string("t"),
    getCheckedValues = (checkboxes) => {
      // from https://stackoverflow.com/a/14544545
      return Array.from(checkboxes)
        .filter((i) => i.checked)
        .map((i) => i.value);
    },
    setCheckedValues = (checkboxes, values) => {
      checkboxes.forEach((checkbox) => {
        checkbox.checked = values.includes(checkbox.value);
      });
    },
    initFragments = () => {
      // topic
      const topicFragment = document.createDocumentFragment();
      const topicNode = document
        .querySelector("#cbl-topics li")
        .cloneNode(true);
      topicFragment.appendChild(topicNode);
      fragments.topic = topicFragment;

      // section
      const sectionFragment = document.createDocumentFragment();
      const sectionNode = document
        .querySelector("#cbl-sections li")
        .cloneNode(true);
      sectionFragment.appendChild(sectionNode);
      fragments.section = sectionFragment;
    },
    createTopics = (topics) => {
      const newFragment = document.createDocumentFragment();
      const parentEl = document.querySelector("#cbl-topics ul");

      topics.forEach((topic) => {
        const topicNode = fragments.topic.cloneNode(true);
        topicNode.querySelector("input").value = topic;
        topicNode.querySelector(".aps-0208-rd-label").innerHTML = topic;

        newFragment.appendChild(topicNode);
      });

      parentEl.innerHTML = "";
      parentEl.appendChild(newFragment);
    },
    createSections = (sections) => {
      const newFragment = document.createDocumentFragment();
      const parentEl = document.querySelector("#cbl-sections ul");

      sections.forEach((section) => {
        const sectionNode = fragments.section.cloneNode(true);
        sectionNode.querySelector("input").value = section.value;
        sectionNode.querySelector(".aps-0208-rd-label").innerHTML =
          section.label;

        newFragment.appendChild(sectionNode);
      });

      parentEl.innerHTML = "";
      parentEl.appendChild(newFragment);
    },
    enableTopicsSections = () => {
      document.querySelectorAll("#row-search-filter input").forEach((input) => {
        input.disabled = false;
      });

      if (qsSections) {
        setCheckedValues(
          document.querySelectorAll("#cbl-sections input"),
          qsSections.split(",")
        );
      }

      if (qsTopics) {
        setCheckedValues(
          document.querySelectorAll("#cbl-topics input"),
          qsTopics.split(",")
        );
      }
      document.querySelector("#cbl-topics").classList.remove("skeleton");
      document.querySelector("#cbl-sections").classList.remove("skeleton");
    },
    triggerSearch = () => {
      document.activeElement.blur();
      const query = document.querySelector("#txt-search-bar input").value;

      if (query.length > 3) {
        const evt = new CustomEvent("triggerSearch", {
          detail: {
            query: document.querySelector("#txt-search-bar input").value,
            sections: getCheckedValues(
              document.querySelectorAll("#cbl-sections input")
            ),
            topics: getCheckedValues(
              document.querySelectorAll("#cbl-topics input")
            ),
          },
        });
        document.dispatchEvent(evt);
      }
    };

  // on init
  initFragments();
  if (qsQuery) {
    document.querySelector("#txt-search-bar input").value = qsQuery;
  }

  // handle project loaded
  document.addEventListener("projectLoaded", (event) => {
    console.log(event.detail);
    createTopics(event.detail.topics);
    createSections(event.detail.sections);

    enableTopicsSections();
    if (qsQuery) {
      triggerSearch();
    }
  });

  // listen for enter on search bar
  document
    .querySelector("#txt-search-bar input")
    .addEventListener("keypress", function (e) {
      if (e.key === "Enter") {
        triggerSearch();
      }
    });

  // listen for click on search btn
  document.querySelector("#btn-search").addEventListener("click", (e) => {
    e.preventDefault();
    triggerSearch();
  });
})(window, document);

/*
 * search.js
 */
(function (window, document) {
  "use strict";
  const searchPageUrl = "https://www.labuanfsa.gov.my/search",
    apiBaseUrl = "https://xtopia-v5-content-a49e.azurewebsites.net/api",
    qsQuery = fn_get_query_string("q"),
    disableInputs = () => {
      document.querySelectorAll("#row-search-bar input").forEach((input) => {
        input.disabled = true;
      });
    },
    enableInputs = () => {
      document.querySelectorAll("#row-search-bar input").forEach((input) => {
        input.disabled = false;
      });
    },
    doSearch = async (projectId, query, sections, topics) => {
      // hide starter and show results
      document.querySelector("#starter-row").classList.add("started");
      if (qsQuery) {
        document.querySelector("#starter-row").classList.add("queried");
      }
      document.querySelector("#search-row").classList.add("started");
      document.querySelector("#result-row").classList.add("started");
      
      let messageCnt = 0;
      const response = await fetch(
        `${apiBaseUrl}/projects/${projectId}/content/smart-search/sse`,
        {
          method: "POST",
          body: JSON.stringify({
            query: query,
            sections: sections,
            topics: topics,
          }),
          headers: {
            "Content-Type": "application/json",
          },
        }
      );
      const respJson = await response.json();
      const searchId = respJson._id;

      // set up sse listener
      const evtSource = new EventSource(
        `${apiBaseUrl}/projects/${projectId}/content/smart-search/sse/${searchId}`
      );
      evtSource.onopen = () => {
        console.log("The connection has been established.");
      };
      evtSource.onmessage = (e) => {
        const messageJson = JSON.parse(e.data);
        messageCnt += 1;

        if (messageCnt === 1) {
          const evt = new CustomEvent("referencesLoaded", {
            detail: messageJson,
          });
          document.dispatchEvent(evt);
        }

        if (messageCnt === 2) {
          const evt = new CustomEvent("summaryLoaded", { detail: messageJson });
          document.dispatchEvent(evt);
          evtSource.close();
          enableInputs();
        }
      };

      evtSource.onerror = () => {
        console.log("The connection has been closed.");
        evtSource.close();
        enableInputs();
      };
    };

  // handle search trigger
  document.addEventListener("triggerSearch", (event) => {
    console.log(event.detail);
    disableInputs();

    if (window.location.href.includes(searchPageUrl)) {
      doSearch(
        "67220b13c37206bf62439351",
        event.detail.query,
        event.detail.sections,
        event.detail.topics
      );
    } else {
      window.location.href = `${searchPageUrl}?q=${event.detail.query}&s=${event.detail.sections}&t=${event.detail.topics}`;
    }
  });
})(window, document);
