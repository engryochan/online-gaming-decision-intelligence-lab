    let files = [];

    const qsFile = fn_get_query_string("f"),
          qsQuery = fn_get_query_string("q"),
          createFileOptions = () => {
              const newFragment = document.createDocumentFragment();
              const parentEl = document.querySelector("#sel-list-name select");

              const defaultOption = document.createElement("option");
              defaultOption.textContent = "Show all files";
              defaultOption.value = "";
              newFragment.appendChild(defaultOption);

              files.forEach((file) => {
                  const newOption = document.createElement("option");
                  newOption.textContent = file.fileName;
                  newOption.value = file.id;
                  newFragment.appendChild(newOption);
              });

              parentEl.options.length = 0;
              parentEl.appendChild(newFragment);
          },
          editLastUpdated = () => {
              const selectedValue = document.querySelector(
                  "#sel-list-name select"
              ).value;
              let selectedDate = null;

              if (selectedValue) {
                  selectedDate = new Date(files.find(
                      (file) => file.id === selectedValue
                  ).uploadedAt);
              } else {
                  files.forEach((file) => {
                      if (selectedDate === null || selectedDate < file.uploadedAt) {
                          selectedDate = new Date(file.uploadedAt);
                      }
                  });
              }

              document.querySelector(
                  "#bdy-last-updated .a-inner-text"
              ).innerHTML = `Last updated ${selectedDate.toDateString()}`;
          },
          editDownloadButton = () => {
              const selectedValue = document.querySelector(
                  "#sel-list-name select"
              ).value;

              if (selectedValue) {
                  document.querySelector("#btn-download-file a").href = `https://api-v5.xtopia.io/clients/717d5286-17f8-4620-b852-83ca4ffcc30c/public/excel/files/${selectedValue}`;
                  document.querySelector("#row-download-file .col").style.backgroundColor = "rgba(37, 99, 235, 1)";
                  document.querySelector("#pgn-excel-record").classList.add("specific");
              } else {
                  document.querySelector("#btn-download-file a").href = "#";
                  document.querySelector("#row-download-file .col").style.backgroundColor = "rgba(126, 126, 126, 1)";
                  document.querySelector("#pgn-excel-record").classList.remove("specific");
              }
          },
          loadRecords = async () => {
              const loadingEvt = new CustomEvent("recordsLoading", { detail: null });
              document.dispatchEvent(loadingEvt);

              const companyName = document.querySelector(
                  "#txt-company-name input"
              ).value;
              const selectedList = document.querySelector(
                  "#sel-list-name select"
              ).value;

              const response = await fetch(
                  `https://api-v5.xtopia.io/clients/717d5286-17f8-4620-b852-83ca4ffcc30c/public/excel/records/search?name=${companyName}&fileId=${selectedList}`,
                  {
                      method: "GET"
                  }
              );
              const respJson = await response.json();

              const evt = new CustomEvent("recordsLoaded", { detail: respJson });
              document.dispatchEvent(evt);
          };

    if (qsQuery) {
        document.querySelector("#txt-company-name input").value = qsQuery;
    }

    // handle files loaded
    document.addEventListener("filesLoaded", (event) => {
        files = event.detail;
        createFileOptions();

        if (qsFile) {
            document.querySelector("#sel-list-name select").value = qsFile;
        }

        editLastUpdated();
        editDownloadButton();
        loadRecords();
    });

    // listen for enter on company name input
    document
        .querySelector("#txt-company-name input")
        .addEventListener("keypress", function (e) {
        if (e.key === "Enter") {
            loadRecords();
        }
    });

    // listen for click on company name button
    document.querySelector("#btn-company-name").addEventListener("click", (e) => {
        e.preventDefault();
        loadRecords();
    });

    // listen for change on file select
    document
        .querySelector("#sel-list-name select")
        .addEventListener("change", (e) => {
        e.preventDefault();
        editLastUpdated();
        editDownloadButton();
        loadRecords();
    });
})(window, document);

/*
 * list-display.js
 */
(function (window, document) {
    "use strict";

    let records = [];

    const fragments = {
        recordItem: null,
        loadingRecordItem: null
    },
          qsCompany = fn_get_query_string("c"),
          initFragments = () => {
              // loading record item
              const loadingRecordItemFragment = document.createDocumentFragment();
              const loadingRecordItemNode = document
              .querySelector("#pgn-excel-record .list-container > div")
              .cloneNode(true);
              loadingRecordItemFragment.appendChild(loadingRecordItemNode);
              fragments.loadingRecordItem = loadingRecordItemFragment;

              // record item
              const recordItemFragment = document.createDocumentFragment();
              const recordItemNode = document
              .querySelector("#pgn-excel-record .list-container > div")
              .cloneNode(true);
              recordItemNode.querySelectorAll(".skeleton").forEach((skeleton) => {
                  skeleton.classList.remove("skeleton");
              });
              recordItemFragment.appendChild(recordItemNode);
              fragments.recordItem = recordItemFragment;
          },
          showPopup = () => {
              document.querySelector(".slide-up-info").classList.add("select");
              document.querySelector(".slide-up-frame").classList.add("active");
              document.querySelector(".content-row").style.zIndex = "1000";
          },
          hidePopup = () => {
              document.querySelector(".slide-up-info").classList.remove("select");
              document.querySelector(".slide-up-frame").classList.remove("active");
              document.querySelector(".content-row").style.zIndex = "";
          },
          makePopup = (record) => {
              document.querySelector("#ttl-popup-name .a-inner-text").innerHTML = record.name.length > 0 ? record.name : "N/A";
              document.querySelector("#bdy-popup-name .a-inner-text").innerHTML = record.name + (record.type.length > 0 ? ` (${record.type})` : "");
              document.querySelector("#bdy-popup-address .a-inner-text").innerHTML = record.address.length > 0 ? record.address : "N/A";
              document.querySelector("#bdy-popup-tel .a-inner-text").innerHTML = record.tel.length > 0 ? record.tel : "N/A";
              document.querySelector("#bdy-popup-email .a-inner-text").innerHTML = record.email.length > 0 ? record.email : "N/A";
              document.querySelector("#bdy-popup-mo-address .a-inner-text").innerHTML = record.marketingOfficeAddress.length > 0 ? record.marketingOfficeAddress : "N/A";
              document.querySelector("#bdy-popup-co-address .a-inner-text").innerHTML = record.colocatedOfficeAddress.length > 0 ? record.colocatedOfficeAddress : "N/A";
              document.querySelector("#bdy-popup-cp-tel .a-inner-text").innerHTML = record.contactPersonTel.length > 0 ? record.contactPersonTel : "N/A";
              document.querySelector("#bdy-popup-cp .a-inner-text").innerHTML = record.contactPerson.length > 0 ? `${record.contactPerson} (${record.designation})` : "N/A";
              showPopup();
          },
          createList = () => {
              const newFragment = document.createDocumentFragment();
              const parentEl = document.querySelector("#pgn-excel-record .list-container");

              records.forEach((record) => {
                  const recordItemNode = fragments.recordItem.cloneNode(true);
                  recordItemNode.querySelector(".hdr-record-file .a-inner-text").innerHTML = record.fileName;
                  recordItemNode.querySelector(".btn-record-name").dataset.recordId = record._id;
                  recordItemNode.querySelector(".btn-record-name .a-inner-text").innerHTML = record.name;
                  //record.fileId === "6937a3ff0f6995c77d871d3c" || record.fileId === "6937a5fd0f6995c77d871d44" || 
                  if (record.fileId === "6937a2c60f6995c77d871d36") {
                      // remove link if labuan foundation, partnership or leasing
                      // 20260702 enable for foundaition and partnership
                      recordItemNode.querySelector(".btn-record-name a").classList.add("unclickable");
                  } else {
                      // add listener directly on each item
                      recordItemNode.querySelector(".btn-record-name").addEventListener("click", (e) => {
                          e.preventDefault();
                          makePopup(record);
                      });
                  }

                  newFragment.appendChild(recordItemNode);
              });

              parentEl.innerHTML = "";
              parentEl.appendChild(newFragment);
          };

    // on init
    initFragments();

    // handle records loading
    document.addEventListener("recordsLoading", (event) => {
        const container = document.querySelector("#pgn-excel-record .list-container");
        const newFragment = document.createDocumentFragment();
        const loadingRecordItemNode = fragments.loadingRecordItem.cloneNode(true);
        newFragment.appendChild(loadingRecordItemNode);
        container.innerHTML = "";
        container.appendChild(newFragment);
    });

    // handle records loaded
    document.addEventListener("recordsLoaded", (event) => {
        records = event.detail;
        createList();
    });

    // listen for click on popup close
    document.querySelector(".slide-out-trigger").addEventListener("click", (e) => {
        e.preventDefault();
        hidePopup();
    });
    document.querySelector(".slide-up-frame").addEventListener("click", (e) => {
        e.preventDefault();
        hidePopup();
    });
})(window, document);
</script><script data-xtopia="master">(function (window, document) {
	"use strict";

	let count = 0;
	const maxCount = 5;
	const intervalId = setInterval(function () {
		count++;
		console.log(`Attempt ${count}: ${window.chatWidgetConnected}`);

		if (window.chatWidgetConnected) {
			console.log("widget accessible");
			clearInterval(intervalId);
		}

		if (count >= maxCount) {
			console.log('Maximum iterations reached, stopping interval.');
			clearInterval(intervalId);
			if(window.matchMedia("(max-width: 768px)").matches){
				document.querySelector(".main-header-mobile").classList.add("fade-in");
			} else {
				document.querySelector(".main-header").classList.add("fade-in");
			}
		}
	}, 2000);

	window.chatActiveFunc = function () {
        setTimeout(function(){
            document.querySelector(".main-header").classList.add("active");
        }, 500);
    };
    
    window.chatInactiveFunc = function () {
        setTimeout(function(){
            document.querySelector(".main-header").classList.remove("active");
        }, 500);
    };

	if(window.location.search.indexOf("_xyan_content") >= 0){
		document.querySelector(".main-header").classList.add("fade-in");
	}

	window.mountedFunc = function () {
		window.handleTrigger({"state": false});
		if(window.matchMedia("(max-width: 768px)").matches){
			document.querySelector(".main-header-mobile").classList.add("fade-in");
		}
	};

}(window, document));// Add this to your HTML or JS file
