    (function($) {
        "use strict";

        $.fn.xtopiaVertMenu = function(options) {
            var settings = $.extend({
                // These are the defaults.
                //source: "api/contentms/side_menu_json.ashx?page_id=[page_id]&descendent_level=0",
                source: "http://develop.alchemedia-01.ximnet.my/abs_d02/api/contentms/full_menu_json.ashx",
                //
                rootFontSize: "font-8C65CD72-BB8B-47C5-8E0E-355356B24AFF",
                lvl2_FontSize: "font-8C65CD72-BB8B-47C5-8E0E-355356B24AFF",
                lvl3_FontSize: "font-8C65CD72-BB8B-47C5-8E0E-355356B24AFF",
                lvl4_FontSize: "font-8C65CD72-BB8B-47C5-8E0E-355356B24AFF"
            }, options);



            return this.each(function(ignore, target) {
                var $target = $(target);
                var defaultTopTitle = settings.defaultTitle;
                //Add Root List
                $target.append("<ul class=\"root-vertical-menu\"></ul>");

                //load JSON file
                $.getJSON(settings.source, function(data) {
                    //build menu
                    var builddata = function() {
                        var source = [];
                        var items = [];

                        data.forEach(function(item) {
                            var label = item.name,
                                parentid = item.parent_id,
                                id = item.id,
                                target = item.target,
                                url = item.url;


                            if (items[parentid]) {
                                item = {
                                    id: id,
                                    parentid: parentid,
                                    label: label,
                                    url: url,
                                    target: target,
                                    item: item
                                };

                                if (!items[parentid].items) {
                                    items[parentid].items = [];
                                }

                                items[parentid].items[items[parentid].items.length] = item;
                                items[id] = item;
                            } else {
                                items[id] = {
                                    id: id,
                                    parentid: parentid,
                                    label: label,
                                    url: url,
                                    target: target,
                                    item: item
                                };

                                source[id] = items[id];
                            }
                        });

                        var nodes = [];

                        Object.keys(items).forEach(function(key) {
                            nodes.push(items[key]);
                        });

                        return source;
                    };

                    var startingLevel = 1;
                    var lvl = 0;
                    var buildUL;

                    buildUL = function(parent, items, lvl) {
                        lvl += 1;

                        Object.keys(items).forEach(function(key) {
                            var item = items[key];

                            if (item.label) {
                                var li = $("<li id=\"lvl-" + item.id + "\" data-parent=\"lvl-" + item.parentid + "\" class=\"vertical-menu-item lvl-" + lvl + "\"><div class=\"vertical-menu-link\"><a target=\"" + item.target + "\" class=\"vertical-link\" href=\"" + item.url + "\">" + item.label + "</a></div></li>");

                                li.appendTo(parent);



                                switch (lvl) {
                                    case 1:
                                       
                                        $(parent).addClass(settings.rootFontSize + " lvl-" + item.parentid + " lvl-" + lvl + " menu-list");
                                        break;
                                    case 2:
                                        $(parent).addClass(settings.lvl2_FontSize + " lvl-" + item.parentid + " lvl-" + lvl + " menu-list");
                                        break;
                                    case 3:
                                        $(parent).addClass(settings.lvl3_FontSize + " lvl-" + item.parentid + " lvl-" + lvl + " menu-list");
                                        break;
                                    case 4:
                                        $(parent).addClass(settings.lvl4_FontSize + " lvl-" + item.parentid + " lvl-" + lvl + " menu-list");
                                        break;
                                }



                                //Add Sub Menu List
                                if (item.items && item.items.length > 0) {

                                    li.addClass("drop-down").find(".vertical-menu-link").append("<span class=\"vertical-menu-icon\"></span>");

                                    var ul = $("<ul class=\"vertical-sub-menu\"></ul>");
                                    var div = $("<div class=\"vertical-sub-menu-container\"></div>");
                                    var subWrapper = $("<div class=\"vertical-drop-down-wrapper\"></div>");
                                    ul.appendTo(li);
                                    buildUL(ul, item.items, lvl);
                                    ul.add(ul.nextAll()).wrapAll(subWrapper);

                                    //Add Wrapper Sub Menu List
                                }
                            }
                        });
                    };

                    var source = builddata();
                    var ul = $target.find(".root-vertical-menu");


                    //Run Rendering
                    ul.appendTo(ul);
                    buildUL(ul, source, lvl);

                    //Hover Function if drop down type 3
                    $(".vertical-menu-link .vertical-menu-icon").click(function(e) {
                        console.log("a");
                        $(e.currentTarget).parent().toggleClass('select');
                        e.preventDefault();
                    });

                });
            });
        };
    }(jQuery));
