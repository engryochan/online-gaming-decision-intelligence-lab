quest">TestRequest (1)</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42ResendRequest" href="/documentation/fix/fix-42/us-equities/#fix42ResendRequest">ResendRequest (2)</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42SessionReject" href="/documentation/fix/fix-42/us-equities/#fix42SessionReject">Reject (3)</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42SequenceReset" href="/documentation/fix/fix-42/us-equities/#fix42SequenceReset">SequenceReset (4)</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42Logout" href="/documentation/fix/fix-42/us-equities/#fix42Logout">Logout (5)</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42Logon" href="/documentation/fix/fix-42/us-equities/#fix42Logon">Logon (A)</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42BusinessMessageReject" href="/documentation/fix/fix-42/us-equities/#fix42BusinessMessageReject">BusinessMessageReject (j)</a></li><li><a class="block leading-snug pl-0 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="from-subscriber" href="/documentation/fix/fix-42/us-equities/#from-subscriber">From Subscriber</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42NewOrder" href="/documentation/fix/fix-42/us-equities/#fix42NewOrder">New</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42Cancel" href="/documentation/fix/fix-42/us-equities/#fix42Cancel">Cancel</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42Modify" href="/documentation/fix/fix-42/us-equities/#fix42Modify">Modify</a></li><li><a class="block leading-snug pl-0 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="to-subscriber" href="/documentation/fix/fix-42/us-equities/#to-subscriber">To Subscriber</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42ExecutionReport" href="/documentation/fix/fix-42/us-equities/#fix42ExecutionReport">Execution Report</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42CancelReject" href="/documentation/fix/fix-42/us-equities/#fix42CancelReject">Cancel Reject</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="fix42TradeBust" href="/documentation/fix/fix-42/us-equities/#fix42TradeBust">Trade Bust</a></li><li><a class="block leading-snug pl-3 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-300" data-slug="report-specializations" href="/documentation/fix/fix-42/us-equities/#report-specializations">Report Specializations</a></li><li><a class="block leading-snug pl-0 truncate font-normal text-slate-400 hover:text-slate-600 dark:text-slate-500 dark:hover:text-slate-3