        <div class="uk-background-norepeat uk-background-cover uk-background-center-center uk-section uk-flex uk-flex-middle" data-sources="[{&quot;type&quot;:&quot;image\/webp&quot;,&quot;srcset&quot;:&quot;\/media\/yootheme\/cache\/31\/company-header-light-313f0cc9.webp 768w, \/media\/yootheme\/cache\/c1\/company-header-light-c1912ed4.webp 1024w, \/media\/yootheme\/cache\/3f\/company-header-light-3f79e4c3.webp 1366w, \/media\/yootheme\/cache\/1e\/company-header-light-1e817445.webp 1600w, \/media\/yootheme\/cache\/90\/company-header-light-903faca4.webp 1920w, \/media\/yootheme\/cache\/7c\/company-header-light-7c512ef4.webp 2560w&quot;,&quot;sizes&quot;:&quot;(max-aspect-ratio: 2560\/1440) 178vh&quot;}]" data-src="/images/company-header-light.jpg" loading="eager" uk-img uk-height-viewport="offset-top: true;">    
        
        
        
