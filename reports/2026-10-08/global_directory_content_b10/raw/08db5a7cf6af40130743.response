  // Positions the Technologies Dropdown List
  // Only execute if window size is >= 992px
  if (window.innerWidth >= 992) {
    // Find the iex-group-navbar-dropdown element
    var navbarDropdown = document.querySelector(".iex-group-navbar-dropdown");
    var dropdownList = document.querySelector(".navbar-dropdown-list");

    if (navbarDropdown && dropdownList) {
      function updateDropdownPosition() {
        var navbarDropdownRect = navbarDropdown.getBoundingClientRect();
        var navbarDropdownLeft = navbarDropdownRect.left;
        dropdownList.style.paddingLeft = navbarDropdownLeft + "px";
      }

      // Initial set
      updateDropdownPosition();

      // Update on window resize
      window.addEventListener("resize", updateDropdownPosition);
    } else {
      console.warn("Dropdown elements not found on page.");
    }
  }
</script>
