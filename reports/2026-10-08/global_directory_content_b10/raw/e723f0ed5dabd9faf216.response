titutioneel vermogensbeheer"><b>Institutioneel</b> vermogensbeheer</a></li><li><a href="/vermogensbeheer/financieel-adviseurs/" title="OHV voor financieel adviseurs"><b>Financieel</b> adviseurs</a></li></ul></li><li><a href="/brokerage-services/" title="Uw belang boven alles">Markets Execution &amp; Solutions</a></li><li class="dropdown"><a href="/exportfinanciering/" id="menu4152" class="dropdown-toggle" data-toggle="dropdown" title="Exportfinanciering">Exportfinanciering <i class="fa-regular fa-fw fa-chevron-down"></i></a><ul class="dropdown-menu" role="menu" aria-labelledby="menu4152"><li><a href="/exportfinanciering/" title="Exportfinanciering">Exportfinanciering</a></li></ul></li><li class="dropdown"><a href="/over-ohv/" id="menu1028" class="dropdown-toggle" data-toggle="dropdown" title="Over OHV">Over OHV <i class="fa-regular fa-fw fa-chevron-down"></i></a><ul class="dropdown-menu" role="menu" aria-labelledby="menu1028"><li><a href="/over-ohv/ons-verhaal/" title="Uw toegang tot de financiële markten">Ons verhaal</a></li><li><a href="/over-ohv/geschiedenis/" title="Geschiedenis">Geschiedenis</a></li><li><a href="/nieuws/" title="Kennis &amp; Inzicht">Kennis &amp; Inzicht</a></li><li><a href="/over-ohv/vacatures/" title="Vacatures">Vacatures</a></li><li><a href="/over-ohv/informatie-dienstverlening/" title="Informatie dienstverlening">Informatie dienstverlening</a></li><li><a href="/over-ohv/informatie-duurzaam-beleggen/" title="Informatie duurzaam beleggen">Informatie duurzaam beleggen</a></li></ul></li><li class="menu-contact"><a href="/contact/" title="Contact" class="menu-contact">Contact</a></li></ul></div></nav></div><div id="header" class="header-with-image"><div class="header-image hidden-xs" style="background-image:url('/site/assets/files/1025/mark_luka_export.jpeg');"></div><div class="header-mobile-image" style="background-image:url('/site/assets/files/1025/ohv-13652-750x600.jpg');"></div><a href="javascript:void(0);" id="toggle" title="Menu"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="25"><g fill="#fff"><path d="M0 0h32v3H0zM0 11h22v3H0zM0 22h27v3H0z"/></g></svg> </a><div class="container" id="page-title"><div class="row"><div class="col col-sm-7 col-md-7 col-lg-6"><h1 data-aos="fade-up">Markets Execution &amp; Solutions</h1><p data-aos="fade-up" data-aos-delay="200">Financiële bemiddelaar op de institutionele markt</p><div class="buttons" data-aos="fade-up" data-aos-delay="400"><div><a href="#ohv-bemiddelt-in" class="btn btn-eq0 btn-white"><span>Onze diensten</span></a></div><div><a href="/contact/" class="btn btn-eq1 btn-green"><span>Contact</span></a></div></div></div></div></div></div><div id="mobile-menu"><a href="#" id="toggle-close"><i class="fal fa-times"></i></a><ul id="mobile-menu-ul"><li><a data-toggle="collapse" data-parent="#side-menu-ul" href="#sub-menu1023">Vermogensbeheer <i class="fa-regular fa-chevron-down fa-fw"></i></a><ul id="sub-menu1023" class="collapse"><li><a href="/vermogensbeheer/particulier-vermogensbeheer/" title="Particulier vermogensbeheer"><b>Particulier</b> vermogensbeheer</a></li><li class="display_as_subpage"><a href="/vermogensbeheer/beleggen-in-obligaties/" title="Beleggen in obligaties">Beleggen in <b>obligaties</b></a></li><li class="display_as_subpage"><a href="/vermogensbeheer/voor-dgas/" title="Vermogensbeheer voor DGA&#039;s">DGA&#039;s</a></li><li class="display_as_subpage"><a href="/vermogensbeheer/voor-erfgenamen/" title="Vermogensbeheer voor erfgenamen">Erfgenamen</a></li><li class="display_as_subpage"><a href="/vermogensbeheer/voor-professionals/" title="Vermogensbeheer voor professionals">Professionals</a></li><li><a href="/vermogensbeheer/institutioneel-vermogensbeheer/" title="Institutioneel vermogensbeheer"><b>Institutioneel</b> vermogensbeheer</a></li><li><a href="/vermogensbeheer/financieel-adviseurs/" title="OHV voor financieel adviseurs"><b>Financieel</b> adviseurs</a></li></ul></li><li><a href="/brokerage-services/" title="Markets Execution &amp; Solutions">Markets Execution &amp; Solutions</a></li><li><a data-toggle="collapse" data-parent="#side-menu-ul" href="#sub-menu4152">Exportfinanciering <i class="fa-regular fa-chevron-down fa-fw"></i></a><ul id="sub-menu4152" class="collapse"><li><a href="/exportfinanciering/" title="Exportfinanciering">Exportfinanciering</a></li></ul></li><li><a data-toggle="collapse" data-parent="#side-menu-ul" href="#sub-menu1028">Over OHV <i class="fa-regular fa-chevron-down fa-fw"></i></a><ul id="sub-menu1028" class="collapse"><li><a href="/over-ohv/ons-verhaal/" title="Uw toegang tot de financiële markten">Ons verhaal</a></li><li><a href="/over-ohv/geschiedenis/" title="Geschiedenis">Geschiedenis</a></li><li><a href="/nieuws/" title="Kennis &amp; Inzicht">Kennis &amp; Inzicht</a></li><li><a href="/over-ohv/vacatures/" title="Vacatures">Vacatures</a></li><li><a href="/over-ohv/informatie-dienstverlening/" title="Informatie dienstverlening">Informatie dienstverlening</a></li><li><a href="/over-ohv/informatie-duurzaam-beleggen/" title="Informatie duurzaam beleggen">Informatie duurzaam beleggen</a></li></ul></li><li><a href="/contact/" title="Contact">Contact</a></li></ul><ul class="list-unstyled" id="topmenu2"><li><a href="/veelgestelde-vragen/" title="Veelgestelde vragen">Veelgestelde vragen</a></li><li><a href="/inloggen/" title="Inloggen">Inloggen</a></li><li><a href="/downloads/" title="Downloads">Brochures</a></li><li><a href="/toegankelijkheid/" title="Toegankelijkheid">Toegankelijkheid</a></li><li><a href="/zoeken/" title="Zoeken">Zoeken</a></li></ul></div><div id="download-cta" data-aos="flip-down" data-aos-offset="0"><div class="inner"><img src="/site/assets/files/1169/ohv-mockup-brokerage-overzicht-downloads.png" alt="Markets Execution &amp; Solutions"><p><strong>Ontdek uw mogelijkheden</strong> <a href="/downloads/markets-execution-solutions/" title="Markets Execution &amp; Solutions">Lees brochure <span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 37.628 11.589"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m36.128 5.794-7.786-4.5v8.991ZM0 5.794h28.342"/></g></svg></span></a></p><span class="close-cta"><i class="fa-regular fa-xmark fa-fw"></i></span></div></div><div class="section special"><div class="container"><div class="row"><div class="col col-md-12 col-last" id="page-intro"><h1 data-aos="fade-up">Uw belang boven alles</h1><p data-aos="fade-up" data-aos-delay="200">Sinds 1932 zijn wij actief als bemiddelaar op de geld- en kapitaalmarkt. Hierdoor hebben wij een groot internationaal netwerk aan institutionele relaties opgebouwd. Ons markets team heeft toegang tot alle denkbare markten en producten. U kunt ons zien als makelaar op financi&euml;le markten. We brengen de vraag en het aanbod van geld bij elkaar waarbij uw belang boven alles staat.</p></div></div></div></div><div class="section special bg-transparent special-img-left" id="het-alternatief-voor-banken"><div class="container container-second"><div class="row"><div class="col col-img col-sm-12 col-md-6 col-mh" data-aos="fade-up" data-aos-delay="200"><img src="/site/assets/files/1198/ohv-3a4947-960x640.jpg" alt="Het alternatief voor banken" class="img-responsive"></div><div class="col col-sm-12 col-md-6 col-mh col-last" data-aos="fade-up" id="col-id-1198"><h2 class="mh-h2"><b>Het alternatief voor banken</b></h2><p>Als broker zijn wij bemiddelaar tussen geldgevers en geldnemers. OHV biedt u een institutionele orderdesk met wereldwijde toegang, tegen zeer aantrekkelijke tarieven. Dit maakt ons een goed alternatief voor banken. We zijn enerzijds actief op gereguleerde markten en anderzijds in staat om ook kleinere partijen in contact te brengen met institutionele beleggers met tegengestelde belangen.</p></div></div></div></div><div class="section special bg-transparent special-col3" id="ohv-bemiddelt-in"><div class="container container-second"><div class="row"><div class="col"><h2 class="text-center"><b>OHV bemiddelt in:</b></h2></div><div class="col col-sm-6 col-md-4 col-mh" data-aos="fade-up" id="col-id-1202"><h2 class="mh-h2">Staatsgegarandeerde leningen</h2><p>Decennialang is OHV marktleider in het bemiddelen van staatsgegarandeerde leningen. Onderdeel van de bemiddeling is de verzorging van leningsovereenkomsten. Gemeenten, woningbouwverenigingen, ziekenhuizen en waterschappen zijn de debiteuren. OHV brengt dagelijks duizenden geldnemers en geldgevers bij elkaar en bemiddelt in maatwerk op het gebied van looptijd, aflossing en startdata. Ideaal voor beleggers die aan looptijd matching willen doen.</p></div><div class="col col-sm-6 col-md-4 col-mh" data-aos="fade-up" data-aos-delay="200" id="col-id-1204"><h2 class="mh-h2">Exportfinanciering</h2><p>De Nederlandse overheid helpt de nationale industrie door garanties te verstrekken op de leningen voortkomend uit exporttransacties. Dit gebeurt door een aangewezen instantie. In Nederland is dit Atradius Dutch State Business.</p><p>Meer buitenlandse omzet behalen via exportfinanciering? Wij kunnen uw bedrijf snel en flexibel ondersteunen bij het financieren van uw buitenlandse klanten.</p><div class="buttons"><div><a href="https://www.ohv.nl/downloads/brochure-exportfinanciering/" target="_blank" class="btn btn-eq0 btn-green"><span>Brochure exportfinanciering</span></a></div></div></div><div class="col col-sm-6 col-md-4 col-mh col-last" data-aos="fade-up" data-aos-delay="400" id="col-id-1207"><h2 class="mh-h2">Execution only</h2><p>Execution Only betekent wereldwijde toegang in alle producten en markten tegen lage tarieven. Daarnaast biedt OHV als een van de weinige partijen in Nederland toegang tot de primaire markt. OHV is vanaf 1932 actief op de kapitaalmarkt en is specialist in obligaties. Door onze jarenlange ervaring en grote netwerk in de financi&euml;le markten van de handelaren is OHV uw partner bij uitstek voor het uitvoeren van uw effectentransacties.</p></div></div></div></div><div class="section special bg-transparent special-sidebars" id="cta"><div class="container-fluid"><div class="row"><div class="sidebar col-xs-12 col-sm-6" style="background-image:url('/site/assets/files/1096/ohv-14424-dark-1440x1440.jpg');"><div class="vcenter-sm"><div class="sidebar-inner"><div class="sidebar-img mh-img"><img src="/site/img/blank.png" alt="Vrijblijvend kennismakingsgesprek" class="img-responsive"></div><h2><b>Vrijblijvend<br>kennismakingsgesprek</b></h2><p>Tijdens een kennismakingsgesprek nemen wij uw mogelijkheden met u door op basis van uw (financiële) doelen, ambities en uitdagingen.</p><form method="post" action="/contact/vrijblijvend-kennismakingsgesprek/#sidebar-form" class="recaptchaForm-old"><div><input type="email" name="uw-email" value="" placeholder="Uw e-mailadres" required><button type="submit" class="btn btn-green pull-right" name="verstuur" value="Verstuur"><span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 37.628 11.589"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m36.128 5.794-7.786-4.5v8.991ZM0 5.794h28.342"/></g></svg></span></button></div><small>Door het formulier te verzenden, gaat u akkoord met het opslaan van uw gegevens zoals omschreven in onze privacy statement.</small></form></div></div></div><div class="sidebar col-xs-12 col-sm-6 bg-blue"><div class="vcenter-sm"><div class="sidebar-inner"><div class="sidebar-img mh-img"><img src="/site/assets/files/1169/ohv-mockup-brokerage-overzicht-downloads.png" alt="Markets Execution &amp; Solutions" class="img-responsive"></div><h2>Download brochure<br><b>Markets Execution &amp; Solutions</b></h2><p>Onze brochure Markets Execution &amp; Solutions geeft u een goed beeld van de dienstverlening van onze markets desk.</p><form method="post" action="/downloads/markets-execution-solutions/#sidebar-form" class="recaptchaForm-old"><div><input type="email" name="uw-email" value="" placeholder="Uw e-mailadres" required><button type="submit" class="btn btn-green pull-right" name="verstuur" value="Verstuur"><span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 37.628 11.589"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m36.128 5.794-7.786-4.5v8.991ZM0 5.794h28.342"/></g></svg></span></button></div><small>Door het formulier te verzenden, gaat u akkoord met het opslaan van uw gegevens zoals omschreven in onze privacy statement.</small></form></div></div></div></div></div></div><div class="section special bg-transparent special-news" id="actueel-amp-inzicht"><div class="container"><div class="row row-blocks"><div class="col col-xs-12 col-sm-6 col-md-8 col-mh col-main-title"><h2><b>Actueel &amp; Inzicht</b></h2></div><div class="col col-xs-12 col-sm-6 col-md-4 col-mh col-more hidden-xs"><a href="/nieuws/" title="Kennis &amp; Inzicht">Alle publicaties <span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 37.628 11.589"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m36.128 5.794-7.786-4.5v8.991ZM0 5.794h28.342"/></g></svg></span></a></div><div class="col col-xs-12 col-sm-6 col-md-4 mh-news"><div class="row row-in-row"><a href="/nieuws/wat-vermogende-particulieren-kunnen-leren-van-institutionele-beleggers/" title="Wat vermogende particulieren kunnen leren van institutionele beleggers" class="news-item item-0"><div class="col-xs-3 col-sm-12 col-img"><img src="/site/assets/files/10131/ohv-100819.500x324.jpg" alt="Wat vermogende particulieren kunnen leren van institutionele beleggers" class="img-responsive"> <span class="date hidden-xs"><b>Blog</b> | 1 september 2026</span></div><div class="col-xs-9 col-sm-12 col-title"><strong class="mh-h2">Wat vermogende particulieren kunnen leren van institutionele beleggers</strong><p class="mh-p hidden-xs">Bij vermogensbeheer boven €1 miljoen draait het niet alleen om rendement. Minstens zo belangrijk is dat uw vermogen aansluit bij uw doelen, uw horizon en de risico’s en verplichtingen die u onderweg moet kunnen opvangen.</p><span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 37.628 11.589"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m36.128 5.794-7.786-4.5v8.991ZM0 5.794h28.342"/></g></svg></span></div></a></div></div><div class="col col-xs-12 col-sm-6 col-md-4 mh-news"><div class="row row-in-row"><a href="/nieuws/de-mooiste-obligatiekansen-liggen-buiten-de-index/" title="De mooiste obligatiekansen liggen buiten de index" class="news-item item-1"><div class="col-xs-3 col-sm-12 col-img"><img src="/site/assets/files/9968/voor_de_groei-82949-1.500x324.jpg" alt="De mooiste obligatiekansen liggen buiten de index" class="img-responsive"> <span class="date hidden-xs"><b>Blog</b> | 29 juli 2026</span></div><div class="col-xs-9 col-sm-12 col-title"><strong class="mh-h2">De mooiste obligatiekansen liggen buiten de index</strong><p class="mh-p hidden-xs">Actief obligatiebeheer biedt kansen buiten de grote indices. OHV selecteert kleinere emissies, exportleningen en ondergewaardeerde obligaties en stuurt de portefeuille actief mee met renteontwikkelingen en marktomstandigheden. Zo ontstaat meerwaarde.</p><span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 37.628 11.589"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m36.128 5.794-7.786-4.5v8.991ZM0 5.794h28.342"/></g></svg></span></div></a></div></div><div class="col col-xs-12 col-sm-6 col-md-4 mh-news"><div class="row row-in-row"><a href="/nieuws/de-grootste-impact-maak-je-aan-de-financieringstafel/" title="De grootste impact maak je aan de financieringstafel" class="news-item item-2"><div class="col-xs-3 col-sm-12 col-img"><img src="/site/assets/files/9970/erik_profiel_1619_x_1080_px.500x324.png" alt="De grootste impact maak je aan de financieringstafel" class="img-responsive"> <span class="date hidden-xs"><b>Blog</b> | 4 juli 2026</span></div><div class="col-xs-9 col-sm-12 col-title"><strong class="mh-h2">De grootste impact maak je aan de financieringstafel</strong><p class="mh-p hidden-xs">Impactbeleggen wordt tastbaar wanneer kapitaal rechtstreeks naar het Nederlandse mkb gaat. Mkb-financiering maakt groei, innovatie, banen en verduurzaming mogelijk en geeft beleggers de kans om dicht bij huis concreet verschil te maken in Nederland.</p><span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 37.628 11.589"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m36.128 5.794-7.786-4.5v8.991ZM0 5.794h28.342"/></g></svg></span></div></a></div></div></div></div></div><div class="section special bg-transparent special-sidebars" id="cta"><div class="container-fluid"><div class="row"><div class="sidebar col-xs-12 col-sm-6 bg-blue"><div class="vcenter-sm"><div class="sidebar-inner"><div class="sidebar-img mh-img"><img src="/site/assets/files/1166/ohv-mockup-exportfinanciering.png" alt="Exportfinanciering" class="img-responsive"></div><h2>Ontvang de brochure<br><b>Exportfinanciering</b></h2><p>In de brochure geven wij een overzicht van een aantal mogelijkheden om uw export te bevorderen.</p><form method="post" action="/downloads/brochure-exportfinanciering/#sidebar-form" class="recaptchaForm-old"><div><input type="email" name="uw-email" value="" placeholder="Uw e-mailadres" required><button type="submit" class="btn btn-green pull-right" name="verstuur" value="Verstuur"><span class="arrow"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 37.628 11.589"><g fill="none" stroke="currentColor" stroke-width="1.5"><path d="m36.128 5.794-7.786-4.5v8.991ZM0 5.794h28.342"/></g></svg></span></button></div><small>Door het formulier te verzenden, gaat u akkoord met het opslaan van uw gegevens zoals omschreven in onze privacy statement.</small></form></div></div></div><div class="sidebar col-xs-12 col-sm-6"><div class="vcenter-sm"><div class="sidebar-inner"><div class="sidebar-img mh-img"><img src="/site/assets/files/1223/ohv-nieuwsbrief.png" alt="Nieuwsbrief OHV" class="img-responsive"></div><h2>Nieuwsbrief<br><b>OHV Vermogensbeheer</b></h2><p>In 