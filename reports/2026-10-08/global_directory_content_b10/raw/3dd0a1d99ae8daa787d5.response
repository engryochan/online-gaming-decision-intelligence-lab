	<script nonce="d93BfFBS7SCVqaRD/vA8Hw==">
		document.addEventListener("DOMContentLoaded", function () {
			let accordionId = "flush-collapse5";
			let element = document.getElementById(accordionId);
			if (element) {
				let accordionHeader = element.previousElementSibling;
