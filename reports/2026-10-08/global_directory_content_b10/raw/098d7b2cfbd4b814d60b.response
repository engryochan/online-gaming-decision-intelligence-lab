<style id="wp-custom-css">
/* Only the header CTA, not all site buttons */
header /* Header Request Demo: force one-line pill across sizes */
header a.qodef-qi-button.qodef-layout--outlined {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: auto !important;
  min-width: max-content !important;
  border-radius: 9999px !important;
  padding: 10px 22px !important;
  line-height: 1 !important;
  box-sizing: border-box !important;
}

/* Prevent internal Qode text wrapping */
header a.qodef-qi-button.qodef-layout--outlined .qodef-m-text,
header a.qodef-qi-button.qodef-layout--outlined span {
  white-space: nowrap !important;
  word-break: normal !important;
  overflow-wrap: normal !important;
  display: inline !important;
  line-height: 1 !important;
}

/* Tablet tuning */
@media (max-width: 1180px) {
  header a.qodef-qi-button.qodef-layout--outlined {
    font-size: 16px !important;
    padding: 9px 18px !important;
  }
}

/* Mobile tuning */
@media (max-width: 767px) {
  header a.qodef-qi-button.qodef-layout--outlined {
    font-size: 15px !important;
    padding: 8px 16px !important;
  }
}

@media (max-width: 1024px) {
  .elementor-location-header,
  header {
    position: relative;
    z-index: 10000 !important;
  }

  .elementor-menu-toggle {
    position: relative;
    z-index: 10003 !important;
  }

  .elementor-nav-menu--dropdown.elementor-nav-menu__container {
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: auto !important;
    bottom: 0 !important;
    height: 100dvh !important;
    width: min(400px, calc(100vw - 24px)) !important;
    max-width: calc(100vw - 24px) !important;
    margin: 0 !important;
    padding: 84px 0 20px 0 !important;
    box-sizing: border-box !important;
    transform: translate3d(-100%, 0, 0) !important;
    transition: transform 260ms ease, opacity 200ms ease, visibility 200ms ease !important;
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
    overflow: hidden !important;
    -webkit-overflow-scrolling: touch;
    z-index: 10002 !important;
  }

  .elementor-menu-toggle[aria-expanded="true"] + .elementor-nav-menu--dropdown.elementor-nav-menu__container,
  .elementor-menu-toggle[aria-expanded="true"] ~ .elementor-nav-menu--dropdown.elementor-nav-menu__container,
  .elementor-menu-toggle.elementor-active + .elementor-nav-menu--dropdown.elementor-nav-menu__container,
  .elementor-menu-toggle.elementor-active ~ .elementor-nav-menu--dropdown.elementor-nav-menu__container {
    transform: translate3d(0, 0, 0) !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
  }

  .elementor-nav-menu--dropdown.elementor-nav-menu__container::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    transition: opacity 200ms ease;
    z-index: -1;
  }

  .elementor-menu-toggle[aria-expanded="true"] + .elementor-nav-menu--dropdown.elementor-nav-menu__container::before,
  .elementor-menu-toggle[aria-expanded="true"] ~ .elementor-nav-menu--dropdown.elementor-nav-menu__container::before,
  .elementor-menu-toggle.elementor-active + .elementor-nav-menu--dropdown.elementor-nav-menu__container::before,
  .elementor-menu-toggle.elementor-active ~ .elementor-nav-menu--dropdown.elementor-nav-menu__container::before {
    opacity: 1;
    pointer-events: auto;
  }

  .elementor-nav-menu--dropdown.elementor-nav-menu__container .elementor-nav-menu,
  .elementor-nav-menu--dropdown.elementor-nav-menu__container .menu,
  .elementor-nav-menu--dropdown.elementor-nav-menu__container ul,
  .elementor-nav-menu--dropdown.elementor-nav-menu__container li {
    margin: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
    left: 0 !important;
    width: 100% !important;
    max-width: 100% !important;
    transform: none !important;
  }

  html,
  body {
    overflow-x: hidden !important;
  }
}

@media (max-width: 767px) {
  .elementor-nav-menu--dropdown.elementor-nav-menu__container {
    left: 0 !important;
    right: 0 !important;
    width: 100vw !important;
    max-width: 100vw !important;
  }
}

@media (max-width: 1024px) {
  .elementor-nav-menu--dropdown.elementor-nav-menu__container {
    background: #ffffff !important;
    border-radius: 0 !important;
    box-shadow: 12px 0 28px rgba(17, 24, 39, 0.14) !important;
  }

  .elementor-nav-menu--dropdown .menu-item > a,
  .elementor-nav-menu--dropdown .elementor-item {
    min-height: 48px;
    padding: 12px 22px !important;
    font-size: 16px;
    line-height: 1.3;
    font-weight: 500;
    color: #1f2430 !important;
    background: #ffffff !important;
    border: 0 !important;
    box-shadow: none !important;
  }

  .elementor-nav-menu--dropdown .menu-item {
    border-bottom: 1px solid #e8eaf0;
  }

  .elementor-nav-menu--dropdown .menu-item:last-child {
    border-bottom: 0;
  }

  .elementor-nav-menu--dropdown .menu-item > a:hover,
  .elementor-nav-menu--dropdown .menu-item > a:focus {
    background: rgba(0, 0, 255, 0.06) !important;
    color: #0000ff !important;
  }

  .elementor-nav-menu--dropdown .current-menu-item > a,
  .elementor-nav-menu--dropdown .current-menu-ancestor > a,
  .elementor-nav-menu--dropdown .current_page_item > a,
  .elementor-nav-menu--dropdown .menu-item > a.elementor-item-active,
  .elementor-nav-menu--dropdown .menu-item > a[aria-current="page"] {
    color: #0000ff !important;
    font-weight: 600 !important;
    background: rgba(0, 0, 255, 0.07) !important;
  }

  .elementor-nav-menu--dropdown .menu-item-has-children > a {
    color: #1f2430 !important;
    font-weight: 600;
  }

  .elementor-nav-menu--dropdown .sub-menu {
    margin: 0 !important;
    padding: 4px 0 8px !important;
    border-left: 2px solid rgba(0, 0, 255, 0.14);
  }

  .elementor-nav-menu--dropdown .sub-menu > li > a {
    padding: 10px 22px 10px 36px !important;
    font-size: 15px;
    font-weight: 500;
    color: #3a4252 !important;
    background: #ffffff !important;
  }

  .elementor-nav-menu--dropdown .sub-menu > li > a:hover,
  .elementor-nav-menu--dropdown .sub-menu > li > a:focus {
    color: #0000ff !important;
    background: rgba(0, 0, 255, 0.05) !important;
  }

  .elementor-nav-menu--dropdown .sub-menu .current-menu-item > a,
  .elementor-nav-menu--dropdown .sub-menu .current_page_item > a {
    color: #0000ff !important;
    font-weight: 600 !important;
    background: rgba(0, 0, 255, 0.08) !important;
  }

  .elementor-nav-menu--dropdown .sub-arrow,
  .elementor-nav-menu--dropdown .sub-arrow i,
  .elementor-nav-menu--dropdown .sub-arrow svg {
    color: #6b7280 !important;
    fill: #6b7280 !important;
    font-size: 12px !important;
    width: 12px;
    height: 12px;
  }

  .elementor-nav-menu--dropdown .menu-item-has-children > a[aria-expanded="true"] .sub-arrow,
  .elementor-nav-menu--dropdown .menu-item-has-children > a[aria-expanded="true"] .sub-arrow i,
  .elementor-nav-menu--dropdown .menu-item-has-children > a[aria-expanded="true"] .sub-arrow svg,
  .elementor-nav-menu--dropdown .menu-item-has-children.current-menu-ancestor > a .sub-arrow,
  .elementor-nav-menu--dropdown .menu-item-has-children.current-menu-ancestor > a .sub-arrow i,
  .elementor-nav-menu--dropdown .menu-item-has-children.current-menu-ancestor > a .sub-arrow svg {
    color: #0000ff !important;
    fill: #0000ff !important;
  }

  .elementor-nav-menu--dropdown .menu-item > a {
    white-space: normal;
    word-break: normal;
    overflow-wrap: anywhere;
  }
}

/* Banner layout */
:root {
  --oy-banner-height: 76px;
  --oy-shell-header-height: 76px;
}

.oy-top-banner {
  position: sticky;
  top: 0;
  width: 100%;
  min-height: var(--oy-banner-height);
  margin: 0;
  overflow: hidden;
  background: linear-gradient(90deg, #1c32ff 0%, #1023d8 48%, #0a148f 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 28px;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  border: 0;
  z-index: 10001;
}

.oy-top-banner__texture {
  position: absolute;
  top: 50%;
  width: 760px;
  opacity: 0.95;
  pointer-events: none;
}

.oy-top-banner__texture--left {
  left: -205px;
  transform: translateY(-50%);
  opacity: 0.88;
  -webkit-mask-image: linear-gradient(
    to right,
    #000 0%,
    #000 44%,
    rgba(0,0,0,0.82) 58%,
    rgba(0,0,0,0.38) 72%,
    transparent 88%
  );
  mask-image: linear-gradient(
    to right,
    #000 0%,
    #000 44%,
    rgba(0,0,0,0.82) 58%,
    rgba(0,0,0,0.38) 72%,
    transparent 88%
  );
}

.oy-top-banner__texture--right {
  right: -180px;
  transform: translateY(-50%);
  -webkit-mask-image: linear-gradient(
    to left,
    #000 0%,
    #000 44%,
    rgba(0,0,0,0.85) 54%,
    rgba(0,0,0,0.35) 68%,
    transparent 82%
  );
  mask-image: linear-gradient(
    to left,
    #000 0%,
    #000 44%,
    rgba(0,0,0,0.85) 54%,
    rgba(0,0,0,0.35) 68%,
    transparent 82%
  );
}

.oy-top-banner__text {
  position: relative;
  z-index: 2;
  margin: 0;
  color: rgba(255, 255, 255, 0.97);
  font-size: 24px;
  line-height: 1.2;
  letter-spacing: -0.025em;
  font-weight: 400;
  text-align: center;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.18);
  white-space: nowrap;
  padding: 0 24px;
}

.oy-top-banner__text strong {
  font-weight: 600;
  color: #ffffff;
}

body:has(.oy-top-banner) {
  padding-top: var(--oy-shell-header-height) !important;
}

body:has(.oy-top-banner) .oy-header {
  top: var(--oy-banner-height) !important;
}

body:has(.oy-top-banner) .oy-mobile-nav {
  top: calc(var(--oy-banner-height) + var(--oy-shell-header-height)) !important;
  max-height: calc(100vh - var(--oy-banner-height) - var(--oy-shell-header-height)) !important;
}

body:has(.oy-top-banner).admin-bar .oy-header {
  top: calc(32px + var(--oy-banner-height)) !important;
}

body:has(.oy-top-banner).admin-bar .oy-mobile-nav {
  top: calc(32px + var(--oy-banner-height) + var(--oy-shell-header-height)) !important;
  max-height: calc(100vh - 32px - var(--oy-banner-height) - var(--oy-shell-header-height)) !important;
}

@media (max-width: 1024px) {
  :root {
    --oy-banner-height: 68px;
  }

  .oy-top-banner {
    min-height: var(--oy-banner-height);
    padding: 0 20px;
  }

  .oy-top-banner__texture {
    width: 620px;
  }

  .oy-top-banner__texture--left {
    left: -185px;
  }

  .oy-top-banner__texture--right {
    right: -160px;
  }

  .oy-top-banner__text {
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    padding: 0 20px;
  }
}

@media (max-width: 767px) {
  :root {
    --oy-banner-height: 58px;
  }

  .oy-top-banner {
    min-height: var(--oy-banner-height);
    padding: 12px 16px;
  }

  .oy-top-banner__texture {
    width: 420px;
    opacity: 0.84;
  }

  .oy-top-banner__texture--left {
    left: -125px;
  }

  .oy-top-banner__texture--right {
    right: -110px;
  }

  .oy-top-banner__text {
    font-size: 14px;
    line-height: 1.35;
    letter-spacing: -0.01em;
    white-space: normal;
    padding: 0 12px;
  }
}

</style>
</head>
