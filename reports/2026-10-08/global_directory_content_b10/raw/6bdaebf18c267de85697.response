							<div class="" data-fragments-editor-item-id="20109-20274270" data-fragments-editor-item-type="fragments-editor-mapped-item" >
								
























	
	
	
		<div class="journal-content-article " data-analytics-asset-id="3962043" data-analytics-asset-title="SV_Online_PT_Security" data-analytics-asset-type="web-content" data-analytics-web-content-resource-pk="20274270">
			

			





<div class="dt-product-description">
	<div class="row portlet-column">
		<div class="col-sm-12 col-lg-6 dt-product">
			<div class="dt-content dt-content-module">
					<h1 class="heading1 dt-red">Oberbank Security App</h1>
				<p>Die Oberbank Security App ist ein Verfahren, um Transaktionen im Internetbanking freizugeben.</p>

<p>&nbsp;</p>

<ul class="dt-check">
	<li>Sicher &amp; einfach</li>
	<li>Ohne manuelle Eingabe von TAN-Codes</li>
	<li>Mehr Zahlungsinformationen bei der Freigabe von Aufträgen&nbsp;</li>
</ul>

<p>&nbsp;</p>

<p>&nbsp;</p>

<p id="yui_patched_v3_11_0_1_1547715663934_939"><strong id="yui_patched_v3_11_0_1_1547715663934_938">Security App Support Hotline</strong></p>

<p>Mo bis Fr: 08:00 - 18:00 Uhr (an Bankwerktagen)</p>

<p>Sa: 08:00 - 13:00 Uhr</p>

<p><a class="dt-a-tel-red" href="tel:004373278020">+ 43 732 / 7802 - 0</a></p>

<p><a class="dt-a-mail" href="mailto:ebanking@oberbank.at?subject=Security%20App">ebanking@oberbank.at</a></p>
			</div>
		</div>
			<div class="col-sm-12 col-lg-6 dt-picture">
				<picture title="Oberbank Security App am Smartphone" class="lazy" data-iesrc="/o/documents/20195/104734/SecurityAppATDE_kl_1932x1288.jpg/9b7030fe-b080-be4b-044c-ca78ccba6d7d?t=1776430047865&imageThumbnail=0612">
					<!--[if IE 9]><video style="display: none;"><![endif]-->
