							<div class="" data-fragments-editor-item-id="20109-20272823" data-fragments-editor-item-type="fragments-editor-mapped-item" >
								
























	
	
	
		<div class="journal-content-article " data-analytics-asset-id="11563884" data-analytics-asset-title="SV_Online_TMklein_ChatMia" data-analytics-asset-type="web-content" data-analytics-web-content-resource-pk="20272823">
			

			











	<div class="dt-picture-text dt-content-module   dt-has-background" style="background: #E9EDED;">

		<div class="dt-content" style="border-color: transparent;">
				<h2 class="heading2 ">Ihre interaktive Online-Assistentin</h2>
				<hr role="presentation">
				<p>Unser <strong>Chatbot&nbsp;Mia</strong> ist rund um die Uhr auf unserer Website &amp; im Oberbank Kundenportal für Sie verfügbar.</p>

<p>&nbsp;</p>
				<div><a class="dt-a-arrow dt-animated" href="/chatbot-mia" title="Zum Chatbot Mia" target=""><span class="vc">Zum Chatbot Mia</span></a></div>
		</div>

	</div>

			
		</div>

		

	



