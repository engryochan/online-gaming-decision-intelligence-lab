<div class="col-md-6 col-lg-4 col-xxl-3 col-12">
    <div class="card">
        <div class="card-img-top" style="background-image: url('/images/imgsSubidas/empresas/Hawk-Biosystems/Foto-fondo.jpg');">
            <div class="overlay-bg"></div>
