.ttsec-category-sidebar {
    border: 1px solid var(--e-global-color-9b30ee3);
    padding: 16px 0;
    background: var(--e-global-color-9b30ee3);
    border-radius: 14px;
    margin: 48px 0 40px;
}

.ttsec-category-sidebar p {
    color: var(--e-global-color-secondary);
    padding: 0 15px;
    font-size: 12px;
    text-transform: uppercase;
    margin: 0 0 10px !important;
    font-weight: 600;
}

.parent-category {
    font-weight: 600;
    font-size: 16px;
    padding: 4px 16px;
}

.parent-category a {
    color: #fff;
    text-decoration: none;
}

.parent-category a:hover {
    color: #fff;
}

.parent-category.active {
    background: #fff;
}

.parent-category.active a {
    color: var(--e-global-color-9b30ee3);
}

ul.category-tree {
    margin: 0;
    list-style: none;
    font-size: 14px;
}

ul.category-tree li {
    padding: 8px 16px;

}
ul.category-tree li.active {
    background-color: #fff;
}

ul.category-tree li.active a {
    font-weight: 600;
    color: var(--e-global-color-9b30ee3);
}

ul.category-tree li a {
    color: #fff;
}

ul.category-tree li a {
    display: block;
}

.ttsec-category-sidebar span.toggle {
    color: #fff;
    font-size: 20px;
    /* vertical-align: middle; */
    /* margin-right: 5px; */
    font-weight: 600;
    position: absolute;
    right: 10px;
    /* margin-top: -7px; */
    top: -5px;
    display: none;
}

ul.category-tree li {
    padding: 0;
    position: relative;
}



ul.category-tree li a {
    color: #fff;
    padding: 6px 16px;
    display: block;
}

ul.category-tree li ul {
    margin: 0;
    list-style: none;
    padding: 0;
}

ul.category-tree li ul li a {
    padding: 4px 32px;
}

@media screen and (max-width: 768px) {
    .ttsec-category-sidebar{
        display: none;
    }

    select#ttsec-category-select {
        margin: 10px 0;
        border-radius: 20px;
        border-color: var(--ast-global-color-0);
        border-width: 2px;
    }
}
</style>
