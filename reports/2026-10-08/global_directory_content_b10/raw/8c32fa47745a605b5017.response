<script src="/assets/application.js" data-turbolinks-track="true"></script>
  <script type="text/javascript">
    (function() {
      var container = document.getElementById('ticker-container');
      var items = document.getElementById('ticker-items');
      if (!container || !items) return;

      var pos = 0;
      var speed = 0.8;
      var animationId = null;
      var itemWidth = 0;
      var containerWidth = 0;

      function updateWidths() {
        itemWidth = items.scrollWidth;
        containerWidth = container.offsetWidth;
        if (itemWidth <= containerWidth) {
          if (animationId) {
            cancelAnimationFrame(animationId);
            animationId = null;
          }
          items.style.transform = 'translateX(0)';
          return false;
        }
        return true;
      }

      function animate() {
        if (!animationId) return;
        pos -= speed;
        if (Math.abs(pos) >= itemWidth / 2) {
          pos = 0;
        }
        items.style.transform = 'translateX(' + pos + 'px)';
        animationId = requestAnimationFrame(animate);
      }

      function startAnimation() {
        if (animationId) {
          cancelAnimationFrame(animationId);
          animationId = null;
        }
        if (updateWidths()) {
          pos = 0;
          animationId = requestAnimationFrame(animate);
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', startAnimation);
      } else {
        startAnimation();
      }

      var resizeTimeout;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimeout);
        resizeTimeout = setTimeout(function() {
          startAnimation();
        }, 300);
      });

      window.addEventListener('load', function() {
        setTimeout(startAnimation, 500);
      });
    })();
  </script>


<script type="text/javascript">
  var isMicMode = false;
  var currentLocale = "ru";
  var voiceLang = currentLocale == 'en' ? 'en-US' : 'ru-RU';

  $('#grayscale-btn').click(function(e) {
    e.preventDefault();

    if ($('body').hasClass('grayscale')) {
      $(this).parent('li').removeClass('active');
      $('body').removeClass('grayscale');
    } else {
      $(this).parent('li').addClass('active');
      $('body').addClass('grayscale');
    }

    var $target = $(this);
    $.getJSON('/grayscale', function(data) {
      $target.blur();
    });
  });

  $('#microphone-btn').click(function(e) {
    e.preventDefault();

    isMicMode = !isMicMode;
    if (isMicMode) {
      $(this).parent('li').addClass('active');
      $('html,body').css('cursor', 'pointer');
    } else {
      $(this).parent('li').removeClass('active');
      $(this).blur();
      $('html,body').css('cursor', 'auto');
    }
  });

  $(document).hover(function() {
    $(this).toggleClass('result_hover');
  });

  $(document).click(function(event) {
    if (isMicMode && event.target.id != 'microphone-btn') {
      event.preventDefault();

      var text = '';
      var utterance;

      if ($(event.target).is('img')) {
        text = $(event.target).attr('alt');
        utterance = new SpeechSynthesisUtterance(text);
      } else {
        text = $(event.target).text();
        utterance = new SpeechSynthesisUtterance(text);
      }
      utterance.lang = voiceLang;
      window.speechSynthesis.speak(utterance);
    }
  });

  $(function() {
    $('[data-toggle="tooltip"]').tooltip();
  });
</script>
<script>
  $('.dropdown-submenu > a').on('click', function(e) {
    if ($(window).width() > 768) {
      e.preventDefault();
      window.location.href = $(this).attr('href');
    }
  });
</script>
