body[data-header-search=false][data-full-width-header=false] #header-outer[data-lhe=text_reveal][data-format=default][data-cart=false] #top nav>ul>li:not([class*=menu-item-btn-style]):last-child>a {
    padding-right: 20px;
}


#footer-widgets {
    display: none;
}


#inner-banner .row-bg-wrap .row-bg {
    background-size: contain;
}

.before-footer .footer-link {
    margin-bottom: 5px;
}


@media only screen and (min-width: 1000px) and (max-width: 1300px) {
    #header-outer #top .sf-menu .menu-item a {
        padding-left: 15px !important;
        padding-right: 15px  !important;
    }
}



@media only screen and (max-width: 999px) {
    
    #hero-banner .vc_row.vc_row-o-columns-top.vc_row-o-full-height>.span_12 {
        align-content: center;
    }
    
    #intro-section .full-width-section .row-bg {
        background-size: contain;
        
    }
    
}
