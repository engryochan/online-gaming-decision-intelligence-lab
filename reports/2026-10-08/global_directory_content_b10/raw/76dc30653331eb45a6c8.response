        <div class="tabs-tab tabs-tab-m">
            <span class="tabs-tab-number">03</span>
            
            <span class="tabs-tab-text">Banking</span>
        </div>
        <div id="tabs-57e07d41e1-item-0dc82fc922-tabpanel" role="tabpanel" aria-labelledby="tabs-57e07d41e1-item-0dc82fc922-tab" tabindex="-1" class="cmp-tabs__tabpanel" data-cmp-hook-tabs="tabpanel" data-cmp-data-layer="{&#34;tabs-57e07d41e1-item-0dc82fc922&#34;:{&#34;@type&#34;:&#34;core/wcm/components/tabs/v1/tabs/item&#34;,&#34;dc:title&#34;:&#34;Banking&#34;}}">
