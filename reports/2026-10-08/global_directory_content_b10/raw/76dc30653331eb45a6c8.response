        <div id="tabs-e20f2dab30-item-ffb331683d-tabpanel" role="tabpanel" aria-labelledby="tabs-e20f2dab30-item-ffb331683d-tab" tabindex="-1" class="cmp-tabs__tabpanel cmp-tabs__tabpanel--active" data-cmp-hook-tabs="tabpanel" data-cmp-data-layer="{&#34;tabs-e20f2dab30-item-ffb331683d&#34;:{&#34;@type&#34;:&#34;core/wcm/components/tabs/v1/tabs/item&#34;,&#34;dc:title&#34;:&#34;Data types&#34;}}">
