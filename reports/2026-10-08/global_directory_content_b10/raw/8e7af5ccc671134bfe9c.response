<script>
document.addEventListener("scroll", () => {
    const counters = document.querySelectorAll('.counter');
    counters.forEach(counter => {
        const rect = counter.getBoundingClientRect();
        const isVisible = rect.top < window.innerHeight && rect.bottom > 0;

        if (isVisible && !counter.dataset.counted) {
            const target = +counter.getAttribute('data-digits-counter');
            let current = 0;
            const increment = Math.ceil(target / 100);

            const updateCount = () => {
                current += increment;
                if (current < target) {
                    counter.textContent = current;
                    requestAnimationFrame(updateCount);
                } else {
                    counter.textContent = target;
                }
            };

            updateCount();
            counter.dataset.counted = true;
        }
    });
});
	jQuery(document).ready(function() {
		jQuery('.spollers-faq__title').click(function() {
			if(jQuery(this).hasClass('_spoller-active')) {
				jQuery(this).removeClass('_spoller-active');
				jQuery(this).parent().find('.spollers-faq__body').slideUp('slow');
			} else { 
				jQuery(this).addClass('_spoller-active');
				jQuery(this).parent().find('.spollers-faq__body').slideDown('slow');
			}
		})
		jQuery('.title_accordion').click(function() {
			if(jQuery(this).hasClass('active')) {
				jQuery(this).removeClass('active');
			   jQuery(this).next().slideUp('slow');
			} else {
				jQuery(this).addClass('active');
			   jQuery(this).next().slideDown('slow');
			}
		})
		  jQuery('.wpcf7-file').on('change', function () {
    const fileName = jQuery(this).prop('files')[0]?.name || 'Upload file';

    jQuery('.visible_block_file').text(fileName);
  });
	jQuery('.modal_call').click(function() {
	jQuery('#overlay').fadeIn('slow');
	})
	jQuery('.close_form').click(function() {
	jQuery('#overlay').fadeOut('slow');
	})
	jQuery('.block_acc_newspaper label').click(function() {
	var textInput = jQuery(this).find('input').val();
	jQuery('.block_acc_newspaper .title_accordion').text(textInput);
	jQuery('.block_acc_newspaper .content_accordion').slideUp('slow');
	jQuery('.block_acc_newspaper .title_accordion').removeClass('active');
	})
	jQuery('.block_acc_mortgages label').click(function() {
	var textInputMort = jQuery(this).find('input').val();
	jQuery('.block_acc_mortgages .title_accordion').text(textInputMort);
	jQuery('.block_acc_mortgages .content_accordion').slideUp('slow');
	jQuery('.block_acc_mortgages .title_accordion').removeClass('active');
	})
	jQuery('.block_acc_mortgages .radio_form .first input').attr('checked', true);
	jQuery('.block_acc_newspaper .radio_form .first input').attr('checked', true);
	})
	
	jQuery('.button_filter').click(function() {
	if(jQuery(this).parent().hasClass('show')) {
	jQuery(this).parent().removeClass('show');
	jQuery('.list_filter_form').slideUp('slow');
	} else {
		jQuery(this).parent().addClass('show');
	jQuery('.list_filter_form').slideDown('slow');
	}
	})
	jQuery('.table_filter_list_tab > ul > li:first-child').addClass('active');
	jQuery('.table_content_list > .table_content:first-child').addClass('active');
	
	    jQuery('.table_filter_list_tab li').on('click', function () {
        jQuery('.table_filter_list_tab li, .table_content').removeClass('active');

        jQuery(this).addClass('active');
        const targetTab = jQuery(this).data('tab');
        jQuery('#' + targetTab).addClass('active');
	jQuery('#' + targetTab).find('.button_reset').click();
    });
	
	(function ($) {
$(document).ready(function () {
	
	$('.spollers .spollers__title').click();
	
	$('.active_title_custom_select').click(function() {
		$(this).parent().addClass('active');
	})
	$('.hidden_values_block ul li').click(function() {
	$(this).parent().parent().parent().removeClass('active');
	})
	
	$(document).mouseup(function (e) {
    var container = $(".hidden_values_block");
    if (container.has(e.target).length === 0){
	$(container).parent().removeClass('active');
    }
});
	
	
	  $('.table_content').each(function() {
    const $tab = $(this);

    function filterTab() {
      $tab.find('.line_table_content').each(function() {
        let show = true;

        const companyName = $tab.find('input[name="company_name"]').val().toLowerCase();
        if (companyName && !$(this).find('[data-attr="company_name"]').text().toLowerCase().includes(companyName)) {
          show = false;
        }

        const noticeNo = $tab.find('input[name="notice_no"]').val().toLowerCase();
        if (noticeNo && !$(this).find('[data-attr="notice_number"]').text().toLowerCase().includes(noticeNo)) {
          show = false;
        }

        const legislation = $tab.find('input[name="legislation"]').val().toLowerCase();
        if (legislation && !$(this).find('[data-attr="legislation"]').text().toLowerCase().includes(legislation)) {
          show = false;
        }

        const noticeType = $tab.find('.custom_select[data-filter="notice_type"] .active_title_custom_select').text().trim().toLowerCase();
        if (noticeType !== 'notice type' && !$(this).find('[data-attr="notise_type"]').text().toLowerCase().includes(noticeType)) {
          show = false;
        }

        const effectiveDate = $tab.find('.custom_select[data-filter="effective_date"] .active_title_custom_select').text().trim().toLowerCase();
        if (effectiveDate !== 'effective date' && !$(this).find('[data-attr="effective_data"]').text().toLowerCase().includes(effectiveDate)) {
          show = false;
        }

        const status = $tab.find('.custom_select[data-filter="status"] .active_title_custom_select').text().trim().toLowerCase();
        if (status !== 'status' && !$(this).find('[data-attr="status"]').text().toLowerCase().includes(status)) {
          show = false;
        }
	

        if (show) {
          $(this).show();
        } else {
          $(this).hide();
        }
      });
    }

    $tab.find('input[name="company_name"], input[name="notice_no"], input[name="legislation"]').on('input', filterTab);
    $tab.find('.custom_select .hidden_values_block li').on('click', function() {
      const select = $(this).closest('.custom_select');
      select.find('.active_title_custom_select').text($(this).text());
      filterTab();
    });

    $tab.find('.button_reset').on('click', function() {
      $tab.find('input[name="company_name"], input[name="notice_no"], input[name="legislation"]').val('');
      $tab.find('.custom_select .active_title_custom_select').each(function() {
        $(this).text($(this).attr('data-default') || $(this).text());
      });
      filterTab();
    });
	

    $tab.find('.button_search').on('click', filterTab);
  });
	
    
});
})(jQuery);

	
</script>

<style>
.block_text_content {
	display: none;
}
	.form_line {
		    display: flex;
    align-items: center;
    margin-bottom: 30px;
	}
	.form_label {
	    margin-right: 30px;
    min-width: 206px;
	}
	.form_line select {
		    border: 1px solid #ccc;
    padding: 10px 20px;
    border-radius: 5px;
	}
		.form_line input[type="text"], .form_line input[type="email"], .form_line input[type="tel"], .form_line input[type="number"] {
		    border: 1px solid #ccc;
    padding: 10px 20px;
    border-radius: 5px;
			outline: none
	}
	.title_form_second {
		font-size: 20px;
    font-weight: bold;
    margin-bottom: 45px;
	}
	.wrap_form {
		margin-bottom: 70px;
	}
	.block_text_form h3 {
		    font-weight: bold;
    font-size: 18px;
    margin-bottom: 15px;
	}
	.block_text_form p {
		    line-height: 150%;
    margin-bottom: 20px;
	}
	.block_text_form ol {
		    padding-left: 20px;
	}
	.block_text_form ol > li {
		margin-bottom: 20px;
		line-height: 150%;
	}
	.block_text_form ol > ul {
		    padding-left: 20px;
    margin: 20px 0;
	}
	.block_text_form ol > ul > li {
		    list-style: lower-roman;
		margin-bottom: 20px;
		line-height: 150%;
	}
	.hidden_form {
		display: none;
	}
		.hidden_form.show {
		display: flex;
	}
	.form_line textarea {
		border: 1px solid #ccc;
    padding: 10px 20px;
    border-radius: 5px;
    outline: none;
	}
	.wrap_form input[type="submit"] {
		    background: #000;
    color: #fff;
    padding: 20px;
    border-radius: 5px;
    max-width: 200px;
    cursor: pointer;
    font-weight: bold;
    text-transform: uppercase;
    margin-left: 236px;
	}
	.select {
    display: block;
    max-width: 215px;
    width: 100%;
    position: relative;
}
.copy_select {
position: relative;
    border: 1px solid #ced4da;
    padding: 10px 15px;
    cursor: pointer;
    user-select: none;
    padding-right: 35px;
}
.option_list {
    position: absolute;
    top: 45px;
    left: 0;
    border: 1px solid #ced4da;
    cursor: pointer;
    width: 100%;
    z-index: 2;
    background: #fff;
    user-select: none;
}
.option_list.on {
    display: block;
}
.option_item span {
    display: block;
    padding: 10px 15px;
}
.option_item span:hover {
    color: #12b223;
}
.copy_select:after {
    content: '';
    display: block;
	background: url(https://afsa.aifc.kz/wp-content/themes/afsa/img/bottom-arrow.svg) no-repeat;
     position: absolute;
    right: 9px;
    top: 11px;
    width: 15px;
    height: 15px;
    line-height: 20px;
    opacity: 0.6;
    transition: all .27s ease-in-out;
    transform: rotate(0deg);
    font-size: 18px;
}
	.form_input {
		min-width: 200px;
		    min-width: 40%;
	}
	.copy_select.on:after {
		transform: rotate(180deg);
	}
	.wpcf7 form .wpcf7-response-output {
		    margin-left: 236px !important;
    max-width: 411px;
    margin-bottom: 50px !important;
    line-height: 150% !important;
    padding: 20px !important;
    text-align: center !important;
	}
	.req {
		    line-height: 150%;
    margin-left: 236px;
    max-width: 435px;
    margin-bottom: 35px;
	}
	@media screen and (max-width:767px) {
	.form_label {
    margin-right: 0;
    margin-bottom: 20px;
}
		.form_input {
    min-width: 100%;
}
		.form_line {
    flex-wrap: wrap;
}
		.req {
    margin-left: 0;
}
		.wrap_form input[type="submit"] {
    margin-left: 0;
}
	}
</style>

<script>
jQuery(document).ready(function($) {

  $('.select').each((index, element) => {
    const $this = $(element).hide().wrap('<div class="select"></div>');
    const $select = $('<div>', {
      class: 'copy_select',
      text: $this.children('option:eq(0)').text()
    }).insertAfter($this);

    const $option_list = $('<div>', {
      class: 'option_list'
    }).insertAfter($select);

    $this.find('option').each((index, option) => {
      if (index !== 0) {
        $('<div>', {
          class: 'option_item',
          html: $('<span>').text($(option).text())
        })
        .attr('data-value', $(option).val())
        .appendTo($option_list);
      }
    });

    $option_list.hide();

    $select.on('click', () => {
      $select.toggleClass('on');
      $option_list.slideToggle(100);
    });

    $option_list.on('click', '.option_item', function() {
      const chooseItem = $(this).data('value');
      $this.val(chooseItem).prop('selected', true).trigger('change');
      $select.text($(this).find('span').text());
      $option_list.slideUp(100);
      $select.removeClass('on');
    });
  });


  $('.first_step_show').on('change', function() {
    var selected = $(this).val();

    if (selected === 'Protection Officer') {
      $('#block_text_first').slideDown('slow');
      $('#block_text_second').slideUp('slow');
      $('.second_form_line').show();
    } 
    else if (selected === 'Escalation') {
      $('#block_text_second').slideDown('slow');
      $('#block_text_first').slideUp('slow');
      $('.second_form_line').show();
    } 
    else {
      $('#block_text_first').slideUp('slow');
      $('#block_text_second').slideUp('slow');
      $('.second_form_line').hide();
    }
  });


  $('.second_step_show').on('change', function() {
    var selected_second = $(this).val();

    if (selected_second === 'Yes') {
      $('.hidden_form').removeClass('show');
      $('.form_step_second').slideDown('slow');
    } 
    else if (selected_second === 'No') {
      $('.hidden_form').addClass('show');
      $('.form_step_second').slideDown('slow');
    } 
    else {
      $('.hidden_form').removeClass('show');
      $('.form_step_second').slideUp('slow');
    }
  });

});
</script>


