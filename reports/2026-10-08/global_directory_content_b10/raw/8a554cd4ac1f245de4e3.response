		font-size: 0.775rem;
	}

	#sc-content-data-hash a.sc-hash-slider {
		overflow: hidden;
		text-decoration: none;
		width: fit-content;
		max-width: 220px;
		height: 50px;
		align-items: center;
		display: flex;
		border-radius: 8px;
		border: 1px solid #E2E8EE;
		transition: all 0.5s ease-out;
