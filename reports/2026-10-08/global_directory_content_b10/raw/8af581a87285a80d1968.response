<script>
        $(document).ready(function(){
            /*about 슬라이드 1024px를 기준으로 슬라이드 기능 토글*/
            let aboutSlide;

            const initSwiper = function() {
                if ($(window).innerWidth() <= 1200 && !aboutSlide) {
                    aboutSlide = new Swiper('.slide-bx .swiper-container', {
                        slidesPerView: 1.2,
                        spaceBetween: 30,
                        speed: 1000,
                        breakpoints: {
                            576: {
                                slidesPerView: 2,
                                spaceBetween: 30,
                            },
                            1024: {
                                slidesPerView: 3,
                                spaceBetween: 30,
                            },
                        },
                        pagination: {
                            el: ".slide-bx .swiper-pagination",
                            clickable: true,    
                        },
                    });
                } else if ($(window).innerWidth() > 1200 && aboutSlide) {
                    aboutSlide.destroy(true, true);
                    aboutSlide = null;
                }
                console.log('test')
            };

            let resizeTimeout;
            $(window).on('resize', function() {
                if (resizeTimeout) clearTimeout(resizeTimeout);
                resizeTimeout = setTimeout(function() {
                    initSwiper();
                }, 200);
            });

            // 페이지 로드 시 초기화
            initSwiper();
        });
    </script>
