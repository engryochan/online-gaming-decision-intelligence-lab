es="16x16" href="https://cdn-assets-eu.frontify.com/s3/frontify-enterprise-files-eu/eyJwYXRoIjoiZmlyc3QtcmFuZC1ncm91cFwvZmlsZVwvUkNYZ293WlI5YUpzWlYxWmE2aGsucG5nIn0:first-rand-group:gbZcUz8wIVbVo3klyySyQJ8lI96Cs5rCbJkvuHq3UBY"/><title>Security Awareness - RMB</title><meta name="description" content="Security Awareness provides you, our client with the comprehensive information you need to protect yourself against fraudsters and simplifies the process to report fraud."/><meta property="og:title" content="Security Awareness - RMB"/><meta property="og:description" content="Security Awareness provides you, our client with the comprehensive information you need to protect yourself against fraudsters and simplifies the process to report fraud."/><meta property="og:image" content="https://cdn-assets-eu.frontify.com/s3/frontify-enterprise-files-eu/eyJwYXRoIjoiZmlyc3QtcmFuZC1ncm91cFwvZmlsZVwvazhvajdzcnU4TnhYRDZod0RrNlYuanBnIn0:first-rand-group:ZDzwXdgZzLJrm5SPOX89hbfF2sn3wPaQ4ru9Z7T3EMA.jpg?width=894&amp;height=918&amp;crop=fp&amp;format=webp&amp;fp=0.5,0.5"/><meta property="og:type" content="website"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Security Awareness - RMB"/><meta name="twitter:description" content="Security Awareness provides you, our client with the comprehensive information you need to protect yourself against fraudsters and simplifies the process to report fraud."/><meta name="twitter:image" content="https://cdn-assets-eu.frontify.com/s3/frontify-enterprise-files-eu/eyJwYXRoIjoiZmlyc3QtcmFuZC1ncm91cFwvZmlsZVwvazhvajdzcnU4TnhYRDZod0RrNlYuanBnIn0:first-rand-group:ZDzwXdgZzLJrm5SPOX89hbfF2sn3wPaQ4ru9Z7T3EMA.jpg?width=894&amp;height=918&amp;crop=fp&amp;format=webp&amp;fp=0.5,0.5"/><script src="https://cookie-cdn.cookiepro.com/scripttemplates/otSDKStub.js" nonce="q1SLkJz9ljA8UpKnqv1L6Q==" type="text/javascript" data-domain-script="a1ab5ed4-7fc6-4e64-a4dd-986ed8a76485"></script><script id="CookiePro - SA - OptanonWrapper" nonce="q1SLkJz9ljA8UpKnqv1L6Q==" type="text/javascript">function OptanonWrapper() { }</script><script id="PageTitle placeholder replacement" nonce="q1SLkJz9ljA8UpKnqv1L6Q==" type="text/javascript">const token = "{{pageTitle}}";
const originals = new WeakMap();

setInterval(() => {
  const replacement = document.title
  .replace(
    /\s*-\s*(RMB Nigeria Asset Management|RMB Corvest|RMB Ventures|FNB CIB|RMB)\s*$/,
    ""
  )
  .trim();

  document.querySelectorAll("input, textarea").forEach((el) => {
    if (!originals.has(el) && el.value?.includes(token)) {
      originals.set(el, el.value);
    }

    const template = originals.get(el);
    if (!template) return;

    const nextValue = template.replaceAll(token, replacement);
    if (el.value === nextValue) return;

    const setter = Object.getOwnPropertyDescriptor(
      Object.getPrototypeOf(el),
      "value",
    )?.set;

    setter ? setter.call(el, nextValue) : (el.value = nextValue);
    el.dispatchEvent(new Event("input", { bubbles: true }));
  });
}, 500);</script><link href="https://assets.rmb.co.za/css/override.css" rel="stylesheet" type="text/css"/><script src="/_next/static/chunks/polyfills-42372ed130431b0a.js" noModule="" nonce="q1SLkJz9ljA8UpKnqv1L6Q=="></script></head><body><script id="non-www to www Redirect" nonce="q1SLkJz9ljA8UpKnqv1L6Q==" type="text/javascript">if (location.hostname === 'rmb.co.za') {
  location.replace(
    'https://www.rmb.co.za' +
    location.pathname +
    location.search +
    location.hash
  );
}</script><header class="header h-16 md:h-20"><div class="container py-0!"><div class="header-inner items-center"><div class="md:hidden"><button class="text-2xl"><svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" class="h-6 text-white" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M3 4H21V6H3V4ZM3 11H15V13H3V11ZM3 18H21V20H3V18Z"></path></svg></button></div><div class="justify-self-start"><a href="/"><img src="https://cdn-assets-eu.frontify.com/s3/frontify-enterprise-files-eu/eyJvYXV0aCI6eyJjbGllbnRfaWQiOiJjbGllbnQtZGl6dzZvZ3Q2ODJrcnczMyJ9LCJwYXRoIjoiZmlyc3QtcmFuZC1ncm91cFwvZmlsZVwvOWR5WmlKMjVKaDhQbms4YTRTa28uc3ZnIn0:first-rand-group:1k5uiXpmDyDhtQTAa7LyX0-Rp4Q3s1CVA-BKJiW1Bbc" alt="RMB" class="h-10"/></a></div><nav aria-label="Main Navigation" class="hidden md:flex space-x-8"><ul><li class="relative z-9999 group"><span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" aria-controls="main-nav-panel-15" class="flex items-center main-drop-down">About</span></li><li class="relative z-9999 group"><span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" aria-controls="main-nav-panel-1037" class="flex items-center main-drop-down">Solutions</span></li><li class="relative z-9999 group"><span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" aria-controls="main-nav-panel-17" class="flex items-center main-drop-down">Insights</span></li><li class="relative z-9999 group"><a class="flex items-center" href="/careers">Careers</a></li><li class="relative z-9999 group"><a class="flex items-center" href="/contact">Contact</a></li><li class="relative z-9999 group"><span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" aria-controls="main-nav-panel-20" class="flex items-center main-drop-down">Logins</span></li><li class="relative z-9999 group"><span role="button" tabindex="0" aria-haspopup="true" aria-expanded="false" aria-controls="main-nav-panel-4895