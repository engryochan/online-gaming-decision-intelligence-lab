		.hero-content {
			width: 100%;
			padding: 36px 24px 44px;
			align-items: center;
			text-align: center;
			gap: 14px;
		}

		.hero-title {
			font-size: 40px;
		}

		.hero-subtitle {
			max-width: 100%;
		}

		.hero-cta {
			width: 100%;
			max-width: 280px;
		}
	}
</style>
