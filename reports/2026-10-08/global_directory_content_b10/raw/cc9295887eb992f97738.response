<!-- blog: feb 2026 - aspx -->
<!-- blog routing rules - lowercase + .aspx rules -->
<script>
  (function () {
    try {
      var loc = window.location;
      var origin = loc.origin;
      var path = loc.pathname;       // path tal como llega
      var lower = path.toLowerCase(); // path en minúsculas para decidir
      var search = loc.search || "";
      var hash = loc.hash || "";

      // Solo actuar dentro de /blog
      if (!lower.startsWith("/blog")) return;

      // Normalizar dobles slashes
      var normalizedLower = lower.replace(/\/{2,}/g, "/");

      var targetPathLower = null;

      // 1) Homepage: /blog -> /blog.aspx (todo en minúsculas)
      if (normalizedLower === "/blog") {
        targetPathLower = "/blog.aspx";
      }
      // 1b) /blog.aspx -> OK, no tocar
      else if (normalizedLower === "/blog.aspx") {
        targetPathLower = null; // stay
      }
      // 2) Categorías: /blog/categoria/... -> SIEMPRE con .aspx y en minúsculas
      else if (normalizedLower.startsWith("/blog/categoria/")) {
        if (!normalizedLower.endsWith(".aspx")) {
          targetPathLower = normalizedLower + ".aspx";
        } else {
          // ya termina en .aspx -> solo asegurar minúsculas
          if (path !== normalizedLower) {
            targetPathLower = normalizedLower;
          }
        }
      }
      // 3) Notas: cualquier /blog/... que no sea homepage ni categoría -> SIN .aspx y en minúsculas
      else if (normalizedLower.startsWith("/blog/")) {
        var noAspxLower = normalizedLower.replace(/\.aspx$/i, "");
        if (noAspxLower !== normalizedLower || path !== normalizedLower) {
          targetPathLower = noAspxLower;
        }
      }

      // Si hay destino y difiere de la URL actual, redirigir
      if (targetPathLower && (targetPathLower !== path)) {
        var newUrl = origin + targetPathLower + search + hash;

        // Evitar loops (comparación exacta es suficiente porque imponemos minúsculas)
        if (newUrl !== origin + path + search + hash) {
          window.location.replace(newUrl);
        }
      }
    } catch (e) {
      // console.warn("Blog routing script error", e);
    }
  })();
</script>

