<div class="sc-access-panel"><button type="button" data-access="font-plus"><img src="https://cdn.aglty.io/scotia-bank-mexico/images/ico/ico-text-increase.svg" alt="" class="imgaccesibilidad" /><br />Aumentar texto</button> <button type="button" data-access="font-minus"><img src="https://cdn.aglty.io/scotia-bank-mexico/images/ico/ico-text-decrease.svg" alt="" class="imgaccesibilidad" /><br />Disminuir texto</button> <button type="button" data-access="grayscale"><img src="https://cdn.aglty.io/scotia-bank-mexico/images/ico/ico-grey-scale.svg" alt="" class="imgaccesibilidad" /><br />Escala de grises</button> <button type="button" data-access="underline"><img src="https://cdn.aglty.io/scotia-bank-mexico/images/ico/ico-text-underline.svg" alt="" class="imgaccesibilidad" /><br />Subrayar enlaces</button> <button type="button" data-access="read"><img src="https://cdn.aglty.io/scotia-bank-mexico/images/ico/icio-reader-voice.svg" alt="" class="imgaccesibilidad" /><br />Leer p&aacute;gina</button></div>
</div>
<style>
	@media screen and (max-width: 768px) {
		.sc-access-panel {
			bottom: 56px !important;
			left: 0px !important;
			display: flex !important;
			flex-direction: column !important;
			width: 250% !important;
			align-items: center !important;
			gap: 0px !important;
		}
		.imgaccesibilidad {
			width: 22px;
		}	}
	.contraste-alto {
		background: black !important;
		color: yellow !important;
	}
	body.escala-grises::before {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background: #808080;
		mix-blend-mode: saturation;
		pointer-events: none;
		z-index: 1;
	}
	.subrayar a {
		text-decoration: underline !important;
	}
	/* ===== CONTENEDOR ===== */
	.sc-access-widget {
		position: fixed;
		bottom: 15px;
		left: 24px;
		/* cambia a right:24px si lo quieres a la derecha */
		z-index: 99999;
		font-family: Arial, sans-serif;
	}
	/* ===== BOTÓN ===== */
	.sc-access-toggle {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		border: none;
		background: #e3121d;
		color: #fff;
		font-size: 24px;
		cursor: pointer;
		box-shadow: 0 6px 16px rgba(0, 0, 0, .25);
		padding-top: 5px;
	}
	/* ===== PANEL ===== */
	.sc-access-panel {
		position: absolute;
		bottom: 0;
		left: 64px;
		/* aparece hacia la derecha del botón */
		background: #000000b5;
		border-radius: 8px;
		padding: 14px;
		box-shadow: 0 8px 24px rgba(0, 0, 0, .25);
		transform: translateX(-20px);
		opacity: 0;
		pointer-events: none;
		transition: all .25s ease;
		display: flex;
		flex-direction: row;
		width: 1350%;
		align-items: center;
		gap: 16px;
	}
	/* Panel visible */
	.sc-access-widget.open .sc-access-panel {
		transform: translateX(0);
		opacity: 1;
		pointer-events: auto;
	}
	/* Título */
	.sc-access-title {
		font-weight: bold;
		margin: 0 0 10px;
		font-size: 14px;
	}
	/* Botones */
	.sc-access-panel button {
		width: 100%;
		background-color: #FFF;
		color: #333;
		border: 1px solid #333;
		cursor: pointer;
		border-radius: 8px;
		font-size: 14px;
		font-weight: 600;
		padding: 16px 30px;
		box-sizing: border-box;
		text-decoration: none;
		display: inline-block;
		-webkit-transition: .33s ease;
		transition: .33s ease;
		margin-bottom: 7px;
	}
	.sc-access-panel button:hover {
		border-color: #ec111a;
		color: #ec111a;
	}
	/* ===== EFECTOS ACCESIBILIDAD ===== */
	.sc-access-grayscale {
		filter: grayscale(100%);
	}
	.sc-access-contrast {
		filter: contrast(1.4);
	}
</style>
<script>
	(function(){
  const widget = document.querySelector('.sc-access-widget');
  const toggle = widget.querySelector('.sc-access-toggle');
  const panel = widget.querySelector('.sc-access-panel');
  /* ===== TOGGLE PANEL ===== */
  toggle.addEventListener('click', () => {
    widget.classList.toggle('open');  });
  /* ===== ACCESIBILIDAD ===== */
let fontScale = 1;
const MIN_SCALE = 0.85;
const MAX_SCALE = 1.4;
function inicializarTamañosBase() {
const elementos = document.querySelectorAll(
"p, h1, h2, h3, h4, h5, h6, span, li, a");
elementos.forEach(el => {
if (!el.dataset.baseSize) {
const size = window.getComputedStyle(el).fontSize;
el.dataset.baseSize = parseFloat(size); }});}
function aplicarEscalaTexto() {
const elementos = document.querySelectorAll(
"p, h1, h2, h3, h4, h5, h6, span, li, a" );
elementos.forEach(el => {
const baseSize = parseFloat(el.dataset.baseSize);
if (!baseSize) return;
el.style.fontSize = (baseSize * fontScale) + "px"; }); }
function aumentarTexto() {
if (fontScale >= MAX_SCALE) return;
fontScale += 0.1;
aplicarEscalaTexto(); }
function disminuirTexto() {
if (fontScale <= MIN_SCALE) return; fontScale -=0.1; aplicarEscalaTexto(); }
function alternarEscalaGrises() {
document.body.classList.toggle("escala-grises"); }
function alternarSubrayado() {
document.body.classList.toggle("subrayar"); }
document.addEventListener("DOMContentLoaded", () => {
  inicializarTamañosBase(); });
/* ===== LECTOR DE PAGINA INICIO ===== */
let lectorActivo = false;
let speech;
function leerPagina(){
if(lectorActivo){
speechSynthesis.cancel();
lectorActivo = false;
return; }
const contenido =
document.querySelector("main") ||
document.querySelector("#content") ||
document.querySelector(".main-content") ||
document.body;
const texto = contenido.innerText;
speech = new SpeechSynthesisUtterance(texto);
speech.lang = "es-MX";
speech.rate = 1;
speech.pitch = 1;
speechSynthesis.speak(speech);
lectorActivo = true; }
/* ===== LECTOR DE PAGINA FIN ===== */
/* =========================
BIND DE BOTONES DEL PANEL
========================= */
document.addEventListener("DOMContentLoaded", () => {
const panel = document.querySelector(".sc-access-panel");
if (!panel) return;
panel.addEventListener("click", (e) => {
const btn = e.target.closest("button");
if (!btn) return;
const action = btn.dataset.access;
switch (action) {
case "font-plus":
aumentarTexto();
break;
case "font-minus":
disminuirTexto();
break;
case "contrast":
alternarContraste();
break;
case "grayscale":
alternarEscalaGrises();
break;
case "underline":
alternarSubrayado();
break;
case "read":
leerPagina();
break;
} }); }); })();
</script>








<!-- ===== COOKIE BANNER ===== -->
<style>
.cookie-banner {
position: fixed;
bottom: 0;
left: 0;
width: 100%;
display: grid;
grid-template-columns: 0;
grid-template-areas:
"spacer content"
"spacer action";
gap: 16px;
padding: 16px 16px 20px;
background: #f4f4f4;
box-shadow: 0 -2px 6px rgba(0,0,0,.12);
z-index: 9000;
font-size: 15px;
}
.cookie-spacer {
grid-area: spacer;
}
.cookie-content {
max-width: 90%;
}
.cookie-content p {
margin: 0;
line-height: 1.4;
}
.cookie-action {
grid-area: action;
padding-right: 25%;
padding-left: 15%;
}
.cookie-action button {
width: 100%;
padding: 14px;
font-size: 16px;
border: none;
border-radius: 6px;
background: #ec111a;
color: #fff;
cursor: pointer;
transition: background-color 0.2s ease;
}
.cookie-action button:hover {
background-color: #b70d14; 
}
/* DESKTOP */
@media (min-width: 769px) {
.cookie-banner {
grid-template-columns: 5% 1fr 15%;
grid-template-areas: "spacer content action";
align-items: center;
}
.cookie-action button {
width: auto;
padding: 10px 20px;
} }
</style>
<div id="cookie-banner" class="cookie-banner" role="region" aria-label="Aviso de privacidad">
<div class="cookie-spacer" aria-hidden="true"></div>
<div class="cookie-content">

<p>Le informamos que utilizamos cookies y otras tecnologías para monitorear su comportamiento como usuario, brindarle un mejor servicio y experiencia de navegación en nuestro portal. <a class="link" href="https://www.scotiabank.com.mx/transparencia/aviso-privacidad.aspx">Aviso de Privacidad.</a></p> </div>
<div class="cookie-action"><button id="cookie-close" type="button"> Aceptar </button></div>
</div>
<script>
	(function () {
  var STORAGE_KEY = 'cookieBannerAccepted_v1';
  var SIX_MONTHS = 1000 * 60 * 60 * 24 * 182;
  function hasConsent() {
    try {
      var v = JSON.parse(localStorage.getItem(STORAGE_KEY));
      return v && Date.now() < v.expires;
    } catch {
      return false; 
       }  }
  function saveConsent() {
    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify({ expires: Date.now() + SIX_MONTHS })
    );  }
  var banner = document.getElementById('cookie-banner');
  var btn = document.getElementById('cookie-close');
  if (!banner || !btn) return;
  if (hasConsent()) {
    banner.remove();
    return;  }
  btn.addEventListener('click', function () {
    saveConsent();
    banner.remove();
  }); })();
</script></body>
</html>
