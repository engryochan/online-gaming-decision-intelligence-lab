        function handleKeyPressSearch(e) {
            var key;
            if (window.event)
                key = window.event.keyCode;
            else
                key = e.which;

            if (key == 13 || key == 10) {
                var doPostBackArgs = /^javascript:__doPostBack\('([^']*)','([^']*)'\)$/i.exec($('#lnkMobilePopUpSearch').attr('href'));
                if (doPostBackArgs && typeof __doPostBack === 'function') { __doPostBack(doPostBackArgs[1], doPostBackArgs[2]); }
                return false;
            }
            else
                return true;
        }

    </script>

