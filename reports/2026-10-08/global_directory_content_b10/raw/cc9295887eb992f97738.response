		.hero-inner {
			min-height: 320px;
		}

		.hero-title {
			font-size: 46px;
		}

		.hero-content {
			padding: 48px 32px 48px 28px;
			gap: 14px;
		}

		.hero-subtitle {
			font-size: 16px;
			max-width: 100%;
		}

		.hero-cta {
			font-size: 16px;
			padding: 11px 22px;
		}
	}

	/* MOBILE */
	@media (max-width: 767px) {
		.hero {
			min-height: 0;
		}

		/* Ocultamos la imagen desktop */
		.hero-image-desk {
			display: none;
