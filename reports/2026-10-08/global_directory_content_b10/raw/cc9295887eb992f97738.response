<div class="buttons"><button class="salir button secondary redColor">Aceptar</button> <button class="cancelar button primary">Cancelar</button></div>
</div>
<script>
	window.addEventListener('DOMContentLoaded', () => {
const links = document.querySelectorAll('.link-intersticial');

links.forEach(link => {
link.addEventListener('click', (event) => {
event.preventDefault();
const url = event.target.href;
const popupId = link.dataset.popup;
const popup = document.getElementById(popupId);
const urlElement = popup.querySelector('#url-intersticial');
urlElement.textContent = url;
popup.style.display = 'block';
});
});

const popups = document.querySelectorAll('.popup-intersticial');

popups.forEach(popup => {
const salirButton = popup.querySelector('.salir');
const cancelarButton = popup.querySelector('.cancelar');

salirButton.addEventListener('click', () => {
const url = popup.querySelector('#url-intersticial').textContent;
window.open(url);
event.preventDefault();
popup.style.display = 'none';
});

cancelarButton.addEventListener('click', () => {
event.preventDefault();
popup.style.display = 'none';
});
});
});
</script>
