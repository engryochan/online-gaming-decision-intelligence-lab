	.serif {
		font-family: scotia_serifregular;
		font-weight: 500;
	}

	.hero {
		width: 100%;
		position: relative;
		overflow: hidden;
		min-height: 500px;
	}

	.hero-inner {
		width: 100%;
		max-width: 1280px;
		margin: 0 auto;
		min-height: 500px;
		display: flex;
		align-items: center;
	}

	.hero-content {
		width: 46%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 64px 48px 64px 15px;
		gap: 16px;
		position: relative;
		z-index: 2;
	}

	.hero-title {
		font-family: Scotia-Headline;
		font-size: 46px;
		line-height: 1.2;
		margin-top: 0px !important;
	}

	.hero-subtitle {
		font-size: 16px;
		line-height: 1.65;
		max-width: 80%;
	}

	.hero-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: fit-content;
		margin-bottom: 8px;
		border: 1px solid transparent;
		font-weight: 800;
		cursor: pointer;
		border-radius: 50px;
		font-size: 16px;
		font-weight: 600;
		padding: 18px 30px;
		box-sizing: border-box;
		text-decoration: none;
		-webkit-transition: .33s ease;
		transition: .33s ease;
	}

	/* Imagen desktop: absoluta, pegada al borde derecho */
	.hero-image-desk {
		position: absolute;
		top: 0;
		bottom: 0;
		right: 0;
		left: 50%;
		overflow: hidden;
		z-index: 1;
	}

	.hero-image-desk img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: right bottom;
		display: block;
	}

	/* Imagen mobile: oculta en desktop */
	.hero-image-mob {
		display: none;
	}

	/* Breakpoints desktop */
	@media (min-width: 1600px) {

		.hero,
		.hero-inner {
			min-height: 460px;
		}

		.hero-title {
			font-size: 46px;
		}

		.hero-content {
			padding: 80px 64px 80px 48px;
		}

