<!-- evitar cache PDF - nov 2024 -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Selecciona todos los enlaces que terminan en .pdf
    const pdfLinks = document.querySelectorAll('a[href$=".pdf"]');
    // Genera una versión única basada en la marca de tiempo actual
    const version = new Date().getTime();
    // Itera sobre cada enlace y agrega el parámetro de versión
    pdfLinks.forEach(link => {
        // Verifica si el enlace ya tiene parámetros de consulta
        if (link.href.includes('?')) {
            link.href += `&v=${version}`;
        } else {
            link.href += `?v=${version}`;
        }     }); }); 
</script>
