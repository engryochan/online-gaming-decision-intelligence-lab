                        </div>
                        <div class="js-accordion-item border-b first:border-t border-grey-30" id="7-Jak-vyberu-penize-zpatky-na-svuj-bezny-ucet" data-is-opened="False" data-bg-change data-testid="accordion-widget-item-id-db11dce7-0e43-4484-8712-8647e2863641">
                <h3>
        <a class="js-accordion-button flex justify-between items-center px-8 py-6 media-hover:bg-white transition-colors duration-300"
