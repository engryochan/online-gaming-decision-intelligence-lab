<script nonce="y3TsukJIDRoehb66GRsLgQ==">
    document.addEventListener('DOMContentLoaded', function () {
        const dropdowns = document.querySelectorAll('.dropdown');
        const mediaQuery = window.matchMedia("(min-width: 1200px)");

        dropdowns.forEach(function (dropdown) {
            dropdown.addEventListener('mouseenter', function () {
                if (!mediaQuery.matches) return;

                
                document.querySelectorAll('.dropdown.show').forEach(function (openDropdown) {
                    if (openDropdown !== dropdown) {
                        openDropdown.classList.remove('show');
                        const openMenu = openDropdown.querySelector('.dropdown-menu');
                        if (openMenu) {
                            openMenu.classList.remove('show');
                        } 
                    }
                });

                dropdown.classList.add('show');
                const menu = dropdown.querySelector('.dropdown-menu');
                if (menu) menu.classList.add('show');
            });

            dropdown.addEventListener('mouseleave', function () {

                if (!mediaQuery.matches) return; 

                dropdown.classList.remove('show');
                const menu = dropdown.querySelector('.dropdown-menu');
                if (menu) {
                    menu.classList.remove('show');
                }
            });

        });

    });
</script>

<script nonce="y3TsukJIDRoehb66GRsLgQ==">
    document.addEventListener("DOMContentLoaded", function () {
        const submenus = document.querySelectorAll('.dropdown-submenu');

        submenus.forEach(function(submenu) {
            const toggle = submenu.querySelector('a.dropdown-toggle');
            
            if (toggle) toggle.setAttribute('aria-expanded', 'false');
            function setSubmenuOpen(menu, open) {
                if (open) {
                    menu.classList.add('show');
                } else {
                    menu.classList.remove('show');
                }
                if (toggle) toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            }

            submenu.addEventListener('mouseenter', function () {
                if (window.innerWidth >= 1200) {
                    const menu = submenu.querySelector('.dropdown-menu');
                    if (menu) setSubmenuOpen(menu, true);
                }
            });
            submenu.addEventListener('mouseleave', function () {
                if (window.innerWidth >= 1200) {
                    const menu = submenu.querySelector('.dropdown-menu');
                    if (menu) setSubmenuOpen(menu, false);
                }
            });

            if (!toggle) return;

            toggle.addEventListener('click', function(e) {
                if (window.innerWidth < 1200) {
                    e.preventDefault();
                    e.stopPropagation();

                    const menu = submenu.querySelector('.dropdown-menu');
                    if (menu) setSubmenuOpen(menu, !menu.classList.contains('show'));
                }
            });

            toggle.addEventListener('keydown', function(e) {
                if (e.key !== 'Enter' && e.key !== ' ' && e.key !== 'Spacebar') return;
                e.preventDefault();
                const menu = submenu.querySelector('.dropdown-menu');
                if (menu) setSubmenuOpen(menu, !menu.classList.contains('show'));
            });

            
            submenu.addEventListener('keydown', function(e) {
                if (e.key !== 'Escape' && e.key !== 'Esc') return;
                const menu = submenu.querySelector('.dropdown-menu');
                if (!menu || !menu.classList.contains('show')) return;
                e.preventDefault();
                e.stopPropagation();
                setSubmenuOpen(menu, false);
                toggle.focus();
            });
        });

        
        const mainDropdowns = document.querySelectorAll('.dropdown');
        mainDropdowns.forEach(function(dropdown){
            dropdown.addEventListener('hide.bs.dropdown', function () {
                const openSubmenus = dropdown.querySelectorAll('.dropdown-menu.show');
                openSubmenus.forEach(function(menu){
                    menu.classList.remove('show');
                });
                
                dropdown.querySelectorAll('.dropdown-submenu > a.dropdown-toggle').forEach(function(subToggle){
                    subToggle.setAttribute('aria-expanded', 'false');
                });
            });
        });
    });
</script>


