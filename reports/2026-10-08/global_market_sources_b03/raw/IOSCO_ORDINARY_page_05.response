            if (document.activeElement && e.target.contains(document.activeElement)) {
                document.activeElement.blur();
            }
        });
    </script>

    
    <script nonce="PK4H6ZvqLJ/p1bT47sC2QA==">
        document.addEventListener('click', function(e){
            let el = e.target.closest('[data-onclick-fn]');
            if (el) {
                let fn = window[el.dataset.onclickFn];
                if (typeof fn === 'function') {
                    
                    if (!el.hasAttribute('data-onclick-keep-default')) e.preventDefault();
                    let args = [];
                    if (el.dataset.onclickArgs) {
                        try { args = JSON.parse(el.dataset.onclickArgs); } catch(err) {}
                    }
                    fn.apply(el, args);
                }
            }

            let multiEl = e.target.closest('[data-onclick-multi]');
            if (!multiEl) return;
            e.preventDefault();
            let calls = [];
            try { calls = JSON.parse(multiEl.dataset.onclickMulti); } catch(err) {}
            calls.forEach(function(call){
                let multiFn = window[call[0]];
                if (typeof multiFn === 'function') multiFn.apply(multiEl, call[1] || []);
            });
        });
        document.addEventListener('change', function(e){
            let el = e.target.closest('[data-onchange-fn]');
            if (!el) return;
            let fn = window[el.dataset.onchangeFn];
            if (typeof fn !== 'function') return;
            let args = [];
            if (el.dataset.onchangeArgs) {
                try { args = JSON.parse(el.dataset.onchangeArgs); } catch(err) {}
            }
            fn.apply(el, args);
        });
        document.addEventListener('submit', function(e){
            let form = e.target.closest('[data-onsubmit-validate]');
            if (!form) return;
            let fn = window[form.dataset.onsubmitValidate];
            if (typeof fn !== 'function') return;
            let fieldNames = (form.dataset.onsubmitFields || '').split(',').filter(Boolean);
            let fieldEls = fieldNames.map(function(name){ return form.elements[name]; });
            if (!fn.apply(form, fieldEls)) {
                alert(form.dataset.onsubmitMessage || 'Please complete all required fields.');
                e.preventDefault();
            }
        });
        document.addEventListener('submit', function(e){
            let form = e.target.closest('[data-onsubmit-call]');
            if (!form) return;
            let fn = window[form.dataset.onsubmitCall];
            if (typeof fn !== 'function') return;
            let args = [];
            if (form.dataset.onsubmitArgs) {
                try { args = JSON.parse(form.dataset.onsubmitArgs); } catch(err) {}
            }
            if (!fn.apply(form, args)) e.preventDefault();
        });
        document.addEventListener('blur', function(e){
            if (!e.target || typeof e.target.closest !== 'function') return;
            let el = e.target.closest('[data-onblur-fn]');
            if (!el) return;
            let fn = window[el.dataset.onblurFn];
            if (typeof fn !== 'function') return;
            let args = [];
            if (el.dataset.onblurArgs) {
                try { args = JSON.parse(el.dataset.onblurArgs); } catch(err) {}
            }
            fn.apply(el, args);
        }, true);
        
        
        document.addEventListener('invalid', function(e){
            let msg = e.target.getAttribute && e.target.getAttribute('data-oninvalid-message');
            if (msg) e.target.setCustomValidity(msg);
        }, true);
        ['input','change'].forEach(function(evt){
            document.addEventListener(evt, function(e){
                if (e.target.getAttribute && e.target.getAttribute('data-oninvalid-message')) e.target.setCustomValidity('');
            }, true);
        });

        window.navigateTo = function(url, target){
            if (target === 'top') window.top.location.href = url;
            else location.href = url;
        };
        window.openWindow = function(url, target, features){
            window.open(url, target, features);
        };
        window.setFieldAndUpdate = function(selector, value, updateFnName){
            $(selector).val(value);
            let fn = window[updateFnName];
            if (typeof fn === 'function') fn();
        };
        window.submitMyForm = function(){
            this.form.submit();
        };
        window.requestSubmitMyForm = function(){
            this.form.requestSubmit();
        };
        window.navigateToValue = function(paramName){
            navigateTo('?' + paramName + '=' + encodeURIComponent(this.value));
        };
        window.callWithThisValue = function(fnName){
            let fn = window[fnName];
            if (typeof fn === 'function') fn(this.value);
        };
        window.jQueryToggle = function(selector){
            $(selector).toggle();
        };
        window.changeRestrictionFor = function(permissionFieldName){
            let fn = window.changeRestriction;
            if (typeof fn === 'function') fn(this, this.form.elements[permissionFieldName]);
        };
        window.setValueAndFieldById = function(newValue, fieldId, fieldValue){
            this.value = newValue;
            document.getElementById(fieldId).value = fieldValue;
        };
        window.historyBack = function(){
            history.back();
        };
        window.setNeedToConfirm = function(value){
            needToConfirm = value;
        };
        window.saveDraft = function(status){
            needToConfirm = false;
            selectAll(this.form.selected_categories);
            selectAll(this.form.selected_markets);
            selectAll(this.form.selected_standards);
            selectAll(this.form.selected_old_references);
            draftSaved(status);
        };
        window.wizardPageNav = function(showPage, hidePage){
            show_hide_toggle(showPage, hidePage);
            timeRemaining.location.reload(true);
            window.scrollTo(0,0);
        };
        window.deselectDecisionLists = function(){
            deselectAll(this.form.all_categories);
            deselectAll(this.form.selected_categories);
            deselectAll(this.form.all_markets);
            deselectAll(this.form.selected_markets);
            deselectAll(this.form.all_standards);
            deselectAll(this.form.selected_standards);
        };
        window.changeDaysInMonthFor = function(yearField, monthField, dayField){
            let fn = window.changeDaysInMonth;
            if (typeof fn === 'function') fn(this.form.elements[yearField], this.form.elements[monthField], this.form.elements[dayField]);
        };
        window.changePageFor = function(currentPage){
            let fn = window.changePage;
            if (typeof fn === 'function') fn(currentPage, this);
            timeRemaining.location.reload(true);
        };
        window.copySelectedFor = function(allFieldName, selectedFieldName, otherDivId){
            let fn = window.copySelected;
            if (typeof fn === 'function') fn(this.form.elements[allFieldName], this.form.elements[selectedFieldName]);
            if (otherDivId) {
                let fn2 = window.otherSelected;
                if (typeof fn2 === 'function') fn2(this.form.elements[selectedFieldName], otherDivId);
            }
        };
        window.removeOptionFor = function(selectedFieldName, otherDivId, otherFieldName){
            let fn = window.removeOption;
            if (typeof fn !== 'function') return;
            let otherField = otherFieldName ? this.form.elements[otherFieldName] : '';
            fn(this.form.elements[selectedFieldName], otherDivId, otherField);
        };
        window.updateParagraphListFor = function(introFieldName, standardFieldName){
            let fn = window.updateParagraphList;
            if (typeof fn === 'function') fn(this, this.form.elements[introFieldName], this.form.elements[standardFieldName]);
        };
        window.copySelectedParagraphsFor = function(allFieldName, introFieldName, standardFieldName, selectedFieldName, otherDivId){
            let fn = window.copySelectedParagraphs;
            if (typeof fn === 'function') fn(this.form.elements[allFieldName], this.form.elements[introFieldName], this.form.elements[standardFieldName], this.form.elements[selectedFieldName]);
            if (otherDivId) {
                let fn2 = window.otherSelected;
                if (typeof fn2 === 'function') fn2(this.form.elements[selectedFieldName], otherDivId);
            }
        };
        window.showOtherFieldFor = function(divId, otherFieldName){
            let fn = window.show;
            if (typeof fn === 'function') fn(this.id, divId);
            let fn2 = window.delete_text;
            if (typeof fn2 === 'function') fn2(this.form.elements[otherFieldName]);
        };
    </script>

    
    
</head>
