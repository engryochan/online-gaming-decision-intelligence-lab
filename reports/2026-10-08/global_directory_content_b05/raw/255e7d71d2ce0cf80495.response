          <h2>Digitized Historical Information </h2>
          <h3>Period to consult:</h3>
          <div id="boxQuarter" class="row">
            
            <div id="boxInformation" class="sel-box">
              <div id="cboTipoInformacion" class="combo square cbo-main">
                <span class="value">
                  <span class="text">Information Type</span>
                  <span class="button"></span>
                </span>
                <ul class="options">
                  <li>
                    <label for="rbTipoInformacion_">Information Type</label>
                    <input id="rbTipoInformacion_" name="tipoInformacion" type="radio" value="" />
                  </li>
                </ul>
              </div><!--End combo-->
            </div><!-- end sel-box -->
            
            <div id="boxStartDate" class="calendar-box">
              <input id="txtStartDate" type="text" class="text-field" placeholder='Initial Date' value="" />
              <input id="valueStartDate" name="fechaInicial" type="hidden" value="" />
              <label for="txtStartDate">open calendar</label>
            </div><!-- end calendar-box -->
            <em>a</em>
            <div id="boxEndDate" class="calendar-box alignright">
              <input id="txtEndDate" type="text" class="text-field" placeholder='End Date' value="" />
              <input id="valueEndDate" name="fechaFinal" type="hidden" value="" />
              <label for="txtEndDate">open calendar</label>
            </div><!-- end calendar-box -->

            <div id="ttMsgError" class="tt_graph tooltip tt-error">
              <span class="msg-error">The initial period can not be earlier than end</span>
            </div>

            <div id="ttStart" class="tt_graph tooltip">
              <span class="arrow"></span>
              <span id="lbStartMonth" class="hide">Initial month</span>
              <div id="boxStartQuarter">
                <div id="cboStartQuarter" class="combo square">
                  <span class="value">
                    <span class="text">First trimester</span>
