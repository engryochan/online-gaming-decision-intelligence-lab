        <input id="valueUrlTipoInformacion" name="urlTipoInformacion" type="hidden" value="/en/Grupo_BMV/Empresas_listadas/_rid/243/_mto/3/_mod/onChangeTipoInformacion" />
        <input id="valueUrlTipoDocumento" name="urlTipoDocumento" type="hidden" value="/en/Grupo_BMV/Empresas_listadas/_rid/243/_mto/3/_mod/onChangeTipoDocumento" />
