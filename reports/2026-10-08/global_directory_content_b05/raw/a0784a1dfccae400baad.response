					<div id="ste_container_cicss_6f0d577e564e4c1d8d3dd42bab6cf47c" class="ContentItemContainer"><div id="ctl01_TemplateBody_WebPartManager1_gwpcicss_6f0d577e564e4c1d8d3dd42bab6cf47c_cicss_6f0d577e564e4c1d8d3dd42bab6cf47c_Panel_css">
	<style>
    /* radGrid reset start */
    thead {
    display: none;
    }
    a.noeffect:hover {
    text-decoration: none !important;
    }
    .RadGrid_MetroTouch {
    border: none;
    color: #182232;
    background-color: transparent;
    }
    .RadGrid_MetroTouch .rgMasterTable .rgSelectedCell, .RadGrid_MetroTouch .rgSelectedRow, .RadGrid_MetroTouch td.rgEditRow .rgSelectedRow, .RadGrid_MetroTouch .rgSelectedRow td.rgSorted {
    color: #182232;
    background: transparent;
    border-color: transparent;
    }
    .RadGrid.RadGrid_MetroTouch .rgMasterTable .rgSelectedCell a, .RadGrid.RadGrid_MetroTouch .rgSelectedRow a, .RadGrid.RadGrid_MetroTouch td.rgEditRow .rgSelectedRow a, .RadGrid.RadGrid_MetroTouch .rgSelectedRow td.rgSorted a, .RadGrid.RadGrid_MetroTouch th.rgSorted a, .RadGrid.RadGrid_Metro .rgMasterTable .rgSelectedCell a, .RadGrid.RadGrid_Metro .rgSelectedRow a, .RadGrid.RadGrid_Metro td.rgEditRow .rgSelectedRow a, .RadGrid.RadGrid_Metro .rgSelectedRow td.rgSorted a, .RadGrid.RadGrid_Metro th.rgSorted a {
    color: #182232 !important;
    }
    .RadGrid_MetroTouch .rgRow a, .RadGrid_MetroTouch .rgAltRow a, .RadGrid_MetroTouch tr.rgEditRow a, .RadGrid_MetroTouch .rgFooter a, .RadGrid_MetroTouch .rgEditForm a {
    color: #182232;
    }
    .RadGrid.RadGrid_MetroTouch .rgActiveRow td, .RadGrid.RadGrid_MetroTouch .rgActiveRow td.rgSorted, .RadGrid.RadGrid_MetroTouch .rgSelectedRow td, .RadGrid.RadGrid_MetroTouch .rgSelectedRow td.rgSorted, .RadGrid.RadGrid_MetroTouch .rgMasterTable .rgActiveCell, .RadGrid.RadGrid_Metro .rgActiveRow td, .RadGrid.RadGrid_Metro .rgActiveRow td.rgSorted, .RadGrid.RadGrid_Metro .rgSelectedRow td, .RadGrid.RadGrid_Metro .rgSelectedRow td.rgSorted, .RadGrid.RadGrid_Metro .rgMasterTable .rgActiveCell {
    border: none;
    }
    .RadGrid.RadGrid_MetroTouch .rgMasterTable .rgSelectedCell, .RadGrid.RadGrid_MetroTouch .rgSelectedRow, .RadGrid.RadGrid_MetroTouch td.rgEditRow .rgSelectedRow, .RadGrid.RadGrid_MetroTouch .rgSelectedRow td.rgSorted, .RadGrid.RadGrid_MetroTouch th.rgSorted, .RadGrid.RadGrid_Metro .rgMasterTable .rgSelectedCell, .RadGrid.RadGrid_Metro .rgSelectedRow, .RadGrid.RadGrid_Metro td.rgEditRow .rgSelectedRow, .RadGrid.RadGrid_Metro .rgSelectedRow td.rgSorted, .RadGrid.RadGrid_Metro th.rgSorted {
    background: transparent;
    border-color: transparent;
    }
    .RadGrid_MetroTouch .rgAltRow {
    background: transparent;
    }
    .RadGrid_MetroTouch .rgRow>a>td, .RadGrid_MetroTouch .rgAltRow>a>td {
    border: none;
    padding: 0 !important;
    }
    .RadGrid.RadGrid_MetroTouch .rgMasterTable, .RadGrid.RadGrid_Metro .rgMasterTable {
    background-color: transparent;
    }
    /* radGrid reset end */
    /* FilterPanel START */
    .FilterPanel {
    padding: 3rem;
    border: none !important;
    margin: 0;
    background: var(--grey-color);
    border-radius: var(--border-radius);
    }
    .FilterPanel div[id$="_ResultsGrid_Sheet0"] {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    justify-content: flex-end;
    }
    .FilterPanel div[id$="_ResultsGrid_Sheet0"]:before {
    content: "";
    display: block;
    width: 100%;
    color: var(--primary-color);
    font-size: 2.4rem;
    font-weight: 600;
    }
    .FilterPanel div[id$="_ResultsGrid_Sheet0"]>.PanelField {
    padding: 0;
    width: calc(33.333333333% - 2rem);
    display: flex;
    flex-direction: column;
    gap: .5rem;
    }
    .FilterPanel div[id$="_ResultsGrid_Sheet0"]>.PanelField>label {
    width: 100%;
    max-width: 100%;
    }
    .FilterPanel div[id$="_ResultsGrid_Sheet0"]>.PanelField>.PanelFieldValue {
    width: 100%;
    max-width: 100%;
    padding: 0;
    }
    .FilterPanel div[id$="_ResultsGrid_Sheet0"]>.PanelField>.PanelFieldValue>input[type="text"],
    .FilterPanel div[id$="_ResultsGrid_Sheet0"]>.PanelField>.PanelFieldValue>select {
    width: 100%;
    max-width: 100%;
    }
    div[id*="Directory"i] .GridTitlePanel {
    margin-top: 0;
    }
    div[id*="Directory"i].RadGrid {
    overflow: visible !important;
    }
    div[id*="Directory"i].RadGrid>table>tbody {
    display: flex;
    flex-wrap: wrap;
    gap: 3rem;
    margin: 3rem 0;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr {
    display: flex;
    width: calc(25% - 2.25rem);
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr.rgSelectedRow {
    background: #fff0 !important;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr>td {
    padding: 1.5rem !important;
    border: var(--input-border) !important;
    display: flex;
    flex-direction: column;
    border-radius: var(--border-radius);
    width: 100%;
    align-items: center;
    text-align: center;
    transition: all .2s ease-in-out;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr>td:hover {
    box-shadow: var(--box-shadow);
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr:not(:has(>td>div)) {
    display: none !important;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr.rgSelectedRow>td {
    border: var(--input-border) !important;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr>td a,
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr.rgSelectedRow>td a{
    text-decoration: none !important;
    color: var(--primary-color) !important;
    font-size: 2rem;
    font-weight: 600;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr>td .Details {
    margin-bottom: 1.5rem;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr>td .Details>div {
    padding: .5rem;
    border-radius: var(--border-radius);
    font-size: 1.4rem;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr>td .Details>.Category  {
    background: var(--tertiary-color);
    color: var(--primary-color);
    margin-bottom: .5rem;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr>td .Details>.Firm {
    background: var(--secondary-color);
    color: var(--primary-color);
    }
    @media (max-width: 992.98px) {
    .FilterPanel div[id$="_ResultsGrid_Sheet0"]>.PanelField {
    width: 100%;
    }
    body#MainBody div[id*="Directory"i].RadGrid>table>tbody>tr {
    width: calc(50% - 1.5rem);
    }
    }
    /* Company Member List — force 3 cards per row */
    body#MainBody div[id*="Directory"] .RadGrid table tbody {
    display: flex !important;
    flex-wrap: wrap !important;
    gap: 1.5rem !important;
    }
    body#MainBody div[id*="Directory"] .RadGrid table tbody > tr {
    display: block !important;
    width: calc((100% - 3rem) / 3) !important;
    flex: 0 0 calc((100% - 3rem) / 3) !important;
    box-sizing: border-box !important;
    margin: 0 !important;
    }
    body#MainBody div[id*="Directory"] .RadGrid table tbody > tr > td {
    width: 100% !important;
    max-width: 100% !important;
    box-sizing: border-box !important;
    }
    /* Tablet */
    @media (max-width: 900px) {
    body#MainBody div[id*="Directory"] .RadGrid table tbody > tr {
    width: calc((100% - 2rem) / 2) !important;
    flex: 0 0 calc((100% - 2rem) / 2) !important;
    }
    }
    /* Mobile */
    @media (max-width: 500px) {
    body#MainBody div[id*="Directory"] .RadGrid table tbody > tr {
    width: 100% !important;
    flex: 0 0 100% !important;
    }
    }
    /* === DIRECT FIX FOR DIRECTORY SEARCH LAYOUT === */
    /* 1. Make the sheet a single row */
    div[id*="ResultsGrid_Sheet0"] {
    display: flex !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    gap: 0.75rem !important;
    }
    /* 2. Fields inline */
    div[id*="ResultsGrid_Sheet0"] > .PanelField {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    flex: 0 1 auto !important;
    width: auto !important;
    gap: 0.4rem;
    }
    /* 3. Inputs smaller so button fits */
    div[id*="ResultsGrid_Sheet0"] input[type="text"],
    div[id*="ResultsGrid_Sheet0"] select {
    width: auto !important;
    min-width: 110px;
    max-width: 150px;
    }
    /* 4. CRITICAL — treat button as flex item */
    div[id*="ResultsGrid_Sheet0"] > input[type="submit"] {
    flex: 0 0 auto !important;
    margin-left: auto !important;
    white-space: nowrap !important;
    height: 36px;
    padding: 0 14px;
    }
    /* Restore label readability */
    div[id*="ResultsGrid_Sheet0"] label {
    white-space: nowrap;
    margin-bottom: 0 !important;
    font-size: 0.95rem;   /* was too small before */
    line-height: 1.2;
    opacity: 1;           /* remove fading */
    }
    /* Force title to stay on its own line above filters */
    .FilterPanelHorizontal {
    display: block !important;
    }
    /* Title always full width */
    .FilterPanelHorizontal .PanelTitle,
    .FilterPanelHorizontal h2,
    .FilterPanelHorizontal h3 {
    display: block !important;
    width: 100%;
    flex: 0 0 100%;
    margin-bottom: 1rem;
    }
    div[id*="ResultsGrid_Sheet0"] input[type="text"],
    div[id*="ResultsGrid_Sheet0"] select {
    min-width: 120px;
    max-width: 170px;
    }
    /* Only the actual field container becomes flex */
    div[id*="ResultsGrid_Sheet0"] {
    display: flex !important;
    flex-wrap: nowrap !important;
    align-items: center !important;
    gap: 0.75rem !important;
    }
    /* Increase filter field label size */
    .ciDirectorySearch label,
    .QueryDisplay label,
    #ctl01_TemplateBody_WebPartManager1_gwpciDirectory_ciDirectory_ResultsGrid label {
    font-size: 16px !important;
    font-weight: 600 !important;
    color: #333 !important;
    }
</style>
