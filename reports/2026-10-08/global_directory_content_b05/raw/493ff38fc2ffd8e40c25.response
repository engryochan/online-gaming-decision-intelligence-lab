<div id="windowRegister" class="modal-body">
    <h2>Register</h2>
    <form id="addUserForm" class="form-register" autocomplete="off" method="post" action="/en/Grupo_BMV/Informacion_financiera_XBRL/_aid/688/_act/add">
        <fieldset>
