dren\":[\"$\",\"section\",null,{\"className\":\"rounded-2xl border border-[var(--fintech-gray-200)] bg-[var(--fintech-gray-50)] p-6 md:p-8\",\"children\":[\"$\",\"div\",null,{\"className\":\"min-w-0 border-l-2 border-[var(--fintech-green-600)] pl-6 md:pl-7\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-[family-name:var(--font-inter)] text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--fintech-blue-600)]\",\"children\":\"Trading Venue\"}],[\"$\",\"div\",null,{\"className\":\"$37\",\"children\":[[\"$\",\"h2\",\"0\",{\"children\":[\"Trading venue\"]}],[\"$\",\"p\",\"1\",{\"children\":[\"The NOREXECO market place is supported by an Electronic Trading System, the KBT Portal, delivered by the European Energy Exchange AG owned company KB Technology Ltd. The Portal handles orders, automatching, passing on trades to European Commodity Clearing AG (ECC) for real time clearing and information distribution. Information is distributed globally via our web site, approved Independent Software Vendors (ISVs) and financial information distributors.\"]}],[\"$\",\"h2\",\"2\",{\"children\":[\"Direct access to the Portal\"]}],[\"$\",\"p\",\"3\",{\"children\":[\"Trade Members access NOREXECO through the browser-based trading Portal. Access is controlled by username, password, TFA and IP whitelisting. Pre-trade limits apply and risk managers may impose clearing limits. Three named Portal users are included in the standard monthly fee. Additional users can be provisioned on request.\"]}],[\"$\",\"h2\",\"4\",{\"children\":[\"FIX \u0026 API connectivity\"]}],[\"$\",\"p\",\"5\",{\"children\":[\"Approved ISVs can connect via NOREXECO’s FIX or native API gateways. The ultimate FIX integration requires registration of a Portal user and gives Direct Market Access which covers order entry with MiFIR attributes, clearing information, pre-trade limits and market data while a less sophisticated API integration would support outgoing market data.\"]}],\"$L38\",\"$L39\",\"$L3a\",\"$L3b\"]}],null]}]}]}]}]}]\n"])</script><script>self.__next_f.push([1,"3c:T594,"])</script><script>self.__next_f.push([1,"relative hover:cursor-pointer gap-2 whitespace-nowrap active:translate-y-0 disabled:pointer-events-none disabled:opacity-50 [\u0026_svg]:pointer-events-none [\u0026_svg:not([class*='size-'])]:size-4 shrink-0 [\u0026_svg]:shrink-0 outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 aria-invalid:border-destructive marketing-cta-primary h-9 has-[\u003esvg]:px-3 no-underline inline-flex items-center justify-center font-semibold transition-[color,box-shadow,transform,opacity,background-color] duration-300 ease-out active:scale-[0.98] min-w-44 rounded-full px-5 py-2.5 text-sm marketing-cta-primary border border-transparent bg-gradient-to-r from-[var(--brand-btn-from)] to-[var(--brand-btn-to)] text-[var(--brand-btn-fg)] shadow-sm hover:shadow-md hover:-translate-y-0.5 hover:from-[var(--brand-btn-from-hover)] hover:to-[var(--brand-btn-to-hover)] no-underline inline-flex items-center justify-center font-semibold transition-[color,box-shadow,transform,opacity,background-color] duration-300 ease-out active:scale-[0.98] min-w-44 rounded-full px-5 py-2.5 text-sm marketing-cta-primary border border-transparent bg-gradient-to-r from-[var(--brand-btn-from)] to-[var(--brand-btn-to)] text-[var(--brand-btn-fg)] shadow-sm hover:shadow-md hover:-translate-y-0.5 hover:from-[var(--brand-btn-from-hover)] hover:to-[var(--brand-btn-to-hover)]"])</script><script>self.__next_f.push([1,"2e:[\"$\",\"div\",\"5\",{\"className\":\"my-6 md:my-8 scroll-mt-28\",\"data-block-type\":\"finCta\",\"id\":\"member-list-cta\",\"children\":[\"$\",\"section\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"rounded-2xl border border-[var(--fintech-gray-200)] bg-gradient-to-b from-[var(--site-surface-muted)] to-[var(--site-surface-card)] px-4 py-8 s