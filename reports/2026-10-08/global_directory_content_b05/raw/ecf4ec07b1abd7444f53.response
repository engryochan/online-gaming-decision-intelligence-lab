ar(--font-inter)] text-[11px] font-semibold uppercase tracking-[0.14em] text-[var(--fintech-blue-600)]\",\"children\":\"Trade Members\"}],[\"$\",\"div\",null,{\"className\":\"$2f\",\"children\":[[\"$\",\"h2\",\"0\",{\"children\":[\"Trading as a Trade Member\"]}],[\"$\",\"p\",\"1\",{\"children\":[\"A Trade Member of NOREXECO is allowed to trade directly in the Electronic Trading System (ETS) or via the NOREXECO Market Service Desk. A Trade Member is also allowed to be a participant in Block Trades in NOREXECO Products.\"]}],[\"$\",\"p\",\"2\",{\"children\":[\"A Trade Member may facilitate Direct Market Access (DMA) to its clients either directly in the ETS or by use of a third party order routing service.\"]}],[\"$\",\"h2\",\"3\",{\"children\":[\"Membership requirements\"]}],[\"$\",\"p\",\"4\",{\"children\":[\"In order to become a Trade Member, the applicant must comply with the membership criteria of NOREXECO, have an agreement with a clearing bank at European Commodity Clearing AG (ECC), the clearing house partner of NOREXECO, and be approved as a Trading Participant by ECC.\"]}],[\"$\",\"h2\",\"5\",{\"children\":[\"Application process\"]}],[\"$\",\"p\",\"6\",{\"children\":[\"NOREXECO and ECC have aligned the two application processes which have to be quite formal due to regulatory requirements. A membership application consists of some required information such as:\"]}],[\"$\",\"p\",\"7\",{\"children\":[\"• Application forms to become a Trade Member of NOREXECO and Approved Trading Participant of ECC\"]}],[\"$\",\"p\",\"8\",{\"children\":[\"• A commercial registry extract (no older than three months old)\"]}],\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\"]}],null]}]}]}]}]}]\n"])</script><script>self.__next_f.push([1,"2b:[\"$\",\"div\",\"2\",{\"className\":\"my-6 md:my-8 scroll-mt-28\",\"data-block-type\":\"fintechTable\",\"id\":\"trade-members\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-full font-sans antialiased text-foreground\",\"children\":[\"$\",\"$L35\",null,{\"className\":\"$undefined\",\"countryColumnLabel\":\"Country\",\"footnoteAfterHighlight\":\"– these are clients of Trade Members.\",\"footnoteBeforeHighlight\":\"A number of other market participants are undisclosed\",\"footnoteHighlight\":\"INDIRECT MEMBERS\",\"legalPolicyPage\":true,\"memberNameColumnLabel\":\"Member name\",\"members\":[{\"name\":\"DNB Bank ASA\",\"country\":\"NORWAY\"},{\"name\":\"Delfortgroup AG\",\"country\":\"AUSTRIA\"},{\"name\":\"Goldman Sachs Bank Europe SE\",\"country\":\"GERMANY\"},{\"name\":\"Morgan Stanley \u0026 Co. International Plc\",\"country\":\"UK\"},{\"name\":\"Morgan Stanley Europe SE\",\"country\":\"GERMANY\"},{\"name\":\"Sappi International SA\",\"country\":\"BELGIUM\"},{\"name\":\"Skandinaviska Enskilda Banken AB\",\"country\":\"SWEDEN\"},{\"name\":\"StoneX Financial Ltd.\",\"country\":\"UK\"},{\"name\":\"UPM Kymmene Oyj\",\"country\":\"FINLAND\"},{\"name\":\"Altri SGPS SA\",\"country\":\"PORTUGAL\"},{\"name\":\"StoneX Financial Europe GmbH\",\"country\":\"Germany\"}],\"title\":\"Trade Members\"}]}]}]}]\n"])</script><script>self.__next_f.push([1,"2c:[\"$\",\"div\",\"3\",{\"className\":\"my-6 md:my-8 scroll-mt-28\",\"data-block-type\":\"fintechTable\",\"id\":\"services-fees\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"w-full font-sans antialiased text-foreground\",\"children\":[\"$\",\"$L36\",null,{\"categoryColumnLabel\":\"Category\",\"className\":\"$undefined\",\"exchangeMembersColumnLabel\":\"Exchange members\",\"footnoteAsterisk\":\"* For settlement on recycled paper and pulp OTC contracts\",\"footnoteNote\":\"Note: Mandatory reporting is required for all OTC settlement transactions. Fees are subject to standard VAT where applicable.\",\"intro\":\"Transparent pricing for members and non-members.\",\"legalPolicyPage\":true,\"nonMembersExternalUseColumnLabel\":\"Non-members (external u