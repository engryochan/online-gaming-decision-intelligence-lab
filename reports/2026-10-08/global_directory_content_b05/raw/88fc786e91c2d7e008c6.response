    <script type="text/javascript">
        $(document).ready(function () {
            //Disabling autocompletion on all forms
            try {
                $("input[type='text']").each(function () {
                    $(this).attr("autocomplete", "off");
                });
            } catch (e) {
            }
        });

        //Showing the loader for ajax requests
        function onBegin() {
            $("#spiner").show();
        }

        //Showing the loader for ajax requests
        function onFilterBegin() {
            $("#loading").show();
        }

        //Hidding the loader for ajax requests
        function onComplete() {
            $("#spiner").hide();
        }

        //Hidding the loader for ajax requests
        function onSuccess() {
            $("#spiner").hide();
            $("[data-toggle='tooltip']").tooltip();
        }
    </script>
