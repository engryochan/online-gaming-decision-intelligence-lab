    padding:0 0 0 0;
    margin-right:30px;
}
.nse_newtabs .tabbed[data-style="minimal"] >ul li:not(.cta-button) .active-tab{
    color:#8DC442;
}
.nse_newtabs .tabbed[data-style*="minimal"] >ul li .active-tab:after{
    background-color:#8DC442;
}
.nse_newtabs .tabbed[data-style="minimal"] .wpb_tabs_nav {
    border-bottom: 1px solid #303d4a;
    margin-bottom: 25px;
}
.nse_paginations{
    display:none !important;
}
.nse_tabled thead{
    display:none;
}
.nse_tabled .gainerstable tbody, .nse_tabled .loserstable tbody, .nse_tabled .moverstable tbody {
    background: transparent !important;
    border-bottom: 1px #ddd solid !important;
    border-left: 1px #ddd solid !important;
    border-right: 1px #ddd solid !important;
}
.nse_tabled .tabbed[data-style="minimal_flexible"] .wpb_tabs_nav {
    margin-bottom: 5px;
}
.nse_newtabs .wpb_tabs_nav{
    margin-bottom:0 !important;
}
.nse_newtabs #tab-corporate-actions, .nse_newtabs #tab-press-release, 
.nse_newtabs #tab-corporate-announcements, .nse_newtabs #tab-events, 
.nse_newtabs #tab-corporate-actions,
.nse_newtabs #tab-press-releases,
.nse_newtabs #tab-success-stories{
