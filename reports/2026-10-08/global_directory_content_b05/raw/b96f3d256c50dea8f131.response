}
.nse_videos .nectar-flickity.nectar-carousel.nectar-carousel:not(.masonry) .flickity-viewport {
    margin: 0px 0 0px 0 !important;
}
.nse_car{
    position:relative;
    z-index:1000;
}
.nse_car .flickity-page-dots .dot {
    width: 30px !important;
}
.nse_car .flickity-page-dots .dot:before {
    height: 6px !important;
    border-radius: 5px !important;
}
.nse_car .nectar-flickity[data-control-style="material_pagination"] .flickity-page-dots .dot:before{
    width: 12px;
}
.nse_car .nectar-flickity[data-control-style="material_pagination"] .flickity-page-dots .dot.is-selected:before{
    box-shadow: inset 0 0 0 1px #8dc442;
    background-color: #8dc442;
}
.nse tabes .tabbed[data-style*="material"] .wpb_tabs_nav, .tabbed[data-style="minimal_flexible"] .wpb_tabs_nav{
    margin-bottom:0;
}
.tabbed[data-style*="minimal"][data-color-scheme="accent-color"] > ul li a:after {
    background-color: #303d4a !important;
}
.nse_tabs .tabbed[data-style*="minimal"][data-color-scheme="accent-color"] > ul li:first-child a{
    color:#8dc442;
