    font-weight:500 !important;
}
.event_date{
    font-size:55px !important;
}
.event_month{
    font-size:18px !important;
    font-weight:500 !important;
    padding-top:10px;
    text-align:center !important;
}
.mec-event-grid-minimal .mec-event-date {
    width: 100px;
    padding: 32px 16px 20px;
}
