}
.nse_statistics .stat_col:not(:first-child){
        padding: 0 30px;
    }
    .stat_data{
        display: flex;
        white-space: nowrap;
        overflow-y: hidden;
        overflow-x: scroll;
    }
/* Hide scrollbar for Chrome, Safari and Opera */
    .stat_data::-webkit-scrollbar {
    display: none;
    }

    /* Hide scrollbar for IE, Edge and Firefox */
    .stat_data {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
    }
