.nse_mobilesearch{
    display:inline-block;
}
.nse_mobilesearch input{
    line-height:8px;
    padding:8px;
}
.nse_mobilesearch i {
    top: 9px !important;
    right: 12px !important;
    font-size: 15px !important;
    color: #3b4755;
}
.nse_secondnav{
    display:flex;
    justify-content: space-between;
}
.nse_secondnav .nse_flags:after{
    content: '';
    background: #fff;
    padding: 12px 1px;
    position: absolute;
    margin: 5px 10px;
    top: 5px;
}
.nse_newcol .nse_flags img{
    vertical-align: middle;
}
.nse_newcol .nse_flags a{
    font-size: 13px;
}    
.nse_secondnav{
    top: 25px;
    position: relative;
    font-size: 11px;
    background: #F3F3F3;
    height: 52px;
    overflow: hidden;
    padding: 10px 10px;
}
@media only screen and (min-width: 1300px){
#ajax-content-wrap .container, .post-area.standard-minimal.full-width-content .post .inner-wrap {
    max-width: 1200px !important;
}
}
@media only screen and (min-width: 1000px){
#header-outer:not([data-format="left-header"]) #top > .container > .row, #header-outer:not([data-format="left-header"]) #top > .container > .row nav, #header-outer:not([data-format="left-header"]) #top > .container > .row nav >ul, #header-outer:not([data-format="left-header"]) #top > .container > .row nav >ul > li {
    align-items:center
}
.container-wrap, .project-title {
    background-color: #f8f8f8;
    position: relative;
    z-index: 10;
    margin-top: 0;
    padding-top: 0px;
    padding-bottom: 0px;
}
}
@media only screen and (min-width: 1000px){
    .nse_mobilesearch{
        display:none;
    }
    .nse_secondnav{
        display:none;
    }
#header-outer:not([data-format="left-header"]) #top nav >ul {
    float:right;
}
.nse_row{
    max-width:1440px !important;
    margin:auto !important;
    padding:0 40px;
}
.nse_nav{
    display: flex;
    justify-content: flex-end;
    background: #303D4A;
    padding: 12px 0;
}
.nse_nav .nse_second{
    max-width:1440px;
    margin:auto;
    width:1440px;
    padding: 0 40px;
}
}
.nse_search{
    position:relative;
}
.nse_search i{
    position: absolute;
    top: 10px;
    right: 15px;
    font-size: 22px;
    color: #3b4755;
}
.nse_search input{
    border-radius: 35px;
    border: 1px solid #303d4a;
    background: #fff;
}
@media only screen and (max-width: 480px){
    .nse_secondnav{
        zoom: 75%;
    }
}
@media only screen and (min-width: 1000px){
#header-outer #logo, #header-outer .logo-spacing {
    margin-top: 10px;
    margin-bottom: 10px;
}
#header-secondary-outer ul {
    float: left;
}
#header-secondary-outer #social, .nse_flags {
    float: right;
}
.menu-item-5303{
    display:none !important;
}
.menu-item-1110{
    top:2px;
}
a.glink span {
    margin-right: 5px;
    font-size: 15px;
    vertical-align: middle;
}
a.glink img {
    vertical-align: middle;
    display: inline;
    border: 0;
    padding: 0;
    margin: 0;
    opacity: 0.8;
}
.nse_flags{
    padding-right:30px;
}
.nse_flags a{
    color:#fff;
}
#header-secondary-outer #social li a i {
    font-size: 14px;
    width:14px;
    color:#fff;
}
#header-secondary-outer #social li a{
    border:1px solid #fff !important;
    border-radius:25px;
}
#header-secondary-outer #social li:not(:last-child){
    padding-right:10px;
}
.nse_topbar{
    background: #303d4a;
}
.nse_topbar > nav{
    height: 45px;
    padding: 5px 40px;
    max-width: 1440px;
    margin:auto;
}
body #header-secondary-outer nav >ul >li >a {
    border:none !important;
    color:#fff !important;
    font-size: 13px;
    text-transform: uppercase;
}
#header-secondary-outer nav >ul >li >a .sf-sub-indicator i {
    color:#fff;
}
#header-outer nav ul li a{
    color:#fff;
    text-transform:uppercase;
    font-size:14px;
}
body:not(.vc_editor) .flickity-page-dots {
    bottom:-60px !important;
    margin: 0 285px !important;
}
.flickity-page-dots .dot:before {
    height: 10px !important;
    border-radius: 5px !important;
}
.flickity-page-dots .dot {
    width: 18px !important;
}
.megamenu.nectar-megamenu-menu-item .sub-menu li a{
    padding:15px 6px !important;
}
.megamenu.nectar-megamenu-menu-item .sub-menu li a{
    border-bottom:1px solid #ddd !important;
}
#header-outer nav >ul >.megamenu.nectar-megamenu-menu-item.width-75 > ul{
    width:85em;
}
#header-outer nav >ul >.megamenu.nectar-megamenu-menu-item >.sub-menu > li{
    border-right: 1px solid #ddd;
}
#header-outer .sf-menu li ul li a{
    color:#000;
}
body:not([data-header-format="left-header"]) #header-outer nav >ul >.megamenu >ul >li >a, body:not([data-header-format="left-header"]) #header-outer nav >ul >.megamenu >ul >li >ul >.has-ul >a {
    background: #303d4a !important;
    color: #fff !important;
    padding: 10px 10px !important;
}
#footer-outer #copyright {
    background-color: #848B93;
    color: #fff;
}
#stat_left{
	position: absolute;
	left: -50px;
	top:125px;
}
#stat_right{
	position: absolute;
	right: -50px;
	top:125px;
}
#stat_right button, #stat_left button{
	font-size:20px;
	font-weight:600;
	cursor:pointer;
}
}
.news_form input[type="email"], .nse-fcontrol{
    width: 100%;
    background: #ccc;
    font-size: 20px;
    height: 50px;
    border: none;
    border-radius: 10px;
    color: #000;
    padding: 0 10px;
}
.nse_submit{
    margin-top: 15px;
    padding: 10px 30px !important;
    font-size: 20px !important;
    border-radius: 10px !important;
}
#footer-widgets .widgettitle{
    font-size: 20px;
    font-weight: 600;
    color: #fff;
}
#footer-outer .widget.widget_nav_menu li a, #footer-outer #footer-widgets .col ul ul li:last-child {
    border-bottom: 0!important;
    padding: 3px 0px !important;
    font-size: 17px;
}
#nseitems3, #nseticker3{
    height:45px !important;
}
#nseitems, #nseitemss, #nseitems3{
    font-size:16px;
}
#thrnseappend, #thrnseappend2 {
    line-height: 45px !important;
}
.nseclosing{
    color:#fff !important;
}
.nseclosing.nsegreat:after, .nseclosing.nsenegative:after, .nseclosing.nseneutral:after {
    padding-left: 5px !important;
}
@media only screen and (max-width: 1000px){
#stat_right,#stat_left{
    display:none !important;
}
.mobile-only .menu-item-1110{
    display:none !important;
}
#msl-ir-container {
    overflow: scroll;
}
}
.stat_percent:not(.zero):before {
    content: "\f0d8";
    font-family: FontAwesome;
    padding: 0 5px;
    color: #4BAC43;
}
.stat_percent.zero:before {
    content: "\f0dc";
    font-family: FontAwesome;
    padding: 0 5px;
    color: #FFBF00;
}
.nse_footerflex{
    display:flex;
    justify-content: space-evenly;
    position:relative;
    z-index:100;
    background: #848B93;
}
.nse_footerflex .col-flex{
    width:17%;
}
.nse_quicklinks{
    text-align: center;
    background: #8dc442;
    padding: 10px 10px;
    vertical-align: middle;
}
.nse_quicklinks h3{
    color:#fff;
    margin:0 !important;
