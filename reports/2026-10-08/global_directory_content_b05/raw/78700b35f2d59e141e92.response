Btm">Registered office: 8 Marina View, #43-062 Asia Square Tower 1, Singapore 018960</span></div><div class="index-module__CjsThG__padPara2">© Copyright BondbloX <!-- -->2026<!-- -->, All Rights Reserved.</div></div></div></div><div id="myportal"></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"responseData":{"memberDirectories":[{"id":9,"name":"Aldiracita Sekuritas Indonesia","description":"Aldiracita Sekuritas Indonesia (“Aldira”) was established in 1990 as a securities company and member of Indonesia Stock Exchange. They provide a wide range of financial services, from equity and fixed income brokerage, investment banking, and corporate finance services to institutional and retail clients by taking into consideration our clients' risk tolerance and market dynamics.","phone":"+62 021-39705858","email":"cso@aldiracita.com","featured_member":null,"published_at":"2021-11-03T01:53:25.477Z","created_at":"2021-11-03T01:53:23.231Z","updated_at":"2021-11-03T01:55:08.034Z","image":{"id":41,"name":"Aldira Logo.png","alternativeText":"","caption":"","width":250,"height":177,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Aldira_Logo_ab7cd77492.png","hash":"thumbnail_Aldira_Logo_ab7cd77492","mime":"image/png","name":"thumbnail_Aldira Logo.png","path":null,"size":16.88,"width":220,"height":156}},"hash":"Aldira_Logo_ab7cd77492","ext":".png","mime":"image/png","size":11.55,"url":"/uploads/Aldira_Logo_ab7cd77492.png","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T01:53:20.066Z","updated_at":"2021-11-03T01:53:20.080Z"},"featured_member_video":null},{"id":1,"name":"Amstel Securities (Asia)","description":"The Amstel Group, headquartered in Singapore, has operated as an institutional intermediary in Fixed Income, Money Market, FX, and Private Debt markets for over 30 years. For the first time in its history it is allowing access for accredited individual investors to transact at institutional prices. The Amstel Group comprises over 150 people in 7 global offices, and holds multiple licenses from the Monetary Authority of Singapore.","phone":"+65 6550 6249","email":"privateclients@amstelsec.com.sg","featured_member":null,"published_at":"2021-11-03T00:54:31.456Z","created_at":"2021-11-03T00:54:28.666Z","updated_at":"2021-11-03T01:49:12.168Z","image":{"id":28,"name":"Amstel Logo.jpg","alternativeText":"","caption":"","width":165,"height":153,"formats":null,"hash":"Amstel_Logo_60a1b5a48e","ext":".jpg","mime":"image/jpeg","size":7.9,"url":"/uploads/Amstel_Logo_60a1b5a48e.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T00:54:20.244Z","updated_at":"2021-11-03T00:54:20.257Z"},"featured_member_video":null},{"id":14,"name":"AXSA","description":"AXSA is an independent investment management firm based in Singapore that offers end-to-end investment and advisory services to individuals, family offices and institutions.","phone":"+65 6809 5162","email":"inquiries@axsawm.com","featured_member":null,"published_at":"2023-09-19T02:45:49.718Z","created_at":"2023-09-19T02:45:46.817Z","updated_at":"2023-09-19T02:45:49.746Z","image":{"id":180,"name":"4f4ef3_9f17453b249a4b74badad883c9033fea~mv2.png","alternativeText":"","caption":"","width":714,"height":334,"formats":{"small":{"ext":".png","url":"/uploads/small_4f4ef3_9f17453b249a4b74badad883c9033fea_mv2_61783160d8.png","hash":"small_4f4ef3_9f17453b249a4b74badad883c9033fea_mv2_61783160d8","mime":"image/png","name":"small_4f4ef3_9f17453b249a4b74badad883c9033fea~mv2.png","path":null,"size":19.55,"width":500,"height":234},"thumbnail":{"ext":".png","url":"/uploads/thumbnail_4f4ef3_9f17453b249a4b74badad883c9033fea_mv2_61783160d8.png","hash":"thumbnail_4f4ef3_9f17453b249a4b74badad883c9033fea_mv2_61783160d8","mime":"image/png","name":"thumbnail_4f4ef3_9f17453b249a4b74badad883c9033fea~mv2.png","path":null,"size":8.24,"width":245,"height":115}},"hash":"4f4ef3_9f17453b249a4b74badad883c9033fea_mv2_61783160d8","ext":".png","mime":"image/png","size":13.54,"url":"/uploads/4f4ef3_9f17453b249a4b74badad883c9033fea_mv2_61783160d8.png","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2023-09-19T02:45:42.218Z","updated_at":"2023-09-19T02:45:42.299Z"},"featured_member_video":null},{"id":2,"name":"CapBridge","description":"Invest like The Top 1% with CapBridge, Asia’s Digital Gateway to the World Private Markets. As a fully digital wealth management platform, CapBridge provides access to highly sought-after private equity (PE) products, including pre-IPO unicorns, top-quartile funds, real estate, and bonds. Their innovative solutions allow investors to invest in these exclusive asset classes at a fraction of the cost - helping investors unlock greater value and achieve higher risk-adjusted returns.\nCapBridge is regulated by the Monetary Authority of Singapore. Strategic shareholders include SGX, SGInnovate, Hong Kong Cyberport and Hanwha Investment \u0026 Securities.","phone":"+65 9829 2062","email":"contact@capbridge.sg","featured_member":false,"published_at":"2021-11-03T00:57:04.480Z","created_at":"2021-11-03T00:57:01.769Z","updated_at":"2022-02-28T08:34:47.429Z","image":{"id":36,"name":"CapBridge Logo.png","alternativeText":"","caption":"","width":250,"height":66,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Cap_Bridge_Logo_2166d97cf8.png","hash":"thumbnail_Cap_Bridge_Logo_2166d97cf8","mime":"image/png","name":"thumbnail_CapBridge Logo.png","path":null,"size":14.29,"width":245,"height":65}},"hash":"Cap_Bridge_Logo_2166d97cf8","ext":".png","mime":"image/png","size":10.08,"url":"/uploads/Cap_Bridge_Logo_2166d97cf8.png","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T01:15:50.771Z","updated_at":"2021-11-03T01:15:50.780Z"},"featured_member_video":{"id":50,"name":"BondbloX X CapBridge Final (H.264) (3).mp4","alternativeText":"","caption":"","width":null,"height":null,"formats":null,"hash":"Bondblo_X_X_Cap_Bridge_Final_H_264_3_64a69c217c","ext":".mp4","mime":"video/mp4","size":194385.8,"url":"/uploads/Bondblo_X_X_Cap_Bridge_Final_H_264_3_64a69c217c.mp4","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T05:53:39.819Z","updated_at":"2021-11-03T05:53:39.829Z"}},{"id":3,"name":"Century Private Wealth","description":"Century Private Wealth is a Dubai Financial Services Authority (DFSA) regulated Asset and Wealth Manager, entrusted with the legacies of some of the Middle-East’s most successful entrepreneurs, innovators, visionaries, and their families. Managed by highly qualified professionals and seasoned bankers, we are committed to setting the highest standards in Private Wealth Management, providing tailored investment advice clubbed with transparent solutions.","phone":"+971 4 509 8500","email":"info@centurywealth.ae","featured_member":null,"published_at":"2021-11-03T01:05:26.678Z","created_at":"2021-11-03T01:05:24.280Z","updated_at":"2021-11-03T01:15:12.474Z","image":{"id":35,"name":"Century Private Wealth Logo.png","alternativeText":"","caption":"","width":250,"height":77,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Century_Private_Wealth_Logo_34d0b31a75.png","hash":"thumbnail_Century_Private_Wealth_Logo_34d0b31a75","mime":"image/png","name":"thumbnail_Century Private Wealth Logo.png","path":null,"size":9.52,"width":245,"height":75}},"hash":"Century_Private_Wealth_Logo_34d0b31a75","ext":".png","mime":"image/png","size":6.63,"url":"/uploads/Century_Private_Wealth_Logo_34d0b31a75.png","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T01:15:08.107Z","updated_at":"2021-11-03T01:15:08.123Z"},"featured_member_video":null},{"id":13,"name":"DigiFT","description":"A global outfit backed by well-established venture partners, DigiFT is the first and only regulatory-compliant security token DEX enrolled in the Monetary Authority of Singapore (MAS) FinTech Regulatory Sandbox.","phone":"+65 6914 9824","email":"support@digift.com.sg","featured_member":null,"published_at":"2023-09-19T02:38:32.444Z","created_at":"2023-09-19T02:38:06.821Z","updated_at":"2023-09-19T02:42:38.315Z","image":{"id":179,"name":"download.png","alternativeText":"","caption":"","width":406,"height":124,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_download_e722134034.png","hash":"thumbnail_download_e722134034","mime":"image/png","name":"thumbnail_download.png","path":null,"size":8.21,"width":245,"height":75}},"hash":"download_e722134034","ext":".png","mime":"image/png","size":4.03,"url":"/uploads/download_e722134034.png","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2023-09-19T02:37:59.311Z","updated_at":"2023-09-19T02:37:59.333Z"},"featured_member_video":null},{"id":11,"name":"Equity Bank Bahamas Limited","description":"Equity Bank Bahamas Limited is located in Nassau, Bahamas, the leading private management centre in the Caribbean region and is part of The Equity Group of Companies with bank and trust company affiliates in Switzerland. As an independent, boutique bank, trust and other financial services provider, The Equity Group designs custom made products and services to meet specific needs of high net worth individuals, families and institutional clients. The breadth of their multi-jurisdictional group of companies and affiliates provides them with the flexibility to devise and establish entities and relationships not only in The Bahamas but elsewhere if this in the best interest of a client.","phone":"+1 (242) 676-8188","email":"ddean@equitybahamas.com","featured_member":null,"published_at":"2022-09-22T01:12:52.825Z","created_at":"2022-09-21T03:56:14.630Z","updated_at":"2022-09-22T01:12:52.854Z","image":{"id":123,"name":"EBB Logo.jfif","alternativeText":"","caption":"","width":480,"height":105,"formats":{"thumbnail":{"ext":".jfif","url":"/uploads/thumbnail_EBB_Logo_20cc916c2e.jfif","hash":"thumbnail_EBB_Logo_20cc916c2e","mime":"image/jpeg","name":"thumbnail_EBB Logo.jfif","path":null,"size":4.35,"width":245,"height":54}},"hash":"EBB_Logo_20cc916c2e","ext":".jfif","mime":"image/jpeg","size":7.79,"url":"/uploads/EBB_Logo_20cc916c2e.jfif","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2022-09-21T03:54:11.622Z","updated_at":"2022-09-21T03:54:11.638Z"},"featured_member_video":null},{"id":12,"name":"EquityBasket Capital","description":"Eqbac is a web based platform, through which investor clients will gain financial and investment advice along with the freedom to choose where, when, and how they want to trade.","phone":"+971 50 8405577","email":"contactus@eqbac.com","featured_member":null,"published_at":"2022-09-21T08:12:11.437Z","created_at":"2022-09-21T08:12:03.150Z","updated_at":"2023-09-19T02:48:13.581Z","image":{"id":124,"name":"Eqbac - Final Logo.png","alternativeText":"","caption":"","width":1390,"height":324,"formats":{"large":{"ext":".png","url":"/uploads/large_Eqbac_Final_Logo_f62dc4adfb.png","hash":"large_Eqbac_Final_Logo_f62dc4adfb","mime":"image/png","name":"large_Eqbac - Final Logo.png","path":null,"size":112.76,"width":1000,"height":233},"small":{"ext":".png","url":"/uploads/small_Eqbac_Final_Logo_f62dc4adfb.png","hash":"small_Eqbac_Final_Logo_f62dc4adfb","mime":"image/png","name":"small_Eqbac - Final Logo.png","path":null,"size":43.1,"width":500,"height":117},"medium":{"ext":".png","url":"/uploads/medium_Eqbac_Final_Logo_f62dc4adfb.png","hash":"medium_Eqbac_Final_Logo_f62dc4adfb","mime":"image/png","name":"medium_Eqbac - Final Logo.png","path":null,"size":75.22,"width":750,"height":175},"thumbnail":{"ext":".png","url":"/uploads/thumbnail_Eqbac_Final_Logo_f62dc4adfb.png","hash":"thumbnail_Eqbac_Final_Logo_f62dc4adfb","mime":"image/png","name":"thumbnail_Eqbac - Final Logo.png","path":null,"size":16.59,"width":245,"height":57}},"hash":"Eqbac_Final_Logo_f62dc4adfb","ext":".png","mime":"image/png","size":60.86,"url":"/uploads/Eqbac_Final_Logo_f62dc4adfb.png","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2022-09-21T08:05:46.920Z","updated_at":"2022-09-21T08:05:46.935Z"},"featured_member_video":null},{"id":4,"name":"GFM Group","description":"The GFM Group is a Hong Kong based provider of wealth management services for professional global citizens and their multinational families. Initially focused on serving American clients with US IRA, 401k, and 529 accounts, GFM now serves high net worth and pre high net worth individuals in over a dozen countries around the world with a full suite of wealth management services and a passionate interest in evaluating individual stock opportunities. GFM co-Founder Tariq Dennison TEP is also a renowned speaker and lecturer on fixed income, ETFs and alternative investments, and uses the BondbloX platform to build better balanced bond ladders for non-US clients.","phone":"+852 9476 2868","email":"bondblox@gfmii.com","featured_member":null,"published_at":"2021-11-03T01:08:45.586Z","created_at":"2021-11-03T01:08:43.245Z","updated_at":"2021-11-03T01:13:41.884Z","image":{"id":34,"name":"GFM Logo.png","alternativeText":"","caption":"","width":250,"height":98,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_GFM_Logo_3fa0f363da.png","hash":"thumbnail_GFM_Logo_3fa0f363da","mime":"image/png","name":"thumbnail_GFM Logo.png","path":null,"size":24.97,"width":245,"height":96}},"hash":"GFM_Logo_3fa0f363da","ext":".png","mime":"image/png","size":19.42,"url":"/uploads/GFM_Logo_3fa0f363da.png","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T01:13:36.679Z","updated_at":"2021-11-03T01:13:36.689Z"},"featured_member_video":null},{"id":10,"name":"InCred Global Wealth Pte. Ltd.","description":"InCred is a Wealth Management firm catering to U-HNIs. ​Client assets remain with the bank, while the advise is retained by them - allowing each to focus on their strengths. Their ethos is to give clients a first class service experience along with a competent, structured Investment advisory practice. Along with their global banking partners, in-house Investment advisory practice and product specific expertise - they ensure clients get the best of whats possible -  in a true open architecture model.","phone":"+65 6805 8196","email":"admin@incredwealth.sg","featured_member":null,"published_at":"2022-06-28T08:12:52.968Z","created_at":"2022-06-27T10:03:05.173Z","updated_at":"2022-06-28T08:12:53.000Z","image":{"id":116,"name":"Incred Logo.jpg","alternativeText":"","caption":"","width":200,"height":200,"formats":{"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_Incred_Logo_91db89d4bf.jpg","hash":"thumbnail_Incred_Logo_91db89d4bf","mime":"image/jpeg","name":"thumbnail_Incred Logo.jpg","path":null,"size":2.38,"width":156,"height":156}},"hash":"Incred_Logo_91db89d4bf","ext":".jpg","mime":"image/jpeg","size":3.32,"url":"/uploads/Incred_Logo_91db89d4bf.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2022-06-28T08:12:48.849Z","updated_at":"2022-06-28T08:12:48.865Z"},"featured_member_video":null},{"id":5,"name":"Investment Services UK Limited (ISUL)","description":"Investment Services UK Limited (ISUL) is an idea-centric investment advisory firm specialising in Global Fixed Income, covering emerging and developed markets. ISUL was established in 1995 and has been Authorised and Regulated by the Financial Conduct Authority (FCA) to act as 'Investment Advisors and Arrangers’. In 2013 ISUL upgraded its licence with the FCA and was granted permission to transact business on a 'Matched Principal’ basis. ISUL provides innovative and efficient investment strategies for our clients, understanding that in a competitive environment we need to go beyond standard solutions and think outside the box.","phone":"+44 207 436 8070","email":"info@isul.co.uk","featured_member":null,"published_at":"2021-11-03T01:10:28.833Z","created_at":"2021-11-03T01:10:26.660Z","updated_at":"2021-11-03T01:10:28.856Z","image":{"id":33,"name":"ISUL Logo.jpg","alternativeText":"","caption":"","width":237,"height":138,"formats":null,"hash":"ISUL_Logo_b48d378234","ext":".jpg","mime":"image/jpeg","size":4.21,"url":"/uploads/ISUL_Logo_b48d378234.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T01:10:23.733Z","updated_at":"2021-11-03T01:10:23.751Z"},"featured_member_video":null},{"id":8,"name":"Kristal.AI","description":"BondbloX and Kristal.AI announced a new investment product called the BondbloX Kristals. These are baskets of single bonds listed on the BondbloX Exchange that follow a theme such as SGD REIT Perps, USD Bank Perps and SGD Bank Perps. \n\nStarting at just a few thousand dollars, the new product allows investors to access bonds that were traditionally sold in $200,000 or higher minimum denominations. This gives them the ability to diversify across different issuers for a lower quantum while keeping to an underlying theme.","phone":"+65 9239 1022","email":"support@kristal.ai","featured_member":true,"published_at":"2021-11-03T01:48:31.046Z","created_at":"2021-11-03T01:48:27.831Z","updated_at":"2023-06-06T10:01:17.730Z","image":{"id":40,"name":"Kristal Logo.jpg","alternativeText":"","caption":"","width":247,"height":161,"formats":{"thumbnail":{"ext":".jpg","url":"/uploads/thumbnail_Kristal_Logo_0785b15246.jpg","hash":"thumbnail_Kristal_Logo_0785b15246","mime":"image/jpeg","name":"thumbnail_Kristal Logo.jpg","path":null,"size":3.65,"width":239,"height":156}},"hash":"Kristal_Logo_0785b15246","ext":".jpg","mime":"image/jpeg","size":3.48,"url":"/uploads/Kristal_Logo_0785b15246.jpg","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T01:50:25.494Z","updated_at":"2021-11-03T01:50:25.513Z"},"featured_member_video":{"id":93,"name":"Kristal Featured Video.mp4","alternativeText":"","caption":"BondEvalue and Kristal.AI Partner to Create Thematic Basket of Fractional Bonds","width":null,"height":null,"formats":null,"hash":"Kristal_Featured_Video_71f0b85a31","ext":".mp4","mime":"video/mp4","size":102623.19,"url":"/uploads/Kristal_Featured_Video_71f0b85a31.mp4","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2022-02-28T08:37:33.224Z","updated_at":"2022-02-28T08:38:07.504Z"}},{"id":7,"name":"UOB Kay Hian","description":"Backed by the UOB Group, UOB Kay Hian is one of Asia’s largest brokerage firms. Headquartered in Singapore, they are supported by more than 80 branches worldwide including a growing network of offices across Southeast Asia, Greater China, the United Kingdom and North America. Their global footprint and strong international presence have enabled them to feel the pulse of key financial markets and deliver incisive intelligence across industry sectors and asset classes.","phone":"+65 6536 9338","email":"contact@utrade.com.sg","featured_member":false,"published_at":"2021-11-03T01:20:26.219Z","created_at":"2021-11-03T01:20:07.685Z","updated_at":"2023-06-05T07:44:04.060Z","image":{"id":38,"name":"UOB Kay Hian Logo.png","alternativeText":"","caption":"","width":250,"height":51,"formats":{"thumbnail":{"ext":".png","url":"/uploads/thumbnail_UOB_Kay_Hian_Logo_4746b4119d.png","hash":"thumbnail_UOB_Kay_Hian_Logo_4746b4119d","mime":"image/png","name":"thumbnail_UOB Kay Hian Logo.png","path":null,"size":10.7,"width":245,"height":50}},"hash":"UOB_Kay_Hian_Logo_4746b4119d","ext":".png","mime":"image/png","size":6.36,"url":"/uploads/UOB_Kay_Hian_Logo_4746b4119d.png","previewUrl":null,"provider":"local","provider_metadata":null,"created_at":"2021-11-03T01:20:02.915Z","updated_at":"2021-11-03T01:20:02.924Z"},"featured_member_video":null}],"memberDirectoriesCount":13}},"__N_SSG":true},"page":"/trade-bonds/market-information/member-directory","query":{},"buildId":"aolv8lfkGjfCJZ7rBmxFB","isFallback":false,"isExperimentalCompile":false,"gsp":true,"scriptLoader":[]}</script></body></html>