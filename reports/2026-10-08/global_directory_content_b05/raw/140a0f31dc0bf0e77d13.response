@media only screen and (min-width: 1000px){
#header-outer #logo, #header-outer .logo-spacing {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
    
}}
#header-outer #top .sf-sub-indicator i{
    color:#C6912D !important;
}
.fa-angle-down:before {
    content: "\f0d7" !important;
}
body:not([data-header-format="left-header"]) #top .sf-menu li ul{
    padding:0 !important;
}
.sub-menu li{
        padding: 0 20px !important;
}
.sub-menu li:hover{
        background:#C6912D !important;
}
.stm-envelope-11:before {
    content: "\f003";
    font-family: FontAwesome;
}
.stm-phone-11:before{
    content: "\f095";
    font-family: FontAwesome;
}
.stm-location-11:before{
    content: "\f041";
    font-family: FontAwesome;
}
.stm_contacts_widget.style_4 ul li .icon .stm-envelope-11, .stm-phone-11, .stm-location-11 {
    display: inline-block;
    font-size: 19px;
    margin-top: 1px;
    margin-right: 11px;
}
.stm_contacts_widget.style_4 {
    font-family: 'Open Sans',sans-serif;
}
.stm_contacts_widget.style_4 .text{
    font-weight:600;
}
.stm_contacts_widget.style_4 li {
    display:flex;
    font-size:13px;
}
#footer-outer a:hover{
    color:#fff !important;
}
#footer-outer a, .custom-html-widget{
    font-size:13px;
     font-family: 'Open Sans',sans-serif;
     line-height:2;
}
.llinks li{
    padding: 8px 0;
    list-style: none;
    margin-bottom: 0;
    border-bottom: 0px !important;
    font-size: 13px;
    line-height: 1;
}
#footer-outer #footer-widgets .col ul li {
    border-bottom: 0px solid #444;
}
#footer-outer .row {
    padding: 35px 0;
    margin-bottom: 0;
}
#footer-outer, #nectar_fullscreen_rows > #footer-outer.wpb_row .full-page-inner-wrap {
    color: #fff;
    position: relative;
    z-index: 10;
    background-color: #C6912D;
}
#footer-outer a {
    color: #fff;
    font-weight: 600;
}
#footer-outer[data-link-hover="underline"] #footer-widgets ul:not([class*="nectar_blog_posts"]) li > a:not(.tag-cloud-link):not(.nectar-button), #footer-outer[data-link-hover="underline"] #footer-widgets .textwidget a:not(.nectar-button) {
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: left bottom;
    background-image: linear-gradient(to right, #ffffff 0%, #ffffff 100%);
}
#footer-widgets h6:after {
    content: '';
    display: block;
    width: 52px;
    height: 3px;
    background: #fff;
    margin-top: 13px;
}
#footer-outer #copyright[data-layout="centered"] {
    padding: 23px 0;
    color: #fff;
    font-family: 'Open Sans',sans-serif;
    font-size:14px;
}
#header-outer[data-lhe="animated_underline"] #top nav > ul > li > a{
    color: #2b2b2b !important;
}
#header-outer[data-lhe="animated_underline"] #top nav > ul > li > a:after{
    border-color: #fff;
}
#slide-out-widget-area:not(.fullscreen-alt):not(.fullscreen){
    background:#C6912D;
}
#header-space{
   height: 115px;
}
select{
    background-image: url(//www.bse.co.bw/wp-content/uploads/2020/02/Untitled-1-2.png) !important;
    overflow: hidden !important;
    border-radius: .25em !important;
    background-repeat: no-repeat !important;
    background-position: center right 15px !important;
    background-size: 12px !important;
    
}
.sf-menu li ul li .sf-sub-indicator {
    top: 8px;
    right: 0;
}
#header-outer:not([data-format="left-header"]) #top nav > ul > li:not(.megamenu) ul .current-menu-ancestor{
    background-color: #c6912d!important;
}
#header-outer:not([data-format="left-header"]) #top nav > ul > li:not(.megamenu) ul .current-menu-item{
    background-color: #c6912d!important;
}

@media only screen and (max-width: 690px){
    .bseslider .content p{
    font-size:14px;
    font-style:italic;
    font-weight:500;
    line-height:16px !important;
}
.bseslider .content span{
    line-height:inherit !important;
}
.bseslider .content{
    padding:0 !important;
    top:auto !important;
    bottom:100% !important;
}
}
@media only screen and (min-width: 691px){
.bseslider .content p{
    font-size:14px;
    font-style:italic;
    font-weight:500;
    line-height:27px !important;
}
.bseslider .content span{
    line-height:27px !important;
}
.bseslider .content{
    padding:0 !important;
    top:auto !important;
    bottom:0 !important;
}
}
.textwidget li{
    line-height:25px;
}
.lvca-accordion.lvca-style1 .lvca-panel.lvca-active .lvca-panel-title:after {
    color: #c6912d;
}
.lvca-accordion.lvca-style1 .lvca-panel .lvca-panel-title:after{
    color: #c6912d; 
}

/*#header-outer[data-full-width="true"] header >.container, body[data-slide-out-widget-area-style="simple"] #header-outer[data-full-width="true"] #mobile-menu {*/
/*    width: 100%;*/
/*    max-width: 100%;*/
/*    padding: 0 5px;*/
/*}*/

@media only screen and (max-width: 320px){
#time,#time2 {
    display: block !important;
}
    #ticker2,#ticker{
        margin-top: -15px;
    }
    .homepagetabsh .wpb_tabs_nav{
        zoom:80%;
    }
}
#ticker .items{
    text-transform:uppercase;
}
#ticker2 .items{
    text-transform:uppercase;
}
#insttable img{
    width:150px;
}
#search-results{
    height:auto !important;
}
@media only screen and (max-width: 780px){
.searchtext{
    display:none !important;
}
}
.searchtext{
    font-family:'corisanderegularregular',Arial,Helvetica,sans-serif !important;
}
.post-template-default .entry-title{
    font-size:35px !important;
}
.post-template-default .meta-category{
    display:none !important;
}
.post-template-default .nectar-social{
    display:none !important;
}
.grecaptcha-badge{
    display:none;
}
