f.__next_f.push([1," and fixed income ecosystem.\u0026nbsp;\u003c/p\u003e\",\"CTAButton\":\"$cf\",\"Cards\":\"$d0\",\"PagesCardsArea\":\"$d1\",\"ProductServicesCardsArea\":\"$ed\",\"_concreteType\":\"GenericTextCardsContainerBlock\"}\ncd:{\"Id\":39860,\"Expanded\":\"$ce\"}\nf2:[]\nf1:{\"Url\":\"https://files.dtcc.com/images/assets/DTCC_UnderstandingDTCC_r1.jpg/Zz0zMTA5ZTRjMDhmM2UxMWYxYjlmMGY2NDQxMTg0ZTA1Yg==\",\"Alt\":\"DTCC_UnderstandingDTCC_r1.jpg\",\"Category\":\"$f2\"}\nf0:{\"Expanded\":\"$f1\"}\nf8:{}\nf7:{\"Expanded\":\"$f8\"}\nf9:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\nfa:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\nf6:{\"Name\":\"What markets does DTCC support?\",\"AccordionHeader\":\"What markets does DTCC support?\",\"AccordionPanel\":\"\u003cp\u003eDTCC supports critical U.S. financial markets through its clearing and settlement subsidiaries, including equities, U.S. Treasuries, agency securities and mortgage-backed securities (MBS).\u003c/p\u003e\",\"ImageAccordionItem\":\"$f7\",\"AccordionCTA\":\"$f9\",\"ContentType\":\"$fa\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\nf5:{\"Id\":42530,\"GuidValue\":\"585d7a60-1742-4d96-9a70-6a592df2e9ac\",\"Expanded\":\"$f6\"}\nf4:{\"ContentLink\":\"$f5\",\"DisplayOption\":\"\",\"Tag\":null}\nff:{}\nfe:{\"Expanded\":\"$ff\"}\n100:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\n101:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\nfd:{\"Name\":\"What is the role of clearing in financial markets?\",\"AccordionHeader\":\"What is the role of clearing in financial markets?\",\"AccordionPanel\":\"\u003cp\u003eClearing helps ensure that trades are accurately matched, validated and prepared for settlement. By centralizing post-trade processing and risk management, clearing reduces uncertainty and helps markets operate more smoothly.\u003c/p\u003e\",\"ImageAccordionItem\":\"$fe\",\"AccordionCTA\":\"$100\",\"ContentType\":\"$101\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\nfc:{\"Id\":42531,\"GuidValue\":\"6c748b97-fe1c-4be3-a19f-572f5b94155d\",\"Expanded\":\"$fd\"}\nfb:{\"ContentLink\":\"$fc\",\"DisplayOption\":\"\",\"Tag\":null}\n106:{}\n105:{\"Expanded\":\"$106\"}\n107:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":"])</script><script>self.__next_f.push([1,"null}\n108:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\n104:{\"Name\":\"What is the difference between clearing and settlement?\",\"AccordionHeader\":\"What is the difference between clearing and settlement?\",\"AccordionPanel\":\"\u003cp\u003eClearing is the process of validating trades, managing risk and determining each party's obligations. Settlement is the final exchange of securities and cash that completes the transaction. Together, they help ensure trades are completed accurately and efficiently.\u003c/p\u003e\",\"ImageAccordionItem\":\"$105\",\"AccordionCTA\":\"$107\",\"ContentType\":\"$108\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\n103:{\"Id\":42532,\"GuidValue\":\"c70eb984-296c-4a6e-9d69-164d3c1b2391\",\"Expanded\":\"$104\"}\n102:{\"ContentLink\":\"$103\",\"DisplayOption\":\"\",\"Tag\":null}\n10d:{}\n10c:{\"Expanded\":\"$10d\"}\n10e:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\n10f:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\n10b:{\"Name\":\"Why is central clearing important?\",\"AccordionHeader\":\"Why is central clearing important?\",\"AccordionPanel\":\"\u003cp\u003eCentral clearing helps reduce counterparty risk by placing a central counterparty (CCP) between buyers and sellers. This helps improve transparency, strengthen market resilience and promote confidence in financial markets.\u003c/p\u003e\",\"ImageAccordionItem\":\"$10c\",\"AccordionCTA\":\"$10e\",\"ContentType\":\"$10f\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\n10a:{\"Id\":42533,\"GuidValue\":\"1aa3a211-f0a3-4e0f-9430-19cfb9e6fdbe\",\"Expanded\":\"$10b\"}\n109:{\"ContentLink\":\"$10a\",\"DisplayOption\":\"\",\"Tag\":null}\n114:{}\n113:{\"Expanded\":\"$114\"}\n115:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\n116:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\n112:{\"Name\":\"What is a central counterparty (CCP)?\",\"AccordionHeader\":\"What is a central counterparty (CCP)?\",\"AccordionPanel\":\"\u003cp\u003eA central counterparty (CCP) stands between trading counterparties and becomes the buyer to every seller and the seller to every buyer. By managing risk centrally, CCPs help "])</script><script>self.__next_f.push([1,"promote market stability and ensure eligible transactions are completed even during periods of market stress.\u0026nbsp;\u003cbr /\u003e\u0026nbsp;\u003c/p\u003e\",\"ImageAccordionItem\":\"$113\",\"AccordionCTA\":\"$115\",\"ContentType\":\"$116\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\n111:{\"Id\":44190,\"GuidValue\":\"1c28ade5-f042-4229-824f-79281168d439\",\"Expanded\":\"$112\"}\n110:{\"ContentLink\":\"$111\",\"DisplayOption\":\"\",\"Tag\":null}\n11b:{}\n11a:{\"Expanded\":\"$11b\"}\n11c:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\n11d:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\n119:{\"Name\":\"How does multilateral netting improve capital and liquidity efficiency?\",\"AccordionHeader\":\"How does multilateral netting improve capital and liquidity efficiency?\",\"AccordionPanel\":\"\u003cp\u003eMultilateral netting consolidates many trading obligations into a smaller number of net settlement positions. This reduces the number and value of transactions that must be settled, helping firms lower funding needs and use capital and liquidity more efficiently.\u0026nbsp;\u003c/p\u003e\",\"ImageAccordionItem\":\"$11a\",\"AccordionCTA\":\"$11c\",\"ContentType\":\"$11d\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\n118:{\"Id\":44191,\"GuidValue\":\"6345e5b9-e4c1-4722-b7a0-5d6754c0e7c6\",\"Expanded\":\"$119\"}\n117:{\"ContentLink\":\"$118\",\"DisplayOption\":\"\",\"Tag\":null}\n122:{}\n121:{\"Expanded\":\"$122\"}\n123:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\n124:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\n120:{\"Name\":\"How does DTCC help reduce settlement risk?\",\"AccordionHeader\":\"How does DTCC help reduce settlement risk?\",\"AccordionPanel\":\"\u003cp\u003eDTCC helps reduce settlement risk through centralized clearing, risk management, netting and automated settlement processes. These capabilities help decrease failed transactions, improve efficiency and support the timely completion of trades.\u003c/p\u003e\",\"ImageAccordionItem\":\"$121\",\"AccordionCTA\":\"$123\",\"ContentType\":\"$124\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\n11f:{\"Id\":44193,\"GuidValue\":\"ef199385-fad1-44ef-ace4-1e45b7012a8d\",\"E"])</script><script>self.__next_f.push([1,"xpanded\":\"$120\"}\n11e:{\"ContentLink\":\"$11f\",\"DisplayOption\":\"\",\"Tag\":null}\n129:{}\n128:{\"Expanded\":\"$129\"}\n12a:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\n12b:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\n127:{\"Name\":\"What does T+1 settlement mean?\",\"AccordionHeader\":\"What does T+1 settlement mean?\",\"AccordionPanel\":\"\u003cp\u003eT+1 means that most securities transactions settle one business day after the trade date. The shorter settlement cycle helps reduce risk exposure, improve operational efficiency and accelerate the movement of securities and cash through the marketplace.\u003c/p\u003e\",\"ImageAccordionItem\":\"$128\",\"AccordionCTA\":\"$12a\",\"ContentType\":\"$12b\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\n126:{\"Id\":44195,\"GuidValue\":\"c0a517a9-ed04-4fbc-b0ab-f08bdc5d3ddc\",\"Expanded\":\"$127\"}\n125:{\"ContentLink\":\"$126\",\"DisplayOption\":\"\",\"Tag\":null}\n130:{}\n12f:{\"Expanded\":\"$130\"}\n131:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\n132:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\n12e:{\"Name\":\"How does DTCC help firms manage market volume and volatility?\",\"AccordionHeader\":\"How does DTCC help firms manage market volume and volatility?\",\"AccordionPanel\":\"\u003cp\u003eDTCC's infrastructure is designed to support the demands of modern markets during both routine trading and periods of heightened activity. Centralized processing, automation and risk management tools help firms continue to operate efficiently as transaction volumes grow and market conditions change.\u0026nbsp;\u003c/p\u003e\",\"ImageAccordionItem\":\"$12f\",\"AccordionCTA\":\"$131\",\"ContentType\":\"$132\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\n12d:{\"Id\":44196,\"GuidValue\":\"86274b92-e09c-4447-bddd-7177d063dc99\",\"Expanded\":\"$12e\"}\n12c:{\"ContentLink\":\"$12d\",\"DisplayOption\":\"\",\"Tag\":null}\n137:{}\n136:{\"Expanded\":\"$137\"}\n138:{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}\n139:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"]\n135:{\"Name\":\"Why does market scale matter in clearing and settlement?\",\"A"])</script><script>self.__next_f.push([1,"ccordionHeader\":\"Why does market scale matter in clearing and settlement?\",\"AccordionPanel\":\"\u003cp\u003eScale enables clearing and settlement infrastructure to process large transaction volumes efficiently while creating benefits such as netting efficiencies, risk reduction and liquidity savings. By centralizing post-trade activity, DTCC helps firms achieve efficiencies that would be difficult to realize through bilateral processing alone.\u003c/p\u003e\",\"ImageAccordionItem\":\"$136\",\"AccordionCTA\":\"$138\",\"ContentType\":\"$139\",\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}\n134:{\"Id\":44198,\"GuidValue\":\"a2371c97-0a9a-4a7f-9624-c40f4b829d99\",\"Expanded\":\"$135\"}\n133:{\"ContentLink\":\"$134\",\"DisplayOption\":\"\",\"Tag\":null}\nf3:[\"$f4\",\"$fb\",\"$102\",\"$109\",\"$110\",\"$117\",\"$11e\",\"$125\",\"$12c\",\"$133\"]\n13a:[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionContainerBlock\"]\nef:{\"__typename\":\"AccordionContainerBlock\",\"JumpLinksTitle\":\"\",\"Theme\":\"light\",\"Name\":\"Frequently Asked Questions\",\"Subheading\":\"\",\"Heading\":\"Understanding DTCC Clearing Infrastructure \",\"Description\":\"\u003cp\u003eLearn more about the infrastructure that supports U.S. equities and fixed income markets.\u0026nbsp;\u003c/p\u003e\",\"OpenFirstAccordionByDefault\":true,\"ShowNumbers\":false,\"ImagePosition\":\"left\",\"OptionalImage\":\"$f0\",\"AccordionRows\":\"$f3\",\"ContentType\":\"$13a\",\"_id\":null,\"_concreteType\":\"AccordionContainerBlock\"}\nee:{\"Id\":42528,\"Expanded\":\"$ef\"}\n13c:{\"__typename\":\"FormContainerBlock\",\"JumpLinksTitle\":\"Contact Us\",\"Background\":\"light\",\"Subheading\":\"Get in Touch\",\"Heading\":\"Interested in learning more about our Clearing \u0026 Settlement Services?\",\"Description\":\"\u003cp\u003e\u003ca id=\\\"ContactUs\\\"\u003e\u003c/a\u003eComplete the form and a member of our team will contact you.\u0026nbsp;\u003c/p\u003e\\n\u003cp\u003eNeed support with a DTCC product or service you currently use? Please visit the \u003ca href=\\\"https://www.dtcc.com/support\\\" target=\\\"_top\\\"\u003eDTCC Client Center\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\",\"EmbeddedForm\":\"\u003cscript src=\\\"https://communications.dtcc.com/js/forms2/js/forms2.min.js\\\"\u003e\u003c/script\u003e\\n\u003cform id=\\\"mktoForm_8918\\\"\u003e\\n    \u003cdiv id=\\\"formPlaceholde"])</script><script>self.__next_f.push([1,"r\\\"\u003e\u0026nbsp;\u003c/div\u003e\\n\u003c/form\u003e\\n\u003cscript\u003eMktoForms2.loadForm(\\\"//communications.dtcc.com\\\", \\\"669-QIL-921\\\", 8918, function(form) {\\n    $(\\\"#formPlaceholder\\\").append(form.getFormElem());\\n    \\n    // Add an onSuccess handler\\n    form.onSuccess(function(values, followUpUrl) {\\n\\n        window.dataLayer = window.dataLayer || [];\\n\\n        window.dataLayer.push({\\n\\n            'event': 'formSubmission',\\n\\n           'formID': 'mktoForm_8918'\\n\\n        });\\n\\n    });\\n});\u003c/script\u003e\",\"_concreteType\":\"FormContainerBlock\"}\n13b:{\"Id\":57625,\"Expanded\":\"$13c\"}\n13d:[\"components/layout/MicrositeLayout.tsx -\u003e @/components/layout/Footer\"]\n"])</script><script>self.__next_f.push([1,"64:[\"$\",\"div\",null,{\"className\":\"flex min-h-screen flex-col justify-between\",\"children\":[[\"$\",\"$65\",null,{\"fallback\":null,\"children\":[[\"$\",\"$L66\",null,{\"moduleIds\":\"$6f\"}],[\"$\",\"$L67\",null,{\"data\":{\"HeaderLogoImage\":{\"Url\":\"https://cms-prod.dtcc.com/contentassets/a67be6b1ff964b2f839d6e4587e7d48d/dtcc-green-logo.svg\",\"Expanded\":{\"Url\":\"https://cms-prod.dtcc.com/contentassets/a67be6b1ff964b2f839d6e4587e7d48d/dtcc-green-logo.svg\",\"Alt\":\"DTCC-green-logo.svg\"}},\"NavigationMenuArea\":[{\"ContentLink\":{\"Expanded\":{\"_concreteType\":\"PrimaryNavigationBlock\",\"PrimaryItemLabel\":\"Products \u0026 Services\",\"ColumnsArea\":[{\"ContentLink\":{\"Id\":22996,\"Expanded\":{\"__typename\":\"NavigationTopItemBlock\",\"_concreteType\":\"NavigationTopItemBlock\",\"Link\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"Description\":\"\",\"Links\":[{\"ContentLink\":{\"Id\":22998,\"Expanded\":{\"Link\":{\"Href\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services\",\"Target\":null,\"Title\":null,\"Text\":\"Clearing \u0026 Settlement Services\"},\"Description\":\"\u003cp\u003eEvery day, we help keep the world\u0026rsquo;s financial markets moving. We process trillions of dollars in securities transactions daily and quadrillions annually, delivering the scale, resiliency and certainty market participants need as settlement cycles accelerate and automation expands.\u003c/p\u003e\",\"AutomateChildren\":false,\"ShowLinksInASubmenu\":true,\"Use2Columns\":false,\"Links\":[{\"ContentLink\":{\"Id\":2133,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/equities-clearing\",\"NavigationTitle\":\"Equities Clearing (NSCC)\",\"Name\":\"Equities Clearing (NSCC)\",\"ShortDescription\":\"Every trading day, clearing helps reduce risk, free up capital and keep markets running smoothly. DTCC’s National Securities Clearing Corporation (NSCC) combines millions of transactions into fewer, simpler obligations, making them easier and less costly for firms to manage.\"}}},{\"ContentLink\":{\"Id\":2151,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/equities-settlement\",\"NavigationTitle\":\"Equities Settlement (DTC)\",\"Name\":\"Equities Settlement (DTC)\",\"ShortDescription\":\"Once a trade is cleared, settlement makes it final. Every day, we help move securities and payments between market participants, completing transactions safely, efficiently and at scale. \"}}},{\"ContentLink\":{\"Id\":43110,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/fixed-income-clearing-corporation-ficc\",\"NavigationTitle\":\"Fixed Income Clearing (FICC)\",\"Name\":\"Fixed Income Clearing (FICC)\",\"ShortDescription\":\"For more than 40 years, Fixed Income Clearing Corporation (FICC) has helped market participants manage risk, improve efficiency and support liquidity across the U.S. Treasury and agency mortgage-backed securities markets through trusted clearing and post-trade infrastructure.\"}}}],\"ChildrenLinks\":[],\"CalloutCardsArea\":[]}}},{\"ContentLink\":{\"Id\":22997,\"Expanded\":{\"Link\":{\"Href\":\"https://www.dtcc.com/products-and-services/trade-processing-solutions\",\"Target\":null,\"Title\":null,\"Text\":\"Trade Processing Solutions\"},\"Description\":\"\u003cp\u003eManaging post-trade activity across markets, counterparties and asset classes requires seamless connectivity and automation. Our trade processing solutions connect buy-side, sell-side and custodian firms across 85 markets, helping reduce operational complexity, streamline workflows and improve post-trade efficiency.\u003c/p\u003e\",\"AutomateChildren\":false,\"ShowLinksInASubmenu\":true,\"Use2Columns\":null,\"Links\":[{\"ContentLink\":{\"Id\":24624,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/trade-processing-solutions/ctm\",\"NavigationTitle\":\"Trade Allocation \u0026 Matching: CTM®\",\"Name\":\"Trade Allocation and Matching: CTM®\",\"ShortDescription\":\"Secure, resilient trade allocation, confirmation and matching, with flexible functionality tailored to your needs.\"}}},{\"ContentLink\":{\"Id\":24907,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/trade-processing-solutions/alert\",\"NavigationTitle\":\"SSI Management: ALERT®\",\"Name\":\"SSI Management: ALERT®\",\"ShortDescription\":\"Reduce settlement risk and eliminate inefficiencies with automated Standing Settlement Instruction (SSI) management.\"}}},{\"ContentLink\":{\"Id\":24864,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/trade-processing-solutions/tradesuite-id\",\"NavigationTitle\":\"Trade Affirmation: TradeSuite ID®\",\"Name\":\"Trade Affirmation: TradeSuite ID®\",\"ShortDescription\":\"Trade affirmation between counterparties for DTC-eligible securities, with optional archival services and analytics.\"}}}],\"ChildrenLinks\":[],\"CalloutCardsArea\":[{\"ContentLink\":{\"Id\":48732,\"Expanded\":{\"__typename\":\"NavCalloutCardBlock\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/critical_role_of_ssis.jpg/Zz02ZTFmYTg0YWE2ZWExMWYxYmUzNWI2NTViNWE5ODkwMA==\",\"Alt\":\"critical_role_of_ssis.jpg\",\"Category\":[]}},\"Title\":\"The Critical Role of SSIs\",\"Description\":\"Industry experts joined us for an interactive webinar to discuss the importance of SSIs for T+1 readiness.\",\"Link\":{\"Href\":\"https://www.dtcc.com/initiatives/accelerated-settlement/t1-in-europe-the-critical-role-of-ssis\",\"Target\":null,\"Title\":null,\"Text\":\"T+1 in Europe: The Critical Role of SSIs\"},\"Theme\":\"light-green\"}}},{\"ContentLink\":{\"Id\":48733,\"Expanded\":{\"__typename\":\"NavCalloutCardBlock\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/accelerated-settlement-thumbnail/Zz1mN2I2Yzg0ZTM2OTkxMWYwYWY4NTVlMDlmYjY1ZWNjNw==\",\"Alt\":\"accelerated-settlement-thumbnail\",\"Category\":[]}},\"Title\":\"Europe T+1\",\"Description\":\"Europe’s transition to T+1 settlement is underway. Get ready with insights, data and expertise.\",\"Link\":{\"Href\":\"https://www.dtcc.com/initiatives/accelerated-settlement/europe-t1\",\"Target\":null,\"Title\":null,\"Text\":\"Europe T+1\"},\"Theme\":\"light-green\"}}}]}}},{\"ContentLink\":{\"Id\":24971,\"Expanded\":{\"Link\":{\"Href\":\"https://www.dtcc.com/products-and-services/digital-assets\",\"Target\":null,\"Title\":null,\"Text\":\"Digital Assets\"},\"Description\":\"\u003cp\u003eAs digital assets continue to reshape capital markets, institutional adoption depends on interoperability, governance and confidence. We are helping connect traditional market infrastructure with emerging digital ecosystems, supporting the efficient movement of value across evolving financial networks.\u003c/p\u003e\",\"AutomateChildren\":false,\"ShowLinksInASubmenu\":true,\"Use2Columns\":null,\"Links\":[{\"ContentLink\":{\"Id\":42465,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/digital-assets/tokenization\",\"NavigationTitle\":\"DTCC Tokenization Service\",\"Name\":\"DTCC Tokenization Service\",\"ShortDescription\":\"Connects traditional and digital markets through trusted infrastructure and approved networks enabling greater capital efficiency, increasing asset mobility and supporting institutional-scale adoption.\"}}},{\"ContentLink\":{\"Id\":5786,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/digital-assets/composerx\",\"NavigationTitle\":\"DTCC ComposerX™\",\"Name\":\"DTCC ComposerX™\",\"ShortDescription\":\"Provides firms with a unified platform to create, manage and monitor digital assets, while reducing operational handoffs and supporting digital asset activity throughout the asset lifecycle.\"}}},{\"ContentLink\":{\"Id\":5787,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/digital-assets/collateral-appchain\",\"NavigationTitle\":\"DTCC Collateral AppChain \",\"Name\":\"DTCC Collateral AppChain\",\"ShortDescription\":\"Supports collateral mobility by enabling firms to access and deploy assets more effectively, enhancing efficiency and responsiveness to market demands.\"}}},{\"ContentLink\":{\"Id\":5785,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/digital-assets/launchpad\",\"NavigationTitle\":\"DTCC Digital Launchpad\",\"Name\":\"DTCC Digital Launchpad\",\"ShortDescription\":\"Brings market participants together to explore new ideas, develop practical solutions and advance digital asset adoption through industry collaboration.\"}}}],\"ChildrenLinks\":[],\"CalloutCardsArea\":[{\"ContentLink\":{\"Id\":44212,\"Expanded\":{\"__typename\":\"NavCalloutCardBlock\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/DTCC_Initiatives_Tokenization_r1.jpg/Zz1hMzgyM2QwNjhmNzgxMWYxODJlYzhlMWM3ODdlMzI5ZA==\",\"Alt\":\"DTCC_Initiatives_Tokenization_r1.jpg\",\"Category\":[]}},\"Title\":\"Tokenization Becomes a Reality\",\"Description\":\"Tokenization is moving beyond theory and into real-world application as clients leverage live trading environments.\",\"Link\":{\"Href\":\"https://www.dtcc.com/press-releases/2026/dtcc-turns-tokenization-into-reality\",\"Target\":null,\"Title\":null,\"Text\":\"Tokenization Becomes a Reality\"},\"Theme\":\"light-green\"}}},{\"ContentLink\":{\"Id\":68512,\"Expanded\":{\"__typename\":\"NavCalloutCardBlock\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/the-connective-tissue-of-digital-finance-white-paper-thumbnail.png/Zz1lNjZjZWI3Y2JiNGExMWYxODc1NjVlMDY4ZTVkYjJlMg==\",\"Alt\":\"the-connective-tissue-of-digital-finance-white-paper-thumbnail.png\",\"Category\":[]}},\"Title\":\"The Connective Tissue of Digital Finance\",\"Description\":\"Co-authored with Citi and Swift, this white paper explores interoperability, programmability and the foundations for scale\",\"Link\":{\"Href\":\"https://files.dtcc.com/download/assets/The+Connective+Tissue+of+Digital+Finance/d84d5678b79211f18b07268987ca867a\",\"Target\":\"_blank\",\"Title\":null,\"Text\":\"Learn More\"},\"Theme\":\"light-green\"}}}]}}},{\"ContentLink\":{\"Id\":22999,\"Expanded\":{\"Link\":{\"Href\":\"https://www.dtcc.com/products-and-services/asset-services\",\"Target\":null,\"Title\":null,\"Text\":\"Asset Services\"},\"Description\":\"\u003cp\u003eFrom issuance through ongoing servicing, securities depend on a network of participants, data and processes. We connect issuers, agents, financial intermediaries and investors, supporting the communication and operational activities that underpin the lifecycle of virtually all U.S. securities.\u003c/p\u003e\",\"AutomateChildren\":false,\"ShowLinksInASubmenu\":true,\"Use2Columns\":null,\"Links\":[{\"ContentLink\":{\"Id\":1557,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/asset-services/agent-services\",\"NavigationTitle\":\"Agent Services\",\"Name\":\"Agent Services\",\"ShortDescription\":\"Gives transfer agents a central way to become DTC-eligible and use DTC programs. \"}}},{\"ContentLink\":{\"Id\":1554,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/asset-services/corporate-actions-processing\",\"NavigationTitle\":\"Corporate Actions Processing\",\"Name\":\"Corporate Actions Processing\",\"ShortDescription\":\"Manages announcements, elections, payments and reporting across the lifecycle of an event. \"}}},{\"ContentLink\":{\"Id\":1556,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/asset-services/global-tax-services\",\"NavigationTitle\":\"Global Tax Services\",\"Name\":\"Global Tax Services\",\"ShortDescription\":\"Simplifies tax relief, withholding, reporting and compliance for domestic and cross-border activities. \"}}},{\"ContentLink\":{\"Id\":1553,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/asset-services/issuer-services\",\"NavigationTitle\":\"Issuer Services\",\"Name\":\"Issuer Services\",\"ShortDescription\":\"Gives issuers a centralized place to communicate with shareholders and access useful information. \"}}},{\"ContentLink\":{\"Id\":1555,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/asset-services/securities-processing\",\"NavigationTitle\":\"Securities Processing\",\"Name\":\"Securities Processing\",\"ShortDescription\":\"Helps firms hold, move and manage physical and electronic securities. \"}}},{\"ContentLink\":{\"Id\":1552,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/asset-services/underwriting\",\"NavigationTitle\":\"Underwriting\",\"Name\":\"Underwriting\",\"ShortDescription\":\"Helps new and existing securities enter DTC so they can be distributed and settled efficiently. \"}}}],\"ChildrenLinks\":[],\"CalloutCardsArea\":[{\"ContentLink\":{\"Id\":65887,\"Expanded\":{\"__typename\":\"NavCalloutCardBlock\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/dtcc-frank-lasalla-why-market-infra.jpg/Zz1mMzMxY2U4MDhmODYxMWYxYjJhYTMyYjdhMzI1MGFiYQ==\",\"Alt\":\"dtcc-frank-lasalla-why-market-infra.jpg\",\"Category\":[]}},\"Title\":\"Why Market Infrastructure Still Matters\",\"Description\":\"On the heels of SpaceX's historic IPO, DTCC CEO Frank La Salla shares the important industry role we play as a trusted industry steward and strategic partner.\",