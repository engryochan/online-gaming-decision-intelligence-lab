268-75350e7d2ee5d6e1.js?dpl=dpl_DWFSX423ndjNSgqMwL7gmzW2vk3v\",\"7255\",\"static/chunks/7255-f2f14d17465c9676.js?dpl=dpl_DWFSX423ndjNSgqMwL7gmzW2vk3v\",\"7246\",\"static/chunks/7246-341d5f973f23f3c9.js?dpl=dpl_DWFSX423ndjNSgqMwL7gmzW2vk3v\",\"4759\",\"static/chunks/4759-3e924e21cce128da.js?dpl=dpl_DWFSX423ndjNSgqMwL7gmzW2vk3v\",\"8918\",\"static/chunks/8918-3a2ca1c301d39444.js?dpl=dpl_DWFSX423ndjNSgqMwL7gmzW2vk3v\",\"2330\",\"static/chunks/2330-dfb3d6bce3686798.js?dpl=dpl_DWFSX423ndjNSgqMwL7gmzW2vk3v\",\"9160\",\"static/chunks/app/not-found-3aaf2146be74df73.js?dpl=dpl_DWFSX423ndjNSgqMwL7gmzW2vk3v\"],\"FooterRegions\"]\n"])</script><script>self.__next_f.push([1,"20:[\"$\",\"div\",null,{\"className\":\"flex min-h-screen flex-col justify-between\",\"children\":[[\"$\",\"$65\",null,{\"fallback\":null,\"children\":[[\"$\",\"$L66\",null,{\"moduleIds\":[\"components/layout/MicrositeLayout.tsx -\u003e @/components/layout/Header\"]}],[\"$\",\"$L67\",null,{\"data\":{\"HeaderLogoImage\":{\"Url\":\"https://cms-prod.dtcc.com/contentassets/a67be6b1ff964b2f839d6e4587e7d48d/dtcc-green-logo.svg\",\"Expanded\":{\"Url\":\"https://cms-prod.dtcc.com/contentassets/a67be6b1ff964b2f839d6e4587e7d48d/dtcc-green-logo.svg\",\"Alt\":\"DTCC-green-logo.svg\"}},\"NavigationMenuArea\":[{\"ContentLink\":{\"Expanded\":{\"_concreteType\":\"PrimaryNavigationBlock\",\"PrimaryItemLabel\":\"Products \u0026 Services\",\"ColumnsArea\":[{\"ContentLink\":{\"Id\":22996,\"Expanded\":{\"__typename\":\"NavigationTopItemBlock\",\"_concreteType\":\"NavigationTopItemBlock\",\"Link\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"Description\":\"\",\"Links\":[{\"ContentLink\":{\"Id\":22998,\"Expanded\":{\"Link\":{\"Href\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services\",\"Target\":null,\"Title\":null,\"Text\":\"Clearing \u0026 Settlement Services\"},\"Description\":\"\u003cp\u003eEvery day, we help keep the world\u0026rsquo;s financial markets moving. We process trillions of dollars in securities transactions daily and quadrillions annually, delivering the scale, resiliency and certainty market participants need as settlement cycles accelerate and automation expands.\u003c/p\u003e\",\"AutomateChildren\":false,\"ShowLinksInASubmenu\":true,\"Use2Columns\":false,\"Links\":[{\"ContentLink\":{\"Id\":2133,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/equities-clearing\",\"NavigationTitle\":\"Equities Clearing (NSCC)\",\"Name\":\"Equities Clearing (NSCC)\",\"ShortDescription\":\"Every trading day, clearing helps reduce risk, free up capital and keep markets running smoothly. DTCC’s National Securities Clearing Corporation (NSCC) combines millions of transactions into fewer, simpler obligations, making them easier and less costly for firms to manage.\"}}},{\"ContentLink\":{\"Id\":2151,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/equities-settlement\",\"NavigationTitle\":\"Equities Settlement (DTC)\",\"Name\":\"Equities Settlement (DTC)\",\"ShortDescription\":\"Once a trade is cleared, settlement makes it final. Every day, we help move securities and payments between market participants, completing transactions safely, efficiently and at scale. \"}}},{\"ContentLink\":{\"Id\":43110,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/fixed-income-clearing-corporation-ficc\",\"NavigationTitle\":\"Fixed Income Clearing (FICC)\",\"Name\":\"Fixed Income Clearing (FICC)\",\"ShortDescription\":\"For more than 40 years, Fixed Income Clearing Corporation (FICC) has helped market participants manage risk, improve efficiency and support liquidity across the U.S. Treasury and agency mortgage-backed securities markets through trusted clearing and post-trade infrastructure.\"}}}],\"ChildrenLinks\":[],\"CalloutCardsArea\":[]}}},{\"ContentLink\":{\"Id\":22997,\"Expanded\":{\"Link\":{\"Href\":\"https://www.dtcc.com/products-and-services/trade-processing-solutions\",\"Target\":null,\"Title\":null,\"Text\":\"Trade Processing Solutions\"},\"Description\":\"\u003cp\u003eManaging post-trade activity across markets, counterparties and asset classes requires seamless connectivity and automation. Our trade processing solutions connect buy-side, sell-side and custodian firms across 85 markets, helping reduce operational complexity, streamline workflows and improve post-trade efficiency.\u003c/p\u003e\",\"AutomateChildren\":false,\"ShowLinksInASubmenu\":true,\"Use2Columns\":null,\"Links\":[{\"ContentLink\":{\"Id\":24624,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/trade-processing-solutions/ctm\",\"NavigationTitle\":\"Trade Allocation \u0026 Matching: CTM®\",\"Name\":\"Trade Allocation and Matching: CTM®\",\"ShortDescription\":\"Secure, resilient trade allocation, confirmation and matching, with flexible functionality tailored to your needs.\"}}},{\"ContentLink\":{\"Id\":24907,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/trade-processing-solutions/alert\",\"NavigationTitle\":\"SSI Management: ALERT®\",\"Name\":\"SSI Management: ALERT®\",\"ShortDescription\":\"Reduce settlement risk and eliminate inefficiencies with automated Standing Settlement Instruction (SSI) management.\"}}},{\"ContentLink\":{\"Id\":24864,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/trade-processing-solutions/tradesuite-id\",\"NavigationTitle\":\"Trade Affirmation: TradeSuite ID®\",\"Name\":\"Trade Affirmation: TradeSuite ID®\",\"ShortDescription\":\"Trade affirmation between counterparties for DTC-eligible securities, with optional archival services and analytics.\"}}}],\"ChildrenLinks\":[],\"CalloutCardsArea\":[{\"ContentLink\":{\"Id\":48732,\"Expanded\":{\"__typename\":\"NavCalloutCardBlock\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/critical_role_of_ssis.jpg/Zz02ZTFmYTg0YWE2ZWExMWYxYmUzNWI2NTViNWE5ODkwMA==\",\"Alt\":\"critical_role_of_ssis.jpg\",\"Category\":[]}},\"Title\":\"The Critical Role of SSIs\",\"Description\":\"Industry experts joined us for an interactive webinar to discuss the importance of SSIs for T+1 readiness.\",\"Link\":{\"Href\":\"https://www.dtcc.com/initiatives/accelerated-settlement/t1-in-europe-the-critical-role-of-ssis\",\"Target\":null,\"Title\":null,\"Text\":\"T+1 in Europe: The Critical Role of SSIs\"},\"Theme\":\"light-green\"}}},{\"ContentLink\":{\"Id\":48733,\"Expanded\":{\"__typename\":\"NavCalloutCardBlock\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/accelerated-settlement-thumbnail/Zz1mN2I2Yzg0ZTM2OTkxMWYwYWY4NTVlMDlmYjY1ZWNjNw==\",\"Alt\":\"accelerated-settlement-thumbnail\",\"Category\":[]}},\"Title\":\"Europe T+1\",\"Description\":\"Europe’s transition to T+1 settlement is underway. Get ready with insights, data and expertise.\",\"Link\":{\"Href\":\"https://www.dtcc.com/initiatives/accelerated-settlement/europe-t1\",\"Target\":null,\"Title\":null,\"Text\":\"Europe T+1\"},\"Theme\":\"light-green\"}}}]}}},{\"ContentLink\":{\"Id\":24971,\"Expanded\":{\"Link\":{\"Href\":\"https://www.dtcc.com/products-and-services/digital-assets\",\"Target\":null,\"Title\":null,\"Text\":\"Digital Assets\"},\"Description\":\"\u003cp\u003eAs digital assets continue to reshape capital markets, institutional adoption depends on interoperability, governance and confidence. We are helping connect traditional market infrastructure with emerging digital ecosystems, supporting the efficient movement of value across evolving financial networks.\u003c/p\u003e\",\"AutomateChildren\":false,\"ShowLinksInASubmenu\":true,\"Use2Columns\":null,\"Links\":[{\"ContentLink\":{\"Id\":42465,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/digital-assets/tokenization\",\"NavigationTitle\":\"DTCC Tokenization Service\",\"Name\":\"DTCC Tokenization Service\",\"ShortDescription\":\"Connects traditional and digital markets through trusted infrastructure and approved networks enabling greater capital efficiency, increasing asset mobility and supporting institutional-scale adoption.\"}}},{\"ContentLink\":{\"Id\":5786,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/digital-assets/composerx\",\"NavigationTitle\":\"DTCC ComposerX™\",\"Name\":\"DTCC ComposerX™\",\"ShortDescription\":\"Provides firms with a unified platform to create, manage and monitor digital assets, while reducing operational handoffs and supporting digital asset activity throughout the asset lifecycle.\"}}},{\"ContentLink\":{\"Id\":5787,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/digital-assets/collateral-appchain\",\"NavigationTitle\":\"DTCC Collateral AppChain \",\"Name\":\"DTCC Collateral AppChain\",\"ShortDescription\":\"Supports collateral mobility by enabling firms to access and deploy assets more effectively, enhancing efficiency and responsiveness to market demands.\"}}},{\"ContentLink\":{\"Id\":5785,\"Expanded\":{\"Url\":\"https://www.dtcc.com/products-and-services/digital-assets/launchpad\",\"NavigationTitle\":\"DTCC Digital Launchpad\",\"Name\":\"DTCC Digital Launchpad\",\"ShortDescription\":\"Brings market participants together to explore new ideas, develop practical solutions and advance digital asset adoption through industry collaboration.\"}}}],\"ChildrenLinks\":[],\"CalloutCardsArea\":[{\"ContentLink\":{\"Id\":44212,\"Expanded\":{\"__typename\":\"NavCalloutCardBlock\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/DTCC_Initiatives_Tokenization_r1.jpg/Zz1hMzgyM2QwNjhmNzgxMWYxODJlYzhlMWM3ODdlMzI5ZA==\",\"Alt\":\"DTCC_Initiatives_Tokenization_r1.jpg\",\"Category\":[]}},\"Title\":\"Tokenization Becomes a Reality\",\"Description\":\"Tokenization is moving beyond theory and into real-world application as clients leverage live trading environments.\",\"Link\":{\"Href\":\"https://www.dtcc.com/press-releases/2026/dtcc-turns-tokenization-into-reality