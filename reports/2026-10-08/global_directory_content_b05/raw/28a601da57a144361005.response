ooter/social-icons/fb-icon.svg\",\"alt\":\"fb\",\"width\":24,\"height\":24,\"className\":\"footer__social-icon\",\"unoptimized\":true}]}]}],[\"$\",\"li\",\"4\",{\"children\":[\"$\",\"$L6c\",null,{\"href\":\"https://www.youtube.com/c/thedtcc1973\",\"target\":\"_self\",\"rel\":\"$undefined\",\"className\":\"footer__social-link\",\"aria-label\":\"Visit our yt page\",\"children\":[\"$\",\"$L6d\",null,{\"src\":\"https://cms-prod.dtcc.com/globalassets/global/footer/social-icons/yt-icon.svg\",\"alt\":\"yt\",\"width\":24,\"height\":24,\"className\":\"footer__social-icon\",\"unoptimized\":true}]}]}],[\"$\",\"li\",\"5\",{\"children\":[\"$\",\"$L6c\",null,{\"href\":\"https://www.dtcc.com/rss-feeds\",\"target\":\"_self\",\"rel\":\"$undefined\",\"className\":\"footer__social-link\",\"aria-label\":\"Visit our rss-feed page\",\"children\":[\"$\",\"$L6d\",null,{\"src\":\"https://cms-prod.dtcc.com/globalassets/global/footer/social-icons/rss.svg\",\"alt\":\"rss-feed\",\"width\":24,\"height\":24,\"className\":\"footer__social-icon\",\"unoptimized\":true}]}]}]]}]]}]]}]}]]}]]}]\n"])</script><script>self.__next_f.push([1,"13e:Tff8,"])</script><script>self.__next_f.push([1,"{\"@type\":\"FAQPage\",\"@context\":\"https://schema.org\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What markets does DTCC support?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eDTCC supports critical U.S. financial markets through its clearing and settlement subsidiaries, including equities, U.S. Treasuries, agency securities and mortgage-backed securities (MBS).\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What is the role of clearing in financial markets?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eClearing helps ensure that trades are accurately matched, validated and prepared for settlement. By centralizing post-trade processing and risk management, clearing reduces uncertainty and helps markets operate more smoothly.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What is the difference between clearing and settlement?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eClearing is the process of validating trades, managing risk and determining each party's obligations. Settlement is the final exchange of securities and cash that completes the transaction. Together, they help ensure trades are completed accurately and efficiently.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"Why is central clearing important?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eCentral clearing helps reduce counterparty risk by placing a central counterparty (CCP) between buyers and sellers. This helps improve transparency, strengthen market resilience and promote confidence in financial markets.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What is a central counterparty (CCP)?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eA central counterparty (CCP) stands between trading counterparties and becomes the buyer to every seller and the seller to every buyer. By managing risk centrally, CCPs help promote market stability and ensure eligible transactions are completed even during periods of market stress.\u0026nbsp;\\u003cbr /\u003e\u0026nbsp;\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"How does multilateral netting improve capital and liquidity efficiency?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eMultilateral netting consolidates many trading obligations into a smaller number of net settlement positions. This reduces the number and value of transactions that must be settled, helping firms lower funding needs and use capital and liquidity more efficiently.\u0026nbsp;\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"How does DTCC help reduce settlement risk?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eDTCC helps reduce settlement risk through centralized clearing, risk management, netting and automated settlement processes. These capabilities help decrease failed transactions, improve efficiency and support the timely completion of trades.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What does T+1 settlement mean?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eT+1 means that most securities transactions settle one business day after the trade date. The shorter settlement cycle helps reduce risk exposure, improve operational efficiency and accelerate the movement of securities and cash through the marketplace.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"How does DTCC help firms manage market volume and volatility?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eDTCC's infrastructure is designed to support the demands of modern markets during both routine trading and periods of heightened activity. Centralized processing, automation and risk management tools help firms continue to operate efficiently as transaction volumes grow and market conditions change.\u0026nbsp;\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"Why does market scale matter in clearing and settlement?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eScale enables clearing and settlement infrastructure to process large transaction volumes efficiently while creating benefits such as netting efficiencies, risk reduction and liquidity savings. By centralizing post-trade activity, DTCC helps firms achieve efficiencies that would be difficult to realize through bilateral processing alone.\\u003c/p\u003e\"}}]}"])</script><script>self.__next_f.push([1,"13f:Tff8,"])</script><script>self.__next_f.push([1,"{\"@type\":\"FAQPage\",\"@context\":\"https://schema.org\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What markets does DTCC support?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eDTCC supports critical U.S. financial markets through its clearing and settlement subsidiaries, including equities, U.S. Treasuries, agency securities and mortgage-backed securities (MBS).\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What is the role of clearing in financial markets?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eClearing helps ensure that trades are accurately matched, validated and prepared for settlement. By centralizing post-trade processing and risk management, clearing reduces uncertainty and helps markets operate more smoothly.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What is the difference between clearing and settlement?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eClearing is the process of validating trades, managing risk and determining each party's obligations. Settlement is the final exchange of securities and cash that completes the transaction. Together, they help ensure trades are completed accurately and efficiently.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"Why is central clearing important?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eCentral clearing helps reduce counterparty risk by placing a central counterparty (CCP) between buyers and sellers. This helps improve transparency, strengthen market resilience and promote confidence in financial markets.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What is a central counterparty (CCP)?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eA central counterparty (CCP) stands between trading counterparties and becomes the buyer to every seller and the seller to every buyer. By managing risk centrally, CCPs help promote market stability and ensure eligible transactions are completed even during periods of market stress.\u0026nbsp;\\u003cbr /\u003e\u0026nbsp;\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"How does multilateral netting improve capital and liquidity efficiency?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eMultilateral netting consolidates many trading obligations into a smaller number of net settlement positions. This reduces the number and value of transactions that must be settled, helping firms lower funding needs and use capital and liquidity more efficiently.\u0026nbsp;\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"How does DTCC help reduce settlement risk?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eDTCC helps reduce settlement risk through centralized clearing, risk management, netting and automated settlement processes. These capabilities help decrease failed transactions, improve efficiency and support the timely completion of trades.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"What does T+1 settlement mean?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eT+1 means that most securities transactions settle one business day after the trade date. The shorter settlement cycle helps reduce risk exposure, improve operational efficiency and accelerate the movement of securities and cash through the marketplace.\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"How does DTCC help firms manage market volume and volatility?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eDTCC's infrastructure is designed to support the demands of modern markets during both routine trading and periods of heightened activity. Centralized processing, automation and risk management tools help firms continue to operate efficiently as transaction volumes grow and market conditions change.\u0026nbsp;\\u003c/p\u003e\"}},{\"@type\":\"Question\",\"name\":\"Why does market scale matter in clearing and settlement?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"\\u003cp\u003eScale enables clearing and settlement infrastructure to process large transaction volumes efficiently while creating benefits such as netting efficiencies, risk reduction and liquidity savings. By centralizing post-trade activity, DTCC helps firms achieve efficiencies that would be difficult to realize through bilateral processing alone.\\u003c/p\u003e\"}}]}"])</script><script>self.__next_f.push([1,"70:[[\"$\",\"$L13\",\"{\\\"@type\\\":\\\"Organization\\\",\\\"@context\\\":\\\"https://schema.org\\\",\\\"name\\\":\\\"DTCC\\\",\\\"alternateName\\\":\\\"Depository Trust \u0026 Clearing Corporation\\\",\\\"url\\\":\\\"www.dtcc.com\\\",\\\"logo\\\":\\\"www.dtcc.com/dtcc-logo-desktop\\\"}\",{\"id\":\"structured-data-0\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@type\\\":\\\"Organization\\\",\\\"@context\\\":\\\"https://schema.org\\\",\\\"name\\\":\\\"DTCC\\\",\\\"alternateName\\\":\\\"Depository Trust \u0026 Clearing Corporation\\\",\\\"url\\\":\\\"www.dtcc.com\\\",\\\"logo\\\":\\\"www.dtcc.com/dtcc-logo-desktop\\\"}\"}}],[\"$\",\"$L13\",\"{\\\"@type\\\":\\\"WebSite\\\",\\\"@context\\\":\\\"https://schema.org\\\",\\\"name\\\":\\\"DTCC\\\",\\\"url\\\":\\\"www.dtcc.com\\\",\\\"potentialAction\\\":{\\\"@type\\\":\\\"SearchAction\\\",\\\"target\\\":\\\"www.dtcc.com/search?q={search_term_string}\\\",\\\"query-input\\\":\\\"required name=search_term_string\\\"}}\",{\"id\":\"structured-data-1\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@type\\\":\\\"WebSite\\\",\\\"@context\\\":\\\"https://schema.org\\\",\\\"name\\\":\\\"DTCC\\\",\\\"url\\\":\\\"www.dtcc.com\\\",\\\"potentialAction\\\":{\\\"@type\\\":\\\"SearchAction\\\",\\\"target\\\":\\\"www.dtcc.com/search?q={search_term_string}\\\",\\\"query-input\\\":\\\"required name=search_term_string\\\"}}\"}}],[\"$\",\"$L13\",\"{\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"@context\\\":\\\"https://schema.org\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"item\\\":{\\\"@id\\\":\\\"https://www.dtcc.com/\\\",\\\"name\\\":\\\"Home\\\"}},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"item\\\":{\\\"@id\\\":\\\"https://www.dtcc.com/products-and-services\\\",\\\"name\\\":\\\"Products \u0026 Services\\\"}},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"item\\\":{\\\"@id\\\":\\\"https://www.dtcc.com/products-and-services/clearing-settlement-services\\\",\\\"name\\\":\\\"Clearing \u0026 Settlement Services \\\"}}]}\",{\"id\":\"structured-data-2\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"@context\\\":\\\"https://schema.org\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"item\\\":{\\\"@id\\\":\\\"https://www.dtcc.com/\\\",\\\"name\\\":\\\"Home\\\"}},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"item\\\":{\\\"@id\\\":\\\"https://www.dtcc.com/products-and-services\\\",\\\"name\\\":\\\"Products \u0026 Services\\\"}},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"item\\\":{\\\"@id\\\":\\\"https://www.dtcc.com/products-and-services/clearing-settlement-services\\\",\\\"name\\\":\\\"Clearing \u0026 Settlement Services \\\"}}]}\"}}],[\"$\",\"$L13\",\"$13e\",{\"id\":\"structured-data-3\",\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$13f\"}}]]\n"])</script></body></html>