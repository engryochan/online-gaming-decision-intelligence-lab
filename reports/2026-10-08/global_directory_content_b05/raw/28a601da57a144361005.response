{\"ContentLink\":{\"Expanded\":{\"Text\":\"Services\"}}}]}}]]}],[\"$\",\"main\",null,{\"id\":\"main\",\"tabIndex\":-1,\"className\":\"grow scroll-mt-24 outline-offset-2\",\"children\":[false,[[\"$\",\"$65\",null,{\"fallback\":null,\"children\":\"$L70\"}],[\"$\",\"$L69\",null,{\"filteredBreadcrumbs\":[{\"Text\":\"Home\",\"Url\":\"https://www.dtcc.com/\"},{\"Text\":\"Products \u0026 Services\",\"Url\":\"https://www.dtcc.com/products-and-services\"},{\"Text\":\"Clearing \u0026 Settlement Services \",\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services\"}]}],[\"$\",\"div\",null,{\"data-test\":\"masthead-wrapper\",\"children\":[\"$\",\"$L6a\",null,{\"masthead\":[{\"ContentLink\":{\"Id\":39852,\"GuidValue\":\"44f99b07-38d3-47ea-8df4-e86904b727b7\",\"Expanded\":{\"__typename\":\"SubpageMastheadBlock\",\"Heading\":\"Clearing \u0026 Settlement Services\",\"HideBreadcrumbs\":null,\"Description\":\"Every day, DTCC helps keep the world's financial markets moving. We process trillions of dollars in securities transactions daily and quadrillions annually, delivering the scale, resiliency and certainty market participants need as settlement cycles accelerate and automation expands.\",\"TopNavigationMenu\":[],\"DesktopImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/Clearing%26Settlement_Masthead_r1.jpg/Zz1jMjc5NmQ4NjhkMGUxMWYxYTU5MzQyYmFkNzI2NTVlYQ==\",\"Alt\":\"Clearing\u0026Settlement_Masthead_r1.jpg\",\"Category\":[]}},\"DesktopVideo\":{\"Expanded\":{}},\"MobileImage\":{\"Expanded\":{}},\"MobileVideo\":{\"Expanded\":{}},\"MediaOpacity\":100,\"BackgroundMediaTheme\":\"dark\",\"NoBackgroundMediaTheme\":\"light\",\"BannerHeight\":\"small\",\"Cta\":{\"Href\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services#ContactUs\",\"Target\":null,\"Title\":\"Contact Us\",\"Text\":\"Contact Us\"},\"EmbedVideoDetailPage\":{\"Expanded\":{}},\"EmbedVideoId\":\"\",\"EmbedVideoTitle\":\"\",\"EmbedVideoPlatform\":null,\"EmbedVideoThumbnail\":{\"Expanded\":{}},\"ShowWatchVideoButton\":null,\"WatchVideoButtonLabel\":\"\",\"VideoDurationDisplay\":\"\",\"BadgeEyebrow\":\"\",\"BadgeLink\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"SubpageMastheadBlock\"],\"_id\":null,\"_concreteType\":\"SubpageMastheadBlock\"}},\"DisplayOption\":\"\",\"Tag\":null}]}]}],false,[\"$\",\"$L71\",null,{\"content\":{\"ContentLink\":{\"Id\":2132,\"GuidValue\":\"c41255f5-c150-41fa-91af-760f232aabf9\"},\"Name\":\"Clearing \u0026 Settlement Services\",\"RelativePath\":\"/products-and-services/clearing-settlement-services\",\"ContentType\":[\"FoundationPageData\",\"PageData\",\"ContentData\",\"IFoundationContent\",\"Page\",\"ProductAndServicesCategoryPage\",\"Content\"],\"Status\":\"Published\",\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services\",\"_id\":\"c41255f5-c150-41fa-91af-760f232aabf9_en_Published\",\"_concreteType\":\"ProductAndServicesCategoryPage\",\"Masthead\":[{\"ContentLink\":\"$72\",\"DisplayOption\":\"\",\"Tag\":null}],\"ProductServicesName\":\"Clearing \u0026 Settlement Services\",\"Description\":\"\u003cp\u003eEvery day, DTCC helps keep the world's financial markets moving. We process trillions of dollars in securities transactions daily and quadrillions annually, delivering the scale, resiliency and certainty market participants need as settlement cycles accelerate and automation expands.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\",\"ProductServicesLinksArea\":[],\"GeneratePageBreadcrumbs\":\"$85\",\"ShowBackToTopButton\":null,\"NavigationTitle\":\"Clearing \u0026 Settlement Services \",\"BrowserTitle\":\"Clearing \u0026 Settlement Services | DTCC\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/DTCC_EC_Review_Website_Images-10.jpg/Zz0xNDFhM2JhMDhjM2YxMWYxODA2YjJlMjQxNWZiZjUyZg==\",\"Alt\":\"DTCC_EC_Review_Website_Images-10.jpg\",\"Category\":[]}},\"ShortDescription\":\"Every day, we help keep the world’s financial markets moving. We process trillions of dollars in securities transactions daily and quadrillions annually, delivering the scale, resiliency and certainty market participants need as settlement cycles accelerate and automation expands. \",\"MetaTitle\":\"Clearing \u0026 Settlement Services | DTCC\",\"Keywords\":\"\",\"PageDescription\":\"We deliver highly efficient and reliable clearing and settlement across the U.S. equities and fixed income markets that reduce risk and cost for clients.\",\"MetaContentType\":\"\",\"OpenGraphImage\":{\"Expanded\":{}},\"OpenGraphTitle\":\"\",\"DisableIndexing\":null,\"MainContentArea\":[{\"ContentLink\":{\"Id\":39853,\"Expanded\":{\"__typename\":\"OverviewContainerBlock\",\"JumpLinksTitle\":\"\",\"Name\":\"Overview\",\"Theme\":\"light\",\"ShowWatchVideoButton\":null,\"Subheading\":\"\",\"Heading\":\"Keeping Markets Moving \",\"Description\":\"\u003cp\u003eFinancial markets are handling growing transaction volumes, faster settlement cycles and increasing complexity. To operate efficiently, market participants need a reliable way to manage risk and complete trades.\u003c/p\u003e\\n\u003cp\u003eDTCC provides the infrastructure that helps make this possible across U.S. equities and fixed income markets. Through our clearing, settlement and asset servicing services, we help firms process transactions, manage obligations and complete trades with confidence.\u003c/p\u003e\\n\u003cp\u003eBy centralizing and automating these activities, we help reduce risk, improve operational performance and support the smooth functioning of the financial markets.\u0026nbsp;\u003c/p\u003e\",\"CTAButton\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"MediaType\":\"\",\"MediaImage\":{\"Expanded\":{}},\"AutoplayLoopVideo\":{\"Expanded\":{}},\"VideoDetailPage\":{\"Expanded\":{}},\"VideoPlatform\":null,\"VideoId\":\"\",\"VideoAutoplayEnabled\":null,\"WatchVideoButtonLabel\":\"\",\"VideoDurationDisplay\":\"\",\"FeaturedResource\":{\"Expanded\":{}},\"SupportingModules\":[],\"FixedWidthCards\":null,\"NewsInsightsCardsArea\":[],\"_concreteType\":\"OverviewContainerBlock\"}}},{\"ContentLink\":{\"Id\":39855,\"Expanded\":{\"__typename\":\"StatCardsContainerBlock\",\"JumpLinksTitle\":\"\",\"StatCards\":[{\"ContentLink\":{\"Expanded\":{\"QuantityLabel\":\"$$608\",\"UnitLabel\":\"Trillion\",\"Description\":\"Equity transactions processed in 2025\",\"Footnote\":\"\",\"_concreteType\":\"StatCardBlock\"}}},{\"ContentLink\":{\"Expanded\":{\"QuantityLabel\":\"98%\",\"UnitLabel\":\"\",\"Description\":\"Average reduction in payment obligations through multilateral netting\",\"Footnote\":\"\",\"_concreteType\":\"StatCardBlock\"}}},{\"ContentLink\":{\"Expanded\":{\"QuantityLabel\":\"545\",\"UnitLabel\":\"Million\",\"Description\":\"Record equities transactions cleared in a single day\",\"Footnote\":\"\",\"_concreteType\":\"StatCardBlock\"}}},{\"ContentLink\":{\"Expanded\":{\"QuantityLabel\":\"$$3.3\",\"UnitLabel\":\"Quadrillion\",\"Description\":\"Government securities transactions processed in 2025\",\"Footnote\":\"\",\"_concreteType\":\"StatCardBlock\"}}}],\"Footnote\":\"Data as of Q4 2025\",\"Theme\":\"light\",\"AnimationEnabled\":true,\"DisplayBackgroundFill\":true,\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"StatCardsContainerBlock\"],\"_concreteType\":\"StatCardsContainerBlock\"}}},{\"ContentLink\":{\"Id\":39865,\"Expanded\":{\"__typename\":\"FeatureGridContainerBlock\",\"JumpLinksTitle\":\"\",\"Theme\":\"light\",\"Subheading\":\"\",\"Heading\":\"Delivering Value\",\"Description\":\"\",\"CardIconMode\":\"check\",\"Cards\":[{\"ContentLink\":{\"Id\":39867,\"GuidValue\":\"45f903d8-2476-4dcb-92fb-9c48ba2c302a\",\"Expanded\":{\"Image\":{\"Expanded\":{}},\"Heading\":\"Central Counterparty Protection\",\"Description\":\"By standing between buyers and sellers, we help ensure the completion of eligible transactions while reducing counterparty risk.\",\"Link\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}}}},{\"ContentLink\":{\"Id\":39868,\"GuidValue\":\"5c5be2a8-f671-448b-83bd-de39dc5ac7f5\",\"Expanded\":{\"Image\":{\"Expanded\":{}},\"Heading\":\"Multilateral Netting Efficiency\",\"Description\":\"Our netting capabilities significantly reduce settlement obligations, freeing liquidity and reducing operational burdens across the marketplace.\",\"Link\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}}}},{\"ContentLink\":{\"Id\":39869,\"GuidValue\":\"f255ff7d-78f0-4b63-9ee5-cffe358a5883\",\"Expanded\":{\"Image\":{\"Expanded\":{}},\"Heading\":\"Market-Scale Processing\",\"Description\":\"Infrastructure engineered to support trillions of dollars in daily activity and periods of elevated market volatility.\",\"Link\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}}}},{\"ContentLink\":{\"Id\":39870,\"GuidValue\":\"86ee0f1d-abe8-47d4-ac37-3529c998f851\",\"Expanded\":{\"Image\":{\"Expanded\":{}},\"Heading\":\"Keeping Pace with Market Change\",\"Description\":\"Support evolving settlement and operating models, including T+1 and 24x5 processing capabilities.\",\"Link\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}}}},{\"ContentLink\":{\"Id\":39871,\"GuidValue\":\"0df5f5fa-a518-4281-af90-5629b5132863\",\"Expanded\":{\"Image\":{\"Expanded\":{}},\"Heading\":\"Enhanced Transparency\",\"Description\":\"Centralized clearing creates greater visibility, standardization and operational consistency across participants.\",\"Link\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}}}},{\"ContentLink\":{\"Id\":39872,\"GuidValue\":\"c4b61a14-aed5-4b8e-b1e3-eb5fed7e9312\",\"Expanded\":{\"Image\":{\"Expanded\":{}},\"Heading\":\"Resilient Infrastructure\",\"Description\":\"Our critical infrastructure is designed to support market continuity during periods of heightened activity and stress.\",\"Link\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null}}}}]}}},{\"ContentLink\":{\"Id\":39860,\"Expanded\":{\"__typename\":\"GenericTextCardsContainerBlock\",\"JumpLinksTitle\":\"\",\"Theme\":\"light-green\",\"DesktopColumns\":\"3\",\"ComponentLayout\":\"grid\",\"IntroHeadingSize\":\"heading-small\",\"Subheading\":\"\",\"Heading\":\"Explore Our Services\",\"Description\":\"\u003cp\u003eWe deliver critical clearing, settlement and risk management capabilities across the U.S. equities and fixed income ecosystem.\u0026nbsp;\u003c/p\u003e\",\"CTAButton\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"Cards\":[],\"PagesCardsArea\":[{\"ContentLink\":{\"Id\":2133,\"GuidValue\":\"ea09d77d-516d-4995-80ae-3b0ec0c05d8d\",\"Expanded\":{\"_concreteType\":\"ProductAndServicesCategoryPage\",\"ContentLink\":{\"Id\":2133},\"Name\":\"Equities Clearing (NSCC)\",\"NavigationTitle\":\"Equities Clearing (NSCC)\",\"OpenGraphImage\":{\"Expanded\":{}},\"PageDescription\":\"Explore DTCC equities clearing services that help reduce risk, improve efficiency and support secure post-trade processing.\",\"ProductServicesName\":\"Equities Clearing\",\"ShortDescription\":\"Every trading day, clearing helps reduce risk, free up capital and keep markets running smoothly. DTCC’s National Securities Clearing Corporation (NSCC) combines millions of transactions into fewer, simpler obligations, making them easier and less costly for firms to manage.\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/DTCC_FICC_EquitiesClearing.jpg/Zz02NDFmNGE4NGFjODExMWYxYWM2NWQyMjRjMGQzYzc2ZA==\",\"Alt\":\"DTCC_FICC_EquitiesClearing.jpg\",\"Category\":[]}},\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/equities-clearing\"}}},{\"ContentLink\":{\"Id\":2151,\"GuidValue\":\"470dcc0e-0ca9-4984-ab3e-7da906ee985a\",\"Expanded\":{\"_concreteType\":\"ProductAndServicesCategoryPage\",\"ContentLink\":{\"Id\":2151},\"Name\":\"Equities Settlement (DTC)\",\"NavigationTitle\":\"Equities Settlement (DTC)\",\"OpenGraphImage\":{\"Expanded\":{}},\"PageDescription\":\"Explore DTCC equities settlement services that help automate post-trade processing, reduce risk and support efficient market settlement.\",\"ProductServicesName\":\"Equities Settlement\",\"ShortDescription\":\"Once a trade is cleared, settlement makes it final. Every day, we help move securities and payments between market participants, completing transactions safely, efficiently and at scale. \",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/DTCC_FICC_EquititesSettlement.jpg/Zz02MzljYzM1Y2FjODExMWYxYWEyZDI2NDZlZDA1NTQ4YQ==\",\"Alt\":\"DTCC_FICC_EquititesSettlement.jpg\",\"Category\":[]}},\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/equities-settlement\"}}},{\"ContentLink\":{\"Id\":43110,\"GuidValue\":\"d39abcad-d17b-4f11-96ee-37abcaaf1628\",\"Expanded\":{\"_concreteType\":\"ProductAndServicesCategoryPage\",\"ContentLink\":{\"Id\":43110},\"Name\":\"Fixed Income Clearing (FICC)\",\"NavigationTitle\":\"Fixed Income Clearing (FICC)\",\"OpenGraphImage\":{\"Expanded\":{}},\"PageDescription\":\"Learn how FICC helps manage risk, improve efficiency and support clearing and settlement across key fixed income markets.\",\"ProductServicesName\":\"Fixed Income Clearing (FICC)\",\"ShortDescription\":\"For more than 40 years, Fixed Income Clearing Corporation (FICC) has helped market participants manage risk, improve efficiency and support liquidity across the U.S. Treasury and agency mortgage-backed securities markets through trusted clearing and post-trade infrastructure.\",\"ThumbnailImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/DTCC_FICC_FICC.jpg/Zz02NDI0YTA0Y2FjODExMWYxOTBlNWZlYWY3YjA1ZTE0Mw==\",\"Alt\":\"DTCC_FICC_FICC.jpg\",\"Category\":[]}},\"Url\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/fixed-income-clearing-corporation-ficc\"}}}],\"ProductServicesCardsArea\":[],\"_concreteType\":\"GenericTextCardsContainerBlock\"}}},{\"ContentLink\":{\"Id\":42528,\"Expanded\":{\"__typename\":\"AccordionContainerBlock\",\"JumpLinksTitle\":\"\",\"Theme\":\"light\",\"Name\":\"Frequently Asked Questions\",\"Subheading\":\"\",\"Heading\":\"Understanding DTCC Clearing Infrastructure \",\"Description\":\"\u003cp\u003eLearn more about the infrastructure that supports U.S. equities and fixed income markets.\u0026nbsp;\u003c/p\u003e\",\"OpenFirstAccordionByDefault\":true,\"ShowNumbers\":false,\"ImagePosition\":\"left\",\"OptionalImage\":{\"Expanded\":{\"Url\":\"https://files.dtcc.com/images/assets/DTCC_UnderstandingDTCC_r1.jpg/Zz0zMTA5ZTRjMDhmM2UxMWYxYjlmMGY2NDQxMTg0ZTA1Yg==\",\"Alt\":\"DTCC_UnderstandingDTCC_r1.jpg\",\"Category\":[]}},\"AccordionRows\":[{\"ContentLink\":{\"Id\":42530,\"GuidValue\":\"585d7a60-1742-4d96-9a70-6a592df2e9ac\",\"Expanded\":{\"Name\":\"What markets does DTCC support?\",\"AccordionHeader\":\"What markets does DTCC support?\",\"AccordionPanel\":\"\u003cp\u003eDTCC supports critical U.S. financial markets through its clearing and settlement subsidiaries, including equities, U.S. Treasuries, agency securities and mortgage-backed securities (MBS).\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":42531,\"GuidValue\":\"6c748b97-fe1c-4be3-a19f-572f5b94155d\",\"Expanded\":{\"Name\":\"What is the role of clearing in financial markets?\",\"AccordionHeader\":\"What is the role of clearing in financial markets?\",\"AccordionPanel\":\"\u003cp\u003eClearing helps ensure that trades are accurately matched, validated and prepared for settlement. By centralizing post-trade processing and risk management, clearing reduces uncertainty and helps markets operate more smoothly.\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":42532,\"GuidValue\":\"c70eb984-296c-4a6e-9d69-164d3c1b2391\",\"Expanded\":{\"Name\":\"What is the difference between clearing and settlement?\",\"AccordionHeader\":\"What is the difference between clearing and settlement?\",\"AccordionPanel\":\"\u003cp\u003eClearing is the process of validating trades, managing risk and determining each party's obligations. Settlement is the final exchange of securities and cash that completes the transaction. Together, they help ensure trades are completed accurately and efficiently.\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":42533,\"GuidValue\":\"1aa3a211-f0a3-4e0f-9430-19cfb9e6fdbe\",\"Expanded\":{\"Name\":\"Why is central clearing important?\",\"AccordionHeader\":\"Why is central clearing important?\",\"AccordionPanel\":\"\u003cp\u003eCentral clearing helps reduce counterparty risk by placing a central counterparty (CCP) between buyers and sellers. This helps improve transparency, strengthen market resilience and promote confidence in financial markets.\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":44190,\"GuidValue\":\"1c28ade5-f042-4229-824f-79281168d439\",\"Expanded\":{\"Name\":\"What is a central counterparty (CCP)?\",\"AccordionHeader\":\"What is a central counterparty (CCP)?\",\"AccordionPanel\":\"\u003cp\u003eA central counterparty (CCP) stands between trading counterparties and becomes the buyer to every seller and the seller to every buyer. By managing risk centrally, CCPs help promote market stability and ensure eligible transactions are completed even during periods of market stress.\u0026nbsp;\u003cbr /\u003e\u0026nbsp;\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":44191,\"GuidValue\":\"6345e5b9-e4c1-4722-b7a0-5d6754c0e7c6\",\"Expanded\":{\"Name\":\"How does multilateral netting improve capital and liquidity efficiency?\",\"AccordionHeader\":\"How does multilateral netting improve capital and liquidity efficiency?\",\"AccordionPanel\":\"\u003cp\u003eMultilateral netting consolidates many trading obligations into a smaller number of net settlement positions. This reduces the number and value of transactions that must be settled, helping firms lower funding needs and use capital and liquidity more efficiently.\u0026nbsp;\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":44193,\"GuidValue\":\"ef199385-fad1-44ef-ace4-1e45b7012a8d\",\"Expanded\":{\"Name\":\"How does DTCC help reduce settlement risk?\",\"AccordionHeader\":\"How does DTCC help reduce settlement risk?\",\"AccordionPanel\":\"\u003cp\u003eDTCC helps reduce settlement risk through centralized clearing, risk management, netting and automated settlement processes. These capabilities help decrease failed transactions, improve efficiency and support the timely completion of trades.\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":44195,\"GuidValue\":\"c0a517a9-ed04-4fbc-b0ab-f08bdc5d3ddc\",\"Expanded\":{\"Name\":\"What does T+1 settlement mean?\",\"AccordionHeader\":\"What does T+1 settlement mean?\",\"AccordionPanel\":\"\u003cp\u003eT+1 means that most securities transactions settle one business day after the trade date. The shorter settlement cycle helps reduce risk exposure, improve operational efficiency and accelerate the movement of securities and cash through the marketplace.\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":44196,\"GuidValue\":\"86274b92-e09c-4447-bddd-7177d063dc99\",\"Expanded\":{\"Name\":\"How does DTCC help firms manage market volume and volatility?\",\"AccordionHeader\":\"How does DTCC help firms manage market volume and volatility?\",\"AccordionPanel\":\"\u003cp\u003eDTCC's infrastructure is designed to support the demands of modern markets during both routine trading and periods of heightened activity. Centralized processing, automation and risk management tools help firms continue to operate efficiently as transaction volumes grow and market conditions change.\u0026nbsp;\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null},{\"ContentLink\":{\"Id\":44198,\"GuidValue\":\"a2371c97-0a9a-4a7f-9624-c40f4b829d99\",\"Expanded\":{\"Name\":\"Why does market scale matter in clearing and settlement?\",\"AccordionHeader\":\"Why does market scale matter in clearing and settlement?\",\"AccordionPanel\":\"\u003cp\u003eScale enables clearing and settlement infrastructure to process large transaction volumes efficiently while creating benefits such as netting efficiencies, risk reduction and liquidity savings. By centralizing post-trade activity, DTCC helps firms achieve efficiencies that would be difficult to realize through bilateral processing alone.\u003c/p\u003e\",\"ImageAccordionItem\":{\"Expanded\":{}},\"AccordionCTA\":{\"Href\":null,\"Target\":null,\"Title\":null,\"Text\":null},\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionRowBlock\"],\"_id\":null,\"_concreteType\":\"AccordionRowBlock\"}},\"DisplayOption\":\"\",\"Tag\":null}],\"ContentType\":[\"FoundationBlockData\",\"BlockData\",\"ContentData\",\"Block\",\"AccordionContainerBlock\"],\"_id\":null,\"_concreteType\":\"AccordionContainerBlock\"}}},{\"ContentLink\":{\"Id\":57625,\"Expanded\":{\"__typename\":\"FormContainerBlock\",\"JumpLinksTitle\":\"Contact Us\",\"Background\":\"light\",\"Subheading\":\"Get in Touch\",\"Heading\":\"Interested in learning more about our Clearing \u0026 Settlement Services?\",\"Description\":\"\u003cp\u003e\u003ca id=\\\"ContactUs\\\"\u003e\u003c/a\u003eComplete the form and a member of our team will contact you.\u0026nbsp;\u003c/p\u003e\\n\u003cp\u003eNeed support with a DTCC product or service you currently use? Please visit the \u003ca href=\\\"https://www.dtcc.com/support\\\" target=\\\"_top\\\"\u003eDTCC Client Center\u003c/a\u003e.\u0026nbsp;\u003c/p\u003e\",\"EmbeddedForm\":\"\u003cscript src=\\\"https://communications.dtcc.com/js/forms2/js/forms2.min.js\\\"\u003e\u003c/script\u003e\\n\u003cform id=\\\"mktoForm_8918\\\"\u003e\\n    \u003cdiv id=\\\"formPlaceholder\\\"\u003e\u0026nbsp;\u003c/div\u003e\\n\u003c/form\u003e\\n\u003cscript\u003eMktoForms2.loadForm(\\\"//communications.dtcc.com\\\", \\\"669-QIL-921\\\", 8918, function(form) {\\n    $(\\\"#formPlaceholder\\\").append(form.getFormElem());\\n    \\n    // Add an onSuccess handler\\n    form.onSuccess(function(values, followUpUrl) {\\n\\n        window.dataLayer = window.dataLayer || [];\\n\\n        window.dataLayer.push({\\n\\n            'event': 'formSubmission',\\n\\n           'formID': 'mktoForm_8918'\\n\\n        });\\n\\n    });\\n});\u003c/script\u003e\",\"_concreteType\":\"FormContainerBlock\"}}}],\"ExcludeFromSearch\":null,\"TaxonomyInitiatives\":[],\"TaxonomyLegalAndRegulatory\":[],\"TaxonomyAboutDTCC\":[],\"TaxonomyProductAndServices\":[{\"ContentLink\":{\"Id\":2132,\"Expanded\":{\"__typename\":\"Content\"}}}],\"TaxonomyNewsAndInsights\":[],\"RegionsSelection\":[],\"TaxonomyOrganizationType\":[],\"AssetClassesSelection\":[],\"TaxonomyCampaign\":[],\"TaxonomyTopics\":[]}}],[\"$\",\"$L6a\",null,{\"mainContent\":[{\"ContentLink\":\"$89\",\"DisplayOption\":\"$undefined\",\"Tag\":\"$undefined\"},{\"ContentLink\":\"$96\",\"DisplayOption\":\"$undefined\",\"Tag\":\"$undefined\"},{\"ContentLink\":\"$a6\",\"DisplayOption\":\"$undefined\",\"Tag\":\"$undefined\"},{\"ContentLink\":\"$cd\",\"DisplayOption\":\"$undefined\",\"Tag\":\"$undefined\",\"genericTextCardsData\":{\"genericTextCardsData\":[{\"Id\":2133,\"Name\":\"Equities Clearing (NSCC)\",\"Heading\":\"Equities Clearing (NSCC)\",\"Description\":\"Every trading day, clearing helps reduce risk, free up capital and keep markets running smoothly. DTCC’s National Securities Clearing Corporation (NSCC) combines millions of transactions into fewer, simpler obligations, making them easier and less costly for firms to manage.\",\"CTAButton\":{\"Text\":\"Learn More\",\"Href\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/equities-clearing\",\"Target\":\"_self\"},\"Image\":\"$d8\",\"_cardType\":\"product-service\",\"_concreteType\":\"ProductAndServicesCategoryPage\"},{\"Id\":2151,\"Name\":\"Equities Settlement (DTC)\",\"Heading\":\"Equities Settlement (DTC)\",\"Description\":\"Once a trade is cleared, settlement makes it final. Every day, we help move securities and payments between market participants, completing transactions safely, efficiently and at scale. \",\"CTAButton\":{\"Text\":\"Learn More\",\"Href\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/equities-settlement\",\"Target\":\"_self\"},\"Image\":\"$e1\",\"_cardType\":\"product-service\",\"_concreteType\":\"ProductAndServicesCategoryPage\"},{\"Id\":43110,\"Name\":\"Fixed Income Clearing (FICC)\",\"Heading\":\"Fixed Income Clearing (FICC)\",\"Description\":\"For more than 40 years, Fixed Income Clearing Corporation (FICC) has helped market participants manage risk, improve efficiency and support liquidity across the U.S. Treasury and agency mortgage-backed securities markets through trusted clearing and post-trade infrastructure.\",\"CTAButton\":{\"Text\":\"Learn More\",\"Href\":\"https://www.dtcc.com/products-and-services/clearing-settlement-services/fixed-income-clearing-corporation-ficc\",\"Target\":\"_self\"},\"Image\":\"$ea\",\"_cardType\":\"product-service\",\"_concreteType\":\"ProductAndServicesCategoryPage\"}]}},{\"ContentLink\":\"$ee\",\"DisplayOption\":\"$undefined\",\"Tag\":\"$undefined\"},{\"ContentLink\":\"$13b\",\"DisplayOption\":\"$undefined\",\"Tag\":\"$undefined\"}]}]]]}],[\"$\",\"$65\",null,{\"fallback\":null,\"children