 <script type="text/javascript">
      $('#listed_company').bind('input', function() {
          var c = this.selectionStart,
              r = /[^a-z0-9 .]/gi,
              v = $(this).val();
          if(r.test(v)) {
            $(this).val(v.replace(r, ''));
            c--;
          }
          this.setSelectionRange(c, c);
        });

    $(document).ready(function(){
       $(document).on('click','.addressbook',function(e) {

