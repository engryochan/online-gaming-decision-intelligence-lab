ttps://www.spindices.com/indices/equity/sp-nzx-50-portfolio-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}},"sys":{"id":"2Y9oEz1XzlkAIjZDfM5uzB","type":"Entry"}},{"fields":{"isin":"ALL","name":" S\u0026P/NZX All Index","code":"SPNZXALLTR","position":7,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The index is considered the total market indicator for the New Zealand \nequity market. It comprises all eligible securities quoted on the NZX \nMain Board (NZSX). Constituents are not screened for liquidity.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.spindices.com/indices/equity/sp-nzx-all-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":" ","marks":[],"data":{}}]}]}},"sys":{"id":"4FCSH9qCt5AyfdjdBOFmhU","type":"Entry"}},{"fields":{"isin":"NZ50","name":"S\u0026P/NZX 50 Index","code":"SPNZXNZ50TR","position":1,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The index is designed to measure the performance of the 50 largest, eligible stocks listed on the Main Board (NZSX) of the NZX by float-adjusted market capitalization. Representative, liquid, and investable, it is widely considered New Zealand's preeminent benchmark index. The index is float-adjusted, covering approximately 90% of New Zealand equity market capitalization.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.spindices.com/indices/equity/sp-nzx-50-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"\n\n","marks":[],"data":{}}]}]}},"sys":{"id":"6czPf2WqtDpUuNr1VrZoub","type":"Entry"}},{"fields":{"isin":"NZ20","name":"S\u0026P/NZX 20 Index","code":"SPNZXNZ20","position":2,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The index is designed to measure the performance of 20 of the largest and most liquid companies in the S\u0026P/NZX 50 Index. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.spindices.com/indices/equity/sp-nzx-20-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}},"sys":{"id":"2iArddOCWQ4Fc2eI2kIMHl","type":"Entry"}},{"fields":{"isin":"T10","name":"S\u0026P/NZX 10 Index","code":"SPNZXT10TR","position":4,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The index is designed to measure the performance of 10 of the largest companies in the S\u0026P/NZ 50 Index. Dual and overseas listed companies are not eligible for index inclusion.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"\n","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.spindices.com/indices/equity/sp-nzx-10-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"\n","marks":[],"data":{}}]}]}},"sys":{"id":"6JawrDCTRWUk8ex5zLCdUa","type":"Entry"}},{"fields":{"isin":"SCI","name":"S\u0026P/NZX SmallCap Index","code":"SPNZXSCITR","position":6,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeTy