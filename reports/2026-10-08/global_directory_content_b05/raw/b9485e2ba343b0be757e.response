 Clearing"},{"id":"3Rnvb7","url":"/services/nzx-trading","name":"NZX Trading"},{"id":"4cxwKu3YDJIqUfb7fSd483","url":"/services/data-connectivity","name":"NZX Data \u0026 Connectivity"}]},{"id":"SEC-31A9Q9","name":"Investing","children":[{"id":"2bj6C3","url":"/investing/investing-overview","name":"Investing Overview"},{"id":"1KA9Ki","url":"/investing/glossary","name":"Glossary"},{"id":"mLTXJ","url":"/investing/education-resource-centre","name":"Education Resource Centre "},{"id":"2uptT0","url":"/investing/nzx-trading-hours","name":"NZX Trading Hours"},{"id":"1uQsFG","url":"/investing/find-a-participant","name":"Find a Participant"},{"id":"11ViJd","url":"/investing/nzx-podcast","name":"NZX Podcast"}]},{"id":"SEC-3muLmI","name":"About NZX","children":[{"id":"t64UM","url":"/about-nzx/organization-structure","name":"Who We Are"},{"id":"QKGwr","url":"/about-nzx/investor-centre","name":"Investor Centre"},{"id":"18tLw1","url":"/about-nzx/contact","name":"Contact"},{"id":"2sqTxM","url":"/about-nzx/Charity-Golf-Classic","name":"S\u0026P/NZX Charity Golf Classic "}]}],"page":{"metadata":{"tags":[{"sys":{"type":"Link","linkType":"Tag","id":"servicesSection"}}],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"1JFjKu","type":"Entry","createdAt":"2023-05-16T23:51:22.447Z","updatedAt":"2023-12-13T00:56:25.127Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":59,"revision":18,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"page"}},"locale":"en-US"},"fields":{"label":"Become a Participant","title":"Become a Participant","path":"/services/market-participants/become-a-participant","slug":"become-a-participant","layoutRef":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"1JjDWE","type":"Entry","createdAt":"2023-05-04T22:03:03.807Z","updatedAt":"2024-11-08T02:33:56.092Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":14,"revision":7,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"layouts"}},"locale":"en-US"},"fields":{"name":"Article with Sibling Navigation","template":"sidebarWithSiblings"}},"content":{"nodeType":"document","data":{},"content":[{"nodeType":"heading-1","data":{},"content":[{"nodeType":"text","value":"Become a Participant","marks":[],"data":{}}]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"Market Participant / Participant","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"We offer a variety of membership options across our cash market, which are designed to incorporate Trading, Clearing and Depository activities. Please see the brochure below for more information. ","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"file-asb5528-ccf7388","type":"Asset","createdAt":"2023-10-01T23:04:21.796Z","updatedAt":"2023-10-06T00:42:48.260Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":5,"revision":2,"locale":"en-US"},"fields":{"title":"Become a NZX Participant - Front Page.JPG","file":{"url":"//images.ctfassets.net/m5mydry9e35f/file-asb5528-ccf7388/742f8a82cc4427fde8801ffdd6edf790/Become_a_NZX_Participant_-_Front_Page.JPG","details":{"size":4922,"image":{"width":175,"height":247}},"fileName":"Become a NZX Participant - Front Page.JPG","contentType":"image/jpeg"}}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"asset-hyperlink","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"file-asb5520-ccf7380","type":"Asset","createdAt":"2023-10-01T23:27:37.461Z","updatedAt":"2023-10-01T23:27:37.461Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"Become A NZX Participant.pdf","file":{"url":"//assets.ctfassets.net/m5mydry9e35f/file-asb5520-ccf7380/6897024f09426c1f5c8d70b8748de1bf/Become_A_NZX_Participant.pdf","details":{"size":9332430},"fileName":"Become A NZX Participant.pdf","contentType":"application/pdf"}}}},"content":[{"nodeType":"text","value":"Become A NZX Participant","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"hr","data":{},"content":[]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"Trading Participant","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"NZX accredited trading participants have access to our world class exchange platform that offers liquidity across a wide range of markets such as equities, debt, exchange traded funds, along with equity derivatives \u0026 commodity derivatives (through partnership). Please see the brochure below for more information. ","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"file-asb5634-ccf7493","type":"Asset","createdAt":"2023-10-02T01:30:57.881Z","updatedAt":"2023-10-06T00:44:21.290Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":5,"revision":2,"locale":"en-US"},"fields":{"title":"NZX Trading Cover.jpeg","file":{"url":"//images.ctfassets.net/m5mydry9e35f/file-asb5634-ccf7493/126d71f72ef3618a70531fce0981957b/NZX_Trading_Cover.jpeg","details":{"size":60823,"image":{"width":175,"height":246}},"fileName":"NZX Trading Cover.jpeg","contentType":"image/png"}}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"asset-hyperlink","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"file-asb6005-ccf7492","type":"Asset","createdAt":"2023-10-02T03:05:47.039Z","updatedAt":"2023-10-02T03:05:47.039Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"NZX Trading Booklet - May 2022_v7.pdf","file":{"url":"//assets.ctfassets.net/m5mydry9e35f/file-asb6005-ccf7492/e02b69add153280988520f88ff11a9d7/NZX_Trading_Booklet_-_May_2022_v7.pdf","details":{"size":4523594},"fileName":"NZX Trading Booklet - May 2022_v7.pdf","contentType":"application/pdf"}}}},"content":[{"nodeType":"text","value":"NZX Trading","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"hr","data":{},"content":[]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"Connectivity ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"NZX offers a range of different connectivity options for clients to access the NZX systems, regardless of location. The right option will depend on your preference and the way you intend to access the NZX Markets. Please see the brochure below for more information. ","marks":[],"data":{}}]},{"nodeType":"embedded-asset-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"file-asb5629-ccf7490","type":"Asset","createdAt":"2023-10-02T01:46:20.900Z","updatedAt":"2023-10-06T00:50:02.329Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":6,"revision":2,"locale":"en-US"},"fields":{"title":"NZX Connectivity Overview - cover","file":{"url":"//images.ctfassets.net/m5mydry9e35f/file-asb5629-ccf7490/978fe04c18ff3baae9b580a1a61d0a8e/NZX_Connectivity_Overview_-_Front_Page.JPG","details":{"size":10431,"image":{"width":175,"height":246}},"fileName":"NZX Connectivity Overview - Front Page.JPG","contentType":"image/jpeg"}}}},"content":[]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"asset-hyperlink","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"file-asb5630-ccf7489","type":"Asset","createdAt":"2023-10-02T01:41:11.651Z","updatedAt":"2023-10-02T01:41:11.651Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"Connectivity Overview.pdf","file":{"url":"//assets.ctfassets.net/m5mydry9e35f/file-asb5630-ccf7489/8fea4737e29de14407c375ebacb90b51/Connectivity_Overview.pdf","details":{"size":4344998},"fileName":"Connectivity Overview.pdf","contentType":"application/pdf"}}}},"content":[{"nodeType":"text","value":"Connectivity Overview","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"hr","data":{},"content":[]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"NZX Participant Application Process","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"NZX provides a highly efficient and collaborative onboarding process, comprising a regulatory accreditation process and a business and operations establishment phase. This is completed in parallel with the support of dedicated relationship managers. ","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"STEP 1: CONSULATION","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The NZX Markets Development team will be your key commercial contacts throughout the application process. NZX Markets Development works with clients to determine what type of accreditation is best for their needs and help clients to navigate through the application process. ","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"STEP 2: TESTING AND SUPPORT","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"We will set you up with a team of subject matter experts across NZX markets, data, technology and compliance to support and guide you on your accreditation journey. For firms looking to connect new front or back office technology, this step will include a technical conformance to ensure that your technology is fit for purpose. Clients are required to develop robust operational procedures to manage their obligations as NZX Participants. ","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"STEP 3: APPLICATION AND ACCREDITATION","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Once an application is submitted, the NZX Participant Compliance Team will review your documentation to validate and ensure that firms accredited for NZX's markets meet the highest of standards, enabling overall market integrity to be maintained. The formal accreditation process confirms that the applicant is legally, technically and operationally capable of managing their obligations as an NZX Participant. ","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"STEP 4: GO LIVE LAUNCH","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"Upon successful accreditation, the NZX team will ensure a smooth go live transition providing pre and post-launch services. This includes dedicated go live resources and support networks to ensure your successful assimilation into the NZX Participant environment. This relationship management and client-centric approach continues as firms become valued members of the NZX and the New Zealand Capital Markets. ","marks":[],"data":{}}]},{"nodeType":"hr","data":{},"content":[]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"Participant Accreditation","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"A Market Participant / Participant is a business accredited by NZX to participate in the markets provided by NZX. NZX also accredits individuals within these businesses as NZX Advisers, NZDX Advisers and NZX Derivatives Advisers.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":" Section 3 of the NZX Participant Rules and Section 3 of the Derivatives Market Rules detail the main application requirements for accreditation as an NZX Participant or Derivatives Market Participant. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":" Applicants must fulfil certain requirements and submit prescribed documents to NZ RegCo. Applicants must ensure that they are aware of their obligations under each Rule set, relevant to their application, and to implement appropriate processes to comply with the applicable Rule obligations before they submit an application to NZ RegCo. ","marks":[],"data":{}}]},{"nodeType":"heading-4","data":{},"content":[{"nodeType":"text","value":"Accreditation Documentation ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":" The following documentation will assist applicants with their accreditation process: ","marks":[],"data":{}}]},{"nodeType":"unordered-list","data":{},"content":[{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"/regulation/nzx-rules-guidance/participant-guidance"},"content":[{"nodeType":"text","value":"NZX Participant Rules","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"/regulation/nzx-rules-guidance/clearing-depository-rules"},"content":[{"nodeType":"text","value":"NZX Clearing \u0026 Depository Rules","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"/regulation/nzx-rules-guidance/participant-derivative-guidance"},"content":[{"nodeType":"text","value":"Guidance Notes and Practice Notes issued by NZX","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]},{"nodeType":"list-item","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"/services/market-participants/participant-fees"},"content":[{"nodeType":"text","value":"Current NZX fee schedules","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}]},{"nodeType":"hr","data":{},"content":[]},{"nodeType":"heading-2","data":{},"content":[{"nodeType":"text","value":"NZX Adviser / NZDX Adviser / NZX Derivatives Adviser ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To be accredited as an NZX Adviser, NZDX Adviser or NZX Derivatives Adviser an individual must be employed by an NZX Market Participant or Derivatives Market Participant as appropriate. The individual must be NZX accredited under either, or both, the Participant Rules and the Derivatives Market Rules to provide advice to clients in respect of the relevant products. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"To apply for approval as any of the above Adviser designations, a candidate must fulfil certain requirements and submit documents prescribed by the Rules as set out in the ","marks":[],"data":{}},{"nodeType":"asset-hyperlink","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"file-asb1047-ccf2933","type":"Asset","createdAt":"2023-10-01T22:31:44.287Z","updatedAt":"2023-10-01T22:31:44.287Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":2,"revision":1,"locale":"en-US"},"fields":{"title":"NZX_Adviser_Designation_(December_2017).pdf","file":{"url":"//assets.ctfassets.net/m5mydry9e35f/file-asb1047-ccf2933/857f0ae0d911554d576eebf8d55cd9ca/NZX_Adviser_Designation__December_2017_.pdf","details":{"size":471232},"fileName":"NZX_Adviser_Designation_(December_2017).pdf","contentType":"application/pdf"}}}},"content":[{"nodeType":"text","value":"NZX Adviser Designation Guidance Note","marks":[],"data":{}}]},{"nodeType":"text","value":". ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":" For assistance on becoming a Market Participant / Participant or NZX Adviser / NZDX Adviser / NZX Derivatives Adviser, please email ","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"mailto:participant@nzregco.com"},"content":[{"nodeType":"text","value":"participant@nzregco.com.","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"embedded-entry-block","data":{"target":{"metadata":{"tags":[],"concepts":[]},"sys":{"space":{"sys":{"type":"Link","linkType":"Space","id":"m5mydry9e35f"}},"id":"1Ij8rVFgzSctgM2OhfLRFy","type":"Entry","createdAt":"2023-10-16T03:15:52.854Z","updatedAt":"2025-01-05T21:24:23.432Z","environment":{"sys":{"id":"master","type":"Link","linkType":"Environment"}},"publishedVersion":17,"revision":3,"contentType":{"sys":{"type":"Link","linkType":"ContentType","id":"contacts"}},"locale":"en-US"},"fields":{"title":"C