        <button type="button" class="close" onclick="lpopClose('#mycustomNavPop')"><span class="sr-only">close</span></button>
      </div>
      <div class="popwrap__body">
        <div class="popwrap__body__cont">
          <div class="sh-pop pt0">
            <div class="mycustomNav">
              <p class="mcn-text"><em><strong>If you select and set 8 favorite menus</strong></em>, you can use the fast service.</p>
              <div class="mycustomNav-body">
                <label class="form-check"><input type="checkbox" name="customnav-1"><span>Financial Institutions</span></label>
