<!-- 공통 메뉴  -->
<!-- 통합 검색 -->
<div id="modal_search_full" class="krds-modal search" data-type="full" role="dialog" aria-labelledby="tit_modal_search_full">
  <div class="modal-dialog">
    <div class="modal-content">
      <!-- modal title -->
      <div class="modal-header sr-only">
        <h2 id="tit_modal_search_full" class="modal-title">SEARCH</h2>
      </div>
      <!-- //modal title -->
      <!-- modal contents -->
      <div class="modal-conts">
        <div class="conts-area">
          <div class="total-search-wrap">
            <!-- search form -->
            <div class="sch-form-wrap vert">
              <div class="form-tit">
                <label for="layer-search-total">Please enter a search term.</label>
              </div>
              <div class="sch-input">
                <input
                  type="text"
                  class="krds-input xlarge"
                  id="layer-search-total"
                  placeholder="Please enter a search term."
                />
                <button type="button" class="krds-btn icon xlarge ico-search" id="btnModalSearch">
                  <span class="sr-only">SEARCH</span>
                  <i class="svg-icon ico-sch"></i>
                </button>
              </div>
            </div>
            <!-- //search form -->
            <!-- 검색어 자동완성 목록 -->
            <div class="sch-word-wrap" id="search-auto-keyword" style="display: none;">
              <!-- 검색어 자동완성 -->
              <div class="trending-area">
                <h3 class="tit">Search Autocomplete</h3>
                <ul class="recent-list" id="modalAutoList"></ul>
              </div>
            </div>
            <!-- 검색어 자동완성 목록 -->
            <div class="sch-word-wrap" id="search-keyword-box">
              <!-- 인기 검색어 -->
              <div class="trending-area">
                <h3 class="tit">Popular Search Terms</h3>
                <ol class="trending-list" id="modalPopList"></ol>
              </div>
              <!-- 내가 찾은 검색어, 자주찾는 메뉴 -->
              <div class="recent-area">
                <div class="keyword-box">
                  <div class="">
                    <h3 class="tit">Search terms I found</h3>
                    <ul class="recent-list" id="modalRecentList"></ul>
                  </div>
                  <button type="button" class="krds-btn medium text" id="btnRecentClearAll">
                    Delete all recent search terms<i class="svg-icon ico-delete-fill"></i>
                  </button>
                </div>
                <div class="fav-menu">
                  <div class="">
                    <h3 class="tit">Frequently Used Menus</h3>
                    <ul class="recent-list" id="modalFavMenuList"></ul>
                  </div>
                </div>
              </div>
            </div>
            <!-- //내가 찾은 검색어, 자주찾는 메뉴 -->
            <!-- banner -->
            <!-- //banner -->
          </div>
        </div>
      </div>
      <!-- //modal contents -->
      <!-- close button -->
      <button type="button" class="krds-btn xlarge icon btn-close close-modal">
        <span class="sr-only">Close</span>
        <i class="svg-icon ico-popup-close"></i>
      </button>
      <!-- //close button -->
    </div>
  </div>
  <div class="modal-back in"></div>
</div>
<!-- // 통합 검색 -->
<script>
(function($) {
    "use strict";

    var SEARCH_URL   = '/fss/search/searchNew/list.do';
    var POPULAR_URL  = '/fss/search/searchNew/popularKeywords.do';
    var AUTO_URL     = '/fss/search/searchNew/autocomplete.do';
    var LS_RECENT    = 'fssRecentQueries';  // 내가 찾은 검색어 (list.jsp 와 공유)
    var RECENT_MAX   = 10;                  // 최근검색어 저장 상한
    var RECENT_VIEW  = 5;                   // 최근검색어 화면 노출 개수 (저장은 10개 유지 — 개별 삭제 시 다음 검색어가 올라옴)
    var FAVMENU_VIEW = 3;                   // 자주찾는 메뉴 화면 노출 개수 (favMenuList.do 는 상위 10 반환, 화면엔 3개만)
    // [WN 검색 수정] 자주찾는 메뉴는 DB 클릭로그(favMenuList.do)로 전환되어 localStorage 변수 불필요

    // ===== localStorage 유틸 (프라이빗 모드 등 접근 불가 환경에서도 죽지 않도록 방어) =====
    function lsGet(key, fallback) {
        try {
            var raw = localStorage.getItem(key);
            return raw ? JSON.parse(raw) : fallback;
        } catch (e) { return fallback; }
    }
    function lsSet(key, value) {
        try { localStorage.setItem(key, JSON.stringify(value)); } catch (e) { /* 저장 불가 환경 — 무시 */ }
    }

    // ===== 검색 실행 =====
    function goSearch(q) {
        // [WN 검색 수정 - 표시 보정] 자주찾는 메뉴 클릭 등으로 &middot; 가 포함된 값이 넘어올 수 있어
        // 저장 전에 디코드 — 이후 저장분은 최근검색어/검색어 전달 모두 정상 문자로 유지된다.
        q = decodeEntities(q).trim();
        if (!q) { return; }
        // 내가 찾은 검색어 저장 — 중복은 최신으로 끌어올리고 상한 유지
        var recent = lsGet(LS_RECENT, []);
        recent = recent.filter(function(v) { return v !== q; });
        recent.unshift(q);
        if (recent.length > RECENT_MAX) { recent = recent.slice(0, RECENT_MAX); }
        lsSet(LS_RECENT, recent);

        // [WN 검색 수정 - 다국어] 현재 페이지 언어(html lang)를 통합검색으로 전달.
        // list.jsp 는 이 lang 값(en/ko)으로 헤더/푸터/common_menu 를 eng/fss 로 분기한다.
        // 영문 페이지는 <html lang="en"> 이므로 'en', 그 외는 'ko' 로 넘어간다.
        var LANG = (document.documentElement.lang === 'en') ? 'en' : 'ko';
        location.href = SEARCH_URL + '?query=' + encodeURIComponent(q) + '&lang=' + LANG;
    }

    $('#btnModalSearch').on('click', function() { goSearch($('#layer-search-total').val()); });
    $('#layer-search-total').on('keypress', function(e) {
        if (e.which === 13) { goSearch($(this).val()); }
    });

    // ===== 인기검색어 (일간) — 모달 최초 접근 시 1회 lazy 로드 =====
    // common_menu 는 전 페이지에 포함되므로, 페이지 로드마다 ServiceKit 을 두드리지 않도록
    // 사용자가 실제로 검색 모달에 접근(포커스/마우스진입/터치)했을 때 한 번만 조회한다.
    var popLoaded = false;
    function loadPopular() {
        if (popLoaded) { return; }
        popLoaded = true;
        $.ajax({
            url: POPULAR_URL,
            data: { period: 'daily' },
            dataType: 'json',
            timeout: 10000,   // [WN 검색 수정 - 모바일 체감] ServiceKit 지연 시 10초에서 포기 (모달을 막지 않음)
            error: function() { popLoaded = false; }   // 실패 시 다음 접근에서 재시도
        }).done(function(list) {
            var $ol = $('#modalPopList').empty();
            if (!list || list.length === 0) {
                $ol.append($('<li></li>').append($('<a href="javascript:void(0);" class="link"></a>').text('There are no aggregated popular search terms.')));
                return;
            }
            list.forEach(function(kw) {
                var $li = $('<li></li>');
                var $a = $('<a href="javascript:void(0);" class="link"></a>')
                            .text(kw.query)
                            .on('click', function() { goSearch(kw.query); });
                $li.append($a);
                // 등락 표시 — [WN 검색 수정] "10위 화면 기준"으로만 등락을 표현한다.
                //   인기검색어는 10위까지만 노출하는데, 순위 등락폭(gap)은 엔진이 10위 밖까지 포함해
                //   계산하므로 "3위인데 12단계 상승"(=이전 15위) 같은, 10위 화면에선 불가능한 값이 나온다.
                //   → 상승분을 역산한 이전 순위(rank+gap)가 10위를 벗어나면 화면상 "신규 진입"과 같으므로
                //     N(신규)으로 표기한다. 10위 안에서의 이동만 상승/하락 단계로 표시(최대 9단계).
                var POP_MAX = 10;
                var rank = parseInt(kw.rank, 10) || 0;
                var gap  = parseInt(kw.gap, 10) || 0;
                if (kw.updown === 'U') {
                    if (rank + gap > POP_MAX) {
                        // 이전 순위가 10위 밖 → 10위 화면 기준 신규 진입 (신규 배지 아이콘)
                        $li.append($('<span class="status new"><img src="/static/fss/img/search/badge-new.svg" alt="신규검색어"></span>'));
                    } else {
                        $li.append($('<span class="status up"></span>').text(gap));
                    }
                } else if (kw.updown === 'D') {
                    // 하락은 10위 안에 있던 항목이 내려온 것이므로 그대로 표시 (화면에 보이는 = 여전히 10위 내)
                    $li.append($('<span class="status down"></span>').text(gap));
                } else if (kw.updown === 'N') {
                    $li.append($('<span class="status new"><img src="/static/fss/img/search/badge-new.svg" alt="신규검색어"></span>'));
                } else {
                    $li.append($('<span class="status"></span>').text('-'));
                }
                $ol.append($li);
            });
        }).fail(function() {
            popLoaded = false; // 실패 시 다음 접근에서 재시도
        });
    }
    $('#modal_search_full').on('mouseenter touchstart', '.total-search-wrap', loadPopular);
    $('#layer-search-total').on('focus', loadPopular);

    // [WN 검색 수정 - 표시 보정] HTML 엔티티 디코드 (공용).
    //   원본 DB 메뉴명에 &middot; 등이 문자열로 저장되어 있어, JS .text() 로 넣으면 문자 그대로 노출됨.
    //   (JSP EL 출력은 브라우저가 해석하므로 검색결과 화면은 정상)
    //   html() 은 XSS 위험이 있어 지정 엔티티만 선별 치환한다.
    //   자주찾는 메뉴 표시 + 최근검색어 저장/표시에 공통 사용.
    function decodeEntities(s) {
        return String(s || '')
            .replace(/&middot;/g, '\u00B7')
            .replace(/&lt;/g, '<').replace(/&gt;/g, '>')
            .replace(/&#39;/g, "'").replace(/&quot;/g, '"')
            .replace(/&nbsp;/g, ' ')
            .replace(/&amp;/g, '&');
    }

    // ===== 내가 찾은 검색어 (localStorage) =====
    function renderRecent() {
        var recent = lsGet(LS_RECENT, []);
        var $ul = $('#modalRecentList').empty();
        if (recent.length === 0) {
            $ul.append($('<li></li>').append($('<a href="javascript:void(0);" class="link"></a>').text('There are no recent search terms.')));
            return;
        }
        // [WN 검색 수정] 화면 노출은 RECENT_VIEW(5)개까지만 — 저장분(최대 10)에서 최신순으로 잘라 표시
        recent.slice(0, RECENT_VIEW).forEach(function(q) {
            var $li = $('<li></li>');
            // 기존에 저장돼 있던(디코드 전) 값도 정상 표시되도록 표시 시점에도 디코드
            var qDisp = decodeEntities(q);
            $li.append($('<a href="javascript:void(0);" class="link"></a>').text(qDisp).on('click', function() { goSearch(qDisp); }));
            var $del = $('<button type="button" class="krds-btn xsmall icon"><span class="sr-only">Delete</span><i class="svg-icon ico-delete-fill"></i></button>')
                .on('click', function() {
                    var list = lsGet(LS_RECENT, []).filter(function(v) { return v !== q; });
                    lsSet(LS_RECENT, list);
                    renderRecent();
                });
            $li.append($del);
            $ul.append($li);
        });
    }
    $('#btnRecentClearAll').on('click', function() {
        lsSet(LS_RECENT, []);
        renderRecent();
    });

    // ===== 자주찾는 메뉴 (DB 클릭로그 기반 — 전체 공통 인기 메뉴) =====
    // [WN 검색 수정] 기존 localStorage(개인별) 방식은 브라우저가 바뀌면 사라지는 한계가 있어,
    // 전체 사용자 클릭을 집계한 SF1_CLICK_LOG(클릭 수 상위 10) 를 favMenuList.do 로 조회해 표시.
    // 전체 공통 데이터라 "개인 삭제"는 의미가 없으므로 삭제 버튼/전체삭제는 제거함.
    function renderFavMenus() {
        var $ul = $('#modalFavMenuList').empty();
        $.ajax({
            url: '/fss/search/searchNew/favMenuList.do',
            timeout: 3000,   // [WN 검색 수정] 응답 지연 시 3초에서 포기 (빈 목록 표시로 대체)
            type: 'GET',
            dataType: 'json',
            success: function(list) {
                $ul.empty();
                if (!list || list.length === 0) {
                    $ul.append($('<li></li>').append($('<a href="javascript:void(0);" class="link"></a>').text('There are no frequently visited menu items.')));
                    return;
                }
                // [WN 검색 수정] 화면 노출은 FAVMENU_VIEW(3)개까지만 — 서버가 상위 10을 줘도 3개만 표시
                list.slice(0, FAVMENU_VIEW).forEach(function(m) {
                    var $li = $('<li></li>');
                    // [WN 검색 수정 - 표시 보정] 원본 DB 메뉴명에 HTML 엔티티(&middot; &amp; 등)가 문자열로
                    // 저장되어 있음. 검색결과(JSP EL 출력)는 브라우저가 엔티티를 해석해 · 로 보이지만,
                    // 모달은 JS .text() 로 넣어 "&middot;" 가 문자 그대로 노출됨 → 안전한 선별 치환으로 디코딩.
                    // (html() 사용은 XSS 위험이 있어 지정 엔티티만 치환)
                    var menuNmDisp = decodeEntities(m.menuNm);
                    // 클릭 시 통합검색으로 해당 메뉴명을 검색 (모달 검색 흐름과 일관)
                    var $a = $('<a class="link"></a>').text(menuNmDisp)
                        .attr('href', 'javascript:void(0);')
                        .on('click', function() { goSearch(menuNmDisp); });
                    $li.append($a);
                    $ul.append($li);
                });
            },
            error: function() {
                $ul.empty();
                $ul.append($('<li></li>').append($('<a href="javascript:void(0);" class="link"></a>').text('There are no frequently visited menu items.')));
            }
        });
    }

    // ===== 자동완성 (autocomplete.do, 300ms 디바운스) =====
    // 퍼블 규격: 매칭(입력값) 부분을 <span class="b-word"> 로 강조
    function renderAutoItem(keyword, q) {
        var $a = $('<a href="javascript:void(0);" class="link"></a>').on('click', function() { goSearch(keyword); });
        var lower = keyword.toLowerCase();
        var idx = lower.indexOf(q.toLowerCase());
        if (idx >= 0 && q.length > 0) {
            // 매칭 앞/매칭부(b-word)/매칭 뒤 — DOM 조립(text)로 XSS 안전하게 구성
            if (idx > 0) { $a.append(document.createTextNode(keyword.substring(0, idx))); }
            $a.append($('<span class="b-word"></span>').text(keyword.substr(idx, q.length)));
            if (idx + q.length < keyword.length) { $a.append(document.createTextNode(keyword.substring(idx + q.length))); }
        } else {
            $a.text(keyword);
        }
        return $('<li></li>').append($a);
    }

    var autoTimer = null;
    $('#layer-search-total').on('keyup', function() {
        var q = $(this).val().trim();

        // 퍼블 원본의 표시 토글 유지: 입력 있으면 자동완성 영역, 없으면 기본 영역
        if (q === '') {
            $('#search-auto-keyword').hide();
            $('#search-keyword-box').show();
            // [WN 검색 수정 - 요청] 관련부속사이트 미적용 — $('.bnr-wrap').show();
            clearTimeout(autoTimer);
            return;
        }
        $('#search-auto-keyword').show();
        $('#search-keyword-box').hide();
        // [WN 검색 수정 - 요청] 관련부속사이트 미적용 — $('.bnr-wrap').hide();

        clearTimeout(autoTimer);
        autoTimer = setTimeout(function() {
            $.getJSON(AUTO_URL, { query: q }, function(list) {
                // [WN 검색 수정 - 동시성] 응답 도착 시점의 현재 입력값과 요청 q 가 다르면 낡은 응답 — 버린다.
                // (빠른 타이핑 시 앞선 질의의 응답이 늦게 도착해 최신 목록을 덮는 것 방지)
                if (q !== $('#layer-search-total').val().trim()) { return; }
                var $ul = $('#modalAutoList').empty();
                if (!list || list.length === 0) {
                    $ul.append($('<li></li>').append($('<a href="javascript:void(0);" class="link"></a>').text('No autocomplete results.')));
                    return;
                }
                list.forEach(function(kw) { $ul.append(renderAutoItem(kw, q)); });
            });
        }, 300);
    });

    // ===== 초기 렌더 (localStorage 기반 — 저비용이므로 즉시) =====
    $(function() {
        renderRecent();
        renderFavMenus();
        // [WN 검색 수정 - 모바일 체감] 인기검색어 프리페치.
        // 기존에는 모달 접근 시점에 조회(lazy)했는데, ServiceKit 응답이 느리면 그 지연이
        // 사용자 대기시간으로 그대로 노출됨(모바일 5초 체감 보고). 페이지 로드 0.5초 뒤
        // 백그라운드로 미리 받아두면 지연이 체감되지 않고 모달은 즉시 표시된다.
        // popLoaded 플래그가 있어 모달 접근 시 중복 호출은 발생하지 않는다.
        setTimeout(loadPopular, 500);
    });

    
})(jQuery);
</script>

<!-- 전체 메뉴 -->
<div id="modal_menu_full" class="krds-modal all-menu" data-type="full" role="dialog" aria-labelledby="tit_modal_menu_full">
  <div class="modal-dialog">
    <div class="modal-content">
      <!-- modal title -->
      <div class="modal-header">
        <h2 id="tit_modal_menu_full" class="modal-title">All menu</h2>
      </div>
      <!-- //modal title -->
