                <label class="form-check"><input type="checkbox" name="customnav-5"><span>Consumer Protection</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-6"><span>Annual Supervision·Examination Plan</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-7"><span>Laws and Regulations</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-8"><span>Laws</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-9"><span>Regulations</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-10"><span>Announcement of Rule Changes</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-11"><span>Press Releases</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-12"><span>Speeches and Public Statements</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-13"><span>FSS Stories</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-14"><span>Annual Report</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-15"><span>Handbook</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-16"><span>Brochure</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-17"><span>References</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-18"><span>Korean-English Glossary</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-19"><span>About Financial Statistics</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-20"><span>Key Statistics by Financial Industry</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-21"><span>Regulation on Short Sales</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-22"><span>Management</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-23"><span>Organization</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-24"><span>Contact Us</span></label>
                <label class="form-check"><input type="checkbox" name="customnav-25"><span>Upcoming Events</span></label>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="popwrap__footer">
        <div class="page-btn-wrap both m-column">
              <div class="btn-wrap">
                <button type="button" class="krds-btn large tertiary mycustomNav-default">Default</button>
            <button type="button" class="krds-btn large primary mycustomNav-submit">Complete</button>
              </div>
          </div>
      </div>
    </div>
  </div>
</div>
<!-- //메뉴설정 -->

<script>
// #북마크 즐겨찾기 여러 개 대응
const subBookmarkSwipers = document.querySelectorAll('.my-bookmark-swiper.sub-menu-swiper .swiper');
subBookmarkSwipers.forEach((el) => {
	new Swiper(el, {
		// slidesPerView: 4,
		// spaceBetween: 32,
		// grid: {
		// 	rows: 2,
		// 	fill: "row",
		// },
		watchOverflow: true,
		observer: true,
		observeParents: true,
		navigation: {
			nextEl: el.closest('.my-bookmark-swiper.sub-menu-swiper').querySelector('.swiper-button-next'),
			prevEl: el.closest('.my-bookmark-swiper.sub-menu-swiper').querySelector('.swiper-button-prev'),
		},
		pagination: {
			el: el.closest('.my-bookmark-swiper.sub-menu-swiper').querySelector('.swiper-pagination'),
			clickable: true,
		},
		breakpoints: {
			0: {
				slidesPerView: 1,
				spaceBetween: 16,
				grid: {
					rows: 4,
					fill: "row"
				}
			},
			768: {
				slidesPerView: 2,
				spaceBetween: 16,
				grid: {
					rows: 4,
					fill: "row"
				}
			},
			1200: {
				slidesPerView: 4,
				spaceBetween: 32,
				grid: {
					rows: 2,
					fill: "row",
				}
			}
		},
		on: {
			init(swiper) {
				swpControlUI(swiper);
			},
			resize(swiper) {
				swpControlUI(swiper);
			},
			update(swiper) {
				swpControlUI(swiper);
			},
		},
	});
});
//모달 팝업 내 swiper 오픈 시, 정상 렌더링 안되는 문제 대응
document.addEventListener('click', () => {
	setTimeout(() => {
		document.querySelectorAll('.swiper').forEach(el => {
			el.swiper?.update();
		});
	}, 50); // 1프레임 정도
});

// ㄴ grid slide 가 1개인 경우 indicator hidden 처리
function swpControlUI(swiper) {

	// 현재 swiper 기준으로 탐색
	const container = swiper.el.closest('.my-bookmark-swiper.sub-menu-swiper');
	if (!container) return;
	const indicator = container.querySelector('.swiper-indicator');
	if (!indicator) return;

	// 페이지 개수 (grid 포함 정확 계산)
	const pageCount = swiper.snapGrid.length;

	// 1페이지면 숨김, 2페이지 이상이면 노출
	indicator.style.display = pageCount <= 1 ? 'none' : '';

}
</script>

