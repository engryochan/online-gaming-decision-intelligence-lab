				<a href="/cmmn/popup/ENG8.2.1.html" class="krds-btn medium link" title="new window" data-popup="800,800"><strong>Copyright Policy</strong></a>
				<a href="/fss/main/contents.do?menuNo=200759" class="krds-btn medium link basic" target="_blank" title="new window">Viewer Download</a>
			</div>
			<p class="f-copy">© Copyright financial supervisory service. All rights reserved.</p>
			<a href="https://www.wa.or.kr/board/list.asp?BoardID=0006" title="open in new window" target="_blank" class="f-mark"><img src="/static/fss/img/main/wa_logo.png" alt="Korea Federation of Organizations of the Disabled Korea Institute of Web Accessibility Certification and Value Web Accessibility Certification Mark" width="68" height="48"></a>
		</div>

		<!-- identifier -->
		<!-- <article class="krds-identifier">
			<span class="logo">
				<span class="sr-only">행정안전부</span>
			</span>
			<span class="ban-txt">이 누리집은 행정안전부 산하기관 누리집입니다.</span>
		</article> -->
		<!-- //identifier -->

	</section>
</div>

</footer>
