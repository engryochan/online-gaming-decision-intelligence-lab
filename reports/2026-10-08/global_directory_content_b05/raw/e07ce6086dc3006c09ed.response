                                <input class="default" id="idcaptcha_registro_8" name="captcha_idcaptcha_registro" type="radio" value="8"/>
                                <input type="hidden" class="keyHidd_idcaptcha_registro_8" value='MTUyODEyNTk1MTk5YWM0YWExOTE4MTc2MDhlYWUxYTc='/>
                                <input type="hidden" class="dateHidd_idcaptcha_registro_8" value='2026-10-08 03:44:48.523'/>
