0/svg" width="24" height="24"><use href="#eva-icons-chevron-right"></use></svg></a></li><li class="SideNavigationItem bKGabX"><a class="Link hxlSIK gMcxnl" href="/services/market-participants/participants-types" target="_self"><span>Participant Types</span><svg class="Icon bQczPV" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><use href="#eva-icons-chevron-right"></use></svg></a></li><li class="SideNavigationItem bKGabX"><a class="Link hxlSIK gMcxnl" href="/services/market-participants/participant-fees" target="_self"><span>Participant Fees</span><svg class="Icon bQczPV" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><use href="#eva-icons-chevron-right"></use></svg></a></li><li class="SideNavigationItem bKGabX"><a class="Link hxlSIK gMcxnl" href="/services/market-participants/all-market-participants" target="_self"><span>All Market Participants</span><svg class="Icon bQczPV" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><use href="#eva-icons-chevron-right"></use></svg></a></li><li class="SideNavigationItem bKGabX"><a class="Link hxlSIK gMcxnl" href="/services/market-participants/participant-portal" target="_self"><span>Participant Portal</span><svg class="Icon bQczPV" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="24" height="24"><use href="#eva-icons-chevron-right"></use></svg></a></li></ul></div></div><div class="Stack jBpqRq" style="overflow-x:hidden;overflow-y:hidden"><h1>Market Participants</h1><p> A Market Participant is a business accredited by NZX to participate in NZX markets. NZX also accredits financial advisors within these businesses as NZX Advisors. Find information about the types of market participants, participant fees and how to become a market participant in this section. </p><p>Rules for Market Participants can be found <a class="Link hxlSIK gMcxnl" href="/regulation/nzx-rules-guidance/participant-guidance" target="_self">here</a>.</p><a c