  if (!window.__bruceNewsletterHsFormsInitialized) {
    window.__bruceNewsletterHsFormsInitialized = true;

    const scriptId = 'hubspot-forms-embed-script';
    const scriptSrc = 'https://js.hsforms.net/forms/embed/50368110.js';

    // The embed script renders the form once and watches the original <body> for
    // new frames. Astro's ClientRouter swaps the <body> on navigation, orphaning
    // that observer — so the rendered form is kept across pages via
    // `transition:persist` on the .hs-form-frame instead of re-initializing here.
    const loadNewsletterForms = () => {
      if (document.getElementById(scriptId)) return;

      const script = document.createElement('script');
      script.id = scriptId;
      script.src = scriptSrc;
      script.defer = true;
      document.head.appendChild(script);
    };

    document.addEventListener('astro:page-load', loadNewsletterForms);
  }
</script>  </main> <footer class="site-footer text-white border-t border-white/5 py-12 px-6" data-astro-cid-sz7xmlte> <section class="pt-12 pb-32 px-6"> <div class="container mx-auto"> <h2 class="text-4xl md:text-5xl font-light text-white mb-6 leading-tight">
