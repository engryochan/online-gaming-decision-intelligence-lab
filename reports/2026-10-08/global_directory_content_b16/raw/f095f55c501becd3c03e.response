	  <style>
/* ===== Desktop only (>= 1281px) ===== */
@media (min-width: 1281px) {
  .navbar ul {
    list-style: none;
    display: flex;
    padding: 0;
    margin: 0;
  }

  .navbar ul li {
    margin: 0 5px; /* ລະຍະຫ່າງດ້ານຂ້າງ */
  }

  .navbar ul li a {
    text-decoration: none;
    color: white;
    padding: 8px 5px;
    letter-spacing: -0.4px;
  }
}

/* =========================================================================
   Mobile (<= 1280px) — ການອອກແບບເມນູ hamburger ໃຫ້ມີສັດສ່ວນ ແລະ ງາມ
   ໂຄງສີຫຼັກ: #084298 (ນ້ຳເງິນເຂັ້ມ), ນ້ຳເງິນອ່ອນເປັນພື້ນຫຼັງຊັ້ນຍ່ອຍ
   ກວມເອົາການ zoom 200% ໃນໜ້າຈໍ 2K/4K ນຳ
   ========================================================================= */
@media (max-width: 1280px) {

  /* --- ບັງຄັບໃຫ້ hamburger ສະແດງ (ຖ້າ main.css/style.css ມີ rule ບັງເຊື່ອງ) --- */
  .mobile-nav-toggle,
  i.bi-list.mobile-nav-toggle {
    display: inline-block !important;
  }
  /* --- ເຊື່ອງ ul ດ້ານໃນ desktop mode ເພື່ອໃຫ້ເມນູ hamburger ເຮັດວຽກ --- */
  body:not(.mobile-nav-active) .navbar > ul {
    display: none !important;
  }

  /* --- ກອບເມນູໃຫຍ່ (ul ຊັ້ນນອກ) --- */
  .navbar > ul {
    background-color: #ffffff !important;
    border-radius: 12px !important;
    box-shadow: 0 10px 30px rgba(8, 66, 152, 0.18) !important;
    overflow: hidden !important;
    padding: 0 !important;
  }

  /* --- ລາຍການຊັ້ນ 0 (ເມນູໃຫຍ່) --- */
  .navbar > ul > li {
    border-bottom: 1px solid #eef2f8;
    margin: 0 !important;
  }
  .navbar > ul > li:last-child {
    border-bottom: none;
  }
  .navbar > ul > li > a {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    flex-wrap: nowrap !important;
    width: 100%;
    padding: 14px 20px !important;
    font-family: "Phetsarath OT", sans-serif;
    font-size: 16px !important;
    font-weight: 600 !important;
    color: #084298 !important;
    letter-spacing: 0 !important;
    white-space: normal !important;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  /* --- ບັງຄັບໃຫ້ span ພາຍໃນ link ສະແດງຊັດເຈນ (ແກ້ບັນຫາ 4 ເມນູໃຫຍ່ຫາຍ) --- */
  .navbar > ul > li > a > span,
  .navbar > ul > li > ul > li > a > span,
  .navbar > ul > li > ul > li > ul > li > a > span {
    color: inherit !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
    font: inherit !important;
    font-family: "Phetsarath OT", sans-serif !important;
    line-height: inherit !important;
    letter-spacing: inherit !important;
    flex: 1 1 auto !important;
    min-width: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    text-indent: 0 !important;
    white-space: normal !important;
    word-break: break-word !important;
    overflow-wrap: anywhere !important;
    text-shadow: none !important;
    background: transparent !important;
    -webkit-text-fill-color: currentColor !important;
  }
  .navbar > ul > li > a:hover,
  .navbar > ul > li > a.active {
    background: linear-gradient(to right, #2f9ef3, #084298) !important;
    color: #ffffff !important;
  }
  .navbar > ul > li > a:hover span,
  .navbar > ul > li > a:hover i,
  .navbar > ul > li > a.active span,
  .navbar > ul > li > a.active i {
    color: #ffffff !important;
    -webkit-text-fill-color: #ffffff !important;
  }

  /* --- ເຊື່ອງ dropdown ຍ່ອຍເປັນຄ່າເລີ່ມຕົ້ນ --- */
  .navbar .dropdown ul,
  .navbar .dropdown .dropdown ul,
  .navbar .dropdown .dropdown .dropdown ul {
    display: none !important;
    position: static !important;
    margin: 0 !important;
    padding: 0 !important;
    box-shadow: none !important;
    border-radius: 0 !important;
  }

  /* --- ເປີດ dropdown ເມື່ອມີ class .dropdown-active --- */
  .navbar .dropdown ul.dropdown-active,
  .navbar .dropdown .dropdown ul.dropdown-active,
  .navbar .dropdown .dropdown .dropdown ul.dropdown-active {
    display: block !important;
  }

  /* --- ຊັ້ນ 1 (dropdown ແຖວທຳອິດ) --- */
  .navbar > ul > li > ul {
    background-color: #f3f7fc !important;
    border-top: 1px solid #dfe9f4;
  }
  .navbar > ul > li > ul > li {
    margin: 0 !important;
    border-bottom: 1px solid #e5ecf5;
  }
  .navbar > ul > li > ul > li:last-child {
    border-bottom: none;
  }
  .navbar > ul > li > ul > li > a {
    display: flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    flex-wrap: nowrap !important;
    width: 100%;
    padding: 11px 20px 11px 36px !important;
    font-size: 14.5px !important;
    font-weight: 500 !important;
    color: #0a3b7c !important;
    white-space: normal !important;
    position: relative;
  }
  .navbar > ul > li > ul > li > a::before {
    content: "";
    position: absolute;
    left: 22px;
    top: 50%;
    width: 6px;
    height: 6px;
    background-color: #2f9ef3;
    border-radius: 50%;
    transform: translateY(-50%);
    opacity: 0.7;
  }
  .navbar > ul > li > ul > li > a:hover {
    background-color: #e1ecf8 !important;
    color: #084298 !important;
  }

  /* --- ຊັ້ນ 2 (dropdown ຍ່ອຍຕໍ່ໄປ) --- */
  .navbar > ul > li > ul > li > ul {
    background-color: #e9f0f9 !important;
    border-top: 1px dashed #c6d4e8;
  }
  .navbar > ul > li > ul > li > ul > li {
    margin: 0 !important;
    border-bottom: 1px dashed #d4ddeb;
  }
  .navbar > ul > li > ul > li > ul > li:last-child {
    border-bottom: none;
  }
  .navbar > ul > li > ul > li > ul > li > a {
    display: flex !important;
    align-items: center !important;
    width: 100%;
    padding: 9px 20px 9px 56px !important;
    font-size: 13.5px !important;
    font-weight: 400 !important;
    color: #1a4586 !important;
    position: relative;
  }
  .navbar > ul > li > ul > li > ul > li > a::before {
    content: "\2013"; /* ขีด en-dash */
    position: absolute;
    left: 42px;
    color: #6690c4;
  }
  .navbar > ul > li > ul > li > ul > li > a:hover {
    background-color: #d6e4f4 !important;
    color: #084298 !important;
  }

  /* --- ໄອຄອນລູກສອນ dropdown (push to right) --- */
  .navbar .dropdown > a .dropdown-indicator {
    font-size: 12px !important;
    margin-left: auto !important;
    padding-left: 10px !important;
    color: inherit !important;
    transition: transform 0.25s ease;
    flex-shrink: 0 !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
  }

  /* --- ປຸ່ມ EN (ພິເສດ: ເຮັດໃຫ້ເຫັນຊັດເຈນໃນ hamburger mobile) --- */
  .navbar > ul > li:has(> ul > li > a[href="EN"]),
  .navbar > ul > li:has(> ul > li > a[href="../EN"]) {
    background-color: #084298 !important;
    border-bottom: none !important;
    padding: 6px 16px !important;
  }
  .navbar > ul > li > ul:has(> li > a[href="EN"]),
  .navbar > ul > li > ul:has(> li > a[href="../EN"]) {
    background: transparent !important;
    border-top: none !important;
    display: flex !important;
    justify-content: center !important;
    padding: 6px 0 !important;
  }
  .navbar > ul > li > ul > li:has(> a[href="EN"]),
  .navbar > ul > li > ul > li:has(> a[href="../EN"]) {
    border-bottom: none !important;
    list-style: none !important;
  }
  .navbar ul li a[href="EN"],
  .navbar ul li a[href="../EN"] {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    border: 2px solid #ffffff !important;
    border-radius: 6px !important;
    height: auto !important;
    padding: 8px 28px !important;
    background-color: transparent !important;
    color: #ffffff !important;
    font-weight: 700 !important;
    font-size: 16px !important;
    letter-spacing: 1px !important;
  }
  .navbar ul li a[href="EN"]::before,
  .navbar ul li a[href="../EN"]::before {
    display: none !important;
  }
  .navbar ul li a[href="EN"] span,
  .navbar ul li a[href="../EN"] span {
    color: #ffffff !important;
    margin-left: 0 !important;
    font-weight: 700 !important;
  }
  .navbar ul li a[href="EN"]:hover,
  .navbar ul li a[href="../EN"]:hover {
    background-color: #ffffff !important;
    color: #084298 !important;
  }
  .navbar ul li a[href="EN"]:hover span,
  .navbar ul li a[href="../EN"]:hover span {
    color: #084298 !important;
  }

  /* --- ຊ່ອງຄົ້ນຫາໃນ hamburger --- */
  .navbar .search-container {
    padding: 12px 16px !important;
    display: block !important;
    position: relative !important;
    width: 100% !important;
  }

  /* ໄອຄອນຄົ້ນຫາ: ສະແດງເປັນປຸ່ມກວ້າງເຕັມແຖວ */
  .navbar .search-icon {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px;
    width: 100% !important;
    background: #f3f7fc !important;
    border: 1px solid #dfe9f4 !important;
    border-radius: 8px !important;
    padding: 10px 14px !important;
    color: #084298 !important;
    font-size: 18px !important;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }
  .navbar .search-icon:hover {
    background: #e1ecf8 !important;
  }
  .navbar .search-icon i {
    color: #084298 !important;
    font-size: 18px !important;
  }

  /* ເມື່ອ search-box ມີ class .show → ເຊື່ອງໄອຄອນ, ສະແດງ box ແທນ */
  .navbar .search-container:has(.search-box.show) .search-icon {
    display: none !important;
  }

  /* form container */
  .navbar .search-container form {
    width: 100% !important;
    margin: 0 !important;
  }

  /* ຊ່ອງຄົ້ນຫາໃນ mobile: ສະແດງເຕັມແຖວ ບໍ່ໃຊ້ absolute */
  .navbar .search-box {
    position: static !important;
    transform: none !important;
    width: 100% !important;
    max-width: 100% !important;
    right: auto !important;
    top: auto !important;
    opacity: 0 !important;
    display: none !important;
    align-items: center !important;
    background: #ffffff !important;
    padding: 6px 8px !important;
    border: 2px solid #084298 !important;
    border-radius: 8px !important;
    box-shadow: 0 2px 6px rgba(8,66,152,0.12) !important;
    overflow: visible !important;
  }
  .navbar .search-box.show {
    display: flex !important;
    opacity: 1 !important;
    width: 100% !important;
    right: auto !important;
  }
  .navbar .search-box i {
    position: static !important;
    left: auto !important;
    color: #084298 !important;
    margin-right: 8px !important;
    font-size: 16px !important;
    flex-shrink: 0;
  }
  .navbar .search-box input {
    flex: 1 1 auto !important;
    width: auto !important;
    padding: 6px 0 !important;
    font-size: 14px !important;
    font-family: "Phetsarath OT", sans-serif !important;
    color: #084298 !important;
    background: transparent !important;
  }
  .navbar .search-box button {
    background: #084298 !important;
    color: #ffffff !important;
    padding: 6px 14px !important;
    border-radius: 6px !important;
    font-size: 14px !important;
    font-family: "Phetsarath OT", sans-serif !important;
    flex-shrink: 0 !important;
    margin-left: 6px !important;
  }
  .navbar .search-box button:hover {
    background: #0a3b7c !important;
  }

  /* --- ກວ້າງເຕັມຂອງກອບເມນູມືຖື --- */
  .mobile-nav-active .navbar > ul {
    inset: 70px 15px 15px 15px !important;
    max-height: calc(100vh - 85px) !important;
    overflow-y: auto !important;
    width: auto !important;
    left: 15px !important;
    right: 15px !important;
  }

  /* --- ລ້າງ inline margin-left/margin-right ຂອງ nav
         (ບາງໜ້າໃຊ້ sub_menu() ທີ່ໃສ່ margin-left: 9%)
         ເພື່ອບໍ່ໃຫ້ເມນູຖືກດັນອອກທາງຂວາຂອງຈໍ --- */
  nav#navbar.navbar,
  .mobile-nav-active nav#navbar.navbar {
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  /* --- ຫຼຸດຂະໜາດ font ພາຍໃນ dropdown ຍ່ອຍ ເພື່ອບໍ່ໃຫ້ບໍລິຈອດຂໍ້ຄວາມລ້ນ --- */
  .navbar > ul > li > ul > li > ul > li > a {
    font-size: 13px !important;
    padding-left: 48px !important;
    padding-right: 16px !important;
  }
}

</style>

     <style>
        /* Container ຂອງຊ່ອງຄົ້ນຫາ */
        .search-container {
            position: relative;
            display: flex;
            align-items: center;
        }

        /* ປຸ່ມໄອຕອນຄົ້ນຫາເລີ່ມຕົ້ນ */
        .search-icon {
            background: none;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
            transition: transform 0.3s ease;
        }

        /* ຊ່ອງຄົ້ນຫາທີ່ຂະຫຍາຍອອກໄປທາງຊ້າຍ */
        .search-box {
            width: 0;
            opacity: 0;
            transition: width 0.3s ease, opacity 0.3s ease;
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            background: white;
            padding: 5px;
            border-radius: 5px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.2);
            display: flex;
            align-items: center;
            overflow: hidden;
        }

        /* ຊ່ອງ input */
        .search-box input {
            width: 180px;
            border: none;
            outline: none;
            padding-left: 30px;
        }

        /* ໄອຄອນທີ່ຢູ່ພາຍໃນຊ່ອງຄົ້ນຫາ */
        .search-box i {
            position: absolute;
            left: 10px;
            color: gray;
        }

        /* ປຸ່ມຄົ້ນຫາ */
        .search-box button {
            border: none;
            background: #007bff;
            color: white;
            padding: 5px 10px;
            border-radius: 5px;
            cursor: pointer;
            margin-left: 5px;
        }

        /* ເມື່ອເປີດຊ່ອງຄົ້ນຫາ */
        .search-box.show {
            width: 250px;
            opacity: 1;
            right: -220px;
        }
    </style>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchIcon = document.getElementById("search-icon");
        const searchBox = document.getElementById("search-box");
        const searchInput = document.getElementById("search-input");
        const searchBtn = document.getElementById("search-btn");

        // ເມື່ອກົດໄອຄອນໃຫ້ຂະຫຍາຍອອກໄປທາງຊ້າຍຂອງຈໍ
        searchIcon.addEventListener("click", function (event) {
            event.stopPropagation(); // ປ້ອງກັນການເຊື່ອງເມື່ອກົດໄອຄອນ
            searchBox.classList.toggle("show");
            if (searchBox.classList.contains("show")) {
                searchInput.focus(); // ໃຫ້ເນັ້ນໜັກໄປທີ່ໍຊ່ອງຄົ້ນຫາ
            }
        });

        // ຖ້າກົດບ່ອນອື່ນ ໃຫ້ເຊື່ອງປ່ອງຄົ້ນຫາ
        document.addEventListener("click", function (event) {
            if (!searchBox.contains(event.target) && event.target !== searchIcon) {
                searchBox.classList.remove("show");
            }
        });

        // ເມື່ອກົດຄົ້ນຫາ
//        searchBtn.addEventListener("click", function () {
//            alert("คุณค้นหา: " + searchInput.value);
//        });
    });
</script>

<!-- ===== Mobile dropdown toggle (ເປີດ/ປິດ sub-menu ຕອນຢູ່ໃນມືຖື ຫຼື ຂະຫຍາຍຫຼາຍ) ===== -->
<script>
(function () {
  // ໃຊ້ event delegation ໃນ capture phase ເພື່ອບໍ່ໃຫ້ຂັດແຍ່ງກັບ handler ອື່ນ
  document.addEventListener('click', function (e) {
    // ເຮັດວຽກສະເພາະເມື່ອເມນູມືຖືເປີດ (body ມີ class .mobile-nav-active)
    if (!document.body.classList.contains('mobile-nav-active')) return;

    // ຊອກຫາ link ທີ່ເປັນ dropdown parent
    var link = e.target.closest('.navbar li.dropdown > a');
    if (!link) return;

    // ຊອກຫາ sibling ul
    var sub = link.nextElementSibling;
    if (!sub || sub.tagName !== 'UL') return;

    // ຢຸດການໄປຕາມ link + ຢຸດ event ບໍ່ໃຫ້ໄປຕໍ່ (ປ້ອງກັນ main_slide_show.js ຕີກັນ)
    e.preventDefault();
    e.stopPropagation();

    // ເປີດ/ປິດ
    sub.classList.toggle('dropdown-active');
    link.classList.toggle('active');

    // ສະຫຼັບໄອຄອນລູກສອນ
    var ind = link.querySelector('.dropdown-indicator');
    if (ind) {
      if (ind.classList.contains('bi-chevron-down')) {
        ind.classList.remove('bi-chevron-down');
        ind.classList.add('bi-chevron-up');
      } else if (ind.classList.contains('bi-chevron-up')) {
        ind.classList.remove('bi-chevron-up');
        ind.classList.add('bi-chevron-down');
      } else if (ind.classList.contains('bi-chevron-right')) {
        ind.classList.remove('bi-chevron-right');
        ind.classList.add('bi-chevron-down');
      }
    }
  }, true); // capture = true
})();
</script>

