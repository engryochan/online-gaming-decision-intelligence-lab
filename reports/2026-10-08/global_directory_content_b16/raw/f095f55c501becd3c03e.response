<script>
document.addEventListener("DOMContentLoaded", function() {
  let menuTitles = document.querySelectorAll(".sidebar-title");
  let menuItems = document.querySelectorAll(".sidebar-item ul");

  // ซ่อนเมนูทั้งหมดก่อน
  menuItems.forEach(menu => {
    menu.style.display = "none";
  });

  // ตรวจสอบให้เมนูที่ใช้งานอยู่เปิดอัตโนมัติ
  let activeMenu = window.location.pathname.split('/').pop(); // ใช้ URL เพื่อหาชื่อไฟล์
  menuTitles.forEach(title => {
    let menuLink = title.nextElementSibling.querySelector("ul");
    if (menuLink) {
      let links = menuLink.querySelectorAll('a');
      links.forEach(link => {
        if (link.getAttribute('href') === activeMenu) {
          title.classList.add("active");
          menuLink.style.display = "block";
        }
      });
    }
  });

  // คลิกเพื่อเปิด/ปิดเมนู
  menuTitles.forEach(title => {
    title.addEventListener("click", function() {
      // ปิดเมนูอื่น
      menuTitles.forEach(t => {
        if (t !== this) {
          t.classList.remove("active");
          let otherMenu = t.nextElementSibling.querySelector("ul");
          if (otherMenu) {
            otherMenu.style.display = "none";
          }
        }
      });
      // เปิดเมนูที่ถูกคลิก
      this.classList.toggle("active");
      let menu = this.nextElementSibling.querySelector("ul");
      if (menu) {
        if (menu.style.display === "none") {
          menu.style.display = "block";
        } else {
          menu.style.display = "none";
        }
      }
    });
  });
});


</script>
            

