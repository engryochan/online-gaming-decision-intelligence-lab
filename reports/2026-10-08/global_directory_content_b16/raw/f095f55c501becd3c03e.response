<!--LOGO-->
<style>
	#navbar {
  position: fixed;
  top: 0;
  width: 100%;
  background-color: transparent;
  z-index: 1000;
  transition: padding 0.3s; /* Smooth transition */
  padding: 20px; /* Initial padding */
}

#logo {
  width: 130px; /* Initial size */
  transition: width 0.3s; /* Smooth transition */
}

#navbar.scrolled {
  padding: 50px; /* Reduced padding when scrolled */
}

#logo.scrolled {
  width: 80px; /* Smaller logo size when scrolled */
}

/* ===== Logo positioning — ຕຳເໝ່ງດຽວກັນທຸກຂະໝາດໝ້າຈໍ (ຄືກັນກັບໝ້າຫຼັກ) ===== */
@media (max-width: 991px) {
  header#header .container-fluid,
  header#header > .container-xl,
  header#header > .col-md-7 {
    max-width: 100% !important;
    width: 100% !important;
    flex: 1 1 100% !important;
    justify-content: flex-start !important;
    padding-left: 15px !important;
    padding-right: 15px !important;
    min-height: 70px !important;
  }
  header#header > .container-fluid > a.logo:empty,
  header#header > .container-xl > a.logo:empty {
    display: none !important;
  }
  div#navbar {
    position: static !important;
    padding: 0 !important;
    margin: 0 !important;
    width: auto !important;
    flex: 0 0 auto !important;
    text-align: left !important;
  }
  div#navbar > div:first-child {
    margin: 0 !important;
    padding: 0 !important;
    text-align: left !important;
    display: inline-block !important;
  }
  #navbar #logo,
  img#logo,
  #navbar img.logo {
    position: fixed !important;
    top: 8px !important;
    left: 15px !important;
    z-index: 10000 !important;
    margin: 0 !important;
    padding: 0 !important;
    width: 110px !important;
    max-width: 28vw !important;
    height: auto !important;
    display: inline-block !important;
    visibility: visible !important;
    opacity: 1 !important;
    transform: none !important;
    filter: drop-shadow(0 0 0.15rem rgba(0,0,0,0.35)) !important;
  }
  #navbar .search-form-wrap {
    display: none !important;
  }
  .mobile-nav-toggle,
  i.bi-list.mobile-nav-toggle {
    position: fixed !important;
    top: 15px !important;
    right: 15px !important;
    z-index: 10001 !important;
    margin: 0 !important;
    font-size: 30px !important;
    color: #ffffff !important;
  }
}
@media (max-width: 480px) {
  #navbar #logo,
  img#logo,
  #navbar img.logo {
    width: 80px !important;
    max-width: 25vw !important;
    top: 10px !important;
    left: 10px !important;
  }
}
