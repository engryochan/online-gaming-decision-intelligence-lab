uote_block_v1","id":"a09db856-a97f-424d-8582-cef4c52a3c32","resourceIdObjMeta":{"target_revision_id":304833,"drupal_internal__target_id":70631}},{"type":"paragraph--text_block_v1","id":"c01172a9-22f7-4df5-af6c-cfd83dee7452","resourceIdObjMeta":{"target_revision_id":304834,"drupal_internal__target_id":70632}}],"field_right_content_data":[],"field_secondary_categories":[],"field_sectors":[],"relationshipNames":["node_type","revision_uid","uid","field_banner_image","field_categories","field_country","field_craft","field_domain_access","field_domain_source","field_edit_permission","field_free_tag","field_image","field_news_main_conten","field_right_content_data","field_secondary_categories","field_sectors"]},{"type":"node--actualite","id":"055c32e6-9b54-4039-8433-9beb32ead2cf","drupal_internal__nid":3650,"drupal_internal__vid":20466,"langcode":"en","revision_timestamp":"2026-09-24T16:09:01+00:00","status":true,"title":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands","created":"2026-09-24T09:20:01+00:00","changed":{"value":"2026-09-24T16:09:01+00:00","preserve":null},"promote":false,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"breadcrumbs":[{"uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en","resolvable_uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en","title":"Home","options":[]},{"uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/news","resolvable_uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/news","title":"News","options":[]}],"content_translation_source":"und","content_translation_outdated":false,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands | Crédit Agricole CIB"}},{"tag":"meta","attributes":{"name":"description","content":"Crédit Agricole CIB announces the opening of a representative office in Amsterdam, Netherlands, marking a significant step in the Bank's European expansion strategy and its commitment to the Dutch market."}},{"tag":"meta","attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},{"tag":"meta","attributes":{"property":"og:type","content":"news"}},{"tag":"meta","attributes":{"property":"og:url","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/views/news_list/block_news_highlight_more_link"}},{"tag":"meta","attributes":{"property":"og:title","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands"}},{"tag":"meta","attributes":{"property":"og:description","content":"Crédit Agricole CIB announces the opening of a representative office in Amsterdam, Netherlands, marking a significant step in the Bank's European expansion strategy and its commitment to the Dutch market."}},{"tag":"meta","attributes":{"property":"og:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/GeorgLise_55553_CDN_images.jpg?h=7a926e85\u0026itok=ntAcIX9U"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}},{"tag":"meta","attributes":{"name":"twitter:description","content":"Crédit Agricole CIB announces the opening of a representative office in Amsterdam, Netherlands, marking a significant step in the Bank's European expansion strategy and its commitment to the Dutch market."}},{"tag":"meta","attributes":{"name":"twitter:title","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands"}},{"tag":"meta","attributes":{"name":"twitter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/GeorgLise_55553_CDN_images.jpg?h=7a926e85\u0026itok=ntAcIX9U"}},{"tag":"meta","attributes":{"name":"@type","content":"NewsArticle","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"headline","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"name","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"articleBody","content":"The new representative office will focus on marketing the Bank's capabilities to Dutch clients and international companies with material activities in the Netherlands, while strengthening commercial relationships. All banking or investment services will continue to be delivered by licensed Crédit Agricole CIB entities operating from the Bank's established branches or subsidiaries.The decision to establish a presence in the Netherlands reflects the significant opportunities the market has as it navigates major transitions in energy, infrastructure, and technology. The Netherlands is home to companies undertaking some of Europe's most ambitious investment programmes, requiring banking partners with deep sector expertise and cross-border capabilities.The physical presence will also enable more intensive client engagement and leverage local market knowledge, whilst Dutch language capabilities will support deeper client relationships.The opening of the representative office aligns with Crédit Agricole's Medium-Term Plan through 2028, which emphasises internationalisation, European growth, and a proactive approach to market development.Erik Brommer will become the Representative Officer of the Netherlands representative office. Based in Amsterdam, Erik will report to Lise Kessler, Senior Country Officer for the Benelux., full_html","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"abstract","content":["Crédit Agricole CIB announces the opening of a representative office in Amsterdam","Netherlands","marking a significant step in the Bank's European expansion strategy and its commitment to the Dutch market. "],"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"image","content":{"@type":"ImageObject","url":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/large/public/GeorgLise_55553_CDN_images.jpg?itok=Pntx1sS6"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"datePublished","content":"2026-09-24T00:00:00+0200","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"dateModified","content":"2026-09-24T18:09:01+0200","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"mainEntityOfPage","content":"/en/news","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"@type","content":"VideoObject","group":"schema_video_object","schema_metatag":true}}],"path":{"alias":"/news/credit-agricole-cib-strengthens-its-presence-benelux-representative-office-opening-netherlands","pid":7755,"langcode":"en"},"cacib_extra_paths":[{"alias":"/en/news/credit-agricole-cib-strengthens-its-presence-benelux-representative-office-opening-netherlands","langcode":"en"}],"cacib_extra_metatags":[{"title":{"#tag":"meta","#attributes":{"name":"title","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands | Crédit Agricole CIB"}},"description":{"#tag":"meta","#attributes":{"name":"description","content":"Crédit Agricole CIB announces the opening of a representative office in Amsterdam, Netherlands, marking a significant step in the Bank's European expansion strategy and its commitment to the Dutch market."}},"og_site_name":{"#tag":"meta","#attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},"og_type":{"#tag":"meta","#attributes":{"property":"og:type","content":"news"}},"og_url":{"#tag":"meta","#attributes":{"property":"og:url","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/views/news_list/block_news_highlight_more_link"}},"og_title":{"#tag":"meta","#attributes":{"property":"og:title","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands"}},"og_description":{"#tag":"meta","#attributes":{"property":"og:description","content":"Crédit Agricole CIB announces the opening of a representative office in Amsterdam, Netherlands, marking a significant step in the Bank's European expansion strategy and its commitment to the Dutch market."}},"og_image_0":{"#tag":"meta","#attributes":{"property":"og:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/GeorgLise_55553_CDN_images.jpg?h=7a926e85\u0026itok=ntAcIX9U"}},"twitter_cards_type":{"#tag":"meta","#attributes":{"name":"twitter:card","content":"summary_large_image"}},"twitter_cards_description":{"#tag":"meta","#attributes":{"name":"twitter:description","content":"Crédit Agricole CIB announces the opening of a representative office in Amsterdam, Netherlands, marking a significant step in the Bank's European expansion strategy and its commitment to the Dutch market."}},"twitter_cards_title":{"#tag":"meta","#attributes":{"name":"twitter:title","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands"}},"twitter_cards_image":{"#tag":"meta","#attributes":{"name":"twitter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/GeorgLise_55553_CDN_images.jpg?h=7a926e85\u0026itok=ntAcIX9U"}},"schema_article_type":{"#tag":"meta","#attributes":{"name":"@type","content":"NewsArticle","group":"schema_article","schema_metatag":true}},"schema_article_headline":{"#tag":"meta","#attributes":{"name":"headline","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands","group":"schema_article","schema_metatag":true}},"schema_article_name":{"#tag":"meta","#attributes":{"name":"name","content":"Crédit Agricole CIB strengthens its presence in Benelux with Representative Office opening in the Netherlands","group":"schema_article","schema_metatag":true}},"schema_article_article_body":{"#tag":"meta","#attributes":{"name":"articleBody","content":"The new representative office will focus on marketing the Bank's capabilities to Dutch clients and international companies with material activities in the Netherlands, while strengthening commercial relationships. All banking or investment services will continue to be delivered by licensed Crédit Agricole CIB entities operating from the Bank's established branches or subsidiaries.The decision to establish a presence in the Netherlands reflects the significant opportunities the market has as it navigates major transitions in energy, infrastructure, and technology. The Netherlands is home to companies undertaking some of Europe's most ambitious investment programmes, requiring banking partners with deep sector expertise and cross-border capabilities.The physical presence will also enable more intensive client engagement and leverage local market knowledge, whilst Dutch language capabilities will support deeper client relationships.The opening of the representative office aligns with Crédit Agricole's Medium-Term Plan through 2028, which emphasises internationalisation, European growth, and a proactive approach to market development.Erik Brommer will become the Representative Officer of the Netherlands representative office. Based in Amsterdam, Erik will report to Lise Kessler, Senior Country Officer for the Benelux., full_html","group":"schema_article","schema_metatag":true}},"schema_article_abstract_0":{"#tag":"meta","#attributes":{"name":"abstract","content":["Crédit Agricole CIB announces the opening of a representative office in Amsterdam","Netherlands","marking a significant step in the Bank's European expansion strategy and its commitment to the Dutch market. "],"group":"schema_article","schema_metatag":true}},"schema_article_image":{"#tag":"meta","#attributes":{"name":"image","content":{"@type":"ImageObject","url":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/large/public/GeorgLise_55553_CDN_images.jpg?itok=Pntx1sS6"},"group":"schema_article","schema_metatag":true}},"schema_article_date_published":{"#tag":"meta","#attributes":{"name":"datePublished","content":"2026-09-24T00:00:00+0200","group":"schema_article","schema_metatag":true}},"schema_article_date_modified":{"#tag":"meta","#attributes":{"name":"dateModified","content":"2026-09-24T18:09:01+0200","group":"schema_article","schema_metatag":true}},"schema_article_author_0":{"#tag":"meta","#attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},"schema_article_publisher":{"#tag":"meta","#attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},"schema_article_main_entity_of_page":{"#tag":"meta","#attributes":{"name":"mainEntityOfPage","content":"/en/news","group":"schema_article","schema_metatag":true}},"schema_video_object_type":{"#tag":"meta","#attributes":{"name":"@type","content":"VideoObject","group":"schema_video_object","schema_metatag":true}}}],"cacib_menu_tree":[],"body":{"value":"Crédit Agricole CIB announces the opening of a representative office in Amsterdam, Netherlands, marking a significant step in t