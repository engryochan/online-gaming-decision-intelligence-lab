<style id="wp-custom-css">
form label, form .gfield_label {
	color:#ffffff;
}
  form .gfield_description {
	color:#B2C9EB;
}
.gform_wrapper input[type="radio"] {
    width: 18px !important;
    height: 18px !important;
    min-width: 18px;
    padding: 0 !important;
    margin: 0 10px 0 0 !important;
    display: inline-block !important;
    appearance: auto;
    -webkit-appearance: radio;
    border: initial;
    border-radius: 50%;
}
.gform_wrapper .gfield_radio .gchoice {
    display: flex;
    align-items: center;
    margin-bottom: 14px;
}

.gform_wrapper .gfield_radio label {
    display: inline-block;
    margin: 0;
}

/* Gravity Forms file upload area */
.gform_wrapper .ginput_container_fileupload {
    margin-top: 16px;
}

/* Drop zone */
.gform_wrapper .gform_drop_area {
    border: 1px dashed rgba(255, 255, 255, 0.45) !important;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.03);
    padding: 28px 24px !important;
    text-align: center;
    transition: border-color 0.2s ease, background-color 0.2s ease;
}

.gform_wrapper .gform_drop_area:hover,
.gform_wrapper .gform_drop_area:focus-within {
    border-color: #68f5b3 !important;
    background: rgba(104, 245, 179, 0.05);
}

/* “Drop files here or” text */
.gform_wrapper .gform_drop_instructions {
    display: block;
    margin-bottom: 14px;
    color: #b9cbea;
    font-size: 16px;
    line-height: 1.5;
}

/* Select files button */
.gform_wrapper .gform_button_select_files {
    width: auto !important;
    min-height: 44px;
    padding: 10px 18px !important;
    border: 1px solid #68f5b3 !important;
    border-radius: 6px;
    background: transparent !important;
    color: #ffffff !important;
    font-size: 15px;
    font-weight: 600;
