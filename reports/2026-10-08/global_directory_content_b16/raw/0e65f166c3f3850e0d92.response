        <ul>
            <li>
                <input type="submit"  value="الحاليين"  name="current" id ="current"  class="btn active tab" onclick="getTable(this.name);printPriviewType(this.name)">
            </li>
            <li>
                <input type="submit"  value="السابقين" name="previous" id ="previous"  class="btn tab"  onclick="getTable(this.name);printPriviewType(this.name)">
            </li>
