 background-color 0.3s ease;\n  white-space: nowrap;\n}\n\n.feedback-link:hover {\n  background-color: #32a76b;\n}\n\u003C\/style\u003E\n","check_cookie":"1","expire":"0","width":"900","height":"500","delay":"0","close_delay":"0","cover_opacity":"50","hash":"5ba3e0e961f057a935d329b32ef1f472e0114d997fd39f343ae8902af0ebb2af"},"user":{"uid":0,"permissionsHash":"31d422fefc88ac453eea2e93541f0084f29cec6069e16f1da0f40609e58c9d8e"}}</script>
