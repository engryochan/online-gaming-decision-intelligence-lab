<style>
	#frmLogin input[type="text"],
	#frmLogin input[type="password"]{
		max-width: 400px;
	}
</style>

<script nonce="pQGb8p5MiF7Jn//xyN7hKg==">
	$(function(){
		$("#frmLogin").on("submit", function(){
			let $rememberMe = $("#rememberMe");
			if ($rememberMe.is(":checked")){
				let username = $("#userName").val();
				localStorage.membersAreaUserName = username;
			}
			else {
				if (localStorage.membersAreaUserName){
					localStorage.removeItem("membersAreaUserName");
				}
			}
		});
		if (localStorage.membersAreaUserName){
			$("#userName").val(localStorage.membersAreaUserName);
			$("#rememberMe").prop("checked", true);
		}
	});
</script>

<div id="main" class="p-0 members-area">
	<div class="container py-4">
		<div class="row">
			<div class="col-md-12 p-4 shadow" id="rightPage">
				
					<h2>You are now logging in securely to the IOSCO Members area</h2>
					
					
					<form id="frmLogin" action="&#x2f;members_area&#x2f;index.cfm" method="post">
						
						<input type="hidden" name="csrf_token" value="752B8A0A36D1AFBC599AE3286EEA288D0D24F2EB">
						<div class="form-group">
							<label for="userName">Username:</label>
							<input class="form-control form-control-sm" type="text" name="userName" id="userName" maxlength="254">
						</div>
						<div class="form-group mt-3">
							<label for="PasswordProvided">Password:</label>
							<input class="form-control form-control-sm" type="password" name="PasswordProvided" id="PasswordProvided" maxlength="128">
						</div>
						<div class="form-group mt-1">
							<input type="checkbox" name="rememberMe" id="rememberMe" value="1">
							<label for="rememberMe" class="rememberMe" style="cursor: pointer;">Remember my username</label><br>
						</div>
						<p style="font-size:0.8rem;">
							<a href="/members_area/?requestLogin=1">Setup an account</a><br>
							<a href="/members_area/?forgotPassword">Forgot Password</a>
						</p>
						<button id="btnLogin" type="submit" class="btn custom-button-primary">Login</button>
					</form>
				
			</div>
		</div>
	</div>
