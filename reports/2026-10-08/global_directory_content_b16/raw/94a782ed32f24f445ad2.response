        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
            <h3 class="section-header">Bank Supervision</h3>
            <div class="row vertical-tab-container">
                <div class="col-lg-3 col-md-3 col-sm-3 col-xs-12 vertical-tab-menu">
                    <div class="list-group">
