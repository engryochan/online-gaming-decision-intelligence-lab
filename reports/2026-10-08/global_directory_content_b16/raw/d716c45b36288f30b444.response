<script>
    $(document).ready(function(){
        $('.dropdown-submenu .open-menu').on("click", function(e){
            $(this).next('ul').toggle();

            const Li = $(this).parent('li');
            if(Li.hasClass('active-child')){
                Li.removeClass('active-child');
            }else{
                $(this).parent('li').addClass('active-child').siblings('li').removeClass('active-child').children('ul').hide();
            }
            e.stopPropagation();
            e.preventDefault();
        });
    });
</script>

