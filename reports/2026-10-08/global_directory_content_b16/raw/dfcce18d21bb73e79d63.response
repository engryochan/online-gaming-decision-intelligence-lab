    <script src="/assets/application.js" data-turbolinks-track="true"></script>
    <script>
      (function() {
        function initSummernote() {
          document.querySelectorAll('textarea.summernote').forEach(function(el) {
            if (el.dataset.summernoteInstance) return;
            if (typeof $ === 'undefined' || typeof $(el).summernote !== 'function') {
              setTimeout(initSummernote, 300);
              return;
            }
            $(el).summernote({
              height: 300,
              styleWithSpan: true,
              dialogsInBody: true,
              toolbar: [
                ['style', ['style']],
                ['font', ['bold', 'italic', 'underline', 'clear']],
                ['fontsize', ['fontsize']],
                ['color', ['color']],
                ['para', ['ul', 'ol', 'paragraph']],
                ['height', ['height']],
                ['table', ['table']],
                ['insert', ['link', 'picture', 'video']],
                ['view', ['fullscreen', 'codeview', 'help']],
              ],
              callbacks: {
                onChange: function(contents) {
                  el.value = contents;
                }
              }
            });
            el.dataset.summernoteInstance = 'true';
          });
        }

        $(window).on('load', function() {
          setTimeout(initSummernote, 0);
        });
      })();
    </script>
      <script type="text/javascript">
    $(function(){
      $.getJSON("/isu_infos/names", { mkt_id: "STK" }, function(data){
        $('.typeahead').typeahead({
          source: data,
          items: 'all',
          minLength: 2,
          displayText: function (item) {
            return item[0] + " / " + item[1] + " / " + item[2];
          },
          afterSelect: function (item) {
            $(".typeahead").val(item[0])
          }
        });
      });
    });
  </script>

