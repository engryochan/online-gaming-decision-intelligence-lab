      <title>List of CM :: Clearing Member</title>
<!-- header end here -->
<section id="solution" class="p-t-60 p-b-40">
    <div class="container">
        <div id="book-closure" class="row">
            <div class="col-md-12 p-b-50" id="dp">
            <div class="col-md-12 col-sm-12 col-xs-12">
                <div class="solution_tabs">
                <!-- <ul>
                    <li class="active"><a href="#">Clearing Member</a>  <br/>   </li> 
                    <ul>
                                                        <li class="">
                                                        <a href="https://cdsc.com.np/cmintroduction">Introduction</a>                                </li>
                                                        <li class="active">
                                                        <a href="https://cdsc.com.np/listofclearingmember">List of Clearing Member</a>
                                </li>
                                                        <li class="">
                                                        <a href="https://cdsc.com.np/cmsettlementprocedure">Settlement Procedure</a>
                                </li>
                                            </ul>
                                            </ul> -->
                </div>
            </div>
                <div class="heading_border bg_red"></div>
                <h2>List of Clearing Member</h2>
                
                <!-- Search Form -->
                <div class="row" style="margin-bottom: 20px;">
                    <div class="col-md-12">
                        <div class="panel panel-default">
                            <div class="panel-heading">
                                
                            </div>
                            <div class="panel-body">
                                <form method="GET" action="https://cdsc.com.np/search-clearing-member" class="form-inline">
                                    <div class="form-group" style="margin-right: 10px;">
                                        <label for="name">Name:</label>
                                        <input type="text" 
                                               class="form-control" 
                                               id="name" 
                                               name="name" 
                                               placeholder="Enter CM name"
                                               value=""
                                               style="width: 200px;">
                                    </div>
                                    <div class="form-group" style="margin-right: 10px;">
                                        <label for="cm_no">CM No:</label>
                                        <input type="text" 
                                               class="form-control" 
                                               id="cm_no" 
                                               name="cm_no" 
                                               placeholder="Enter CM_ID"
                                               value=""
                                               style="width: 150px;">
                                    </div>
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-search"></i> Search
                                    </button>
                                    <a href="https://cdsc.com.np/listofclearingmember" class="btn btn-default">
                                        <i class="fa fa-refresh"></i> Clear
                                    </a>
                                    
                                                                        <a href="https://cdsc.com.np/export-clearing-member-csv" 
                                       class="btn btn-success" style="margin-left: 10px;">
                                        <i class="fa fa-download"></i> Download All CSV
                                    </a>
                                                                    </form>
                                
                                                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="table-responsive" id="listall">
                    <table class="table table-responsive table-striped table-bordered" id="dynamic-table" style="width: 100%">
                        <thead>
                           <tr>
                            <th>S.N</th>
                            <th style="width:25%;">CLEARING MEMBER(CM)</th>
                            <th>CM NO.</th>
                            <th>ADDRESS</th>
