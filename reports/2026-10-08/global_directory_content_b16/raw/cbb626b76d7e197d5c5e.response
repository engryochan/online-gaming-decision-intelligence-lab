<h1 class="boxed">Members&#039; area registration</h1>



<form class="login clearfix" action="members/registration/" method="post" id="registerForm">
<p>Registration for access to the members’ area of the website will only be provided to those working for Full or Associate Members of IMMFA.</p>
<p>Please note, only individual work e-mail addresses are valid. If you use a personal or group e-mail address you will need to re-submit your application.</p>
    <input type="hidden" name="nospam:blank" value="" />
    <div class="row">
        
        <label for="username">*Full Name<span class="error"></span>
            
        </label>
        <input type="text" name="fullname:required" id="fullname" value="" />
    </div>
    <div class="row">
        <label for="password">*Company Name
            <span class="error"></span>
        </label>
        <input type="text" name="website:required" id="website" value="" />
    </div>
    <div class="row">
        <label for="password">*Job Title
            <span class="error"></span>
        </label>
        <input type="text" name="fax:required" id="fax" value="" />
    </div>
    <div class="row">
        <label for="city">*Department
            <span class="error"></span>
        </label>
        <input type="text" name="city:required" id="city" value="" />
    </div>
    <div class="row">
    <label for="address">*Company Address
            <span class="error"></span>
        </label>
      <textarea style="height:50px;" rows="5" class="text"name="address:required" id="address"></textarea>
    </div>

    <div class="row">
        <label for="zip">*Postcode
            <span class="error"></span>
        </label>
        <input class="text" type="text" name="zip:required" id="zip" value="" />
    </div>

    <div class="row">
        <label for="phone">*Work telephone number
            <span class="error"></span>
        </label>
        <input  class="text" type="text" name="phone:required" id="phone" value="" />

    </div>

    <div class="row">
        <label for="email">*Email <span class="note">- this will be your username</span>
            <span class="error"></span>
        </label>
        <input class="text" type="text" name="email:email:checkEmailType" id="email" value="" />

    </div>

    <div class="row">
        <label for="password">*Password
            <span class="error"></span>
        </label>
        <input class="text"type="password" name="password" id="password" value="" />
    </div>

    <div class="row">
        
        <label for="password_confirm">*Confirm Password
            <span class="error"></span>
        </label>
        <input class="text" type="password" name="password_confirm" id="password_confirm" value="" />
    </div>
    <div class="row">
    <div class="g-recaptcha" data-sitekey="6LdiNJEUAAAAAPiuJozoIxR1DnfXqCr77L6_N8GO"></div>
<script type="text/javascript" src="https://www.google.com/recaptcha/api.js?hl=en"></script>
    
</div>

 <div class="row"> 
        <button class="important" type="submit" name="login-register-btn">Register</button>
    </div>
<p>*all fields are mandatory</p>
</form>
           

        </div><!--main-->
    </div><!--inner-->
</div><!--content-->


