itter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/shutterstock_2504072849_52532_CDN_images.jpg?h=828c8f70\u0026itok=hmG8ijMC"}},{"tag":"meta","attributes":{"name":"@type","content":"NewsArticle","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"headline","content":"Crédit Agricole CIB supports international solar financing for Vena Energy in the Philippines","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"name","content":"Crédit Agricole CIB supports international solar financing for Vena Energy in the Philippines","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"articleBody","content":"Vena Energy has secured USD 310 million in financing for its 500 MWp Ixus Bugallon Solar Power Project, with Crédit Agricole CIB acting as Mandated Lead Arranger, Lender, and Modelling Bank.Awarded under the second round of the Green Energy Auction Programme (GEA-2), the project benefits from a 20-year offtake agreement with the government-owned National Transmission Corporation, providing affordable clean energy to communities across the Philippines.It represents our second project financing with Vena Energy in the Philippines within nine months, following the successful close of the 300 MWp Opus Solar Energy Project in December 2025, also awarded under GEA-2. Vena Energy, the renewable energy arm of Vena Group, is a leading low-carbon energy solutions provider in the Asia-Pacific region, through a renewable power pipeline of 30.5 GW across onshore/offshore wind and solar projects, and a low-carbon energy infrastructure pipeline including 26.2 GWh of BESS and 848 KTPA of green hydrogen and ammonia. Vena Energy has had a presence in the Philippines for over a decade and now holds a renewable asset portfolio exceeding 3 GW across the country.This landmark transaction deepens our relationship with Vena Energy, reinforces Crédit Agricole CIB's sector leadership in renewable energy financing across Asia, and further strengthens our position to support the region's accelerating energy transition and capture future opportunities in this rapidly growing market., full_html","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"abstract","content":"One of the largest international financings for a solar project in the country to date.","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"image","content":{"@type":"ImageObject","url":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/large/public/shutterstock_2504072849_52532_CDN_images.jpg?itok=fq9_udfz"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"datePublished","content":"2026-08-14T00:00:00+0200","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"dateModified","content":"2026-08-14T14:35:01+0200","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"mainEntityOfPage","content":"/en/news","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"@type","content":"VideoObject","group":"schema_video_object","schema_metatag":true}}],"path":{"alias":"/news/credit-agricole-cib-supports-international-solar-financing-vena-energy-philippines","pid":7700,"langcode":"en"},"cacib_extra_paths":[{"alias":"/en/news/credit-agricole-cib-supports-international-solar-financing-vena-energy-philippines","langcode":"en"}],"cacib_extra_metatags":[{"title":{"#tag":"meta","#attributes":{"name":"title","content":"Crédit Agricole CIB supports international solar financing for Vena Energy in the Philippines | Crédit Agricole CIB"}},"description":{"#tag":"meta","#attributes":{"name":"description","content":"One of the largest international financings for a solar project in the country to date."}},"og_site_name":{"#tag":"meta","#attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},"og_type":{"#tag":"meta","#attributes":{"property":"og:type","content":"news"}},"og_url":{"#tag":"meta","#attributes":{"property":"og:url","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/views/news_list/block_news_no_highlights"}},"og_title":{"#tag":"meta","#attributes":{"property":"og:title","content":"Crédit Agricole CIB supports international solar financing for Vena Energy in the Philippines"}},"og_description":{"#tag":"meta","#attributes":{"property":"og:description","content":"One of the largest international financings for a solar project in the country to date."}},"og_image_0":{"#tag":"meta","#attributes":{"property":"og:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/shutterstock_2504072849_52532_CDN_images.jpg?h=828c8f70\u0026itok=hmG8ijMC"}},"twitter_cards_type":{"#tag":"meta","#attributes":{"name":"twitter:card","content":"summary_large_image"}},"twitter_cards_description":{"#tag":"meta","#attributes":{"name":"twitter:description","content":"One of the largest international financings for a solar project in the country to date."}},"twitter_cards_title":{"#tag":"meta","#attributes":{"name":"twitter:title","content":"Crédit Agricole CIB supports international solar financing for Vena Energy in the Philippines"}},"twitter_cards_image":{"#tag":"meta","#attributes":{"name":"twitter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/shutterstock_2504072849_52532_CDN_images.jpg?h=828c8f70\u0026itok=hmG8ijMC"}},"schema_article_type":{"#tag":"meta","#attributes":{"name":"@type","content":"NewsArticle","group":"schema_article","schema_metatag":true}},"schema_article_headline":{"#tag":"meta","#attributes":{"name":"headline","content":"Crédit Agricole CIB supports international solar financing for Vena Energy in the Philippines","group":"schema_article","schema_metatag":true}},"schema_article_name":{"#tag":"meta","#attributes":{"name":"name","content":"Crédit Agricole CIB supports international solar financing for Vena Energy in the Philippines","group":"schema_article","schema_metatag":true}},"schema_article_article_body":{"#tag":"meta","#attributes":{"name":"articleBody","content":"Vena Energy has secured USD 310 million in financing for its 500 MWp Ixus Bugallon Solar Power Project, with Crédit Agricole CIB acting as Mandated Lead Arranger, Lender, and Modelling Bank.Awarded under the second round of the Green Energy Auction Programme (GEA-2), the project benefits from a 20-year offtake agreement with the government-owned National Transmission Corporation, providing affordable clean energy to communities across the Philippines.It represents our second project financing with Vena Energy in the Philippines within nine months, following the successful close of the 300 MWp Opus Solar Energy Project in December 2025, also awarded under GEA-2. Vena Energy, the renewable energy arm of Vena Group, is a leading low-carbon energy solutions provider in the Asia-Pacific region, through a renewable power pipeline of 30.5 GW across onshore/offshore wind and solar projects, and a low-carbon energy infrastructure pipeline including 26.2 GWh of BESS and 848 KTPA of green hydrogen and ammonia. Vena Energy has had a presence in the Philippines for over a decade and now holds a renewable asset portfolio exceeding 3 GW across the country.This landmark transaction deepens our relationship with Vena Energy, reinforces Crédit Agricole CIB's sector leadership in renewable energy financing across Asia, and further strengthens our position to support the region's accelerating energy transition and capture future opportunities in this rapidly growing market., full_html","group":"schema_article","schema_metatag":true}},"schema_article_abstract_0":{"#tag":"meta","#attributes":{"name":"abstract","content":"One of the largest international financings for a solar project in the country to date.","group":"schema_article","schema_metatag":true}},"schema_article_image":{"#tag":"meta","#attributes":{"name":"image","content":{"@type":"ImageObject","url":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/large/public/shutterstock_2504072849_52532_CDN_images.jpg?itok=fq9_udfz"},"group":"schema_article","schema_metatag":true}},"schema_article_date_published":{"#tag":"meta","#attributes":{"name":"datePublished","content":"2026-08-14T00:00:00+0200","group":"schema_article","schema_metatag":true}},"schema_article_date_modified":{"#tag":"meta","#attributes":{"name":"dateModified","content":"2026-08-14T14:35:01+0200","group":"schema_article","schema_metatag":true}},"schema_article_author_0":{"#tag":"meta","#attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},"schema_article_publisher":{"#tag":"meta","#attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},"schema_article_main_entity_of_page":{"#tag":"meta","#attributes":{"name":"mainEntityOfPage","content":"/en/news","group":"schema_article","schema_metatag":true}},"schema_video_object_type":{"#tag":"meta","#attributes":{"name":"@type","content":"VideoObject","group":"schema_video_object","schema_metatag":true}}}],"cacib_menu_tree":[],"body":{"value":"One of the largest international financings for a solar project in the country to date.","format":"full_html","processed":"\u003cp\u003eOne of the largest international financings for a solar project in 