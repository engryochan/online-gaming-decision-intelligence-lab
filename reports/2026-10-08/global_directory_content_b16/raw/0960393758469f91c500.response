inated approach.\u003c/strong\u003e\u003c/p\u003e\n","summary":""},"field_anchor_link_title":"Content","field_domain_all_affiliates":false,"field_language_select_message":"Find the content of [node:title] in the following language:","field_meta_tag":"{\"keywords\":\"Corporate finance, corporate finance for midcaps, corporate finance for medium- sized companies\"}","field_meta_tags":"{\"description\":\"The Cr\\u00e9dit Agricole Group has developed a centre of expertise and coordination that meets the needs of midcaps in France.\",\"title\":\"Financial expertise for midcaps | [site:name]\"}","field_publishing_date":"2023-08-10T02:00:00+02:00","field_resume":null,"field_send_to_client_portal":false,"field_show_anchor_links":true,"field_show_social_media_sharing":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/node/page_edito/ffbcc96d-71db-42f4-b40b-71efb1250fb9?resourceVersion=id%3A9892"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/node/page_edito/ffbcc96d-71db-42f4-b40b-71efb1250fb9?resourceVersion=rel%3Aworking-copy"}},"node_type":{"type":"node_type--node_type","id":"d600fcc2-ad99-429f-a0f2-245525e92f0b","resourceIdObjMeta":{"drupal_internal__target_id":"page_edito"}},"revision_uid":{"type":"user--user","id":"81c216bb-adde-464e-8594-845471c4bdc8","resourceIdObjMeta":{"drupal_internal__target_id":25}},"uid":{"type":"user--user","id":"f0c0db80-4309-49af-85b3-fe026b671110","resourceIdObjMeta":{"drupal_internal__target_id":8}},"moderation_state":{"type":"moderation_state--moderation_state","id":"6ad9fede-47e7-4dc0-887d-ed5642e71918","resourceIdObjMeta":{"drupal_internal__target_id":"published"}},"field_banner_image":{"type":"file--file","id":"b57849c5-3820-4c05-8b49-0978cb681fae","drupal_internal__fid":9027,"langcode":"en","filename":"Group 1309-wide.jpg","uri":{"value":"public://2023-08/Group 1309-wide.jpg","url":"/sites/default/files/2023-08/Group%201309-wide.jpg"},"filemime":"image/jpeg","filesize":733992,"status":true,"created":"2023-08-28T07:24:44+00:00","changed":{"value":"2023-08-28T07:25:17+00:00","preserve":null},"breadcrumbs":[],"origname":"Group 1309-wide.jpg","image_style_uri":{"lowres_placeholder":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/lowres_placeholder/public/2023-08/Group%201309-wide.jpg?itok=pkRaeEGu","max_2600x2600":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/max_2600x2600/public/2023-08/Group%201309-wide.jpg?itok=aWxyZnMs","og_image_fb":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/2023-08/Group%201309-wide.jpg?h=ab3cf82e\u0026itok=OvCShCut","source_large_thumbnail_focal_point":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/source_large_thumbnail_focal_point/public/2023-08/Group%201309-wide.jpg?h=ab3cf82e\u0026itok=tROqoNUW","source_thumbnail_focal_point":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/source_thumbnail_focal_point/public/2023-08/Group%201309-wide.jpg?h=ab3cf82e\u0026itok=Tz6LzEDG"},"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/file/file/b57849c5-3820-4c05-8b49-0978cb681fae"}},"resourceIdObjMeta":{"alt":"","title":"","width":1920,"height":433,"drupal_internal__target_id":9027},"uid":{"type":"user--user","id":"f0c0db80-4309-49af-85b3-fe026b671110","resourceIdObjMeta":{"drupal_internal__target_id":8}},"relationshipNames":["uid"]},"field_categories":null,"field_country":[],"field_craft":[],"field_domain_access":[{"type":"domain--domain","id":"a608439f-976c-4aa2-90d9-9404c4ec16ad","resourceIdObjMeta":{"drupal_internal__target_id":"ca_cib_com"}}],"field_domain_source":{"type":"domain--domain","id":"a608439f-976c-4aa2-90d9-9404c4ec16ad","resourceIdObjMeta":{"drupal_internal__target_id":"ca_cib_com"}},"field_edit_permission":[],"field_free_tag":[],"field_news_main_conten":[{"type":"paragraph--title_block_v1","id":"372a65c7-9ce3-49b0-82cd-3f75d78796b8","drupal_internal__id":9940,"drupal_internal__revision_id":154911,"langcode":"en","status":true,"created":"2023-08-10T16:46:34+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-01T15:49:01+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"An ambition to become the leading bank for midcaps","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/372a65c7-9ce3-49b0-82cd-3f75d78796b8?resourceVersion=id%3A154911"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/372a65c7-9ce3-49b0-82cd-3f75d78796b8?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154911,"drupal_internal__target_id":9940},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"82cf85ba-525e-4567-87a8-f5155963c256","drupal_internal__id":9943,"drupal_internal__revision_id":154912,"langcode":"en","status":true,"created":"2023-08-10T16:49:34+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-20T14:03:20+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eMidcaps are key players in the regions and are at the heart of their economic dynamism. They are currently undergoing profound transformation. To support them in these changes and best meet their needs, the Crédit Agricole Group has a number of advantages:\u003c/p\u003e\u003cul\u003e\u003cli\u003ethe ability of our retail banks (Regional Banks, LCL, DBI banks) to support midcaps over the long-\u003cbr\u003eterm as a local bank;\u003c/li\u003e\u003cli\u003eour recognised and \"differentiating\" expertise and the diversity of our business lines;\u003c/li\u003e\u003cli\u003eour strong international presence, which helps to support the development of our clients abroad, through the Crédit Agricole Group's International Business Solutions Division (PAI)\u003c/li\u003e\u003cli\u003e\u003cstrong\u003eour commitment to Corporate Social Responsibility (CSR) issues, which has resulted in us developing significant expertise in supporting our clients on transition matters,\u003c/strong\u003e\u003c/li\u003e\u003cli\u003eour ability to support our private equity clients over the long term and to support them with a full-service M\u0026amp;A practice.\u003c/li\u003e\u003c/ul\u003e","format":"full_html","processed":"\u003cp\u003eMidcaps are key players in the regions and are at the heart of their economic dynamism. They are currently undergoing profound transformation. To support them in these changes and best meet their needs, the Crédit Agricole Group has a number of advantages:\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003ethe ability of our retail banks (Regional Banks, LCL, DBI banks) to support midcaps over the long-\u003cbr\u003eterm as a local bank;\u003c/li\u003e\n\u003cli\u003eour recognised and \"differentiating\" expertise and the diversity of our business lines;\u003c/li\u003e\n\u003cli\u003eour strong international presence, which helps to support the development of our clients abroad, through the Crédit Agricole Group's International Business Solutions Division (PAI)\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eour commitment to Corporate Social Responsibility (CSR) issues, which has resulted in us developing significant expertise in supporting our clients on transition matters,\u003c/strong\u003e\u003c/li\u003e\n\u003cli\u003eour ability to support our private equity clients over the long term and to support them with a full-service M\u0026amp;A practice.\u003c/li\u003e\n\u003c/ul\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/82cf85ba-525e-4567-87a8-f5155963c256?resourceVersion=id%3A154912"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/82cf85ba-525e-4567-87a8-f5155963c256?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154912,"drupal_internal__target_id":9943},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"38c05633-c98b-4d37-9f53-ae2ae2a6f93b","drupal_internal__id":12583,"drupal_internal__revision_id":154913,"langcode":"en","status":true,"created":"2023-09-01T15:44:40+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-01T15:44:40+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"An original approach to meeting the needs of midcaps","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/38c05633-c98b-4d37-9f53-ae2ae2a6f93b?resourceVersion=id%3A154913"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/38c05633-c98b-4d37-9f53-ae2ae2a6f93b?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154913,"drupal_internal__target_id":12583},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"4006bf8c-c611-4945-8496-d45f714227cb","drupal_internal__id":9945,"drupal_internal__revision_id":154914,"langcode":"en","status":true,"created":"2023-08-10T16:52:47+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-17T08:44:03+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eThe midcap division closely supports its clients by applying an original approach based on:\u003c/p\u003e\u003cul\u003e\u003cli\u003e\u003cstrong\u003ea relationship-based model\u003c/strong\u003e specific to strategic midcaps. They benefit from a client team structured around a senior banker whose dual objective is to forge strong strategic relationships with the managers of the midcap and ensure that Crédit Agricole CIB's business lines can provide the best possible assistance to these clients, with the support of commercial banks and a senior sponsor from to the Group's senior management team;\u003c/li\u003e\u003cli\u003e\u003cstrong\u003ededicated teams within our business lines\u003c/strong\u003e to offer midcaps a full range of corporate and investment banking (CIB) services;\u003c/li\u003e\u003cli\u003e\u003cstrong\u003ecoordination between the Crédit Agricole Group's entities to best serve midcaps\u003c/strong\u003e, through Group-level governance specific to the midcap division and a commitment to full transparency about the value created\u003c/li\u003e\u003c/ul\u003e","format":"full_html","processed":"\u003cp\u003eThe midcap division closely supports its clients by applying an original approach based on:\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003e\u003cstrong\u003ea relationship-based model\u003c/strong\u003e specific to strategic midcaps. They benefit from a client team structured around a senior banker whose dual objective is to forge strong strategic relationships with the managers of the midcap and ensure that Crédit Agricole CIB's business lines can provide the best possible assistance to these clients, with the support of commercial banks and a senior sponsor from to the Group's senior management team;\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ededicated teams within our business lines\u003c/strong\u003e to offer midcaps a full range of corporate and investment banking (CIB) services;\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003ecoordination between the Crédit Agricole Group's entities to best serve midcaps\u003c/strong\u003e, through Group-level governance specific to the midcap division and a commitment to full transparency about the value created\u003c/li\u003e\n\u003c/ul\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/4006bf8c-c611-4945-8496-d45f714227cb?resourceVersion=id%3A154914"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/4006bf8c-c611-4945-8496-d45f714227cb?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154914,"drupal_internal__target_id":9945},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"50a8b9a9-8aec-4a04-a9a2-755c95f670a7","drupal_internal__id":12584,"drupal_internal__revision_id":154915,"langcode":"en","status":true,"created":"2023-09-01T15:45:21+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-01T15:45:21+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"Our teams dedicated to midcaps","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/50a8b9a9-8aec-4a04-a9a2-755c95f670a7?resourceVersion=id%3A154915"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/50a8b9a9-8aec-4a04-a9a2-755c95f670a7?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154915,"drupal_internal__target_id":12584},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"8ae29259-bc79-4ccd-ae82-42471d5139cd","drupal_internal__id":9947,"drupal_internal__revision_id":154916,"langcode":"en","status":true,"created":"2023-08-10T16:56:53+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-20T14:03:20+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eAt the service of our clients, the midcap division comprises:\u003c/p\u003e\u003cul\u003e\u003cli\u003esenior bankers who work as close as possible with our clients, grouped into four regions:\u0026nbsp;Auvergne Rhône-Alpes Méditerranée, Grand Est et Nord, Grand Sud-Ouest and Loire Bretagne Outre-Mer;\u003c/li\u003e\u003cli\u003esenior bankers dedicated to public sector clients and regional financial institutions;\u003c/li\u003e\u003cli\u003ea financing advisory team (Corporate Solutions \u0026amp; Advisory);\u0026nbsp;\u003c/li\u003e\u003cli\u003eteams within corporate and investment banking (Corporate \u0026amp; Leverage Finance, International Trade \u0026amp; Transaction Banking, Global Markets Division, Sustainable Banking, Crédit Agricole Midcap Advisors);\u003c/li\u003e\u003cli\u003ea dedicated international support team (Business Solutions Division - PAI);\u003c/li\u003e\u003cli\u003eteams supporting bankers.\u003c/li\u003e\u003c/ul\u003e","format":"full_html","processed":"\u003cp\u003eAt the service of our clients, the midcap division comprises:\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003esenior bankers who work as close as possible with our clients, grouped into four regions:\u0026nbsp;Auvergne Rhône-Alpes Méditerranée, Grand Est et Nord, Grand Sud-Ouest and Loire Bretagne Outre-Mer;\u003c/li\u003e\n\u003cli\u003esenior bankers dedicated to public sector clients and regional financial institutions;\u003c/li\u003e\n\u003cli\u003ea financing advisory team (Corporate Solutions \u0026amp; Advisory);\u0026nbsp;\u003c/li\u003e\n\u003cli\u003eteams within corporate and investment banking (Corporate \u0026amp; Leverage Finance, International Trade \u0026amp; Transaction Banking, Global Markets Division, Sustainable Banking, Crédit Agricole Midcap Advisors);\u003c/li\u003e\n\u003cli\u003ea dedicated international support team (Business Solutions Division - PAI);\u003c/li\u003e\n\u003cli\u003eteams supporting bankers.\u003c/li\u003e\n\u003c/ul\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/8ae29259-bc79-4ccd-ae82-42471d5139cd?resourceVersion=id%3A154916"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/8ae29259-bc79-4ccd-ae82-42471d5139cd?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154916,"drupal_internal__target_id":9947},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"684d24f8-e034-4f97-a9ae-82f324d61617","drupal_internal__id":12585,"drupal_internal__revision_id":154917,"langcode":"en","status":true,"created":"2023-09-01T15:46:01+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-01T15:46:01+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"An investment bank for midcaps: Crédit Agricole Midcap Advisors","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/684d24f8-e034-4f97-a9ae-82f324d61617?resourceVersion=id%3A154917"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/684d24f8-e034-4f97-a9ae-82f324d61617?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154917,"drupal_internal__target_id":12585},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"8092cd85-6f25-4b04-a8d9-6323dd92dfbc","drupal_internal__id":9949,"drupal_internal__revision_id":154918,"langcode":"en","status":true,"created":"2023-08-10T17:00:47+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":true,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2024-05-15T12:59:28+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eAs part of the midcap division, \u003ca href=\"https://www.ca-midcap-advisors.com/\"\u003eCrédit Agricole Midcap Advisors\u003c/a\u003e, a subsidiary of Crédit Agricole CIB, \u003cstrong\u003especialises in providing financial advice to managers and shareholders of SMEs and midcaps\u003c/strong\u003e (M\u0026amp;A advisory, financial and stock market engineering). It relies on a coordinated commercial approach - particularly with the Regional Banks, LCL and the Group's other subsidiaries - to enhance its support for the managers and shareholders of SMEs and midcaps, and benefits from the Group's territorial coverage in France, as well as the international network and Crédit Agricole CIB's sector expertise.\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eAs part of the midcap division, \u003ca href=\"https://www.ca-midcap-advisors.com/\" target=\"_blank\"\u003eCrédit Agricole Midcap Advisors\u003cspan class=\"sr-only\"\u003e Will open in a new tab \u003c/span\u003e\u003c/a\u003e, a subsidiary of Crédit Agricole CIB, \u003cstrong\u003especialises in providing financial advice to managers and shareholders of SMEs and midcaps\u003c/strong\u003e (M\u0026amp;A advisory, financial and stock market engineering). It relies on a coordinated commercial approach - particularly with the Regional Banks, LCL and the Group's other subsidiaries - to enhance its support for the managers and shareholders of SMEs and midcaps, and benefits from the Group's territorial coverage in France, as well as the international network and Crédit Agricole CIB's sector expertise.\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/8092cd85-6f25-4b04-a8d9-6323dd92dfbc?resourceVersion=id%3A154918"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/8092cd85-6f25-4b04-a8d9-6323dd92dfbc?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154918,"drupal_internal__target_id":9949},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"0e82c845-0a34-4d7e-ba4f-6ead46af3cc4","drupal_internal__id":15115,"drupal_internal__revision_id":154919,"langcode":"en","status":true,"created":"2023-10-20T13:50:25+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-20T13:50:25+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"An International Business Solutions Division for SMEs and ETIs","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/0e82c845-0a34-4d7e-ba4f-6ead46af3cc4?resourceVersion=id%3A154919"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/0e82c845-0a34-4d7e-ba4f-6ead46af3cc4?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154919,"drupal_internal__target_id":15115},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"c081fd44-ce3f-4d3f-ae6c-e92b7e754fb3","drupal_internal__id":15116,"drupal_internal__revision_id":154920,"langcode":"en","status":true,"created":"2023-10-20T13:50:18+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-20T13:50:18+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eThe Crédit Agricole Group's International Business Solutions Division (PAI), which is a \u003cstrong\u003enatural extension of the ETI division's ambitions\u003c/strong\u003e, includes the management unit based in Paris and the International Desks Network based mainly abroad in the international network (CACIB and DBI Banks).\u003c/p\u003e\u003cp\u003eThe missions of the PAI :\u003c/p\u003e\u003cul\u003e\u003cli\u003eCentral support unit in Paris: Strategy, Marketing of the offer and Communication / Steering of banking and non-banking partnerships / Animation, training and support for the networks ;\u003c/li\u003e\u003cli\u003eIts network of International Desks supports the Group's SME and ETI clients in \u003cstrong\u003emore than 90 countries\u003c/strong\u003e: information and advice, accounts, cash management, financing, help with setting up, referrals to banking and non-banking partners, coordination and promotion with the networks (client events). The International Desk is on hand to offer tailor-made solutions through Crédit Agricole's local offices, partner banks and local service providers, from the planning stage through to implementation, and throughout the company's international operations.\u003c/li\u003e\u003c/ul\u003e","format":"full_html","processed":"\u003cp\u003eThe Crédit Agricole Group's International Business Solutions Division (PAI), which is a \u003cstrong\u003enatural extension of the ETI division's ambitions\u003c/strong\u003e, includes the management unit based in Paris and the International Desks Network based mainly abroad in the international network (CACIB and DBI Banks).\u003c/p\u003e\n\u003cp\u003eThe missions of the PAI :\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eCentral support unit in Paris: Strategy, Marketing of the offer and Communication / Steering of banking and non-banking partnerships / Animation, training and support for the networks ;\u003c/li\u003e\n\u003cli\u003eIts network of International Desks supports the Group's SME and ETI clients in \u003cstrong\u003emore than 90 countries\u003c/strong\u003e: information and advice, accounts, cash management, financing, help with setting up, referrals to banking and non-banking partners, coordination and promotion with the networks (client events). The International Desk is on hand to offer tailor-made solutions through Crédit Agricole's local offices, partner banks and local service providers, from the planning stage through to implementation, and throughout the company's international operations.\u003c/li\u003e\n\u003c/ul\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/c081fd44-ce3f-4d3f-ae6c-e92b7e754fb3?resourceVersion=id%3A154920"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/c081fd44-ce3f-4d3f-ae6c-e92b7e754fb3?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154920,"drupal_internal__target_id":15116},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]}],"field_page_bottom_footer":[],"field_page_contact":null,"field_page_top_footer":[{"type":"paragraph--news_block_v1","id":"602f9ca6-5bab-43f1-aa64-178e132e88f3","drupal_internal__id":12586,"drupal_internal__revision_id":154921,"langcode":"en","status":true,"created":"2023-09-01T15:48:38+00:00","parent_id":"1166","parent_type":"node","parent_field_name":"field_page_top_footer","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-01T15:48:38+00:00","preserve":null},"cacib_field_country":null,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/news_block_v1/602f9ca6-5bab-43f1-aa64-178e132e88f3?resourceVersion=id%3A154921"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/news_block_v1/602f9ca6-5bab-43f1-aa64-178e132e88f3?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":154921,"drupal_internal__target_id":12586},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"0c63c8f4-4b95-4237-ade9-9005385a96b0","resourceIdObjMeta":{"drupal_internal__target_id":"news_block_v1"}},"field_views":{"type":"view--view","id":"news_list--block_3_latest_related_news","resourceIdObjMeta":{"display_id":"block_3_latest_related_news","data":{"limit":null,"pager":null,"offset":null,"title":null,"argument":null,"exposed_filters":{"vr_exposed_filters_visible":false,"field_news_types_value":[],"field_sectors_target_id":[],"field_country_target_id":[],"combine":"","field_publishing_date_value