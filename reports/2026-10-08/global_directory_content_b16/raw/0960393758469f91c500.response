ue,"breadcrumbs":[{"uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/expertise/accompanying-you-your-specific-financing-needs","resolvable_uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/expertise/accompanying-you-your-specific-financing-needs","title":"Accompanying you with your specific financing needs","options":[]},{"uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/expertise/accompanying-you-your-specific-financing-needs/financial-expertise-midcaps-are-strategic","resolvable_uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/expertise/accompanying-you-your-specific-financing-needs/financial-expertise-midcaps-are-strategic","title":"Financing services for Midcaps","options":[]}],"content_translation_source":"und","content_translation_outdated":false,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Financial expertise for midcaps | Crédit Agricole CIB"}},{"tag":"meta","attributes":{"name":"description","content":"The Crédit Agricole Group has developed a centre of expertise and coordination that meets the needs of midcaps in France."}},{"tag":"meta","attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},{"tag":"meta","attributes":{"property":"og:url","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/node/page_edito/ffbcc96d-71db-42f4-b40b-71efb1250fb9"}},{"tag":"meta","attributes":{"property":"og:title","content":"Financial expertise for midcaps that are strategic to our regions"}},{"tag":"meta","attributes":{"property":"og:description","content":"The Crédit Agricole Group has developed a centre of expertise for midcaps that are considered to be strategic to the regions, both in terms of economic dynamism and the location of decision-making centres. Within Crédit Agricole CIB, the midcap division is able to meet the specific needs of these companies through its comprehensive and coordinated approach."}},{"tag":"meta","attributes":{"property":"og:image","content":"http:/