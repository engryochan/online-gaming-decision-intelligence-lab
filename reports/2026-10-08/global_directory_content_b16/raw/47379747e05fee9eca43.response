document.addEventListener("DOMContentLoaded", function () {

    const menus = document.querySelectorAll(".fsc-cooperation-menu");

    if (!menus.length) {
        return;
    }

    menus.forEach(function (menu) {

        const mainDropdown = menu.querySelector(".fsc-main-dropdown");
        const mainTrigger = menu.querySelector(".fsc-main-trigger");
        const submenuToggles = menu.querySelectorAll(".fsc-submenu-toggle");

        if (!mainDropdown || !mainTrigger) {
            return;
        }

        function closeChildMenus(container) {
            const openItems = container.querySelectorAll(
                ".fsc-has-children.fsc-open"
            );

            openItems.forEach(function (item) {
                item.classList.remove("fsc-open");

                const toggle = item.querySelector(
                    ":scope > .fsc-menu-row > .fsc-submenu-toggle"
                );

                if (toggle) {
                    toggle.setAttribute("aria-expanded", "false");
                }
            });
        }

        function closeMainMenu() {
            mainDropdown.classList.remove("fsc-open");
            mainTrigger.setAttribute("aria-expanded", "false");
            closeChildMenus(mainDropdown);
        }

        mainTrigger.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();

            const isOpen = mainDropdown.classList.toggle("fsc-open");

            mainTrigger.setAttribute(
                "aria-expanded",
                isOpen ? "true" : "false"
            );

            if (!isOpen) {
                closeChildMenus(mainDropdown);
            }
        });

        submenuToggles.forEach(function (toggle) {

            toggle.addEventListener("click", function (event) {
                event.preventDefault();
                event.stopPropagation();

                const parentItem = toggle.closest(".fsc-has-children");

                if (!parentItem) {
                    return;
                }

                const isOpen = parentItem.classList.contains("fsc-open");
                const parentList = parentItem.parentElement;

                if (parentList) {
                    const siblingItems = parentList.querySelectorAll(
                        ":scope > .fsc-has-children.fsc-open"
                    );

                    siblingItems.forEach(function (sibling) {

                        if (sibling !== parentItem) {
                            sibling.classList.remove("fsc-open");

                            const siblingToggle = sibling.querySelector(
                                ":scope > .fsc-menu-row > .fsc-submenu-toggle"
                            );

                            if (siblingToggle) {
                                siblingToggle.setAttribute(
                                    "aria-expanded",
                                    "false"
                                );
                            }

                            closeChildMenus(sibling);
                        }
                    });
                }

                parentItem.classList.toggle("fsc-open", !isOpen);

                toggle.setAttribute(
                    "aria-expanded",
                    !isOpen ? "true" : "false"
                );

                if (isOpen) {
                    closeChildMenus(parentItem);
                }
            });
        });

        document.addEventListener("click", function (event) {
            if (!menu.contains(event.target)) {
                closeMainMenu();
            }
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeMainMenu();
                mainTrigger.focus();
            }
        });
    });
});
</script></body>
