<div class="l-canvas type_wide">
	<header id="page-header" class="l-header pos_fixed shadow_thin bg_solid id_5932"><div class="l-subheader at_top width_default"><div class="l-subheader-h"><div class="l-subheader-cell at_left"></div><div class="l-subheader-cell at_center"></div><div class="l-subheader-cell at_right"><div class="w-text ush_text_1 nowrap"><a href="/licensys/" class="w-text-h"><span class="w-text-value">LicenSys</span></a></div><div class="w-html ush_html_1"><nav class="fsc-cooperation-menu" aria-label="Cooperation menu">

    <div class="fsc-menu-item fsc-main-dropdown">

        <button
            class="fsc-main-trigger"
            type="button"
            aria-expanded="false"
            aria-controls="fsc-cooperation-dropdown"
        >
            <span>Cooperation</span>
            <span class="fsc-arrow" aria-hidden="true"></span>
        </button>

        <ul
            class="fsc-dropdown fsc-level-1"
