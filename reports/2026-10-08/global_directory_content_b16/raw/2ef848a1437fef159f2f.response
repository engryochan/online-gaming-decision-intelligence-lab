                <td>×</td>
                <td>×</td>
              </tr>
              <tr>
                <th class="bg-th-dark-gray text-white">アイスバーグ</th>
                <td class="bg-th-dark-pink">○</td>
                <td>×</td>
                <td>○</td>
                <td>×</td>
                <td>×</td>
              </tr>
              <tr>
                <th class="bg-th-dark-gray text-white">リバージョン</th>
                <td class="bg-th-dark-pink">○</td>
                <td>×</td>
                <td>×</td>
                <td>×</td>
                <td>×</td>
              </tr>
              <tr>
                <th class="bg-th-dark-gray text-white">ペッグ</th>
                <td class="bg-th-dark-pink">○</td>
                <td>×</td>
                <td>×</td>
                <td>×</td>
                <td>×</td>
              </tr>
              <tr>
                <th class="bg-th-dark-gray text-white">POV</th>
