<script>
inView('.counter_block5')
    .on('enter', inviewEnter5)
//.on('exit', outView);

function inviewEnter5() {
    console.log("in view");
    $('.counter5').each(function() {
        var $this = $(this),
            countTo = $this.attr('data-count');
        $({
            countNum: $this.text()
        }).animate({
            countNum: countTo
        }, {
            duration: 2000,
            easing: 'linear',
            step: function() {
                $this.text(Math.floor(this.countNum));
            },
            complete: function() {
                $this.text(this.countNum);
            }
        });
    });
}
</script>
