<div class="job_listing36" id="job-listing">
    
    <div class="job-filters mb-4">

        <div class="container">
            <div class="row g-3" style="align-items: stretch;">

                <!-- Search -->
                <div class="position-relative col-12 col-md-3 mb-3 mb-md-0">
                    <input
                        type="search"
