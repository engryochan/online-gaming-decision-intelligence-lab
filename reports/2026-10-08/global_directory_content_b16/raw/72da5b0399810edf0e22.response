-3 px-6 py-3 rounded-full bg-white border border-gray-200 mb-8 backdrop-blur-sm shadow-sm"><span class="text-gray-900 text-xl"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-building2 lucide-building-2" aria-hidden="true"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path><path d="M10 6h4"></path><path d="M10 10h4"></path><path d="M10 14h4"></path><path d="M10 18h4"></path></svg></span><span class="text-gray-900 font-semibold">Capital Markets</span></div><h1 class="text-4xl md:text-6xl font-light mb-6 text-gray-900 leading-tight tracking-tight">List on MERJ Exchange</h1><p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed font-light">Access global capital and liquidity through our innovative, regulated, and internationally recognized exchange platform.</p></div></section></div><main class="max-w-7xl mx-auto px-6 pb-12 "><div class="space-y-24"><div class="transition-all ease-out " style="opacity:0;transform:translateY(25px);transition-duration:500ms;transition-timing-function:cubic-bezier(0.16, 1, 0.3, 1)"><div class="relative bg-white backdrop-blur-xl rounded-3xl p-10 border border-gray-200 hover:border-gray-300 transition-all duration-500" style="box-shadow:0 25px 50px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8)"><div class="text-center mb-12"><h2 class="text-3xl md:text-4xl font-light text-gray-900 mb-6 tracking-tight">Why List on MERJ Exchange?</h2><h3 class="text-2xl font-light text-gradient-animated mb-6 tracking-tight">Fast. Global. Accessible.</h3></div><div class="grid grid-cols-1 md:grid-cols-3 gap-8"><div class="text-center group"><div class="w-16 h-16 bg-gray-100 rounded-full mx-auto mb-6 flex items-center justify-center group-hover:bg-gray-200 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock h-8 w-8 text-gray-900" aria-hidden="true"><path d="M12 6v6l4 2"></path><circle cx="12" cy="12" r="10"></circle></svg></div><div class="text-3xl font-light text-gray-900 mb-3 group-hover:text-black transition-colors">30+</div><h4 class="text-xl font-medium text-gray-900 mb-2 group-hover:text-black transition-colors">Days to List</h4><p class="text-gray-600 font-light">Fastest listing process in the industry</p></div><div class="text-center group"><div class="w-16 h-16 bg-gray-100 rounded-full mx-auto mb-6 flex items-center justify-center group-hover:bg-gray-200 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-globe h-8 w-8 text-gray-900" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg></div><div class="text-3xl font-light text-gray-900 mb-3 group-hover:text-black transition-colors">180+</div><h4 class="text-xl font-medium text-gray-900 mb-2 group-hover:text-black transition-colors">Countries</h4><p class="text-gray-600 font-light">Global investor access permitted</p></div><div class="text-center group"><div class="w-16 h-16 bg-gray-100 rounded-full mx-auto mb-6 flex items-center justify-center group-hover:bg-gray-200 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users h-8 w-8 text-gray-900" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></div><div class="text-3xl font-light text-gray-900 mb-3 group-hover:text-black transition-colors">20/5 Trading</div><h4 class="text-xl font-medium text-gray-900 mb-2 group-hover:text-black transition-colors">Extended Hours</h4><p class="text-gray-600 font-light">Mon-Fri 10:00-06:00 UTC+4</p></div></div></div></div><div class="transition-all ease-out " style="opacity:0;transform:translateY(25px);transition-duration:500ms;transition-timing-function:cubic-bezier(0.16, 1, 0.3, 1)"><div class="relative bg-white backdrop-blur-xl rounded-3xl p-10 border border-gray-200 hover:border-gray-300 transition-all duration-500" style="box-shadow:0 25px 50px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8)"><div class="text-center mb-12"><h2 class="text-3xl md:text-4xl font-light text-gray-900 mb-6 tracking-tight">Market Boards</h2><h3 class="text-2xl font-light text-gradient-animated mb-6 tracking-tight">Tailored. Flexible. Comprehensive.</h3></div><p class="text-xl text-gray-600 mb-12 max-w-4xl mx-auto leading-relaxed font-light text-center">MERJ Exchange operates three distinct market boards, each tailored to different company profiles and capital requirements.</p><div class="grid grid-cols-1 md:grid-cols-3 gap-8"><div class="group p-8 bg-gray-50 rounded-2xl border border-gray-200 hover:border-gray-300 transition-all duration-300 hover:scale-105"><h4 class="text-xl font-medium text-gray-900 mb-4 group-hover:text-black transition-colors">Main Board</h4><p class="text-gray-600 font-light mb-6">For established companies with proven track records</p><ul class="text-gray-600 space-y-3 font-light"><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Revenue of $5M+ annually</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Audited financial statements</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Strong corporate governance</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Minimum public float requirements</li></ul></div><div class="group p-8 bg-gray-50 rounded-2xl border border-gray-200 hover:border-gray-300 transition-all duration-300 hover:scale-105"><h4 class="text-xl font-medium text-gray-900 mb-4 group-hover:text-black transition-colors">SME Board</h4><p class="text-gray-600 font-light mb-6">For small and medium enterprises seeking growth capital</p><ul class="text-gray-600 space-y-3 font-light"><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Revenue of $1M+ annually</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Simplified listing requirements</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Fast-track approval process</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Reduced compliance costs</li></ul></div><div class="group p-8 bg-gray-50 rounded-2xl border border-gray-200 hover:border-gray-300 transition-all duration-300 hover:scale-105"><h4 class="text-xl font-medium text-gray-900 mb-4 group-hover:text-black transition-colors">VCAP Board</h4><p class="text-gray-600 font-light mb-6">For early-stage and high-growth companies</p><ul class="text-gray-600 space-y-3 font-light"><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Pre-revenue companies accepted</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Venture capital and private equity focus</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Innovative business models</li><li class="flex items-start"><div class="w-2 h-2 rounded-full bg-gray-400 mt-2 mr-3 flex-shrink-0"></div>Flexible listing criteria</li></ul></div></div></div></div><div class="transition-all ease-out " style="opacity:0;transform:translateY(25px);transition-duration:500ms;transition-timing-function:cubic-bezier(0.16, 1, 0.3, 1)"><div class="relative bg-white backdrop-blur-xl rounded-3xl p-10 border border-gray-200 hover:border-gray-300 transition-all duration-500" style="box-shadow:0 25px 50px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.8)"><div class="text-center mb-12"><h2 class="text-3xl md:text-4xl font-light text-gray-900 mb-6 tracking-tight">Streamlined Listing Process</h2><h3 class="text-2xl font-light text-gradient-animated mb-6 tracking-tight">Simple. Efficient. Transparent.</h3></div><div class="grid grid-cols-1 md:grid-cols-5 gap-6"><div class="text-center group"><div class="w-16 h-16 bg-gray-100 rounded-full mx-auto mb-6 flex items-center justify-center text-gray-900 font-medium text-xl group-hover:bg-gray-200 transition-colors">1</div><h4 class="text-lg font-medium text-gray-900 mb-3 group-hover:text-black transition-colors">Initial Consultation</h4><p class="text-gray-600 font-light">Discuss your listing objectives</p></div><div class="text-center group"><div class="w-16 h-16 bg-gray-100 rounded-full mx-auto mb-6 flex items-center justify-center text-gray-900 font-medium text-xl group-hover:bg-gray-200 transition-colors">2</div><h4 class="text-lg font-medium text-gray-900 mb-3 group-hover:text-black transition-colors">Documentation</h4><p class="text-gray-600 font-light">Prepare listing documents</p></div><div class="text-center group"><div class="w-16 h-16 bg-gray-100 rounded-full mx-auto mb-6 flex items-center justify-center text-gray-900 font-medium text-xl group-hover:bg-gray-200 transition-colors">3</div><h4 class="text-lg font-medium text-gray-900 mb-3 group-hover:text-black transition-colors">Review &am