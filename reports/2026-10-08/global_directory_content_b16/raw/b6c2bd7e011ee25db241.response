    <script>$X.PMD = {"0084a14b-8e52-47bc-9d68-021e5f59c753":{},"daca904b-2a20-4dea-81c4-b445430b4d3f":{},"38ff1894-68de-4944-a597-a9cd0c8fbbcf":{}};$X.PPG = {"0084a14b-8e52-47bc-9d68-021e5f59c753":{},"daca904b-2a20-4dea-81c4-b445430b4d3f":{},"38ff1894-68de-4944-a597-a9cd0c8fbbcf":{"items":["\u003cdiv class=\"[xCssCls]\"\u003e\u003cdiv class=\"com com-41a12de3-8254-4f24-86d4-f09c27f89252\"\u003e\u003cdiv class=\"mol mol-4d7490fb-8eae-4119-b94d-f59e11105b71\"\u003e\u003cdiv class=\"col col-266c357a-a8c1-4d19-ba7d-ef623e6d4c3c\"\u003e\u003cdiv class=\"com com-3f1265b7-2cdb-4229-9ffb-1f41aa740150\"\u003e\u003ca data-so-type=\"btn;1\" class=\"aps-0030-so-wrapper  hvr-normal font-8C65CD72-BB8B-47C5-8E0E-355356B24AFF btn-padding-n  font-icon-textless aps-0030-so-wrapper-1fe64cf6-c76e-4f26-ad3c-9ee4c18a60bb\" data-so-popup=\"[F6E522F8-4DEF-40D0-F127-3C1125CEAE50]\" href=\"[Page Address]\" target=\"_self\"\u003e\u003cdiv class=\"a-inner-text\"\u003e[Page Name]\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003cdiv class=\"com com-d5f9fce2-25a0-4c9b-9e87-ecacdd141fcd\"\u003e\u003cdiv data-so-type=\"txt;1\" class=\"aps-0036-so-wrapper  list-gap-s font-D6715655-7F24-45EF-8463-ADB1866B5F1D  aps-0036-so-wrapper-b9fda670-acfb-42c3-bdd9-4a728d794647\"\u003e\u003cdiv class=\"a-inner-text\"\u003e[Description]\u003c/div\u003e\n\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"com com-62db6825-5fbf-4e9f-a2b5-1f21f1d2b215\"\u003e\u003cdiv class=\"aps-0037-so-wrapper line-placement-center aps-0037-so-wrapper-ed218cf8-92ad-42d1-8e7e-07eaf468d7c8\"\u003e\u003chr\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e","\u003cdiv class=\"[xCssCls]\"\u003e\u003cdiv class=\"com com-41a12de3-8254-4f24-86d4-f09c27f89252\"\u003e\u003cdiv class=\"mol mol-4d7490fb-8eae-4119-b94d-f59e11105b71\"\u003e\u003cdiv class=\"col col-266c357a-a8c1-4d19-ba7d-ef623e6d4c3c\"\u003e\u003cdiv class=\"com com-3f1265b7-2cdb-4229-9ffb-1f41aa740150\"\u003e\u003ca data-so-type=\"btn;1\" class=\"aps-0030-so-wrapper  hvr-normal font-8C65CD72-BB8B-47C5-8E0E-355356B24AFF btn-padding-n  font-icon-textless aps-0030-so-wrapper-1fe64cf6-c76e-4f26-ad3c-9ee4c18a60bb\" data-so-popup=\"[F6E522F8-4DEF-40D0-F127-3C1125CEAE50]\" href=\"[Page Address]\" target=\"_self\"\u003e\u003cdiv class=\"a-inner-text\"\u003e[Page Name]\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003cdiv class=\"com com-d5f9fce2-25a0-4c9b-9e87-ecacdd141fcd\"\u003e\u003cdiv data-so-type=\"txt;1\" class=\"aps-0036-so-wrapper  list-gap-s font-D6715655-7F24-45EF-8463-ADB1866B5F1D  aps-0036-so-wrapper-b9fda670-acfb-42c3-bdd9-4a728d794647\"\u003e\u003cdiv class=\"a-inner-text\"\u003e[Description]\u003c/div\u003e\n\u003c/div\u003e\u003c/div\u003e\u003cdiv class=\"com com-62db6825-5fbf-4e9f-a2b5-1f21f1d2b215\"\u003e\u003cdiv class=\"aps-0037-so-wrapper line-placement-center aps-0037-so-wrapper-ed218cf8-92ad-42d1-8e7e-07eaf468d7c8\"\u003e\u003chr\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e\u003c/div\u003e"],"pages": {"0":[{"Page Name":"Application Kit","Description":"Application Kit","Page Address":"regulation/licensing/application-kit","xDataId":"5cffacd2-d093-4e9d-ba3e-6926f5dbb3d6","xDataVal":"","xCssCls":""},{"Page Name":"Licensing and Registration","Description":"Licensing Handbook and Registration Guidelines","Page Address":"https://www.sc.com.my/regulation/guidelines/licensing-and-registration","xDataId":"f01a843f-78c0-4f69-86c5-782ff745a594","xDataVal":"","xCssCls":""},{"Page Name":"Licensed and Registered Persons","Description":"Licensed and Registered Persons","Page Address":"regulation/licensing/licensed-and-registered-persons","xDataId":"3edeabc6-c5f2-4513-84d2-8e494906d216","xDataVal":"","xCssCls":""},{"Page Name":"Application Procedures for Trading on Specified Exchanges","Description":"Application Procedures for Trading on Specified Exchanges","Page Address":"regulation/licensing/application-procedures-for-trading-on-specified-