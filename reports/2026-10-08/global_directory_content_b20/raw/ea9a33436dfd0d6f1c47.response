ation.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=http%3A%2F%2Fbo-en-instit-cacib.adsi.credit-agricole.fr%2Fsites%2Fdefault%2Ffiles%2F2023-08%2Feditorial-banner-securitisation.jpg&amp;w=3840&amp;q=75 3840w" sizes="100vw" alt="" width="0" height="0" loading="lazy" class="w-full h-full object-cover text-transparent  "/></div></div><div><main role="main" id="content"><article origin="https://www.ca-cib.com" path="[object Object]"><div class="flex flex-col lg:flex-row mb-8 lg:mb-10 2.5xl:mb-15"><div class="sidebar-links w-full lg:max-w-[268px] 2.5xl:max-w-[420px]" aria-live="polite"><div class="block lg:sticky top-0 z-10 lg:p-6"><div class="hidden lg:block cib-shadow-m z-10 absolute top-0 bottom-6 right-0 w-6"></div><div class="hidden lg:block cib-shadow-m z-10 absolute bottom-0 left-6 right-0 h-6"></div><div class="hidden lg:block z-20 absolute bottom-0 top-0 left-0 right-0 cib-bg-surface"></div><div class="side-menu-container z-20 lg:relative -my-6 -mx-6 max-h-screen overflow-auto cib-scrollbar"><div><div class="block lg:hidden absolute top-0 left-0 right-0 cib-bg-surface"><span class="py-2.75 flex items-center justify-center lg:-mx-1 w-full cib-link uppercase !no-underline" tabindex="0"><span class="px-1 underline">Content</span> <span class="px-1 flex items-center"><cib-icon name="ic_chevron_down" color="var(--cib-color-brand-primary)"></cib-icon></span></span></div><nav aria-label="Navigation in the table of contents" role="navigation" class="transition-all z-10 cib-bg-surface block fixed lg:static top-[75px] bottom-0 left-0 right-0 lg:h-auto lg:overflow-visible max-h-0 overflow-hidden lg:max-h-full"><span class="flex justify-between items-center sticky lg:static top-15 cib-bg-surface uppercase py-2 lg:py-6 px-6 cib-border-default border-b lg:border-0 z-10"><span class="text-base leading-7 lg:text-2xl lg:leading-6">Content</span><span class="block lg:hidden"><span class="flex items-center justify-center w-full cib-link uppercase !no-underline"><span class="px-1 -mx-1 underline">Close</span></span></span></span><ul><li id="link-paragraph-dada53dd-9404-4934-81c8-efbcc2a9a486" class="link-item cib-nav-link-14 !normal-case border-0 my-0 block"><a class="px-5 lg:px-6 py-4 lg:py-6 block" aria-label="Go to section Our customised securitisation solutions" href="/en/expertise/providing-capital-markets-solutions/securitisation#paragraph-dada53dd-9404-4934-81c8-efbcc2a9a486"><span class="font-bold text-sm leading-5.5 lg:text-base lg:leading-6">Our customised securitisation solutions</span></a></li><li id="link-paragraph-5fa5896e-8bde-42c0-b71f-d058e60f5ea6" class="link-item cib-nav-link-14 !normal-case border-0 my-0 block"><a class="px-5 lg:px-6 py-4 lg:py-6 block" aria-label="Go to section Our presence in the world" href="/en/expertise/providing-capital-markets-solutions/securitisation#paragraph-5fa5896e-8bde-42c0-b71f-d058e60f5ea6"><span class="font-bold text-sm leading-5.5 lg:text-base lg:leading-6">Our presence in the world</span></a></li><li id="link-paragraph-1b611cfc-7b4a-4334-803d-b23f6241db81" class="link-item cib-nav-link-14 !normal-case border-0 my-0 block"><a class="px-5 lg:px-6 py-4 lg:py-6 block" aria-label="Go to section Crédit Agricole CIB’s recognised expertise in securitisation products " href="/en/expertise/providing-capital-markets-solutions/securitisation#paragraph-1b611cfc-7b4a-4334-803d-b23f6241db81"><span class="font-bold text-sm leading-5.5 lg:text-base lg:leading-6">Crédit Agricole CIB’s recognised expertise in securitisation products </span></a></li><li id="link-paragraph-64b92566-bc95-47c4-a34a-f4ed16ce2429" class="link-item cib-nav-link-14 !normal-case border-0 my-0 block"><a class="px-5 lg:px-6 py-4 lg:py-6 block" aria-label="Go to section Green, social and sustainability-linked securitisation" href="/en/expertise/providing-capital-markets-solutions/securitisation#paragraph-64b92566-bc95-47c4-a34a-f4ed16ce2429"><span class="font-bold text-sm leading-5.5 lg:text-base lg:leading-6">Green, social and sustainability-linked securitisation</span></a><ul><li id="link-paragraph-bb20af46-95bb-4892-a9ff-bfcfa5de4dca" class="link-item cib-footer-link-14 border-0 my-0 block normal-case"><a class="pl-8 pr-5 lg:pl-12 lg:pr-6 py-4 lg:py-6 block" aria-label="Go to section Green Asset-backed Commercial Paper (ABCP) programme" href="/en/expertise/providing-capital-markets-solutions/securitisation#paragraph-bb20af46-95bb-4892-a9ff-bfcfa5de4dca"><span class="font-normal text-sm leading-5.5 lg:text-base lg:leading-6">Green Asset-backed Commercial Paper (ABCP) programme</span></a></li></ul></li></ul></nav></div></div></div></div><div class="w-full lg:max-w-none mx-auto"><div class="px-4 md:px-0"><div class="w-full -mt-12 lg:-mt-25 md:max-w-[96%] lg:max-w-[95%] lg:max-w-[95%] xl:max-w-[96%] 2.5xl:max-w-[1356px] lg:mx-0 mx-auto px-0 relative bg-surface dark:bg-dark-gray-000 min-h-[51px] lg:min-h-[101px]"><div><div class="md:px-11 pt-6 lg:pt-12 w-full px-4 lg:px-0 lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg mx-auto"><div class="mt-4 lg:mt-10 w-full px-0 mx-auto"><h1 class="text-2.5xl leading-10 lg:text-4.25xl lg:leading-15 font-bold uppercase mb-8 cib-text-major"><span>Securitisation </span></h1><div class="font-semibold text-lg leading-8 lg:text-lg lg:leading-9 my-6"><div class="richtext-container"><p>The <strong>securitisation</strong> product line of the Global Markets division (GMD) offers origination and structuring of <strong>secured financing solutions</strong> for Crédit Agricole CIB and Crédit Agricole Group clients, via asset or cash flow based structures refinanced by financial products.</p>
</div></div></div></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-0 mx-auto"><div class="flex flex-wrap items-center my-6 pt-4 border-t cib-border-gray-400 rs_skip"><div class="flex items-center lg:-mx-3"><div class="px-0 lg:px-3"><label class="text-base leading-6"><span>Share</span></label></div><ul class="flex items-center"><li class="px-3 flex items-center group"><span aria-label="Sharing on Linkedin, opens a new window" type="button"><cib-icon name="ic_linkedin" color="var(--cib-color-primary)" class="block rounded outline-2 group-focus-within:outline" aria-hidden="true"></cib-icon><span class="hidden">LinkedIn</span></span></li><li class="px-3 flex items-center group"><span aria-label="Sharing on Twitter, opens a new window" type="button"><cib-icon name="ic_x" color="var(--cib-color-primary)" class="block rounded outline-2 group-focus-within:outline" aria-hidden="true"></cib-icon><span class="hidden">Twitter</span></span></li><li class="px-3 flex items-center group"><span aria-label="Sharing on Facebook, opens a new window" type="button"><cib-icon name="ic_facebook" color="var(--cib-color-primary)" class="block rounded outline-2 group-focus-within:outline" aria-hidden="true"></cib-icon><span class="hidden">Facebook</span></span></li></ul></div></div></div></div></div><div class="my-4 lg:my-10 lg:max-w-[95%] xl:max-w-[96%] 2.5xl:max-w-[1356px] lg:mx-0 mx-auto px-0 pt-4 md:pt-8 lg:pt-10 2.5xl:pt-15 relative bg-surface dark:bg-dark-gray-000"><div class="w-full"><div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 !mb-4 lg:!mb-6" id="paragraph-dada53dd-9404-4934-81c8-efbcc2a9a486"><h2 class="cib-text-major"><span class="block uppercase text-ellipsis text-xl leading-7.5 lg:text-3.75xl lg:leading-15 font-bold">Our customised securitisation solutions</span></h2></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 w-full mx-auto"><div><div class="text-base leading-8.5 text-block-v1 richtext-container"><p>The Bank offers structured financing and risk management solutions tailored to the needs of our clients, based on a variety of assets or cash-flows:</p>
<ul class="list-disc pl-5">
<li>Trade receivables;</li>
<li>Financial assets (e.g. car loans and leases, consumer loans, credit card loans, home loans, solar loans);</li>
<li>Operating Assets, including rental vehicle fleets, air or rail transport assets, solar and other energy transition assets; and</li>
<li>Infrastructure assets (for project bonds and private placements).</li>
</ul>
<p>These <strong>financing structures </strong>are mainly refinanced by three major asset-backed commercial paper (ABCP) conduits, sponsored by Crédit Agricole CIB (rated A1/P1/F1+, LMA in Europe, ATLANTIC and LA FAYETTE in the United States), or directly via <strong>asset-backed securities</strong> (ABS), structured and placed on the <strong>capital markets</strong>.</p>
</div></div></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 !mb-4 lg:!mb-6 mt-16 md:mt-16 lg:mt-20 2.5xl:mt-25" id="paragraph-5fa5896e-8bde-42c0-b71f-d058e60f5ea6"><h2 class="cib-text-major"><span class="block uppercase text-ellipsis text-xl leading-7.5 lg:text-3.75xl lg:leading-15 font-bold">Our presence in the world</span></h2></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 w-full mx-auto"><div><div class="text-base leading-8.5 text-block-v1 richtext-container"><p>The <strong>securitisation business</strong> has <strong>experts based in Paris, New York, Milan, and São Paulo</strong>, to meet the financing needs of the Group’s clients in Europe and the Americas. The Bank also supports our multinational clients as they expand in Asia through securitisation programmes, including portfolios of Asian debtors.</p>
</div></div></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 !mb-4 lg:!mb-6 mt-16 md:mt-16 lg:mt-20 2.5xl:mt-25" id="paragraph-1b611cfc-7b4a-4334-803d-b23f6241db81"><h2 class="cib-text-major"><span class="block uppercase text-ellipsis text-xl leading-7.5 lg:text-3.75xl lg:leading-15 font-bold">Crédit Agricole CIB’s recognised expertise in securitisation products </span></h2></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 w-full mx-auto"><div><div class="text-base leading-8.5 text-block-v1 richtext-container"><p>Thanks to our worldwide franchise, Crédit Agricole CIB’s securitisation business has built a solid reputation and a high standing in the implementation of <strong>private securitisation programmes and public and private ABS issuances.</strong></p>
<p>The Bank consistently ranks at the top of Euro ABS league-tables, including:</p>
</div></div></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15"><span class="sr-only">Key Figures</span><div><div><ul class="flex flex-col lg:flex-row items-center lg:items-stretch justify-center lg:-mx-2 -my-2 divide-y lg:divide-y-0 lg:divide-x relative flex-wrap "><li class="w-full lg:w-full max-w-full lg:max-w-[250px] px-5 py-5 my-0 lg:px-2 lg:py-2 lg:my-10 text-center lg:w-4/12 "><p><span class="block text-4.25xl leading-14 lg:text-4.25xl lg:leading-18 font-bold key-figure-color-d14600"> <!-- -->#2<!-- --> </span><span class="text-sm leading-5.5"> <!-- -->Euro ABS league-tables in 2022 and H1 2023<!-- --> </span></p></li><li class="w-full lg:w-full max-w-full lg:max-w-[250px] px-5 py-5 my-0 lg:px-2 lg:py-2 lg:my-10 text-center lg:w-4/12 "><p><span class="block text-4.25xl leading-14 lg:text-4.25xl lg:leading-18 font-bold key-figure-color-357ca7"> <!-- -->#4<!-- --> </span><span class="text-sm leading-5.5"> <!-- -->US aviation ABS league-tables, in aggregate 2012 to H1 2023<!-- --> </span></p></li><li class="w-full lg:w-full max-w-full lg:max-w-[250px] px-5 py-5 my-0 lg:px-2 lg:py-2 lg:my-10 text-center lg:w-4/12 "><p><span class="block text-4.25xl leading-14 lg:text-4.25xl lg:leading-18 font-bold key-figure-color-008795"> <!-- -->#3<!-- --> </span><span class="text-sm leading-5.5"> <!-- -->railcar ABS league-tables, in aggregate 2012 to H1 2023<!-- --> </span></p></li></ul></div></div></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 w-full mx-auto"><div><div class="text-base leading-8.5 text-block-v1 richtext-container"><p>Our main conduit, LMA, ranked as the first largest multiseller ABCP conduit according to the last worldwide ABCP league table of Moody’s (Q2 -2023). Through its three ABCP conduits, Crédit Agricole CIB is the world’s third largest sponsor of ABCP programmes.</p>
</div></div></div></div><div id="sustainabilitysecuritisation"></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 !mb-4 lg:!mb-6 mt-16 md:mt-16 lg:mt-20 2.5xl:mt-25" id="paragraph-64b92566-bc95-47c4-a34a-f4ed16ce2429"><h2 class="cib-text-major"><span class="block uppercase text-ellipsis text-xl leading-7.5 lg:text-3.75xl lg:leading-15 font-bold">Green, social and sustainability-linked securitisation</span></h2></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 w-full mx-auto"><div><div class="text-base leading-8.5 text-block-v1 richtext-container"><p>With the support of Crédit Agricole CIB’s Sustainable Banking team, <strong>the securitisation product line offers a full service to originators and sponsors considering a sustainability linked securitisation.&nbsp;</strong></p>

<p>It has developed a strong expertise in inaugural securitisations aligned to the Sustainability Linked market standards for financial institutions and corporates across asset classes and geographies.&nbsp;</p>
</div></div></div></div><div id="abcp"></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 !mb-4 lg:!mb-6 mt-8 md:mt-8 lg:mt-10 2.5xl:mt-15" id="paragraph-bb20af46-95bb-4892-a9ff-bfcfa5de4dca"><h3 class="text-lg leading-7 lg:text-2xl lg:leading-8 uppercase cib-text-major"><span>Green Asset-backed Commercial Paper (ABCP) programme</span></h3></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="mb-8 lg:mb-10 2.5xl:mb-15 w-full mx-auto"><div><div class="text-base leading-8.5 text-block-v1 richtext-container"><p>In 2020 Crédit Agricole CIB structured the first green ABCP backed by trade and auto loan/lease receivables contributing to the energy and environmental transition. Since then, LMA and ATLANTIC issue green CP (Commercial Paper) on the European and US markets.&nbsp;</p>
<p>These issuances are aligned with market principles (Green Securitised Bond in Appendix 1 of the 2021 Green Bond Principles) and with the Schedule 1 of Crédit Agricole Group Green Bond Framework.</p>
</div></div></div></div></div></div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[95%] lg:max-w-[90%] xl:max-w-[95%] 2.5xl:max-w-screen-1.75lg px-4 md:px-0 mx-auto"><div class="flex flex-wrap items-center my-6 pt-4 border-t cib-border-gray-400 rs_skip"><div class="flex items-center lg:-mx-3"><div class="px-0 lg:px-3"><label class="text-base leading-6"><span>Share</span></label></div><ul class="flex items-center" role="presentation"><li class="px-3 flex items-center group"><span aria-label="Sharing on Linkedin, opens a new window" type="button"><cib-icon name="ic_linkedin" color="var(--cib-color-primary)" class="block rounded outline-2 group-focus-within:outline" aria-hidden="true"></cib-icon><span class="hidden">LinkedIn</span></span></li><li class="px-3 flex items-center group"><span aria-label="Sharing on Twitter, opens a new window" type="button"><cib-icon name="ic_x" color="var(--cib-color-primary)" class="block rounded outline-2 group-focus-within:outline" aria-hidden="true"></cib-icon><span class="hidden">Twitter</span></span></li><li class="px-3 flex items-center group"><span aria-label="Sharing on Facebook, opens a new window" type="button"><cib-icon name="ic_facebook" color="var(--cib-color-primary)" class="block rounded outline-2 group-focus-within:outline" aria-hidden="true"></cib-icon><span class="hidden">Facebook</span></span></li></ul></div></div></div></div></div></div><div class="w-full"><div><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[90%] 2.5xl:max-w-screen-2.75xl px-4 md:px-0 mx-auto"><div class="w-full md:max-w-[96%] lg:max-w-[90%] xl:max-w-[90%] 2.5xl:max-w-screen-2.75xl px-4 md:px-0 mx-auto"><div class="my-8 lg:my-20 -mx-4 md:mx-0 views-view " id="views-view-news_list--block_3_latest_related_news-block_3_latest_related_news" aria-live="polite"><div class="my-10"><h2 class="cib-text-major"><span class="block text-xl leading-7.5 lg:text-3.5xl lg:leading-10 normal-case font-normal">Find</span><span class="block text-2.5