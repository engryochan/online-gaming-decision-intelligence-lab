eld_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-12T05:19:05+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"Our customised securitisation solutions","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/dada53dd-9404-4934-81c8-efbcc2a9a486?resourceVersion=id%3A151910"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/dada53dd-9404-4934-81c8-efbcc2a9a486?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151910,"drupal_internal__target_id":9539},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"69971de9-1cb1-42b4-af26-4bce1805abf9","drupal_internal__id":9542,"drupal_internal__revision_id":151911,"langcode":"en","status":true,"created":"2023-06-22T15:00:11+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-17T16:27:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eThe Bank offers structured financing and risk management solutions tailored to the needs of our clients, based on a variety of assets or cash-flows:\u003c/p\u003e\u003cul\u003e\u003cli\u003eTrade receivables;\u003c/li\u003e\u003cli\u003eFinancial assets (e.g. car loans and leases, consumer loans, credit card loans, home loans, solar loans);\u003c/li\u003e\u003cli\u003eOperating Assets, including rental vehicle fleets, air or rail transport assets, solar and other energy transition assets; and\u003c/li\u003e\u003cli\u003eInfrastructure assets (for project bonds and private placements).\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u003cbr\u003eThese \u003cstrong\u003efinancing structures \u003c/strong\u003eare mainly refinanced by three major asset-backed commercial paper (ABCP) conduits, sponsored by Crédit Agricole CIB (rated A1/P1/F1+, LMA in Europe, ATLANTIC and LA FAYETTE in the United States), or directly via \u003cstrong\u003easset-backed securities\u003c/strong\u003e (ABS), structured and placed on the \u003cstrong\u003ecapital markets\u003c/strong\u003e.\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eThe Bank offers structured financing and risk management solutions tailored to the needs of our clients, based on a variety of assets or cash-flows:\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eTrade receivables;\u003c/li\u003e\n\u003cli\u003eFinancial assets (e.g. car loans and leases, consumer loans, credit card loans, home loans, solar loans);\u003c/li\u003e\n\u003cli\u003eOperating Assets, including rental vehicle fleets, air or rail transport assets, solar and other energy transition assets; and\u003c/li\u003e\n\u003cli\u003eInfrastructure assets (for project bonds and private placements).\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eThese \u003cstrong\u003efinancing structures \u003c/strong\u003eare mainly refinanced by three major asset-backed commercial paper (ABCP) conduits, sponsored by Crédit Agricole CIB (rated A1/P1/F1+, LMA in Europe, ATLANTIC and LA FAYETTE in the United States), or directly via \u003cstrong\u003easset-backed securities\u003c/strong\u003e (ABS), structured and placed on the \u003cstrong\u003ecapital markets\u003c/strong\u003e.\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/69971de9-1cb1-42b4-af26-4bce1805abf9?resourceVersion=id%3A151911"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/69971de9-1cb1-42b4-af26-4bce1805abf9?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151911,"drupal_internal__target_id":9542},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"5fa5896e-8bde-42c0-b71f-d058e60f5ea6","drupal_internal__id":13166,"drupal_internal__revision_id":151912,"langcode":"en","status":true,"created":"2023-09-12T05:18:02+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-17T16:27:50+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"Our presence in the world","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/5fa5896e-8bde-42c0-b71f-d058e60f5ea6?resourceVersion=id%3A151912"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/5fa5896e-8bde-42c0-b71f-d058e60f5ea6?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151912,"drupal_internal__target_id":13166},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"3c51b9ab-1c72-48c5-bdee-7e3400409f54","drupal_internal__id":9544,"drupal_internal__revision_id":151913,"langcode":"en","status":true,"created":"2023-06-22T15:01:23+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-17T16:27:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eThe \u003cstrong\u003esecuritisation business\u003c/strong\u003e has \u003cstrong\u003eexperts based in Paris, New York, Milan, and São Paulo\u003c/strong\u003e, to meet the financing needs of the Group’s clients in Europe and the Americas. The Bank also supports our multinational clients as they expand in Asia through securitisation programmes, including portfolios of Asian debtors.\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eThe \u003cstrong\u003esecuritisation business\u003c/strong\u003e has \u003cstrong\u003eexperts based in Paris, New York, Milan, and São Paulo\u003c/strong\u003e, to meet the financing needs of the Group’s clients in Europe and the Americas. The Bank also supports our multinational clients as they expand in Asia through securitisation programmes, including portfolios of Asian debtors.\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/3c51b9ab-1c72-48c5-bdee-7e3400409f54?resourceVersion=id%3A151913"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/3c51b9ab-1c72-48c5-bdee-7e3400409f54?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151913,"drupal_internal__target_id":9544},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"1b611cfc-7b4a-4334-803d-b23f6241db81","drupal_internal__id":13167,"drupal_internal__revision_id":151914,"langcode":"en","status":true,"created":"2023-09-12T05:18:35+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-12T05:18:35+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"Crédit Agricole CIB’s recognised expertise in securitisation products ","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/1b611cfc-7b4a-4334-803d-b23f6241db81?resourceVersion=id%3A151914"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/1b611cfc-7b4a-4334-803d-b23f6241db81?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151914,"drupal_internal__target_id":13167},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"2a529534-11b6-4864-b18e-18dc71441aee","drupal_internal__id":9546,"drupal_internal__revision_id":151915,"langcode":"en","status":true,"created":"2023-06-22T15:02:42+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-17T16:27:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eThanks to our worldwide franchise, Crédit Agricole CIB’s securitisation business has built a solid reputation and a high standing in the implementation of \u003cstrong\u003eprivate securitisation programmes and public and private ABS issuances.\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u003cbr\u003eThe Bank consistently ranks at the top of Euro ABS league-tables, including:\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eThanks to our worldwide franchise, Crédit Agricole CIB’s securitisation business has built a solid reputation and a high standing in the implementation of \u003cstrong\u003eprivate securitisation programmes and public and private ABS issuances.\u003c/strong\u003e\u003c/p\u003e\n\u003cp\u003eThe Bank consistently ranks at the top of Euro ABS league-tables, including:\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/2a529534-11b6-4864-b18e-18dc71441aee?resourceVersion=id%3A151915"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/2a529534-11b6-4864-b18e-18dc71441aee?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151915,"drupal_internal__target_id":9546},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--key_figures_block_v1","id":"1ce2c536-9749-4713-8173-4a2bbc9b1556","drupal_internal__id":14599,"drupal_internal__revision_id":151920,"langcode":"en","status":true,"created":"2023-10-17T16:21:34+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_sett