+00:00","status":true,"title":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP","created":"2026-09-22T12:55:02+00:00","changed":{"value":"2026-09-22T12:55:02+00:00","preserve":null},"promote":false,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"breadcrumbs":[{"uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en","resolvable_uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en","title":"Home","options":[]},{"uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/news","resolvable_uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/news","title":"News","options":[]}],"content_translation_source":"und","content_translation_outdated":false,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP | Crédit Agricole CIB"}},{"tag":"meta","attributes":{"name":"description","content":"The Bank receives four awards in total this year"}},{"tag":"meta","attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},{"tag":"meta","attributes":{"property":"og:type","content":"news"}},{"tag":"meta","attributes":{"property":"og:url","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/views/news_list/block_news_no_highlights"}},{"tag":"meta","attributes":{"property":"og:title","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP"}},{"tag":"meta","attributes":{"property":"og:description","content":"The Bank receives four awards in total this year"}},{"tag":"meta","attributes":{"property":"og:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/GMD%20SRP%20award_Group%20photo%20VF_55482_CDN_images.jpg?h=360d446d\u0026itok=NZ1gUq28"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}},{"tag":"meta","attributes":{"name":"twitter:description","content":"The Bank receives four awards in total this year"}},{"tag":"meta","attributes":{"name":"twitter:title","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP"}},{"tag":"meta","attributes":{"name":"twitter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/GMD%20SRP%20award_Group%20photo%20VF_55482_CDN_images.jpg?h=360d446d\u0026itok=NZ1gUq28"}},{"tag":"meta","attributes":{"name":"@type","content":"NewsArticle","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"headline","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"name","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"articleBody","content":"Crédit Agricole CIB has been recognised for several categories by Structured Retail Products (SRP) at its SRP Asia Pacific Awards 2026:Best House, Asian EquitiesBest House, South Korea – Hedge ProviderDeal of the YearCentral to the Bank’s award success is its commitment to payoff innovation. Through its Cross-Asset Distribution Sales team, Crédit Agricole CIB consistently showcases innovative and bespoke solutions across both Fixed Income, Currencies \u0026 Commodities (FICC) and Equity Derivatives (EQD) structured products.While the market has become increasingly commoditised, the Bank has deliberately focused on developing differentiated payout structures, an approach that has proven a key differentiator and one that continues to resonate strongly with clients.Rishad Schaefer, Head of Equity Sales \u0026 Structuring, APAC, is also awarded the Personality of the Year Award, an award voted by industry experts to recognise outstanding individual in the market., full_html","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"abstract","content":"The Bank receives four awards in total this year","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"image","content":{"@type":"ImageObject","url":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/large/public/GMD%20SRP%20award_Group%20photo%20VF_55482_CDN_images.jpg?itok=PTjs9L2l"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"datePublished","content":"2026-09-22T00:00:00+0200","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"dateModified","content":"2026-09-22T14:55:02+0200","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"mainEntityOfPage","content":"/en/news","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"@type","content":"VideoObject","group":"schema_video_object","schema_metatag":true}}],"path":{"alias":"/news/credit-agricole-cib-honoured-best-house-asian-equities-srp","pid":7752,"langcode":"en"},"cacib_extra_paths":[{"alias":"/en/news/credit-agricole-cib-honoured-best-house-asian-equities-srp","langcode":"en"}],"cacib_extra_metatags":[{"title":{"#tag":"meta","#attributes":{"name":"title","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP | Crédit Agricole CIB"}},"description":{"#tag":"meta","#attributes":{"name":"description","content":"The Bank receives four awards in total this year"}},"og_site_name":{"#tag":"meta","#attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},"og_type":{"#tag":"meta","#attributes":{"property":"og:type","content":"news"}},"og_url":{"#tag":"meta","#attributes":{"property":"og:url","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/views/news_list/block_news_no_highlights"}},"og_title":{"#tag":"meta","#attributes":{"property":"og:title","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP"}},"og_description":{"#tag":"meta","#attributes":{"property":"og:description","content":"The Bank receives four awards in total this year"}},"og_image_0":{"#tag":"meta","#attributes":{"property":"og:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/GMD%20SRP%20award_Group%20photo%20VF_55482_CDN_images.jpg?h=360d446d\u0026itok=NZ1gUq28"}},"twitter_cards_type":{"#tag":"meta","#attributes":{"name":"twitter:card","content":"summary_large_image"}},"twitter_cards_description":{"#tag":"meta","#attributes":{"name":"twitter:description","content":"The Bank receives four awards in total this year"}},"twitter_cards_title":{"#tag":"meta","#attributes":{"name":"twitter:title","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP"}},"twitter_cards_image":{"#tag":"meta","#attributes":{"name":"twitter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/GMD%20SRP%20award_Group%20photo%20VF_55482_CDN_images.jpg?h=360d446d\u0026itok=NZ1gUq28"}},"schema_article_type":{"#tag":"meta","#attributes":{"name":"@type","content":"NewsArticle","group":"schema_article","schema_metatag":true}},"schema_article_headline":{"#tag":"meta","#attributes":{"name":"headline","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP","group":"schema_article","schema_metatag":true}},"schema_article_name":{"#tag":"meta","#attributes":{"name":"name","content":"Crédit Agricole CIB is honoured as Best House, Asian Equities by SRP","group":"schema_article","schema_metatag":true}},"schema_article_article_body":{"#tag":"meta","#attributes":{"name":"articleBody","content":"Crédit Agricole CIB has been recognised for several categories by Structured Retail Products (SRP) at its SRP Asia Pacific Awards 2026:Best House, Asian EquitiesBest House, South Korea – Hedge ProviderDeal of the YearCentral to the Bank’s award success is its commitment to payoff innovation. Through its Cross-Asset Distribution Sales team, Crédit Agricole CIB consistently showcases innovative and bespoke solutions across both Fixed Income, Currencies \u0026 Commodities (FICC) and Equity Derivatives (EQD) structured products.While the market has become increasingly commoditised, the Bank has deliberately focused on developing differentiated payout structures, an approach that has proven a key differentiator and one that continues to resonate strongly with clients.Rishad Schaefer, Head of Equity Sales \u0026 Structuring, APAC, is also awarded the Personality of the Year Award, an award voted by industry experts to recognise outstanding individual in the market., full_html","group":"schema_article","schema_metatag":true}},"schema_article_abstract_0":{"#tag":"meta","#attributes":{"name":"abstract","content":"The Bank receives four awards in total this year","group":"schema_article","schema_metatag":true}},"schema_article_image":{"#tag":"meta","#attributes":{"name":"image","content":{"@type":"ImageObject","url":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/large/public/GMD%20SRP%20award_Group%20photo%20VF_55482_CDN_images.jpg?itok=PTjs9L2l"},"group":"schema_article","schema_metatag":true}},"schema_article_date_published":{"#tag":"meta","#attributes":{"name":"datePublished","content":"2026-09-22T00:00:00+0200","group":"schema_article","schema_metatag":true}},"schema_article_date_modified":{"#tag":"meta","#attributes":{"name":"dateModified","content":"2026-09-22T14:55:02+0200","group":"schema_article","schema_metatag":true}},"schema_article_author_0":{"#tag":"meta","#attributes":{"name":"author","content":{"@type":"Organization","