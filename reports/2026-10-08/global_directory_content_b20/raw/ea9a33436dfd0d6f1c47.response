:14601,"drupal_internal__revision_id":151923,"langcode":"en","status":true,"created":"2023-10-17T16:24:19+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-17T16:24:19+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"Green, social and sustainability-linked securitisation","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/64b92566-bc95-47c4-a34a-f4ed16ce2429?resourceVersion=id%3A151923"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/64b92566-bc95-47c4-a34a-f4ed16ce2429?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151923,"drupal_internal__target_id":14601},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"7c9ac1ce-a4e5-4a3b-be54-326c2b945b4b","drupal_internal__id":14602,"drupal_internal__revision_id":151924,"langcode":"en","status":true,"created":"2023-10-17T16:24:35+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-17T16:24:35+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eWith the support of Crédit Agricole CIB’s Sustainable Banking team, \u003cstrong\u003ethe securitisation product line offers a full service to originators and sponsors considering a sustainability linked securitisation.\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eIt has developed a strong expertise in inaugural securitisations aligned to the Sustainability Linked market standards for financial institutions and corporates across asset classes and geographies.\u0026nbsp;\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eWith the support of Crédit Agricole CIB’s Sustainable Banking team, \u003cstrong\u003ethe securitisation product line offers a full service to originators and sponsors considering a sustainability linked securitisation.\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\n\n\u003cp\u003eIt has developed a strong expertise in inaugural securitisations aligned to the Sustainability Linked market standards for financial institutions and corporates across asset classes and geographies.\u0026nbsp;\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/7c9ac1ce-a4e5-4a3b-be54-326c2b945b4b?resourceVersion=id%3A151924"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/7c9ac1ce-a4e5-4a3b-be54-326c2b945b4b?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151924,"drupal_internal__target_id":14602},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--fragment_placeholder_v1","id":"e5be5d64-d3e6-4755-a16e-b0b8b5b515d8","drupal_internal__id":15002,"drupal_internal__revision_id":151925,"langcode":"en","status":true,"created":"2023-10-19T12:44:04+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-19T12:44:04+00:00","preserve":null},"cacib_field_country":null,"field_placeholder_id":"abcp","links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/fragment_placeholder_v1/e5be5d64-d3e6-4755-a16e-b0b8b5b515d8?resourceVersion=id%3A151925"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/fragment_placeholder_v1/e5be5d64-d3e6-4755-a16e-b0b8b5b515d8?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151925,"drupal_internal__target_id":15002},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"cbba5342-a635-480c-9b85-0a8fcdf0de3d","resourceIdObjMeta":{"drupal_internal__target_id":"fragment_placeholder_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--sub_title_block_v1","id":"bb20af46-95bb-4892-a9ff-bfcfa5de4dca","drupal_internal__id":15061,"drupal_internal__revision_id":151926,"langcode":"en","status":true,"created":"2023-10-20T11:10:48+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-20T11:10:48+00:00","preserve":null},"cacib_field_country":null,"field_subtitle":"Green Asset-backed Commercial Paper (ABCP) programme","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/sub_title_block_v1/bb20af46-95bb-4892-a9ff-bfcfa5de4dca?resourceVersion=id%3A151926"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/sub_title_block_v1/bb20af46-95bb-4892-a9ff-bfcfa5de4dca?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151926,"drupal_internal__target_id":15061},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"e4cec8ab-fae3-44a4-b3fe-1ddb00ac2a31","resourceIdObjMeta":{"drupal_internal__target_id":"sub_title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"67f02453-41fe-42fb-a283-6a7216ec0e44","drupal_internal__id":14604,"drupal_internal__revision_id":151927,"langcode":"en","status":true,"created":"2023-10-17T16:25:22+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-19T13:21:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eIn 2020 Crédit Agricole CIB structured the first green ABCP backed by trade and auto loan/lease receivables contributing to the energy and environmental transition. Since then, LMA and ATLANTIC issue green CP (Commercial Paper) on the European and US markets.\u0026nbsp;\u003c/p\u003e\u003cp\u003eThese issuances are aligned with market principles (Green Securitised Bond in Appendix 1 of the 2021 Green Bond Principles) and with the Schedule 1 of Crédit Agricole Group Green Bond Framework.\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eIn 2020 Crédit Agricole CIB structured the first green ABCP backed by trade and auto loan/lease receivables contributing to the energy and environmental transition. Since then, LMA and ATLANTIC issue green CP (Commercial Paper) on the European and US markets.\u0026nbsp;\u003c/p\u003e\n\u003cp\u003eThese issuances are aligned with market principles (Green Securitised Bond in Appendix 1 of the 2021 Green Bond Principles) and with the Schedule 1 of Crédit Agricole Group Green Bond Framework.\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/67f02453-41fe-42fb-a283-6a7216ec0e44?resourceVersion=id%3A151927"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/67f02453-41fe-42fb-a283-6a7216ec0e44?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151927,"drupal_internal__target_id":14604},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]}],"field_page_bottom_footer":[],"field_page_contact":null,"field_page_top_footer":[{"type":"paragraph--section_background_block_v1","id":"901f3235-6fda-41de-af97-43d1b786b10a","resourceIdObjMeta":{"target_revision_id":151932,"drupal_internal__target_id":16648}},{"type":"paragraph--news_block_v1","id":"b01b9863-d0c0-43aa-ada8-5a4e28782ae2","drupal_internal__id":10234,"drupal_internal__revision_id":151933,"langcode":"en","status":true,"created":"2023-08-14T14:06:20+00:00","parent_id":"1137","parent_type":"node","parent_field_name":"field_page_top_footer","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-11-08T09:16:40+00:00","preserve":null},"cacib_field_country":null,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/news_block_v1/b01b9863-d0c0-43aa-ada8-5a4e28782ae2?resourceVersion=id%3A151933"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/news_block_v1/b01b9863-d0c0-43aa-ada8-5a4e28782ae2?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":151933,"drupal_internal__target_id":10234},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"0c63c8f4-4b95-4237-ade9-9005385a96b0","resourceIdObjMeta":{"drupal_internal__target_id":"news_block_v1"}},"field_views":{"type":"view--view","id":"news_list--block_3_latest_related_news","resourceIdObjMeta":{"display_id":"block_3_latest_related_news","data":{"limit":null,"pager":null,"offset":null,"title":null,"argument":null,"exposed_filters":{"vr_exposed_filters_visible":false,"field_news_types_value":[],"field_sectors_target_id":[],"field_country_target_id":[],"combine":"","field_publishing_date_value_wrapper":{"field_publishing_date_value":{"min":"","max":""}},"field_categories_target_id":{"26":"26","27":"27","28":"28","29":"29","33":"33"},"field_secondary_categories_target_id":[]}},"drupal_internal__target_id":"news_list","related_content":true},"results":[{"type":"node--actualite","id":"ef74676b-ea55-47cc-bac2-40bd9146c9a7","drupal_internal__nid":3655,"drupal_internal__vid":20542,"langcode":"en","revision_timestamp":"2026-10-06T12:20:01+00:00","status":true,"title":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance","created":"2026-10-06T12:15:01+00:00","changed":{"value":"2026-10-06T12:20:01+00:00","preserve":null},"promote":false,"sticky":false,"default_langcode":true,"revision_translation_affected":true,"breadcrumbs":[{"uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en","resolvable_uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en","title":"Home","options":[]},{"uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/news","resolvable_uri":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/news","title":"News","options":[]}],"content_translation_source":"und","content_translation_outdated":false,"metatag":[{"tag":"meta","attributes":{"name":"title","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance | Crédit Agricole CIB"}},{"tag":"meta","attributes":{"name":"description","content":"A continued testament to the Bank’s expertise and commitment to Hong Kong’s digital and sustainable finance leadership"}},{"tag":"meta","attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},{"tag":"meta","attributes":{"property":"og:type","content":"news"}},{"tag":"meta","attributes":{"property":"og:url","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/views/news_list/block_news_highlight"}},{"tag":"meta","attributes":{"property":"og:title","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance"}},{"tag":"meta","attributes":{"property":"og:description","content":"A continued testament to the Bank’s expertise and commitment to Hong Kong’s digital and sustainable finance leadership"}},{"tag":"meta","attributes":{"property":"og:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/shutterstock_2730711979_54915_CDN_images.jpg?h=790be497\u0026itok=OMO_kl26"}},{"tag":"meta","attributes":{"name":"twitter:card","content":"summary_large_image"}},{"tag":"meta","attributes":{"name":"twitter:description","content":"A continued testament to the Bank’s expertise and commitment to Hong Kong’s digital and sustainable finance leadership"}},{"tag":"meta","attributes":{"name":"twitter:title","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance"}},{"tag":"meta","attributes":{"name":"twitter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/shutterstock_2730711979_54915_CDN_images.jpg?h=790be497\u0026itok=OMO_kl26"}},{"tag":"meta","attributes":{"name":"@type","content":"NewsArticle","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"headline","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"name","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"articleBody","content":"The Hong Kong Special Administrative Region (HKSAR) Government has successfully priced its fourth digital green bond offering on 28 September 2026, raising approximately HK$20 billion equivalent across four currencies. This landmark transaction represents the world’s largest digital bond issuance to date, reinforcing Hong Kong’s position as a global leader in digital finance, underscoring its unwavering commitment to driving innovation in the bond market.The multi-currency offering, comprising Hong Kong dollars, Renminbi, US dollars, and Euro tranches, achieved exceptional oversubscription with ratios ranging from 1.3 to 11.3 time, highlighting strong investor demand for Hong Kong-issued tokenised products.This fourth issuance builds on the success of previous digital bond issuances in 2023, 2024 and 2025, all supported by the Bank, whilst further introducing groundbreaking features that advance the digital bond market: World's first digital bond to integrate tokenised deposits in HKD into the primary settlement process, advancing towards a more integrated digital ecosystem.Adopted the International Capital Market Association's Bond Data Taxonomy Version 2.0, promoting greater data consistency and end-to-end automation across the bond lifecycle. Issuance size reached HK$20 billion equivalent, doubling the prior issuance and setting a new global record for digital bond issuances.Proceeds will support eligible projects under the Government Green Bond Framework that advance Hong Kong's sustainable development objectives.Crédit Agricole CIB acted as Joint Global Coordinator, Joint Bookrunner, Joint Lead Manager, and Joint Green and Sustainable Bond Structuring Bank on this transaction. , full_html","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"abstract","content":"A continued testament to the Bank’s expertise and commitment to Hong Kong’s digital and sustainable finance leadership ","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"image","content":{"@type":"ImageObject","url":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/large/public/shutterstock_2730711979_54915_CDN_images.jpg?itok=j8JqVgpH"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"datePublished","content":"2026-10-06T00:00:00+0200","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"dateModified","content":"2026-10-06T14:20:01+0200","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"mainEntityOfPage","content":"/en/news","group":"schema_article","schema_metatag":true}},{"tag":"meta","attributes":{"name":"@type","content":"VideoObject","group":"schema_video_object","schema_metatag":true}}],"path":{"alias":"/news/credit-agricole-cib-supports-hong-kong-sar-governments-record-breaking-fourth-digital-green","pid":7762,"langcode":"en"},"cacib_extra_paths":[{"alias":"/en/news/credit-agricole-cib-supports-hong-kong-sar-governments-record-breaking-fourth-digital-green","langcode":"en"}],"cacib_extra_metatags":[{"title":{"#tag":"meta","#attributes":{"name":"title","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance | Crédit Agricole CIB"}},"description":{"#tag":"meta","#attributes":{"name":"description","content":"A continued testament to the Bank’s expertise and commitment to Hong Kong’s digital and sustainable finance leadership"}},"og_site_name":{"#tag":"meta","#attributes":{"property":"og:site_name","content":"Crédit Agricole CIB"}},"og_type":{"#tag":"meta","#attributes":{"property":"og:type","content":"news"}},"og_url":{"#tag":"meta","#attributes":{"property":"og:url","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/views/news_list/block_news_highlight"}},"og_title":{"#tag":"meta","#attributes":{"property":"og:title","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance"}},"og_description":{"#tag":"meta","#attributes":{"property":"og:description","content":"A continued testament to the Bank’s expertise and commitment to Hong Kong’s digital and sustainable finance leadership"}},"og_image_0":{"#tag":"meta","#attributes":{"property":"og:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/shutterstock_2730711979_54915_CDN_images.jpg?h=790be497\u0026itok=OMO_kl26"}},"twitter_cards_type":{"#tag":"meta","#attributes":{"name":"twitter:card","content":"summary_large_image"}},"twitter_cards_description":{"#tag":"meta","#attributes":{"name":"twitter:description","content":"A continued testament to the Bank’s expertise and commitment to Hong Kong’s digital and sustainable finance leadership"}},"twitter_cards_title":{"#tag":"meta","#attributes":{"name":"twitter:title","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance"}},"twitter_cards_image":{"#tag":"meta","#attributes":{"name":"twitter:image","content":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/shutterstock_2730711979_54915_CDN_images.jpg?h=790be497\u0026itok=OMO_kl26"}},"schema_article_type":{"#tag":"meta","#attributes":{"name":"@type","content":"NewsArticle","group":"schema_article","schema_metatag":true}},"schema_article_headline":{"#tag":"meta","#attributes":{"name":"headline","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance","group":"schema_article","schema_metatag":true}},"schema_article_name":{"#tag":"meta","#attributes":{"name":"name","content":"Crédit Agricole CIB supports Hong Kong SAR Government’s record-breaking fourth digital green bond issuance","group":"schema_article","schema_metatag":true}},"schema_article_article_body":{"#tag":"meta","#attributes":{"name":"articleBody","content":"The Hong Kong Special Administrative Region (HKSAR) Government has successfully priced its fourth digital green bond offering on 28 September 2026, raising approximately HK$20 billion equivalent across four currencies. This landmark transaction represents the world’s largest digital bond issuance to date, reinforcing Hong Kong’s position as a global leader in digital finance, underscoring its unwavering commitment to driving innovation in the bond market.The multi-currency offering, comprising Hong Kong dollars, Renminbi, US dollars, and Euro tranches, achieved exceptional oversubscription with ratios ranging from 1.3 to 11.3 time, highlighting strong investor demand for Hong Kong-issued tokenised products.This fourth issuance builds on the success of previous digital bond issuances in 2023, 2024 and 2025, all supported by the Bank, whilst further introducing groundbreaking features that advance the digital bond market: World's first digital bond to integrate tokenised deposits in HKD into the primary settlement process, advancing towards a more integrated digital ecosystem.Adopted the International Capital Market Association's Bond Data Taxonomy Version 2.0, promoting greater data consistency and end-to-end automation across the bond lifecycle. Issuance size reached HK$20 billion equivalent, doubling the prior issuance and setting a new global record for digital bond issuances.Proceeds will support eligible projects under the Government Green Bond Framework that advance Hong Kong's sustainable development objectives.Crédit Agricole CIB acted as Joint Global Coordinator, Joint Bookrunner, Joint Lead Manager, and Joint Green and Sustainable Bond Structuring Bank on this transaction. , full_html","group":"schema_article","schema_metatag":true}},"schema_article_abstract_0":{"#tag":"meta","#attributes":{"name":"abstract","content":"A continued testament to the Bank’s expertise and commitment to Hong Kong’s digital and sustainable finance leadership ","group":"schema_article","schema_metatag":true}},"schema_article_image":{"#tag":"meta","#attributes":{"name":"image","content":{"@type":"ImageObject","url":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/large/public/shutterstock_2730711979_54915_CDN_images.jpg?itok=j8JqVgpH"},"group":"schema_article","schema_metatag":true}},"schema_article_date_published":{"#tag":"meta","#attributes":{"name":"datePublished","content":"2026-10-06T00:00:00+0200","group":"schema_article","schema_metatag":true}},"schema_article_date_modified":{"#tag":"meta","#attributes":{"name":"dateModified","content":"2026-10-06T14:20:01+0200","group":"schema_article","schema_metatag":true}},"schema_article_author_0":{"#tag":"meta","#attributes":{"name":"author","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},"schema_article_publisher":{"#tag":"meta","#attributes":{"name":"publisher","content":{"@type":"Organization","name":"Crédit Agricole CIB"},"group":"schema_article","schema_metatag":true}},"schema_article_main_entity_of_page":{"#tag":"meta","#attributes":{"name":"mainEntityOfPage","content":"/en/news","group":"schema_article","schema_metatag":true}},"schema_video_object_type":{"#tag":"meta","#attributes":{"name":"@type","content":"VideoObject","group":"schema_video_obj