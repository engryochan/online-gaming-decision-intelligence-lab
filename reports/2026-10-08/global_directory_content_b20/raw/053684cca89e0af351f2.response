</div></div></div></div></div></div></div></main><footer data-cms-snapshot-exclude="true"><div id="integration-id-dec38ec" class="contents globalotc"></div></footer></div></div><noscript><iframe title="GTM" src="https://www.googletagmanager.com/ns.html?id=GTM-5VF73HX" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript><div data-page="65132" data-slot="adhoc-styles"><div id="integration-id-3fa73e0" class="contents globalotc"></div></div><script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>(function(w){const CMS2 = w.CMS2 = w.CMS2 || {hydrationQueue:[]};CMS2.hydrationQueue.push({"pageId":65132,"renderContext":{"isCmsAdmin":false,"isCmsEditor":false,"isCmsPreview":false,"isCmsDemo":false,"publishDate":1730145029287,"pageId":65132,"pageTitle":"Trading Fees","pageBreadCrumbTitle":"","pageStatus":"published","urlPath":"/brokers/trading-fees","query":{},"siteId":21768,"siteDomain":"globalotc.com","siteName":"globalotc","cdnBaseUrl":"https://static.ice.com","requestPath":"/brokers/trading-fees","version":"41.10.17","theme":"globalotc","ssoBaseUrl":"https://sso.ice.com","injectable":true,"gtmId":"GTM-5VF73HX","hydrate":true,"favicon":null,"faviconType":"image/x-icon","appBaseUrl":"http://localhost:29080","appProxyUrl":"/api/sites/globalotc/proxy"},"featureFlags":{"removeInjectedHeadElements":true},"headTags":[{"id":"title","type":"title","props":{"children":"Trading Fees"}},{"id":"https://static.ice.com/cms/41.10.17/assets/globalotc.css","type":"link","props":{"rel":"stylesheet","href":"https://static.ice.com/cms/41.10.17/assets/globalotc.css"}},{"id":"https://static.ice.com/cms/41.10.17/hydrate.js","type":"link","props":{"rel":"modulepreload","href":"https://static.ice.com/cms/41.10.17/hydrate.js"}},{"id":"https://static.ice.com/cms/41.10.17/chunks/__generated__/components/demos-DhThR4g2.js","type":"link","props":{"rel":"modulepreload","href":"https://static.ice.com/cms/41.10.17/chun