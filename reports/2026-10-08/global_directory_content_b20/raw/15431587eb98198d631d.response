    <div class="press-filter">
        <form method="post" action="#" name="filter" id="filterOffers" autocomplete='off'>
            <fieldset>
                <ul>
                    <li>
                        <div id='cmb-2' >
                            <div class="combo square ui-component" id="mer" >
                                <span class="value">
                                    <span class="text">Market</span>
                                    <span class="button"></span>
                                </span>
                                <ul class="options">
                                    <li>
                                        <label for="mer_0">Market</label>
                                        <input type="radio" value="" name="mercado" id="mer_0">
                                    </li>

                                </ul>
                            </div>
                        </div>
                    </li>
                    <li>
                        <div id='cmb-3' >
                            <div class="combo square ui-component" id="tpval" >
                                <span class="value">
                                    <span class="text">Asset Class</span>
                                    <span class="button"></span>
                                </span>
                                <ul class="options">
                                    <li>
                                        <label for="tipVal_0">Asset Class</label>
                                        <input type="radio" value="" name="tipval" id="tipVal_0">
                                    </li>

                                </ul>
                            </div>
                        </div>
                    </li>
                    <li>
                        <input type="submit" value="SEARCH">
                    </li>
                </ul>
            </fieldset>
        </form>
    </div>
    <section class="prospects">
        <div class="headline-area">
            <div class="sort">
                <form method="post" action="#" name="filterPros" autocomplete='off'>
                    <fieldset>
                        <div id='cmb-4' >
                            <div class="combo square ui-component" id="filtTab" >
                                <span class="value">
                                    <span class="text">Order by</span>
                                    <span class="button"></span>
                                </span>
                                <ul class="options">
                                    <li>
                                        <label for="filt_val">Order by</label>
                                        <input type="radio" value="" name="filtVal" id="filt_val">
                                    </li>
                                    <li>
                                        <label for="filt_val_1">DATE</label>
                                        <input type="radio" value="0" name="filtVal" id="filt_val_1">
                                    </li>
                                    <li>
                                        <label for="filt_val_2">TICKER</label>
                                        <input type="radio" value="2" name="filtVal" id="filt_val_2">
                                    </li>
                                    <li>
                                        <label for="filt_val_3">ISSUER</label>
                                        <input type="radio" value="3" name="filtVal" id="filt_val_3">
                                    </li>
                                    <li>
                                        <label for="filt_val_4">SETTLOR</label>
                                        <input type="radio" value="4" name="filtVal" id="filt_val_4">
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
            <h3>Prospectus</h3>
        </div><!-- headline-area -->

        <table id="tableProspect" class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th class="cell-01">DATE</th>
                    <th class="cell-02">TICKER</th>
                    <th class="cell-03">ISSUER</th>
                    <th class="cell-04">SETTLOR</th>
                    <th>DOCUMENT</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{id}}</td>
                    <td>{{prettyDate}}</td>
                    <td><strong>{{claveEmisora}}</strong></td>
                    <td>
                        {{emisor}}
                    </td>
                    <td>
                       {{fideicomitente}}
                    </td>
                    <td>
                        {{descripcion}}
                        <div class="holder content-area">
                            <a href="{{archivo}}" class="lnk-download {{anyFile}}" target="_blank">
                                <span class="icon"></span>
                                <span class="text">Download</span>
                                <span class="document"></span>
                            </a>
                            {{search}}
                            <input type="hidden" value='{{id}}'/>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </section>
    <div class="templateTable">
        <table id="tableDetail">
            <thead>
                <tr>
                    <th class="cell-03">PUBLICATION DATE</th>
                    <th>DOCUMENT</th>       
                    <th class="cell-04"></th>         
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>{{prettyDate}}</td>
                    <td>{{descripcionDocumento}}</td>
                    <td>
                        <a href="{{dataFile}}" class="lnk-download {{anyFile}}" target="_blank">
                            <span class="icon"></span>
                            <span class="text">Download</span>
                            <span class="document"></span>
                        </a>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
    
</div>
