<div id="windowLogin" class="modal-body ">
    <h2>Register Users</h2>
    <div class="server-message ">
        <span class="icon info"></span>
        <p>null</p>
    </div>
    <form id="loginForm" class="form-login" autocomplete="off" method="post" action="https://www.bmv.com.mx/en/Grupo_BMV/Prospectos_de_colocacion/_aid/688/_act/loginUser">
        <ul>
            <li>
                <span class="messages error">Debe ser un correo v&aacute;lido</span>
                <label for="txtEmail" title="Username">Username</label>
                <input id="txtEmail" name="wb_username" type="text" value="" />
            </li>
            <li>
                <span class="messages error">Mensaje de error</span>
                <label for="txtPassword" title="Password">Password</label>
                <input id="txtPassword" name="wb_password" type="password" value="" />
            </li>
            <li><p><input id="btnLogin" name="login" type="submit" value="Login" /></p></li>
        </ul>
        <ul class="list-options">
            <li><a id="lnkRecover" href="#">I forgot my password?</a></li>
            <li><a id="lnkRegister" href="#">Register</a></li>
        </ul>
    </form>
</div><!--End window log in-->

<div id="windowRegister" class="modal-body">
    <h2>Register</h2>
    <form id="addUserForm" class="form-register" autocomplete="off" method="post" action="/en/Grupo_BMV/Prospectos_de_colocacion/_aid/688/_act/add">
        <fieldset>
            <legend>Fields marked * are required.</legend>
            <ul class="col-3">
                <li class="col">
                    <span class="messages error">La informaci&oacute;n que haz llenado es incorrecta.</span>
                    <label for="txtEmailRegister" title="Email">*Email</label>
                    <input id="txtEmailRegister" name="usrEmail" class="txt" type="text" value="" />
                </li>
                <li class="col">
                    <span class="messages error">La informaci&oacute;n que haz llenado es incorrecta.</span>
                    <label for="txtPasswordRegister" title="Password">*Password</label>
                    <input id="txtPasswordRegister" name="usrPassword" class="txt" maxlength="16" type="password" value="" />
                </li>
                <li class="col">
                    <span class="messages error">La informaci&oacute;n que haz llenado es incorrecta.</span>
                    <label for="txtConfirmPassword" title="Confirm Password">*Confirm Password</label>
                    <input id="txtConfirmPassword" name="usrConfirmPassword" class="txt" maxlength="16" type="password" value="" />
                </li>
            </ul>
            <p>Suggested: a minimum of 8 and a maximum of 16 characters, having at least one capital letter and one number. As an option, you can use special characters and no consecutive characters will be allowed.</p>
            <ul class="col-3">
                <li class="col">
                    <label for="txtName" title="Name">*Name</label>
                    <input id="txtName" name="usrName" class="txt" type="text" value="" />
                </li>
                <li class="col">
                    <label for="txtLastName_1" title="LastName">*LastName</label>
                    <input id="txtLastName_1" name="usrLastName" class="txt" type="text" value="" />
                </li>
                <li class="col">
                    <label for="txtLastName_2" title="Second LastName">*Second LastName</label>
                    <input id="txtLastName_2" name="usrSecondLastName" class="txt" type="text" value="" />
                </li>
            </ul>
            <ul class="col-3">
                <li class="col">
                    <label for="txtCompany" title="Company">Company</label>
                    <input id="txtCompany" name="usrEmpresa" class="txt" type="text" value="" />
                </li>
                <li class="col">
                    <label for="txtPhone" title="Telephone">*Telephone</label>
                    <input id="txtPhone" name="usrTel" class="txt" type="text" value="" />
                </li>
                <li id="boxCountries" class="column">
                    <div id="cboCountries" class="combo square ui-component">
                      <span class="value">
                        <span class="text">*Country</span>
                        <span class="button"></span>
                      </span>
                        <ul class="options">
                            <li>
                                <label for="rbCountry_0" title="Country">*Country</label>
                                <input id="rbCountry_0" name="usrCountry" type="radio" value="" />
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
            <ul class="center-register">
                <li class="checkbox">
                    <input id="chkTerms" name="terms" type="checkbox" value="1" />
                    <p class="special">
                        <label id="lbTerms" title="terms of use" for="chkTerms"><span></span>I have read and accept the</label>&nbsp;
                        <a href="/en/terms-of-use" target="_blank">terms of use</a>
                        and the
                        <a href="/en/privacy-policy" target="_blank">privacy policy.</a>
                    </p>
                </li>
                <li>
                    <!-- Captcha -->
                    <div id='idcaptcha_registro' class='commonCaptcha'>
                        <p class="special">To continue, please click on the number:<strong>&nbsp;TWO</strong></p>
                        <ul id="captchaRegister" class="captcha">
                            
                            <li>
                                <input class="default" id="idcaptcha_registro_2" name="captcha_idcaptcha_registro" type="radio" value="2"/>
                                <input type="hidden" class="keyHidd_idcaptcha_registro_2" value='OTgxOTQ2ZjRjZWI0YjE0ZDMyNDQzZmY4NTA5OTA4YmM='/>
                                <input type="hidden" class="dateHidd_idcaptcha_registro_2" value='2026-10-08 12:10:13.298'/>
                                <label for="idcaptcha_registro_2">2</label>
                            </li>
                            
                            <li>
                                <input class="default" id="idcaptcha_registro_4" name="captcha_idcaptcha_registro" type="radio" value="4"/>
                                <input type="hidden" class="keyHidd_idcaptcha_registro_4" value='OTgxOTQ2ZjRjZWI0YjE0ZDMyNDQzZmY4NTA5OTA4YmM='/>
