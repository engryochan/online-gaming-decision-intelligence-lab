    <div class="text parbase">
<div style="margin: 0.0px 0.0px 0.0px 0.0px; padding: 10.0px 0.0px 0.0px 20.0px;"><p style="text-align: left;"><img alt="" style="float: left; padding-right: 15.0px; padding-bottom: 10.0px; padding-top: 10.0px; margin-bottom: 25.0px;" src="/content/dam/anzcomau/Icons/ico-talkwithus.svg"></p>
