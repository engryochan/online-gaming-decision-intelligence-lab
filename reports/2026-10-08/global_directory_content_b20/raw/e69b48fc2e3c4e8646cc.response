>
            

    <div>
        <script id="coveo7251E2B7"
                class="result-template"
                type="text/x-underscore-template"
               >
            <!-- If you get an "Unexpected Token <" issue on this line with SXA, refer to: https://docs.coveo.com/en/2098/ -->
            {{
    const ascHideExcerpt = document.getElementById("asc-hide-excerpt");
    var hideExcerpt = ascHideExcerpt.dataset.value === "True";

    function formatUTCDate(date) {
        return (date.getUTCMonth() + 1) + '/' + date.getUTCDate() + '/' + date.getUTCFullYear();
    }

    // clean up clickUri
    var urlOne = "asc-cws-prod-web-cd.azurewebsites.net";
    var urlTwo = "test.albertasecurities.com";
    var positionOne = clickUri.lastIndexOf(urlOne);
    var positionTwo = clickUri.lastIndexOf(urlTwo);
    if( positionOne > -1 || positionTwo > -1 ){

        if(positionOne > -1 )
        {
            clickUri = clickUri.substring(positionOne + urlOne.length);
        }
        if(positionTwo > -1 )
        {
            clickUri = clickUri.substring(positionTwo + urlTwo.length);
        }
    }
}}
<div class="coveo-result-frame coveoforsitecore-template">
    <div class="coveo-result-row">

        <div class="coveo-result-cell coveoforsitecore-information-section">
            <!-- #region Investment Caution -->
            {{ if (raw.templatename == "Investment Caution") { }}
            <div class="investment-caution-result">
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class='coveo-title'>
                                <% if (coveoFieldValue("HasLayout") === "1" || raw.syssource !== currentSourceName()) { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink' target="_blank"><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                <% } else { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink' target="_blank"><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                <% } %>
                            </div>
                        </div>
                        <% if (!hideExcerpt) { %>
                        <div class="coveo-result-row">
                            <div class="coveo-result-cell">
                                <span class="CoveoExcerpt"></span>
                            </div>
                        </div>
                        <% } %>
                    </div>
                    <div class="coveo-result-cell coveoforsitecore-time-cell">
                        {{var options = {year: 'numeric', month: 'long', day: 'numeric' };}}
                        {{if (raw.z95xinvestmentcautiondate != null){}}
                        {{var itemDate = new Date(raw.z95xinvestmentcautiondate)}}
                        {{=itemDate.toLocaleDateString("en-US")}}
                        {{ } else { }}
                        {{var itemDate = new Date(raw.sysdate)}}
                        {{=itemDate.toLocaleDateString("en-US")}}
                        {{ } }}
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Weekly Update -->
            {{ } else if (raw.templatename == "Weekly Update") { }}
            <div class="news-release-result">
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class='coveo-title'>
                                <%= raw.z95xtitle %>
                            </div>
                        </div>
                        <div class="coveo-result-row">
                            <%= raw.z95xweeklyupdatebody %>
                        </div>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region News Release -->
            {{ } else if (raw.templatename == "News Release") { }}
            <div class="news-release-result">
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class='coveo-title'>
                                <% if (coveoFieldValue("HasLayout") === "1" || raw.syssource !== currentSourceName()) { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink'><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                <% } else { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink'><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                <% } %>
                            </div>
                        </div>
                        <% if (!hideExcerpt) { %>
                        <div class="coveo-result-row">
                            <div class="coveo-result-cell">
                                <span class="CoveoExcerpt"></span>
                            </div>
                        </div>
                        <% } %>
                    </div>
                    <div class="coveo-result-cell coveoforsitecore-time-cell">
                        {{var options = {year: 'numeric', month: 'long', day: 'numeric' };}}
                        {{if (raw.z95xnewspublishdate != null){}}
                        {{var itemDate = new Date(raw.z95xnewspublishdate)}}
                        {{=itemDate.toLocaleDateString("en-US")}}
                        {{ } else { }}
                        {{var itemDate = new Date(raw.sysdate)}}
                        {{=itemDate.toLocaleDateString("en-US")}}
                        {{ } }}
                    </div>
                    <div class="coveo-result-cell">
                        <span class="newsreleasetype">
                            {{if (raw.z95xnewsreleasetype != null ) { }}{{=raw.z95xnewsreleasetype}}{{ } else { }}ASC{{ } }}
                        </span>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Event -->
            {{ } else if (raw.templatename == "Event") { }}
            <div class="event-result">
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class='coveo-title'>
                                <% if (coveoFieldValue("HasLayout") === "1" || raw.syssource !== currentSourceName()) { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink'><%= raw.z95xeventtitle ? highlight(raw.z95xeventtitle, titleHighlights) : clickUri %></a>
                                <% } else { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink'><%= raw.z95xeventtitle ? highlight(raw.z95xeventtitle, titleHighlights) : clickUri %></a>
                                <% } %>
                            </div>
                        </div>
                        <% if (!hideExcerpt) { %>
                        <div class="coveo-result-row">
                            <div class="coveo-result-cell">
                                <span class="CoveoExcerpt"></span>
                            </div>
                        </div>
                        <% } %>
                    </div>
                    <div class="coveo-result-cell coveoforsitecore-time-cell">
                        {{var options = {year: 'numeric', month: 'long', day: 'numeric' };}}
                        {{if (raw.z95xeventdatetime != null){}}

                        {{var itemDate = new Date(raw.z95xeventdatetime)}}

                        {{=itemDate.toLocaleDateString("en-US")}}
                        {{ } }}
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Exempt Financing-->
            {{ } else if (raw.templatename == "Exempt Financing") { }}
            <div class="exempt-financing-result">
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class="coveo-result-cell">
                                <div class='coveo-title'>
                                    <% if (coveoFieldValue("HasLayout") === "1" || raw.syssource !== currentSourceName()) { %>
                                    <a href="{{=clickUri}}" class='CoveoResultLink'><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                    <% } else { %>
                                    <a href="{{=clickUri}}" class='CoveoResultLink'><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                    <% } %>
                                </div>
                            </div>
                            <div class="coveo-result-cell">
                                <div class="coveo-result-row">
                                    <div class="coveo-result-cell">Total proceed in AB:</div>
                                    <div class="coveo-result-cell">{{=raw.z95xeftotalproceed}}</div>
                                </div>
                                <div class="coveo-result-row">
                                    <div class="coveo-result-cell">Distribution Date:</div>
                                    <div class="coveo-result-cell">{{=raw.z95xefdistributiondate}}</div>
                                </div>
                                <div class="coveo-result-row">
                                    <div class="coveo-result-cell">Exemption:</div>
                                    <div class="coveo-result-cell">{{=raw.z95xefez120xemption}}</div>
                                </div>
                            </div>
                        </div>
                        <% if (!hideExcerpt) { %>
                        <div class="coveo-result-row">
                            <div class="coveo-result-cell">
                                {{ if (raw.z95xsummarydesc) { }}
                                <span class="SummaryDesc">{{=raw.z95xsummarydesc}}</span>
                                {{ } else { }}
                                <span class="CoveoExcerpt"></span>
                                {{ } }}
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region PDO Exemption Orders | Exemption Orders -->
            {{ } else if (raw.z95xcontenttype == "PDO Exemption Orders" || raw.z95xinformationtype=="Exemption Orders"){ }}
            <div class="exemption-orders-result proceedings">
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="icon desktop-only">
                            <img src="/img/icons/{{=raw.sysfiletype}}.png">
                        </div>
                    </div>
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class='coveo-title'>
                                <% if (coveoFieldValue("HasLayout") === "1" || raw.syssource !== currentSourceName()) { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink' target="_blank"><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                <% } else { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink' target="_blank"><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="coveo-result-cell">{{=raw.z95xez120xemptionorderstype}}</div>
                    <div class="coveo-result-cell">
                        {{var options = {year: 'numeric', month: 'long', day: 'numeric' };}}
                        {{if (raw.z95xcreateddate != null){}}

                        {{var itemDate = new Date(raw.z95xcreateddate)}}

                        {{=itemDate.toLocaleDateString("en-US")}}
                        {{ } else { }}

                        {{var itemDate = new Date(raw.sysdate)}}

                        {{=itemDate.toLocaleDateString("en-US")}}
                        {{ } }}
                    </div>
                    <div class="coveo-result-cell">{{=raw.z95xefez120xemption}}</div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Rule Review -->
            {{ } else if (raw.z95xinformationtype=="Rule Review"){ }}
            <div class="rulereview-orders-result proceedings">
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class='coveo-title'>
                                <% if (coveoFieldValue("HasLayout") === "1" || raw.syssource !== currentSourceName()) { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink' target="_blank"><%= raw.z95xrulereviewtitle ? highlight(raw.z95xrulereviewtitle, titleHighlights) : clickUri %></a>
                                <% } else { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink' target="_blank"><%= raw.z95xrulereviewtitle ? highlight(raw.z95xrulereviewtitle, titleHighlights) : clickUri %></a>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="coveo-result-cell">
                        {{var options = {year: 'numeric', month: 'long', day: 'numeric' };}}
                        {{if (raw.z95xrulereviewpublicationdate != null){}}

                        {{var itemDate = new Date(raw.z95xrulereviewpublicationdate)}}

                        {{=formatUTCDate(itemDate)}}
                        {{ } else { }}

                        {{var itemDate = new Date(raw.sysdate)}}

                        {{=itemDate.toLocaleDateString("en-US")}}
                        {{ } }}
                    </div>
                    <div class="coveo-result-cell">{{=raw.z95xrulereviewtype}}</div>
                </div>
            </div>
            <!-- #endregion -->
            <!-- #region Proceedings Decisions and Orders -->
            {{ } else if (raw.templatename == "Proceedings Decisions and Orders") { }}
            {{ if (raw.z95xpdostatus == "Unpaid (Full)" || raw.z95xpdostatus == "Unpaid (Partial)" || raw.z95xpdostatus == "Paying as Agreed") { }}
            <div class="pdo-unpaid-result">
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class='coveo-title'>
                                <% if (coveoFieldValue("HasLayout") === "1" || raw.syssource !== currentSourceName()) { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink' target="_blank"><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                <% } else { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink' target="_blank"><%= raw.z95xtitle ? highlight(raw.z95xtitle, titleHighlights) : clickUri %></a>
                                <% } %>
                                {{if (raw.z95xpdodocuments != null) { }}
                                <div class="coveo-result-row">
                                    <div class="coveo-result-cell">{{=raw.z95xpdodocuments}}</div>
                                </div>
                                {{ } }}
                            </div>
                        </div>
                    </div>
                    <div class="coveo-result-cell">
                        {{if (raw.z95xdecisiondate != null){}}
                        {{var options = { year: 'numeric', month: 'long', day: 'numeric' };}}
                        {{var itemDate = new Date(raw.z95xdecisiondate)}}
                        <span class="metadata-label">Date of Decision: </span> {{=itemDate.toLocaleDateString("en-US", options)}}
                        {{ } else if (raw.z95xcreateddate != null){}}
                        {{var options = { year: 'numeric', month: 'long', day: 'numeric' };}}
                        {{var itemDate = new Date(raw.z95xcreateddate)}}
                        {{=itemDate.toLocaleDateString("en-US", options)}}
                        {{ } }}
                    </div>
                    <div class="coveo-result-cell">
                        {{if (raw.z95xpdostatus != null) { }}
                        <span class="metadata-label">Status: </span>{{=raw.z95xpdostatus}}
                        {{ } }}
                    </div>
                </div>
            </div>
            {{ } else { }}
            <div class="pdo-archived-current-result">
                {{ var respondent = raw.z95xpdorespondents;}}
                {{ respondent = respondent.replaceAll("<div>","");}}
                {{ respondent = respondent.replaceAll("</div>","");}}
                {{ respondent = respondent.replaceAll("<br />","|");}}
                {{ var respondentList = respondent.split('|');}}
                <div class="coveo-result-row">
                    <div class="coveo-result-cell">
                        <div class="coveo-result-row">
                            <div class='coveo-title'>
                                {{ _.each(respondentList, function (result, index){ }}
                                <% if (coveoFieldValue("HasLayout") === "1" || raw.syssource !== currentSourceName()) { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink {{=raw.sysfiletype}}' target="_blank">{{=result?highlight(result, titleHighlights):clickUri}}</a></br>
                                <% } else { %>
                                <a href="{{=clickUri}}" class='CoveoResultLink {{=raw.sysfiletype}}' target="_blank">{{=result?highlight(respondent, titleHighlights):clickUri}}</a><br />
                                <% } %>
                                {{ }) }}
                            </div>
                        </div>
                    </div>
                    <div class="coveo-result-cell">
                        {{if (raw.z95xpdoproceedingdate != null && raw.z95xpdoproceedingdate != -17955907200000) { }}
                        <span class="metadata-label">Proceeding Date: </span>
