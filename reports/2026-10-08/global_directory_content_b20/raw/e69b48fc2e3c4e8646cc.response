                                {{ } else if (raw.z95xinformationtype == "Notices, Decisions & Orders") { }}
                                <div class="coveo-result-row">
                                    <div class="coveo-result-cell">
                                        Category: <span>{{=raw.z95xdecisionsorderscategory}}</span>
                                    </div>
                                </div>
                                {{ } else if (raw.z95xinformationtype == "Exemption Orders") { }}
                                <div class="coveo-result-row">
                                    <div class="coveo-result-cell">
                                        Classification: <span>{{=raw.z95xez120xemptionorderclass}}</span>
                                    </div>
                                    <div class="coveo-result-cell">
                                        Type: <span>{{=raw.z95xez120xemptionorderstype}}</span>
                                    </div>
                                    <div class="coveo-result-cell">
                                        Exemption #: <span>{{=raw.z95xefez120xemption}}</span>
                                    </div>
                                </div>
                                {{ } else if (raw.z95xcontenttype == "Miscellaneous Notices") { }}
                                <div class="coveo-result-row">
                                    <div class="coveo-result-cell">
                                        Date Type: <span>{{=raw.z95xdatetype}}</span>
                                    </div>
                                </div>
                                {{ } }}
                            </div>
                        </div>
                        {{if (raw.z95xinformationtype == "Notices, Decisions & Orders") { }}
                        <div class="coveo-result-row">
                            <div class="coveo-result-cell">
                                Parties Involved: <span>{{=raw.z95xpartiesinvolved}}</span>
                            </div>
                        </div>
                        {{ } }}
                    </div>
                </div>
            </div>

            {{ } }}
            <!-- #endregion -->
        </div>
    </div>
</div>        </script>
    </div>

        </div>
</div>
<div class="CoveoPager"
             data-number-of-pages='10'
>

    
    
</div>



                                        </div>
                                    </div>



                                    


                                    


                                    


                                    

                                </div>

                            </div>
                        </div>
                    </div>
                </div>
                <!-- End Custom Content -->

