      <div class="section-hero uk-position-relative uk-light">
  <div class="uk-background-norepeat uk-background-cover uk-background-center-center uk-section uk-flex uk-flex-middle uk-height-large" style="background-image: url('https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/1600_0_auto/img_14da47cd10d2396d1466771bc0efda7b.jpg');" uk-img uk-height-viewport="offset-bottom: 40">
    <div class="uk-position-cover overlay-primary lighter"></div>
    <div class="uk-width-1-1">
      <div class="uk-container uk-position-relative">
        <div uk-grid>
          <div class="uk-width-1-4">
            <ul class="uk-list ">
              <li>
                <a href="https://www.world-exchanges.org/news" class="uk-flex">
                  <span class="uk-margin-small-right" uk-icon="chevron-left"></span>
                  <span class="uk-flex-middle">News</span>
                </a>
              </li>
            </ul>
          </div>
        </div>
        <div class="uk-grid-medium uk-margin-top" uk-grid>
          <div class="uk-width-2-3@m uk-width-1-1">
            <div class="hero-text">
              <h1 class="h2">The WFE Publishes Position Paper on Mythos AI Cybersecurity Model</h1>
              
              <div uk-grid class="uk-grid-small">
                <div class="uk-width-auto">
