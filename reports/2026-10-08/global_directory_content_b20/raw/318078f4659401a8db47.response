<article about="/company/about" class="node node--type-promotional-page node--view-mode-full">

  
    

  
  <div class="node__content">
                    
  <div class="paragraph paragraph--type--hero-secondary paragraph--view-mode--default">
                  

<section class="hero-secondary black " style="background-image: url(data:image/svg+xml;base64,)">
  <div class="container">
          

<nav aria-label="breadcrumb" class="container breadcrumb__container">
  <h2 id="system-breadcrumb" class="visually-hidden">Breadcrumb</h2>
  <ol class="breadcrumb">
          <li class="breadcrumb-item ">
                  <a href="/" >Home</a>
