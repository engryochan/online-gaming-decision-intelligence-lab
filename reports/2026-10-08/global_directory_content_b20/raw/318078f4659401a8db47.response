<section class="two-column-benefits  default ">
  <div class="two-column-benefits-container">
  <div class="benefit">
    <div class="content content-one">
      

<div class="card default ">
    <div class="card-body tcb-header">
                  <h3 class="card-title">The MIAX advantage </h3>
                                  <p class="card-text">  <img loading="lazy" src="/sites/default/files/2023-01/about-benefits-back-FNL-2.jpg" width="900" height="1140" alt="miax-miami-building" typeof="foaf:Image" class="img-fluid" />

  <img loading="lazy" src="/sites/default/files/2023-01/about-benefits-front-FNL-2.jpg" width="900" height="1140" alt="Emerald-launch" typeof="foaf:Image" class="img-fluid" />

</p>
                  </div>
      </div>
    </div>
    <div class="content content-two">
              

<div class="list-item ">
  <div class="card-body">
          <span class="card-index">01</span>
    
          <h5 class="card-title">Proprietary Technology</h5>
    
          <ul><li class="ck-list-marker-font-size" style="--ck-content-list-marker-font-size:18px;" data-list-item-id="eb18bc9c08fea8a75a60e30eee50300d6"><span style="font-size:18px;"><span style="font-family:FoundersGrotesk-Web-Light;">Electronic trading platforms across multiple asset segments&nbsp;&nbsp;</span></span></li><li class="ck-list-marker-font-size" style="--ck-content-list-marker-font-size:18px;" data-list-item-id="e3388a23e96af92ce1f8be7d2cdf1728f"><span style="font-size:18px;"><span style="font-family:FoundersGrotesk-Web-Light;">Consistent low latency experience</span></span></li><li class="ck-list-marker-font-size" style="--ck-content-list-marker-font-size:18px;" data-list-item-id="ebbb301eee34daa607eaaf9d2e6c80dec"><span style="font-size:18px;"><span style="font-family:FoundersGrotesk-Web-Light;">Customizable risk protections</span></span></li></ul>
      </div>
</div>
              

<div class="list-item ">
  <div class="card-body">
