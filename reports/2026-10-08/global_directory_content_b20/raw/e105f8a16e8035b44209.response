      background: #999999;
    }

    /* simple animation for text */
    .animate-left {
      position: relative;
      animation: animate1 0.5s;
    }
    .animate-right {
      position: relative;
      animation: animate2 0.3s;
    }

    @keyframes animate1 {
      from {
        left: 5px;
      }
      to {
        left: 0;
      }
    }

    @keyframes animate2 {
      from {
        right: 5px;
      }
      to {
        right: 0;
      }
    }

