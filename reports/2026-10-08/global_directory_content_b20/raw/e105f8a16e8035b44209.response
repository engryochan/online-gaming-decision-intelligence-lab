    <div>
      <div
        id="main-chat"
        class="fixed bottom-[108px] 2xl:bottom-[115px] right-[130px] 2xl:right-[140px] h-[450px] w-80 bg-white border border-gray-100 rounded-3xl rounded-br-none shadow-xl hidden"
      >
        <div class="h-full flex flex-col rounded-3xl overflow-hidden">
          <div class="flex-1 overflow-hidden h-full">
            <!-- Initial Display -->
            <div
              class="gap-8 flex flex-col justify-center items-center h-full font-medium text-lg"
              id="initial-greeting"
            >
              <div>Hello i’m SEBON Chatbot</div>

              <img src="https://www.sebon.gov.np/chatbot/icons/chat-head-1.svg" alt="" class="w-24" />

              <div>How can i help you?</div>
            </div>

            <!-- After some text messages has been sent -->
            <div class="flex flex-col h-full">
              <div
                class="h-20 flex-shrink-0 bg-primary flex items-center px-8 gap-4"
              >
                <div
                  class="bg-white w-12 h-12 2xl:w-14 2xl:h-14 rounded-full grid place-items-center"
                >
                  <img
                    src="https://www.sebon.gov.np/chatbot/icons/logo.svg"
                    alt=""
                    class="w-[30px] h-8"
                  />
                </div>
                <p class="font-semibold text-lg text-white">SEBON Chat(Beta Version)</p>
              </div>

              <div class="relative flex-1 h-full overflow-hidden">
                <div
                  class="px-4 pt-6 flex flex-col h-full overflow-auto scroll-smooth text-sm"
                  id="message-container"
                >
                  <div id="messages" class="gap-3 flex flex-col"></div>
                  <div id="last-message"></div>
                </div>

                <div
                  class="absolute -z-10 opacity-[0.04] w-[80%] h-[80%] left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
                >
                  <img src="https://www.sebon.gov.np/chatbot/icons/chat-bg.svg" />
                </div>
              </div>
            </div>
          </div>

          <form
            id="message-form"
            class="flex items-center gap-3 py-4 px-5 h-20 flex-shrink-0"
          >
            <div class="flex-1">
              <input
                type="text"
                class="w-full py-2 px-4 bg-light-gray rounded-xl focus:outline-none"
                placeholder="Write a message"
                id="message-input"
              />
            </div>

            <button type="submit">
              <img
                src="https://www.sebon.gov.np/chatbot/icons/send.svg"
                alt=""
                class="w-6 cursor-pointer"
              />
            </button>
          </form>
        </div>

        <div
          class="w-8 h-8 rounded-full bg-primary absolute -top-12 right-0 grid place-items-center cursor-pointer"
          onclick="toggleChat()"
        >
          <img src="https://www.sebon.gov.np/chatbot/icons/down-arrow.svg" alt="" class="w-4" />
        </div>

        <svg
          height="25"
          width="60"
          class="absolute -bottom-3 -right-9 drop-shadow-xl -z-10"
        >
          <polygon points="24,0 0,13 61,25" fill="#ffffff" strokeWidth="1" />
        </svg>
      </div>

      <div
        class="fixed bottom-8 right-8 cursor-pointer bg-red-200 rounded-full"
        onclick="toggleChat()"
      >
        <img src="https://www.sebon.gov.np/chatbot/icons/chat-head.svg" alt="" class="w-16 2xl:w-20" />
      </div>
    </div>
