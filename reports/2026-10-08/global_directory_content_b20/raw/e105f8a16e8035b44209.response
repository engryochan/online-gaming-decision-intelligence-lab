                autoplay: true,
                autoplaySpeed: 2000,
            });
            
        }
        if ($('.carousel-quote').length) {
            var slickQuote = $('.carousel-quote').slick({
                dots: false,
                arrows:false,
                infinite: true,
                speed: 300,
                //fade: true,
                slidesToShow: 1,
                adaptiveHeight: true,
                autoplay: true,
                autoplaySpeed: 2000,
            });
            $('#c-next').on('click',function(){slickQuote.slick('slickNext');});
            $('#c-prev').on('click',function(){slickQuote.slick('slickPrev');});
        }
        
        if ($('.carousel-pub').length) {
            $('.carousel-pub').slick({
                dots: false,
                arrows: true,
                infinite: true,
//             vertical:true,
                speed: 300,
                //fade: true,
                slidesToShow: 3,
                adaptiveHeight: true,
                autoplay: true,
                autoplaySpeed: 2000,
                responsive: [
                    {
                        breakpoint: 1024,
                        settings: {
                            slidesToShow: 2,
                            slidesToScroll: 1,
                            infinite: true,
                            dots: true
                        }
                    },
                    , {
                        breakpoint: 768,
                        settings: {
                            slidesToShow: 3,
                            slidesToScroll: 1
                        }},
                    {
                        breakpoint: 480,
                        settings: {
                            slidesToShow: 2,
                            slidesToScroll: 1
                        }}]
            });
        }

        if ($('ul#vert-menu').length) {
            $('ul#vert-menu').superfish({
                delay: 200
            });
        }
        
        $("input:checkbox").on('click', function() {
  // in the handler, 'this' refers to the box clicked on
  var $box = $(this);
  $('#event1,#event2').prop("checked", false);
  $box.prop("checked", true);
});


