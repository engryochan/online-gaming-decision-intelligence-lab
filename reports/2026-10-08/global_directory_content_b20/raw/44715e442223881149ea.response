	startLoading();
	document.getElementById("news-content").innerHTML = '<div style="Display:none">IN THE LINE OF FIRE</div>';
    AUI().use('aui-io-request', function(A){
    	
        A.io.request('https://www.qe.com.qa/companymoreinformationsearch?p_p_id=MoreInformationSearch_INSTANCE_fiaMOfJcVEMX&p_p_lifecycle=2&p_p_state=normal&p_p_mode=view&p_p_cacheability=cacheLevelPage&_MoreInformationSearch_INSTANCE_fiaMOfJcVEMX_param1=Value1', {
               method: 'post',
               
               data: {
            	   _MoreInformationSearch_INSTANCE_fiaMOfJcVEMX_infoCategory : infoCategory,
            	   _MoreInformationSearch_INSTANCE_fiaMOfJcVEMX_infoType : infoType,
            	   _MoreInformationSearch_INSTANCE_fiaMOfJcVEMX_fromLocalSite : fromLocalSite,
            	   _MoreInformationSearch_INSTANCE_fiaMOfJcVEMX_companyCode : companyCode,
            	   _MoreInformationSearch_INSTANCE_fiaMOfJcVEMX_BiggerCurrentPage: BiggerCurrentPage
               },
               on: {
            	   
                   	success: function(data) {
                   	
                   	var outputXML = this.get('responseData');
                   	//console.log("serve resource output " + this.get('responseData'));
                   	show_updateBiggerRecordSet(outputXML)
                  
                   }
              }
        });
 
    });
}
