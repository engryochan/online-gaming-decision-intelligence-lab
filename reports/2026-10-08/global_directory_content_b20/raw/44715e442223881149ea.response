function callServeResource(BiggerCurrentPage){
	var infoCategory=UrlParameters('InformationCategory');
	var infoType =  UrlParameters("InformationType");
	var fromLocalSite =  UrlParameters("FromLocalSite");
	var companyCode =  UrlParameters("CompanyCode");
