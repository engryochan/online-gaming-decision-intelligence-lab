<script>

// Load scripts sequentially so dependencies (like require.js) are available before dependent files run.
function loadScript(src, cb, errCb) {
  var script = document.createElement('script');
  script.src = src;
  script.async = false; // preserve execution order when appended sequentially
  script.onload = function () { if (typeof cb === 'function') cb(); };
  script.onerror = function (e) { if (typeof errCb === 'function') errCb(e); else console.error('Error loading script', src, e); };
  document.head.appendChild(script);
}

document.addEventListener('DOMContentLoaded', function () {
  // Add delay to ensure Liferay has fully initialized, especially for Safari
  setTimeout(function () {
    var currentURL = window.location.pathname;

    // Comprehensive home page URL patterns for Liferay 7.4 (English only)
    var homePagePatterns = [
      '/',
      '/home',
      '/web/guest/home',
      '/group/guest/home',
      '/en',
      '/en/',
      '/en/web/guest/home',
      '/en/group/guest/home'
    ];

    // Check if current URL matches any home page pattern
 var isHomePage = homePagePatterns.some(function (pattern) {
  return currentURL.endsWith(pattern);
});

    // Explicitly check for home page and return early
    if (isHomePage) {
      console.log('Home page detected - skipping ticker load. URL:', currentURL);
      return; // Exit early - do not load ticker on home page
    }

    function loadTicker() {
      var tickerJs = '/pps/qse_files/js/qe.ticker.js?v=' + new Date().getTime();

      // If require is present, load ticker normally. Otherwise load after require finishes.
      if (window.require) {
        loadScript(tickerJs, null, function(){ console.error('Failed to load qe.ticker.js'); });
        return;
      }

      loadScript('/pps/qse_files/js/require.js', function () {
        // ensure require is exposed before loading ticker
        if (window.require) {
          loadScript(tickerJs, null, function(){ console.error('Failed to load qe.ticker.js'); });
        } else {
          // Some AMD loaders may attach differently; small delay to ensure execution
          setTimeout(function () {
            if (window.require) {
              loadScript(tickerJs);
            } else {
              console.error('require did not become available after loading require.js');
            }
          }, 50);
        }
      }, function (e) { console.error('Failed to load require.js', e); });
    }

    if (currentURL.includes('/insider-trades')) {
      // Only load ticker.js on /insider-trades — require likely not needed there
      console.log('Insider trades page - loading ticker without require');
      var tickerJs = '/pps/qse_files/js/qe.ticker.js?v=' + new Date().getTime();
      loadScript(tickerJs, null, function(){ console.error('Failed to load qe.ticker.js'); });
    } else {
      // Load require and then ticker (sequential)
      console.log('Loading ticker with require for URL:', currentURL);
      loadTicker();
    }
  }, 100); // 100ms delay to ensure URL is stable in Safari
});
</script>
