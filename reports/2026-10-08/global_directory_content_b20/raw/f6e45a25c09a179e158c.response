  "name": "Why List with LTSE",
  "description": "List on the LTSE to find investors who support your long-term ambitions and join a community of like-minded leaders committed to creating lasting value.",
  "url": "/partner-with-ltse",
  "about": {
    "@type": "Organization",
    "name": "Long-Term Stock Exchange",
    "alternateName": "LTSE",
    "description": "An innovative exchange created to champion and reward purpose-driven companies. The Long-Term Stock Exchange is a disruptor focused on sustainable corporate governance, built to change capitalism on a broad scale.",
    "url": "/partner-with-ltse",
    "founder": [
      {
        "@type": "Organization",
        "name": "Obvious Ventures"
      },
