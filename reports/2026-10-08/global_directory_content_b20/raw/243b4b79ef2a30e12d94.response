33+00:00","changed":{"value":"2023-08-10T19:13:42+00:00","preserve":null},"breadcrumbs":[],"origname":"Group 1326.jpg","image_style_uri":{"lowres_placeholder":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/lowres_placeholder/public/2023-08/Group%201326.jpg?itok=81Ngxo6y","max_2600x2600":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/max_2600x2600/public/2023-08/Group%201326.jpg?itok=QO8ZAm2p","og_image_fb":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/2023-08/Group%201326.jpg?h=d7041edb\u0026itok=Nnoj4zlD","source_large_thumbnail_focal_point":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/source_large_thumbnail_focal_point/public/2023-08/Group%201326.jpg?h=d7041edb\u0026itok=qPGerEY3","source_thumbnail_focal_point":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/source_thumbnail_focal_point/public/2023-08/Group%201326.jpg?h=d7041edb\u0026itok=qMP2EhKj"},"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/file/file/ba518284-75a0-4cca-ad2b-064c52929ab6"}},"resourceIdObjMeta":{"alt":"devanture batiment","title":"","width":1281,"height":850,"drupal_internal__target_id":6276},"uid":{"type":"user--user","id":"f0c0db80-4309-49af-85b3-fe026b671110","resourceIdObjMeta":{"drupal_internal__target_id":8}},"relationshipNames":["uid"]},"field_categories":null,"field_country":[],"field_craft":[],"field_domain_access":[{"type":"domain--domain","id":"a608439f-976c-4aa2-90d9-9404c4ec16ad","resourceIdObjMeta":{"drupal_internal__target_id":"ca_cib_com"}}],"field_domain_source":{"type":"domain--domain","id":"a608439f-976c-4aa2-90d9-9404c4ec16ad","resourceIdObjMeta":{"drupal_internal__target_id":"ca_cib_com"}},"field_edit_permission":[],"field_free_tag":[],"field_news_main_conten":[{"type":"paragraph--title_block_v1","id":"066c1ad0-b508-4adf-8121-cfa5b2582b76","drupal_internal__id":9970,"drupal_internal__revision_id":108309,"langcode":"en","status":true,"created":"2023-08-10T18:45:10+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-13T05:56:49+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"Acting as a global banking partner thanks to a common approach within the Crédit Agricole Group","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/066c1ad0-b508-4adf-8121-cfa5b2582b76?resourceVersion=id%3A108309"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/066c1ad0-b508-4adf-8121-cfa5b2582b76?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108309,"drupal_internal__target_id":9970},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"8d28b429-4f7c-4f88-ab6c-8729c7c30b57","drupal_internal__id":9973,"drupal_internal__revision_id":108310,"langcode":"en","status":true,"created":"2023-08-10T18:51:11+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-13T16:08:43+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eCombining the global expertise of senior bankers and private bankers, Private Investment Banking uses the services platform of Crédit Agricole CIB and Indosuez Wealth Management and the Crédit Agricole Group’s ecosystem. The team operates globally with the support of the Group's international network, with a presence in more than 45 countries.\u003c/p\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eOur \u003cstrong\u003eWealth Management\u003c/strong\u003e division benefits from the major strengths of the Crédit Agricole Group:\u003c/p\u003e\u003cul\u003e\u003cli\u003eA long-term strategy with stable and solid governance\u003c/li\u003e\u003cli\u003eA strong and solid balance sheet\u003c/li\u003e\u003cli\u003eAn above-average rating\u003c/li\u003e\u003cli\u003eSignificant financing capacity\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003eWith a combined expertise, Crédit Agricole CIB and Indosuez Wealth Management have developed a comprehensive service through a dedicated team devoted to families in order to build long lasting partnerships and bring solutions that target their specific needs.\u003cbr\u003eOur strategy to be rolled-out on Family businesses \u0026amp; Individuals:\u003c/p\u003e\u003cul\u003e\u003cli\u003eIncrease knowledge of decision-makers and family members’ needs through a joint commercial approach Crédit Agricole CIB \u0026amp; Indosuez Wealth Management.\u003c/li\u003e\u003cli\u003eDeliver a comprehensive offer leveraging Crédit Agricole CIB, Indosuez Wealth Management and other Crédit Agricole Group entities.\u003cbr\u003e\u0026nbsp;\u003c/li\u003e\u003c/ul\u003e","format":"full_html","processed":"\u003cp\u003eCombining the global expertise of senior bankers and private bankers, Private Investment Banking uses the services platform of Crédit Agricole CIB and Indosuez Wealth Management and the Crédit Agricole Group’s ecosystem. The team operates globally with the support of the Group's international network, with a presence in more than 45 countries.\u003c/p\u003e\n\n\u003cp\u003eOur \u003cstrong\u003eWealth Management\u003c/strong\u003e division benefits from the major strengths of the Crédit Agricole Group:\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eA long-term strategy with stable and solid governance\u003c/li\u003e\n\u003cli\u003eA strong and solid balance sheet\u003c/li\u003e\n\u003cli\u003eAn above-average rating\u003c/li\u003e\n\u003cli\u003eSignificant financing capacity\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003eWith a combined expertise, Crédit Agricole CIB and Indosuez Wealth Management have developed a comprehensive service through a dedicated team devoted to families in order to build long lasting partnerships and bring solutions that target their specific needs.\u003cbr\u003eOur strategy to be rolled-out on Family businesses \u0026amp; Individuals:\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eIncrease knowledge of decision-makers and family members’ needs through a joint commercial approach Crédit Agricole CIB \u0026amp; Indosuez Wealth Management.\u003c/li\u003e\n\u003cli\u003eDeliver a comprehensive offer leveraging Crédit Agricole CIB, Indosuez Wealth Management and other Crédit Agricole Group entities.\u003cbr\u003e\u0026nbsp;\u003c/li\u003e\n\u003c/ul\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/8d28b429-4f7c-4f88-ab6c-8729c7c30b57?resourceVersion=id%3A108310"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/8d28b429-4f7c-4f88-ab6c-8729c7c30b57?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108310,"drupal_internal__target_id":9973},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"ee8c1395-da23-49fa-8165-a457534ca396","drupal_internal__id":13223,"drupal_internal__revision_id":108311,"langcode":"en","status":true,"created":"2023-09-13T05:52:45+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-13T05:52:45+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"A dedicated team of Private Investment Bankers","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/ee8c1395-da23-49fa-8165-a457534ca396?resourceVersion=id%3A108311"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/ee8c1395-da23-49fa-8165-a457534ca396?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108311,"drupal_internal__target_id":13223},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"f9649ff6-6f23-472b-8ff0-07cb70261db8","drupal_internal__id":9975,"drupal_internal__revision_id":108312,"langcode":"en","status":true,"created":"2023-08-10T18:53:21+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-10T19:13:42+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eA dedicated team of Private Investment Bankers covers all the needs of family holding companies.\u003c/p\u003e\u003cul\u003e\u003cli\u003eOur Private Investment Banking entity offers family businesses a single single entry-point through which they can access the group's various entities\u003c/li\u003e\u003cli\u003eOur team of specialists covers all the needs of family businesses, from individual shareholders to Family Holding Companies.\u003c/li\u003e\u003cli\u003eOur comprehensive approach relies on Crédit Agricole CIB's and Indosuez Wealth Management's local bankers with a dedicated point of contact around the world.\u003c/li\u003e\u003c/ul\u003e","format":"full_html","processed":"\u003cp\u003eA dedicated team of Private Investment Bankers covers all the needs of family holding companies.\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eOur Private Investment Banking entity offers family businesses a single single entry-point through which they can access the group's various entities\u003c/li\u003e\n\u003cli\u003eOur team of specialists covers all the needs of family businesses, from individual shareholders to Family Holding Companies.\u003c/li\u003e\n\u003cli\u003eOur comprehensive approach relies on Crédit Agricole CIB's and Indosuez Wealth Management's local bankers with a dedicated point of contact around the world.\u003c/li\u003e\n\u003c/ul\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/f9649ff6-6f23-472b-8ff0-07cb70261db8?resourceVersion=id%3A108312"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/f9649ff6-6f23-472b-8ff0-07cb70261db8?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108312,"drupal_internal__target_id":9975},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--image_block_v1","id":"4b415556-af7f-4fcd-8899-5575cf2b464d","drupal_internal__id":9976,"drupal_internal__revision_id":108313,"langcode":"en","status":true,"created":"2023-08-10T18:56:59+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-10-13T16:08:43+00:00","preserve":null},"cacib_field_country":null,"field_link":null,"field_load_from_reference_link":null,"field_text":null,"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/image_block_v1/4b415556-af7f-4fcd-8899-5575cf2b464d?resourceVersion=id%3A108313"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/image_block_v1/4b415556-af7f-4fcd-8899-5575cf2b464d?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108313,"drupal_internal__target_id":9976},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"847c2985-73f5-40c3-bcbc-bd4faba5d70e","resourceIdObjMeta":{"drupal_internal__target_id":"image_block_v1"}},"field_image":{"type":"file--file","id":"991c648c-d845-4589-93ab-0327dc36d716","drupal_internal__fid":10953,"langcode":"en","filename":"schema_0.png","uri":{"value":"public://2023-10/schema_0.png","url":"/sites/default/files/2023-10/schema_0.png"},"filemime":"image/png","filesize":135085,"status":true,"created":"2023-10-13T16:07:06+00:00","changed":{"value":"2023-10-13T16:08:43+00:00","preserve":null},"breadcrumbs":[],"origname":"schema_0.png","image_style_uri":{"lowres_placeholder":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/lowres_placeholder/public/2023-10/schema_0.png?itok=exvUxIGd","max_2600x2600":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/max_2600x2600/public/2023-10/schema_0.png?itok=8riiZqds","og_image_fb":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/og_image_fb/public/2023-10/schema_0.png?h=ea94a65e\u0026itok=Y096q-Sq","source_large_thumbnail_focal_point":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/source_large_thumbnail_focal_point/public/2023-10/schema_0.png?h=ea94a65e\u0026itok=864xVU2C","source_thumbnail_focal_point":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/sites/default/files/styles/source_thumbnail_focal_point/public/2023-10/schema_0.png?h=ea94a65e\u0026itok=agA5vJMn"},"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/file/file/991c648c-d845-4589-93ab-0327dc36d716"}},"resourceIdObjMeta":{"alt":"schéma Wealth Management","title":"","width":1621,"height":906,"drupal_internal__target_id":10953},"uid":{"type":"user--user","id":"6cb6debc-b814-4fa9-a101-02168c26d1e4","resourceIdObjMeta":{"drupal_internal__target_id":12}},"relationshipNames":["uid"]},"field_referenced_node":null,"relationshipNames":["paragraph_type","field_image","field_referenced_node"]},{"type":"paragraph--title_block_v1","id":"584cad2e-afa5-4251-8869-7bb43208ba6c","drupal_internal__id":13224,"drupal_internal__revision_id":108314,"langcode":"en","status":true,"created":"2023-09-13T05:53:38+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-13T05:53:38+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"Services for Family Holding Companies and Family Offices","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/584cad2e-afa5-4251-8869-7bb43208ba6c?resourceVersion=id%3A108314"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/584cad2e-afa5-4251-8869-7bb43208ba6c?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108314,"drupal_internal__target_id":13224},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"a5aa11af-8020-4dc9-b3f7-391b47b8a77a","drupal_internal__id":9978,"drupal_internal__revision_id":108315,"langcode":"en","status":true,"created":"2023-08-10T19:02:05+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-29T15:05:48+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003e\u003cstrong\u003eA Family Holding Company is a company :\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eOwned by a high net worth individual or family members\u003c/li\u003e\u003cli\u003eWith a historical principal company - which is often still fully or partially owned, or which was sold at some point in the past\u003c/li\u003e\u003cli\u003eWhich holds a diversified portfolio of investments\u003c/li\u003e\u003c/ul\u003e\u003cp\u003e\u0026nbsp;\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eA Family Office :\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003eIs an organisation that manages the financial and personal interests of a wealthy family\u003c/li\u003e\u003cli\u003eIt provides advice to family members on investment, budgets, insurance, taxation, real estate, trusts, accounting, legal affairs, risk management, etc.\u003c/li\u003e\u003cli\u003eIs generally fully owned and controlled by the family members in question Family Offices manage individual issues and are therefore mainly backed up by private bankers.\u003cbr\u003eA Single Family Office (SFO) serves a single family while a Multi-Family Office (MFO) serves multiple families.\u003c/li\u003e\u003c/ul\u003e","format":"full_html","processed":"\u003cp\u003e\u003cstrong\u003eA Family Holding Company is a company :\u003c/strong\u003e\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eOwned by a high net worth individual or family members\u003c/li\u003e\n\u003cli\u003eWith a historical principal company - which is often still fully or partially owned, or which was sold at some point in the past\u003c/li\u003e\n\u003cli\u003eWhich holds a diversified portfolio of investments\u003c/li\u003e\n\u003c/ul\u003e\n\n\u003cp\u003e\u003cstrong\u003eA Family Office :\u0026nbsp;\u003c/strong\u003e\u003c/p\u003e\n\u003cul class=\"list-disc pl-5\"\u003e\n\u003cli\u003eIs an organisation that manages the financial and personal interests of a wealthy family\u003c/li\u003e\n\u003cli\u003eIt provides advice to family members on investment, budgets, insurance, taxation, real estate, trusts, accounting, legal affairs, risk management, etc.\u003c/li\u003e\n\u003cli\u003eIs generally fully owned and controlled by the family members in question Family Offices manage individual issues and are therefore mainly backed up by private bankers.\u003cbr\u003eA Single Family Office (SFO) serves a single family while a Multi-Family Office (MFO) serves multiple families.\u003c/li\u003e\n\u003c/ul\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/a5aa11af-8020-4dc9-b3f7-391b47b8a77a?resourceVersion=id%3A108315"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/a5aa11af-8020-4dc9-b3f7-391b47b8a77a?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108315,"drupal_internal__target_id":9978},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{"drupal_internal__target_id":"text_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--title_block_v1","id":"1448caa8-4cda-4d2c-8c5f-b5e23711e501","drupal_internal__id":13225,"drupal_internal__revision_id":108316,"langcode":"en","status":true,"created":"2023-09-13T05:53:57+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-09-13T05:53:57+00:00","preserve":null},"cacib_field_country":null,"field_block_alignment":null,"field_subtitle":null,"field_title":"A global and historical presence","field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/1448caa8-4cda-4d2c-8c5f-b5e23711e501?resourceVersion=id%3A108316"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/title_block_v1/1448caa8-4cda-4d2c-8c5f-b5e23711e501?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108316,"drupal_internal__target_id":13225},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"9742858b-ee80-49e2-9392-ce523706bc50","resourceIdObjMeta":{"drupal_internal__target_id":"title_block_v1"}},"relationshipNames":["paragraph_type"]},{"type":"paragraph--text_block_v1","id":"4e35650e-4fb6-4b2a-8f5d-3e3bc128b903","drupal_internal__id":9980,"drupal_internal__revision_id":108317,"langcode":"en","status":true,"created":"2023-08-10T19:05:28+00:00","parent_id":"1168","parent_type":"node","parent_field_name":"field_news_main_conten","behavior_settings":[],"default_langcode":true,"revision_translation_affected":null,"breadcrumbs":[],"content_translation_source":"und","content_translation_outdated":false,"content_translation_changed":{"value":"2023-08-17T09:29:50+00:00","preserve":null},"cacib_field_country":null,"field_text":{"value":"\u003cp\u003eWe offer a comprehensive approach to \u003cstrong\u003ewealth and asset management,\u003c/strong\u003e supported by Crédit Agricole CIB's and \u003ca href=\"https://ca-indosuez.com/\"\u003eIndosuez Wealth Management\u003c/a\u003e's local bankers with a dedicated point of contact around the world. Our global and long-standing presence allows us to support our clients and the Group with their cross-border needs.\u003c/p\u003e","format":"full_html","processed":"\u003cp\u003eWe offer a comprehensive approach to \u003cstrong\u003ewealth and asset management,\u003c/strong\u003e supported by Crédit Agricole CIB's and \u003ca href=\"https://ca-indosuez.com/\" target=\"_blank\"\u003eIndosuez Wealth Management\u003cspan class=\"sr-only\"\u003e Will open in a new tab \u003c/span\u003e\u003c/a\u003e's local bankers with a dedicated point of contact around the world. Our global and long-standing presence allows us to support our clients and the Group with their cross-border needs.\u003c/p\u003e\n"},"field_visible":true,"links":{"self":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/4e35650e-4fb6-4b2a-8f5d-3e3bc128b903?resourceVersion=id%3A108317"},"working-copy":{"href":"http://bo-en-instit-cacib.adsi.credit-agricole.fr/en/jsonapi/paragraph/text_block_v1/4e35650e-4fb6-4b2a-8f5d-3e3bc128b903?resourceVersion=rel%3Aworking-copy"}},"resourceIdObjMeta":{"target_revision_id":108317,"drupal_internal__target_id":9980},"paragraph_type":{"type":"paragraphs_type--paragraphs_type","id":"30a2c032-3c6d-4dfa-8428-f8f6d2205fe6","resourceIdObjMeta":{