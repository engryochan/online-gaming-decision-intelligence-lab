            <img src="https://informinvestor.cmda.gov.mv/storage/uploads/NQoQBzwv/c/u51zv7tk-profile-preview.jpg" alt="" class="mb-4">
            
            <h4 class="text-primary mb-2">Ali Wasif</h4>
            
            <h6 class="text-secondary fw-normal">Executive Director / Chief Financial Officer</h6>
        </div>
    </div>
