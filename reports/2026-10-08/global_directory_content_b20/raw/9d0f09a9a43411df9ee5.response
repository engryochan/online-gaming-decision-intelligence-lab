            <td class="verd_black12" style="text-align: left;">
            <div>
            <div>Trading Hours</div>
            <span style="font-size: 0.75rem; vertical-align: super;"></span></div>
            </td>
            <td class="verd_black12" style="text-align: left;">
            <div>
