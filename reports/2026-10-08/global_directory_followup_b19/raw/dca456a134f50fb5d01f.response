                <div class="uk-margin-top">
                  <h3>
                                        The WFE SME Conference
                                      </h3>
                                                            <div class="text-date-location"><strong>Date:</strong> 26 February 2018</div>
                                                                                            <div class="text-date-location"><strong>Location:</strong> Malta</div>
                                                        <div class="text-date-location"><strong>Hosted by:</strong> Malta Stock Exchange</div>
                                                                                                <div class="text-date-location">
                      <strong>Download:</strong>
                                                                                                                                                                                <a class="js-download-track" target="_blank" href="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/uploads/public/5c0/e97/314/5c0e97314bd1e299357650.pdf" data-event-category="Conference Program" data-event-label="The WFE SME Conference - Malta - 20180416-SME-Conference-Program-FINAL.PDF">20180416-SME-Conference-Program-FINAL.PDF</a>                                                                  </div>
                                                                      </div>
              </div>
                                        <div>
