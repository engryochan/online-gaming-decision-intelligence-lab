      <section class="uk-section uk-section-default" uk-height-viewport="expand: true">
        <div class="uk-container uk-container-large">
          <div uk-grid class="uk-child-width-1-3">
                                        <div>
                <div class="uk-inline">
                                                        <img class="uk-responsive-width" data-src="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/968_460_crop/img_d5c500573bed6855c5355316e849bba7.jpg" uk-img>
                                                    </div>
                <div class="uk-margin-top">
                  <h3>
                                        WFEClear, The WFE’s Clearing and Derivatives Conference 2025
                                      </h3>
                                                            <div class="text-date-location">
                        <strong>Date:</strong>
                                                1
                        - 3 April 2025
                                              </div>
                                                                                                                                          <div class="text-date-location">
                      <strong>Time:</strong> 00:00 - 00:00 UTC
                    </div>
                                                      <div class="text-date-location"><strong>Location:</strong> Seoul</div>
                                                        <div class="text-date-location"><strong>Hosted by:</strong> Korea Exchange</div>
                                                                                        </div>
              </div>
                                        <div>
                <div class="uk-inline">
                                                        <img class="uk-responsive-width" data-src="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/968_460_crop/img_12a64fb3b84b094df18d9275b2ff9207.jpg" uk-img>
                                                    </div>
                <div class="uk-margin-top">
                  <h3>
                                        WFE Webinar: Is 24/7 Trading Better?
                                      </h3>
                                                            <div class="text-date-location">
                        <strong>Date:</strong>
