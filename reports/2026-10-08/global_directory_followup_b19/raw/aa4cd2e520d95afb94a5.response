      </div>

      <section class="uk-section uk-section-default" uk-height-viewport="expand: true">
        <div class="uk-container uk-container-large">
          <div uk-grid class="uk-child-width-1-3">
                                        <div>
                <div class="uk-inline">
                                                        <img class="uk-responsive-width" data-src="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/968_460_crop/img_211feac7e55e6ad734f7c903d6944caa.jpg" uk-img>
                                                    </div>
                <div class="uk-margin-top">
                  <h3>
                                        The World Federation of Exchanges&#039; Global Meeting on Sustainability Chaired by TMX Group
                                      </h3>
                                                            <div class="text-date-location">
                        <strong>Date:</strong>
                                                5 June 2024
                                              </div>
                                                                                                                                          <div class="text-date-location">
                      <strong>Time:</strong> 00:00 - 00:00 UTC
                    </div>
                                                      <div class="text-date-location"><strong>Location:</strong> Toronto</div>
                                                        <div class="text-date-location"><strong>Hosted by:</strong> TMX Group</div>
                                                                                        </div>
              </div>
                                        <div>
                <div class="uk-inline">
                                                        <img class="uk-responsive-width" data-src="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/968_460_crop/img_69d2555daa14fdaf50502d2f3e514a4a.jpg" uk-img>
                                                    </div>
                <div class="uk-margin-top">
                  <h3>
                                        WFE Research Webinar: “ The Effect of DLT Settlement Latency on Market Liquidity&quot;
                                      </h3>
                                                            <div class="text-date-location">
                        <strong>Date:</strong>
