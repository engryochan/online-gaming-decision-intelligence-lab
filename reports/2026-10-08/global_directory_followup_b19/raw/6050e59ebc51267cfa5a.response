      <div class="section-hero uk-position-relative uk-light">
        <div class="uk-background-norepeat uk-background-cover uk-background-center-center background-hero uk-flex uk-flex-middle" style="background-image: url('https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/1600_0_crop/img_0c76778bf3ea32b9cfe2121368c9c8aa.jpg');" uk-img uk-height-viewport="offset-bottom: 60">
          <div class="uk-position-cover overlay-primary lighter"></div>
          <div class="uk-width-1-1">
            <div class="uk-position-cover uk-flex uk-flex-left uk-flex-middle uk-container uk-container-large container-hero">

              <div class="uk-grid-medium " uk-grid>
                <div class="uk-width-large">
                  <div class="hero-text">
                    <h1 class="h2">Past Events</h1>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

      <section class="uk-section uk-section-default" uk-height-viewport="expand: true">
        <div class="uk-container uk-container-large">
          <div uk-grid class="uk-child-width-1-3">
                                        <div>
                <div class="uk-inline">
                                                        <img class="uk-responsive-width" data-src="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/968_460_crop/img_85882956946a2332fa1f7a115ec609cf.jpg" uk-img>
                                                    </div>
                <div class="uk-margin-top">
                  <h3>
                                        WFE Webinar - Always On: Building Infrastructure for 24x7 Exchange Operations (Option 2)
                                      </h3>
                                                            <div class="text-date-location">
                        <strong>Date:</strong>
                                                5 November 2025
                                              </div>
                                                                                                                                          <div class="text-date-location">
                      <strong>Time:</strong> 16:40 - 16:40 UTC
                    </div>
                                                                                                              <div class="text-date-location">
                      <div uk-lightbox>
                      <strong>Video:</strong>  <a href="https://vimeo.com/1134254063" data-caption="WFE Webinar - Always On: Building Infrastructure for 24x7 Exchange Operations (Option 2)">Watch Webinar</a>
                      </div>
                    </div>
                                                    </div>
              </div>
                                        <div>
                <div class="uk-inline">
                                                        <img class="uk-responsive-width" data-src="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/968_460_crop/img_7396677f7a63cf623cbb78304e4f63b0.jpg" uk-img>
                                                    </div>
                <div class="uk-margin-top">
                  <h3>
