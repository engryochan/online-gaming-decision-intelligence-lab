      <section class="uk-section uk-section-default" uk-height-viewport="expand: true">
        <div class="uk-container uk-container-large">
          <div uk-grid class="uk-child-width-1-3">
                                        <div>
                <div class="uk-inline">
                                                        <img class="uk-responsive-width" data-src="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/968_460_crop/img_8769560d5f7284c6ebba316bad3dbae4.jpg" uk-img>
                                                    </div>
                <div class="uk-margin-top">
                  <h3>
                                        The WFE Working Committee Meeting  -  Cancelled
                                      </h3>
                                                            <div class="text-date-location"><strong>Date:</strong> 24 June 2020</div>
                                                                                            <div class="text-date-location"><strong>Location:</strong> London, UK</div>
                                                                                                          </div>
              </div>
                                        <div>
                <div class="uk-inline">
                                                        <img class="uk-responsive-width" data-src="https://wfe-live.lon1.cdn.digitaloceanspaces.com/org_focus/storage/resources/resize/968_460_crop/img_6a0975da431ffab62a57d13a71475960.jpg" uk-img>
                                                    </div>
                <div class="uk-margin-top">
                  <h3>
                                        The WFE Working Committee Meeting
                                      </h3>
                                                            <div class="text-date-location"><strong>Date:</strong> 16 January 2020</div>
                                                                                            <div class="text-date-location"><strong>Location:</strong> London, UK</div>
                                                                                                          </div>
              </div>
