<script type="c72382553a4dedc7a24fbbb7-text/javascript">

    function showSimpleTab(tabID) {
        $(".infoPartOne .simpleTabsContent").hide();
        $('.each_journey .animation-hidden').removeClass('appearance');
        $('.infoPartOne .simpleTabsContent[data-tab-id="' + tabID + '"]').show();
        setTimeout(function () {
            $('.infoPartOne .simpleTabsContent[data-tab-id="' + tabID + '"]').find('.each_journey .animation-hidden').addClass('appearance');
        }, 300);

        $('.infoPartOne .simpleTabs li').removeClass('active');
        $('.infoPartOne .simpleTabs li[data-tab-id="' + tabID + '"]').addClass('active');
    }
</script>


