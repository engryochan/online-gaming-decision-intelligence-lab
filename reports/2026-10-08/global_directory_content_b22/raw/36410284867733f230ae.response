<script>
document.addEventListener("DOMContentLoaded", function() {
  if (window.location.hash) {
    var targetId = window.location.hash;
    var targetElement = document.querySelector(targetId);

    if (targetElement) {
      // Check if it's inside a <details>
      var detailsElement = targetElement.closest("details");
      if (detailsElement && !detailsElement.open) {
        detailsElement.open = true;
      }

      // Delay to ensure the opening animation completes (if any)
      setTimeout(function() {
        var headerOffset = 100; // adjust as needed
        var elementPosition = targetElement.getBoundingClientRect().top + window.pageYOffset;
        var offsetPosition = elementPosition - headerOffset;
        window.scrollTo({
          top: offsetPosition,
          behavior: "smooth"
        });
      }, 100); // small delay is usually enough
    }
  }
});
</script>

<style>.yydev-back-to-top {background:#fe5f00 url(https://www.vfsc.vu/wp-content/plugins/back-to-the-top-button/images/back-to-top.png) no-repeat;background-position: 50% 43%;text-indent:-9999px;width:45px;height:45px;border-radius:50%;right:30px;bottom:30px;border:2px solid #fff;position: fixed;display:none;z-index:9999;visibility: visible !important}@media only screen and (max-width: 960px) {.yydev-back-to-top {visibility: visible !important}}</style>
</body>
</html>
