            <img src="https://informinvestor.cmda.gov.mv/storage/uploads/bVw9JzYv/c/5wux1c9s-profile-preview.png" alt="" class="mb-4">
            
            <h4 class="text-primary mb-2">Shimad Ibrahim</h4>
            
            <h6 class="text-secondary fw-normal">Executive Director</h6>
