						font-weight: bold;
						color: #d9312b;
						background-color: #eee;
					}
					div[id*='ajaxsearchliteres'].wpdreams_asl_results .results img.asl_image {
						width: 70px;
						height: 70px;
						object-fit: cover;
					}
					div[id*='ajaxsearchlite'].asl_r .results {
						max-height: none;
					}
					div[id*='ajaxsearchlite'].asl_r {
						position: absolute;
					}
				
						div.asl_r.asl_w.vertical .results .item::after {
