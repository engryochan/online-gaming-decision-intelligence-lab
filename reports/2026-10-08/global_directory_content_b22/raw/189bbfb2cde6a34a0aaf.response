                <li x-show="typesActive.includes('legal_basis')" class="flex flex-col">
    <span x-cloak
          x-show="!isInit"
          class="z-10 mb-8 flex h-8 items-center bg-white text-lg font-bold x-sticky-header"
          :class="isStickyHeaderEls && 'sticky'">
        Rechtsgrundlagen
    </span>

    <template x-if="'legal_basis' in data">
        <div class="contents">

            <template x-if="data['legal_basis'].result?.length">
                <div class="contents">
                    <ul class="">
                        <template x-for="item in getVisibleItems('legal_basis')">
                                                            <li class="transition-opacity delay-300 ease-in bg-bison-300 mb-4 group rounded"
    :class="isLoading ? 'opacity-0' : 'opacity-100'">
    <div class="grid grid-cols-8 sm:grid-cols-12 pt-5 px-2 sm:px-4 gap-x-3 sm:gap-x-0">
        <div class="col-span-1">
            <template x-for="icon in $store.system.getIconClasses(item.link.mime_type, item.link.type)">
                <span :class="icon" class="text-[2rem] w-8 h-8 text-shark-200"></span>
            </template>
        </div>
        <div class="col-span-6 sm:col-span-10 pb-5">
            <div class="flex-row flex text-shark-200 text-sm flex-wrap leading-4" x-show="item.categories_labels.length > 0 || item.addresses_labels.length > 0 || item.field_laws_labels.length > 0">
                <div class="w-fit mb-2">
                    <template x-for="(category, index) in item.categories_labels" :key="'category-' + index">
                        <span>
                            <span x-text="category"></span>
                            <span x-show="!(index === item.categories_labels.length - 1 && item.addresses_labels.length === 0 && item.field_laws_labels.length === 0)" class="mx-1">&bull;</span>
                        </span>
                    </template>
                    <template x-for="(address, index) in item.addresses_labels" :key="'address-' + index">
                        <span>
                            <span x-text="address"></span>
                            <span x-show="!(index === item.addresses_labels.length - 1 && item.field_laws_labels.length === 0)" class="mx-1">&bull;</span>
                        </span>
                    </template>
                    <template x-for="(fieldLaw, index) in item.field_laws_labels" :key="'fieldLaw-' + index">
                        <span>
                            <span x-text="fieldLaw"></span>
                            <span x-show="index !== item.field_laws_labels.length - 1" class="mx-1">&bull;</span>
                        </span>
                    </template>
                </div>
            </div>

            <a class="hover:underline-offset-4 hover:underline"
               x-show="item.link.href !== null && item.link.href !== ''" :href="item.link.href" :title="item.title"
               :target="item.link.type === 'internal' ? '_self' :'_blank'">
                <h4 class="text-primary mt-0 mb-2.5 text-base leading-[1.125] sm:leading-tight sm:text-lg"
                    x-text="item.title"></h4>
            </a>
            <h4 x-show="item.link.href === null || item.link.href === ''"
                class="text-primary mt-0 mb-2.5 text-base leading-[1.125] sm:leading-tight sm:text-lg"
                x-text="item.title"></h4>
            <p class="small">
                <span x-text="item.description"></span>
                <span x-text="`(${item.link.size})`" x-show="item.link.type === 'asset'"></span>
            </p>
        </div>

        <div class="col-span-1 justify-end flex" x-show="item.link.type === 'asset'">
            <button class="download-file flex justify-center text-2xl w-6 h-6 icon-bookmark"
                    :data-downloadId="item.link.id" @click.prevent="toggleBookmarkItem(item.link.id, $el)"></button>
        </div>
    </div>

    <div x-data="{ showVariants: false, showAttachment: false }">
        <div x-show="item.variants.length" class="ml-[14%] sm:ml-[10%] md:ml-[9.5%] pb-4">
            <button class="text-primary text-sm" x-on:click="showVariants = !showVariants">
                Archiv <span :class="showVariants ? 'icon-chevron-up' : 'icon-chevron-down'"></span>
            </button>
        </div>

        <div x-show="item.variants.length && showVariants"
             x-transition
             class="grid grid-cols-8 sm:grid-cols-12 pt-5 px-2 sm:px-4 gap-x-3 sm:gap-x-0 bg-bison-400"
             :class="item.children.length && showVariants ? 'mb-4' : ''">

            <div class="col-span-1"></div>
            <div class="col-span-7 sm:col-span-11 pb-5">
                <template x-for="(child, index) in item.variants" :key="child.id">
                    <div class="grid grid-cols-12 pt-5 gap-x-3 sm:gap-x-0">

                        <div class="col-span-11 pb-5">
                            <div>
                                <a x-show="child.link.href !== null && child.link.href !== ''"
                                   class="hover:underline-offset-4 hover:underline"
                                   :href="child.link.href" :title="child.title"
                                   :target="child.link.type === 'internal' ? '_self' :'_blank'">
                                    <h4 x-text="child.title"
                                        class="text-primary mt-0 mb-2.5 text-base leading-[1.125] sm:leading-tight sm:text-lg"></h4>
                                </a>
                                <h4 x-show="child.link.href === null || child.link.href === ''"
                                    class="text-primary mt-0 mb-2.5 text-base leading-[1.125] sm:leading-tight sm:text-lg"
                                    x-text="child.title"></h4>
                                <p class="small">
                                    <span x-text="child.description"></span>
                                    <span x-text="`(${child.link.size})`" x-show="child.link.type === 'asset'"></span>
                                </p>
                            </div>
                        </div>

                        <div class="col-span-1 justify-end hidden sm:flex" x-show="child.link.type === 'asset'">
                            <button class="download-file flex justify-center text-2xl w-6 h-6 icon-bookmark"
                                    :data-downloadId="child.link.id"
                                    @click.prevent="toggleBookmarkItem(child.link.id, $el)">
                            </button>
                        </div>
                    </div>
                </template>
            </div>
        </div>

        <div x-show="item.children.length"
             class="ml-[14%] sm:ml-[10%] md:ml-[9.5%] pb-4">
            <button class="text-primary text-sm"
                    x-on:click="showAttachment = !showAttachment">
                Anhänge
                <span :class="showAttachment ? 'icon-chevron-up' : 'icon-chevron-down'"></span>
            </button>
        </div>

        <ul x-show="item.children.length && showAttachment" x-transition>
            <template x-for="(child, index) in item.children" :key="child.id">
                <li class="grid grid-cols-8 sm:grid-cols-12 pt-5 px-2 sm:px-4 gap-x-3 sm:gap-x-0"
                     :class="item.children.length > 0 ? 'border-t border-bison-200': ''">

                    <div class="col-span-1">
                        <span x-text="child.type"></span>
                        <template x-for="icon in $store.system.getIconClasses(child.link.mime_type, child.link.type)">
                            <span :class="icon" class="text-[2rem] w-8 h-8 text-shark-200"></span>
                        </template>
                    </div>

                    <div class="col-span-6 sm:col-span-10 pb-5">
                        <div>
                            <a class="hover:underline-offset-4 hover:underline"
                               x-show="child.link.href !== null && child.link.href !== ''"
                               :href="child.link.href"
                               :title="child.title"
                               :target="child.link.type === 'internal' ? '_self' :'_blank'">
                                <h4 class="text-primary mt-0 mb-2.5 text-base leading-[1.125] sm:leading-tight sm:text-lg"
                                    x-text="child.title"></h4>
                            </a>
                            <h4 x-show="child.link.href === null || child.link.href === ''"
                                class="text-primary mt-0 mb-2.5 text-base leading-[1.125] sm:leading-tight sm:text-lg"
                                x-text="child.title"></h4>
                            <p class="small">
                                <span x-text="child.description"></span>
                                <span x-show="child.link.type === 'asset'">
                            (<span x-text="child.link.size"></span>)
                        </span>
                            </p>
                        </div>
                    </div>

                    <div class="col-span-1 justify-end hidden sm:flex" x-show="child.link.type === 'asset'">
                        <button class="download-file flex justify-center text-2xl w-6 h-6 icon-bookmark"
                                :data-downloadId="child.link.id"
                                @click.prevent="toggleBookmarkItem(child.link.id, $el)">
                        </button>
                    </div>
                </li>
            </template>
        </ul>

    </div>
</li>
                                                    </template>
                    </ul>
                    <div x-show="isShowMoreVisible('legal_basis')" class="mt-10 w-full">
                        <button class="btn btn-primary"
                                @click="showMore('legal_basis')">
                            Mehr anzeigen
                        </button>
                    </div>
                </div>
            </template>

            <template x-if="!data['legal_basis'].result?.length">
                <span class="text-shark-200 text-sm">
                    Keine Ergebnisse
                </span>
            </template>

        </div>
    </template>
</li>
                <li x-show="typesActive.includes('guideline')" class="flex flex-col">
    <span x-cloak
          x-show="!isInit"
          class="z-10 mb-8 flex h-8 items-center bg-white text-lg font-bold x-sticky-header"
          :class="isStickyHeaderEls && 'sticky'">
        Guidelines
    </span>

    <template x-if="'guideline' in data">
        <div class="contents">

            <template x-if="data['guideline'].result?.length">
                <div class="contents">
                    <ul class="">
                        <template x-for="item in getVisibleItems('guideline')">
                                                            <li class="mb-4 rounded p-4 transition-opacity delay-300 ease-in bg-bison-300 group"
    :class="isLoading ? 'opacity-0' : 'opacity-100'">
    <template x-if="item.link && item.link.href">
        <a x-show="item.link && item.link.href" :title="item.title"
           :href="item.link.href"
           :target="item.link.type === 'external' ? '_blank' : '_self'"
           class="w-full">

            
    <div class="mb-4 flex flex-row flex-wrap text-sm leading-4 text-shark-200">
        <template
                x-for="(item, index) in (labels = [...item.categories_labels, ...item.esas_labels, ...item.addresses_labels], labels)"
                :key="index">
            <div class="w-fit">
                <span x-text="item"></span>
                <span x-show="index !== labels.length - 1" class="mx-1">&bull;</span>
            </div>
        </template>
    </div>



            <div class="flex flex-col">
                <div class="mb-6 text-sm text-shark-200">
                    <span x-text="item.date ? `Geltung ab ${dates.formatDate(dates.getDateFromTimestamp(item.date))}` : `Intend to comply`"></span>
                </div>
                <div class="flex items-start gap-1 text-primary group x-colors hover:text-carmine-200">
                    <span class="relative h-6 w-6 overflow-hidden text-2xl">
                        <span class="absolute inset-y-0 h-6 w-6 transition-transform duration-500 ease-out"
                              :class="item.link.type === 'external' 
                                ? 'icon-arrow-diagonal translate-y-7 -translate-x-7 group-hover:translate-y-0 group-hover:translate-x-0' 
                                : '-left-6 icon-arrow-right group-hover:translate-x-6'"></span>
                        <span class="absolute inset-y-0 h-6 w-6 transition-transform duration-500 ease-out"
                              :class="item.link.type === 'external' 
                              ? 'icon-arrow-diagonal translate-y-0 translate-x-0 group-hover:-translate-y-7 group-hover:translate-x-7' 
                              : 'left-0 icon-arrow-right group-hover:translate-x-6'"></span>
                    </span>
                    <span class="mb-4 text-lg font-medium underline-offset-4 group-hover:underline" x-text="item.title"></span>
                </div>
                <p class="pl-7 small" x-text="item.description"></p>
            </div>
        </a>
    </template>

    <template x-if="!item.link || !item.link.href">
        <div class="w-full">

            
    <div class="mb-4 flex flex-row flex-wrap text-sm leading-4 text-shark-200">
        <template
                x-for="(item, index) in (labels = [...item.categories_labels, ...item.esas_labels, ...item.addresses_labels], labels)"
                :key="index">
            <div class="w-fit">
                <span x-text="item"></span>
                <span x-show="index !== labels.length - 1" class="mx-1">&bull;</span>
            </div>
        </template>
    </div>



            <div class="flex flex-col">
                <div class="mb-6 text-sm text-shark-200">
                    <span x-text="item.date
                        ? `Geltung ab ${dates.formatDate(dates.getDateFromTimestamp(item.date))}`
                        : `Intend to comply`"></span>
                </div>
                <div class="flex items-start gap-1 text-primary x-colors">
                    <span class="mb-4 pl-7 text-lg font-medium" x-text="item.title"></span>
                </div>
                <p class="pl-7 small" x-text="item.description"></p>
            </div>
        </div>
    </template>
</li>

                                                    </template>
                    </ul>
                    <div x-show="isShowMoreVisible('guideline')" class="mt-10 w-full">
                        <button class="btn btn-primary"
                                @click="showMore('guideline')">
                            Mehr anzeigen
                        </button>
                    </div>
                </div>
            </template>

            <template x-if="!data['guideline'].result?.length">
                <span class="text-shark-200 text-sm">
                    Keine Ergebnisse
                </span>
            </template>

        </div>
    </template>
</li>
            </ul>

            <div x-ref="trigger"
                 x-intersect:enter="isScrollTopVisible = true"
                 x-intersect:leave="isScrollTopVisible = false"
                 class="absolute bottom-0 top-[100vh]"></div>

            <div x-cloak
                 x-show="!isLoading && isScrollTopVisible"
                 x-transition.opacity.75ms
                 class="fixed inset-x-0 top-96 z-20 mx-auto flex w-full justify-center">
                <div class="flex w-full justify-end px-4 lg:w-[1384px]">
                    <button class="h-10 w-10 rounded-full border bg-white text-2xl drop-shadow border-primary icon-arrow-up x-center text-primary"
                            @click="scrollTop()"></button>
                </div>
            </div>
        </div>
    </div>
</div></body>

