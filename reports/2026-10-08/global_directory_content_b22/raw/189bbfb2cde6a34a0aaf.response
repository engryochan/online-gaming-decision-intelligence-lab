    <button x-cloak
            class="absolute top-0 right-0 h-full w-14 text-2xl x-center icon-arrow-right text-primary"
            :class="!!query.length ? 'invisible opacity-0' : 'visible opacity-100'"
            @click.stop="getItemsAll()">
    </button>
    <button x-cloak
            class="absolute top-0 right-0 h-full w-14 x-center icon-close text-primary"
