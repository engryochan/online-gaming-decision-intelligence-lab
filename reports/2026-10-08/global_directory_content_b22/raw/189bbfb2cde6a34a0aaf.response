                </div>
            </template>

            <template x-if="!data['event'].result?.length">
                <span class="text-shark-200 text-sm">
                    Keine Ergebnisse
                </span>
            </template>

        </div>
    </template>
</li>

                <li x-show="typesActive.includes('employee')" class="flex flex-col">
