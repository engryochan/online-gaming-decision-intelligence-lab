                <div class="container__background" style="background-position-x:;background-position-y:;"></div>
                <div id="container-7b159f8d43" class="cmp-container  container--align- container-- container--bg-">
                 <div class="image">
                  <div data-cmp-is="image" data-six-is="image" data-cmp-widths="319,510,1024,1920,2560" data-cmp-src="/es/securities-services/_jcr_content/root/containers/container_1131322800/grid_copy_copy/container1/image_copy.coreimg.85{.width}.jpeg/1750072980887/edificio-barna-bmefx-hrz.jpeg" data-cmp-filereference="/content/dam/bme/images/securities-services/edificio-barna-bmefx-hrz.jpg" id="image-9ed080baa2" data-cmp-hook-image="imageV3" class="cmp-image" itemscope itemtype="http://schema.org/ImageObject"><img src="/es/securities-services/_jcr_content/root/containers/container_1131322800/grid_copy_copy/container1/image_copy.coreimg.jpeg/1750072980887/edificio-barna-bmefx-hrz.jpeg" srcset="/es/securities-services/_jcr_content/root/containers/container_1131322800/grid_copy_copy/container1/image_copy.coreimg.85.319.jpeg/1750072980887/edificio-barna-bmefx-hrz.jpeg 319w,/es/securities-services/_jcr_content/root/containers/container_1131322800/grid_copy_copy/container1/image_copy.coreimg.85.510.jpeg/1750072980887/edificio-barna-bmefx-hrz.jpeg 510w,/es/securities-services/_jcr_content/root/containers/container_1131322800/grid_copy_copy/container1/image_copy.coreimg.85.1024.jpeg/1750072980887/edificio-barna-bmefx-hrz.jpeg 1024w,/es/securities-services/_jcr_content/root/containers/container_1131322800/grid_copy_copy/container1/image_copy.coreimg.85.1920.jpeg/1750072980887/edificio-barna-bmefx-hrz.jpeg 1920w,/es/securities-services/_jcr_content/root/containers/container_1131322800/grid_copy_copy/container1/image_copy.coreimg.85.2560.jpeg/1750072980887/edificio-barna-bmefx-hrz.jpeg 2560w" loading="lazy" class="cmp-image__image" itemprop="contentUrl" width="1901" height="831" alt>
                  </div>
