<td><h2>Resultatpresentasjon pr. 2.tertial 2017 - 28.september 207 kl. 18.00</h2></td>
<td><h3>Company news</h3></td>
<td align="right"><h3>2017-09-22 12:20:08</h3></td>
</tr>
