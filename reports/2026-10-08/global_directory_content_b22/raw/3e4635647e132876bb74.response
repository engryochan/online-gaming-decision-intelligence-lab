</footer>
<footer class="bg-green">
    <div class="mx-auto max-w-screen-xl px-3 py-6 text-sm font-light text-cream sm:px-5">
        <div class="flex flex-col gap-10 sm:items-center sm:justify-between sm:gap-6 lg:flex-row">
