: middle; vertical-align: bottom ; ">(6)%</td><td style="width:76.00px;;border-left: solid black 1pt ; text-align: center ;  vertical-align: middle; vertical-align: bottom ; ">87,409</td><td style="width:76.00px;;border-right: solid black 1pt ; border-left: solid black 1pt ; text-align: center ;  vertical-align: middle; vertical-align: bottom ; ">(4)%</td></tr><tr><td style="width:284.00px;;border-bottom: solid black 1pt ; border-left: solid black 1pt ; ">Golars share of contractual debt <sup>1</sup></td><td style="width:76.00px;;border-bottom: solid black 1pt ; border-left: solid black 1pt ; text-align: center ;  vertical-align: middle; vertical-align: bottom ; ">1,151,781</td><td style="width:76.00px;;border-bottom: solid black 1pt ; border-left: solid black 1pt ; text-align: center ;  vertical-align: middle; vertical-align: bottom ; ">1,743,747</td><td style="width:76.00px;;border-bottom: solid black 1pt ; border-left: solid black 1pt ; text-align: center ;  vertical-align: middle; vertical-align: bottom ; ">(34)%</td><td style="width:76.00px;;border-bottom: solid black 1pt ; border-left: solid black 1pt ; text-align: center ;  vertical-align: middle; vertical-align: bottom ; ">843,428</td><td style="width:76.00px;;border-right: solid black 1pt ; border-bottom: solid black 1pt ; border-left: solid black 1pt ; text-align: center ;  vertical-align: middle; vertical-align: bottom ; ">37%</td></tr></table> <p align="justify"><strong>Financial Review</strong></p>  <p align="justify"><em>Business Performance:</em></p> <table style="border-collapse: collapse; width:664; border-collapse:collapse ;"><tr><td style="width:463.00px;;border-top: solid black 1pt ; border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td style="width:67.00px;;border-top: solid black 1pt ; border-bottom: solid black 1pt ; border-left: solid black 1pt ; text-align: center ;  vertical-align: middle; vertical-align: bottom ; "><strong>2023</strong></td><td colspan="2" style="width:134.00