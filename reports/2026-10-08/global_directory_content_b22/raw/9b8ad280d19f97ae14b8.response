 ; "> </td><td style="width:55.34px;;text-align: right ;  vertical-align: middle; vertical-align: bottom ; ">54,524</td><td style="width:4.67px;;border-right: solid black 1pt ; vertical-align: top ; "> </td><td style="width:56.67px;;text-align: right ;  vertical-align: middle; vertical-align: bottom ; ">114,287</td><td style="width:4.67px;;border-right: solid black 1pt ; vertical-align: top ; "> </td></tr><tr><td style="width:308.00px;;border-right: solid black 1pt ; border-left: solid black 1pt ; vertical-align: bottom ; ">Vessel operating expenses</td><td style="width:58.00px;;text-align: right ;  vertical-align: middle; vertical-align: bottom ; ">(16,996</td><td style="width:4.67px;;border-right: solid black 1pt ; vertical-align: bottom ; ">)</td><td style="width:55.34px;;text-align: right ;  vertical-align: middle; vertical-align: bottom ; ">(13,822</td><td style="width:4.67px;;border-right: solid black 1pt ; vertical-align: bottom ; ">)</td><td style="width:55.34px;;text-align: right ;  vertical-align: middle; vertical-align: bottom ; ">(30,818</td><td style="width:4.67px;;border-right: solid black 1pt ; vertical-align: bottom ; ">)</td><td style="width:63.34px;;text-align: right ;  vertical-align: middle; vertical-align: bottom ; ">(18,176</td><td style="width:4.67px;;border-right: solid black 1pt ; vertical-align: bottom ; ">)</td><td style="width:55.34px;;text-align: right ;  vertical-align: middle; vertical-align: bottom ; ">(13,072</td><td style="width:4.67px;;border-right: solid black 1pt ; vertical-align: bottom ; ">)</td><td style="width:56.67px;;text-align: right ;  vertical-align: middle; vertical-align: bottom ; ">(31,248</td><td style="width:4.67px;;border-right: solid black 1pt ; vertical-align: bottom ; ">)</td></tr><tr><td style="width:308.00px;;border-right: solid black 1pt ; border-left: solid black 1pt ; vertical-align: bottom ; ">Voyage, charterhire &amp; commission expenses (including expenses from collaborative arrangement)</td><td style="w