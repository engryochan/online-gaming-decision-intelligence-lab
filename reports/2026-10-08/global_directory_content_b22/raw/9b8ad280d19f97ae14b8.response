="bottom"> (14,775 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (13,257 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (99 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (13,356 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td></tr><tr class="hugin"><td class="hugin" style="border-style: none solid none solid; border-width:1px;" valign="bottom"> Project development expenses<sup class="hugin" style="vertical-align: text-top; font-size: 0.8em;">(2)</sup> </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (1,037 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (4,704 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (5,741 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (1,145 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (6,798 </td><td class="hugin" style="border-style: none solid none none; border-width:1px;" valign="bottom"> ) </td><td align="right" class="hugin" style="border-style:none;" valign="bottom"> (7,943 </td><td class="hug