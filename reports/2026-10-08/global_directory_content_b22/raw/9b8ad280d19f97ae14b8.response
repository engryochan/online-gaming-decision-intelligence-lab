width:6.67px;;vertical-align: bottom ; "> </td><td style="width:61.34px;;border-left: solid black 1pt ; text-align: right ;  vertical-align: middle; vertical-align: bottom ; "><strong>26,045 </strong></td><td style="width:6.67px;;vertical-align: bottom ; "> </td><td style="width:53.34px;;border-left: solid black 1pt ; text-align: right ;  vertical-align: middle; vertical-align: bottom ; "><strong>41,105 </strong></td><td style="width:6.67px;;vertical-align: bottom ; "> </td><td style="width:54.34px;;border-left: solid black 1pt ; text-align: right ;  vertical-align: middle; vertical-align: bottom ; "><strong>67,150 </strong></td><td style="width:6.67px;;border-right: solid black 1pt ; vertical-align: bottom ; "> </td></tr><tr><td style="width:292.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:68.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:59.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:56.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:68.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:60.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:61.00px;;border-right: solid black 1pt ; border-left: solid black 1pt ; vertical-align: bottom ; "> </td></tr><tr><td style="width:292.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "><strong>Reconciliation to operating income</strong></td><td colspan="2" style="width:68.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:59.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:56.00px;;border-left: solid black 1pt ; vertical-align: bottom ; "> </td><td colspan="2" style="width:68.00px;;border-left: solid black 1pt ; vert