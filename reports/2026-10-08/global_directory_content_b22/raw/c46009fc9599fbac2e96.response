        </section>

            <div class="pageLayoutContentEditor">
                
                <div class="container-lg">
                <div class="content-image">
                <div id="ctl00_PlaceHolderMain_ctl02_label" style='display:none'>صورة الصفحة</div><div id="ctl00_PlaceHolderMain_ctl02__ControlWrapper_RichImageField" class="ms-rtestate-field" style="display:inline" aria-labelledby="ctl00_PlaceHolderMain_ctl02_label"><div class="ms-rtestate-field"></div></div>
                </div>
                <div id="ctl00_PlaceHolderMain_ctl03_label" style='display:none'>محتوى الصفحة</div><div id="ctl00_PlaceHolderMain_ctl03__ControlWrapper_RichHtmlField" class="ms-rtestate-field" style="display:inline" aria-labelledby="ctl00_PlaceHolderMain_ctl03_label"><h3>​​​​​​​التراخيص – شركات الخدمات المالية</h3><div> 
   <span style="font-size&#58;18.4px;">يبين الجدول التالي الحد الأدنى لرأس​ المال المدفوع المطلوب لكل نشاط من أنشطة الخدمات المالية، والرسوم المقررة لمنح ا</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">لترخيص وتجديده&#58;</span></div><div>
   <span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;"></span></div><div><table class="table table-bordered table-striped table-header" style="width&#58;1044px;"><thead><tr><th style="text-align&#58;center;"> تصنيف النشاط<br></th><th style="text-align&#58;center;"> رأس المال (رق)<br></th><th style="text-align&#58;center;"> رسوم منح الترخيص</th><th style="text-align&#58;center;"> رسوم التجديد لكل ثلاث سنوات</th><th style="text-align&#58;center;"> الضمان البنكي<br></th></tr></thead><tbody><tr><td>وسيط تنفيذي<br></td><td style="text-align&#58;center;">3,000,000<br></td><td style="text-align&#58;center;">​–<br></td><td style="text-align&#58;center;">–<br></td><td>1,000,000 يقدم للهيئة</td></tr><tr><td>وسيط تقاص</td><td style="text-align&#58;center;">10,000,000</td><td style="text-align&#58;center;">–​​​<br></td><td style="text-align&#58;center;">–<br></td><td>5,000,000 يقدم لجهة الإيداع</td></tr><tr><td>وسيط شامل</td><td style="text-align&#58;center;">20,000,000​</td><td style="text-align&#58;center;">–<br></td><td style="text-align&#58;center;">–</td><td>10,000,000 يقدم لجهة الإيداع</td></tr><tr><td>شركات الخدمات المالية الأخرى&#58;</td><td style="text-align&#58;center;">–<br></td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td></tr><tr><td>تنفيذ أوامر بيع أو شراء الأوراق المالية لصالح الغير</td><td style="text-align&#58;center;">3,000,000</td><td style="text-align&#58;center;">100,000</td><td style="text-align&#58;center;">30,000</td><td style="text-align&#58;center;">–</td></tr><tr><td>تداول الأوراق المالية لصالح الشخص نفسه</td><td style="text-align&#58;center;">5,000,000<br></td><td style="text-align&#58;center;">50,000</td><td style="text-align&#58;center;">15,000</td><td style="text-align&#58;center;">–</td></tr><tr><td>تقديم خدمات حفظ الأموال (النقود أو الأوراق المالية)</td><td style="text-align&#58;center;">20,000,000</td><td style="text-align&#58;center;">50,000</td><td style="text-align&#58;center;">15,000</td><td style="text-align&#58;center;">–</td></tr><tr><td>تقديم المشورة بشأن الأوراق المالية</td><td style="text-align&#58;center;">1,000,000​</td><td style="text-align&#58;center;">100,000</td><td style="text-align&#58;center;">30,000</td><td style="text-align&#58;center;">–</td></tr><tr><td>إدارة الاستثمار في الأوراق المالية</td><td style="text-align&#58;center;">5,000,000​​</td><td style="text-align&#58;center;">100,000</td><td style="text-align&#58;center;">30,000</td><td style="text-align&#58;center;">–</td></tr><tr><td>أمانة الاستثمار</td><td style="text-align&#58;center;">2,000,000</td><td style="text-align&#58;center;">50,000</td><td style="text-align&#58;center;">15,000​</td><td style="text-align&#58;center;">–</td></tr><tr><td>التعهد بتغطية إصدار الأوراق المالية</td><td style="text-align&#58;center;">5,000,000</td><td style="text-align&#58;center;">50,000</td><td style="text-align&#58;center;">15,000</td><td style="text-align&#58;center;">–</td></tr><tr><td>إدارة إصدار الأوراق المالية</td><td style="text-align&#58;center;">2,000,000</td><td style="text-align&#58;center;">100,000</td><td style="text-align&#58;center;">30,000</td><td style="text-align&#58;center;">–</td></tr><tr><td>مزويد السيولة</td><td style="text-align&#58;center;">10,000,000​</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td></tr><tr><td>إقراض واقتراض الأوراق المالية</td><td style="text-align&#58;center;">2,000,000</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td></tr><tr><td>التداول بالهامش​</td><td style="text-align&#58;center;">10,000,000</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td></tr><tr><td>صانع السوق</td><td style="text-align&#58;center;">20,000,000</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td></tr><tr><td>التسويق والترويج</td><td style="text-align&#58;center;">100,000</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td></tr><tr><td>مستشار الادراج</td><td style="text-align&#58;center;">100,000</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td></tr><tr><td>وكيل وسيط</td><td style="text-align&#58;center;"><span style="color&#58;#212529;font-size&#58;18.4px;text-align&#58;center;">100,000</span>​</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td><td style="text-align&#58;center;">–</td></tr></tbody></table> 
   <span style="background-color&#58;transparent;color&#58;#666666;text-align&#58;center;">​​​</span></div><h3>ملاحظات​</h3><div><ol><li style="text-align&#58;justify;"> 
         <span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;font-weight&#58;normal;">​​​الحد الأدنى لرأس المال المطلوب هو 15 مليون ريال قطري للوسيط المقاصة و 30 مليون ريال قطري للوسيط الشامل،&#160;</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;font-weight&#58;normal;">في حال رغبة مقدم الطلب بممارسة أي من الأنشطة الاختيارية المسموح بها ضمن فئته. ويتم تعديل رأس المال&#160;</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;font-weight&#58;normal;">المطلوب وفقًا لذلك ليعكس نطاق الخدمات المرخصة الموسع.</span></li><li style="text-align&#58;justify;"><div> 
            <span style="font-size&#58;18.4px;">شركات الخدمات المالية المرخصة لممارسة جميع الأنشطة المسموح بها (باستثناء التداول بالهامش، إقراض واقتراض&#160;</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">الأوراق المالية، تنفيذ أوامر الأوراق المالية لصالح الغير، التداول لحساب الشركة، صانع السوق، ومزود السيولة</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">)&#160;</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">يجب أن تحافظ على حد أدنى لرأس المال المدفوع قدره 25 مليون ريال قطري، شريطة أن تتقدم بطلب لممارسة كامل&#160;</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">نطاق الأنشطة المؤهلة</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">​.</span></div></li><li style="text-align&#58;justify;"><div> 
            <span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">أنش</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">طة التداول بالهامش، إقراض واقترا​ض الأوراق المالية، تنفيذ أوامر الأوراق المالية لصالح الغير، التداول لحساب ا</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">لشركة، صانع السوق، ومزود السيولة تقتصر على فئات الوسطاء الماليين وفقًا للتصنيف الوارد في المادة&#160;(5) من&#160;</span><span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">دليل الخدمات المالية الصادر عن الهيئة .</span></div></li><li><div> 
            <span style="color&#58;#666666;font-size&#58;18.4px;background-color&#58;transparent;">يوضح دليل معايير التراخيص بالتفصيل المتطلبات الخاصة بكل نشاط من أجل الحصول على الترخيص​.</span></div></li></ol><div><h3>روابط ذات صلة</h3><div><ul><li> 
               <span style="font-size&#58;18.4px;">
                  <a href="/Arabic/Licensing/Documents/معايير%20التراخيص3.pdf">دليل معايير التراخيص​ – هيئة قطر للأسواق المالية.​</a>​</span></li><li> 
               <span style="font-size&#58;18.4px;">
                  <a href="/Arabic/Legislation/Legal_decisions/Documents/2019-05.pdf">دليل الخدمات المالية – هيئة قطر ​للأسواق المالية.</a>​</span></li></ul></div></div></div><p>​​<br></p>​<br></div>
                </div>
            </div>
            
