                                             <p>تاريخ التسجيل </p> 
                                          </th> 
                                       </tr> 
                                    </thead> 
                                    <tbody> 
                                       <tr> 
                                          <td rowspan="1"> 
                                             <span>أتش أم كيه كابيتال ذ.م.م</span> </td> 
                                          <td rowspan="1"> 
                                             <span> إدارة الاستثمار في الأوراق المالية</span> </td> 
                                          <td rowspan="1"> 
                                             <span>09 سبتمبر 2025</span> </td> 
                                       </tr> 
                                       <tr> 
                                          <td rowspan="6" style="background-color: var(--bs-table-striped-bg);"> 
                                             <span>​بنك لشا ذ.م.م  </span> </td> 
                                          <td rowspan="1"> 
                                             <span>تقديم المشورة بشأن الأوراق المالية</span> </td> 
                                          <td rowspan="1"> 
                                             <span>23 أكتوبر 2025</span> </td> 
                                       </tr> 
