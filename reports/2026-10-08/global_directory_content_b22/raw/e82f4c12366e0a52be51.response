      <div class="s4-wpcell-plain ms-webpartzone-cell ms-webpart-cell-vertical-inline-table ms-webpart-cell-vertical ms-fullWidth s4-wpActive"> 
         <div class="ms-webpart-chrome ms-webpart-chrome-vertical ms-webpart-chrome-fullWidth"> 
            <div width="100%" class="ms-WPBody"> 
               <div> 
                  <div class="adv-component"> 
                     <section class="BrokerAgents" id="BrokerAgents"> 
                        <div id="homepage-BrokerAgents-div"> 
                           <div class="container-lg py-3"> 
                              <div class="table-responsive table-custom"> 
                                 <table class="table table-bordered table-striped table-header"> 
                                    <thead> 
                                       <tr> 
                                          <th> 
                                             <p>اسم الشركة</p> 
                                          </th> 
                                          <th> 
                                             <p>نوع النشاط</p> 
                                          </th> 
