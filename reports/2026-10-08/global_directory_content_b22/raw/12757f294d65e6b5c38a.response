    <script>
        //add table head
        jQuery("<thead><tr><th colspan='3'>Consultanti Autorizati</th></tr></thead>").prependTo($("#gvConsultanti"));
        // add separator between the consultants
        
        $($("#gvConsultanti tr")[17]).after("<tr><td colspan='3'>&nbsp;</td></tr>");
	    

        function popoverAeROConsultants(id, name, phone, mail, address) {
            var content = '<p>Persoana de contact: ' + name + '</p>'
            + '<p>Telefon: ' + phone + '</p>'
            + '<p>E-mail: ' + mail + '</p>'
            + '<p>Address: ' + address + '</p>';

            $(id).popover({
                html: true,
                content: content,
                placement: 'auto top',
                conainer: $(id).parent(),
                trigger: 'hover',
                template: '<div class="popover test-class" role="tooltip"><div class="arrow"></div><h3 class="popover-title"></h3><div class="popover-content"></div></div>'
            });
        }


        $(function () {
            $('[data-toggle="popover"]').each(function () {
                var content = '<div class="col-xs-4">Persoana de contact: </div><div class="col-xs-8">' + $(this).data('name') + '</div>'
                + '<div class="clearfix"></div>'
                + '<div class="col-xs-4">Telefon: </div><div class="col-xs-8">' + $(this).data('phone') + '</div>'
                + '<div class="clearfix"></div>'
                + '<div class="col-xs-4">E-mail: </div><div class="col-xs-8">' + '<a href=mailto:' + $(this).data('mail') + '>' + $(this).data('mail') + '</a></div>'
                + '<div class="clearfix"></div>'
                + '<div class="col-xs-4">Adresa: </div><div class="col-xs-8">' + $(this).data('address') + '</div>'

                $(this).popover({
                    html: true,
                    content: content,
                    container: $(this),
                    placement: 'auto top',
                    trigger: 'hover',
                    template: '<div class="popover aero-consultants-popover" role="tooltip"><div class="arrow"></div><h3 class="popover-title"></h3><div class="popover-content"></div><div style="position: absolute; width: 397px; height: 12px; bottom: -12px;"></div></div>'
                });
            });
        })
    </script>


