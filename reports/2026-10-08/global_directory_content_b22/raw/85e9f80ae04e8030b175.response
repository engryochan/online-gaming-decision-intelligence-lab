    <div class="press-filter">
        <form method="post" action="#" name="filter" id="filterOffers">
            <fieldset>
                <ul>
                    <li>
                        <div id='cmb-2' >
                            <div class="combo square ui-component" id="mer" >
                                <span class="value">
