        <thead>
            <tr>
                <th class="cell-01">DATE</th>
                <th class="cell-02">TICKER</th>
                <th class="cell-03">SERIES</th>
                <th class="cell-04">SUBJECT</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{prettyDate}}<div>{{hr}}</div></td>
                <td><strong>{{clave}}</strong></td>
                <td><strong>{{serie}}</strong></td>
                <td><span class="desc">{{asunto}}</span></td>
                <td>
                    <a target="_blank" href="{{archivo}}" class="lnk-download">
                        <span class="icon"></span>
                        <span class="text">Download</span>
                        <span class="document"></span>
                    </a>
                </td>
            </tr>
        </tbody>
    </table>

