ta-language-code="en" data-country-code="us"><img src="https://www.adx.ae/_next/static/media/Earth.5712b293.svg" alt="language-icon" height="20" width="20" class="icon-sphere"/><div class="language-selector-select-link" data-language-code="ar" data-country-code="ae"><button type="button" class="language-switcher-btn btn btn-primary">عربي</button></div></div></div></div><div class="header-util-item header-util-login d-none d-md-flex"></div></div></div></div><div class="gridcontainer pt-3"><div class="public-header-main-row"><div class="header-item header-logo"><div class="adx-logo"><a href="/en"><div class="adx-logo-img"><img alt="full-variant-logo" loading="eager" width="540" height="106" decoding="async" data-nimg="1" class="full-variant-logo" style="color:transparent" src="/-/media/adx/topnavigation/adx-logo/adx-white-logo.svg"/><img alt="light-variant-logo" loading="eager" width="540" height="106" decoding="async" data-nimg="1" class="light-variant-logo" style="color:transparent" src="/-/media/adx/topnavigation/adx-logo/adx-dark-logo.svg"/></div></a></div></div><div class="header-item header-spacer-desktop"></div><div class="header-item header-search"><div class="d-flex align-items-center gap-3 position-relative"><div class="search-btn-responsive secondary-btn search-btn flaot-r rounded-circle"><i data-testid="icon-search1" class="icon-search1"></i></div></div></div><div class="header-item header-mw-btn"><div class="mw-btn"><a class="primary-btn text-dark mw-btn-container " aria-label="marketWatchBtn" href="/en/all-equities"><span class="header-mw-btn__label">MARKET WATCH</span></a></div></div></div></div><!--/$--></div></div></header><main id="top" class="z-1"><div id="content" style="margin-top:120px;background:white"><!--$--><div style="position:sticky;top:0px;z-index:9" class="adx-market-watch header-main-ticker mainHeader-ticker "><div class="ticker-value overflow-hidden"><div class="inLoader-market-watch">Loading<!-- --> ...<span class="spinner-border spinner-border" role="status" aria-hidden="true"></span></div></div></div><!--/$--><!--$--><div class="component navigation "><div class="component-content container"><nav class="breadcrumbs-nav" aria-label="breadcrumbs"><ul class="clearfix m-0"><li class=""><div class="navigation-title"><a href="/">ADX</a><span class="separator">/</span></div></li><li class=""><div class="navigation-title"><span>Issuers</span><span class="separator">/</span></div></li><li class=""></li><li class="active"><div class="navigation-title"><a href="/issuers/why-list/overview">Issuing with ADX</a></div></li></ul></nav><div class="pageTitlediv"><h1 class="pageTitle mb-0">Issuing with ADX</h1></div></div></div><!--/$--><!--$--><div class="component adx-profile "><div class="component-content"><div class="adx-homePage-themeSwitcher"><div class="adx-market-watch"><div class="container-fluid"><div class="theme-switcher"><div class="button-toogle-view"><div class="toogle-btn-mode"><input type="checkbox" id="darkmode-toogle" checked=""/><label for="darkmode-toogle"><i class="icon-dark-theme sun-icon"></i><i class="icon-light-theme moon-icon"></i></label></div><div class="background"></div></div></div></div></div></div><div class="row "><div class="col-12 adx-tabHeader-slider"><div class="container position-relative  "><div class=""></div><div class="tab-animation"><div class="slick-slider adx-profile_nav nav nav-pills nav-fill slide-tab-0 slider-spacing slider-spacingLeft  slick-initialized"><div class="slick-list"><div class="slick-track" style="width:28.571428571428573%;left:0%"><div data-index="0" class="slick-slide slick-active slick-current" tabindex="-1" aria-hidden="false" style="outline:none;width:50%"><div><li class="nav-item" role="presentation" tabindex="-1" style="width:100%;display:inline-block"><button type="button" role="tab" aria-selected="true" class="nav-link">Why ADX</button></li></div></div><div data-index="1" class="slick-slide slick-active" tabindex="-1" aria-hidden="false" style="outline:none;width:50%"><div><li class="nav-item" role="presentation" tabindex="-1" style="width:100%;display:inline-block"><button type="button" role="tab" aria-selected="true" class="nav-link">Raise Capital</button></li></div></div></div></div></div><div class="adx-profile_nav-slider"><span class="glider glider-remove-mobile first-nav-item " style="width:calc(100% / 2)"></span></div></div></div><div class="tab-content" id="myTabContent"><div class="tab-pane fade show active"><div><!--$--><div class="py-1 margin-bottom-40"><div class="richtext-wrapper container"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class=""><p>The Abu Dhabi Securities Exchange (ADX) is a prominent and dynamic marketplace that caters to the capital-raising, listing, and trading needs of a diverse range of issuers. We have established ourselves as the preferred exchange for initial public offerings (IPOs) and listings for leading issuers within the United Arab Emirates (UAE) and regional and international companies.</p>
</div></div></div></div></div><!--/$--><!--$--> <div class="component adx-aboutFunctions"><div class="component-content container"><h2 class="adx-aboutHead">ADX: a leading market</h2><div class="css-0" style="opacity:0;animation-delay:0ms"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="">ADX offers a robust and increasingly diversified capital markets platform.</div></div><div class="css-0" style="opacity:0;animation-delay:1000ms"><div class="row mt-3"><div class="col-md-6"><div class="adx-aboutFunctions-list nochange"><div><strong>Global Reach</strong>: Gain exposure to a diverse investor base with 43% foreign participation and a growing international presence.</div></div></div><div class="col-md-6"><div class="adx-aboutFunctions-list nochange"><div><strong>Diverse Investment Options &amp; Innovation</strong>: Access a wide range of investors through over 100 listed securities, the region's largest ETF platform, and the first SPAC listings in the region.</div></div></div><div class="col-md-6"><div class="adx-aboutFunctions-list nochange"><div><strong>Growing &amp; Engaged Investor Base</strong>: Attract a pool of 1.1 million investors, with a steady increase of new investors year-over-year.&nbsp;</div></div></div><div class="col-md-6"><div class="adx-aboutFunctions-list nochange"><div><strong>Large &amp; Established Market</strong>: Trade on a platform with a market capitalization of 2.9 trillion Dirhams, ranking among the top 20 globally. It signifies a strong foundation for your company's growth and potential valuation.</div></div></div><div class="col-md-6"><div class="adx-aboutFunctions-list nochange"><div><strong>High Liquidity &amp; Active Trading</strong>: Benefit from active trading with an average daily volume of 243 million shares and a total traded value of 286 billion Dirhams (Top 30 globally). This dynamic market with readily available buyers and sellers facilitates smooth transactions for your company's shares.</div></div></div></div></div></div></div></div><!--/$--><!--$?--><template id="B:0"></template><h4>Loading component...</h4><!--/$--><!--$?--><template id="B:1"></template><h4>Loading component...</h4><!--/$--></div><div></div></div></div></div></div></div></div><!--/$--></div></main><footer><button class="ScrollToTop"><i class="icon icon-top"></i></button><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="component adx-footer pt-0"><div class="component-content"><!--$--><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="component newsletter-section"><div class="component-content container"><div class="newsletter-head"><div class="newsletter-title-l2"><div>GET THE LATEST<br/>UPDATES MAILED TO YOU</div></div></div><div id="newsletter-ph" class=""><input type="text" data-testid="newsletter-ph-input" id="newsletter-ph-input" placeholder="Type your email here..." name="newsletter-ph-input" value=""/><button disabled="" class="primary-btn"> <!-- --> <!-- -->Subscribe</button></div></div></div></div><div class="css-0" style="opacity:0;animation-delay:700ms"></div><div class="css-0" style="opacity:0;animation-delay:700ms"></div><div class="css-0" style="opacity:0;animation-delay:700ms"></div><!--/$--><!--$?--><template id="B:2"></template><h4>Loading component...</h4><!--/$--></div></div></div></div></footer></div><div class="Toastify"></div></div><script>requestAnimationFrame(function(){$RT=performance.now()});</script><div hidden id="S:0"><div class="component adx-listingCarousel"><div class="component-content container"><div class="css-0" style="opacity:0;animation-delay:500ms"><h2 class="adx-aboutHead">The Stable Foundation of ADX: Supporting Your Business Success</h2></div><div class="css-0" style="opacity:0;animation-delay:500ms"><div class="adx-listingCarousel_block"><div class="carousel slide"><div class="carousel-indicators"><button type="button" data-bs-target="" aria-label="Slide 1" class="active" aria-current="true"></button><button type="button" data-bs-target="" aria-label="Slide 2" aria-current="false"></button><button type="button" data-bs-target="" aria-label="Slide 3" aria-current="false"></button><button type="button" data-bs-target="" aria-label="Slide 4" aria-current="false"></button><button type="button" data-bs-target="" aria-label="Slide 5" aria-current="false"></button></div><div class="carousel-inner"><div class="active carousel-item"><div class="adx-listingCarousel_block-col"><div class="adx-listingCarousel_block-left"><figure></figure><h2>Strong Backing</h2></div><div class="adx-listingCarousel_block-right"><div><span style="line-height: 107%;">Owned by ADQ, Abu Dhabi's sovereign wealth fund.</span></div></div></div></div><div class="carousel-item"><div class="adx-listingCarousel_block-col"><div class="adx-listingCarousel_block-left"><figure></figure><h2>Sustainable Growth</h2></div><div class="adx-listingCarousel_block-right"><div>Committed to ESG practices &amp; guides listed companies.</div></div></div></div><div class="carousel-item"><div class="adx-listingCarousel_block-col"><div class="adx-listingCarousel_block-left"><figure></figure><h2>Global Recognition</h2></div><div class="adx-listingCarousel_block-right"><div>Tracked by FTSE, S&amp;P, Dow Jones &amp; has MSCI emerging market status.&nbsp;</div></div></div></div><div class="carousel-item"><div class="adx-listingCarousel_block-col"><div class="adx-listingCarousel_block-left"><figure></figure><h2>Diverse Offerings</h2></div><div class="adx-listingCarousel_block-right"><div>List on Main Market, Growth Market, with SPACs, ETFs &amp; Derivatives.&nbsp;</div></div></div></div><div class="carousel-item"><div class="adx-listingCarousel_block-col"><div class="adx-listingCarousel_block-left"><figure></figure><h2>Rapid Expansion</h2></div><div class="adx-listingCarousel_block-right"><div>Over 100 securities listed since 2020.&nbsp;</div></div></div></div></div><a class="carousel-control-prev" role="button" tabindex="0" href="#"><span></span><span class="visually-hidden">Previous</span></a><a class="carousel-control-next" role="button" tabindex="0" href="#"><span></span><span class="visually-hidden">Next</span></a></div></div></div></div></div></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if("/$"===d||"/&"===d)if(0===h)break;else h--;else"$"!==d&&"$?"!==d&&"$~"!==d&&"$!"!==d&&"&"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data="$";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};
$RC=function(a,b){if(b=document.getElementById(b))(a=document.getElementById(a))?(a.previousSibling.data="$~",$RB.push(a,b),2===$RB.length&&("number"!==typeof $RT?requestAnimationFrame($RV.bind(null,$RB)):(a=performance.now(),setTimeout($RV.bind(null,$RB),2300>a&&2E3<a?2300-a:$RT+300-a)))):b.parentNode.removeChild(b)};$RC("B:0","S:0")</script><div hidden id="S:1"><div class="component adx-accordion"><div class="component-content container"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="doc-req"><div class="how-to-trade-title simple_flow_text ">Maximize Exposure and Governance with ADX Issuer Services</div><div><div>ADX empowers issuers with a comprehensive suite of services designed to maximize exposure and enhance governance.</div></div></div></div><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="row"><div class="col-12"><div id="accordionExample" class="accordion accordion"><div class="css-0" style="opacity:0;animation-delay:700ms"><div class="accordion-item accordion-item"><h2 id="headingOne" class="accordion-header accordion-header"><button type="button" aria-expanded="false" class="accordion-button collapsed">Investor Services<div class="show_content"><span></span><span></span></div></button></h2><div class="accordion-collapse collapse"><div class="accordion-body accordion-body"><div class="row company-images-container"><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div></div><div class="list-reqire"><div><ul>
    <li><strong>IR &amp; Research</strong>: Gain access to services that increase qualified and international institutional interest in your company.</li>
    <li><strong>Dividend Distribution</strong>: Leverage our technology-driven platform to offer an efficient and secure dividend distribution service.
</li>
    <li><strong>eIPO Portal</strong>: Facilitate easy IPO subscriptions for all retail investors with a UAE bank account through the ADX website.</li>
</ul></div></div></div></div></div></div><div class="css-0" style="opacity:0;animation-delay:1000ms"><div class="accordion-item accordion-item"><h2 id="headingOne" class="accordion-header accordion-header"><button type="button" aria-expanded="false" class="accordion-button collapsed">Issuer Services<div class="show_content"><span></span><span></span></div></button></h2><div class="accordion-collapse collapse"><div class="accordion-body accordion-body"><div class="row company-images-container"><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div></div><div class="list-reqire"><div><strong>Corporate Communication</strong>: Benefit from pre-, during, and post-IPO support to amplify your visibility among institutional and retail investors.<br />
<strong>AGM Management &amp; E-Voting</strong>: Utilize our services to manage your Annual General Meetings (AGM) efficiently with e-voting capabilities.<br />
<strong>Custodian Services</strong>: Benefit from&nbsp;direct market access, block trade support, and strategic deal execution assistance through our custodian services, connecting you with international investors.</div></div></div></div></div></div><div class="css-0" style="opacity:0;animation-delay:1300ms"><div class="accordion-item accordion-item"><h2 id="headingOne" class="accordion-header accordion-header"><button type="button" aria-expanded="false" class="accordion-button collapsed">Additional Services<div class="show_content"><span></span><span></span></div></button></h2><div class="accordion-collapse collapse"><div class="accordion-body accordion-body"><div class="row company-images-container"><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div></div><div class="list-reqire"><div><ul>
    <li><strong>Market Surveillance</strong>: Our best-in-class market surveillance ensures fair and transparent trading activity for your company's stock.<br />
    <strong></strong></li>
    <li><strong>Detailed Market Data</strong>: Gain access to issuer-specific market data and insights into trading developments.<br />
    <strong></strong></li>
    <li><strong>Global Roadshows &amp; Marketing Activities</strong>: Participate in yearly international and regional investor roadshows, alongside proactive marketing initiatives to elevate your company's profile.</li>
</ul></div></div></div></div></div></div><div class="css-0" style="opacity:0;animation-delay:1600ms"><div class="accordion-item accordion-item"><h2 id="headingOne" class="accordion-header accordion-header"><button type="button" aria-expanded="false" class="accordion-button collapsed">Market Dynamics and Infrastructure<div class="show_content"><span></span><span></span></div></button></h2><div class="accordion-collapse collapse"><div class="accordion-body accordion-body"><div class="row company-images-container"><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div><div class="col-6 col-md-3"></div></div><div class="list-reqire"><div><ul>
    <li><strong>+1B liquidity</strong>: lending agents, licensed liquidity providers, and market makers including AED 1B from Abu Dhabi Government.&nbsp;</li>
    <li><strong>ESG</strong>: ESG reporting and corporate governance to increase sustainability and trust.&nbsp;</li>
    <li><strong>Leadership</strong>: Strong and well experienced management team with experience in IPOs, listings and exchange operations, and issuer services.&nbsp;</li>
</ul></div></div></div></div></div></div></div></div></div></div></div></div></div><script>$RC("B:1","S:1")</script><div hidden id="S:2"><div class="gridcontainer"><div class="row  grid-section-inner"><div class=" col-md-8 col-sm-12"><div class="gridcontainer"><div class="row justify-content-between"><div class="col-md-2 col-sm-12 col-xl-2"><div class="css-0" style="opacity:0;animation-delay:500ms"><div class="sitemap-links"><div class="row"><div class="component global-nav"><div class="component-content"><div><div class="sitemap-list-title">Investors</div><div class="sitemap-list-item" aria-label="sitemap"><a title="" target="" class="sitemap-list-link" href="/en/investors/become-an-investor/how-to-become-an-investor">How to Become an Investor</a></div><div class="sitemap-list-item" aria-label="sitemap"><a title="" target="" class="sitemap-list-link" href="/en/investors/become-an-investor/how-to-invest">How to Invest</a></div><div class="sitemap-list-item" aria-label="sitemap"><a title="" class="sitemap-list-link" href="/en/investors/ipo-overview">IPO Subscription</a></div><div class="sitemap-list-item" aria-label="sitemap"><a title="" target="" class="sitemap-list-link" href="/en/investors/investors-information/dividend-distribution">Dividend Distribution</a></div><div class="sitemap-list-item" aria-label="sitemap"></div><div class="sitemap-list-item" aria-label="sitemap"></div><div class="sitemap-list-item" aria-label="sitemap"><a title="" class="sitemap-list-link" href="/en/investors/list-of-fees">Fees</a></div><div class="sitemap-list-item" aria-label="sitemap"><a title="" class="sitemap-list-link" href="/en/investors/ipo-subscription/listing-calendar">Listing Calendar</a></div></div></div></div></div></div></div></div><div class="col-md-2 col-sm-12 col-xl-2"><div class="css-0" style="opacity:0;animation-delay:500ms"><div class="sitemap-links"><div class="row"><div class="component global-nav"><div class="component-content"><div><div class="sitemap-list-title">