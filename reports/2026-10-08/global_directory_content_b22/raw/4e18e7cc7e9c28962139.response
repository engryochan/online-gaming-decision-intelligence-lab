    <script>

        document.addEventListener("DOMContentLoaded", function () {
            loadWhylistAnchorList();
            initStageHomeBannerSlide();
            removeCss();
        });

        function loadWhylistAnchorList() {
            var bannerNavHtml = '<div class="whylist-landing-anchor"><div class="whylist-landing-anchor-holder">';
            $("[id][data-anchor-title].stage_section_anchor_point").each(function () {
                var $s = $(this);
                var navID = $s.attr("id");
                var navScTitle = $s.attr("title");
                var navTitle = $s.attr("data-anchor-title");
                if (navScTitle) {
                    navTitle = navScTitle;
                }
                if (navID != "" && navTitle != "") {
                    bannerNavHtml += '<a href="#' + navID + '" title="' + navTitle + '" class="whylist-landing-anchor-item">' + navTitle + '</a>'
                }
            });
            bannerNavHtml += '</div></div>'
            //console.log("banner: " + bannerNavHtml);
            if ($("[id][data-anchor-title].stage_section_anchor_point").length != 0) {
                $(".whylist-banner-nav").each(function () {
                    $(this).html(bannerNavHtml);
                });
            }
        }

        function initStageHomeBannerSlide() {
            setInterval(function () {
                if ($(".swiper-pagination-bullet-active").next().length > 0) {
                    $(".swiper-pagination-bullet-active").next().click();
                } else {
                    $(".swiper-pagination-bullet").eq(0).click()
                }
            }, 20000);
        }

        function removeCss() {
            setTimeout(function () {
                $(".swiper-pagination-bullets").removeClass("swiper-pagination-horizontal");
            }, 500);
        }

    </script>

    
