                        <a href="/en/terms-of-use" target="_blank">terms of use</a>
                        and the
                        <a href="/en/privacy-policy" target="_blank">privacy policy.</a>
                    </p>
                </li>
                <li>
                    <!-- Captcha -->
                    <div id='idcaptcha_registro' class='commonCaptcha'>
                        <p class="special">To continue, please click on the number:<strong>&nbsp;NINE</strong></p>
