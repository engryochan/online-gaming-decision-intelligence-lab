<script nonce="Qd0MYRxD9WfklP9e/+8JDg==">
    (function () {
        const tabs = Array.from(document.querySelectorAll('.cp-tab'));
        if (!tabs.length) return;
        const sections = tabs
            .map(t => document.querySelector(t.getAttribute('href')))
            .filter(Boolean);

        tabs.forEach(tab => {
            tab.addEventListener('click', function (e) {
                const target = document.querySelector(tab.getAttribute('href'));
                if (!target) return;
                e.preventDefault();
                const navBar = document.getElementById('cp-tabs');
                const offset = (navBar ? navBar.offsetHeight : 0) + 12;
                const top = target.getBoundingClientRect().top + window.pageYOffset - offset;
                window.scrollTo({ top, behavior: 'smooth' });
            });
        });

        const navBar = document.getElementById('cp-tabs');
        const hero = document.querySelector('.cp-hero');

        function onScroll() {
            const line = (navBar ? navBar.offsetHeight : 0) + 80;
            let current = sections[0];
            for (const sec of sections) {
                if (sec.getBoundingClientRect().top <= line) current = sec;
            }
            tabs.forEach(t => t.classList.toggle('active', t.getAttribute('href') === '#' + (current ? current.id : '')));

            if (navBar && hero) {
                const heroBottom = hero.getBoundingClientRect().bottom;
                navBar.classList.toggle('is-stuck', heroBottom <= navBar.offsetHeight);
            }
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
    })();

    // Initialize AOS animations
    if (typeof AOS !== 'undefined') {
        AOS.init({ once: true, offset: 50 });
    }

    document.querySelectorAll('.tooltip').forEach(function(tip) {
        var box = tip.querySelector('.tooltiptext');
        if (!box) return;
        tip.addEventListener('mouseenter', function() {
            var rect = tip.getBoundingClientRect();
            var tipW = 220;
            var left = rect.right - tipW;
            if (left < 8) left = 8;
            box.style.left = left + 'px';
            box.style.top = (rect.bottom + 8) + 'px';
        });
    });
</script>


