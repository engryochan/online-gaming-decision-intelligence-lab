                        <a href="https://x.com/ConnectedKerb?ref_src=twsrc%5Egoogle%7Ctwcamp%5Eserp%7Ctwgr%5Eauthor" target="_blank" rel="noopener"><i aria-hidden="true" class="fab fa-x-twitter"></i><span>X</span></a>
                        <a href="https://www.youtube.com/@ConnectedKerb" target="_blank" rel="noopener"><i aria-hidden="true" class="fab fa-youtube"></i><span>YouTube</span></a>
                        <a href="https://www.facebook.com/connectedkerb/?locale=en_GB" target="_blank" rel="noopener"><i aria-hidden="true" class="fab fa-facebook"></i><span>Facebook</span></a>
                        
