<div id="windowLogin" class="modal-body ">
    <h2>Register Users</h2>
    <div class="server-message ">
        <span class="icon info"></span>
        <p>null</p>
    </div>
    <form id="loginForm" class="form-login" autocomplete="off" method="post" action="https://www.bmv.com.mx/en/Grupo_BMV/Comite_de_listado_de_valores/_aid/688/_act/loginUser">
