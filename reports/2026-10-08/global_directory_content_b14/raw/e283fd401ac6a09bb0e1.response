Bruce Markets LLC is an SEC registered broker-dealer, member of <a href="//www.finra.org/" target="_blank" class="underline hover:text-white" data-astro-cid-sz7xmlte>FINRA</a> and <a href="https://www.sipc.org/" target="_blank" class="underline hover:text-white" data-astro-cid-sz7xmlte>SIPC</a>.
          Check the background of Bruce Markets LLC at <a href="https://brokercheck.finra.org/firm/summary/300209" target="_blank" class="underline hover:text-white" data-astro-cid-sz7xmlte>FINRA BrokerCheck</a>,
          and more information on Bruce ATS is available on the <a href="https://www.sec.gov/about/divisions-offices/division-trading-markets/alternative-trading-systems/form-ats-n-filings-information" target="_blank" class="underline hover:text-white" data-astro-cid-sz7xmlte>SEC website</a>.
</p> <p data-astro-cid-sz7xmlte>All product and company names are trademarks™ or registered® trademarks of their respective holders. Use of them does not imply any affiliation with or endorsement by them.</p> </div> <p class="text-xs text-bruce-light whitespace-nowrap" data-astro-cid-sz7xmlte>&copy; 2026 Bruce Markets LLC. All rights reserved.</p> </div> </div> </footer> <script type="module">function d(){document.querySelectorAll("[data-accordion-trigger]").forEach(t=>{t.dataset.toggleInitialized!=="true"&&(t.dataset.toggleInitialized="true",t.addEventListener("click",()=>{const a=t.closest("[data-accordion-item]"),i=a?.querySelector("[data-accordion-panel]"),n=a?.querySelector("[data-accordion-icon]"),o=n?.querySelector("path"),e=t.getAttribute("aria-expanded")==="true";t.setAttribute("aria-expanded",String(!e)),i?.classList.toggle("hidden",e),n?.classList.toggle("rotate-45",!e),o&&o.setAttribute("d",e?"M12 6v6m0 0v6m0-6h6m-6 0H6":"M18 12H6")}))})}document.addEventListener("astro:page-load",d);document.addEventListener("DOMContentLoaded",d);</script> <script>
      // HubSpot's v4 forms embed (js.hsforms.net/forms/embed/*.js) renders
      // .hs-form-frame elements once at load, then watches the *original*
      // document.body with a MutationObserver for late-added frames. Astro's
      // ClientRouter replaces the <body> element on every client-side
      // navigation, which orphans that observer — so forms in a freshly
      // swapped page (e.g. the report form in a blog post) never render
      // until a full refresh. Re-inserting the embed script is normally a
      // no-op because it guards on window.__HS__FORMS__EMBED__; deleting
      // that global before re-inserting forces a fresh scan and a new
      // observer bound to the current body.
      if (!window.__bruceHsFormsReloadInitialized) {
        window.__bruceHsFormsReloadInitialized = true;

        const HS_EMBED_GLOBAL = '__HS__FORMS__EMBED__';
        const HS_EMBED_SCRIPT_ID = 'hubspot-forms-embed-reload';
        const HS_EMBED_SRC = 'https://js.hsforms.net/forms/embed/50368110.js';

        // Render any uninitialized form frames on both direct loads and
        // client-side navigations. Scripts inserted via `set:html` are not a
        // reliable initialization point, because the newsletter form may have
        // already loaded HubSpot's embed script for the page.
        document.addEventListener('astro:page-load', () => {
          const frames = Array.from(document.querySelectorAll('.hs-form-frame'));
          const unrendered = frames.filter((frame) => !frame.querySelector('iframe'));
          if (unrendered.length === 0) return;

          // Frames that are already rendered (e.g. the transition:persist'd
          // newsletter form) must be hidden from the re-scan so they don't
          // get a duplicate iframe — both the scan and the observer match on
          // the .hs-form-frame class.
          const rendered = frames.filter((frame) => frame.querySelector('iframe'));
          rendered.forEach((frame) => frame.classList.remove('hs-form-frame'));

          delete window[HS_EMBED_GLOBAL];
          const previous = document.getElementById(HS_EMBED_SCRIPT_ID);
          if (previous) previous.remove();

          const script = document.createElement('script');
          script.id = HS_EMBED_SCRIPT_ID;
          script.src = HS_EMBED_SRC;
          script.onload = () => {
            rendered.forEach((frame) => frame.classList.add('hs-form-frame'));
          };
          document.head.appendChild(script);
        });
      }
    </script> <script>
      // Videos swapped in by the ClientRouter can arrive with resource
      // selection never run: readyState 0, empty currentSrc, networkState 3.
      // This is a Chromium quirk with media elements adopted from the fetched
      // document, so autoplay videos on a client-side navigation (e.g. back
      // to the homepage) never load or play. Explicitly re-running load()
      // restarts resource selection; play() resumes muted autoplay.
      if (!window.__bruceVideoRestartInitialized) {
        window.__bruceVideoRestartInitialized = true;

        document.addEventListener('astro:page-load', () => {
          document.querySelectorAll('video[src]').forEach((video) => {
            if (video.readyState === 0 && !video.currentSrc) {
              video.load();
            }
            if (video.autoplay && video.paused) {
              video.play().catch(() => {});
            }
          });
        });
      }
    </script> </body> </html> 