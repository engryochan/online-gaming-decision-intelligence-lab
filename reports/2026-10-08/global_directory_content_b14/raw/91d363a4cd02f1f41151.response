<div class="pt-[160px] md:pt-72 -mb-40 md:-mb-64 md:pb-5 px-6 md:px-20 overflow-auto" >
    <div class="news-bar group relative w-full  text-gray-700 py-1 border-0 border-b-[3px] border-blue-500 z-50 overflow-hidden rounded-sm text-sm" aria-label="Latest News">

        <div class="news-bar__content flex  whitespace-nowrap animate-scroll-left group-hover:animate-pause transform-gpu w-[200%]">
    
             
                
                
                    <span class="news-bar__item inline-block px-2 md:text-sm last:mr-2">
                        
                            <a href="https://sec.gov.ng/for-investors/keep-track-of-circulars/commencement-of-full-electronic-registration-e-registration-on-the-commissions-eportal/"
                                class="text-gray-200 hover:text-blue-500 hover:underline transition-colors duration-200 ease-in-out"
                                target="_blank"  rel="noopener noreferrer">
