        </section>
        
        <div class="px-6 sm:px-20 my-10 text-gray-700 min-w-full tracking-wide prose sm:prose-sm text-base">
            <p>
                As an investor, choosing the right Capital Market Operator (CMO) is essential for safeguarding your assets and maximizing returns.
                All CMOs in Nigeria are regulated and regularly supervised by the SEC, ensuring they meet the highest standards of professionalism,
                financial soundness and ethical conduct. Whether you need a broker, fund manager, investment adviser or any other market intermediary,
                you can verify their credentials, view their scope of services and confirm their redistration status in one place.
            </p>
            <h1 class="text-xl py-3">Disclaimer</h1>
            <p>
                While we strive to keep all records accurate and current, investors should all conduct their own due diligence and consult qualified professionals
                before making any investment decisions.
            </p>
        </div>
    </main>
    <script>
    // Global accordion function that persists across HTMX swaps
    function toggleAccordion(id) {
        const content = document.getElementById(id);
        const icon = document.getElementById('icon-' + id);
        
        // Close all other accordions
        document.querySelectorAll('[id^="operator-"]').forEach(function(item) {
            if (item.id !== id && !item.classList.contains('hidden')) {
                item.classList.add('hidden');
                const itemIcon = document.getElementById('icon-' + item.id);
                if (itemIcon) {
                    itemIcon.style.transform = 'rotate(0deg)';
                }
            }
        });
        
        // Toggle current accordion
        if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            icon.style.transform = 'rotate(180deg)';
        } else {
            content.classList.add('hidden');
            icon.style.transform = 'rotate(0deg)';
        }
    }
    </script>
    

