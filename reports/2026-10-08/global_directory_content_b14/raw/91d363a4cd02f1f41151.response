    <main class="pt-44 sm:pt-64">
        
        <section class="grid grid-cols-1 sm:grid-cols-2">
            <div class="sm:pt-16 px-6 sm:px-20 mb-8 sm:mb-0">
                <h1 class="text-3xl md:text-2xl tracking-normal sm:leading-snug text-blue-500 font-semibold uppercase">
                    Find
                    
                        <br />
                        a Registered Operator
                    
                </h1>
                
                    <p class="text-base sm:text-xl text-gray-500 max-w-prose tracking-normal whitespace-pre-line">
                        Verify all platforms! Prevent exploitation!

All Operators in Nigeria are required to register with the SEC before commencing operation. Verify the status of your platform here.
                    </p>
                
            </div>
            
                <figure class="w-full">
                    <picture><source srcset="/media/images/Find_a_Registered_Operator_j7jgZ.format-avif.width-1200_UphEUtv.avif 1200w, /media/images/Find_a_Registered_Operator_j7jgZ.format-avif.width-2160_R4EjyP1.avif 2160w" sizes="50vh" type="image/avif"><source srcset="/media/images/Find_a_Registered_Operator_j7jgZ.format-webp.width-1200_IeB8iEn.webp 1200w, /media/images/Find_a_Registered_Operator_j7jgZ.format-webp.width-2160_24KiOeg.webp 2160w" sizes="50vh" type="image/webp"><img alt="Find a Registered Operator" class="h-[50vh] max-h-[50vh] min-w-full object-cover bg-blue-50" height="400" loading="eager" sizes="50vh" src="/media/images/Find_a_Registered_Operator_j7jgZp.format-jpeg.width-1200_ChU8EzG.jpg" srcset="/media/images/Find_a_Registered_Operator_j7jgZp.format-jpeg.width-1200_ChU8EzG.jpg 1200w, /media/images/Find_a_Registered_Operator_j7jgZp.format-jpeg.width-2160_qu64gu0.jpg 2160w" width="1200"></picture>
                </figure>
            
        </section>
        

    <div class="my-10 flex flex-col sm:flex-row justify-center items-center gap-4 sm:gap-8">
        
            <a href="/fintech-and-innovation-hub-finport/registered-fintech-operators/"
