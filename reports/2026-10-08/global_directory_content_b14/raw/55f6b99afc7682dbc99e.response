\"ms-aspect-square ms-h-1 ms-rounded-full ms-bg-white ms-self-center\"}],[\"$\",\"div\",null,{\"className\":\"ms-body-s-sm lg:ms-body-s-lg ms-font-regular\",\"children\":\"September 25, 2026\"}]]]}]]}]]}]]}]}]}]]]}]}]}],[\"$\",\"$L42\",\"1\",{\"sectionNumber\":3,\"sectionName\":\"content\",\"children\":[\"$\",\"section\",null,{\"id\":\"container-b198670e78\",\"className\":\"section ms-bg-white ms-text-black\",\"data-test\":\"theme-container-v2\",\"children\":[\"$\",\"div\",null,{\"className\":\"section-wrapper ms-w-full ms-max-w-[1440px] ms-m-auto ms-relative\",\"children\":[[[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-10 lg:ms-pt-17-5  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline2-sm lg:ms-headline2-lg headline-2 ms-font-semibold\",\"children\":[\"Key findings\"]}]],\"\\n\"]}]}]}],[\"$\",\"div\",\"richtexteditor_910408237\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"ul\",null,{\"className\":\"ms-mt-4 ms-list-disc ms-pl-6 ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"li\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg ms-font-regular\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-l-sm lg:ms-body-l-lg ms-font-regular\",\"children\":[\"The MSCI Japan Index has outperformed the MSCI Kokusai (World ex Japan) Index by 16.4% since the start of 2025, coinciding with the 10-year Japanese government bond (JGB) yield reaching its highest level since 1996.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg ms-font-regular\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-l-sm lg:ms-body-l-lg ms-font-regular\",\"children\":[\"Higher yields have historically accompanied stronger Japanese equity returns (in USD) from 2000-2026. Yen depreciation has also supported local equity market returns, given the export-oriented nature of the Japanese economy.\"]}]]}],[\"$\",\"li\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg ms-font-regular\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-l-sm lg:ms-body-l-lg ms-font-regular\",\"children\":[\"For investors acting tactically on Japan exposure, the choice of index involves a trade-off between market coverage and liquidity.\"]}]]}]]}]]}]}]}],[\"$\",\"div\",\"spacer\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"id\":\"spacer\",\"className\":\"\"}]}],[\"$\",\"div\",\"richtexteditor_209255578\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"label-m\",\"children\":[\"Mentioned in this blog post:\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[[\"$\",\"$L45\",null,{\"href\":\"https://www.msci.com/indexes/index/939200/msci-japan-index\",\"label\":\"$undefined\",\"clickType\":\"link\",\"destination\":\"$undefined\",\"contextTitle\":\"$undefined\",\"blank\":false,\"className\":\"$undefined\",\"disableNextLink\":true,\"queryParams\":\"$undefined\",\"referralPageTracking\":false,\"role\":\"$undefined\",\"children\":[\"$\",\"span\",null,{\"className\":\"ms-link-label-sm lg:ms-link-label-lg ms-font-regular\",\"children\":[\"MSCI Japan Index\"]}]}],\" | \",[\"$\",\"$L45\",null,{\"href\":\"https://www.msci.com/indexes/index/991200/msci-kokusai-world-ex-japan-index\",\"label\":\"$undefined\",\"clickType\":\"link\",\"destination\":\"$undefined\",\"contextTitle\":\"$undefined\",\"blank\":false,\"className\":\"$undefined\",\"disableNextLink\":true,\"queryParams\":\"$undefined\",\"referralPageTracking\":false,\"role\":\"$undefined\",\"children\":[\"$\",\"span\",null,{\"className\":\"ms-link-label-sm lg:ms-link-label-lg ms-font-regular\",\"children\":[\"MSCI Kokusai (World ex Japan) Index\"]}]}],\" | \",[\"$\",\"$L45\",null,{\"href\":\"https://www.msci.com/indexes/index/664171/msci-japan-imi-index\",\"label\":\"$undefined\",\"clickType\":\"link\",\"destination\":\"$undefined\",\"contextTitle\":\"$undefined\",\"blank\":false,\"className\":\"$undefined\",\"disableNextLink\":true,\"queryParams\":\"$undefined\",\"referralPageTracking\":false,\"role\":\"$undefined\",\"children\":[\"$\",\"span\",null,{\"className\":\"ms-link-label-sm lg:ms-link-label-lg ms-font-regular\",\"children\":[\"MSCI Japan IMI Index\"]}]}]]}]]}],\"\\n\"]}]}]}],[\"$\",\"div\",\"spacer_copy\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"div\",null,{\"id\":\"spacer\",\"className\":\"ms-block ms-w-full ms-border-b-thin ms-border-gray-300\"}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"MSCI Japan had a similar return profile to MSCI Kokusai between 2001 and 2008, then underperformed by 58.4% cumulatively from December 2008, bottoming out in January 2025. It has since outperformed by 16.4% (gross USD returns). The reversal came against a backdrop of significant changes in Japan's macroeconomic environment as well as corporate behavior. The Bank of Japan abandoned yield curve control in 2024 and ended negative rates, closing out three decades of near-zero policy rates. The Tokyo Stock Exchange's initiative encouraging listed companies to improve capital efficiency and market valuations accelerated a shift in corporate behavior, visible in rising payouts.\",[\"$\",\"sup\",null,{\"className\":\"$undefined\",\"children\":[\"1\"]}]]}]]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"Our analysis examines the macro conditions supporting a tactical allocation to Japan and the differentiated exposure it may offer.\"]}]]}],\"\\n\",[[\"$\",\"span\",null,{\"className\":\"ms-headline2-sm lg:ms-headline2-lg headline-2 ms-font-semibold\",\"children\":[\"Higher yields have come with stronger equity returns\"]}]],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"The 10-year JGB yield stands at 2.94% as of August 2026, its highest level since September 1996, and the Bank of Japan's policy rate of 1.25% now sits at its highest since 1995.\",[\"$\",\"sup\",null,{\"className\":\"$undefined\",\"children\":[\"2\"]}],\" The OECD projects the rate reaching 2% by the end of 2027, citing higher inflation expectations, solid nominal wage growth and the closing of the output gap.\",[\"$\",\"sup\",null,{\"className\":\"$undefined\",\"children\":[\"3\"]}],\" A higher yield in Japan may signal stronger nominal growth and corporate pricing power. Japanese financials, which account for roughly 19% of the index, have been among the biggest beneficiaries, earning wider net interest margins as rates normalize.\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"We tested the relationship between yield changes and Japanese equity returns historically by bucketing monthly USD returns into quintiles based on the change in the 10-year JGB yield. The pattern is fairly monotonic. The lowest quintile, when yields fell most, averaged -0.9%, while the highest averaged 1.5%.\"]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor_title\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline3-sm lg:ms-headline3-lg headline-3 ms-font-semibold\",\"children\":[\"Japanese equity returns have risen with the size of yield increases\"]}]],\"\\n\"]}]}]}],[\"$\",\"div\",\"image\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L4f\",null,{\"main\":\"$L50\",\"mobile\":\"$L51\"}]}],[\"$\",\"div\",\"richtexteditor_caption\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-text-gray-700 ms-body-s-sm lg:ms-body-s-lg ms-font-regular\",\"children\":[[\"$\",\"i\",null,{\"className\":\"$undefined\",\"children\":[\"Time period: January 2000 to July 2026. Average monthly gross returns in USD for MSCI Japan Index, bucketed by the contemporaneous monthly change in the 10-year JGB yield. Q1 represents the largest declines and Q5 the largest increases.\"]}]]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline2-sm lg:ms-headline2-lg headline-2 ms-font-semibold\",\"children\":[\"A different economic footprint\"]}]],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"Japanese firms derive 56.8% of revenue from outside Japan, against 48.2% for the MSCI Kokusai Index using \",[\"$\",\"$L45\",null,{\"href\":\"/research-and-insights/paper/economic-exposure-in-global-investing\",\"label\":\"$undefined\",\"clickType\":\"link\",\"destination\":\"$undefined\",\"contextTitle\":\"$undefined\",\"blank\":false,\"className\":\"$undefined\",\"disableNextLink\":false,\"queryParams\":\"$undefined\",\"referralPageTracking\":false,\"role\":\"$undefined\",\"children\":[\"$\",\"span\",null,{\"className\":\"ms-link-label-sm lg:ms-link-label-lg ms-font-regular\",\"children\":[\"MSCI Economic Exposure\"]}]}],\" data.\",[\"$\",\"sup\",null,{\"className\":\"$undefined\",\"children\":[\"4\"]}],\" The export-oriented nature of the Japanese economy makes yen weakness a key return driver. A quintile analysis based on how far the yen sits from its 36-month average shows strong returns in the two weakest quintiles and negative returns in the two strongest.\"]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor_title\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline3-sm lg:ms-headline3-lg headline-3 ms-font-semibold\",\"children\":[\"A weak yen has been a supportive backdrop for Japanese equities\"]}]],\"\\n\"]}]}]}],[\"$\",\"div\",\"image\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L4f\",null,{\"main\":\"$L52\",\"mobile\":\"$L53\"}]}],[\"$\",\"div\",\"richtexteditor_caption\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-text-gray-700 ms-body-s-sm lg:ms-body-s-lg ms-font-regular\",\"children\":[[\"$\",\"i\",null,{\"className\":\"$undefined\",\"children\":[\"Time period: January 2000 to August 2026. Average monthly gross returns in JPY for the MSCI Japan Index, bucketed by a z-score calculated as the deviation of USD/JPY spot from its trailing 36-month mean in standard deviations.\"]}]]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline2-sm lg:ms-headline2-lg headline-2 ms-font-semibold\",\"children\":[\"Japanese markets offered a differentiated industry exposure from the rest of developed markets\"]}]],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"Japan's sector mix — as defined by the Global Industry Classification Standard (GICS®)\",[\"$\",\"sup\",null,{\"className\":\"$undefined\",\"children\":[\"5\"]}],\" — diverges from those of MSCI Kokusai. Although industrials, financials and information technology are the three largest sectors in both the MSCI Japan and MSCI Kokusai indexes, their relative importance is very different. Industrials are the largest sector in Japan at roughly 25% of the index, more than twice their 10% weight in Kokusai. Conversely, information technology accounts for around 18% of Japan, compared with more than 30% of Kokusai.\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"The industry composition within each sector differs markedly between the two indexes. Financials has a similar weight in both, yet banks account for almost two-thirds of Japan's financial sector, compared with less than half in Kokusai. Semiconductors and semiconductor equipment represent around half of information technology in both markets, but Japan has relatively more technology hardware and less software and services. The differences within industrials are also notable: Japan has greater representation in machinery, trading companies and industrial conglomerates, while aerospace and defense is more prominent in Kokusai.\"]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor_title\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline3-sm lg:ms-headline3-lg headline-3 ms-font-semibold\",\"children\":[\"Japan's weights are concentrated in different industries\"]}]],\"\\n\"]}]}]}],[\"$\",\"div\",\"vegaembedchart\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L54\",null,{\"version\":\"msci-vega@5-v2.0.0\",\"jsonConfigPath\":\"/assets/web/msci-com/research-and-insights/blog-post/reassessing-the-case-for-japanese-equities/exhibits/Industries_japan_kokusai-3.json\"}]}],[\"$\",\"div\",\"richtexteditor_caption\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-text-gray-700 ms-body-s-sm lg:ms-body-s-lg ms-font-regular\",\"children\":[[\"$\",\"i\",null,{\"className\":\"$undefined\",\"children\":[\"The plot shows the industry weights within each of the GICS sectors for MSCI Japan and MSCI Kokusai (World ex Japan) Index as of Aug. 31, 2026.\"]}]]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"Much of Japan's semiconductor equipment, robotics and precision component exposure sits under industrials rather than information technology, so a sector view understates how much of Japan is linked to the technology cycle. On a revenue basis, exposure to the \",[\"$\",\"$L45\",null,{\"href\":\"/research-and-insights/blog-post/mapping-ai-exposure-across-global-markets\",\"label\":\"$undefined\",\"clickType\":\"link\",\"destination\":\"$undefined\",\"contextTitle\":\"$undefined\",\"blank\":false,\"className\":\"$undefined\",\"disableNextLink\":false,\"queryParams\":\"$undefined\",\"referralPageTracking\":false,\"role\":\"$undefined\",\"children\":[\"$\",\"span\",null,{\"className\":\"ms-link-label-sm lg:ms-link-label-lg ms-font-regular\",\"children\":[\"MSCI AI value-chain\"]}]}],\" exceeds 7%, below the U.S. but above Europe, spanning physical AI infrastructure, digital AI infrastructure and applications.\"]}]]}],\"\\n\",[[\"$\",\"span\",null,{\"className\":\"ms-headline2-sm lg:ms-headline2-lg headline-2 ms-font-semibold\",\"children\":[\"Fundamentals: improving, but the relative picture is mixed\"]}]],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"Japan's corporate fundamentals send mixed signals. Dividend payouts have increased while the profitability gap with the rest of the developed world has widened. MSCI Japan yielded 50 to 150 basis points (bps) less than MSCI Kokusai for two decades until 2019. Since then, Japan has yielded more: around 25 bps as of August 2026.\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"MSCI Japan traded at a forward earnings premium to MSCI Kokusai until roughly 2013 and at a discount since. The discount has narrowed over the past year to -2.3. The price-to-book discount has gone the other way, reaching its widest reading of -2.3 in the series.\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"Japan's return on equity has improved in absolute terms, from around 9% to roughly 12%, but Kokusai's has risen faster based on margin expansion among the largest U.S. technology companies.\"]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor_title\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline3-sm lg:ms-headline3-lg headline-3 ms-font-semibold\",\"children\":[\"Japan's payout has improved while its profitability gap has widened\"]}]],\"\\n\"]}]}]}],[\"$\",\"div\",\"image\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L4f\",null,{\"main\":\"$L55\",\"mobile\":\"$L56\"}]}],[\"$\",\"div\",\"richtexteditor_caption\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-text-gray-700 ms-body-s-sm lg:ms-body-s-lg ms-font-regular\",\"children\":[[\"$\",\"i\",null,{\"className\":\"$undefined\",\"children\":[\"Time period: December 1998 to August 2026. The spread for each metric is calculated as the difference in metric values, MSCI Japan Index less MSCI Kokusai Index (World ex Japan), on each date.\"]}]]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline2-sm lg:ms-headline2-lg headline-2 ms-font-semibold\",\"children\":[\"Indexes to manage Japanese equity exposures\"]}]],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"Investors can choose from a range of underlying indexes to express their investment strategy and asset allocation decisions for the broader Japanese market. Over the long term, the MSCI Japan IMI™ Index has outperformed MSCI Japan, highlighting the value in looking beyond large- and mid-cap companies when considering broad Japanese equity-market exposure. The extent to which investors reach into the small-cap segment, however, varies across indexes.\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"MSCI Japan covers large- and mid-cap companies, while MSCI Japan IMI includes small-cap companies as well and is built to represent 99% of the investable market, so its number of constituents moves with the market itself. The MSCI Japan Select 700 Index currently sits between the two, reaching into small caps but with a fixed number of constituents.\"]}]]}],\"\\n\",[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"The differences in coverage have not translated into large differences in historical risk and return. On tradability, the Japan Select index resembles MSCI Japan. Assuming USD 10 billion in assets, the maximum days to trade for Japan Select 700 is 5.8 — the same as MSCI Japan — against 8.1 for Japan IMI.\"]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor_title\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[[\"$\",\"span\",null,{\"className\":\"ms-headline3-sm lg:ms-headline3-lg headline-3 ms-font-semibold\",\"children\":[\"Japan Select 700 expands market coverage while maintaining similar liquidity to MSCI Japan\"]}]],\"\\n\"]}]}]}],[\"$\",\"div\",\"image\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 ms-pb-10\",\"children\":[\"$\",\"$L4f\",null,{\"main\":\"$L57\",\"mobile\":\"$L58\"}]}],[\"$\",\"div\",\"richtexteditor_caption\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-text-gray-700 ms-body-s-sm lg:ms-body-s-lg ms-font-regular\",\"children\":[[\"$\",\"i\",null,{\"className\":\"$undefined\",\"children\":[\"Return and risk: Dec. 31, 1998 – Aug. 31, 2026, gross returns, annualized in USD. Number of constituents and top 10 weight as of Aug. 31, 2026. Maximum days to trade relative to cash, USD 10 billion, 20% ADV. Overlap constituents with IMI (%) is the number of constituents an index shares with MSCI Japan IMI, expressed as a percentage of MSCI Japan IMI constituents.\"]}]]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\",\"className\":\"section-item ms-mx-5 lg:ms-mx-17-5  ms-pt-0  ms-pb-10\",\"children\":[\"$\",\"div\",null,{\"data-testid\":\"columns-wrapper\",\"className\":\"\",\"children\":[[\"$\",\"$4e\",\"0\",{\"children\":[\"$\",\"div\",null,{\"className\":\"aem-Grid aem-Grid--12 aem-Grid--default--12\",\"children\":[[\"$\",\"div\",\"richtexteditor\",{\"className\":\"aem-GridColumn aem-GridColumn--default--12 \",\"children\":[\"$\",\"$L42\",null,{\"componentName\":\"rich text editor\",\"children\":[\"$\",\"div\",null,{\"className\":\"ms-flex ms-flex-col ms-gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"$undefined\",\"children\":[[\"$\",\"span\",null,{\"className\":\"ms-body-article-sm lg:ms-body-article-lg body-article ms-font-regular\",\"children\":[\"For higher-frequency changes in tactical allocation or hedging effected through index futures, the liquidity of the underlying basket is core to determining how quickly, and at what cost, an investor's position can be built or unwound. The macro case for Japan remains intact; which index an investor uses to express it is now the more relevant decision.\"]}]]}],\"\\n\"]}]}]}]]}]}]]}]}],[\"$\",\"div\",null,{\"id\":\"$undefined\