ref":"#rules","icon":"MoveRightIcon","type":"link","children":[{"text":"Exchange Rulebooks"}]},{},{"type":"line-break","children":[{}]},{},{"href":"/regulation/rule-filings","icon":"MoveRightIcon","type":"link","children":[{"text":"Rule Filings"}]},{},{"type":"line-break","children":[{}]},{},{"href":"https://nyse.wolterskluwer.cloud/listed-company-manual","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"NYSE Listed Company Manual"}]},{}]},{"type":"div","children":[{},{"href":"https://nyseamerican.wolterskluwer.cloud/company-guide","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"NYSE American Company Guide"}]},{}]},{"type":"div","children":[{},{"href":"https://nysearcaguide.srorules.com/rules","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"NYSE Arca Rules"}]},{}]},{"type":"div","children":[{},{"href":"/regulation/noncompliant-issuers","icon":"MoveRightIcon","type":"link","children":[{"text":"Noncompliant Issuers"}]},{}]},{"type":"div","children":[{},{"href":"/listing-manager-support","icon":"MoveRightIcon","type":"link","children":[{"text":"Listing Manager Support"}]},{}]}]}]},"layout":{"default":{"bg":"white","bgOpacity":100,"bw":2,"bc":"transparent","isUniformPadding":true}}}]},"accent":"double","border":true,"padding":true},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"f93672ad-01f2-422c-b1f1-195df286f8ac","name":"cms-component-accent","props":{"slots":{"accent":[{"id":"4326e4c7-bd8b-4e28-8977-d739a6cc61c8","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h4","children":[{"text":"Regulatory Highlights"}],"isHeadingAutoSizeEnabled":false},{"type":"div","children":[{}]},{"type":"spacer","children":[{}]},{"type":"div","children":[{},{"href":"https://www.nyse.com/publicdocs/nyse/markets/nyse/rule-interpretations/2026/Broker-Dealer_Member_Annual_Compliance_Memo.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"2026 Broker-Dealer Member Annual Compliance Memo"}]},{}]},{"type":"div","children":[{},{"href":"https://www.nyse.com/publicdocs/nyse/markets/nyse/NYSE_2026_Annual_Guidance_Letter.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"2026 Listed Company Compliance Guidance for NYSE Issuers"}]},{}]},{"type":"div","children":[{},{"href":"https://www.nyse.com/publicdocs/nyse/markets/nyse-american/NYSE_American_2026_Annual_Guidance_Letter.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"2026 Listed Company Compliance Guidance for NYSE American Issuers"}]},{}]},{"type":"div","children":[{},{"href":"https://www.nyse.com/publicdocs/nyse/regulation/nyse-arca/NYSE_Arca_Listed_ETP_Compliance_Guidance_Letter.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"2026 Compliance Guidance Letter for Listed ETP Issuers"}]},{}]},{"type":"paragraph","children":[{}]},{"type":"paragraph","children":[{}]}]},"layout":{"default":{"bg":"","bw":0,"bc":"transparent","isUniformPadding":true},"xl":{"pt":0,"pb":0}}}]},"accent":"double","border":true,"padding":true},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"16cabc19-7459-42f3-b18a-9340ae932234","name":"cms-component-accent","props":{"slots":{"accent":[{"id":"0e64a551-aaf2-44ca-9033-305a6ce3dd7b","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"h4","children":[{"text":"Extended Hours Trading"}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{},{"href":"/extended-hours-trading","icon":"MoveRightIcon","type":"link","children":[{"text":"NYSE Extended Hours Trading"}]},{},{"href":"/publicdocs/nyse/NYSE_Extended_Hours_Trading_FAQ.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{},{"type":"line-break","children":[{}]},{"text":"Frequently Asked Questions"}]},{},{"href":"/publicdocs/nyse/NYSE_Arca_Corporate_Action_Halt_FAQ.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{},{"type":"line-break","children":[{}]},{"text":"Corporate Actions FAQs"}]},{}]}]}}]},"accent":"double","border":true,"padding":true,"accentColor":"ice-blue"},"layout":{"default":{"pb":5},"xl":{"pb":10}}}],"d3fbcbb5-5504-4c53-97ec-a69a22967bfa":[{"id":"c0951032-1a48-413e-9a74-1983c8a98673","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{}]},{"type":"hr","color":"black","variant":"solid","children":[{}],"topSpacing":false},{"type":"div","children":[{"text":" "}]},{"type":"paragraph","children":[{"text":"To protect investors and the integrity of the NYSE Exchange equities and options markets, NYSE Regulation implements and enforces the rules of the NYSE Exchanges and applicable federal securities laws with respect to both listed companies and broker-dealer member firms. To fulfill its duties, NYSE Regulation has an Issuer Regulation program and a Market Regulation program.  NYSE Regulation executes its mandate independently and is led by a Chief Regulatory Officer. "}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"b0f6dd6e-0baf-430a-84ba-5788eddd2091","name":"cms-component-tabs-2022","props":{"slots":{"3d441d73-0bfd-414f-b231-c0e88c0a6e24":[{"id":"99a1514c-eae5-4732-9e66-66d4511e6072","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{"text":"The Market Regulation team is responsible for enforcing compliance with the rules of the NYSE Exchanges as well as applicable federal securities laws by member firms and their associated persons.  Where misconduct occurs, the Market Regulation team has the authority to prosecute and discipline members through the imposition of censures, fines and other sanctions. "}]},{"type":"unordered-list","children":[{"type":"list-item","children":[{"bold":true,"text":"The Surveillance and Investigations (“S&I”) group"},{"text":" surveils and preliminarily investigates members for potential market and trading related violations.  S&I can issue informal disciplinary actions to members and their associated persons for their violations, such as Cautionary Action or Minor Rule Violation Letters."}]},{"type":"list-item","children":[{"bold":true,"text":"The Enforcement group"},{"text":" investigates potentially violative conduct that may merit formal disciplinary action.  When appropriate, Enforcement will take formal disciplinary action through either settlements (i.e., AWCs) or litigated proceedings, all of which are public.  Litigated matters may proceed to a contested hearing before FINRA’s Office of Hearing Officers (OHO), which hears the matter and issues a decision. "}]}]},{"type":"paragraph","children":[{}]},{"type":"paragraph","children":[{"text":"Market Regulation also oversees the work that FINRA conducts on behalf of the NYSE Exchanges pursuant to Regulatory Services Agreements (RSAs).  These matters are regularly brought as cross-market actions on behalf of multiple self-regulatory organizations, sometimes including FINRA."}]}]},"layout":{"default":{"pt":5,"pb":5},"xl":{"pb":10}}},{"id":"d3744872-ba28-4982-98f7-25fcf81fc1d2","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{}]},{"type":"hr","variant":"solid","children":[{}]},{"type":"div","children":[{}]},{"type":"div","children":[{},{"id":"rules","href":"#rules","icon":"MoveRightIcon","type":"link","children":[{"text":"Rules"}]},{}]},{"type":"div","children":[{"text":"As a registered securities exchange, NYSE is subject to the regulatory oversight of the SEC and all rules and amendments must be filed with and approved by the SEC pursuant to Section 19(b) of the Securities and Exchange Act of 1934 and Rule 19b-4 thereunder."}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"022a726a-e269-4487-8256-1b91e8827e8f","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{},{"href":"/regulation/rule-filings","icon":"MoveRightIcon","type":"link","children":[{"text":"Rule Filings"}]},{}]},{"type":"div","children":[{"text":"All outstanding proposed rule changes, called 19b-4 filings, filed by NYSE with the SEC. 19b-4 filings relate to proposed changes to the NYSE Rules and federal securities laws."}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"159b372e-b58c-43fb-8878-221b94a9ab64","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{},{"href":"/regulation/rule-interpretations","icon":"MoveRightIcon","type":"link","children":[{"text":"Rule Interpretations and Guidance"}]},{}]},{"type":"div","children":[{"text":"NYSE Exchanges periodically issues interpretive guidance related to SEC and exchange rules. This guidance includes Information Memoranda, Weekly Bulletins, Rule Adoption Notices, Rule Interpretations, Rule Changes, Education Bulletins, and Regulatory Bulletins."}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"6c340f4d-55ec-4c03-946f-91e5b4a1e8cd","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{},{"href":"/regulation/disciplinary-actions","icon":"MoveRightIcon","type":"link","children":[{"text":"Disciplinary Actions"}]},{}]},{"type":"div","children":[{"text":"Disciplinary Actions stem from a variety of sources that include internal referrals, investor complaints, examinations of member organizations, and referrals from the SEC."}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"01278cdb-7441-4327-a65a-02862c7e51df","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{},{"href":"/regulation/regulation-sho","icon":"MoveRightIcon","type":"link","children":[{"text":"Regulation SHO"}]},{}]},{"type":"paragraph","children":[{"text":"Guidance and list of threshold securities for every settlement day."}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"9c191da6-5044-4dd8-bf2a-a5a8a63b961d","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{},{"href":"/regulation/governing-documents-related-information-nms-plans","icon":"MoveRightIcon","type":"link","children":[{"text":"Governing Documents, Related Information, and Regulation NMS Plans"}]},{}]},{"type":"paragraph","children":[{"text":"Governing documents of NYSE Holdings LLC and its subsidiaries and applicable NMS Plans of which NYSE securities exchanges are members, along with related information."}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"996dc760-0544-446a-8b8f-758255ce4fac","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{},{"href":"/regulation/rules-other","icon":"MoveRightIcon","type":"link","children":[{"text":"Other Rule Filings Incorporated By Reference"}]},{}]},{"type":"div","children":[{"text":"Proposals and approvals to amend rules incorporated by reference from the rulebooks of other SROs."},{"href":"/regulation/rules/other","type":"link","children":[{}]},{}]}]},"layout":{"default":{"pb":5},"xl":{"pb":10}}},{"id":"17b9502d-df85-4bbb-99c2-adb7dec2fe96","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{},{"href":"#forms","icon":"MoveRightIcon","type":"link","children":[{"text":"Forms"}]},{}]},{"type":"div","children":[{"text":"View exchange related forms."}]}]}}],"9f939ff7-70e8-4e4d-862b-1bc7efcb3153":[{"id":"96bb47b9-42df-4e49-b96f-ce5368a0941d","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{"text":"The integrity of the NYSE Exchanges is dependent on the fair application of initial and continued listing standards.  The Issuer Regulation team is responsible for, among other things, reviewing and approving companies applying to list securities on the NYSE Exchanges, and monitoring and enforcing compliance with ongoing listing standards and requirements."}]},{"type":"unordered-list","children":[{"type":"list-item","children":[{"bold":true,"text":"The Initial Listings & ETPs group"},{"text":" determines prospective companies’ eligibility for listing, reviews company and ETP applications, authorizes options listings, and monitors ETPs and options to ensure ongoing compliance with the listing standards of the relevant NYSE Exchange."}]},{"type":"list-item","children":[{"bold":true,"text":"The Continued Listing group"},{"text":" monitors and enforces quantitative, qualitative and timely filing requirements of companies listed on the NYSE Exchanges, and initiates suspensions and delistings for companies that are noncompliant or no longer suitable for continued listing."}]},{"type":"list-item","children":[{"bold":true,"text":"The Market Watch and Corporate Actions group"},{"text":" ensures that listed companies adhere to the timely alert policies of the NYSE Exchanges, including for material news releases, and processes corporate actions (e.g., mergers, redemptions, spinoffs, stock splits)."}]}]}]},"layout":{"default":{"pt":5},"xl":{"pt":0}}},{"id":"c7b16100-d9cd-4481-98aa-17a633be0417","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"div","children":[{}]},{"type":"hr","variant":"solid","children":[{}]},{"type":"h4","children":[{"text":"Issuer Regulation Groups"}]},{"type":"h4","children":[{}]},{"type":"spacer","children":[{}]},{"type":"div","children":[{},{"href":"/regulation/initial-listings","icon":"MoveRightIcon","type":"link","children":[{"text":"Initial Listings"}]},{}]},{"type":"div","children":[{"text":"For companies seeking to list on an NYSE Exchange."}]},{"type":"spacer","children":[{}]},{"type":"div","children":[{},{"href":"/regulation/continued-listing","icon":"MoveRightIcon","type":"link","children":[{"text":"Continued Listing"}]},{}]},{"type":"div","children":[{"text":"Monitors listed issuers for ongoing compliance with quantitative and qualitative listing standards of the Exchange."}]},{"type":"spacer","children":[{}]},{"type":"div","children":[{},{"href":"/regulation/exchange-traded-products","icon":"MoveRightIcon","type":"link","children":[{"text":"Exchange Traded Products"}]},{}]},{"type":"paragraph","children":[{"text":"Oversees initial and continued listing of different types of Exchange Traded Products."}]},{"type":"div","children":[{},{"href":"/regulation/corporate-actions-market-watch-proxy-compliance","icon":"MoveRightIcon","type":"link","children":[{"text":"Corporate Actions, Market Watch & Proxy Compliance"}]},{}]},{"type":"div","children":[{"text":"Enforces NYSE's Timely Alert Policy, material news and proxy disclosure rules, and publishes daily corporate action events."}]}]},"layout":{"default":{"pt":5},"xl":{"pt":10}}}]},"tabs":[{"id":"9f939ff7-70e8-4e4d-862b-1bc7efcb3153","hash":"issuer-regulation","title":"Issuer Regulation"},{"id":"3d441d73-0bfd-414f-b231-c0e88c0a6e24","hash":"market-regulation","title":"Market Regulation"}],"layout":"responsive","tabSize":"large","isDefaultAccordionTabOpen":false},"layout":{"default":{"pb":10},"xl":{"pb":20}}}]},"gap":8,"rowCols":[{"id":"d3fbcbb5-5504-4c53-97ec-a69a22967bfa","gap":0,"flex":"2","advanced":{"basis":0}},{"id":"159d3e81-ee50-40e8-857a-af8489080cdb","gap":0,"flex":"1","advanced":{"basis":0}}],"columnBreakpoint":"xl","columnContentReverse":true},"layout":{"default":{},"xl":{}}},{"id":"23c3f056-86c0-4c5e-90b8-612f7c61ad49","name":"cms-component-belt","props":{"slots":{"content":[{"id":"9a346b7c-f28b-4dec-a621-e44ff718e082","name":"cms-component-belt","props":{"slots":{"content":[{"id":"2660fb27-8852-4add-a1fc-01af96ae839f","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"align","align":"center","children":[{"type":"h4","children":[{"text":"Complaints and Inquiries"}]},{"type":"paragraph","children":[{}]},{"type":"spacer","children":[{}]},{"type":"paragraph","children":[{"text":"NYSE Regulation welcomes information from investors and others who believe that a member firm or individual broker may have violated securities rules and regulations. "}]},{"type":"paragraph","children":[{"text":"If you would like to share any information with NYSE Regulation, you can do so by following the link below."}]},{"type":"paragraph","children":[{},{"href":"/regulation/complaints-and-inquiries","icon":"MoveRightIcon","type":"link","wide":true,"children":[{"text":"Contact us"}],"isButton":true,"linkColor":"white"},{}]}]}]},"layout":{"default":{"bg":"","isUniformPadding":true},"md":{"mb":10}}}]},"spacing":"normal"},"layout":{"default":{"bg":"black","text":"white","pt":8,"pb":8},"xl":{"pt":16,"pb":16}}}]},"reverse":true}},{"id":"bb08f197-1212-4a0c-98fe-78c6014d0c1e","name":"cms-component-modal","props":{"slots":{"content":[{"id":"2032bdfd-d680-46c2-9389-881c1fc78b94","name":"cms-component-rich-text","props":{"slots":{},"richTextNodes":[{"type":"paragraph","children":[{},{"href":"https://www.nyse.com/publicdocs/nyse/regulation/nyse/Market_Maker__Account_Disclosure_Form.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"Market Maker Account Disclosure Form"}],"noExtension":true},{}]},{"type":"paragraph","children":[{},{"href":"https://www.nyse.com/publicdocs/nyse/regulation/nyse-arca/NYSE_Arca_Notice_of_Material_Change_in_Financial_Condition_Form.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"NYSE Arca Notice of Material Change in Financial Condition Form"}],"noExtension":true},{}]},{"type":"paragraph","children":[{},{"href":"https://www.nyse.com/publicdocs/nyse/regulation/nyse-arca/NYSE_Arca_Financial_Arrangement_Disclosure_Form.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":"NYSE Arca Financial Arrangement Disclosure Form"}],"noExtension":true},{}]},{"type":"paragraph","children":[{},{"href":"https://www.nyse.com/publicdocs/nyse/regulation/nyse-arca/NYSE_Arca_Annual_Compliance_Acknowledgement_Form.pdf","icon":"MoveRightIcon","type":"link","target":"_blank","children":[{"text":