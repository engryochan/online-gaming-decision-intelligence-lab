<!DOCTYPE html><html lang="en" data-is-cms-page="true"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1"/><meta http-equiv="X-UA-Compatible" content="IE=edge"/><script>window.dataLayer=window.dataLayer||[];window.dataLayer.push({'gtm.start':new Date().getTime(),'event':'gtm.js'});</script><title>NYSE Regulation</title><link rel="stylesheet" href="https://static.nyse.com/cms/41.10.17/assets/nyse.css"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/hydrate.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/demos-DhThR4g2.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/date-fns@2-30-0/node_modules/date-fns/addYears/index-js-commonjs-es-import-wvD8i_oy.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/@theice-pushpop@3-5-0_@types-express@4-17-25/node_modules/@theice/pushpop/build/array/replace-BIxldC1J.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks/shared/utils/shouldUseProxy-Bv9cgI89.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks//var/opt/jenkins/workspace/ont-end-monorepo_release_2026-40/packages/website-components/build/components/feedback/Spinner-DWFnkFxu.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks/node_modules/-pnpm/react-router@6-30-4_react@18-3-1/node_modules/react-router/dist/index-js-commonjs-proxy-DScuS9fV.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/main-B_XpGw9E.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks/__generated__/components/meta-8QECb7rV.js"/><link rel="modulepreload" href="https://static.nyse.com/cms/41.10.17/chunks/shared/breadcrumb-context/BreadCrumbContext-Ciq78Fk2.js"/><link rel="modulepreload" href="https://s