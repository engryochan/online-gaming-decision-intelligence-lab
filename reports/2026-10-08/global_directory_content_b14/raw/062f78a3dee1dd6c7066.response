            <td width="65"><p class="fa fa-1x fa-color-rust fa-file-pdf">&nbsp;</p></td>
            <td width="90" style="vertical-align:bottom !important;"><a class="btn-blue small" href="/documents/practice_notes/PN03-JORC2021.pdf" target="_blank">Open</a></td>
        </tr>
