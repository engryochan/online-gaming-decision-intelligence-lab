    <div class="container">

        <div class="row">
            <div class="col-lg-9">
                    <div class="smbc-text-widget-rich-text rich-raw-text">
                        <div class="smbc_footnote"><div class="supcontent"><sup>1</sup></div><div class="content">Our services are provided by SMBC Nikko Securities America, Inc.</div></div>
                    </div>
