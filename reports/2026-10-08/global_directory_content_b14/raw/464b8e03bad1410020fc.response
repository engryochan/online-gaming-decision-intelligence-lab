    <div data-cmp-is="image" data-cmp-lazy data-cmp-src="/adobe/dynamicmedia/deliver/dm-aid--11830691-4872-4962-acbc-618a256a96c9/susan-lloyd-hurwitz-profile-1.png?quality=82&amp;preferwebp=true&amp;width={width}" data-cmp-widths="288,384,480,576,672,768,864,960,1056,1152,1248,1344" data-asset="/assets/macq/about/company/board-members/susan-lloyd-hurwitz-profile-1.png" data-title="Headshot of Susan Lloyd-Hurwitz" class="cmp-image" itemscope itemtype="http://schema.org/ImageObject">
        
