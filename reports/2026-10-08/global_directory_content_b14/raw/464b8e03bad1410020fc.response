    <div data-cmp-is="image" data-cmp-lazy data-cmp-src="/adobe/dynamicmedia/deliver/dm-aid--5efe8b46-13de-4198-8316-5fde934a7896/rebecca-mcgrath-profile.jpg?quality=82&amp;preferwebp=true&amp;width={width}" data-cmp-widths="288,384,480,576,672,768,864,960,1056,1152,1248,1344" data-asset="/assets/macq/about/company/board-members/rebecca-mcgrath-profile.jpg" data-title="Headshot of Rebecca J McGrath" class="cmp-image" itemscope itemtype="http://schema.org/ImageObject">
        
