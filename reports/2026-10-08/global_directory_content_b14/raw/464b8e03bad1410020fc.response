    <div data-cmp-is="image" data-cmp-lazy data-cmp-src="/adobe/dynamicmedia/deliver/dm-aid--e523ae4f-bb50-465c-8149-60ea10297c78/william-vereker.jpg?quality=82&amp;crop=9.1p,8.4p,90.6p,37.4p&amp;preferwebp=true&amp;width={width}" data-cmp-widths="288,384,480,576,672,768,864,960,1056,1152,1248,1344" data-asset="/assets/macq/about/company/board-profiles/william-vereker.jpg" data-title="Headshot of Mike Roche" class="cmp-image" itemscope itemtype="http://schema.org/ImageObject">
        
