    <div data-cmp-is="image" data-cmp-lazy data-cmp-src="/adobe/dynamicmedia/deliver/dm-aid--5dc04975-9bb0-4339-9cf0-5ab207ed2f3f/board-jillianbroadbent.jpg?quality=82&amp;preferwebp=true&amp;width={width}" data-cmp-widths="288,384,480,576,672,768,864,960,1056,1152,1248,1344" data-asset="/assets/macq/about/company/board-members/Board_JillianBroadbent.jpg" data-title="Headshot of Jillian Broadbent" class="cmp-image" itemscope itemtype="http://schema.org/ImageObject">
        
