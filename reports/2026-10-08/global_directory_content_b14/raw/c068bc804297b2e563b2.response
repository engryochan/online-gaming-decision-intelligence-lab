<td><i class="fa fa-file-pdf-o"></i> <a href="/public/files/Assets/Pages/files/SSX_Listing_Rules_-_15_February_2016(1).pdf" target="blank"><i class="fa fa-download"></i></a></td>
</tr>
<tr>
<td>14/12/2015</td>
<td>Listing Rules effective from 14 December&nbsp;2015</td>
<td><i class="fa fa-file-pdf-o"></i> <a href="/public/files/Assets/Pages/files/APX_Listing_Rules_-_14_December_2015.pdf" target="blank"><i class="fa fa-download"></i></a></td>
</tr>
<tr>
<td>12/01/2015</td>
<td>Listing Rules effective from 12 January&nbsp;2015</td>
<td><i class="fa fa-file-pdf-o"></i> <a href="/public/files/Assets/Pages/files/APX_Listing_Rules_-_12_January_2015.pdf" target="blank"><i class="fa fa-download"></i></a></td>
</tr>
