                  <div class="fee-row-label">Stamp Duty</div>
                  <div class="fee-row-values">
                     <div class="fee-row-value"><span class="fee-row-side">Buy Side</span><strong>Exempt</strong></div>
                     <div class="fee-row-value"><span class="fee-row-side">Sell Side</span><strong>N/A</strong></div>
                  </div>
