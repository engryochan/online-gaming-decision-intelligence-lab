<script nonce="TX1clAQ0E2zqmCr1lv7qfg==">
document.addEventListener('DOMContentLoaded', function () {
    const canvas = document.getElementById('heroIndexChart');
    const changeEl = document.getElementById('heroIndexChange');
    const labels = window.chartLabels || [];
    const values = window.chartValues || [];
    if (!canvas || !values.length) return;
    const now = values[values.length - 1];
    const monthAgo = values.length >= 30 ? values[values.length - 30] : values[0];
    const diff = now - monthAgo;
    const pct = monthAgo ? ((diff / monthAgo) * 100).toFixed(2) : null;
    if (pct !== null && changeEl) {
        const up = diff >= 0;
        changeEl.textContent = (up ? '+' : '') + pct + '%';
        changeEl.classList.add(up ? 'hic-change--up' : 'hic-change--down');
    }
    const oneYearAgo = new Date();
    oneYearAgo.setFullYear(oneYearAgo.getFullYear() - 1);
    let startIdx = 0;
    for (let i = 0; i < labels.length; i++) {
        if (new Date(labels[i]) >= oneYearAgo) { startIdx = i; break; }
    }
    const slicedLabels = labels.slice(startIdx);
    const slicedValues = values.slice(startIdx);
    const ctx = canvas.getContext('2d');
    const grad = ctx.createLinearGradient(0, 0, 0, 120);
    grad.addColorStop(0, 'rgba(255,255,255,0.18)');
    grad.addColorStop(1, 'rgba(255,255,255,0.0)');
    new Chart(ctx, {
        type: 'line',
        data: { labels: slicedLabels, datasets: [{ data: slicedValues, borderColor: 'rgba(255,255,255,0.85)', backgroundColor: grad, borderWidth: 1.5, fill: true, tension: 0.35, pointRadius: 0, pointHoverRadius: 0 }] },
        options: {
            responsive: true, maintainAspectRatio: false, animation: { duration: 800 },
            scales: {
                x: { display: true, grid: { display: false, drawBorder: false }, border: { display: false }, ticks: { color: 'rgba(255,255,255,0.3)', font: { size: 9, weight: '600', family: 'Inter, sans-serif' }, maxRotation: 0, autoSkip: false, callback: function(val, idx) { const raw = slicedLabels[idx]; if (!raw) return null; const d = new Date(raw); if (isNaN(d)) return null; const prev = idx > 0 ? new Date(slicedLabels[idx - 1]) : null; if (!prev || d.getMonth() !== prev.getMonth()) { return d.toLocaleDateString('en-GB', { month: 'short' }); } return null; } } },
                y: { display: false }
            },
            plugins: { legend: { display: false }, tooltip: { enabled: false } }
        }
    });
});
</script>


   
      
<section class="inv-how-section" id="how-it-works">
   <div class="inv-how-container">
      <div class="inv-how-header" data-aos="fade-up" data-aos-duration="900">
         <span class="section-label">THE PROCESS</span>
         <h2>How it works</h2>
         <p>JP Jenkins gives private companies a simple, regulated way to create shareholder liquidity without going public.</p>
      </div>
      <ol class="hiw-journey">
         
         <li class="hiw-step" data-aos="fade-up" data-aos-duration="600" data-aos-delay="00">
            <div class="hiw-step-node" aria-hidden="true"><span>01</span></div>
            <div class="hiw-step-body">
               <h3>List your company</h3>
               <p class="hiw-step-sub">We onboard your business quickly and cleanly:</p>
               <p>Company and shareholder review</p><p>Set up your trading model (Private Market or Matched Bargain Facility)</p><p>Connect your registrar or cap-table platform</p><p>Create your public company page</p>
            </div>
         </li>
         
         <li class="hiw-step" data-aos="fade-up" data-aos-duration="600" data-aos-delay="10">
            <div class="hiw-step-node" aria-hidden="true"><span>02</span></div>
            <div class="hiw-step-body">
               <h3>Investors Trade Through Their Brokers</h3>
               
               <p>Investors access JP Jenkins via their existing brokers.</p><p>Brokers route orders straight into our matching engine</p>
            </div>
         </li>
         
         <li class="hiw-step" data-aos="fade-up" data-aos-duration="600" data-aos-delay="20">
            <div class="hiw-step-node" aria-hidden="true"><span>03</span></div>
            <div class="hiw-step-body">
               <h3>Trades Match on Our Venue</h3>
               <p class="hiw-step-sub">Our in-house system powers:</p>
               <p>Auction-style trading</p><p>Matched-bargain trades</p><p>Clear pricing</p><p>Volatility controls</p>
            </div>
         </li>
         
         <li class="hiw-step" data-aos="fade-up" data-aos-duration="600" data-aos-delay="30">
            <div class="hiw-step-node" aria-hidden="true"><span>04</span></div>
            <div class="hiw-step-body">
               <h3>Settlement Flows Through CREST</h3>
               <p class="hiw-step-sub">Once trades match, settlement happens via CREST on T+2:</p>
               <p>Brokers move cash and shares</p><p>Investors receive stock through their usual accounts</p><p>Your shareholder register updates automatically</p>
            </div>
         </li>
         
         <li class="hiw-step" data-aos="fade-up" data-aos-duration="600" data-aos-delay="40">
            <div class="hiw-step-node" aria-hidden="true"><span>05</span></div>
            <div class="hiw-step-body">
               <h3>Your Data Reaches the Market</h3>
               <p class="hiw-step-sub">Prices, trades and disclosures flow to:</p>
               <p>Brokers &amp; wealth managers</p><p>Data vendors</p><p>Investor platforms</p><p>Cap-table systems like Ledgy and Registrars</p>
            </div>
         </li>
         
         <li class="hiw-step" data-aos="fade-up" data-aos-duration="600" data-aos-delay="50">
            <div class="hiw-step-node" aria-hidden="true"><span>06</span></div>
            <div class="hiw-step-body">
               <h3>You Stay in Control</h3>
               <p class="hiw-step-sub">You decide:</p>
               <p>When trading happens</p><p>How often liquidity is offered</p><p>How much you disclose</p><p>Who can participate</p>
            </div>
         </li>
         
      </ol>
   </div>
</section>

   
      
<section class="pricing-section band-section" id="pricing">
   <div class="band-body">
   <div class="pricing-inner">
      <div class="pricing-section-header" data-aos="fade-up" data-aos-duration="900">
         <span class="section-label">PLANS AND PRICING</span>
         <h2>Transaction Pricing</h2>
      </div>
      <div class="pricing-card-wrap" data-aos="fade-up" data-aos-duration="900" data-aos-delay="80">
         <div class="pricing-side">
            <img src="/static/images/london-financial-district.0dfde60a654b.jpg" alt="" class="pricing-side-bg active" data-bg="pisces">
            <img src="/static/images/london-landscape.4b246eb1c5f4.jpg" alt="" class="pricing-side-bg" data-bg="mbf">
            <div class="pricing-side-fade"></div>
            <span class="pricing-side-label">Choose a market</span>
            <div class="pricing-tabs">
               <button class="pricing-tab active" data-tab="pisces"><i class="fas fa-building-columns"></i> <span>Private Market (PISCES)</span></button>
               <button class="pricing-tab" data-tab="mbf"><i class="fas fa-handshake"></i> <span>Matched Bargain Facility</span></button>
            </div>
            <div class="pricing-highlight">
               <i class="fas fa-circle-check"></i>
               <p>No subscription or membership fees &mdash; you only pay when a trade settles.</p>
            </div>
         </div>

         <div class="pricing-main">
         <div class="pricing-content active" id="pisces-content">
            <p class="pricing-intro">Restricted investor access to a trading event.</p>

            <div class="fee-list">
               <div class="fee-row">
                  <div class="fee-row-label">Trading Fee</div>
                  <div class="fee-row-values">
                     <div class="fee-row-value"><span class="fee-row-side">Buy Side</span><strong>0.00%</strong></div>
                     <div class="fee-row-value"><span class="fee-row-side">Sell Side</span><strong>Tiered</strong></div>
                  </div>
               </div>
               <div class="fee-row">
                  <div class="fee-row-label">Settlement Fee</div>
                  <div class="fee-row-values">
                     <div class="fee-row-value"><span class="fee-row-side">Buy Side</span><strong>£25</strong></div>
