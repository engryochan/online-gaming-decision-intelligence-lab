            <div class="pricing-tier-head">
               <h3>Sell-side tiered pricing</h3>
               <p class="pricing-note">Tiered pricing applies to PISCES sell-side trading.</p>
            </div>
            <div class="table-scroll-wrapper">
               <table class="pricing-table pricing-table-tiered">
                  <thead>
                     <tr>
                        <th>Consideration Lower Bound</th>
                        <th>Consideration Upper Bound</th>
                        <th>Buy Charge (£)</th>
