        <div class="heading news-insights--title">
          <h1>
            Piper Sandler Launches Equities Trading in Europe with New Office Opening in Paris
          </h1>
        </div>
        <div>
          09/10/2026
          <span class="news-insights--divider">|</span>
          01:00:00 AM
        </div>
      </div>
