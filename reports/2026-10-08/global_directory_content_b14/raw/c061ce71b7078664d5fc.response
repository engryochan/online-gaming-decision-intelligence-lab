="/es/inversion/preguntas-frecuentes-inversion/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="FAQs sobre inversión">FAQs sobre inversión</a></div></li></ul></li></ul></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Planes de Pensiones">Planes de Pensiones</a> <button type="button" class="menuDropdown-toggle btn btn-icon-xs btn-neutral1-invisible ab_clickElement" aria-expanded="false" aria-controls="submenu-c4ca1d32-15e0-495c-ad1b-4ef801fa42a4" aria-haspopup="true"><span class="sr-only">Abrir submenú</span> <i class="icon-16 icon-ic-arrow-small-down" aria-hidden="true"></i></button></div><ul id="submenu-c4ca1d32-15e0-495c-ad1b-4ef801fa42a4" class="menuDropdown-submenu" hidden="hidden"><li class="menuDropdown-elem has-children js-a11y-dd menuDropdown-hover"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Planes de Pensiones">Planes de Pensiones</a> <button type="button" class="menuDropdown-toggle btn btn-icon-xs btn-neutral1-invisible" aria-expanded="false" aria-controls="submenu-hipotecas1-1" aria-haspopup="true"><span class="sr-only">Abrir submenú</span> <i class="icon-16 icon-ic-arrow-small-down" aria-hidden="true"></i></button></div><ul id="submenu-hipotecas1-1" class="menuDropdown-submenu" hidden="hidden"><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/planes-de-pensiones/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Plan de Pensiones">Plan de Pensiones</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/autonomos/plan-pensiones/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Plan de pensiones para Autónomos">Plan de pensiones para Autónomos</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/epsv/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="EPSV">EPSV</a></div></li></ul></li><li class="menuDropdown-elem has-children js-a11y-dd menuDropdown-hover"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/planes-pensiones/plan-para-ahorrar/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Cómo ahorrar con un Plan de Pensiones ">Cómo ahorrar con un Plan de Pensiones</a></div></li></ul></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/banca-personal/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Banca Personal">Banca Personal</a> <button type="button" class="menuDropdown-toggle btn btn-icon-xs btn-neutral1-invisible ab_clickElement" aria-expanded="false" aria-controls="submenu-3a636cfd-7fe1-456d-af82-14486ed0c399" aria-haspopup="true"><span class="sr-only">Abrir submenú</span> <i class="icon-16 icon-ic-arrow-small-down" aria-hidden="true"></i></button></div><ul id="submenu-3a636cfd-7fe1-456d-af82-14486ed0c399" class="menuDropdown-submenu" hidden="hidden"><li class="menuDropdown-elem has-children js-a11y-dd menuDropdown-hover"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/banca-personal/tarjeta-abanca-personal/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Tarjeta ABANCA Personal">Tarjeta ABANCA Personal</a></div></li></ul></li></ul></nav><nav id="menu-empresas" class="header-categories menuDropdown-nav" aria-label="Enlaces a las páginas de las distintas categorias de productos" data-section="empresas" data-mega-height="400" aria-hidden="false"><ul><li class="menuDropdown-elem hidden-lg hidden-md"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Inicio">Inicio</a></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/autonomos/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Autónomos y Negocios">Autónomos y Negocios</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/pymes-gran-empresa/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Pymes y Grandes Empresas">Pymes y Grandes Empresas</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/abanca-agro/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="ABANCA Agro">ABANCA Agro</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/abanca-mar/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="ABANCA Mar">ABANCA Mar</a></div></li><li class="menuDropdown-elem has-children js-a11y-dd"><div class="menuDropdown-trigger"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/empresas/abanca-turismo/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="ABANCA Turismo">ABANCA Turismo</a></div></li></ul></nav><nav id="menu-banca-privada" class="header-categories menuDropdown-nav" aria-label="Enlaces a las páginas de las distintas categorias de productos" data-section="banca-privada" data-mega-height="400" aria-hidden="false"><ul><li class="menuDropdown-elem hidden-lg hidden-md"><a class="menuDropdown-link btn btn-neutral1-invisible ab_clickElement" href="/es/banca-privada/" data-abaction="click-menu" data-abcategory="home-nav" data-abvalue="Inicio Banca Privada">Inicio Banca Privada</a></li></ul></nav></div><div class="header-bottom-actions"><nav class="header-buttons" aria-label="Menú de acciones"><ul><li><a href="/es/cuentas/cuenta-online/" aria-label="Hazte cliente" title="Hazte cliente" data-abaction="click-menu" data-abcategory="header-primary|nav-bar" data-abvalue="Hazte cliente" class="ab_clickElement header-buttons-hazte-cliente btn btn-primary"><span>Hazte cliente</span></a></li><li><a href="https://online.abanca.com/es-ES/#/login" aria-label="Área cliente" title="Área cliente" data-abaction="click-menu" data-abcategory="header-primary|nav-bar" data-abvalue="Área cliente" class="ab_clickElement btn boton s"><span>Área cliente</span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></nav></div></header><main class="mainContentH" id="content"><article class="profile"><div class="welcome welcome-promo-perfil-agro-1" data-time="8"><link rel="stylesheet" href="//www.abanca.com/css/promos/promo-perfil-agro-1/promo-perfil-agro-1-91ed23c0.css"><div class="welcome-content"><div class="welcome-html"><div class="welcome-header"><h1 class="welcome-title">Somos agro<br>Somos ABANCA</h1></div><ul class="welcome-buttons"></ul><ul class="welcome-links"></ul></div></div></div><div class="profile-intro wrapper-medium"></div><div class="profile-intro wrapper-medium"><p>Somos un banco con los pies en la tierra. En ABANCA apoyamos desde siempre el trabajo y esfuerzo de un sector crítico de nuestra economía, y gracias a esta experiencia somos una entidad de referencia para el <strong>sector agroganadero, forestal y vitivinícola</strong>.</p><p>ABANCA Agro es la unidad especializada en servicios financieros para la cadena de valor del mundo Agro. Cuenta con <strong>un equipo de profesionales especializados y un catálogo de productos diseñados para atender las necesidades financieras del sector</strong>.</p></div><div class="wrapper wrapper-top"><div class="profile-permalink"><div class="profile-header"><figure class="profile-image"><img src="//www.abanca.com/img/internas/agro-bf69df99.jpg" alt=""></figure><header class=""><h2>Financiación y seguros para el campo</h2><nav class="profile-header-menu"><ul><li><a href="#ayudas-pac" data-action="scroll"><span class="fa fa-angle-double-down"></span> Quiero financiación para el día a día</a></li><li><a href="#convenios" data-action="scroll"><span class="fa fa-angle-double-down"></span> Quiero financiación para mis inversiones</a></li><li><a href="#fiabilidad" data-action="scroll"><span class="fa fa-angle-double-down"></span> Quiero financiación especializada</a></li><li><a href="#seguros" data-action="scroll"><span class="fa fa-angle-double-down"></span> Quiero un seguro</a></li></ul></nav></header></div><ul class="profile-needs"><li id="ayudas-pac"><h2 class=""><span>Quiero financiación para el día a día</span></h2><div class="profile-need-intro"><p>Te damos la financiación específica que necesitas para el día a día de tu explotación.</p></div><ul class="profile-need-products"><li class="product-list"><article class="product"><div class="product-container"><div><header class="product-header"><h3 class="product-title">Línea de Financiación Agro</h3></header><div><div class="product-intro"><p>Una solución de crédito que te permite agrupar en un único contrato los tres destinos más habituales de financiación: anticipar tus ayudas PAC, cubrir gastos de campañas o financiar seguros agrarios.</p></div><div class="product-nav"><ul class="product-nav-buttons"><li><a href="/es/empresas/financiacion/linea-financiacion-agro/" class="button button-call ab_clickElement" data-abaction="click-cta" data-abcategory="boton listado|call|0" data-abvalue="Más información"><span class="fa-fw"></span> Más información</a></li></ul></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><figure class="product-image"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/2-agro-46568e87.jpg 180w" media="(prefers-color-scheme: light)" sizes="180px" sizes="180px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/2-agro-46568e87.jpg 180w" media="(prefers-color-scheme: dark)" sizes="180px" sizes="180px"><img src="//www.abanca.com/img/internas/2-agro-46568e87.jpg" alt="" width="180"></picture></figure><div><header class="product-header"><h3 class="product-title">Anticipo de ayudas PAC</h3></header><div><div class="product-intro"><p>Te ofrecemos la posibilidad de <strong>adelantar</strong> el cobro de las <strong>ayudas de la PAC</strong> para que puedas disponer del importe desde el primer día. Con nuestra experiencia te podemos ayudar en la tramitación con una gestión simplificada, ágil y cómoda.</p><p>Pide cita en tu oficina más cercana y te ayudamos.</p></div><div class="product-nav"><ul class="product-nav-buttons"><li><a href="https://solicitudonline.abanca.com/empresas/es/4_pac/J" class="button button-call ab_clickElement" data-abaction="click-cta" data-abcategory="boton listado|call|0" data-abvalue="Solicitar ahora">Solicitar ahora <span class="fa-fw"></span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><figure class="product-image"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/7-agro-808c5bfd.jpg 180w" media="(prefers-color-scheme: light)" sizes="180px" sizes="180px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/7-agro-808c5bfd.jpg 180w" media="(prefers-color-scheme: dark)" sizes="180px" sizes="180px"><img src="//www.abanca.com/img/internas/7-agro-808c5bfd.jpg" alt="" width="180"></picture></figure><div><header class="product-header"><h3 class="product-title">Subvenciones</h3></header><div><div class="product-intro"><p>Hacemos que tus relaciones con la Administración sean mucho más sencillas y llevaderas. <strong>Te anticipamos las subvenciones</strong> concedidas, la devolución de los impuestos y <strong>financiamos tus obligaciones</strong> tributarias.</p><p>Utilizamos nuestra experiencia en el sector para hacerte la vida más cómoda, también con todo lo relacionado con los <a href="/es/empresas/next-generation/"><strong>Fondos Next Generation:</strong></a> anticipo de la ayuda, financiación de inversiones, ¡y mucho más!</p></div><div class="product-nav"><ul class="product-nav-links"><li class=""><a href="https://solicitudonline.abanca.com/empresas/es/4_ayudas_y_subvenciones/J" class="ab_clickElement" data-abaction="click-cta" data-abcategory="link listado|secondary|0" data-abvalue="Cita Anticipo Subvención"><span class="fa-fw"></span> Cita Anticipo Subvención<span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><div><header class="product-header"><h3 class="product-title">Póliza de crédito</h3></header><div><div class="product-intro"><p>Te ayudamos a mejorar la estabilidad de la financiación del circulante que necesita la tesorería de tu explotación. Dispondrás de un aliado tan flexible como sólido para financiar tus necesidades de liquidez, <strong>hasta un plazo de 5 años y en condiciones muy ventajosas</strong> a tipo variable.</p></div><div class="product-nav"><ul class="product-nav-links"><li class=""><a href="/es/empresas/financiacion/linea-credito/" class="ab_clickElement" data-abaction="click-cta" data-abcategory="link listado|secondary|0" data-abvalue="Más información "><span class="fa-fw"></span> Más información</a></li></ul></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><div><header class="product-header"><h3 class="product-title">Líneas de descuento</h3></header><div><div class="product-intro"><p>Para que el <strong>cobro de tus letras</strong>, pagarés, recibos o <strong>facturas</strong> no suponga un problema, te facilitamos que anticipes su cobro con unas condiciones muy competitivas.</p></div></div></div></div></article></li></ul></li><li id="convenios"><h2 class=""><span>Quiero financiación para mis inversiones</span></h2><div class="profile-need-intro"><p>Si estás pensando en invertir para mejorar tu explotación, te podemos ayudar a crecer sin preocupaciones. Con la financiación de inversiones de ABANCA Agro mirarás hacia el futuro con seguridad.</p></div><ul class="profile-need-products"><li class="product-list"><article class="product"><div class="product-container"><div><header class="product-header"><h3 class="product-title">Financiación de equipamiento</h3></header><div><div class="product-intro"><p>Si estás pensando en cambiar, ampliar o <strong>modernizar tus instalaciones</strong>, podemos financiar tus proyectos de inversión a través de nuestra oferta sectorial, donde podrás escoger entre préstamos con un interés fijo hasta un plazo máximo de 8 años o con un <strong>interés variable y hasta en 12 años, con posibilidad de carencia</strong>. Y elige la forma que más te interese: <strong>préstamo o leasing</strong>, incluido el leasing para ganado.</p><p>Además, en la financiación de inversiones que contribuyan a mejorar la sostenibilidad o eficiencia energética de la actividad, se aplicarán tarifas bonificadas.</p><p><strong>Financiación de comunidades de regantes, amueblamiento de fincas de regantes y cultivos de ciclo largo</strong> con plazos y condiciones adaptadas que se adecúan a las necesidades específicas de estos cultivos.</p></div><div class="product-nav"><ul class="product-nav-buttons"><li><a href="https://solicitudonline.abanca.com/empresas/es/nuevas_inversiones/J" class="button button-call ab_clickElement" data-abaction="click-cta" data-abcategory="boton listado|call|0" data-abvalue="Solicítalo ">Solicítalo <span class="fa-fw"></span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><div><header class="product-header"><h3 class="product-title">Convenios para ayudarte con la financiación</h3></header><div><div class="product-intro"><p>Ponemos a tu disposición convenios oficiales que te pueden facilitar el acceso a nueva financiación como son los convenios IGAPE (aplicable sólo en Galicia) con SAECA (a mayores de la linea general, en vigor las líneas reafianzamiento, jóvenes y DANA) o SGRs que aportan garantías adicionales para facilitar el acceso a financiación de liquidez e inversiones y con plazos de hasta 15 años.</p><p>Infórmate de las ventajas del Instrumento Financiero de Gestión Centralizada (IFGC) a través del que podrás optar a financiación con plazos de hasta 20 años con posibilidad de carencia y garantía del 80% del MAPA, para aquellas explotaciones situadas en las CCAA adheridas al IFGC (actualmente Galicia, C. León, Extremadura y Aragón):</p><ul><li>Inversiones en explotaciones agrarias, Industria Forestal con resolución favorable a préstamo garantizado.(*)</li><li>Financiación de inversiones (incluida compra de tierras) y financiación de circulante.(*)</li><li>Incorporación de jóvenes y mujeres.(*)</li></ul><p>(*) Líneas incluidas dependiendo de cada CCAA.</p></div></div></div></div></article></li></ul></li><li id="fiabilidad"><h2 class=""><span>Quiero financiación especializada</span></h2><div class="profile-need-intro"><p>Disponemos de una amplia línea de servicios que garantizan tus <strong>pagos a proveedores</strong>, financiación de comercio exterior o líneas multifinanciación.</p></div><ul class="profile-need-products"><li class="product-list"><article class="product"><div class="product-container"><figure class="product-image"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/poliza-credito1-7d4ac7c3.jpg 180w" media="(prefers-color-scheme: light)" sizes="180px" sizes="180px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/poliza-credito1-7d4ac7c3.jpg 180w" media="(prefers-color-scheme: dark)" sizes="180px" sizes="180px"><img src="//www.abanca.com/img/internas/poliza-credito1-7d4ac7c3.jpg" alt="" width="180"></picture></figure><div><header class="product-header"><h3 class="product-title">Confirming</h3></header><div><div class="product-intro"><p>Esta es una solución perfecta para optimizar tu tiempo y recursos en el <strong>pago a proveedores</strong>, con procesos más simples y menos carga administrativa. Con nuestras soluciones podrás organizar y gestionar tus pagos y disminuir tus costes de aprovisionamiento con la opción de pronto pago. Y hasta nos podemos encargar de atenderte las llamadas.</p></div><div class="product-nav"><ul class="product-nav-buttons"><li><a href="https://solicitudonline.abanca.com/empresas/es/solicitar_confirming/J" class="button button-call ab_clickElement" data-abaction="click-cta" data-abcategory="boton listado|call|0" data-abvalue="Solicitalo ya">Solicitalo ya <span class="fa-fw"></span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul><ul class="product-nav-links"><li class=""><a href="/es/empresas/financiacion/confirming/" class="ab_clickElement" data-abaction="click-cta" data-abcategory="link listado|secondary|0" data-abvalue="Más información"><span class="fa-fw"></span> Más información</a></li></ul></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><figure class="product-image"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/factoring1-b64905a0.jpg 749w" media="(prefers-color-scheme: light)" sizes="180px" sizes="749px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/factoring1-b64905a0.jpg 749w" media="(prefers-color-scheme: dark)" sizes="180px" sizes="749px"><img src="//www.abanca.com/img/internas/factoring1-b64905a0.jpg" alt="" width="180"></picture></figure><div><header class="product-header"><h3 class="product-title">Factoring</h3></header><div><div class="product-intro"><p>Con nuestro servicio de factoring, nosotros nos encargaremos de la <strong>administración y la financiación de las facturas de tu empresa</strong>. Así, <strong>ahorrarás gastos</strong> administrativos, mejorararás tu contabilidad y organizarás más eficientemente la estructura financiera de tu compañía. Tú te ocuparás de que tu empresa sea cada día más y más próspera.</p></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><div><header class="product-header"><h3 class="product-title">Comercio exterior</h3></header><div><div class="product-intro"><p>En ABANCA te garantizamos la seguridad, fiabilidad y financiación de tus pagos a proveedores, aquí y en el extranjero. Para eso te acompañamos en las operaciones de <strong>importación y exportación</strong> con un <strong>servicio integral de calidad</strong>: crédito, afianzamiento y gestión de cobros y pagos.</p><p>ABANCA pone a tu disposición una amplia red internacional, una plataforma informática de vanguardia y, sobre todo, el asesoramiento personalizado de un equipo de gestión próximo. Tenemos una gran <strong>experiencia</strong> en el comercio internacional de productos agroganaderos.</p></div><div class="product-nav"><ul class="product-nav-links"><li class=""><a href="https://solicitudonline.abanca.com/empresas/es/solicitar_comex/J" class="ab_clickElement" data-abaction="click-cta" data-abcategory="link listado|secondary|0" data-abvalue="Pide cita con uno de nuestros gestores especializados"><span class="fa-fw"></span> Pide cita con uno de nuestros gestores especializados<span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><div><header class="product-header"><h3 class="product-title">Multifinanciación</h3></header><div><div class="product-intro"><p><strong>Todos los productos de circulante</strong> que necesitas para tu empresa (avales, comex, descuento comercial, línea de crédito) <strong>en un único contrato</strong>. De esta forma, todos <strong>compartirán el 100% del límite solicitado</strong>. La multifinanciación es una forma mucho más flexible y rápida de disponer de liquidez. Con ella podrás resolver tus necesidades financieras en el momento preciso, cuando tú quieras.</p></div><div class="product-nav"><ul class="product-nav-buttons"><li><a href="https://solicitudonline.abanca.com/empresas/es/solicitar_comex/J" class="button button-call ab_clickElement" data-abaction="click-cta" data-abcategory="boton listado|call|0" data-abvalue="Infórmate">Infórmate <span class="fa-fw"></span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></div></div></div></div></article></li></ul></li><li id="seguros"><h2 class=""><span>Quiero un seguro</span></h2><div class="profile-need-intro"><p>Tenemos un gran número de seguros especializados en el campo para que, sea cual sea tu preocupación, no tengas que pensar en ella nunca más.</p></div><ul class="profile-need-products"><li class="product-list"><article class="product"><div class="product-container"><figure class="product-image"><picture><source type="image/jpeg" srcset="//www.abanca.com/img/internas/1-agro-688944c6.jpg 180w" media="(prefers-color-scheme: light)" sizes="180px" sizes="180px"><source type="image/jpeg" srcset="//www.abanca.com/img/internas/1-agro-688944c6.jpg 180w" media="(prefers-color-scheme: dark)" sizes="180px" sizes="180px"><img src="//www.abanca.com/img/internas/1-agro-688944c6.jpg" alt="" width="180"></picture></figure><div><header class="product-header"><h3 class="product-title">Agroseguro</h3></header><div><div class="product-intro"><p>Comercializamos <strong>todas las líneas</strong> de Agroseguro. Además, disponemos de una línea de financiación específica para seguros agrarios que permite fraccionar el pago de la prima hasta en doce mensualidades en condiciones muy interesantes. Nuestros seguros incluyen:</p><ul><li>Retirada de animales muertos.</li><li>Seguros pecuarios (vacuno, aviar, porcino, ovino y caprino).</li><li>Seguro forestal.</li><li>Seguros agrícolas (maiz, trigo, cebada, alfalfa, leguminosas, oleaginosas, frutos secos, frutales, hortalizas, olivar y uva tanto de mesa como de vino).</li></ul></div><div class="product-nav"><ul class="product-nav-buttons"><li><a href="https://solicitudonline.abanca.com/empresas/es/seguro_pyme/J" class="button button-call ab_clickElement" data-abaction="click-cta" data-abcategory="boton listado|call|0" data-abvalue="Solicítalo ">Solicítalo <span class="fa-fw"></span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></div></div></div></div></article></li><li class="product-list"><article class="product"><div class="product-container"><div><header class="product-header"><h3 class="product-title">Seguro de maquinaria</h3></header><div><div class="product-intro"><p>Nuestro seguro de <strong>tractores y maquinaria agrícola</strong> cubre la póliza obligatoria de circulación, pero además te ofrece la contratación de coberturas adicionales segun tus necesidades, como <strong>responsabilidad civil</strong> de trabajos en bienes propios o ajenos, accidente del conductor, asistencia médica, incendio, robo o pérdida total, entre otros.</p></div><div class="product-nav"><ul class="product-nav-buttons"><li><a href="https://solicitudonline.abanca.com/empresas/es/seguro_maquinaria/J" class="button button-call ab_clickElement" data-abaction="click-cta" data-abcategory="boton listado|call|0" data-abvalue="Solicítalo ">Solicítalo <span class="fa-fw"></span><span class='accessible_hidden'>Serás redirigido a otro sitio web</span></a></li></ul></div></div></div></div></article></li></ul></li></ul></div></div></article><div class="wrapper"><ul class="profiles-grid"><li><a href="/es/empresas/pymes-gran-empresa/" class="profile-list"><article class="profile"><div class="profile-image"><img src="//www.abanca.com/img/internas/_mediaformats/perfil-empresas-150-3c81fb5b.jpg" alt=""></div><div><header class="profile-header"><h4 class="profile-title">¿Buscas lo mejor para tu PYME?</h4></header></div></article></a></li><li><a href="/es/empresas/pymes-gran-empresa/" class="profile-list"><article class="profile"><div class="profile-image"><img src="//www.abanca.com/img/internas/_mediaformats/circulo-comercios-150-701531e2.png" alt=""></div><div><header class="profile-header"><h4 class="profile-title">¿Tienes un comercio?</h4></header></div></article></a></li><li><a href="/es/empresas/abanca-mar/" class="profile-list"><article class="profile"><div class="profile-image"><img src="//www.abanca.com/img/internas/_mediaformats/mar-150-acf2e58d.jpg" alt=""></div><div><header class="profile-header"><h4 class="profile-title">¿Trabajas en el mar?</h4></header></div></article></a></li></ul><footer class="wrapper-medium footer-call"><p class="titular">¿Quieres saber más sobre los productos que ABANCA tiene para ti?</p><ul class="footer-call-buttons"><li><a href="/es/empresas/productos/" class="button button-call ab_clickElement" data-abaction="click-cta" data-abcategory="footer-button|call|0" data-a