3 19.33 10.93C19.09 10.13 18.55 9.53 17.48 8.32L13.64 4H11.63L16.35 9.31C17.21 10.28 17.66 10.8 17.84 11.25H3V12.75Z" fill="black"></path></svg></div><span class="label" data-v-59c74fde>Careers</span><!--]--></a></li><!--]--></ul></div></div><!--]--></div></div></div></div></div></div></div><!----><div data-component="announcement-popup" class="" data-v-ccc7c736><button class="close" data-v-ccc7c736><svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" data-v-ccc7c736><g clip-path="url(#clip0_10510_59510)" data-v-ccc7c736><path d="M13.6858 3.02014L12.9792 2.31348L7.99917 7.29348L3.01917 2.31348L2.3125 3.02014L7.2925 8.00014L2.3125 12.9801L3.01917 13.6868L7.99917 8.70681L12.9792 13.6868L13.6858 12.9801L8.70583 8.00014L13.6858 3.02014Z" fill="black" data-v-ccc7c736></path></g><defs data-v-ccc7c736><clipPath id="clip0_10510_59510" data-v-ccc7c736><rect width="11.3733" height="11.3733" fill="white" transform="translate(2.3125 2.31348)" data-v-ccc7c736></rect></clipPath></defs></svg></button><div class="content" data-v-ccc7c736><div class="image-wrapper" data-v-ccc7c736><a href="/active-trader" class="link -body_small" data-component="hyperlink" aria-label="Link" data-disabled="false" title="active-trader" data-v-ccc7c736 data-v-223f919b><!--[--><img onerror="this.setAttribute(&#39;data-error&#39;, 1)" width="1920" height="1080" alt="Image" data-nuxt-img sizes="1200px" srcset="/_ipx/f_webp&amp;s_1200x675/https://cdn.sanity.io/images/40fnhjbe/production/03146641fdf7aae5aa445b413a336ef407738845-1920x1080.png 1200w, /_ipx/f_webp&amp;s_2400x1350/https://cdn.sanity.io/images/40fnhjbe/production/03146641fdf7aae5aa445b413a336ef407738845-1920x1080.png 2400w" data-component="image-asset" provider_="ipx" title="Image" data-v-ccc7c736 src="/_ipx/f_webp&amp;s_2400x1350/https://cdn.sanity.io/images/40fnhjbe/production/03146641fdf7aae5aa445b413a336ef407738845-1920x1080.png"><!--]--></a></div><div class="content-wrapper" data-v-ccc7c736><h3 class="-body_medium title" data-v-ccc7c736></h3><p class="-caption message" data-v-ccc7c736>Professional-grade execution meets Clear Street&#39;s Omni AI in a new platform built for serious, self-directed traders. Get in early.</p><a href="/active-trader" class="link -body_small" data-component="hyperlink" aria-label="Link" data-disabled="false" title="active-trader" data-v-ccc7c736 data-v-223f919b><!--[-->Learn more <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" data-v-ccc7c736><g clip-path="url(#clip0_10510_165424)" data-v-ccc7c736><path d="M10.8583 13.0083C11.7083 12.0167 12.1333 11.525 12.3167 10.875C12.4833 10.3 12.4833 9.7 12.3167 9.125C12.125 8.475 11.7 7.98333 10.85 6.99167L9.15 5H7.5L9.9 7.8C10.6333 8.65833 11 9.08333 11.1167 9.475C11.2167 9.81667 11.2167 10.1833 11.1167 10.525C11 10.9167 10.6333 11.3417 9.9 12.2L7.5 15H9.15L10.8583 13.0083Z" fill="#2E21DE" data-v-ccc7c736></path></g><defs data-v-ccc7c736><clipPath id="clip0_10510_165424" data-v-ccc7c736><rect width="4.94167" height="10" fill="white" transform="translate(7.5 5)" data-v-ccc7c736></rect></clipPath></defs></svg><!--]--></a></div></div></div><!--[--><div data-component="client" data-slug="etf-issuers" data-v-d8f56d83><!--[--><header data-component="client-services-header" style="" data-slug="etf-issuers" data-v-d8f56d83 data-v-1ac9dbf5><div class="row expanded title-row" data-v-1ac9dbf5><img src="/imgs/clients.jpg" title="Header Image" alt="Header Image" class="img clients" data-v-1ac9dbf5><div class="xxlarge-16 large-18 medium-20 small-24 xsmall-32 col" data-v-1ac9dbf5><!----><h1 class="-h1 title" data-v-1ac9dbf5>ETF Issuers</h1><p class="-body_large subtitle" data-v-1ac9dbf5>Clear Street delivers efficiency and precision all in one place.</p><div class="cta-container" data-v-1ac9dbf5><a href="/contact" class="blueberry primary xlarge back cta-btn" data-component="button" aria-label="Get in Touch" data-disabled="false" title="Get in Touch" data-hover="false" data-v-1ac9dbf5 data-v-fdc95d51 data-v-223f919b><!--[--><span class="bg" data-v-fdc95d51></span><!----><span class="-body label" data-v-fdc95d51>Get in Touch</span><!--]--></a></div></div></div><div class="row expanded others-row" data-v-1ac9dbf5><div class="xxlarge-32 col" data-v-1ac9dbf5></div></div></header><!--[--><section data-component="statistics" _type="globalStatistics" data-v-d8f56d83 data-v-fac60782><div class="row" data-v-fac60782><div class="col left-col xxlarge-16 medium-15 small-32" data-v-fac60782><h2 class="-h4 title" data-v-fac60782>ETF Operations in Real Time</h2><p class="-body description" data-v-fac60782>As derivatives-based ETF strategies continue to gain traction, issuers face growing complexity and competition. Success in this space hinges on having the right partners and infrastructure to support agile, scalable growth. Clear Street’s unified technology helps ETF issuers meet their needs across clearing, execution and financing, with additional support spanning asset servicing, compliance, portfolio margin and
risk management.</p></div><div class="xxlarge-16 medium-17 small-32 col right-col" data-v-fac60782><ul class="list" data-v-fac60782><!--[--><li class="item" data-v-fac60782><!----><div class="content-wrapper" data-v-fac60782><div class="inner" data-v-fac60782><p class="-h4 content-title" data-v-fac60782>~$28.4bn</p><p class="-body" data-v-fac60782>notional / day</p></div></div></li><li class="item" data-v-fac60782><!----><div class="content-wrapper" data-v-fac60782><div class="inner" data-v-fac60782><p class="-h4 content-title" data-v-fac60782>~4%</p><p class="-body" data-v-fac60782>U.S. equities market share</p></div></div></li><li class="item" data-v-fac60782><!----><div class="content-wrapper" data-v-fac60782><div class="inner" data-v-fac60782><p class="-h4 content-title" data-v-fac60782>~2.4mn</p><p class="-body" data-v-fac60782>average daily transactions</p></div></div></li><li class="item" data-v-fac60782><!----><div class="content-wrapper" data-v-fac60782><div class="inner" data-v-fac60782><p class="-h4 content-title" data-v-fac60782>40mn</p><p class="-body" data-v-fac60782>end users serviced</p></div></div></li><!--]--></ul></div></div></section><section data-component="big-list" _type="bigList" data-v-d8f56d83 data-v-aa07eaa6><div class="row" data-v-aa07eaa6><div class="xxlarge-16 xxlarge-offset-8 medium-offset-7 medium-18 small-32 small-offset-0 col title-col" data-v-aa07eaa6><h2 class="-body title" data-v-aa07eaa6></h2><p class="-h4 description" data-v-aa07eaa6>The Clear Street Difference</p></div></div><div data-component="desktop-list" class="desktop-list" data-v-aa07eaa6 data-v-2d845d86><div class="row list-container" data-v-2d845d86><div class="xxlarge-22 xxlarge-offset-2 medium-offset-1 medium-24 col" data-v-2d845d86><div class="list-col" data-v-2d845d86><div class="animation-container" data-v-2d845d86><span class="-h1 numbers-container" data-v-2d845d86><span class="padd-zero" data-v-2d845d86>0</span><span class="numbers" data-v-2d845d86><span class="numbers-inner" data-v-2d845d86><!--[--><span class="index" data-v-2d845d86>1</span><span class="index" data-v-2d845d86>2</span><span class="index" data-v-2d845d86>3</span><span class="index" data-v-2d845d86>4</span><!--]--></span></span></span></div><ul class="list" data-v-2d845d86><!--[--><li class="item active" data-v-2d845d86><div class="content-container" data-v-2d845d86><h3 class="-h4 item-title" data-v-2d845d86>Single-Ledger Visibility</h3><div class="description-container" data-v-2d845d86><p class="-body item-description" data-v-2d845d86>Execution, clearing, financing and risk run on one data set, surfaced in Clear Street Studio™ for live positions, P&amp;L and intraday margin – fewer breaks, faster closes and cleaner oversight.</p></div></div></li><li class="item" data-v-2d845d86><div class="content-container" data-v-2d845d86><h3 class="-h4 item-title" data-v-2d845d86>Integrated Derivatives</h3><div class="description-container" data-v-2d845d86><p class="-body item-description" data-v-2d845d86>Listed options/futures and security-based swaps trade and settle alongside cash, so levered, inverse and options-overlay ETFs can
launch and scale without parallel systems.</p></div></div></li><li class="item" data-v-2d845d86><div class="content-container" data-v-2d845d86><h3 class="-h4 item-title" data-v-2d845d86>Operate with Confidence</h3><div class="description-container" data-v-2d845d86><p class="-body item-description" data-v-2d845d86>High-STP post-trade, cloud-native infrastructure and elastic throughput minimize operational drag during rebalances and regime shifts like T+1. </p></div></div></li><li class="item" data-v-2d845d86><div class="content-container" data-v-2d845d86><h3 class="-h4 item-title" data-v-2d845d86>Capital and Collateral Efficiency</h3><div class="description-container" data-v-2d845d86><p class="-body item-description" data-v-2d845d86>Integrated stock-loan and portfolio margining help optimize collateral and improve financing economics as AUM and volume grow.</p></div></div></li><!--]--></ul></div></div></div></div><div data-component="mobile-list" class="mobile-list" data-v-aa07eaa6 data-v-7ef998f4><div class="row" data-v-7ef998f4><div class="xxlarge-32 col" data-v-7ef998f4><ul class="list" data-v-7ef998f4><!--[--><li class="item" data-v-7ef998f4><div class="main-container" data-v-7ef998f4><div class="-h3 numbers-container" data-v-7ef998f4>0 1</div><div class="title-container" data-v-7ef998f4><h3 class="-h4 item-title" data-v-7ef998f4>Single-Ledger Visibility</h3><div class="icon-container" data-v-7ef998f4><div data-component="icon" class="large icon plus" data-v-7ef998f4 data-v-0b1d9552><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" data-v-0b1d9552><g clip-path="url(#clip0_1926_2354)"><path d="M20.75 11.25H12.75V3.25H11.25V11.25H3.25V12.75H11.25V20.75H12.75V12.75H20.75V11.25Z" fill="black"></path></g><defs><clipPath id="clip0_1926_2354"><rect width="17.5" height="17.5" fill="white" transform="translate(3.25 3.25)"></rect></clipPath></defs></svg></div><div data-component="icon" class="large icon minus" data-v-7ef998f4 da