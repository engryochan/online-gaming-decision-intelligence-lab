<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
function toggleMenu(sub,cont){

	cont = cont.replace(' __ghostlab-hover__','');
	cont = cont.replace(' activated','');
	cont = cont.replace(' mobile-grey','');

	if($("." + cont).hasClass('activated') == true){
		$("ul[id$='Sub']").hide();
	}else{
		$("ul[id$='Sub']").hide();
		$("#"+ sub).toggle();
	}

	if($("." + cont).hasClass('activated') == true){
		$("li").removeClass('activated');
	}else{
		$("li").removeClass('activated');
		$("." + cont).toggleClass('activated');	
	}
};

$(document).ready(function () {
	var logbox = 0;

	$('#nav-icon').click(function(){
		if(logbox !== 1){
			$("ul[id$='Sub']").hide();
			$("li").removeClass('activated');
			$(this).toggleClass('open');
			$(".mobile-nav-button").toggleClass('mobile-active');
			$(".mobile-nav-container").toggle();
			$("#overlay").toggle();
			$(".subpage").show();
			$(".homepage").show();
			$(".footer").show();
		}else{
			$(".mobile-nav-container").css({'position': 'fixed'});
			$("#bgcontainer").css({'position': 'unset'});
			$("#overlay").css({'position': 'fixed'});
			$(".mobile-nav").show();
			$(".mobile-search-box").show();
			$(".mobile-login").hide();
			logbox = 0;
		}
	});

	$("#coalP").on("click",function(){
		toggleMenu('cpSub',$(this).attr('class'));
	});

	$("#mSTC").on("click",function(){
		toggleMenu('scSub',$(this).attr('class'));
	});

	$("#gcAccount").on("click",function(){
		toggleMenu('accSub',$(this).attr('class'));
	});

	$("#coalT").on("click",function(){
		toggleMenu('ctSub',$(this).attr('class'));
	});

	//grey buttons
	$("#mAbout").on("click",function(){
		toggleMenu('abSub',$(this).attr('class'));
	});

	$("#mNews").on("click",function(){
		toggleMenu('neSub',$(this).attr('class'));
	});

	$("#mTools").on("click",function(){
		toggleMenu('fmSub',$(this).attr('class'));
	});

	$("#mContact").on("click", function(){
		window.location.replace('https://www.globalcoal.com/enquire.cfm');
	});
	
	$("#mobLogin").on("click", function(){
		if(logbox == 0){
			$(".mobile-nav-container").css({'position': 'fixed'});	
		}else{
			$(".mobile-nav-container").css({'position': 'absolute'});
		}
		$(".mobile-nav").hide();
		$(".mobile-search-box").hide();
		$(".mobile-account").hide();
		$(".mobile-login").show();
		$("#bgcontainer").css({'position': 'absolute'});
		$("#overlay").css({'position': 'absolute'});
		$(".subpage").hide();
		$(".homepage").hide();
		$(".footer").hide();
		logbox = 1;
	});
	
});
</script>
