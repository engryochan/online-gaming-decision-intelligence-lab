            <style>
                .ui-dialog .ui-dialog-title {
                    /* float: left;
                   position: relative;
                   left: 50%;*/
                    margin: 0.5em 16px 2.1em 16px;
                    font-family: 'Montserrat';
                    font-style: normal;
                    font-weight: 600;
                    font-size: 18px;
                    line-height: 150%;
                }

                .ui-dialog .ui-dialog-content {
                    background: #fff;
                    color: #495057;
                    border: 0 none;
                    padding: 0.2rem 1.5rem 2rem 1.5rem;
                    border: 0 none;
                }

                .ui-dialog {
                    position: fixed;
                    overflow: hidden;
                    padding: 0;
                    box-shadow: 0px 11px 15px -7px rgb(0 0 0 / 20%), 0px 24px 38px 3px rgb(0 0 0 / 14%), 0px 9px 46px 8px rgb(0 0 0 / 12%);
                    border: 0 none;
                    border-radius: 4px;
                }

                .ui-dialog .ui-dialog-titlebar .ui-dialog-titlebar-icon .ui-icon-closethick {
                    font-family: "primeicons" !important;
                    font-style: normal;
                    font-weight: normal;
                    display: inline-block;
                    background: none;
                }
                .ui-icon {
                    font-size: 1.5rem;
                    vertical-align: baseline;
                    position: static;
                    text-indent: 0;
                    overflow: visible;
                }

                .ui-dialog .ui-dialog-titlebar {
                    padding: 1em 1.5em 0em 0em;
                    display: flex;
                    justify-content: center;
                    /* position: relative;*/
                    border: 0;
                    background: #fff;
                }

                .ui-dialog .ui-dialog-titlebar .ui-dialog-titlebar-icon .ui-icon-closethick:before {
                    content: "";
                }

                .ui-widget-overlay {
                    background: rgba(0,0,0,.4);
                }

                .ui-dialog .ui-dialog-titlebar .ui-dialog-titlebar-icon {
                    /* color: #6c757d;*/
                    color: #048282;
                    text-align: center;
                    line-height: 2rem;
                }

                /* select one menu */

                .ui-selectonemenu label.ui-selectonemenu-label {
                    cursor: pointer;
                }

                .ui-fluid .ui-selectonemenu-label {
                    width: calc(100% - 2.357rem);
                    padding: .5rem .5rem;
                }

                .ui-selectonemenu .ui-selectonemenu-label {
                    background: transparent;
                    padding-right: 2.357rem;
                }

                .ui-fluid .ui-inputfield {
                    box-sizing: border-box;
                    -webkit-box-sizing: border-box;
                    -moz-box-sizing: border-box;
                }

                .ui-selectonemenu .ui-selectonemenu-label {
                    display: block;
                    border: 0;
                    white-space: nowrap;
                    overflow: hidden;
                    font-weight: normal;
                    width: 100%;
                    text-align: left;
                }
                /*    #formSearchCA .ui-inputfield {
                        color: #495057;
                        background: #ffffff;
                        padding: .5rem .5rem;
                        border: 1px solid #ced4da;
                        outline: 0 none;
                        font-size: 1rem;
                        border-radius: 4px;
                        transition: background-color .2s,color .2s,border-color .2s,box-shadow .2s,opacity .2s;
                        -webkit-appearance: none;
                        appearance: none;
                        margin: 0;
