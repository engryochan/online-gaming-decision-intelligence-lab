<style id="qcld-wp-chatbot-common-style-inline-css">
.wp-chatbot-ball{
                background: #fff !important;
            }
            .wp-chatbot-ball:hover, .wp-chatbot-ball:focus{
                background: #fff !important;
            }
            .qc_wpbot_floating_main{
                background-color: #fff !important;
            }
            .qc_wpbot_floating_main:hover, .qc_wpbot_floating_main:focus{
                background-color: #fff !important;
            }
            
			#wp-chatbot-chat-container {
				--wpbot-window-height: 80vh;
				--wpbot-window-height: 80dvh;
			}
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board,
			#wp-chatbot-chat-container .wp-chatbot-start-container {
				height: var(--wpbot-window-height) !important;
				max-height: var(--wpbot-window-height) !important;
				box-sizing: border-box;
			}
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board {
				display: flex !important;
				flex-direction: column;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container[style*="display: block"],
			#wp-chatbot-chat-container .wp-chatbot-start-container[style*="display:block"] {
				display: flex !important;
				flex-direction: column !important;
				position: relative;
			}
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board > .wp-chatbot-header,
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board > .wp-chatbot-footer,
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board > .qcld-bot-powered-by {
				flex-shrink: 0;
			}
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board {
				overflow: hidden;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container {
				overflow: hidden !important;
				overscroll-behavior: contain;
				touch-action: pan-y;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container:not(.wp-chatbot-board-open-animate):not(.wp-chatbot-board-is-closing) {
				transform: none !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-content {
				scrollbar-width: thin;
				scrollbar-color: rgba(0, 0, 0, 0.28) transparent;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-content::-webkit-scrollbar {
				width: 4px;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-content::-webkit-scrollbar-track {
				background: transparent;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-content::-webkit-scrollbar-thumb {
				background: rgba(0, 0, 0, 0.28);
				border-radius: 4px;
			}
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board > .slimScrollDiv,
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board > .wp-chatbot-content {
				position: relative;
				display: flex !important;
				flex-direction: column;
				flex: 1 1 auto !important;
				min-height: 0 !important;
				height: auto !important;
				max-height: none !important;
				overflow: hidden;
				    width: 100% !important;
			}
			#wp-chatbot-chat-container #wp-chatbot-board-container.active-chat-board > .slimScrollDiv > .wp-chatbot-content {
				display: flex !important;
				flex-direction: column;
				flex: 1 1 auto !important;
				min-height: 0 !important;
				height: auto !important;
				max-height: none !important;
				overflow-x: hidden;
				overflow-y: auto;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container:not(:has(.wavemain)) > .wp-chatbot-start-header {
				height: auto !important;
				min-height: 0 !important;
				flex-shrink: 0;
				position: sticky !important;
				top: 0 !important;
				z-index: 20;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container:not(:has(.wavemain)) .wp-chatbot-start-header-content {
				position: relative !important;
				padding-bottom: 16px !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-start-header-content {
				padding: 12px 16px 8px !important;
				margin-top: 20px !important;
				opacity: 1 !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-start-close {
				position: absolute !important;
				top: 12px !important;
				right: 10px !important;
				left: auto !important;
				transform: none !important;
				opacity: 1 !important;
				z-index: 30 !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-header {
				position: sticky !important;
				top: 0 !important;
				z-index: 20;
				flex-shrink: 0;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container:has(.wavemain) > section.wavemain {
				position: sticky !important;
				top: 0 !important;
				bottom: auto !important;
				left: 0 !important;
				right: 0 !important;
				width: 100% !important;
				height: 160px !important;
				max-height: 160px !important;
				margin: 0 0 -160px !important;
				border-radius: 0;
				pointer-events: none;
				overflow: hidden;
				z-index: 1;
				flex-shrink: 0;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container:has(.wavemain) > .wp-chatbot-start-header {
				height: 140px !important;
				min-height: 0 !important;
				flex-shrink: 0;
				overflow: visible;
				padding-top: 4px;
				padding-bottom: 0;
				position: sticky !important;
				top: 0 !important;
				z-index: 20;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container:has(.wavemain) .wp-chatbot-start-header-content {
				position: relative !important;
				top: auto !important;
				z-index: 2;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-start-screen-content {
				margin-top: 4px !important;
				padding-bottom: 28px !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-start-content-single:last-child {
				margin-bottom: 16px !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li {
				min-height: 0 !important;
				padding: 0 !important;
				overflow: hidden;
				background: #fff;
				line-height: 0;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li a.wp-chatbot-product-url {
				display: block;
				position: relative;
				text-decoration: none;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li img {
				width: 100% !important;
				max-width: 100% !important;
				height: 140px !important;
				min-height: 140px !important;
				max-height: 140px !important;
				object-fit: cover !important;
				object-position: center center !important;
				display: block !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary {
				position: relative !important;
				top: auto !important;
				right: auto !important;
				bottom: auto !important;
				left: auto !important;
				height: auto !important;
				min-height: 0 !important;
				visibility: visible !important;
				padding: 8px 8px 9px !important;
				display: block !important;
				background: #fff !important;
				text-align: left;
				z-index: 1;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary .wp-chatbot-product-table,
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary .wp-chatbot-product-table-cell {
				height: auto !important;
				min-height: 0 !important;
				display: block !important;
				width: 100%;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary h3.wp-chatbot-product-title {
				margin: 0 0 3px !important;
				max-height: none !important;
				background: none;
				color: #1d2433 !important;
				display: block;
				padding: 0;
				border-radius: 0;
				font-size: 12px;
				line-height: 1.3;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary .price,
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary .price span,
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary .price bdi,
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary .price ins,
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary .price del {
				display: inline !important;
				font-size: 12px !important;
				line-height: 1.2 !important;
				color: #1f75b3 !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .wp-chatbot-products-area ul li .wp-chatbot-product-summary .price del {
				color: #8a93a3 !important;
				margin-right: 4px;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-content {
				position: relative !important;
				z-index: 2;
				top: auto !important;
				right: auto !important;
				bottom: auto !important;
				left: auto !important;
				display: block !important;
				flex: 1 1 auto !important;
				min-height: 0 !important;
				height: auto !important;
				max-height: none !important;
				overflow-x: hidden !important;
				overflow-y: auto !important;
				overscroll-behavior: contain;
				touch-action: pan-y;
				-webkit-overflow-scrolling: touch;
				pointer-events: auto !important;
				padding-bottom: 24px;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container:has(.wavemain) > .wp-chatbot-start-content {
				top: 5px !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-content .slimScrollDiv,
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-content .wp-chatbot-start-screen,
			#wp-chatbot-chat-container .wp-chatbot-start-container > .wp-chatbot-start-content .wp-chatbot-start-screen-content {
				position: relative !important;
				top: auto !important;
				right: auto !important;
				bottom: auto !important;
				left: auto !important;
				display: block !important;
				flex: none !important;
				min-height: 0 !important;
				height: auto !important;
				max-height: none !important;
				margin-top: 0 !important;
				overflow: visible !important;
			}
			#wp-chatbot-chat-container .wp-chatbot-start-container .slimScrollBar,
			#wp-chatbot-chat-container .wp-chatbot-start-container .slimScrollRail {
				display: none !important;
			}
			#wp-chatbot-chat-container.wp-chatbot-is-expanded #wp-chatbot-board-container.active-chat-board,
			#wp-chatbot-chat-container.wp-chatbot-is-expanded .wp-chatbot-start-container,
			#wp-chatbot-chat-container .wp-chatbot-is-expanded#wp-chatbot-board-container.active-chat-board,
			#wp-chatbot-chat-container .wp-chatbot-is-expanded.wp-chatbot-start-container {
				--wpbot-window-height: calc(80vh + 100px);
				--wpbot-window-height: calc(80dvh + 100px);
			}
			@media screen and (min-height: 1081px) {
				#wp-chatbot-chat-container
				 {
					--wpbot-window-height: calc(680px);
				}


				#wp-chatbot-chat-container.wp-chatbot-is-expanded,
				#wp-chatbot-chat-container.wp-chatbot-is-expanded #wp-chatbot-board-container.active-chat-board,
				#wp-chatbot-chat-container.wp-chatbot-is-expanded .wp-chatbot-start-container,
				#wp-chatbot-chat-container .wp-chatbot-is-expanded#wp-chatbot-board-container.active-chat-board,
				#wp-chatbot-chat-container .wp-chatbot-is-expanded.wp-chatbot-start-container {
					--wpbot-window-height: calc(680px + 100px);
				}

			}
			@media screen and (max-width: 767px) {
				#wp-chatbot-chat-container {
					--wpbot-window-height: 100vh;
					--wpbot-window-height: 100dvh;
				}
				#wp-chatbot-chat-container.wp-chatbot-mobile-full-screen.wp-chatbot-mobile-chat-open #wp-chatbot-board-container.active-chat-board,
				#wp-chatbot-chat-container.wp-chatbot-mobile-full-screen.wp-chatbot-mobile-chat-open .wp-chatbot-start-container {
					--wpbot-window-height: 100vh;
					--wpbot-window-height: 100dvh;
				}
			}
			
/*# sourceURL=qcld-wp-chatbot-common-style-inline-css */
