<style id="wp-custom-css">
.w3eden a {
    color: #BD9A5F;
}
.w3eden .btn-primary {
    color: #ffffff;
    background-color: #BD9A5F;
    border-color: #BD9A5F;
}
.w3eden .btn-primary:hover {
    border-color: #000000;
}



.w3eden .media-body{
    color: #000000;
    font-weight: 700;
}
body.custom-background {
    background-color: #BD9A5F !important;
}


.header-inner .custom-container {
    float: right;
}
.footer-middle-wrap {
	  width:100% !important;
}

.elementor-tab-content {
    color: #000000;
    background-color: #ffffff;
    border: none !important;
}
body .job-listing .job-preview .job-cta .apply-btn {
    background-color: #BD9A5F;
    width: 180px;
	  float:right;
}
.awsm-selectric {
