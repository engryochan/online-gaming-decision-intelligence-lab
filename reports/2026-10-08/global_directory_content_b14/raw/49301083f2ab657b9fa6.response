    border: none !important;
}
.menu a {
	color: #ffffff !important;
}
.menu a:hover {
    color: #BD9A5F !important;
}


/*Complaints form*/
.nav-item-inner a.egovenz-popup-trigger.btn {
    vertical-align: inherit;
    background: #BD9A5F;
		color:#ffffff;
}
/*Procurement Listing*/
.jobwp-listing-top {
    display: none;
}

jobwp-listing-body-container .jobwp-item {
    border: 1px solid #BD9A5F !important;
    background-color: #FFF;
}
