<style>
  .skeleton {
    background: linear-gradient(
      -90deg,
      rgba(0, 0, 0, 0.05) 0%,
      rgba(0, 0, 0, 0.1) 50%,
      rgba(0, 0, 0, 0.05) 100%
    );
    background-size: 400% 400%;
    animation: pulse 1.2s ease-in-out infinite;
  }

  .skeleton .a-inner-text,
  .skeleton .aps-0208-rd-off,
  .skeleton .aps-0208-rd-on,
  .skeleton .aps-0208-rd-label {
    color: transparent !important;
    background-color: transparent !important;
    border-color: transparent !important;
  }

  .skeleton a {
    background-color: transparent !important;
    background-size: 0px !important;
  }

  .skeleton a picture {
    display: none;
  }

  @keyframes pulse {
    0% {
      background-position: 0% 0%;
    }
    100% {
      background-position: -135% 0%;
    }
  }
</style>

<!-- search-bar-css.html -->
<style>
  #row-search-bar .aps-0200-so-field-wrap {
    margin-bottom: 0px !important;
  }

  #row-search-bar input::placeholder {
    color: rgba(126, 126, 126, 1) !important;
  }

  #row-search-bar #row-search-filter, #row-search-bar {
    max-height: 100vh;
    transition: max-height 0.5s ease-in-out;
  }

  #row-search-bar:not(:focus-within) #row-search-filter:not(:hover) {
    max-height: 0;
  }

  #search-row.started #row-search-bar {
    max-height: 38px;
  }
</style>

<!-- search-page-css.html -->
<style>
  #starter-row {
    max-height: 100vh;
    transition: max-height 1.0s ease-in-out;
  }

  #starter-row.started {
    max-height: 0;
  }

  #starter-row.queried {
    display: none;
  }

  #result-row {
    max-height: 0;
    transition: max-height 0.5s ease-in-out;
  }

  #result-row.started {
    max-height: 400vh;
  }
</style>
