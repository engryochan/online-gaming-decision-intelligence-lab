                                newCell.innerHTML = `<a href='companyInfo?member_info=${dataTable[i_col]['member_id']}'> ${dataTable[i_col]['member_name'] }</a>`;
                            }

                            newCell = newRow.insertCell()
                            newCell.setAttribute("title",dataHeader[4]);
                            newCell.innerHTML =dataTable[i_col]['status'];
                            if( dataTable[i_col]['corporate_actions'] == '1')
                            {
                                newCell = newRow.insertCell();
                                newCell.setAttribute("style", "color:green;");
                                newCell.setAttribute("title",dataHeader[5]);
                                newCell.innerHTML = `<a href="corporateAction?member_info=${dataTable[i_col]['member_id']}">${ moreLink }</a>`;
                            }
                            else
                            {
                            newCell = newRow.insertCell();
                            newCell.setAttribute("title",dataHeader[4]);
                            newCell.innerHTML = `-`;
                            }


                        }
                    }
                    else
                        {

                            for( i_col = 0 ; i_col < dataTable.length ; i_col++)
                            {
                                var newRow = tbodyRef.insertRow();
                                newCell = newRow.insertCell().appendChild(document.createTextNode(dataTable[i_col]['serial']));
                                newCell = newRow.insertCell();
                                newCell.setAttribute("title",dataHeader[1]);
                                newCell.innerHTML = `<a href='companyInfo?member_info=${dataTable[i_col]['member_id']}'> ${dataTable[i_col]['member_id'] }</a>`;
                                newCell = newRow.insertCell();
                                newCell.setAttribute("title",dataHeader[2]);
                                newCell.innerHTML = `<a href='securityInformation?security_id=${dataTable[i_col]['member_id']}'> ${dataTable[i_col]['reuter_code'] }</a>`;
                                newCell = newRow.insertCell();
                                newCell.setAttribute("title",dataHeader[3]);
                                 if(lang=='en')
                                {
                                    newCell.innerHTML = `<a href='companyInfo?member_info=${dataTable[i_col]['member_id']}'> ${dataTable[i_col]['member_ename'] }</a>`;
                                }
                                else
                                {
                                    newCell.innerHTML = `<a href='companyInfo?member_info=${dataTable[i_col]['member_id']}'> ${dataTable[i_col]['member_name'] }</a>`;
