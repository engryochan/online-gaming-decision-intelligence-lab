<script>
    $(function() {
        $(document).ready(function() {

            var TableId = ['public_shareholding_companies'];
            $('#excell').click(function() {
                var filename = document.querySelector('.inner-image h1.page-title').innerHTML;
                fnExcelReport(TableId, filename);
            });
        });

        waitForElm('#public_shareholding_companies').then((elm) => {
                $('#current').click();

            const queryString = window.location.search;
            const urlParams = new URLSearchParams(queryString);
            if(urlParams.has("members_status"))
            {
                if(urlParams.get("members_status") == "old")
                {
                     $('#previous').click();
                }
                else
                {
                     $('#current').click();

                }
            }

            if(urlParams.has("priview"))
            {
                if(urlParams.has("status"))
                {
                    if(urlParams.get("status") == "current")


                     {  $('#current').click();}
                        else
                    {

                     $('#previous').click();
                    }

                }

            }

            $('#customPrintRiview').click(function () {
                    const inputs = document.querySelectorAll('input.active');

                    // Iterate through each input element
                    inputs.forEach(input => {
                    // Get the name attribute value of each input
                    const name = input.getAttribute('name');

                        if(name == "current")
                        {
                            urL = window.location + '&status=current&priview=1'
                            window.open(urL);

                        }
                        else
                        {
                            urL = window.location + '&status=previous&priview=1'
                            window.open(urL);
                        }
                    });
            });
            $('#customPrint').click(function () {
                    const inputs = document.querySelectorAll('input.active');

                    // Iterate through each input element
                    inputs.forEach(input => {
                    // Get the name attribute value of each input
                    const name = input.getAttribute('name');

                        if(name == "current")
                        {
                            urL = window.location + '&status=current&priview=1&print=1'
                            window.open(urL);

                        }
                        else
                        {
                            urL = window.location + '&status=previous&priview=1&print=1'
                            window.open(urL);
                        }
                    });
            });

        });





    $('.table-warrper input.btn').click(function(){
        $('.table-warrper input').removeClass('active');
        $(this).addClass('active');

    });
     });
            var lang = document.documentElement.lang;

            function getTable(typ)
