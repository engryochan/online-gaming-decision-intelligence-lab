</div>

        
    


        </div>
    </div>
</div>
</div>

        
    
        
        
            
            
            
            
            <div class="cc-wrapper O-COLCTRL-RW-DEV">
    

<div id="content_main_columnControl_73">
    
    <div class="cc cc-columns-50-50  ">
        
        <div id="content_main_columnControlColumn_144" class="cc-column">
            




    
        
        
            
            
            
            
            <div class="M-CONTMAST-RW-RBWM O-SMARTSPCGEN-DEV rich-text"><div id="content_main_richtext_64" class=" A-PAR16R-RW-ALL-WRAPPER" data-date-format="D/M/YYYY" data-time-format="HH:MM:SS A" data-zone="Hongkong">
    <p class="A-PAR16R-RW-ALL">Step 3:&nbsp;Select 'Continue' and proceed to verify your identity with your passport.</p>
<p class="A-PAR16R-RW-ALL"><strong>Tip:</strong></p>
<p class="A-PAR16R-RW-ALL">If you don't have an eligible passport, you can see <a href="/campaigns/prom203/#register-with-your-account-details" target="_self">how to register with your account details</a>.</p>
</div></div>

        
    


        </div>
    
        
