    <div id="content_main_advanced_expander_1" class="sm-12 clear-float">
        
    <div class="anchor" id="accordion-log-on-with-security-code-on-trusted-browser-i-am-new-to-digital"></div>

        
    
    <div class="A-EXPCNT-RW-RBWM expander">
        <div class="dropdown" aria-controls="727141028__panel0" role="button" tabindex="0">
            <h3 id="727141028__tab0" class="dropdown-text ">I&#39;m new to HSBC Digital Banking (HKID holder)&nbsp;</h3>
            <span class="chevron"></span>
        </div>
        <section id="727141028__panel0" class="exp-content " aria-hidden="true" tabindex="-1">
            <div class="exp-panel">




    
        
        
            
            
            
            
            <div class="cc-wrapper O-COLCTRL-RW-DEV">
    

<div id="content_main_columnControl_5">
    
    <div class="cc cc-columns-66-33  ">
        
