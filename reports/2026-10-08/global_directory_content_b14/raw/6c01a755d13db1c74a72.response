            <div class="M-CONTMAST-RW-RBWM O-SMARTSPCGEN-DEV rich-text"><div id="content_main_richtext_17" class=" A-PAR16R-RW-ALL-WRAPPER" data-date-format="D/M/YYYY" data-time-format="HH:MM:SS A" data-zone="Hongkong">
    <p class="A-PAR16R-RW-ALL">Step 4:&nbsp;Choose 'Exit-Entry Permit (EEP)' for document type and enter your EEP number for 'Document number'.</p>
</div></div>

        
    


