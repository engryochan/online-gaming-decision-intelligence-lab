    <picture id="content_main_image_56">
        
        
        
        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/19320-step6-en-v2-1600x900.jpg 1x" media="(min-width: 960px)"/>
        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/19320-step6-en-v2-1600x900.jpg/jcr:content/renditions/cq5dam.web.1220.1000.jpeg 1x" media="(min-width: 480px)"/>
