        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/19320-step5-en-v2-1600x900.jpg/jcr:content/renditions/cq5dam.web.490.1000.jpeg 1x, /content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/19320-step5-en-v2-1600x900.jpg/jcr:content/renditions/cq5dam.web.1220.1000.jpeg 2x"/>
        
