    <picture id="content_main_image_356">
        
        
        
        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/pwsimg-7542/7542-step4-trust-en-1600x900.jpg/jcr:content/renditions/cq5dam.web.1280.1280.jpeg 1x" media="(min-width: 960px)"/>
        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/pwsimg-7542/7542-step4-trust-en-1600x900.jpg/jcr:content/renditions/cq5dam.web.1220.1000.jpeg 1x" media="(min-width: 480px)"/>
        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/pwsimg-7542/7542-step4-trust-en-1600x900.jpg/jcr:content/renditions/cq5dam.web.490.1000.jpeg 1x, /content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/pwsimg-7542/7542-step4-trust-en-1600x900.jpg/jcr:content/renditions/cq5dam.web.1220.1000.jpeg 2x"/>
        
    <img id="content_main_image_357" class="A-IMAGE-RW-ALL smart-image-img" src="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/pwsimg-7542/7542-step4-trust-en-1600x900.jpg/_jcr_content/renditions/cq5dam.web.1280.1280.jpeg" alt/>

