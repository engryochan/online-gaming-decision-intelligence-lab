        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/13524-screen-2-en-1600x900.jpg 1x" media="(min-width: 960px)"/>
        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/13524-screen-2-en-1600x900.jpg/jcr:content/renditions/cq5dam.web.1220.1000.jpeg 1x" media="(min-width: 480px)"/>
        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/13524-screen-2-en-1600x900.jpg/jcr:content/renditions/cq5dam.web.490.1000.jpeg 1x, /content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/13524-screen-2-en-1600x900.jpg/jcr:content/renditions/cq5dam.web.1220.1000.jpeg 2x"/>
        
    <img id="content_main_image_180" class="A-IMAGE-RW-ALL smart-image-img" src="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/13524-screen-2-en-1600x900.jpg" alt/>

    </picture>
    


                
