        <source srcset="/content/dam/hsbc/hk/images/mass/way-to-bank/screenshots/19116-grab-your-passport-en-1600x900.jpg/jcr:content/renditions/cq5dam.web.1220.1000.jpeg 1x" media="(min-width: 480px)"/>
