            const themeStorageKey = 'nzx-theme';
            const defaultTheme = 'nzx-dark';
            let theme = defaultTheme;
            try {
              const storedTheme = localStorage.getItem(themeStorageKey);
              if (storedTheme === 'nzx-dark' || storedTheme === 'nzx-light') {
                theme = storedTheme;
              }
            } catch {
             console.warn('Unable to access localStorage for theme preference. Defaulting to dark theme.');
            }
            document.documentElement.classList.add(theme);
