pe":"italic"},{"type":"superscript"}],"value":"1","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"NZX Data as at 31 August 2025","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"italic"},{"type":"superscript"}],"value":"2","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"JBWere Equity Ownership Survey 2020","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[{"type":"italic"},{"type":"superscript"}],"value":"3","nodeType":"text"},{"data":{},"marks":[{"type":"italic"}],"value":"Includes FCG's transfer to the NZX Main Board in January 2025 ","nodeType":"text"}],"nodeType":"paragraph"},{"data":{},"content":[{"data":{},"marks":[],"value":"","nodeType":"text"}],"nodeType":"paragraph"}],"nodeType":"document"}},"sys":{"id":"e0pR8","type":"Entry"}},"backlink":{"label":"Home: Learning Centre ","href":"/learning"},"sideNav":[{"name":"Equity","url":"/learning/issuer-participant-resources/listing-on-nzx-markets/equity"},{"name":"Funds","url":"/learning/issuer-participant-resources/listing-on-nzx-markets/funds"},{"name":"Debt","url":"/learning/issuer-participant-resources/listing-on-nzx-markets/debt"},{"name":"Foreign Exempt Issuers","url":"/learning/issuer-participant-resources/listing-on-nzx-markets/nzx-foreign-exempt"},{"name":"Case studies","url":"/learning/issuer-participant-resources/listing-on-nzx-markets/case-studies"},{"name":"NZX Issuer Update","url":"/learning/issuer-participant-resources/listing-on-nzx-markets/nzx-issuer-update"},{"name":"Listing Fees","url":"/learning/issuer-participant-resources/listing-on-nzx-markets/listing-fees"},{"name":"Contacts","url":"/learning/issuer-participant-resources/listing-on-nzx-markets/contacts"}],"logo":null,"defaultLogo":{"src":"//images.ctfassets.net/m5mydry9e35f/4trAnuVHa6sWDroeXOipBC/a3d6da7bd9b989d85c687879b35b74fd/nzx_logo_no_black.svg?w=390\u0026h=110","width":120,"height":32,"alt":"NZX Logo (no black) ","link":"/"},"bannerStyle":"default","quickLinks":[{"path":"/learning/education-onboarding/farmer-education","label":"Farmer Education "},{"path":"/learning/issuer-participant-resources/issuer-training-modules","label":"Issuer Training Modules"},{"path":"/learning/help-reference/education-resource-centre","label":"Education Resource Centre "}],"draftMode":false,"indicesContentfulData":[{"fields":{"isin":"NC50","name":"S\u0026P/NZX 50 Portfolio Index","code":"SPNZXNC50TR","position":3,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The index comprises the same constituents as the S\u0026P/NZX 50 Index, but with a 5% cap on the float-adjusted market capitalization. The capped methodology is designed to provide exposure to a diversified portfolio that is more aligned with what a retail investor may hold. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.spindices.com/indices/equity/sp-nzx-50-portfolio-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]}]}},"sys":{"id":"2Y9oEz1XzlkAIjZDfM5uzB","type":"Entry"}},{"fields":{"isin":"ALL","name":" S\u0026P/NZX All Index","code":"SPNZXALLTR","position":7,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The index is considered the total market indicator for the New Zealand \nequity market. It comprises all eligible securities quoted on the NZX \nMain Board (NZSX). Constituents are not screened for liquidity.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.spindices.com/indices/equity/sp-nzx-all-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":" ","marks":[],"data":{}}]}]}},"sys":{"id":"4FCSH9qCt5AyfdjdBOFmhU","type":"Entry"}},{"fields":{"isin":"NZ50","name":"S\u0026P/NZX 50 Index","code":"SPNZXNZ50TR","position":1,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The index is designed to measure the performance of the 50 largest, eligible stocks listed on the Main Board (NZSX) of the NZX by float-adjusted market capitalization. Representative, liquid, and investable, it is widely considered New Zealand's preeminent benchmark index. The index is float-adjusted, covering approximately 90% of New Zealand equity market capitalization.","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.spindices.com/indices/equity/sp-nzx-50-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"\n\n","marks":[],"data":{}}]}]}},"sys":{"id":"6czPf2WqtDpUuNr1VrZoub","type":"Entry"}},{"fields":{"isin":"NZ20","name":"S\u0026P/NZX 20 Index","code":"SPNZXNZ20","position":2,"type":"Indices","description":{"nodeType":"document","data":{},"content":[{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"The index is designed to measure the performance of 20 of the largest and most liquid companies in the S\u0026P/NZX 50 Index. ","marks":[],"data":{}}]},{"nodeType":"paragraph","data":{},"content":[{"nodeType":"text","value":"","marks":[],"data":{}},{"nodeType":"hyperlink","data":{"uri":"https://www.spindices.com/indices/equity/sp-nzx-20-index"},"content":[{"nodeType":"text","value":"Read more","marks":[],"data":{}}]},{"nodeType":"text","value":"","marks":[],"da