                    </li>
                    <li role="presentation" class="nav-item border rounded-0">
                        <a class="nav-link border rounded-0" href="https://mse.co.mw/listing/debt/benefits">Benefits of Listing</a>
                    </li>
                </ul>
                <div class="tab-content ">
                    <div class="container">
                        <div class="" id="tab-content">

                        </div>
                    </div>
                </div>
            </div>

            <script type="text/javascript">
                $(".nav-tabs.mse  li a").on("click",function (e) {
                    e.preventDefault();
                    $(".nav-tabs.mse  li a").removeClass("active");
                    var link = $(this).attr("href");
                    var comp = $(this);
                    $.ajax({
                        url: link,
                        type: 'get',
                        dataType: 'html',
                        beforeSend: function() {
                            $(this).button('loading');
                        },
                        complete: function() {
                            $(this).button('reset');
                        },
                        success: function(html) {
                            comp.addClass("active");
                            $("#tab-content").html(html);
                        },
                        error: function(xhr, ajaxOptions, thrownError) {
                            //alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                            $("#tab-content").html(xhr.responseText);
                        }
                    });
                })

                $(".nav-tabs.mse  li:first-child a").trigger("click");
            </script>
            
        </div>

    </div>
</div>
