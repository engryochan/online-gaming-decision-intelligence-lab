tic/immutable/chunks/0s5wh6skyzmrt.js\",\"/_next/static/immutable/chunks/3zss9oidp0l3h.js\",\"/_next/static/immutable/chunks/33g8fb465u1iq.js\",\"/_next/static/immutable/chunks/0hh1fwogfw41z.js\",\"/_next/static/immutable/chunks/2jgicypq8f55r.js\"],\"BylineShareRow\"]\n43:I[329819,[\"/_next/static/immutable/chunks/0plqxuqrq1by5.js\",\"/_next/static/immutable/chunks/40y0czn93dmv1.js\",\"/_next/static/immutable/chunks/0704gjgg8f5xo.js\",\"/_next/static/immutable/chunks/0dlv6se8k4fka.js\",\"/_next/static/immutable/chunks/2sljlcitmfphu.js\",\"/_next/static/immutable/chunks/0s5wh6skyzmrt.js\",\"/_next/static/immutable/chunks/3zss9oidp0l3h.js\",\"/_next/static/immutable/chunks/33g8fb465u1iq.js\",\"/_next/static/immutable/chunks/0hh1fwogfw41z.js\",\"/_next/static/immutable/chunks/2jgicypq8f55r.js\"],\"ReadMoreModule\"]\n38:[\"$\",\"li\",\"/news/georgia-international-igaming-license-launch\",{\"className\":\"flex items-center hidden min-w-0 sm:flex\",\"children\":[[\"$\",\"span\",null,{\"className\":\"shrink-0 px-1\",\"style\":{\"color\":\"var(--nr2-muted)\"},\"aria-hidden\":true,\"children\":\"/\"}],[\"$\",\"span\",null,{\"aria-current\":\"page\",\"className\":\"truncate\",\"style\":{\"color\":\"var(--nr2-muted)\"},\"children\":\"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan\"}]]}]\n39:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://www.fairgambling.com/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"News\\\",\\\"item\\\":\\\"https://www.fairgambling.com/news\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":3,\\\"name\\\":\\\"Licensing \\\\u0026 Enforcement\\\",\\\"item\\\":\\\"https://www.fairgambling.com/news?cat=Licensing%20%26%20Enforcement\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":4,\\\"name\\\":\\\"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan\\\"}]}\"}}]\n3a:[\"$\",\"$L41\",null,{\"a\":{\"id\":217,\"collection\":\"news-posts\",\"slug\":\"georgia-international-igaming-license-launch\",\"title\":\"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan\",\"dek\":\"The international license bars Georgian citizens, charges 5% of casino revenue and bundles in bank accounts and card processing. Crypto payments are not allowed yet, and no licensee has been named.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2.jpg\",\"alt\":\"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2-256x256.jpg\"},\"category\":{\"name\":\"Licensing \u0026 Enforcement\",\"slug\":\"licensing-enforcement\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"https://cdn.fairgambling.com/news/Francis_Gable_Avatar-256x256.png\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3a:props:a:author\"],\"body\":{\"root\":{\"type\":\"root\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Georgia's new license for offshore online casinos is fully running, the company that oversees gambling for the country's government said on Sept. 28, with Georgian bank accounts and card payments built in.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The offer is aimed squarely at the offshore sites many crypto players use. Licensees pay \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"5% of gross gaming revenue\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\", the money a casino keeps after paying out wins, plus a 1% monitoring fee, according to the \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"link\",\"fields\":{\"url\":\"https://gisg.ge/\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"published terms\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"mode\":\"normal\",\"text\":\" of Georgia International Strategic Group (GISG), the firm appointed to sell the license abroad. GISG compares it directly with Curaçao and Anjouan. Georgian citizens cannot play.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Georgia Promises Casinos Card Payments From Day One\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Each licensee gets a Georgian bank account and a card merchant account coded for gambling, known as \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"MCC 7995\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\", for Visa and Mastercard deposits, GISG says. It claims 20% to 40% of card deposits get declined at casinos with weak licenses, without citing a source.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Crypto is not part of the deal yet. GISG says stablecoin settlement is still in draft legislation and will be sold only once it becomes law.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"A license covers one website and one category, such as casino or betting. It costs \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"mode\":\"normal\",\"text\":\"GEL 100,000\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":1,\"version\":1},{\"mode\":\"normal\",\"text\":\" a year, about $36,000 by GISG's conversion, and runs five years. No office or staff is required in Georgia, only a director, a local address and backup servers there.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"tag\":\"h2\",\"type\":\"heading\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"The Rules Keep Georgians Out\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Lawmakers took up the bill in June as amendments to Georgia's gambling law, an English-language Tbilisi newspaper reported. Sites open to Georgians pay 20% instead. The bill's explanatory note said the change would draw foreign gambling companies while protecting local players.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"Random Systems Georgia soft-launched the regime in July. \\\"Georgia is not building another licensing jurisdiction,\\\" supervisory board member Vakhtang Katamadze said in a launch statement published by SBC News.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"GISG markets approval in 14 to 30 days. FairGambling looked at \",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1},{\"type\":\"link\",\"fields\":{\"url\":\"https://www.fairgambling.com/news/curacao-casino-license-doesnt-work-in-curacao\",\"newTab\":true,\"linkType\":\"custom\"},\"format\":\"\",\"indent\":0,\"version\":3,\"children\":[{\"mode\":\"normal\",\"text\":\"what a Curaçao license buys\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"mode\":\"normal\",\"text\":\" in September.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"},{\"type\":\"paragraph\",\"format\":\"\",\"indent\":0,\"version\":1,\"children\":[{\"mode\":\"normal\",\"text\":\"No Georgian licensee has been named. Katamadze says the first ones are preparing to go live, and GISG says it will announce further terms for operators in October.\",\"type\":\"text\",\"style\":\"\",\"detail\":0,\"format\":0,\"version\":1}],\"direction\":\"ltr\"}],\"direction\":\"ltr\"}},\"publishedAt\":\"2026-09-28T13:15:32.878Z\",\"updatedAt\":\"2026-09-28T13:16:25.925Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":2,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"Georgia Pitches Offshore Casino License Against Curaçao\",\"description\":\"Georgia's international casino license bars locals, taxes 5% of revenue and bundles in card payments. Crypto settlement still awaits a new law.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2.jpg\",\"alt\":\"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"}}]\n3b:[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 md:gap-4 min-[1024px]:flex-1\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-5\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"break-words text-[32px] leading-[40px]\",\"style\":{\"fontFamily\":\"var(--font-inter)\",\"fontWeight\":600,\"letterSpacing\":\"-0.64px\",\"color\":\"var(--nr2-ink)\"},\"children\":\"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan\"}],[\"$\",\"p\",null,{\"className\":\"break-words\",\"style\":{\"fontSize\":16,\"lineHeight\":\"24px\",\"fontWeight\":400,\"letterSpacing\":\"-0.16px\",\"fontFamily\":\"var(--font-inter)\",\"color\":\"var(--nr2-body)\"},\"children\":\"The international license bars Georgian citizens, charges 5% of casino revenue and bundles in bank accounts and card processing. Crypto payments are not allowed yet, and no licensee has been named.\"}]]}],null]}]\n3c:[\"$\",\"div\",null,{\"className\":\"relative mt-8 aspect-[2/1] w-full overflow-hidden bg-[var(--nr2-surface)] sm:mt-10\",\"style\":{\"borderRadius\":6},\"children\":[\"$\",\"$L16\",null,{\"src\":\"https://cdn.fairgambling.com/news/georgia-international-igaming-license-launch-cover-2-1600x800.jpg\",\"alt\":\"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan\",\"fill\":true,\"priority\":true,\"sizes\":\"(max-width: 880px) 100vw, 820px\",\"className\":\"object-cover\"}]}]\n3d:[\"$\",\"div\",null,{\"className\":\"mt-8 sm:mt-10\",\"children\":[\"$\",\"$L42\",null,{\"authors\":[{\"name\":\"Francis Gable\",\"avatarUrl\":\"https://cdn.fairgambling.com/news/Francis_Gable_Avatar-256x256.png\",\"href\":\"/news/authors/francis-gable\"}],\"dateLabel\":\"September 28, 2026\",\"dateIso\":\"2026-09-28T13:15:32.878Z\",\"readingMinutes\":2,\"title\":\"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan\",\"url\":\"https://www.fairgambling.com/news/georgia-international-igaming-license-launch\"}]}]\n3e:[\"$\",\"div\",null,{\"className\":\"mt-5\",\"children\":[[\"$\",\"div\",null,{\"className\":\"nr-prose-v2\",\"children\":[[[\"$\",\"p\",\"0\",{\"children\":[\"Georgia's new license for offshore online casinos is fully running, the company that oversees gambling for the country's government said on Sept. 28, with Georgian bank accounts and card payments built in.\"]}],[\"$\",\"p\",\"1\",{\"children\":[\"The offer is aimed squarely at the offshore sites many crypto players use. Licensees pay \",[\"$\",\"strong\",\"1\",{\"children\":\"5% of gross gaming revenue\"}],\", the money a casino keeps after paying out wins, plus a 1% monitoring fee, according to the \",[\"$\",\"a\",\"3\",{\"href\":\"https://gisg.ge/\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":[\"published terms\"]}],\" of Georgia International Strategic Group (GISG), the firm appointed to sell the license abroad. GISG compares it directly with Curaçao and Anjouan. Georgian citizens cannot play.\"]}],[\"$\",\"h2\",\"2\",{\"id\":\"georgia-promises-casinos-card-payments-from-day-one\",\"children\":[\"Georgia Promises Casinos Card Payments From Day One\"]}],[\"$\",\"p\",\"3\",{\"children\":[\"Each licensee gets a Georgian bank account and a card merchant account coded for gambling, known as \",[\"$\",\"strong\",\"1\",{\"children\":\"MCC 7995\"}],\", for Visa and Mastercard deposits, GISG says. It claims 20% to 40% of card deposits get declined at casinos with weak licenses, without citing a source.\"]}],[\"$\",\"p\",\"4\",{\"children\":[\"Crypto is not part of the deal yet. GISG says stablecoin settlement is still in draft legislation and will be sold only once it becomes law.\"]}],[\"$\",\"p\",\"5\",{\"children\":[\"A license covers one website and one category, such as casino or betting. It costs \",[\"$\",\"strong\",\"1\",{\"children\":\"GEL 100,000\"}],\" a year, about $36,000 by GISG's conversion, and runs five years. No office or staff is required in Georgia, only a director, a local address and backup servers there.\"]}],[\"$\",\"h2\",\"6\",{\"id\":\"the-rules-keep-georgians-out\",\"children\":[\"The Rules Keep Georgians Out\"]}],[\"$\",\"p\",\"7\",{\"children\":[\"Lawmakers took up the bill in June as amendments to Georgia's gambling law, an English-language Tbilisi newspaper reported. Sites open to Georgians pay 20% instead. The bill's explanatory note said the change would draw foreign gambling companies while protecting local players.\"]}],[\"$\",\"p\",\"8\",{\"children\":[\"Random Systems Georgia soft-launched the regime in July. \\\"Georgia is not building another licensing jurisdiction,\\\" supervisory board member Vakhtang Katamadze said in a launch statement published by SBC News.\"]}],[\"$\",\"p\",\"9\",{\"children\":[\"GISG markets approval in 14 to 30 days. FairGambling looked at \",[\"$\",\"a\",\"1\",{\"href\":\"https://www.fairgambling.com/news/curacao-casino-license-doesnt-work-in-curacao\",\"rel\":\"noopener noreferrer\",\"target\":\"_blank\",\"children\":[\"what a Curaçao license buys\"]}],\" in September.\"]}],[\"$\",\"p\",\"10\",{\"children\":[\"No Georgian licensee has been named. Katamadze says the first ones are preparing to go live, and GISG says it will announce further terms for operators in October.\"]}]],[\"$\",\"p\",null,{\"children\":[\"$\",\"em\",null,{\"children\":\"Treat gambling as entertainment you pay for. 18+, and if it stops feeling like entertainment, help exists at BeGambleAware and GamCare.\"}]}]]}],false]}]\n3f:[\"$\",\"$L43\",null,{\"stories\":[{\"id\":234,\"collection\":\"news-posts\",\"slug\":\"stake-canada-alberta-launch-licensed\",\"title\":\"Stake Plans Alberta Launch as Province's Grey-Market Deadline Nears\",\"dek\":\"Stake Canada is registered with Alberta's regulator and says it now holds a license. Its launch lands days before unlicensed operators must leave the province on Oct. 13.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/stake-canada-alberta-launch-licensed-cover-2.jpg\",\"alt\":\"Stake Sets Alberta Launch as Province's Grey-Market Deadline Nears\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/stake-canada-alberta-launch-licensed-cover-2-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/stake-canada-alberta-launch-licensed-cover-2-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/stake-canada-alberta-launch-licensed-cover-2-256x256.jpg\"},\"category\":{\"name\":\"Licensing \u0026 Enforcement\",\"slug\":\"licensing-enforcement\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"$undefined\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3f:props:stories:0:author\"],\"body\":\"$undefined\",\"publishedAt\":\"2026-10-08T00:34:39.707Z\",\"updatedAt\":\"2026-10-08T00:42:56.085Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":2,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"Stake Sets Alberta Launch Ahead of Grey-Market Deadline\",\"description\":\"Stake Canada will launch a licensed casino and sportsbook in Alberta days before the province's Oct. 13 deadline for unlicensed operators.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/stake-canada-alberta-launch-licensed-cover-2.jpg\",\"alt\":\"Stake Sets Alberta Launch as Province's Grey-Market Deadline Nears\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/stake-canada-alberta-launch-licensed-cover-2-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/stake-canada-alberta-launch-licensed-cover-2-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/stake-canada-alberta-launch-licensed-cover-2-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"},{\"id\":235,\"collection\":\"news-posts\",\"slug\":\"cambodia-joint-casino-inspections-online-gambling\",\"title\":\"Cambodia Sends Joint Teams to Inspect Casinos for Online Gambling\",\"dek\":\"Police, immigration officers and prosecutors will check licensed casinos in 16 provinces from October 2026. Any casino caught running online betting faces sanctions and criminal charges, the gambling regulator said.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/cambodia-joint-casino-inspections-online-gambling-cover-3.jpg\",\"alt\":\"Cambodia Sends Joint Teams to Inspect Casinos for Online Gambling\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/cambodia-joint-casino-inspections-online-gambling-cover-3-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/cambodia-joint-casino-inspections-online-gambling-cover-3-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/cambodia-joint-casino-inspections-online-gambling-cover-3-256x256.jpg\"},\"category\":{\"name\":\"Licensing \u0026 Enforcement\",\"slug\":\"licensing-enforcement\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"$undefined\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3f:props:stories:1:author\"],\"body\":\"$undefined\",\"publishedAt\":\"2026-10-07T21:20:06.495Z\",\"updatedAt\":\"2026-10-07T21:20:06.506Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":2,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"Cambodia Sends Joint Teams to Inspect Casinos Nationwide\",\"description\":\"Cambodia will inspect casinos in 16 provinces from October for banned online gambling, threatening sanctions and criminal charges.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/cambodia-joint-casino-inspections-online-gambling-cover-3.jpg\",\"alt\":\"Cambodia Sends Joint Teams to Inspect Casinos for Online Gambling\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/cambodia-joint-casino-inspections-online-gambling-cover-3-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/cambodia-joint-casino-inspections-online-gambling-cover-3-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/cambodia-joint-casino-inspections-online-gambling-cover-3-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"},{\"id\":236,\"collection\":\"news-posts\",\"slug\":\"robinhood-25-million-bitcoin-balance-sheet\",\"title\":\"Robinhood Added $25 Million of Bitcoin to Its Balance Sheet\",\"dek\":\"A crypto executive disclosed the first corporate bitcoin buy at a Singapore conference. The trading app has not yet confirmed it in a filing, and its crypto revenue fell 38% in the second quarter.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/robinhood-25-million-bitcoin-balance-sheet-cover-3.jpg\",\"alt\":\"Robinhood Added $25 Million of Bitcoin to Its Balance Sheet\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/robinhood-25-million-bitcoin-balance-sheet-cover-3-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/robinhood-25-million-bitcoin-balance-sheet-cover-3-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/robinhood-25-million-bitcoin-balance-sheet-cover-3-256x256.jpg\"},\"category\":{\"name\":\"Crypto\",\"slug\":\"crypto\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"$undefined\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3f:props:stories:2:author\"],\"body\":\"$undefined\",\"publishedAt\":\"2026-10-07T17:22:15.917Z\",\"updatedAt\":\"2026-10-07T17:22:15.926Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":1,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"Robinhood Adds $25 Million in Bitcoin to Its Balance Sheet\",\"description\":\"Robinhood bought about $25 million of bitcoin for its own balance sheet, an executive said on Oct. 7, as prediction markets outearn crypto.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/robinhood-25-million-bitcoin-balance-sheet-cover-3.jpg\",\"alt\":\"Robinhood Added $25 Million of Bitcoin to Its Balance Sheet\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/robinhood-25-million-bitcoin-balance-sheet-cover-3-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/robinhood-25-million-bitcoin-balance-sheet-cover-3-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/robinhood-25-million-bitcoin-balance-sheet-cover-3-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"},{\"id\":237,\"collection\":\"news-posts\",\"slug\":\"thailand-meta-tiktok-online-gambling-working-group\",\"title\":\"Thailand Plans Meta and TikTok Working Group Against Online Gambling\",\"dek\":\"The digital ministry will turn public tips into watch lists for the platforms and police, after blocking almost 1 million gambling links in a single year.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/thailand-meta-tiktok-online-gambling-working-group-cover.jpg\",\"alt\":\"Thailand Plans Meta and TikTok Working Group Against Online Gambling\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/thailand-meta-tiktok-online-gambling-working-group-cover-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/thailand-meta-tiktok-online-gambling-working-group-cover-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/thailand-meta-tiktok-online-gambling-working-group-cover-256x256.jpg\"},\"category\":{\"name\":\"Licensing \u0026 Enforcement\",\"slug\":\"licensing-enforcement\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"$undefined\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3f:props:stories:3:author\"],\"body\":\"$undefined\",\"publishedAt\":\"2026-10-07T16:55:46.051Z\",\"updatedAt\":\"2026-10-07T16:55:46.059Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":2,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"Thailand Plans Meta, TikTok Group Against Online Gambling\",\"description\":\"Thailand will pass public tips on gambling sites to Meta, TikTok and police after blocking 945,075 gambling links in one year.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/thailand-meta-tiktok-online-gambling-working-group-cover.jpg\",\"alt\":\"Thailand Plans Meta and TikTok Working Group Against Online Gambling\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/thailand-meta-tiktok-online-gambling-working-group-cover-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/thailand-meta-tiktok-online-gambling-working-group-cover-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/thailand-meta-tiktok-online-gambling-working-group-cover-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"},{\"id\":232,\"collection\":\"news-posts\",\"slug\":\"polymarket-protocol-v2-nov-2-switch\",\"title\":\"Polymarket Unveils Protocol V2 Upgrade, Migration Begins Nov. 2\",\"dek\":\"The prediction market is replacing the 2019 contracts that hold and settle its bets, with a single dollar token as collateral and Chainlink joining UMA to decide outcomes.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/polymarket-protocol-v2-nov-2-switch-cover-3.jpg\",\"alt\":\"Polymarket unveils Protocol V2 Upgrade, Migration Begins Nov. 2\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/polymarket-protocol-v2-nov-2-switch-cover-3-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/polymarket-protocol-v2-nov-2-switch-cover-3-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/polymarket-protocol-v2-nov-2-switch-cover-3-256x256.jpg\"},\"category\":{\"name\":\"Prediction Markets\",\"slug\":\"prediction-markets\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"$undefined\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3f:props:stories:4:author\"],\"body\":\"$undefined\",\"publishedAt\":\"2026-10-06T12:44:46.715Z\",\"updatedAt\":\"2026-10-06T12:44:46.726Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":1,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"Polymarket Moves New Markets to Protocol V2 on Nov. 2\",\"description\":\"Polymarket will open new markets on rebuilt contracts from Nov. 2, with pUSD as sole collateral and a $5 million bug bounty.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/polymarket-protocol-v2-nov-2-switch-cover-3.jpg\",\"alt\":\"Polymarket unveils Protocol V2 Upgrade, Migration Begins Nov. 2\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/polymarket-protocol-v2-nov-2-switch-cover-3-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/polymarket-protocol-v2-nov-2-switch-cover-3-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/polymarket-protocol-v2-nov-2-switch-cover-3-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"},{\"id\":231,\"collection\":\"news-posts\",\"slug\":\"brazil-betting-demand-falls-78-percent-offshore-share-after-ban\",\"title\":\"Brazil Betting Demand Falls 78% in a Week as Gambling Ban Hits\",\"dek\":\"Licensed sites went offline on Oct. 6 under Lula's nationwide ban. Blask data shows most players stopped looking, but offshore brands now hold almost a quarter of what demand is left.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/brazil-betting-demand-falls-78-percent-offshore-share-after-ban-cover-2.jpg\",\"alt\":\"Brazil Betting Demand Falls 78% in a Week as Ban Hits\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/brazil-betting-demand-falls-78-percent-offshore-share-after-ban-cover-2-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/brazil-betting-demand-falls-78-percent-offshore-share-after-ban-cover-2-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/brazil-betting-demand-falls-78-percent-offshore-share-after-ban-cover-2-256x256.jpg\"},\"category\":{\"name\":\"Operators \u0026 Industry\",\"slug\":\"operators-industry\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"$undefined\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3f:props:stories:5:author\"],\"body\":\"$undefined\",\"publishedAt\":\"2026-10-06T11:34:30.054Z\",\"updatedAt\":\"2026-10-06T11:34:30.063Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":2,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"Brazil Betting Demand Falls 78% in a Week as Gambling Ban Hits\",\"description\":\"Blask data shows Brazil's betting demand fell 78.2% week on week after the ban, and offshore brands held 23.4% of what was left on Oct. 4.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/brazil-betting-demand-falls-78-percent-offshore-share-after-ban-cover-2.jpg\",\"alt\":\"Brazil Betting Demand Falls 78% in a Week as Ban Hits\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/brazil-betting-demand-falls-78-percent-offshore-share-after-ban-cover-2-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/brazil-betting-demand-falls-78-percent-offshore-share-after-ban-cover-2-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/brazil-betting-demand-falls-78-percent-offshore-share-after-ban-cover-2-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"},{\"id\":230,\"collection\":\"news-posts\",\"slug\":\"fincen-withdraws-unhosted-wallet-mixer-rules\",\"title\":\"FinCEN Drops Proposed Crypto Wallet and Mixer Reporting Rules\",\"dek\":\"The Treasury bureau abandoned a 2020 plan to log transfers to self-custody wallets above $3,000 and a 2023 plan to flag mixer use, saying the mixer rule risked curbing legitimate activity.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/fincen-withdraws-unhosted-wallet-mixer-rules-cover.jpg\",\"alt\":\"FinCEN Drops Proposed Crypto Wallet and Mixer Reporting Rules\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/fincen-withdraws-unhosted-wallet-mixer-rules-cover-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/fincen-withdraws-unhosted-wallet-mixer-rules-cover-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/fincen-withdraws-unhosted-wallet-mixer-rules-cover-256x256.jpg\"},\"category\":{\"name\":\"Crypto\",\"slug\":\"crypto\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"$undefined\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3f:props:stories:6:author\"],\"body\":\"$undefined\",\"publishedAt\":\"2026-10-06T10:20:26.794Z\",\"updatedAt\":\"2026-10-06T10:20:26.803Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":2,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"FinCEN Drops Proposed Crypto Wallet and Mixer Rules\",\"description\":\"FinCEN withdrew two crypto proposals on Oct. 5: ID checks on self-custody wallet transfers over $3,000 and reports on mixer use.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/fincen-withdraws-unhosted-wallet-mixer-rules-cover.jpg\",\"alt\":\"FinCEN Drops Proposed Crypto Wallet and Mixer Reporting Rules\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/fincen-withdraws-unhosted-wallet-mixer-rules-cover-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/fincen-withdraws-unhosted-wallet-mixer-rules-cover-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/fincen-withdraws-unhosted-wallet-mixer-rules-cover-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"},{\"id\":229,\"collection\":\"news-posts\",\"slug\":\"zachxbt-infiltrates-lazarus-laundering-network\",\"title\":\"ZachXBT Infiltrated a $1 Billion Lazarus Laundering Network\",\"dek\":\"The blockchain investigator says he posed as a client and spent $349,700 of his own money to trace funds from the Bybit hack, helping trigger freezes.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/zachxbt-infiltrates-lazarus-laundering-network-cover.jpg\",\"alt\":\"ZachXBT Says He Infiltrated a $1 Billion Lazarus Laundering Network\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/zachxbt-infiltrates-lazarus-laundering-network-cover-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/zachxbt-infiltrates-lazarus-laundering-network-cover-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/zachxbt-infiltrates-lazarus-laundering-network-cover-256x256.jpg\"},\"category\":{\"name\":\"Crypto\",\"slug\":\"crypto\"},\"author\":{\"name\":\"Francis Gable\",\"slug\":\"francis-gable\",\"avatarUrl\":\"$undefined\",\"bio\":\"Francis Gable covers the gambling industry as it happens, tracking everything from licensing decisions and legal changes to acquisitions, launches and major operator news.\",\"x\":null,\"linkedin\":null},\"authors\":[\"$3f:props:stories:7:author\"],\"body\":\"$undefined\",\"publishedAt\":\"2026-10-05T15:23:44.497Z\",\"updatedAt\":\"2026-10-05T15:23:44.504Z\",\"isBreaking\":false,\"breakingAt\":\"$undefined\",\"breakingDurationHours\":8,\"badge\":\"auto\",\"tags\":[],\"topics\":[],\"verified\":false,\"responsibleGambling\":true,\"pickOrder\":null,\"readingMinutes\":2,\"seo\":{\"metaTitle\":null,\"metaDescription\":null},\"meta\":{\"title\":\"ZachXBT Says He Infiltrated a Lazarus Laundering Network\",\"description\":\"ZachXBT says he posed as a client of a crew he alleges laundered $1 billion for North Korea, helping freeze Bybit hack funds.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/zachxbt-infiltrates-lazarus-laundering-network-cover.jpg\",\"alt\":\"ZachXBT Says He Infiltrated a $1 Billion Lazarus Laundering Network\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/zachxbt-infiltrates-lazarus-laundering-network-cover-800x400.jpg\",\"feature\":\"https://cdn.fairgambling.com/news/zachxbt-infiltrates-lazarus-laundering-network-cover-1600x800.jpg\",\"avatar\":\"https://cdn.fairgambling.com/news/zachxbt-infiltrates-lazarus-laundering-network-cover-256x256.jpg\"}},\"level\":\"$undefined\",\"kind\":\"$undefined\"},{\"id\":225,\"collection\":\"news-posts\",\"slug\":\"uk-gambling-commission-new-gaming-machine-standards\",\"title\":\"New UK Gaming Machines Must Show Your Losses. Old Ones Won't\",\"dek\":\"From June 30, 2027, new Category B machines in Britain must display session time and net wins or losses. Machines already in venues are exempt after operators objected to the upgrade costs.\",\"image\":{\"url\":\"https://cdn.fairgambling.com/news/uk-gambling-commission-new-gaming-machine-standards-cover-3.jpg\",\"alt\":\"New UK Gaming Machines Must Show Your Losses. Old Ones Won't\",\"width\":2400,\"height\":1200,\"card\":\"https://cdn.fairgambling.com/news/uk-gambling-commission-new-gaming-machine-standards-cover-3-800x400.jpg\",\"feature\":\