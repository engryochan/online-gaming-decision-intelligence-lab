pacity-80 truncate" style="color:var(--nr2-accent)" href="/news?cat=Licensing%20%26%20Enforcement">Licensing &amp; Enforcement</a></li><li class="flex items-center hidden min-w-0 sm:flex"><span class="shrink-0 px-1" style="color:var(--nr2-muted)" aria-hidden="true">/</span><span aria-current="page" class="truncate" style="color:var(--nr2-muted)">Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan</span></li></ol></nav><script type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://www.fairgambling.com/"},{"@type":"ListItem","position":2,"name":"News","item":"https://www.fairgambling.com/news"},{"@type":"ListItem","position":3,"name":"Licensing \u0026 Enforcement","item":"https://www.fairgambling.com/news?cat=Licensing%20%26%20Enforcement"},{"@type":"ListItem","position":4,"name":"Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan"}]}</script></div><div class="flex flex-col gap-6 md:gap-4 min-[1024px]:flex-1"><div class="flex flex-col gap-5"><h1 class="break-words text-[32px] leading-[40px]" style="font-family:var(--font-inter);font-weight:600;letter-spacing:-0.64px;color:var(--nr2-ink)">Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan</h1><p class="break-words" style="font-size:16px;line-height:24px;font-weight:400;letter-spacing:-0.16px;font-family:var(--font-inter);color:var(--nr2-body)">The international license bars Georgian citizens, charges 5% of casino revenue and bundles in bank accounts and card processing. Crypto payments are not allowed yet, and no licensee has been named.</p></div></div></div><div class="relative mt-8 aspect-[2/1] w-full overflow-hidden bg-[var(--nr2-surface)] sm:mt-10" style="border-radius:6px"><img alt="Georgia Pitches New Offshore Casino License Against Curaçao and Anjouan" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(max-width: 880px) 100vw, 820px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fgeorgia-international-igaming-license-launch-cover-2-1600x800.jpg&amp;w=3840&amp;q=75"/></div><div class="mt-8 sm:mt-10"><div class="flex items-center justify-between gap-2 sm:gap-6" style="font-family:var(--font-inter);letter-spacing:-0.16px"><div class="flex min-w-0 items-center gap-2 sm:gap-3"><span class="relative flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-full sm:size-11"><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="44px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=32&amp;q=75 32w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=48&amp;q=75 48w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=64&amp;q=75 64w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=96&amp;q=75 96w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=128&amp;q=75 128w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=256&amp;q=75 256w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2FFrancis_Gable_Avatar-256x256.png&amp;w=3840&amp;q=75"/></span><div class="flex min-w-0 flex-col gap-0.5"><p class="truncate text-[14px] leading-5 sm:text-[16px] sm:leading-6" style="font-weight:400"><a class="hover:opacity-70" style="color:var(--nr2-ink)" href="/news/authors/francis-gable">Francis Gable</a></p><p class="truncate text-[14px] leading-5 sm:text-[16px] sm:leading-6" style="font-weight:400;color:var(--nr2-muted)"><span class="sm:hidden"><time dateTime="2026-09-28T13:15:32.878Z">28/09/26</time> · <!-- -->2<!-- --> min</span><span class="hidden sm:inline"><time dateTime="2026-09-28T13:15:32.878Z">September 28, 2026</time> · <!-- -->2<!-- --> min read</span></p></div></div><div class="flex shrink-0 items-center"><div class="relative"><button type="button" aria-haspopup="menu" aria-expanded="false" class="inline-flex h-9 items-center gap-1.5 rounded-[10px] pl-3 pr-3.5 transition-opacity hover:opacity-80 sm:gap-2 sm:pl-3.5 sm:pr-4" style="font-size:14px;line-height:20px;font-weight:500;letter-spacing:-0.14px;background:var(--nr2-surface);color:var(--nr2-ink)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-share2 lucide-share-2" aria-hidden="true"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"></line><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"></line></svg>Share</button></div></div></div></div><div class="mt-5"><div class="nr-prose-v2"><p>Georgia&#x27;s new license for offshore online casinos is fully running, the company that oversees gambling for the country&#x27;s government said on Sept. 28, with Georgian bank accounts and card payments built in.</p><p>The offer is aimed squarely at the offshore sites many crypto players use. Licensees pay <strong>5% of gross gaming revenue</strong>, the money a casino keeps after paying out wins, plus a 1% monitoring fee, according to the <a href="https://gisg.ge/" rel="noopener noreferrer" target="_blank">published terms</a> of Georgia International Strategic Group (GISG), the firm appointed to sell the license abroad. GISG compares it directly with Curaçao and Anjouan. Georgian citizens cannot play.</p><h2 id="georgia-promises-casinos-card-payments-from-day-one">Georgia Promises Casinos Card Payments From Day One</h2><p>Each licensee gets a Georgian bank account and a card merchant account coded for gambling, known as <strong>MCC 7995</strong>, for Visa and Mastercard deposits, GISG says. It claims 20% to 40% of card deposits get declined at casinos with weak licenses, without citing a source.</p><p>Crypto is not part of the deal yet. GISG says stablecoin settlement is still in draft legislation and will be sold only once it becomes law.</p><p>A license covers one website and one category, such as casino or betting. It costs <strong>GEL 100,000</strong> a year, about $36,000 by GISG&#x27;s conversion, and runs five years. No office or staff is required in Georgia, only a director, a local address and backup servers there.</p><h2 id="the-rules-keep-georgians-out">The Rules Keep Georgians Out</h2><p>Lawmakers took up the bill in June as amendments to Georgia&#x27;s gambling law, an English-language Tbilisi newspaper reported. Sites open to Georgians pay 20% instead. The bill&#x27;s explanatory note said the change would draw foreign gambling companies while protecting local players.</p><p>Random Systems Georgia soft-launched the regime in July. &quot;Georgia is not building another licensing jurisdiction,&quot; supervisory board member Vakhtang Katamadze said in a launch statement published by SBC News.</p><p>GISG markets approval in 14 to 30 days. FairGambling looked at <a href="https://www.fairgambling.com/news/curacao-casino-license-doesnt-work-in-curacao" rel="noopener noreferrer" target="_blank">what a Curaçao license buys</a> in September.</p><p>No Georgian licensee has been named. Katamadze says the first ones are preparing to go live, and GISG says it will announce further terms for operators in October.</p><p><em>Treat gambling as entertainment you pay for. 18+, and if it stops feeling like entertainment, help exists at BeGambleAware and GamCare.</em></p></div></div></div></div><section class="nr-frame mt-10" aria-label="Read more articles"><div class="flex items-baseline justify-between gap-4 mb-4"><h2 style="font-size:18px;line-height:26px;font-weight:500;letter-spacing:-0.18px;font-family:var(--font-plex-serif);color:var(--nr2-ink)">Read More Articles</h2><a class="inline-flex shrink-0 items-center gap-1 transition-opacity hover:opacity-70 " style="font-size:16px;line-height:24px;font-weight:500;letter-spacing:-0.16px;font-family:var(--font-plex-serif);color:var(--nr2-ink)" href="/news">See more<svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 4.5 13 10l-5.5 5.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a></div><div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4"><a class="group flex min-w-0 flex-col gap-2.5 " href="/news/stake-canada-alberta-launch-licensed"><div class="relative aspect-[2/1] w-full overflow-hidden bg-[var(--nr2-surface)]" style="border-radius:6px"><img alt="Stake Sets Alberta Launch as Province&#x27;s Grey-Market Deadline Nears" loading="lazy" decoding="async" data-nimg="fill" class="object-cover transition-transform duration-300 group-hover:scale-[1.02]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 388px" srcSet="/_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fstake-canada-alberta-launch-licensed-cover-2-800x400.jpg&amp;w=384&amp;q=75 384w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2Fnews%2Fstake-canada-alberta-launch-licensed-cover-2-800x400.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.fairgambling.com%2F