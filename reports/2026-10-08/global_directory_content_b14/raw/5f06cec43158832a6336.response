  <script src="/common/js/jquery-3.6.0.min.js"></script>
  <script src="/common/include/header.js"></script>
  <script src="/common/include/footer.js"></script>
  <script src="/common/include/lnav.js"></script>
  <script src="/common/js/common.js"></script>
</head>
<body>
  <!-- ##### ヘッダー start ##### -->
  <header class="header">
    <script type="text/javascript">
      globalHeader("fullPurpose");
    </script>
  </header>
  <!-- ##### ヘッダー end ##### -->

  <!-- ##### コンテンツエリア start ##### -->
  <div class="ly-container-single">
    <!-- ##### パンくず start ##### -->
    <ul id="topic" class="pkz">
      <li class="pkz__list">
        <a href="/" class="pkz__link">ホーム</a>
      </li>
      <li id="orchid_name" class="pkz__list">安全にお取引きしていただくための「セキュリティ対策」</li>
    </ul>
    <!-- ##### パンくず end ##### -->

    <!-- ##### メインコンテンツ start ##### -->
    <main class="ly-main ly-main--wide">
      <section class="ly-contents">
        <h1 class="headline01">安全にお取引きしていただくための「セキュリティ対策」</h1>
        <div>
          <a href="/trade/passkey/index.html" class="box-caution box-caution--link" target="_self">
            <p class="box-caution__heading">パスキー認証の設定方法やよくあるご質問はこちらからご確認ください。
            </p>
          </a>
        </div>
        <div class="ly-contents__box">
          <a href="https://www.sc.mufg.jp/company/news/crime/crime00000002.html" class="box-caution box-caution--link" target="_self">
            <p class="box-caution__heading">フィッシング詐欺防止に向けた当社のセキュリティ対策
            </p>
          </a>
        </div>
        <p class="text text__leadtext">お客さまの大切なご資産と情報を守るため、当社はセキュリティ対策に注力しています。安全なお取引きのために当社のセキュリティ対策をご紹介します。</p>
        <section class="ly-contents">
          <div class="ly-contents__block box-column">
            <div class="box-3column">
              <div class="u-center">
                <p class="box-3column__heading">
                  二重パスワード
                </p>
              </div>
              <div class="box-3column__image">
                <img src="/security/img/ico_security01.png" alt="">
              </div>
              <p class="text">
                厳格な本人確認の実施のため、オンライントレードのログイン時に使用する「ログインパスワード」と、注文や入金時に使用する「取引パスワード」の二重のパスワードを導入しています。
              </p>
            </div>
            <div class="box-3column">
              <div class="u-center">
                <p class="box-3column__heading u-center">
                  強固な暗号通信
                </p>
              </div>
              <div class="box-3column__image">
                <img src="/security/img/ico_security02.png" alt="">
              </div>
              <p class="text">
                インターネット上のデータ盗用や改ざん防止のため、強固な暗号通信「TLS」を導入しています。また、当社からの情報漏えい防止のため、不正侵入を防止、検知する装置を導入しています。
              </p>
            </div>
          </div>
          <div class="ly-contents__block box-column ly-contents__block__box-3column">
            <div class="box-3column">
              <div class="u-center">
                <p class="box-3column__heading u-center">
                  出金／メールアドレス変更時の<br>ワンタイムパスワード
                </p>
              </div>
              <div class="box-3column__image">
                <img src="/security/img/ico_security03.png" alt="">
              </div>
              <p class="text">
                第三者からの不正アクセスリスクを低減するため、出金／メールアドレス変更時に従来の取引パスワード入力に加え「出金／メールアドレス変更時のワンタイムパスワード」を導入しています。ワンタイムパスワードは、スマートフォン（アプリ・WEB）・パソコンで利用登録が可能です。
              </p>
              <p class="u-center box-3column__button"><a href="/trade/otp/shukkin.html#tab02" class="button">詳細を確認する</a></p>
            </div>
            <div class="box-3column">
              <div class="u-center">
                <p class="box-3column__heading u-center">
                  パスキー認証
                </p>
              </div>
              <div class="box-3column__image">
                <img src="/security/img/ico_security04.png" alt="">
              </div>
              <p class="text">
                第三者からの不正ログインや取引きを防止するため、オンライントレードログイン時や出金時に、お客さまの端末上で生体認証（指紋や顔認証）やPINコード等を用いて本人認証をする『パスキー認証』を導入しています。パスキー認証は、スマートフォン、タブレット、PCなど、さまざまな端末で利用可能です。
              </p>
              <p class="u-center box-3column__button"><a href="/trade/passkey/index.html" class="button">詳細を確認する</a></p>
            </div>
            <div class="box-3column">
              <div class="u-center">
                <p class="box-3column__heading u-center">
                  ウイルス対策ソフトの導入
                </p>
              </div>
              <div class="box-3column__image">
                <img src="/security/img/ico_security05.png" alt="">
              </div>
              <p class="text">
                各サービスを安全に利用していただくために、オンライン金融取引を狙ったウイルスを検知・駆除するパソコン用ウイルス対策ソフト「Rapport（ラポート）」の導入を推奨しております。難しい設定は不要で無料で簡単にインストールしていただけます。
              </p>
              <p class="u-center box-3column__button"><a href="/trade/rapport/index.html" class="button">詳細を確認する</a></p>
            </div>
          </div>
        </section>
      </section>
      <section class="ly-contents">
        <h1 class="headline01">お客さまにお願いしたい「セキュリティ対策」</h1>
        <p class="text text__leadtext">フィッシング詐欺などのトラブルを未然に防ぐため、ご注意いただきたいことをご案内しております。</p>
        <section class="ly-contents__block">
		  <h2 class="heading02" id="heading02">受信したメールのドメインが相違していないかご確認ください</h2>
		  <p class="text">当社を騙る電子メール・ショートメッセージなどから偽のWebサイトに誘導し、認証情報を入力させられ、ID・パスワードを盗み取られる恐れがあります。<br>当社では下記のドメインのメールアドレスよりメールをお送りしていますので、受信メールが三菱ＵＦＪモルガン・スタンレー証券のアドレスであることをご確認ください。下記のドメイン以外のメールや不審な電子メール等は当社とは一切関係ございませんので、受け取った際は開封せずに削除してください。<br>また、当社から送信しているメールを転送設定されている場合、転送先に正常に届かない可能性があります。<br>その際には、ご利用のメールサービス管理者にご確認ください。</p>
		 <div class="note-scroll">横へスクロールしてください</div>
		   <div class="table-scroll">
		     <table class="table table--scroll">
			<colgroup>
				<col width="30%"/>
				<col width="15%"/>
				<col width="55%"/>
			</colgroup>
			<tbody>
				<tr>
					<th class="table__head u-center u-w200">ドメイン</th>
					<th class="table__head u-center u-w80">認証規格BIMI<sup class="note-pin">＊1</sup></th>
					<th class="table__head u-center u-w400">配信内容</th>
				</tr>
				<tr>
					<td class="table__data u-middle">its.sc.mufg.jp</td>
					<td class="table__data u-middle u-center">○</td>
					<td class="table__data u-middle">口座開設手続時のご連絡、ご出金申込完了時のご連絡、メールアドレス・パスワード等の手続きに関するご連絡、商品のご案内、約定連絡、IPO等当選通知等</td>
				</tr>
				<tr>
					<td class="table__data u-middle">sc-mufg.postub.com</td>
					<td class="table__data u-middle u-center">○</td>
					<td class="table__data u-middle">報告書等電子交付通知</td>
				</tr>
				<tr>
					<td class="table__data u-middle">sc.mufg.qhit.net
          </td>
					<td class="table__data u-middle u-center">○</td>
					<td class="table__data u-middle">株価通知メール等</td>
				</tr>
				<tr>
					<td class="table__data u-middle">sc.mufg-terrace.com</td>
					<td class="table__data u-middle u-center">○</td>
					<td class="table__data u-middle">商品・市況情報のご提供、イベント・サービスのご案内、保有資産に関するご連絡、事務手続に関するご連絡、その他ご挨拶等</td>
				</tr>
				<tr>
					<td class="table__data u-middle">ml.mufg-terrace.com</td>
					<td class="table__data u-middle u-center">○</td>
					<td class="table__data u-middle">MUFGテラスのメールサービスをご利用いただいた際のご連絡</td>
				</tr>
				<tr>
					<td class="table__data u-middle">sc.mufg.jp<sup class="note-pin">＊2</sup><br>mumss.com</td>
					<td class="table__data u-middle u-center">-</td>
					<td class="table__data u-middle">当社の営業員等からの個別のご連絡</td>
				</tr>
				<tr>
					<td class="table__data u-middle">cdd.kpidc.jp</td>
					<td class="table__data u-middle u-center">-</td>
					<td class="table__data u-middle">当社はお客さま情報を定期的に確認させていただいており、その際に利用する認証コードのご連絡</td>
				</tr>
				<tr>
					<td class="table__data u-middle">sys.sc.mufg.jp</td>
					<td class="table__data u-middle u-center">○</td>
					<td class="table__data u-middle">持株会ナビゲーションシステム「Mナビ」から会員さまへのご連絡</td>
				</tr>
			</tbody>
		 </table>
		 </div>
		 <ol class="note-order">
		  <li class="note-order__list">
		    <span class="note-order__num">＊1</span>
		    当社からお送りするメールにMUFGのロゴが表示されます。詳しくは<a href="/security/251027/index.html" class="link-text">こちら</a>をご参照ください。
		  </li>
		  <li class="note-order__list">
		    <span class="note-order__num">＊2</span>
		    2026年2月10日（火）より、sc.mufg.jpから送信されるメールのセキュリティ強化を実施いたします。<br>
        お客さまの受信環境によっては、該当ドメインからのメールが迷惑メールフォルダに送信される可能性があります。<br>
        その際には、ご利用のメールサービス管理者にご確認ください。
		  </li>
		</ol>
        </section>
		<section class="ly-contents__block">
		 <h3 class="heading03">不審メールの実例</h3>
		 <div class="box">
			<p class="text">
			<span class="u-red u-bold">【例1】</span><br>「あなたの三菱UFJ口座は不正利用されているため一時的にこの口座を制限します。下記のURLをクリックして制限を解除してください。」<br>「https://●●●●mufpg.com」　「https://●●●●mufgll.jp」</p>
			<p class="text">
			<span class="u-red u-bold">【例2】</span><br>【三菱UFJ・モルガン・スタンレー証券】：<br>
	こんにちは！我々は三菱証券や●●などの証券会社と連携しております。<br>
	お客様に、株投資者の学習スクールへのご参加をご案内いたします。上昇株など、毎日多くの優良株をお薦めします。オンラインの無料ライブ講座もあります。ご資産を増やしたい方は、講師アシスタントの▲▲（具体的なSNSサービスの名称）のアカウントの追加をお願いいたします。：XX111111（SNS偽アカウント）</p>

		 </div>
		  <p class="text">当社では、クレジットカード番号・有効期限・暗証番号など、お客さまの重要なクレジットカード情報をメールでお伺いすることは一切ありません。<br>不審なメールを受信した場合はすぐに削除し、記載されたリンク先へのアクセスやお客さま情報の入力は絶対にしないでください。</p>
		</section>
      </section>
    </main>
    <!-- ##### メインコンテンツ start ##### -->
  </div>
  <!-- ##### コンテンツエリア end ##### -->

