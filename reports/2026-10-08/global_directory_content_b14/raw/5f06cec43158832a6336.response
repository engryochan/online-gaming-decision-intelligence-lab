  <title>安全にお取引きしていただくための「セキュリティ対策」｜三菱ＵＦＪモルガン・スタンレー証券株式会社</title>
  <meta name="description" content="三菱ＵＦＪモルガン・スタンレー証券株式会社の「安全にお取引きしていただくための「セキュリティ対策」」をご紹介します。" />

  <link rel="canonical" href="https://www.sc.mufg.jp/security/index.html" />

  <link rel="shortcut icon" href="/common/img/favicon.ico" />
  <link rel="apple-touch-icon" href="/common/img/apple-touch-icon.png" />

  <link rel="stylesheet" href="/common/css/style.css" />
