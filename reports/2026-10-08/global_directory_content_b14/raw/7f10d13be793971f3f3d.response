                    function gtag() {
                        dataLayer.push(arguments);
                    }
                    gtag('js', new Date());
                    gtag('config', 'GTM-K6L3FMM');
                }
                head.insertBefore(gScript, head.children[1]);
            });
            head.setAttribute("data-google", "true");
        }
    </script>
