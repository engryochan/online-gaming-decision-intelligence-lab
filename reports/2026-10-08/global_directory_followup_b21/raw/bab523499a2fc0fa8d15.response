<article id="post-5503" class="post-5503 post type-post status-publish format-standard has-post-thumbnail hentry category-cse-issuer-stories category-cse-quarterly tag-cse-issuer-stories tag-cse-quarterly tag-enviroleach-technologies">
	
	<a class="post-thumbnail" href="https://blog.thecse.com/enviroleach-technologies-set-overhaul-mining-sector-eco-friendly-gold-leaching-formula/" aria-hidden="true">
	<img width="672" height="340" src="https://blog.thecse.com/wp-content/uploads/2017/11/2017_09_CSE_Quarterly_EnviroLeach_Blog-672x340.jpg" class="attachment-post-thumbnail size-post-thumbnail wp-post-image" alt="EnviroLeach Technologies set to overhaul mining sector with eco-friendly gold leaching formula" decoding="async" srcset="https://blog.thecse.com/wp-content/uploads/2017/11/2017_09_CSE_Quarterly_EnviroLeach_Blog-672x340.jpg 672w, https://blog.thecse.com/wp-content/uploads/2017/11/2017_09_CSE_Quarterly_EnviroLeach_Blog-300x151.jpg 300w" sizes="(max-width: 672px) 100vw, 672px" data-attachment-id="5508" data-permalink="https://blog.thecse.com/enviroleach-technologies-set-overhaul-mining-sector-eco-friendly-gold-leaching-formula/2017_09_cse_quarterly_enviroleach_blog/" data-orig-file="https://blog.thecse.com/wp-content/uploads/2017/11/2017_09_CSE_Quarterly_EnviroLeach_Blog.jpg" data-orig-size="675,340" data-comments-opened="0" data-image-title="2017_09_CSE_Quarterly_EnviroLeach_Blog" data-image-description="" data-image-caption="" data-large-file="https://blog.thecse.com/wp-content/uploads/2017/11/2017_09_CSE_Quarterly_EnviroLeach_Blog.jpg" />	</a>

	
	<header class="entry-header">
				<div class="entry-meta">
			<span class="cat-links"><a href="https://blog.thecse.com/category/cse-issuer-stories/" rel="category tag">CSE Issuer Stories</a>, <a href="https://blog.thecse.com/category/cse-quarterly/" rel="category tag">CSE Quarterly</a></span>
