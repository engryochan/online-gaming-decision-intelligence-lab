            (function (document, window) {
                let menuHeight = 0;

                const setMenuHeightProperty = () => {
                    const stickyHeader = document.querySelector('.js-sticky-header');

                    if (stickyHeader && menuHeight !== stickyHeader.offsetHeight) {
                        stickyHeader && document.body.style.setProperty('--menu-height', stickyHeader.offsetHeight + 'px');
                    }
                };

                setMenuHeightProperty();

                document.fonts.ready.then(() => {
                    setMenuHeightProperty();
                });

                window.addEventListener('resize', () => {
                    setMenuHeightProperty();
                });
            })(document, window);
        </script>
    
