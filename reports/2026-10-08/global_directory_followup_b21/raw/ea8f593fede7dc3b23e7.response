<script>
    document.addEventListener('DOMContentLoaded', function () {
        (function(document) {
            const root = document.getElementById('js-special-offers-root');

            if (!root) {
                return;
            }

            const translations = {
                'close': 'close',
                'openOffer': 'special_offer.open'
            };

            const currentRoute = document.body.getAttribute('data-route') || '';
            const branch = 'int';
            const language = 'en';

            if (typeof createSpecialOffersApp === 'function') {
                createSpecialOffersApp(root, { currentRoute, branch, language, translations });
            }
        })(document);
    });
</script>

