  <script>
  const viewAsMenu = $('#viewAsMenu').hide();
   const itemMenu = $('#itemMenu').hide(); 
   const rolesMenu = $('#rolesMenu').hide(); 

  $(function() {
    $('#viewAsButton').on('click', function() {
       itemMenu.hide(); 
      viewAsMenu.toggle();
       rolesMenu.hide(); 
      $(document).one('click', function() {
        viewAsMenu.hide();
      });
      return false;
    });

    
    $('#itemButton').on('click', function() {
      itemMenu.toggle();
      viewAsMenu.hide();
       rolesMenu.hide(); 
      $(document).one('click', function() {
        itemMenu.hide();
      });
      return false;
    });
    

    
    $('#rolesButton').on('click', function() {
       itemMenu.hide(); 
      rolesMenu.toggle();
      viewAsMenu.hide();
      $(document).one('click', function() {
        rolesMenu.hide();
      });
      return false;
    });
    
  });
</script>


<script>
  $(function() {
    registerTab('summary');
    
    
      registerTab('itemIdentification');
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
      
       registerTab('childItems'); 
    
    
    registerTab('catalogDetails');

    function registerTab(sectionId) {
      $('#' + sectionId + 'Tab').on('click', function() {
        activateTab(sectionId);
        return false;
      });
    }

    function activateTab(sectionId) {
      hideAllElementsWithClass('metadataSection');
      removeClassFromAllElements('tabbed-header-tab', 'selected');
      document.getElementById(sectionId).style.display = 'block';
      document.getElementById(sectionId + 'Tab').classList.add('selected');
    }

    const anchoredSection = globalThis.location.hash.substring(1);
    // verify that the hash corresponds to an actual section in the page
    if (document.getElementById(anchoredSection) == null) {
      // Have the Summary tab selected by default
      activateTab("summary");
    } else {
      activateTab(anchoredSection);
    }
  });
</script>



<script>
  $(function() {
    // CRS expand links
    $(document).on('click', '.crs-more-link', function() {
      const $link = $(this);
      $($link.data('contentId')).show();
      $($link.data('moreRowId')).hide();
      return false;
    });
  });
</script>

<script src="/inport/js/species.js?v=6.0.9"></script>

</body>
</html>