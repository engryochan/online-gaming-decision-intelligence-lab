  <script src="/inport/js/inport.js?v=6.0.9"></script>



  <script>
  const viewAsMenu = $('#viewAsMenu').hide();
   const itemMenu = $('#itemMenu').hide(); 
   const rolesMenu = $('#rolesMenu').hide(); 

  $(function() {
    $('#viewAsButton').on('click', function() {
       itemMenu.hide(); 
      viewAsMenu.toggle();
       rolesMenu.hide(); 
      $(document).one('click', function() {
        viewAsMenu.hide();
      });
      return false;
    });

    
    $('#itemButton').on('click', function() {
      itemMenu.toggle();
      viewAsMenu.hide();
       rolesMenu.hide(); 
      $(document).one('click', function() {
        itemMenu.hide();
      });
      return false;
    });
    

    
    $('#rolesButton').on('click', function() {
       itemMenu.hide(); 
      rolesMenu.toggle();
      viewAsMenu.hide();
      $(document).one('click', function() {
        rolesMenu.hide();
      });
      return false;
    });
    
  });
</script>


<script>
  $(function() {
    $('#slideMenuLink').on('click', function(e) {
      e.preventDefault();
      $('#slideMenuLayout').toggleClass('active');
      $('#slideMenu').toggleClass('active');
      $('#slideMenuLink').toggleClass('active');
    });

    $('.scrollPage').on('click', function() {
      const elementClicked = $(this).attr('href');
      const destination = $(elementClicked).offset().top;
      $('html:not(:animated),body:not(:animated)').animate({ scrollTop: destination - 5 }, 500);
      return false;
    });

    // Expand CRS links
    $(document).on('click', '.crs-more-link', function() {
      const $link = $(this);
      $($link.data('contentId')).show();
      $($link.data('moreRowId')).hide();
      return false;
    });
  });
</script>


  
