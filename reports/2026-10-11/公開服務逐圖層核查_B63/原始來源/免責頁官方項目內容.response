ole=\"link\" href=\"/search?layout=grid&sort=Title%7Ctitle%7Casc\">All Content</a></li>\r\n</ul>\r\n<br>\r\n<div style=\"text-align: center; font-size: 20px;\">\r\n  <a class=\"data-related-link blue-link\" href=\"/pages/dataupdatelog\">Data Update Log</a> | \r\n  <a class=\"data-related-link blue-link\" href=\"https://www.fisheries.noaa.gov/inport/item/37232\" target=\"_blank\">NOAA Metadata Library</a>\r\n</div>"}},"width":12}]},{"cards":[{"component":{"name":"spacer-card","settings":{"height":"30","cardId":"ceb6qjpm1"}},"settings":{"height":100},"width":12}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":false,"isUrl":true,"state":"","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"#f1f1f1"},"rowLayout":"box"},"rows":[{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"c8nszaz9q","schemaVersion":2.1,"markdown":"<p class=\"section-header\">Featured Content</p>"}},"width":12}]},{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"cnqrory3a","schemaVersion":2.1,"markdown":"<style>\n  .card-group {\n    display: -webkit-box;\n    display: -ms-flexbox;\n    display: flex;\n    gap: 20px;\n    -webkit-box-pack: justify;\n        -ms-flex-pack: justify;\n            justify-content: space-between;\n  }\n  .featured-card {\n    display: -webkit-box;\n    display: -ms-flexbox;\n    display: flex;\n    -webkit-box-orient: vertical;\n    -webkit-box-direction: normal;\n        -ms-flex-flow: column;\n            flex-flow: column;\n    -webkit-box-flex: 1;\n        -ms-flex: 1 1 0px;\n            flex: 1 1 0;\n    border: 1px solid #333;\n    border-radius: 36px;\n    -webkit-box-pack: justify;\n        -ms-flex-pack: justify;\n            justify-content: space-between;\n    \n    & img {\n      -o-object-fit: cover;\n         object-fit: cover;\n      -o-object-position: top;\n         object-position: top;\n      width: 100%;\n      height: 300px;\n      border-radius: 36px 36px 0px 0px;\n    }\n  }\n  .card-title {\n    font-size: 24px;\n    font-weight: 600;\n    margin: 10px;\n  }\n  .card-desc {\n    margin: 10px;\n  }\n  .card-btn {\n    margin: 10px;\n    padding: 20px;\n    text-align: center;\n    text-decoration: none !important;\n    color: white;\n    background-color: #474747;\n    border: none;\n    border-radius: 36px;\n    font-size: 20px;\n    &:hover {\n      color: white;\n      background-color: #363535;\n    }\n  }\n  \n  @media (max-width: 767px) {\n    .card-group {\n      -webkit-box-orient: vertical;\n      -webkit-box-direction: normal;\n          -ms-flex-flow: column;\n              flex-flow: column;\n    }\n  }\n</style>\n\n<div class=\"card-group\">\n  \n  <div class=\"featured-card\">\n    <div>\n      <img src=\"https://coast.noaa.gov/data/marinecadastre/images/featured_or.jpg\" alt=\"An example of the results created from the OceanReports application.\">\n      <p class=\"card-title\">OceanReports</p>\n      <p class=\"card-desc\">This web-based, report-centric tool provides coastal and ocean planners with a high-level analysis for their custom-drawn area of interest.</p>\n    </div>\n    <a class=\"card-btn\" href=\"https://marinecadastre.gov/oceanreports\">Launch</a>\n  </div>\n  \n  <div class=\"featured-card\">\n    <div>\n      <img src=\"https://coast.noaa.gov/data/marinecadastre/images/featured_ais.png\" alt=\"A heat map showing areas of heavy vessel traffic. This image was generated using the Vessel Traffic application.\">\n      <p class=\"card-title\">Vessel Traffic</p>\n      <p class=\"card-desc\">Download and view AIS data to learn more about vessel traffic.</p>\n    </div>\n    <a class=\"card-btn\" href=\"/pages/vesseltraffic\">Learn More</a>\n  </div>\n  \n  <div class=\"featured-card\">\n    <div>\n      <img src=\"https://coast.noaa.gov/data/marinecadastre/images/featured_nv.jpg\" alt=\"A map showing some polygons. This image was generated using the National Viewer application.\">\n      <p class=\"card-title\">National Viewer</p>\n      <p class=\"card-desc\">Use the National Viewer to view and interact with Marine Cadastre data.</p>\n    </div>\n    <a class=\"card-btn\" href=\"https://noaa.maps.arcgis.com/apps/mapviewer/index.html?webmap=1d2ed214322c4130a034c691a9c462b0\">Launch</a>\n  </div>\n\n</div>\n\n"}},"width":12}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":true,"isUrl":false,"state":"valid","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"#147878"},"color":"#ffffff","rowLayout":"box"},"rows":[{"cards":[{"component":{"name":"spacer-card","settings":{"height":"30","cardId":"cqs1wv9b2"}},"settings":{"height":100},"width":12}]},{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"cbeddnyad","schemaVersion":2.1,"markdown":"<p class=\"section-header\">News & Announcements</p>"}},"width":12}]},{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"c51sq1tq2","schemaVersion":2.1,"markdown":"<style>\n  .news-title {\n    font-weight: 700;\n  }\n  .news-desc {\n    font-weight: 200;\n  }\n</style>\n\n<div style=\"\">\n  <p style=\"\"><a class=\"white-link\" href=\"https://hub.marinecadastre.gov/pages/vesseltraffic\" style=\"font-size: 22px;\"><span class=\"news-title\">Now Available</span><span class=\"news-desc\"> – AIS Vessel Broadcast Points 2026 (April 1 to June 30)</span></a></p>\n  \n  <p style=\"\"><a class=\"white-link\" href=\"https://hub.marinecadastre.gov/pages/vesseltraffic\" style=\"font-size: 22px;\"><span class=\"news-title\">Now Available</span><span class=\"news-desc\"> – AIS Vessel Broadcast Points 2026 (January 1 to March 31)</span></a></p>\n  \n  <p style=\"font-size: 22px;\"><a class=\"white-link\" href=\"https://coastalgeotools.org/\"><span class=\"news-title\">Save the Date</span><span class=\"news-desc\"> – Coastal GeoTools 2027</span></a></p>\n  \n 