                  <td width="10%"><a href="/equities/follow-up/jr4eth0000004vj2-att/t13vrt000001u1cj.xlsx" rel="external"><img src="/common/images/icon/icon-xls.png" alt="Excel" title="Excel" width="18" height="18" /></a></td>
                
