<script type="text/javascript" src="../../../bell/js/jquery.tablesorter.js"></script>

<script type="text/javascript">
$(document).ready(function()
{


var rows = $('#tablesorter tbody  tr').get();


    rows.sort(function(a, b) {

      var A = $.trim($(a).children('td').eq(0).text().toUpperCase());
      var B = $.trim($(b).children('td').eq(0).text().toUpperCase());

      if(A < B) {
        return -1;
      }

      if(A > B) {
        return 1;
      }

      return 0;


    });






    $.each(rows, function(index, row) {

      $('#movies').children('tbody').append(row);




    });


});
</script>



		
		
