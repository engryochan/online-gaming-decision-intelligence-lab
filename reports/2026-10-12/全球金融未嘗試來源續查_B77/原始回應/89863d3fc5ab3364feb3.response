    ).done(function() {
        // Turn on/off debug logger, default is off
        LabCI.Utils.CONSOLELOGGER.isdebug = true;
        LabCI.WP.marketMarquee = LabCI.WP["createmarketmarquee"].call(this).init(LabCI.getLang()).show({});
    });
});

})(jQuery);
</script>

