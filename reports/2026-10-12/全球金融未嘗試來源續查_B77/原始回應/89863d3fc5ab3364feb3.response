<script>
    // new release filter button onclick
    $(function () {
        $(".whats_on_tdy_filter_container .whats_on_tdy_filter_btn").on("click", function () {

            var currUrl = $("#pageUrl").val();

            if (currUrl.indexOf('?') == -1) {
                currUrl += "?";
            }

            //var yearFilter = $(".newsRelease-filter #select-target-date").attr("data-value");
            var dateFromFilter = $(".whats_on_tdy_filter_container #newsDateFrom").val();
            var dateToFilter = $(".whats_on_tdy_filter_container #newsDateTo").val();

            var filterUrl = $(".whats_on_tdy_filter_container #activities-2 option:selected").val();
            /*$(".newsRelease-filter input:checkbox[name='NEWS CATEGORY']:checked").each(function () {
                filterUrl += $(this).attr("value") + "|";
            });*/
            var filterUrl2 = $(".whats_on_tdy_filter_container #activities-3 option:selected").val();

            var keyword = $(".whats_on_tdy_filter_container #keywords-2").val();
            //filterUrl = filterUrl.substr(0, filterUrl.length - 1);
            var pageUrl = currUrl
            if (dateFromFilter != "") {//  && ($("#select-target-date").attr("data-value") != $("#allYear").val())) {
                pageUrl += "&DateFrom=" + dateFromFilter;
            }
            if (dateToFilter != "") {
                pageUrl += "&DateTo=" + dateToFilter;
            }
            if (filterUrl != "" || filterUrl != "undefined") {
                pageUrl += "&Category=" + encodeURIComponent(filterUrl);
            }
            if (filterUrl2 != "" || filterUrl2 != "undefined") {
                pageUrl += "&Category2=" + encodeURIComponent(filterUrl2);
            }
            if (keyword != "") {
                pageUrl += "&Keyword=" + encodeURIComponent(keyword);
            }
            if (pageUrl.indexOf("currentCount") != -1) {
                pageUrl = removeURLParameter(pageUrl, "currentCount");
            }
            //console.log(pageUrl);
            window.parent.location.href = pageUrl;

        });
    });

    $(function () {
        $(".whats_on_tdy_filter_container #keywords-2").on("keydown", function (e) {
            var code = (e.keyCode ? e.keyCode : e.which);
            if (code == 13) {
                var currUrl = $("#pageUrl").val();

                if (currUrl.indexOf('?') == -1) {
                    currUrl += "?";
                }

                //var yearFilter = $(".newsRelease-filter #select-target-date").attr("data-value");
                var dateFromFilter = $(".whats_on_tdy_filter_container #newsDateFrom").val();
                var dateToFilter = $(".whats_on_tdy_filter_container #newsDateTo").val();

                var filterUrl = $(".whats_on_tdy_filter_container #activities-2 option:selected").val();
                /*$(".newsRelease-filter input:checkbox[name='NEWS CATEGORY']:checked").each(function () {
                    filterUrl += $(this).attr("value") + "|";
                });*/
                var filterUrl2 = $(".whats_on_tdy_filter_container #activities-3 option:selected").val();

                var keyword = $(".whats_on_tdy_filter_container #keywords-2").val();
                //filterUrl = filterUrl.substr(0, filterUrl.length - 1);
                var pageUrl = currUrl
                if (dateFromFilter != "") {//  && ($("#select-target-date").attr("data-value") != $("#allYear").val())) {
                    pageUrl += "&DateFrom=" + dateFromFilter;
                }
                if (dateToFilter != "") {
                    pageUrl += "&DateTo=" + dateToFilter;
                }
                if (filterUrl != "" || filterUrl != "undefined") {
                    pageUrl += "&Category=" + encodeURIComponent(filterUrl);
                }
                if (filterUrl2 != "" || filterUrl2 != "undefined") {
                    pageUrl += "&Category2=" + encodeURIComponent(filterUrl2);
                }
                if (keyword != "") {
                    pageUrl += "&Keyword=" + encodeURIComponent(keyword);
                }
                if (pageUrl.indexOf("currentCount") != -1) {
                    pageUrl = removeURLParameter(pageUrl, "currentCount");
                }
                //console.log(pageUrl);
                window.parent.location.href = pageUrl;
            }
        });
    });

    $(window).on('scroll', function () {
        setTimeout(function () {
            if ($('.whats_on_tdy_more_row').length != 0) {
                if (checkVisible($('.whats_on_tdy_more_row'))) {
                    //alert("Visible!!!");                    
                    readNewsLoadMore();

                    //$(window).off('scroll');
                } else {
                    //console.log("not see");
                }
            }
        }, 500);
    });

    function getParameterByName(name, url) {
        if (url == '') url = window.location.href;
        name = name.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
            results = regex.exec(url);
        if (!results) return null;
        if (!results[2]) return '';
        return decodeURIComponent(results[2].replace(/\+/g, ' '));
    }

    function readNewsLoadMore() {
        var pageUrl = $("#pageUrl").val();
        var TopicFieldName = $("#TopicFieldName").val();
        var DateFieldName = $("#DateFieldName").val();
        var FilesFieldName = $("#FilesFieldName").val();
        var ImageFieldName = $("#ImageFieldName").val();
        var ContentFieldName = $("#ContentFieldName").val();
        var Category1FieldName = $("#Category1FieldName").val();
        var Category2FieldName = $("#Category2FieldName").val();
        var Category3FieldName = $("#Category3FieldName").val();
        //parseInt
        var currentcount = parseInt($("#currentLoadCount").val());
        var loadmorecount = parseInt($("#LoadMoreCount").val());
        var isCardView = $("#isCardView").val();
        var tabItemSourceID = $("#tabItemSourceID").val();
        var keyword = $("#keyword").val();
        var category = $("#category").val();
        var category2 = $("#category2").val();
        var datefrom = $("#datefrom").val();
        var dateto = $("#dateto").val();
        var isHideDay = $("#isHideDay").val();
        var TargetLanguage = $("html").attr("lang");
        var TargetSite = getParameterByName("sc_site");
        var UrlHost = $("#urlHost").val();
        var hsv = $("#hsv").val();
        var dataValue = { "pageUrl": pageUrl, "TopicFieldName": TopicFieldName, "DateFieldName": DateFieldName, "FilesFieldName": FilesFieldName, "ImageFieldName": ImageFieldName, "ContentFieldName": ContentFieldName, "Category1FieldName": Category1FieldName, "Category2FieldName": Category2FieldName, "Category3FieldName": Category3FieldName, "currentcount": currentcount, "loadmorecount": loadmorecount, "IsLoadMore": true, "isCardView": isCardView, "TabItemSourceID": tabItemSourceID, "datefrom": datefrom, "dateto": dateto, "category": category, "keyword": keyword, "isHideDay": isHideDay, "category2": category2, "TargetLanguage": TargetLanguage, "TargetSite": TargetSite, "host": UrlHost, "hsv": hsv };
        $.ajax({
            type: "POST",
            url: HkexAjaxUtils.getAjaxLink('/layouts/HKEX_Common/Tab/NewsCentreDetailsLoad.aspx/DisplayNewsCentreDetailsLoad'),
            data: JSON.stringify({ req: dataValue }),
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            async: false,
            success: function (result) {
                if (result.d != null && result.d != "") {
                    $('.whats_on_tdy_more_row').remove();
                    if ($('#isCardView').val() == "Y") {
                        $(".section_container_in .column_grid_view .column_source").append(result.d);
                        //$(".section_container_in .column_grid_view .column").html("");                        
                        $(".section_container_in .column_grid_view .column_1").remove();
                        $(".column_grid_view_dt").html("");
                        $(".column_grid_view").columnView();
                        columnViewDT();
                        $(".section_container_in.whats_on_tdy").append("<div class=\"whats_on_tdy_more_row\"><div class=\"whats_on_tdy_more_btn\"><div>Load More</div><img src=\"/assets/images/loading.gif\" alt=\"\" class=\"whats_on_tdy_loading\"></div></div></div>");
                    }
                    else {
                        $(".whats_on_tdy").append(result.d);
                    }
                    $("#currentLoadCount").val(currentcount + loadmorecount);
                }
                else {
                    $('.whats_on_tdy_more_row').remove();
                }
            },
            error: function (jq, status, message) {
                if (message == "Not Found") {
                    alert('A jQuery error has occurred. Status: ' + status + ' - Message: ' + message);
                }
            }
        });
    }

    function checkVisible(elm, eval) {
        eval = eval || "object visible";
        if (elm != null) {
            var viewportHeight = $(window).height(), // Viewport Height
                scrolltop = $(window).scrollTop(), // Scroll Top
                y = $(elm).offset().top,
                elementHeight = $(elm).height();
        }

        if (eval == "object visible") return ((y < (viewportHeight + scrolltop)) && (y > (scrolltop - elementHeight)));
        if (eval == "above") return ((y < (viewportHeight + scrolltop)));
    }
</script>

        </div>
    </div>
    <script>        
        $(document).ready(function () {

            initCardSwiper()
            initCircularBy()
            initRightHighlight()

            //webflow function fix                  

            if ($('.news_release_right').find('.news_release_right_block').length == 0) // Added by Henry
            {
                $('.news_release_right').hide();
                $('.news_release_left').css('width', '100%');
                $('.column_grid_view_dt').attr('data-cols', '4');
                $(".column_grid_view_dt").html("");
                columnViewDT();
            }
            else {
                $('.news_release_right_block:first').addClass('first');
            }

            initDatePicker();
        }
        )
        function initCircularBy() {
            $(".circulars-item").addClass("hidden")
            var parent = $(".circulars-item").parents(".news_release_right_block")
            var dataload = parent.attr("data-load")
            var i
            for (i = 0; i < dataload; i++) {
                $(".circulars-item").eq(i).removeClass("hidden")
            }

            $(".newsHighlight.read-circulars-by-btn, .read-circulars-by .popover__link").click(function (e) {
                
                e.preventDefault()
                $(this).parents(".read-circulars-by").find('.list-panel-popover').toggle();
                if ($(this).is(".popover__link")) {
                    var target = $(this).attr("data-target")
                    if (target == 'all') {
                        $(".circulars-item").removeClass("type-hidden").removeClass("hidden")
                    } else {
                        $(".circulars-item").addClass("type-hidden")
                        $(".circulars-item." + target).removeClass("type-hidden").removeClass("hidden")
                    }
                    $(this).siblings(".news_release_right_more_btn.circulars_btn").css("display", "flex")
                    $(this).siblings(".news_release_right_less_btn.circulars_btn").hide()
                }
                $(".news_release_right_less_btn.circulars_btn").click()
            });
            $(".news_release_right_more_btn.circulars_btn").click(function (event) {
                event.preventDefault();
                $(this).siblings(".news_release_right_less_btn.circulars_btn").css("display", "flex")
                $(this).hide()
                $(this).siblings('.circulars-item').removeClass("hidden")
            });
            $(".news_release_right_less_btn.circulars_btn").click(function (event) {
                event.preventDefault();
                $(this).siblings(".news_release_right_more_btn.circulars_btn").css("display", "flex")
                $(this).hide()
                $(this).siblings('.circulars-item').addClass("hidden")
                var parent = $(".circulars-item").parents(".news_release_right_block")
                var dataload = parent.attr("data-load")
                var i
                for (i = 0; i < dataload; i++) {
                    $(this).siblings(".circulars-item:not(.type-hidden)").eq(i).removeClass("hidden")
                }
            });
        }

        function initRightHighlight() {
            $(".news_release_item_controller > a").click(function () {
                var parent = $(this).parents(".news_release_right_block")
                var dataload = parent.attr("data-load")

                if ($(this).is(".news_release_right_less_btn")) {
                    $(this).css("display", "none")
                    $(this).siblings(".news_release_right_more_btn").css("display", "flex")
                    parent.find(".news_release_item_block").hide()
                    var i
                    for (i = 0; i < dataload; i++) {
                        parent.find(".news_release_item_block").eq(i).show()
                    }
                } else if ($(this).is(".news_release_right_more_btn")) {
                    $(this).css("display", "none")
                    $(this).siblings(".news_release_right_less_btn").css("display", "flex")
                    parent.find(".news_release_item_block").show()
                }

            })

            $(".news_release_right_less_btn").click()
        }

        function initCardSwiper() {
            var twitterSwiper = new Swiper(".card-swiper:not(.span-2)", {
                pagination: {
                    el: '.card-pagination',
                    type: 'fraction',
                },
                navigation: {
                    nextEl: '.card-swiper-btn-next',
                    prevEl: '.card-swiper-btn-prev',
                },
                loop: true,
                updateOnWindowResize: true,
                spaceBetween: 20
            })
        }

        function initDatePicker() {
            var datePickerMonth, datePickerDay
            if ($("html").attr("lang") == "zh-HK" || $("html").attr("lang") == "zh-CN") {
                datePickerMonth = ["一月", "二月", "三月", "四月", "五月", "六月", "七月", "八月", "九月", "十月", "十一月", "十二月"]
                datePickerDay = ["日", " 一", "二", "三", "四", "五", "六"]
            } else {
                datePickerMonth = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
                datePickerDay = ["S", "M", "T", "W", "T", "F", "S"]
            }
            var dateFormat = "yy-mm-dd";
            var dateFrom = new Date($("#newsDateFrom").attr("data-date"));
            var dateTo = new Date($("#newsDateTo").attr("data-date"));
            var YearRangeVal = $("#YearRange").val();
            var from = $("#newsDateFrom").datepicker({
                changeMonth: true,
                changeYear: true,
                yearRange: YearRangeVal,
                dateFormat: dateFormat,
                defaultDate: dateFrom,
                monthNamesShort: datePickerMonth,
                dayNamesMin: datePickerDay,
            }).on("change", function () {
                to.datepicker("option", "minDate", getDate(this));
            });
            var to = $("#newsDateTo").datepicker({
                changeMonth: true,
                changeYear: true,
                yearRange: YearRangeVal,
                dateFormat: dateFormat,
                defaultDate: dateFrom,
                monthNamesShort: datePickerMonth,
                dayNamesMin: datePickerDay,
            }).on("change", function () {
                from.datepicker("option", "maxDate", getDate(this));
            });
            from.datepicker('setDate', dateFrom);
            to.datepicker('setDate', dateTo);
        }

        function getDate(element) {
            var date;
            try {
                date = $.datepicker.parseDate(dateFormat, element.value);
            } catch (error) {
                date = null;
            }
            return date;
        }
    </script>
</div>

