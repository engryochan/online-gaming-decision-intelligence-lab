        if (document.createStyleSheet) try { document.createStyleSheet(_WP_PATH+url); } catch (e) { }
        else $("<link rel='stylesheet' type='text/css' href='"+_WP_PATH+url+"'/>").appendTo("#lhkexw-quotereits");
