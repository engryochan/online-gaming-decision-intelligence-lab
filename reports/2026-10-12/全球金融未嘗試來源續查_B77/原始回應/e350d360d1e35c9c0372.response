	</div>
</section>
				
			</div>

			<div class="col-xl-6">
				
					<section class="">
	<div class="text-container">
		
				<div class="container">
					<div class="row">
						<div class="col-xl-8 offset-xl-2">
							
							
							
							<p>A <strong>Central Coordinator</strong> can access the Member Section to configure the following EEX technical infrastructure: </p><ul class="content-list"> 	<li> 	<p>Trader setups</p> 	</li> 	<li> 	<p>ETI Session</p> 	</li> 	<li> 	<p>T7 GUI keys</p> 	</li> 	<li> 	<p>Common Upload Engine / Common Report Engine (CRE)</p> 	</li> 	<li> 	<p>Short codes + Algo uploads</p> 	</li> 	<li> 	<p>User ID Maintenance </p> 	</li> </ul>
						</div>
					</div>
				</div>
				
	</div>
</section>
				
			</div>
		</div>
	</div>
</section>	<section class="">
