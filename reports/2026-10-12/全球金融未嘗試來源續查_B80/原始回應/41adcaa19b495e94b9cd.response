                $("#news-contents-left").append(getNewsTagList_renewal(news_info.slice(0, 3), true, false, -1, true, true));
                $("#news-contents-right").append(getNewsTagList_renewal(news_info.slice(3, 6), true, false, -1, true, true));

                var ret_category_list=getCategoryList('マーケットニュース');
                var news_link_list_url='/news/index.html';
                for(var key in ret_category_list) {
                    if(ret_category_list[key]=='株式・ETF・REIT等') {
                        news_link_list_url+='?category='+key;
                    }
                }
              $(".JPX-sitelist-btn").append('<a href="'+news_link_list_url+'" class="JPX-btn">関連ニュース一覧</a>');
            } else {
                $("#news-list").remove();
            }
        });
    </script>
