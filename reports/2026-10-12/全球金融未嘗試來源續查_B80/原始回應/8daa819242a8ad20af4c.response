$(window).on('load', function(){
	moredisp('#publicnews > dl','20');
	$("#publicnews .btn_more").on("click",function(){
		moredisp('#publicnews > dl','20','#publicnews .btn_more');
	})
});
$(window).on('load', function(){
	moredisp('#settlement > dl','20');
	$("#settlement .btn_more").on("click",function(){
		moredisp('#settlement > dl','20','#settlement .btn_more');
	})
});
function moredisp(id,cnt,btn){
	var disp_list   = id + " > *:not(.active)";
	var disp_length = $(disp_list).length;
	var disp_total_cnt;
	if( cnt < disp_length ){
		disp_total_cnt = cnt;
	} else {
		disp_total_cnt = disp_length;
		$(btn).hide();
	}
	$(disp_list + ":lt(" + disp_total_cnt +")").addClass("active");
}
</script>
<style>
#publicnews > dl > * { display:none; }
#publicnews > dl > *.active { display:block; }
#settlement > dl > * { display:none; }
#settlement > dl > *.active { display:block; }
</style>

