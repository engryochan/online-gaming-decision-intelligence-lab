	.tab_link:after {
		font-family: "Font Awesome 5 Free";
		font-weight: 900;
		font-size: 14px;
		content: "\f077";
		color: #032045;
		float: right;
		position: absolute;
		display: block;
		top: 10px;
		right: 10px;
		transition: 0.3s all;
		transform: rotate(90deg);
		opacity: 100;
    }
	.tab_link.w--current:after {
		color: #fff;
	}
	.link_right_inner a {
		position: relative;
	}
	a.load_more {
		position: relative;
	}
	a.load_more:after,
	.link_right_inner a:after {
		font-family: "Font Awesome 5 Free";
		font-weight: 900;
		font-size: 14px;
		content: "\f077";
		color: #fff;
		float: right;
		position: absolute;
		display: block;
		top: 15px;
		right: 15px;
		transition: 0.3s all;
		transform: rotate(90deg);
		opacity: 100;
	}
	a.load_more:hover:after {
		color: #000;
	}
	.navigation-item:hover,
	.navigation-item.w--current {
		text-decoration: none;
	}
	.navigation-item {
		position: relative;
	}
	.navigation-item.w--current:after,
	.navigation-item:hover:after {
		content: "";
		width: 100%;
		height: 0;
		background: #c0c7d0;
		position: absolute;
		bottom: -3px;
		left: 0;
		right: 0;
    }
    @media (min-width: 992px) {
        .navigation-item.w--current:after,
        .navigation-item:hover:after {
            height: 1px;
        }
        .navigation-item:hover {
            border-bottom: none;
        }
        .navigation-item:hover:after {
            height: 0 !important;
        }
    }
	footer .w-dropdown-list {
		right: 0px;
	}
	body:after {
		content: "";
		position: absolute;
		top: 0;
		left: 0;
		width: 100vw;
		height: 100vh;
		background: #fff;
		opacity: 1;
		visibility: visible;
		z-index: 2020;
		transition: 0.7s all;
	}
	body.loaded:after {
		opacity: 0;
		visibility: hidden;
	}
	.multiple-items .slick-arrow {
		background: transparent;
		width: auto;
		padding: 0;
		display: inline-block;
		margin: 0;
		-webkit-appearance: none;
		box-shadow: none;
	}
	.multiple-items .slick-arrow:focus {
		outline: none;
	}
	.multiple-items .slick-prev:after {
		content: "";
		background-image: url("https://cdn.prod.website-files.com/5df1d94a245d003373b4b83b/5e4b9a2c419b338b66096b27_prev-icon.png");
		background-repeat: no-repeat;
		background-position: center;
		background-size: 20px;
		width: 30px;
		height: 30px;
		display: block;
	}
	.multiple-items .slick-next:after {
		content: "";
		background-image: url("https://cdn.prod.website-files.com/5df1d94a245d003373b4b83b/5e4b9a2c1e21af51133a5221_next-icon.png");
		background-repeat: no-repeat;
		background-position: center;
		background-size: 20px;
		width: 30px;
		height: 30px;
		display: block;
	}
	.multiple-items .slick-next {
		position: absolute;
		top: 18%;
		right: 0;
	}
	.multiple-items .slick-prev {
		position: absolute;
		top: 18%;
		left: 0;
	}
	.multiple-items {
		position: relative;
	}

	.w-nav {
		display: -webkit-box;
		display: -webkit-flex;
		display: -ms-flexbox;
		display: flex;
		max-width: 100%;
		margin-right: auto;
		margin-left: auto;
		padding: 20px;
		-webkit-box-align: center;
		-webkit-align-items: center;
		-ms-flex-align: center;
		align-items: center;
		background-color: transparent;
	}

	@media only screen and (min-width: 1499px) {
		.navigation-item {
			margin: 0px 28px;
			font-size: 20px;
		}
		.menu {
			margin-right: 25px;
		}
	}

	@media only screen and (max-width: 1023px) {
		.navigation-item {
			margin-right: 10px;
			margin-left: 10px;
		}
	}

	@media only screen and (max-width: 991px) {
		.navigation-item {
			position: relative;
		}
		.navigation-item.w-dropdown-toggle.w--current:after,
		.navigation-item.w-dropdown-toggle:after,
        .navigation-item.w-dropdown-toggle:hover:after,
        .navigation-item.w-nav-link:after {
			content: "";
			width: 100%;
			height: 1px;
			background: #c0c7d0;
			position: absolute;
			bottom: 0px;
			left: 0;
			right: 0;
		}
		.navigation-item:hover,
		.navigation-item:active {
			background-color: #ffffff;
		}
		.navigation-item.w-dropdown-toggle:before {
			content: "\e603";
			font-family: "webflow-icons" !important;
			speak: none;
			font-style: normal;
			font-weight: normal;
			font-variant: normal;
			text-transform: none;
			line-height: 1;
			-webkit-font-smoothing: antialiased;
			position: absolute;
			right: 10px;
			top: 13px;
			transition: all 0.3s ease;
		}
		.navigation-item.w-dropdown-toggle.w--open:before {
			transform: rotate(180deg);
		}

		.multiple-items .slick-next {
			top: 11%;
		}
		.multiple-items .slick-prev {
			top: 11%;
        }
        .w-dropdown-list.w--open:after {
            content: "";
			width: calc(100% - 30px);
			height: 1px;
			background: #c0c7d0;
			position: absolute;
			bottom: 0px;
			left: 15px;
			right: 0;
        }
	}

	@media only screen and (max-width: 639px) {
		.multiple-items .slick-next {
			top: 9%;
		}
		.multiple-items .slick-prev {
			top: 9%;
		}

		.multiple-items .slick-prev:after,
		.multiple-items .slick-next:after {
			background-size: 15px;
			width: 25px;
			height: 25px;
		}
	}
