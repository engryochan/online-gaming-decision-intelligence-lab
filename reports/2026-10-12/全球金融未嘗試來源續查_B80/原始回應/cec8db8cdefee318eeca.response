                <div class="listing-2025-sidepanel-icon">
                    <img src="/-/media/HKEX_Common/Market/Listing-Revamp/Others/Listing-RHS-media/Link1.svg?mw=1000&hash=616176B83C56D0CDA487B681AF23F798D425ABA1DD524FE4A248686CDB0611B9" alt="Link1" />
