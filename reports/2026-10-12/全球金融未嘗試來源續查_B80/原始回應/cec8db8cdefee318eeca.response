                    <img src="/-/media/HKEX_Common/Market/Listing-Revamp/Others/Listing-RHS-media/Calendar.svg?mw=1000&hash=8EDE3D1A3357555ACA68C983B3FBAC05F245652308951EA5077FB09ED5CBDAB5" alt="Calendar" />
