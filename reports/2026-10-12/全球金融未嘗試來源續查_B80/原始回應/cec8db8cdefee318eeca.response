                    <div class="listing-2025-highlights-time-head-filter-date-group">
                        <div class="listing-2025-highlights-time-head-filter-date-text">
                            To
                        </div>
                        <div class="listing-2025-highlights-time-head-filter-date-time">
                            <input type="text" id="highlights_time_endTime" value="2026-12-31" data-date="2026-12-31" />
                        </div>
                    </div>
                </div>

                <div class="listing-2025-highlights-time-head-filter-actions">
                    <div class="button-sample blue-border-button button-sample-text primary-hkex-blue-100 filter-button" id="highlights_time_applyBtn">
                        <div class="listing-2025-highlights-time-head-filter-actions-apply-text">Apply Filters</div>
                        <div class="listing-2025-highlights-time-head-filter-actions-apply-img">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M9 6.5L15 12.5L9 18.5" stroke="#13426B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    </div>
                    <div class="listing-2025-highlights-time-head-filter-actions-reset" id="highlights_time_resetBtn">
                        <div class="listing-2025-highlights-time-head-filter-actions-apply-reset-text">Reset</div>
                    </div>
                </div>
            </div>
        </div>

    </div>



    <div class="listing-2025-highlights-time-list" id="reportsContainer">
    </div>

    <div class="no-results-message" id="noResultsMessage">
        <div>
            <img src="/assets/images/svg/Group10284.svg" class="noResultsMessage_img" />
        </div>
        <div class="noResultsMessage_dec">
            <div class="noResultsMessage_dec_top">No results</div>
            <div class="noResultsMessage_dec_title">
                Please change keywords or reset the filters
            </div>
        </div>
    </div>
</div>

<script>

    const listing2025_highlights_ITEMS_TO_SHOW = 2;

    document.addEventListener("DOMContentLoaded", function (event) {

        // DOM Elements
        const reportsContainer = document.getElementById('reportsContainer');
        const listing2025_filterTags = document.querySelectorAll('.listing-2025-highlights-time-head-tag-item');

        const applyFiltersBtn = document.getElementById('highlights_time_applyBtn');
        const resetFiltersBtn = document.getElementById('highlights_time_resetBtn');
        const startDate = document.getElementById('highlights_time_startTime');
        const endDate = document.getElementById('highlights_time_endTime');
        const noResults = document.getElementById('noResultsMessage');

        let listing2025_firstLoading = true;
        var listing2025_selectedTags = ['All'];
        var listing2025_selectedCategories = [];

        initDatePicker();
        lnitLoadParam(true);
        renderReports();

        function lnitLoadParam(isload) {
            var pageUrl = window.parent.location.href;

            if (isload) {

                const category = getParameterByName('Category');
                if (category != "" && category != null) {
                    listing2025_selectedTags = category ? category.split('|') : [];
                    if (!listing2025_selectedTags.includes("All")) {
                        listing2025_filterTags.forEach(tag => {
                            const listing2025_tagValue = tag.getAttribute('data-tag');
                            const listing2025_new_categoriesValue = tag.getAttribute('data-categories');
                            if (listing2025_selectedTags.includes(listing2025_tagValue)) {
                                listing2025_selectedCategories.push(listing2025_new_categoriesValue);
                            }
                        });
                    }
                    listing2025_updateTagSelection();
                }

                const dateFrom = getParameterByName('DateFrom');
                if (dateFrom != "" && dateFrom != null) {
                    from.datepicker('setDate', new Date(dateFrom));
                }
                const dateTo = getParameterByName('DateTo');
                if (dateTo != "" && dateTo != null) {
                    to.datepicker('setDate', new Date(dateTo));
                }

            } else {

                if (listing2025_selectedTags.length > 0) {

                    upsertParam('Category', listing2025_selectedTags.join('|'));
                }

                var dateFromFilter = $("#highlights_time_startTime").val();
                if (dateFromFilter != "") {
                    upsertParam('DateFrom', dateFromFilter);
                }
                var dateToFilter = $("#highlights_time_endTime").val();
                if (dateToFilter != "") {
                    upsertParam('DateTo', dateToFilter);
                }

            }

        } 

        // Tag filtering functionality (multiple selection)
        listing2025_filterTags.forEach(tag => {
            tag.addEventListener('click', function () {

                const listing2025_tagValue = this.getAttribute('data-tag');

                listing2025_firstLoading = false;
                // Handle "All Categories" tag
                if (listing2025_tagValue === 'All') {
                    listing2025_selectedTags = ['All'];
                    listing2025_selectedCategories = [];
                } else {
                    if (listing2025_selectedTags.includes('All')) {
                        listing2025_selectedTags = [];
                        listing2025_selectedCategories = [];
                    }
                    const listing2025_new_categoriesValue = this.getAttribute('data-categories');
                    if (listing2025_selectedTags.includes(listing2025_tagValue)) {
                        listing2025_selectedTags = listing2025_selectedTags.filter(tag => tag !== listing2025_tagValue);
                        listing2025_selectedCategories = listing2025_selectedCategories.filter(categories => categories !== listing2025_new_categoriesValue);
                    } else {
                        listing2025_selectedTags.push(listing2025_tagValue);
                        listing2025_selectedCategories.push(listing2025_new_categoriesValue);
                    }
                    if (listing2025_selectedTags.length === 0) {
                        listing2025_selectedTags.push('All');
                    }
                }
                upsertParam('Category', listing2025_selectedTags.join('|'));
                listing2025_updateTagSelection();
                //lnitLoadParam(false);
                reportsContainer.innerHTML = '';
                renderReports();
            });
        });


        // Apply filters button
        applyFiltersBtn.addEventListener('click', () => {

            listing2025_firstLoading = false;
            lnitLoadParam(false);
            renderReports();
        });

        // Reset filters button
        resetFiltersBtn.addEventListener('click', () => {
            // Reset UI
            listing2025_filterTags.forEach((filter, index) => {
                if (index === 0) {
                    filter.classList.add('active');
                } else {
                    filter.classList.remove('active');
                }
            });

            var dateFrom = new Date($("#highlights_time_startTime").attr("data-date"));
            var dateTo = new Date($("#highlights_time_endTime").attr("data-date"));

            from.datepicker('setDate', dateFrom);
            to.datepicker('setDate', dateTo);

            // Reset state
            listing2025_selectedTags = ['All'];
            listing2025_selectedCategories = [];

            noResults.style.display = 'none';
            listing2025_firstLoading = true;
            upsertParam('Category');
            upsertParam('DateFrom');
            upsertParam('DateTo');
            reportsContainer.innerHTML = '';
            renderReports();
        });

        // Render reports based on filters
        function renderReports() {

            var showMoreCount = parseInt(listing2025_highlights_ITEMS_TO_SHOW);
            var sc_lang = getParameterByName('sc_lang');
            var datasource = '{1B146E3A-6B9D-464D-B3D2-7AF33663CBD3}';
            var currentcount = parseInt($("#currentLoadCount").val());
            var datefrom = getParameterByName('DateFrom')//listing2025_firstLoading ? "" : $("#highlights_time_startTime").val();
            var dateto = getParameterByName('DateTo')//listing2025_firstLoading ? "" : $("#highlights_time_endTime").val();
            var category = JSON.stringify(listing2025_selectedCategories);;

            var dataValue = { "datasource": datasource, "category": category, "datefrom": datefrom, "dateto": dateto, "sc_lang": sc_lang };
            $.ajax({
                type: "POST",
                url: HkexAjaxUtils.getAjaxLink("/services/HKEX/HKEX MARKET/ajaxform.aspx/DisplayCSMListingReportsFilterRecord"),
                data: JSON.stringify(dataValue),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                async: true,
                success: function (result) {
                    if (result.d != null && result.d != "") {
                        renderReport(result.d, showMoreCount);

                        //noResults.style.display = 'none';
                    }
                    else {
                        $('#reportsContainer').empty();
                        //noResults.style.display = 'block';
                    }
                    if ($('#reportsContainer').height() == 0) {
                        noResults.style.display = 'block';
                    } else {
                        noResults.style.display = 'none';
                    }
                },
                error: function (jq, status, message) {
                    if (message == "Not Found") {
                        alert('A jQuery error has occurred. Status: ' + status + ' - Message: ' + message);
                    }
                }
            });
        }

        function checkEmptyOrNull(str) {
            return str === null || str === undefined || str.length === 0;
        }

        function listing2025_updateTagSelection() {
            listing2025_filterTags.forEach(tag => {
                const listing2025_tagValue = tag.getAttribute('data-tag');
                if (listing2025_selectedTags.includes(listing2025_tagValue)) {
                    tag.classList.add('active');
                } else {
                    tag.classList.remove('active');
                }
            });
        }
        function renderReport(JsonStr, showMoreCount) {
            var targetArray = JSON.parse(JsonStr);
            console.log(targetArray);
            targetArray.forEach((mainSection, sectionIndex) => {
                var reportMainSection = document.createElement('div');
                reportMainSection.className = "listing-2025-highlights-time-steps";
                var reportMainSubtitle = document.createElement('div');
                reportMainSubtitle.className = "listing-2025-highlights-time-steps-subtitle";
                if (!checkEmptyOrNull(mainSection.SectionTitle)) {
                    reportMainSubtitle.innerHTML += `<div class="listing-2025-highlights-time-steps-subtitle-head">
                                                        <div class="listing-2025-highlights-time-steps-subtitle-head-title">${mainSection.SectionTitle}</div>
                                                        <div class="listing-2025-highlights-time-steps-subtitle-head-underline"></div>
                                                    </div>`;
                }
                if (!checkEmptyOrNull(mainSection.SectionLink)) {
                    if (!checkEmptyOrNull(mainSection.SectionLink.LinkText)) {
                        reportMainSubtitle.innerHTML += `<a class="listing-2025-highlights-time-steps-subtitle-viewmore" href="${mainSection.SectionLink.LinkURL}" alt="${mainSection.SectionLink.LinkAlt}" target="${mainSection.SectionLink.LinkTarget}">
                                                            <div class="listing-2025-highlights-time-steps-subtitle-viewmore_title">${mainSection.SectionLink.LinkText}</div>
                                                            <div class="listing-2025-highlights-time-steps-subtitle-viewmore_img">
                                                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                                    <path d="M9 6.5L15 12.5L9 18.5" stroke="#E62742" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                                                </svg>
                                                            </div>
                                                        </a>`;
                    }
                }
                if (!checkEmptyOrNull(mainSection.SectionTitle)) {
                    reportMainSection.appendChild(reportMainSubtitle);
                }
                var reportSubSection = document.createElement('div');
                reportSubSection.className = "listing-2025-highlights-time-steps-repeat-parent";
                var subHtml = "";
                var hasSubSectionTitle = mainSection.ReportSubsections.some(subsection => subsection.SectionTitle);

                if (!hasSubSectionTitle) {
                    reportMainSection.className = "listing-2025-highlights-time-steps listing-2025-highlights-time-steps-no-subreporttitle";
                }
                mainSection.ReportSubsections.forEach((subSection, id) => {
                    var reportItemSection = document.createElement('div');
                    reportItemSection.className = "listing-2025-highlights-time-steps-repeat";
                    var reportItemHead = "";
                    
                    if (!checkEmptyOrNull(subSection.SectionTitle)) {
                        reportItemHead += `<div class="listing-2025-highlights-time-steps-repeat-head-title">${subSection.SectionTitle}</div>`;
                        if (!checkEmptyOrNull(subSection.SectionLink)) {
                            reportItemHead += `<a class="listing-2025-highlights-time-steps-repeat-viewmore" href="${subSection.SectionLink.LinkURL}" alt="${subSection.SectionLink.LinkAlt}" target="${subSection.SectionLink.LinkTarget}"><div class="listing-2025-highlights-time-steps-repeat-viewmore_title">${subSection.SectionLink.LinkText}</div><div class="listing-2025-highlights-time-steps-repeat-viewmore_img"><svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M9 6.5L15 12.5L9 18.5\" stroke=\"#E62742\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></div></a>`;
                        }
                    }
                    reportItemSection.innerHTML = reportItemHead ? `<div class="listing-2025-highlights-time-steps-repeat-head" >${reportItemHead}</div>`:"";
                    var reportSection = document.createElement('div');
                    reportSection.className = `listing-2025-highlights-time-steps-content grid-columns-2 listing-2025-highlights-steps-content_list_${sectionIndex}_${id}`;
                    var reportHtml = "";
                    subSection.ReportItems.forEach((reportItem, index) => {
                        const isHidden = index >= showMoreCount ? "hidden-item" : "";
                        if (reportItem.Displayable) {
                            if (!checkEmptyOrNull(reportItem.ReportLink)) {
                                reportHtml += `<a href="${reportItem.ReportLink.LinkURL}" alt="${reportItem.ReportLink.LinkAlt}" target="${reportItem.ReportLink.LinkTarget}" class="listing-2025-highlights-time-steps-content_typeimg ${isHidden}">`;
                            }
                            if (!checkEmptyOrNull(reportItem.ReportImage)) {
                                reportHtml += `<div class="listing-2025-highlights-time-steps-content_typeimg_img"><img src="${reportItem.ReportImage.ImageSource}" alt="${reportItem.ReportImage.ImageAlt}" class="listing-2025-news-image-img"></div>`;
                            }
                            reportHtml += `<div class="listing-2025-highlights-time-steps-content_typeimg_title"><div class="listing-2025-highlights-time-steps-content_typeimg_title_head">`;
                            if (!checkEmptyOrNull(reportItem.ReportTitle)) {
                                reportHtml += `<div class="listing-2025-highlights-time-steps-content_typeimg_title_head-title-top"><div class="listing-2025-highlights-time-steps-content_typeimg_title_head-title">${reportItem.ReportTitle}</div>`;
                                if (!checkEmptyOrNull(reportItem.ReportLink.LinkExt)) {
                                    reportHtml += `<div class="icon_${reportItem.ReportLink.LinkExt.toLowerCase()}">${reportItem.ReportLink.LinkExt}</div>`;
                                }
                                reportHtml += '</div>';
                            }
                            reportHtml += `<div class="listing-2025-highlights-time-steps-content_typeimg_title_head-img"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 6.5L15 12.5L9 18.5" stroke="#E62742" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg></div></div></div>`;
                            if (!checkEmptyOrNull(reportItem.ReportLink)) {
                                reportHtml += '</a>';
                            }
                            reportSection.innerHTML = reportHtml;
                        }
                    });
                    if (subSection.ReportItems.length > 0) {
                        reportItemSection.appendChild(reportSection);
                    }

                    if (subSection.ReportItems.length > 3) {

                        var showmoreSection = document.createElement('div');
                        showmoreSection.className = `listing-2025-highlights-steps-loadmore listing-2025-highlights-steps-loadmore_${sectionIndex}_${id}`;

                        showmoreSection.addEventListener('click', function () {
                            listing2025_hidden_item(sectionIndex, id);
                        });

                        var showmoreHtml = "";

                        showmoreHtml+=`

         <div class="listing-2025-highlights-steps-loadmore-text">
             Show more
         </div>
         <svg xmlns="http://www.w3.org/2000/svg" width="7" height="8" viewBox="0 0 7 8" fill="none">
             <path d="M3.5 7.25L0 0.75H7L3.5 7.25Z" fill="#0066CC" />
         </svg>

 `;
                        showmoreSection.innerHTML = showmoreHtml;
                        reportItemSection.appendChild(showmoreSection);
                     }


                    reportSubSection.appendChild(reportItemSection);
                });
                reportMainSection.appendChild(reportSubSection);
                if (!checkEmptyOrNull(mainSection.SectionLink)) {
                    if (!checkEmptyOrNull(mainSection.SectionLink.LinkText)) {
                        const reportMainSubtitleLastView = document.createElement('div');
                        reportMainSubtitleLastView.className = "listing-2025-highlights-time-steps-subtitle-last-viewmore";
                        reportMainSubtitleLastView.innerHTML = `<div><hr></div>
                                                                <a class="listing-2025-highlights-time-steps-subtitle-viewmore" href="${mainSection.SectionLink.LinkURL}" alt="${mainSection.SectionLink.LinkAlt}" target="${mainSection.SectionLink.LinkTarget}">
                                                                    <div class="listing-2025-highlights-time-steps-subtitle-viewmore_title">${mainSection.SectionLink.LinkText}</div>
                                                                    <div class="listing-2025-highlights-time-steps-subtitle-viewmore_img">
                                                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
                                                                            <path d="M9 6.5L15 12.5L9 18.5" stroke="#E62742" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                                                                        </svg>
                                                                    </div>
                                                                </a>`;
                        reportMainSection.appendChild(reportMainSubtitleLastView);
                    }
                }
                reportsContainer.appendChild(reportMainSection);
            });
        }
    });


    function listing2025_hidden_item(index,id) {

        const listing2025_classNameShowMoreList = `.listing-2025-highlights-steps-content_list_${index}_${id}`;
        const parentElement = document.querySelector(listing2025_classNameShowMoreList);
        const hiddenItems = parentElement.querySelectorAll('.listing-2025-highlights-time-steps-content_typeimg.hidden-item');
        const listing2025_classNameShowMoreIndex = `.listing-2025-highlights-steps-loadmore_${index}_${id}`;
        const listing2025_showMoreBtn = document.querySelector(listing2025_classNameShowMoreIndex);

        for (let i = 0; i < hiddenItems.length; i++) {
            hiddenItems[i].classList.remove('hidden-item');
        }
        listing2025_showMoreBtn.style.display = 'none';
    }

    var from;
    var to;

    function initDatePicker() {
        var datePickerMonth, datePickerDay
        if ($("html").attr("lang") == "zh-HK" || $("html").attr("lang") == "zh-CN") {
            datePickerMonth = ["一月", "二月", "三月", "四月", "五月", "六月", "七月", "八月", "九月", "十月", "十一月", "十二月"]
            datePickerDay = ["日", " 一", "二", "三", "四", "五", "六"]
        } else {
            datePickerMonth = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
            datePickerDay = ["S", "M", "T", "W", "T", "F", "S"]
        }
        var dateFormat = "yy-mm-dd";
        var dateFrom = new Date($("#highlights_time_startTime").attr("data-date"));
        var dateTo = new Date($("#highlights_time_endTime").attr("data-date"));
        var YearRangeVal = $("#YearRange").val();
        from = $("#highlights_time_startTime").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: YearRangeVal,
            dateFormat: dateFormat,
            defaultDate: dateFrom,
            monthNamesShort: datePickerMonth,
            dayNamesMin: datePickerDay,
        }).on("change", function () {
            to.datepicker("option", "minDate", getDate(this));
        });
        to = $("#highlights_time_endTime").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: YearRangeVal,
            dateFormat: dateFormat,
            defaultDate: dateFrom,
            monthNamesShort: datePickerMonth,
            dayNamesMin: datePickerDay,
        }).on("change", function () {
            from.datepicker("option", "maxDate", getDate(this));
        });
        from.datepicker('setDate', dateFrom);
        to.datepicker('setDate', dateTo);
    }

    function getDate(element) {
        var date;
        try {
            date = $.datepicker.parseDate(dateFormat, element.value);
        } catch (error) {
            date = null;
        }
        return date;
    }

</script>






<!-- End NewsletterCardsSFilter -->

        </div>

