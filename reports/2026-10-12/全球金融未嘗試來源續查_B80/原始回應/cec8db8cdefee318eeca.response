        <noscript id="deferred-styles">
            


        </noscript>
        <script src="/assets/js/swiper.min.js?v=20260626174546" type="text/javascript"></script>
<script src="/assets/js/hkex-market-listing.js?v=20260626174546" type="text/javascript" Defer></script>
<script src="/assets/js/hkex-stage.js?v=20260922091002" type="text/javascript" Defer></script>
<script src="/assets/js/hkex-market-site.js?v=20261006174614" type="text/javascript"></script>
<script src="/assets/js/hkex-config-market.js?v=20260902165148" type="text/javascript"></script>
