<!-- Sidepanel -->






    <div class="listing-2025-sidepanel-sidebar">



        <div class="listing-2025-sidepanel-content-block">
            <div class="listing-2025-sidepanel-icon-text-group">
                <div class="listing-2025-sidepanel-icon">
                    <img src="/-/media/HKEX_Common/Market/Listing-Revamp/Others/Listing-RHS-media/Notification.svg?mw=1000&hash=E284FF45EFC538603FEF7E426DF2E6B0FB3D93BA0EB28DC4C13A32B75440F01C" alt="Notification" />
                </div>
                <span class="listing-2025-sidepanel-text--bold">News Alert</span>
            </div>

            


            <a href="https://www.hkex.com.hk/eng/invest/user/login_e.aspx" target="" title="" class="red-button primary-hkex-white-100-text component-button">
                
