                  <a class="swiper-slide listing-2025-tab-tab-item " data-tab="Explore by topic" style="text-decoration: none;color: #10416c;" href="/Listing/News-and-Publications/Newsletters/Explore-by-topic?sc_lang=en">Explore by topic</a>
                           
                
            </div>

            <div class="listing-2025-tab-nav-control listing-2025-tab-next">
                <div class="listing-2025-tab-next_svg">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M9 6.5L15 12.5L9 18.5" stroke="#E62742" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>
<style type="text/css">
    .light-grey-tab-swiper .swiper-slide {
        width: unset;
    }

    .listing-2025-tab-tabs-scroll {
        display: flex;
        overflow-x: unset;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }
	
	.listing-2025-tab-tabs-container .container{
		opacity:0;
	}
</style>
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function () {
        function updateNavButtons(swiperInstance) {
            const prevEl = swiperInstance.navigation.prevEl;
            const nextEl = swiperInstance.navigation.nextEl;
            if (prevEl) {
                prevEl.style.display = prevEl.className.indexOf('swiper-button-disabled') > -1 ? 'none' : 'flex'
                prevEl.style.opacity = prevEl.className.indexOf('swiper-button-disabled') > -1 ? '0' : '1'
            }
            if (nextEl) {
                nextEl.style.display = nextEl.className.indexOf('swiper-button-disabled') > -1 ? 'none' : 'flex'
                nextEl.style.opacity = nextEl.className.indexOf('swiper-button-disabled') > -1 ? '0' : '1'
            }
        }
        function slideToActiveTab(swiperInstance) {
            const slides = document.querySelectorAll('.light-grey-tab-swiper .swiper-slide');
            let activeIndex = -1;
            for (let i = 0; i < slides.length; i++) {
                if (slides[i].classList.contains('listing-2025-tab-active')) {
                    activeIndex = i;
                    break;
                }
            }
            if (activeIndex !== -1 && swiperInstance) {
                swiperInstance.slideTo(activeIndex, true);
            }
        }
        const lightGreyTabSwiper = new Swiper('.light-grey-tab-swiper', {
            wrapperClass: 'listing-2025-tab-tabs-scroll swiper-wrapper',
           	slidesPerView: 'auto',
            slidesPerGroup: 1,
            spaceBetween: 0,
            watchOverflow: true,
            breakpoints: {
                768: {
                    slidesPerView: 'auto',
                    slidesPerGroup: 4,
                }
            },
            navigation: {
                nextEl: '.listing-2025-tab-next',
                prevEl: '.listing-2025-tab-prev',
            },
            on: {
                init: function () {
                    updateNavButtons(this);
                    slideToActiveTab(this);
                },
                slideChange: function () {
                    updateNavButtons(this);
                },
                reachEnd: function (swiper) {
                    setTimeout(() => {
                        updateNavButtons(swiper);
                    }, 100);
                }
            }
        });
		
		$(".listing-2025-tab-tabs-container>.container").css({'opacity':1});
    });
</script>



<!-- End Tab -->

<div class="listing-2025-new_sidepanel">
    <div class="container">
        <div class="listing-2025-new_sidepanel_left">
            


<!-- NewsletterCardsMFilter -->



<div id="10F28FDBF7E74B15A1E63481EB7337AE" class="stage_section_anchor_point" data-anchor-title="" title=""></div>



<div class="listing-2025-newdown">

    <div class="listing-2025-newdown-section">

        <div class="listing-2025-newdown-section-filter">
            <div class="listing-2025-newdown-section-filter-label">Released in</div>
            <div class="listing-2025-newdown-section-filter-year">
                <div class="listing-2025-newdown-section-filter-year-selected" id="year-selected">All Years</div>
                    <div class="options scrolling" id="options">
                        <div class="option">All Years</div>
                        
                        <div class="option">2026</div>
                        
                        <div class="option">2025</div>
                        
                        <div class="option">2024</div>
                        
                        <div class="option">2023</div>
                        
                        <div class="option">2022</div>
                        
                        <div class="option">2021</div>
                        
                        <div class="option">2020</div>
                        
                        <div class="option">2019</div>
                        
                        <div class="option">2018</div>
                        
                        <div class="option">2017</div>
                        
                    </div>
                
            </div>
        </div>
<div class="listing-2025-newdown-section-content" id="newsContainer">
        </div>
        <input type="hidden" id="currentLoadCount" value="0">
        <div class="no-results-message" id="noResultsMessage">
            <div>
                <img src="/assets/images/svg/Group10284.svg" class="noResultsMessage_img" />
            </div>
            <div class="noResultsMessage_dec">
                <div class="noResultsMessage_dec_top">No results</div>
                <div class="noResultsMessage_dec_title">
                    Please change keywords or reset the filters
                </div>
            </div>
        </div>


        <div class="load-more-container" id="loadingIndicator">
            <div class="listing-2025-load-more" id="loadMoreBtn">
                <div>
                    <img src="/assets/images/loading.gif" alt="" class="listing-2025-load-more_img">
                </div>
                <div class="listing-2025-load-more_text">Load more</div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        // DOM elements
        const listing2025_Container = document.getElementById('newsContainer');
        const listing2025_new_noResultsMessage = document.getElementById('noResultsMessage');
        const listing2025_newdown_yearSelect = document.getElementById('year-selected');

        const desktopHeightThreshold = 186;
        const mobileHeightThreshold = 288;
        let listing2025_newdown_isLoading = false;
        let listing2025_firstLoading = true;
        let lastIndex = 1;
        listing2025_newdown_initPage();

        // Initialize the page
        function listing2025_newdown_initPage() {
            const yearParam = getParameterByName("Year");
            if (yearParam != null) {
                listing2025_newdown_yearSelect.textContent = yearParam;
                listing2025_firstLoading = false;
            }
            listing2025_newdown_renderNewsletters();
            listing2025_newdown_setupEventListeners();
            //scrollingStyle('#options');
        }

        // Setup event listeners
        function listing2025_newdown_setupEventListeners() {
            ToggleOptions("#year-selected");
            
        }
        function ToggleOptions(ele) {
            const options = $('#options');
            $(ele).on('click', function () {
                $(options).toggleClass("open");
            });
            $.each($(".option"), function (index, element) {
                $(element).on('click', function () {
                    $("#currentLoadCount").val(0);
                    $('#newsContainer').empty();
                    $(ele).text($(this).text());
                    $(this).closest(".options").removeClass("open");
                    if (index === 0) {
                        listing2025_firstLoading = true;
                        upsertParam("Year");
                    } else {
                        upsertParam("Year", $(ele).text());
                        listing2025_firstLoading = false;
                    }
                    listing2025_newdown_renderNewsletters();
                });
            });
        }
        //// Setup event listeners
        //function listing2025_newdown_setupEventListeners() {
        //    // Year filter
        //    listing2025_newdown_yearSelect.addEventListener('change', () => {
        //        $("#currentLoadCount").val(0);
        //        $('#newsContainer').empty();
        //        if (listing2025_newdown_yearSelect.selectedIndex === 0) {
        //            listing2025_firstLoading = true;
        //            upsertParam("Year");
        //        } else {
        //            upsertParam("Year", listing2025_newdown_yearSelect.value);
        //            listing2025_firstLoading = false;
        //        }

        //        listing2025_newdown_renderNewsletters();
        //        this.blur();
        //    });
        //}

        // Scroll loading functionality
        window.addEventListener('scroll', function () {
            if (listing2025_newdown_isLoading) return;

            const listing2025_new_scrollPosition = window.scrollY || document.documentElement.scrollTop;
            const listing2025_new_windowHeight = window.innerHeight;
            const listing2025_new_documentHeight = document.documentElement.scrollHeight;

            if (listing2025_new_scrollPosition + listing2025_new_windowHeight >= listing2025_new_documentHeight - 300) {
                listing2025_newdown_renderNewsletters();
            }
        });

        function listing2025_new_loadMoreNews_loadMore(show) {
            if (show) {
                $('#loadingIndicator').css("display", "block");
            } else {
                $('#loadingIndicator').css("display", "none");
            }
        }

        function listing2025_newdown_renderNewsletters() {

            var sc_lang = getParameterByName('sc_lang'); 
            var datasource = '{10F28FDB-F7E7-4B15-A1E6-3481EB7337AE}';
            var currentcount = parseInt($("#currentLoadCount").val());
            var loadmorecount = parseInt(10);
            var year = listing2025_firstLoading ? "" : $("#year-selected").text();
            var dataValue = { "datasource": datasource, "year": year, "currentcount": currentcount, "loadmorecount": loadmorecount, "sc_lang": sc_lang };
            $.ajax({
                type: "POST",
                url: HkexAjaxUtils.getAjaxLink("/services/HKEX/HKEX MARKET/ajaxform.aspx/DisplayCSMListingNewsletterYear"),
                data: JSON.stringify(dataValue),
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                async: true,
                beforeSend: function () {
                    listing2025_newdown_isLoading = true;
                    listing2025_new_loadMoreNews_loadMore(true);
                },
                success: function (result) {
                    if (result.d != null && result.d != "") {

                        var targetArray = JSON.parse(result.d);
                        console.log(targetArray);
                        targetArray.forEach((card) => {
                            const listing2025_card = listingNewsletterDataJsonHtml(card, lastIndex);
                            listing2025_Container.appendChild(listing2025_card);
                            lastIndex++;
                        });

                        $("#currentLoadCount").val(currentcount + loadmorecount);
                        listing2025_new_noResultsMessage.style.display = 'none';
                        listing2025_newdown_isLoading = false;
                        listing2025_new_loadMoreNews_loadMore(false);
                        var listing2025_newdown_section_content_body_lists = document.querySelectorAll('.listing-2025-newdown-section-content-body_list');
                        listing2025_newdown_section_content_body_lists.forEach((list, index) => {

                            const button = list.querySelector('.listing-2025-newdown-section-content-body_list-showmore');
                            const divContent = list.querySelector('.listing-2025-newdown-section-content-body_list-content');
                            //const ul = list.querySelector('ul');

                            var contentHeight = 0;//ul.getBoundingClientRect().height;
                            $(divContent).children().each(function() {
                                contentHeight += $(this).height();
                            });
                            const isMobile = window.innerWidth < 786;
                            const heightThreshold = isMobile ? mobileHeightThreshold : desktopHeightThreshold;

                            if (contentHeight > heightThreshold + 10) {
                                button.style.display = 'flex';
                                //listing-2025-newdown-section-content-body_list-content
                                divContent.style.maxHeight = heightThreshold + 'px';
                                divContent.style.overflowY = 'hidden';
                                divContent.style.transition = 'max-height 0.3s ease';
                                //const ul = list.querySelectorAll('ul');
                                //if (ul.length > 0 ) {
                                //    ul.forEach(ulItem => {
                                //        ulItem.style.maxHeight = heightThreshold + 'px';
                                //        ulItem.style.overflowY = 'hidden';
                                //        ulItem.style.transition = 'max-height 0.3s ease';
                                //    });
                                //}
                                //ul.style.maxHeight = heightThreshold + 'px';
                                //ul.style.overflowY = 'hidden';
                                //ul.style.transition = 'max-height 0.3s ease';

                            } else {
                                button.style.display = 'none';
                            }

                        });
                    }
                    else {

                        listing2025_newdown_isLoading = true;
                        if ($('#newsContainer').text().trim()) {
                            listing2025_new_noResultsMessage.style.display = 'none';
                        } else {
                            listing2025_new_noResultsMessage.style.display = 'block';
                        }
                        listing2025_new_loadMoreNews_loadMore(false);
                    }
                },
                error: function (jq, status, message) {
                    listing2025_newdown_isLoading = true;
                    if (message == "Not Found") {
                        alert('A jQuery error has occurred. Status: ' + status + ' - Message: ' + message);
                    }
                }
            });
        }
    });

    function listingNewsletterDataJsonHtml(card, id) {
        const listing2025_card = document.createElement('div');
        listing2025_card.className = 'listing-2025-newdown-section-content-card';

        let listing2025_listHTML = '';

        listing2025_listHTML += ` <div class="listing-2025-newdown-section-content-grid">
        <div class="listing-2025-newdown-section-content-grid-imagestack">
            <div class="listing-2025-newdown-section-content-grid-image">
                <img src="${card.NewsletterImage}" alt="${card.NewsletterImageAlt}">
            </div>
            <div class="listing-2025-newdown-section-content-grid-circle remove-border">
                <div class="listing-2025-news-share-btn remove-bgcolor" data-id="${id}">
                    <svg xmlns="http://www.w3.org/2000/svg" width="12" height="14" viewBox="0 0 12 14" fill="none">
                        <path d="M10 13.6668C9.44444 13.6668 8.97222 13.4724 8.58333 13.0835C8.19444 12.6946 8 12.2224 8 11.6668C8 11.6002 8.01667 11.4446 8.05 11.2002L3.36667 8.46683C3.18889 8.6335 2.98333 8.76416 2.75 8.85883C2.51667 8.9535 2.26667 9.00061 2 9.00016C1.44444 9.00016 0.972222 8.80572 0.583333 8.41683C0.194444 8.02794 0 7.55572 0 7.00016C0 6.44461 0.194444 5.97238 0.583333 5.5835C0.972222 5.19461 1.44444 5.00016 2 5.00016C2.26667 5.00016 2.51667 5.0475 2.75 5.14216C2.98333 5.23683 3.18889 5.36727 3.36667 5.5335L8.05 2.80016C8.02778 2.72238 8.014 2.6475 8.00867 2.5755C8.00333 2.5035 8.00044 2.42283 8 2.3335C8 1.77794 8.19444 1.30572 8.58333 0.916829C8.97222 0.527941 9.44444 0.333496 10 0.333496C10.5556 0.333496 11.0278 0.527941 11.4167 0.916829C11.8056 1.30572 12 1.77794 12 2.3335C12 2.88905 11.8056 3.36127 11.4167 3.75016C11.0278 4.13905 10.5556 4.3335 10 4.3335C9.73333 4.3335 9.48333 4.28616 9.25 4.1915C9.01667 4.09683 8.81111 3.96638 8.63333 3.80016L3.95 6.5335C3.97222 6.61127 3.98622 6.68638 3.992 6.75883C3.99778 6.83127 4.00044 6.91172 4 7.00016C3.99956 7.08861 3.99689 7.16927 3.992 7.24216C3.98711 7.31505 3.97311 7.38994 3.95 7.46683L8.63333 10.2002C8.81111 10.0335 9.01667 9.90305 9.25 9.80883C9.48333 9.71461 9.73333 9.66727 10 9.66683C10.5556 9.66683 11.0278 9.86127 11.4167 10.2502C11.8056 10.6391 12 11.1113 12 11.6668C12 12.2224 11.8056 12.6946 11.4167 13.0835C11.0278 13.4724 10.5556 13.6668 10 13.6668Z" fill="#144168"></path>
                    </svg>
                </div>
                <div class="listing-2025-news-share_block listing-2025-newdown_block" id="shareBlock${id}">
                    <svg class="listing-2025-news-share_block_tri" width="20" height="10" viewBox="0 0 20 10"><polygon points="10,0 20,10 0,10" fill="#333"></polygon></svg>
                    <div class="listing-2025-news-share_block_in">
                        <a class="share-icon twitter" data-platform="twitter" href="https://twitter.com/intent/tweet?text=HKEX%20Senior%20Management%20Appointments%20Http%3a%2f%2fwww.hkex.com.hk%2fNews%2fNews-Release%2f2025%2f250704news%3fsc_lang%3den"><i class="fab fa-twitter"></i></a>
                        <a class="share-icon linkedin" data-platform="linkedin" href="https://www.linkedin.com/shareArticle?mini=true&amp;url=Http%3a%2f%2fwww.hkex.com.hk%2fNews%2fNews-Release%2f2025%2f250704news%3fsc_lang%3den&amp;title=HKEX%20Senior%20Management%20Appointments&amp;summary=HKEX%20Senior%20Management%20Appointments"><i class="fab fa-linkedin-in"></i></a>
                        <a class="share-icon wechat" data-platform="wechat" href="https://www.hkex.com.hk/Global/Follow-Us-on-WeChat?sc_lang=en"><i class="fab fa-weixin"></i></a>
                        <a class="share-icon facebook" data-platform="facebook" href="https://www.facebook.com/sharer/sharer.php?u=Http%3a%2f%2fwww.hkex.com.hk%2fNews%2fNews-Release%2f2025%2f250704news%3fsc_lang%3den"><i class="fab fa-facebook-f"></i></a>
                        <a class="share-icon weibo" data-platform="weibo" href="http://service.weibo.com/share/share.php?url=Http%3a%2f%2fwww.hkex.com.hk%2fNews%2fNews-Release%2f2025%2f250704news%3fsc_lang%3den&amp;appkey=&amp;title=HKEX%20Senior%20Management%20Appointments&amp;pic=&amp;ralateUid=&amp;language=zh_cn"><i class="fab fa-weibo"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="listing-2025-newdown-section-content-body">
            <div class="listing-2025-newdown-section-content-body_head">
                <div class="listing-2025-newdown-section-content-body_head-title">
                    <a href="${card.LinkURL}" title="${card.LinkAlt}" target="${card.LinkTarget}" rel="noreferrer noopener">${card.NewsletterTitle}</a>
                </div>
                ${card.LinkExt ? `<div class="listing-2025-newdown-section-content-body_head-type">${card.LinkExt}</div>` : ''}
            </div>
            <div class="listing-2025-newdown-section-content-body_list listing-2025-newdown-section-content-body_list_ui_${id}" id="listing2025_newdown_section_content_body_list_${id}">
                <div class="listing-2025-newdown-section-content-body_list-content">
               ${card.NewsletterDescription == null ? '' : card.NewsletterDescription}
               </div>
                <div class="listing-2025-newdown-section-content-body_list-showmore listing-2025-newdown-section-content-body_list-showmore_${id}" id="listing2025_newdown_section_content_body_list_showmore_${id}" style="display: flex;">
                    <div class="listing-2025-newdown-section-content-body_list-showmore_title" onclick="listing2025_newdown_toggleContent(${id})">Show more</div>
                    <div>
                        <svg xmlns="http://www.w3.org/2000/svg  " width="7" height="8" viewBox="0 0 7 8" fill="none" onclick="listing2025_newdown_toggleContent(${id})">
                            <path class="icon-path" d="M3.5 7.25L0 0.75H7L3.5 7.25Z" fill="#0066CC"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>`;

        listing2025_card.innerHTML = listing2025_listHTML;
        return listing2025_card;
    }

    function listing2025_newdown_toggleContent(index) {

        //const list = document.querySelector(`.listing-2025-newdown-section-content-body_list_ui_${index} ul`);
        const button = document.querySelector(`.listing-2025-newdown-section-content-body_list-showmore_${index}`);
        const list = document.querySelector(`.listing-2025-newdown-section-content-body_list_ui_${index}`);
        const listContent = list.querySelector(".listing-2025-newdown-section-content-body_list-content");
        const listing2025_newdown_classNameShowMoreIndex = `.listing-2025-newdown-section-content-body_list-showmore_${index}`;
        const listing2025_newdown_showMoreBtn = document.querySelector(listing2025_newdown_classNameShowMoreIndex);
        const isMobile = window.innerWidth < 786;
        const desktopHeightThreshold = 186;
        const mobileHeightThreshold = 288;
        const heightThreshold = isMobile ? mobileHeightThreshold : desktopHeightThreshold;
        const listing2025_newdown_showMoreBtn_title = listing2025_newdown_showMoreBtn.querySelector('.listing-2025-newdown-section-content-body_list-showmore_title');
        if (list && button) {
            if (button.classList.contains('expanded')) {

                // Collapse the list
                listContent.style.maxHeight = heightThreshold + 'px';
                listContent.style.overflowY = 'hidden';
                button.classList.remove('expanded');

                listing2025_newdown_showMoreBtn.classList.remove('open');
                listing2025_newdown_showMoreBtn_title.innerText = 'Show more';
                listing2025_newdown_ArrowIcon(listing2025_newdown_showMoreBtn);
            } else {

                // Expand the list
                listContent.style.maxHeight = listContent.scrollHeight + 'px';
                listContent.style.overflowY = 'hidden';
                button.classList.add('expanded');

                listing2025_newdown_showMoreBtn.classList.add('open');
                listing2025_newdown_showMoreBtn_title.innerText = 'Show less';
                listing2025_newdown_ArrowIcon(listing2025_newdown_showMoreBtn);
            }
        }
    }

    function listing2025_newdown_ArrowIcon(item) {

        const icon = item.querySelector('.icon-path');
        if (item.classList.contains('open')) {
            icon.setAttribute('d', 'M3.5 0.75L7 7.25L0 7.25L3.5 0.75Z');
        } else {
            icon.setAttribute('d', 'M3.5 7.25L0 0.75H7L3.5 7.25Z');
        }
    }


    // Sharing functionality
    document.addEventListener('click', function (e) {
        // Share button click
        if (e.target.closest('.listing-2025-news-share-btn')) {
            const listing2025_new_button = e.target.closest('.listing-2025-news-share-btn');
            const listing2025_new_shareId = listing2025_new_button.getAttribute('data-id');
            const listing2025_new_shareBlock = document.getElementById(`shareBlock${listing2025_new_shareId}`);

            document.querySelectorAll('.listing-2025-news-share_block').forEach(block => {
                if (block !== listing2025_new_shareBlock) {
                    block.classList.remove('active');
                }
            });

            listing2025_new_shareBlock.classList.toggle('active');
        }
        // Share icon click
        else if (e.target.closest('.share-icon')) {
            const listing2025_new_icon = e.target.closest('.share-icon');
            const listing2025_new_platform = listing2025_new_icon.getAttribute('data-platform');
            const listing2025_new_card = listing2025_new_icon.closest('.listing-2025-news-card');
            const listing2025_new_title = listing2025_new_card.querySelector('.listing-2025-news-text-head-title a').textContent;

            /*            alert(`Attempting to share to: ${listing2025_new_platform}\nTitle: ${listing2025_new_title}`);*/

            document.querySelectorAll('.listing-2025-news-share_block').forEach(block => {
                block.classList.remove('active');
            });
        }
        // Click elsewhere on the page closes share blocks
        else {
            document.querySelectorAll('.listing-2025-news-share_block').forEach(block => {
                block.classList.remove('active');
            });
        }
    });

    function upsertParam(url, key, val) {
        const u = new URL(url, window.location.origin);
        if (val === '' || val == null) {
            u.searchParams.delete(key);
        } else {
            u.searchParams.set(key, val);
        }
        return u.toString();
    }

    function getParameterByName(name, url) {
        if (url == '') url = window.location.href;
        name = name.replace(/[\[\]]/g, '\\$&');
        var regex = new RegExp('[?&]' + name + '(=([^&#]*)|&|#|$)'),
            results = regex.exec(url);
        if (!results) return null;
        if (!results[2]) return '';
        return decodeURIComponent(results[2].replace(/\+/g, ' '));
    }
</script>




<!-- End NewsletterCardsMFilter -->

        </div>

        <div class="listing-2025-new_sidepanel_right">
            

<!-- Sidepanel -->






    <div class="listing-2025-sidepanel-sidebar">



