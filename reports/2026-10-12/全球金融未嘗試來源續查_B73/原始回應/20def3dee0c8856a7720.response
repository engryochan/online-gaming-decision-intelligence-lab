        --QMOD-secondary-text: #555;
        --QMOD-ticker-red: #D9363D;
        --QMOD-ticker-green: #007600;
        --QMOD-primary-color: var(--qmods-link-color);
        --qmods-primary: #1b2935;
        --qmods-primary-hover: #000;
        --qmods-link-color: #0061af;

        /* Headlines */
        --qmods-headline-font-family: "Inter", "Roboto", Arial, Helvetica, Verdana, sans-serif;
