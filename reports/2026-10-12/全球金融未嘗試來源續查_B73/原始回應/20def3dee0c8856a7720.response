<script>
    document.getElementById('qmRequestForm').addEventListener('submit', e => {
        e.preventDefault();
        const data = new FormData(e.target);
        fetch('', { method: 'POST', body: data })
            .then(res => res.json())
            .then(() => {
                document.getElementById('formSendFesult').textContent = 'Thank you!';
                e.target.reset();
            });
    });
</script>
