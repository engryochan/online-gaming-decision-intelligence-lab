    }
    #implementation {
        background: #efefef;
    }

    #widgets {
        background: #cad6dc;
    }
    #contact {
        background: #fff;
    }
    .qmod-ui-tool .qmod-ch-up {
        color: #0d0;
        position: relative;
    }
    /* FORM STYLES */
    .form-section {
        background: #efefef;
        padding: 1.5rem;
        border-radius: 3px;
        margin-bottom: 1.5rem;
    }
    .form-section .input-label,
