        font-size: 14px;
    }
    /* COMMON PAGE SYLES */
    .widget-accordion .qtool {
        margin: 40px;
    }
    @media (max-width:600px) {
        .widget-accordion .qtool {
            margin: 20px 20px;
        }
    }
    .widget-accordion .ac,
    .widget-accordion .ac.is-active {
        border: none;
    }
    .widget-accordion .ac-header {
        background-color: #1b2935;
        color: white;
        border-radius: 3px;
    }
    .widget-accordion .ac-header button {
        color: white!important;
        font-weight: 400!important;
        line-height: 1.4!important;
        padding: 6px 26px 8px 10px!important;
        font-size: 14px!important;
    }
    .widget-accordion .ac-header button:focus {
        outline: none;
    }
    .widget-accordion .ac-header button:hover,
    .widget-accordion .ac-header button:active,
    .widget-accordion .ac-header button:focus {
        color: #16fffb!important;
    }
    .text-tiny {
