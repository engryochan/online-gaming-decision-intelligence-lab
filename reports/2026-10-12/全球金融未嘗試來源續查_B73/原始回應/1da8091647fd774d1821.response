            <td>
            <p>Temporary licensed corporation</p>
            </td>
            <td>
            <p>Types 1, 2, 4, 5, 6, 10&nbsp;</p>
            </td>
            <td>
            <p>$4,900 per RA</p>
            </td>
        </tr>
        <tr>
            <td>
            <p>Registered institution (RI)</p>
            </td>
            <td>
            <p>Types 1, 2, 4, 5, 6, 7, 9, 10, 13</p>
            </td>
            <td>
            <p><a class="colorboxModal cboxElement" href="https://www.sfc.hk/-/media/EN/files/LIC/handbook/footnote_fee_per_ra.png?rev=65d6f6eb5bb043fea3340b7ac10cdffe&amp;hash=40A2BD76FCBDE3ED8180049EF6D34FAF">$23,500 per RA</a></p>
            </td>
        </tr>
        <tr>
            <td rowspan="2">
            <p>Licensed representative</p>
            </td>
            <td>
            <p>Types 1, 2, 4, 5, 6, 7, 8, 9, 10, 13</p>
            </td>
