<div class="naming-conventions__item">
<div class="X-content-container"><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>-</span><span>S</span><span>B</span></div>
<div class="naming-conventions__item">
<div class="X-content-container"><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>Q</span><span>-</span><span>S</span><span>W</span></div>
