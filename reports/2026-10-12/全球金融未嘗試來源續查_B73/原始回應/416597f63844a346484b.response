<select  
        id="CodEstado"
        name="CodEstado"
        data-placeholder="Seleccione un estado..."
        data-value-field="Codigo"
        data-label-field="Descripcion"
        data-search-field="Descripcion"
        data-preload="FOCUS"
        data-selection-type="SINGLE"
        data-max-items="1"
        data-apialias="Estado"
        data-load-value=""
        data-parameter-order="2"
        data-parameter-dependencies=""
        data-control-default-value=I
        data-control-default-text=INSCRITO
        >
        <option value="I">INSCRITO</option>
</select>

                        <span class="field-validation-valid text-danger" data-valmsg-for="CodEstado" data-valmsg-replace="true"></span>
