<script>
(function() {
  if (typeof window.allEquitiesData === 'undefined') {
    window.allEquitiesData = [];
  }

  function loadTickerData() {
    if (window.allEquitiesData.length > 0) {
      if (typeof updateTickerDisplay === 'function') updateTickerDisplay();
      return;
    }
    $.ajax({
      method: "GET",
      url: "https://market-backend.aixkz.com/api/table/mw-main-records"
    })
    .done(function (data) {
      if (data && data.length > 0) {
        window.allEquitiesData = data;
        if (typeof updateTickerDisplay === 'function') updateTickerDisplay();
      }
    });
  }

  $(function() { loadTickerData(); });
})();
</script>
<script>
$(function () {

});
</script>
<script>
$(function () {
    $('.tablewrap table').each(function() {
        const $table = $(this);

        if ($table.hasClass('no-sort')) return;

        let currentSort = { column: null, direction: 'asc' };
        let originalData = [];

        $table.find('tbody tr').each(function() {
            const rowData = [];
            $(this).find('td').each(function() {
                rowData.push({
                    html: $(this).html(),
                    text: $(this).text().trim()
                });
            });
            if (rowData.length > 0) originalData.push(rowData);
        });

        $table.find('thead th').each(function() {
            const $th = $(this);
            const inner = $th.html().trim();
            const text = $th.text().trim();
            $th.attr('data-sort-text', text);
            $th.html(`
                <div>
                    <div class="th-inner">${inner}</div>
                    <svg width="15" height="14" viewBox="0 0 15 14" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M6.96967 10.4125C7.26256 10.7053 7.73744 10.7053 8.03033 10.4125L12.8033 5.63948C13.0962 5.34659 13.0962 4.87172 12.8033 4.57882C12.5104 4.28593 12.0355 4.28593 11.7426 4.57882L7.5 8.82146L3.25736 4.57882C2.96447 4.28593 2.48959 4.28593 2.1967 4.57882C1.90381 4.87172 1.90381 5.34659 2.1967 5.63948L6.96967 10.4125ZM6.75 9.05859L6.75 9.88212L8.25 9.88212L8.25 9.05859L6.75 9.05859Z" fill="#C09A5D"/>
                    </svg>
                </div>
            `);
        }).addClass('sortable').on('click', function() {
            const columnIndex = $(this).index();

            if (currentSort.column === columnIndex) {
                currentSort.direction = currentSort.direction === 'asc' ? 'desc' : 'asc';
            } else {
                currentSort.column = columnIndex;
                currentSort.direction = 'asc';
            }

            const sortedData = [...originalData].sort((a, b) => {
                let aVal = a[columnIndex]?.text || '';
                let bVal = b[columnIndex]?.text || '';

                const parseDate = (str) => {
                    const dotParts = str.split('.');
                    if (dotParts.length === 3 && dotParts[2].length === 4) {
                        return new Date(dotParts[2], dotParts[1] - 1, dotParts[0]);
                    }
                    const dashParts = str.split('-');
                    if (dashParts.length === 3 && dashParts[0].length === 4) {
                        return new Date(dashParts[0], dashParts[1] - 1, dashParts[2]);
                    }
                    return null;
                };
                const aDate = parseDate(aVal);
                const bDate = parseDate(bVal);

                if (aDate && bDate) {
                    return currentSort.direction === 'asc'
                        ? aDate - bDate
                        : bDate - aDate;
                }

                const aNum = parseFloat(aVal.replace(/[^\d.-]/g, ''));
                const bNum = parseFloat(bVal.replace(/[^\d.-]/g, ''));

                if (!isNaN(aNum) && !isNaN(bNum)) {
                    return currentSort.direction === 'asc' ? aNum - bNum : bNum - aNum;
                }

                aVal = aVal.toLowerCase();
                bVal = bVal.toLowerCase();

                return currentSort.direction === 'asc'
                    ? aVal > bVal ? 1 : aVal < bVal ? -1 : 0
                    : aVal < bVal ? 1 : aVal > bVal ? -1 : 0;
            });

            const tbody = $table.find('tbody');
            tbody.empty();
            sortedData.forEach(row => {
                tbody.append('<tr>' + row.map(cell => `<td>${cell.html}</td>`).join('') + '</tr>');
            });

            $table.find('thead th').removeClass('sorted-asc sorted-desc');
            $(this).addClass(`sorted-${currentSort.direction}`);
        });
    });
});
</script>
