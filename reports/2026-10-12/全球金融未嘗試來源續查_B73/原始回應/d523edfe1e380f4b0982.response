async function getFilterSelected(indexOfData)
{

    if (document.getElementById('SecuritiesNoList') !== null) {
        document.getElementById('SecuritiesNoList').value = indexOfData;
    }
    if (document.getElementById('routerList') !== null) {
        document.getElementById('routerList').value = indexOfData;
    }
    if (document.getElementById('SecuritiesNamesList') !== null) {
        document.getElementById('SecuritiesNamesList').value = indexOfData;
    }
    if (document.getElementById('ISINmenu') !== null) {
        document.getElementById('ISINmenu').value = indexOfData;
    }

}


async function getFilterResulte(categoryId, CorporateAction, ActionDescription, sectorId, issuerStatus, sectorNo, routerNo, sectorName, ISIN, dteFrom, dteTo,sortBy,TableId)
{



    var url = 'publicShareholdingCompaniesFilterResultsPage?json=1&categoryId=' + categoryId;

    if (typeof CorporateAction !== "undefined") {
        url += '&mnuTransType=' + CorporateAction;
    }

    if (typeof ActionDescription !== "undefined") {
        url += '&mnuActionType=' + ActionDescription;
    }
    if (typeof sectorId !== "undefined") {
        url += '&member_sub_cat=' + sectorId;
    }
    if (typeof issuerStatus !== "undefined") {
        url += '&mnuStatus=' + issuerStatus;
    }
    if (typeof sectorNo !== "undefined") {
        url += '&mnuSecuritiesNo=' + sectorNo;
    }
    if (typeof routerNo !== "undefined") {
        url += '&mnuReuter=' + routerNo;
    }
    if (typeof sectorName !== "undefined") {
        url += '&mnuSecurities=' + sectorName;
    }
    if (typeof ISIN !== "undefined") {
        url += '&mnuISIN=' + ISIN;
    }
    url += '&dteFrom=' + dteFrom + '&dteTo=' + dteTo + '&chkSearchView=' + sortBy;
    var resulteFrom = document.getElementById("resulte-from");
    if (categoryId == 1)
    {
        resulteFrom.textContent = `نتائج البحث في الشركات المساهمة العامة`;
    }
    else
    {

        if (categoryId == 2)
        {
            resulteFrom.textContent = `نتائج البحث في شركات الخدمات المالية`;
        } else
        {
            resulteFrom.textContent = `نتائج البحث في شركات الحفظ الأمين`;
        }
    }


        const response = await fetch(url);
        const data = await response.json();








    if( categoryId == 1 )
    {
        getResultPublic(data,sortBy,TableId);
    }
    else
    {
        if(categoryId == 2)
        {
             getResultFinancial(data,sortBy,TableId)
        }


        else
        {
            getResultCustodians(data,sortBy,TableId)
        }
    }


    if (data.length != 0) {
        jQuery(".btn-ring").hide();
        jQuery("#get-result").prop('disabled', false);
    }



}
function showLoadingAnimation() {
    document.getElementById('loading-animation').style.display = 'block';
}

// Function to hide the loading animation
function hideLoadingAnimation() {
    document.getElementById('loading-animation').style.display = 'none';
}

function getResultPublic(dataTable,sortBy,TableId)
{

    counter = 0;
    var divOfTable = document.getElementById('resulte');
    let childDiv = document.querySelector('groupTable');
    if (childDiv) {
        childDiv.remove();
    }
    if (typeof dataTable['Results']['Table'] !== "undefined") {
        divOfTable.innerHTML = `<div id="loading-animation" style="display: none;">تحميل...</div>`;
        if(sortBy == 2)
        {
            Object.entries(dataTable['Results']['Table']).forEach(([key, value]) => {
                if (key !== 'total_col') {
                TableId.push(key);
                divOfTable.innerHTML += `
                <table id="${key}">
                    <thead>
                        <tr>
                            <th colspan = "6">${key}</th>
                        </tr>
                    </thead>
                    </table>`;


                    Object.entries(value).forEach(([valueKey, innerValue]) => {
                        if (valueKey !== 'total_col') {
                        var divOfTableTml = "";
                        counter = counter + 1;
                         TableId.push(`${valueKey}`);
                        divOfTableTml +=`<table id="${valueKey}">
                        <tbody>
                            <tr>
                                <td colspan = "6" style="text-align: center;">  ${innerValue.SubTitleSplite.member_name} (${innerValue.SubTitleSplite.COMPANY_NO.label} : <a target = "_blank" href="companyInfo?member_info=${innerValue.SubTitleSplite.issuer_id_for_link}" style="color: var(--main-color);border-bottom: 1px solid;">${innerValue.SubTitleSplite.COMPANY_NO.value}</a>
                                ${innerValue.SubTitleSplite.L_ISIN.label} : <a style="color: var(--main-color);border-bottom: 1px solid;" target = "_blank" href="securityInformation?security_id=${innerValue.SubTitleSplite.issuer_id_for_link}">${innerValue.SubTitleSplite.L_ISIN.value}</a>
                                ${innerValue.SubTitleSplite.L_REUTER_CODE2.label} : <a style="color: var(--main-color);border-bottom: 1px solid;" target = "_blank" href="securityInformation?security_id=${innerValue.SubTitleSplite.issuer_id_for_link}">${innerValue.SubTitleSplite.L_REUTER_CODE2.value}</a>)</td>
                            </tr>
                            <tr>
                                <th>${innerValue.ColumnName['Serial']}</th>
                                <th style="min-width: 100px;">${innerValue.ColumnName['Action Date']}</th>
                                <th>${innerValue.ColumnName['Corporate Action']}</th>
                                <th>${innerValue.ColumnName['Action Description']}</th>
                                <th>${innerValue.ColumnName['Before Action']}</th>
                                <th>${innerValue.ColumnName['After Action']}</th>

                            </tr>
                        `;

                        Object.entries(innerValue.rows).forEach(([innerValueKey, innerRowsValue]) => {
                            var color ="color: inherit";
                            if(innerRowsValue['ACTION_TYPE_status'] == 1)
                            {
                                var color ="color: green";

                            }
                            if(innerRowsValue['ACTION_TYPE_status'] == 2)
                            {
                                var color ="color: blue";

                            }
                        divOfTableTml+= `
                        <tr>
                            <td>${innerRowsValue['Serial']}</td>
                            <td>${innerRowsValue['Action Date']}</td>
                            <td>${innerRowsValue['Corporate Action']}</td>
                            <td style="${color}">${innerRowsValue['Action Description']}</td>
                            <td>${innerRowsValue['Before Action']}</td>
                            <td>${innerRowsValue['After Action']}</td>

                        </tr>

                        `;

                        });

                        divOfTable.innerHTML += divOfTableTml + `</tbody></table>`;
                        }
                    });
                }

            });
        }
        else
        {

            divOfTable.innerHTML = ``;
            const entries = Object.entries(dataTable['Results']['Table']);
            Object.entries(dataTable['Results']['Table']).forEach(([key, value],indexMain) => {
                    if (key !== 'total_col') {
                        TableId.push(`${indexMain}`);
                         divOfTable.innerHTML += `
                            <table id="${indexMain}">
                                <thead>
                                    <tr>
                                        <th colspan = "5">${key}</th>
                                    </tr>
                                </thead>
                            </table>`;
                        var mainRows =`
                            <table id="sub-${key}">
                                    <thead>
                                        <tr>
                                            <th>التسلسل</th>
                                            <th>التفاصيل</th>
                                            <th>اسم الشركة</th>
                                            <th>زيادة</th>
                                            <th>نقصان</th>
                                        </tr>
                            </thead><tbody>`;
                            TableId.push(`sub-${key}`);
                        Object.entries(value).forEach(([valueKey, innerValue],index) => {
                           if (valueKey !== 'total_col') {
                                counter = counter + 1;
                                //TableId.push(`${valueKey}`)
                                var subRows = `
                                    <table id ="${valueKey}">
                                        <thead>
                                            <tr>
                                                <th>${innerValue.ColumnName['Serial']}</th>
                                                <th>${innerValue.ColumnName['Action Date']}</th>
                                                <th>${innerValue.ColumnName['Corporate Action']}</th>
                                                <th>${innerValue.ColumnName['Action Description']}</th>
                                                <th>${innerValue.ColumnName['Before Action']}</th>
                                                <th>${innerValue.ColumnName['After Action']}</th>

                                            </tr>
                                        </thead>
                                    <tbody>`;

                                 mainRows +=`
                                    <tr>
                                        <td class="center">${index + 1}</td>
                                        <td><button id = 'pres-${valueKey}' onclick="showActions('action-${valueKey}');changeText('pres-${valueKey}')" style="width:100%">+</button></td>
                                        <td>${innerValue['SubTitleSplite']['member_name']}</td>
                                        <td class="center">${innerValue['Grand Total']['grandTotalIncrease']}</td>
                                        <td class="center">${innerValue['Grand Total']['grandTotalDecrease']}</td>
                                    </tr>
                                `;

                                Object.entries(innerValue.rows).forEach(([valueKeyRows, innerRowsValue],index) => {

                                    subRows += `
                                    <tr>
                                        <td class="center">${innerRowsValue['Serial']}</td>
                                        <td class="center">${innerRowsValue['Action Date']}</td>
                                        <td>${innerRowsValue['Corporate Action']}</td>
                                        <td>${innerRowsValue['Action Description']}</td>
                                        <td>${innerRowsValue['Before Action']}</td>
                                        <td>${innerRowsValue['After Action']}</td>

                                    </tr>`

                                });
                                subRows += `</tbody></table>`
                                mainRows +=`
                                <tr id="action-${valueKey}" style="display: none;">
                                    <td></td>
                                    <td colspan = 4>${ subRows }</td>
                                </tr>

                                `;

                            }
                        });
                        const currentPathArray = 'https://www.sdc.com.jo/ar/publicShareholdingCompaniesFilterResultsPage'.split("/");
                        var lang = 'en';
                        if (currentPathArray[3] == 'ar') {
                            lang = 'ar';
                        }
                        if(lang == 'en')
                        {
                            var replace ="Sector";
                        }
                        else
                        {
                            var replace = 'قطاع';
                        }
                        mainRows +=`<tr>
                                <td colspan = "3" class="bold center">مجموع ${key.replace(replace, '')}</td>
                                <td class="bold center">${value.total_col.total_category_increase}</td>
                                <td class="bold center">${value.total_col.total_category_decrease}</td>
                            </tr>`;


                        if (indexMain === entries.length - 2) {
                            mainRows +=`<tr>
                            <td colspan = "3" class="bold center">المجموع الكلي</td>
                            <td class="bold center">${dataTable['Results']['Table']['total_col']['total_category_increase']}</td>
                            <td class="bold center">${dataTable['Results']['Table']['total_col']['total_category_decrease']}</td>
                        </tr></tbody></table>`;
                        }else{
                        mainRows += `</tbody></table>`;
                        }
                        divOfTable.innerHTML += mainRows ;
                    }
            });


        }

        var resulteCount = document.getElementById('resulte-count');
        if (resulteCount.classList.contains("no-result")) {
            resulteCount.classList.remove("no-result");
            $('#noResult').css('display','none');
        }
        resulteCount.innerHTML = `عدد نتائج البحث : ${counter}`
    }
    else
    {
             divOfTable.innerHTML = "";
            var resulteCount = document.getElementById('resulte-count');
            if (resulteCount.classList.contains("no-result")) {
                $('#noResult').css('display','inline-block');
                    resulteCount.innerHTML = `لا توجد نتائج للبحث`;
            }
            else
            {
                    $('#resulte-count').addClass('no-result');
                    $('#noResult').css('display','inline-block');
                    resulteCount.innerHTML = `لا توجد نتائج للبحث`;
            }
    }
}





