<script>
jQuery(document).ready(function () {
    document.getElementById("actionTypeList").disabled = true;
    var queryString = window.location.search;
    var urlParams = new URLSearchParams(queryString);
    var categoryId = urlParams.get('categoryId');

        if (queryString.includes("priview"))
        {



            setTimeout(() => {
                if (queryString.includes("CorporateActions"))
                {

                    $("#CorporateActions").val(urlParams.get('CorporateActions'));
                    if(urlParams.get('CorporateActions') == "2")
                    {
                        document.getElementById("actionTypeList").disabled = false;
                    }
                    $("#actionTypeList").val(urlParams.get('ActionDescription'));
                    $("#sectorsList").val(urlParams.get('sectorId'));
                    $("#SecuritiesNoList").val(urlParams.get('routerNo'));
                    $("#routerList").val(urlParams.get('routerNo'));
                    $("#SecuritiesNamesList").val(urlParams.get('sectorName'));
                    $("#ISINmenu").val(urlParams.get('ISIN'));
                    $("#FromDate").val(urlParams.get('dteFrom'));
                    $("#ToDate").val(urlParams.get('dteTo'));
                    $("#issuerStatusList").val(urlParams.get('issuerStatus')).val();

                    if(urlParams.get('sortBy') == 1)
                    {
                        $('#divViewSecurity').css('display','inline-block');
                        removeSelectedRadio();
                        $('#chkSearchViewSecurity').attr('checked');

                    }

                    $("#get-result").click();
                }

            }, 3000);
        }

        if (queryString.includes("print"))
        {



            setTimeout(() => {
                if (queryString.includes("CorporateActions"))
                {

                    $("#CorporateActions").val(urlParams.get('CorporateActions'));
                    if(urlParams.get('CorporateActions') == "2")
                    {
                        document.getElementById("actionTypeList").disabled = false;
                    }
                    $("#actionTypeList").val(urlParams.get('ActionDescription'));
                    $("#sectorsList").val(urlParams.get('sectorId'));
                    $("#SecuritiesNoList").val(urlParams.get('routerNo'));
                    $("#routerList").val(urlParams.get('routerNo'));
                    $("#SecuritiesNamesList").val(urlParams.get('sectorName'));
                    $("#ISINmenu").val(urlParams.get('ISIN'));
                    $("#FromDate").val(urlParams.get('dteFrom'));
                    $("#ToDate").val(urlParams.get('dteTo'));
                    $("#issuerStatusList").val(urlParams.get('issuerStatus')).val();

                    if(urlParams.get('sortBy') == 1)
                    {
                        $('#divViewSecurity').css('display','inline-block');
                        removeSelectedRadio();
                        $('#chkSearchViewSecurity').attr('checked');

                    }

                    $("#get-result").click();
                }

            }, 3000);
        }
    var TableId = [];
    jQuery('#get-result').click(function () {
        var CorporateAction = jQuery("#CorporateActions").find(":selected").val();
        var ActionDescription = jQuery("#actionTypeList").find(":selected").val();
        var sectorId = jQuery("#sectorsList").find(":selected").val();
        var issuerStatus = jQuery("#issuerStatusList").find(":selected").val();
        var sectorNo = jQuery("#SecuritiesNoList").find(":selected").val();
        var routerNo = jQuery("#routerList").find(":selected").val();
        var sectorName = jQuery("#SecuritiesNamesList").find(":selected").val();
        var ISIN = jQuery("#ISINmenu").find(":selected").val();
        var dteFrom = document.getElementById('FromDate').value;
        var dteTo = document.getElementById('ToDate').value;
        var sortBy = getSelectedRadioSort();


        TableId = [];
        //        jQuery(".btn-ring").show();
        jQuery("#get-result").prop('disabled', true);
        jQuery("#get-result").val('disabled');
        getFilterResulte(categoryId, CorporateAction, ActionDescription, sectorId, issuerStatus, sectorNo, routerNo, sectorName, ISIN, dteFrom, dteTo,sortBy,TableId);
    });
    $('#excell').click(function(){

        if(TableId.length > 0)
        {
            let filename = document.querySelector('.inner-image h1.page-title').textContent;
            fnExcelReport(TableId,filename)
        }

    });
    jQuery('#reset-result').click(function () {
            location.reload();
    });

    $('#customPrintRiview').click(function () {
        var CorporateAction = jQuery("#CorporateActions").find(":selected").val();
        var ActionDescription = jQuery("#actionTypeList").find(":selected").val();
        var sectorId = jQuery("#sectorsList").find(":selected").val();
        var issuerStatus = jQuery("#issuerStatusList").find(":selected").val();
        var sectorNo = jQuery("#SecuritiesNoList").find(":selected").val();
        var routerNo = jQuery("#routerList").find(":selected").val();
        var sectorName = jQuery("#SecuritiesNamesList").find(":selected").val();
        var ISIN = jQuery("#ISINmenu").find(":selected").val();
        var dteFrom = document.getElementById('FromDate').value;
        var dteTo = document.getElementById('ToDate').value;
        var sortBy = getSelectedRadioSort();
        if (CorporateAction == '0' && sectorId == '0' && sectorName == '0')
        {
            const urL = window.location + `&priview=1`;
            window.open(urL);
        } else
        {
            if(urlParams.get('categoryId') == 2 || urlParams.get('categoryId') == 3 )
            {
                routerNo = jQuery("#SecuritiesNoList").find(":selected").val();
                const urL = window.location + `&CorporateActions=${CorporateAction}&&ActionDescription=${ActionDescription}&sectorId=${sectorId}&issuerStatus=${issuerStatus}&routerNo=${routerNo}&sectorName=${sectorName}&ISIN=${ISIN}&dteFrom=${dteFrom}&dteTo=${dteTo}&sortBy=${sortBy}&priview=1`;
                window.open(urL);
            }
            else
            {
                const urL = window.location + `&CorporateActions=${CorporateAction}&&ActionDescription=${ActionDescription}&sectorId=${sectorId}&issuerStatus=${issuerStatus}&routerNo=${routerNo}&sectorName=${sectorName}&ISIN=${ISIN}&dteFrom=${dteFrom}&dteTo=${dteTo}&sortBy=${sortBy}&priview=1`;
                window.open(urL);
            }

        }




    });

    $('#customPrint').click(function () {
        var CorporateAction = jQuery("#CorporateActions").find(":selected").val();
        var ActionDescription = jQuery("#actionTypeList").find(":selected").val();
        var sectorId = jQuery("#sectorsList").find(":selected").val();
        var issuerStatus = jQuery("#issuerStatusList").find(":selected").val();
        var sectorNo = jQuery("#SecuritiesNoList").find(":selected").val();
        var routerNo = jQuery("#routerList").find(":selected").val();
        var sectorName = jQuery("#SecuritiesNamesList").find(":selected").val();
        var ISIN = jQuery("#ISINmenu").find(":selected").val();
        var dteFrom = document.getElementById('FromDate').value;
        var dteTo = document.getElementById('ToDate').value;
        var sortBy = getSelectedRadioSort();
        if (CorporateAction == '0' && sectorId == '0' && sectorName == '0')
        {
            const urL = window.location + `&priview=1&print=1`;
            window.open(urL);
        } else
        {
            if(urlParams.get('categoryId') == 2 || urlParams.get('categoryId') == 3 )
            {
                routerNo = jQuery("#SecuritiesNoList").find(":selected").val();
                const urL = window.location + `&CorporateActions=${CorporateAction}&&ActionDescription=${ActionDescription}&sectorId=${sectorId}&issuerStatus=${issuerStatus}&routerNo=${routerNo}&sectorName=${sectorName}&ISIN=${ISIN}&dteFrom=${dteFrom}&dteTo=${dteTo}&sortBy=${sortBy}&priview=1&print=1`;
                window.open(urL);
            }
            else
            {
                const urL = window.location + `&CorporateActions=${CorporateAction}&&ActionDescription=${ActionDescription}&sectorId=${sectorId}&issuerStatus=${issuerStatus}&routerNo=${routerNo}&sectorName=${sectorName}&ISIN=${ISIN}&dteFrom=${dteFrom}&dteTo=${dteTo}&sortBy=${sortBy}&priview=1&print=1`;
                window.open(urL);
            }

        }






    });
});


async function getFilterCorporateActionList(indexOfData){


    const urlParams = new URLSearchParams(window.location.search);
    const categoryId = urlParams.get('categoryId');
    const response = await fetch('publicShareholdingCompaniesFilterResultsPage?json=1&filter=1&categoryId=' + categoryId + '&mnuTransType=' + indexOfData);

    const data = await response.json();

    jQuery('#actionTypeList option').remove();
    keys = Object.keys(data['Filters']['actionTypeList']['list']).sort();
    for (i_options = 0; i_options < keys.length; i_options++)
    {
        var optionValue = keys[i_options];
        var optionText = data['Filters']['actionTypeList']['list'][keys[i_options]];
        jQuery('#actionTypeList').append(`<option value="${optionValue}">${optionText}</option>`);
    }
    document.getElementById("actionTypeList").disabled = true;
    if (data['Filters']['actionTypeList']['enable'] == 1) {
        document.getElementById("actionTypeList").disabled = false;
        document.getElementById("divViewSecurity").style.display = 'inline-block';
    } else {
        document.getElementById("divViewSecurity").style.display = 'none';
        document.getElementById("chkSearchViewSecurity").checked = false;
        document.getElementById("chkSearchViewDate").checked = true;
    }

}



async function getFilterSectorsList(indexOfData)
{
    const currentPathArray = 'https://www.sdc.com.jo/ar/publicShareholdingCompaniesFilterResultsPage'.split("/");
    var lang = 'en';
    if (currentPathArray[3] == 'ar') {
        lang = 'ar';
    }
    var queryString = window.location.search;
    var urlParams = new URLSearchParams(queryString);
    var categoryId = urlParams.get('categoryId');
    var sectorsList = Drupal.t('@sectorsList', {'@sectorsList': ''});

    var CorporateAction = jQuery("#CorporateActions").find(":selected").val();
    var issuerStatus = jQuery("#issuerStatusList").find(":selected").val();

    const response = await fetch('publicShareholdingCompaniesFilterResultsPage?json=1&filter=1&categoryId=' + categoryId + '&mnuTransType=' + CorporateAction + '&member_sub_cat=' + indexOfData + '&mnuStatus=' + issuerStatus );
    const data = await response.json();

    //
    jQuery('#SecuritiesNoList option').remove();
    keys = Object.keys(data['Filters']['SecuritiesNoList']['list']).sort();

    for (i_options = 0; i_options < keys.length; i_options++)
    {
        var optionValue = keys[i_options];
        var optionText = data['Filters']['SecuritiesNoList']['list'][keys[i_options]];
        jQuery('#SecuritiesNoList').append(`<option value="${optionValue}">${optionText}</option>`);
    }

    //
    jQuery('#routerList option').remove();
    keys = Object.keys(data['Filters']['routerList']['list']);
    for (i_options = 0; i_options < keys.length; i_options++)
    {
        var optionValue = data['Filters']['routerList']['list'][keys[i_options]]['id'];
        var optionText = data['Filters']['routerList']['list'][keys[i_options]]['value'];
        jQuery('#routerList').append(`<option value="${optionValue}">${optionText}</option>`);
    }

    //
    jQuery('#SecuritiesNamesList option').remove();
    keys = Object.keys(data['Filters']['SecuritiesNamesList']['list']).sort();
    for (i_options = 0; i_options < keys.length; i_options++)
    {
        var optionValue = keys[i_options];
        var optionText = data['Filters']['SecuritiesNamesList']['list'][keys[i_options]];
        jQuery('#SecuritiesNamesList').append(`<option value="${optionValue}">${optionText}</option>`);
    }

    //
    jQuery('#ISINmenu option').remove();
    keys = Object.keys(data['Filters']['ISINmenu']['list']).sort();
    for (i_options = 0; i_options < keys.length; i_options++)
    {
        var optionValue = keys[i_options];
        var optionText = data['Filters']['ISINmenu']['list'][keys[i_options]];
        jQuery('#ISINmenu').append(`<option value="${optionValue}">${optionText}</option>`);
    }


}


