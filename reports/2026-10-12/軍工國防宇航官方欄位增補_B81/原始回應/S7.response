        {"_createdAt":"2023-09-06T22:47:56Z","_id":"9aa3b10e-c80a-49d0-8f4e-dd5dfd2da088","_rev":"Qy55Bpk20qPJqSMUUbsaF8","_type":"article","_updatedAt":"2026-04-08T01:28:43Z","authors":[{"_createdAt":"2025-04-10T02:38:50Z","_id":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_rev":"8QtQE8S3U2lXjdjxKMFvCL","_type":"person","_updatedAt":"2025-11-18T00:08:12Z","bio":[],"fullName":"Anduril Industries","image":{"_type":"image","asset":{"_id":"image-a990fb8ef1bae814dc01807f8757917489c9e64d-2536x2536-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1,"height":2536,"width":2536},"hasAlpha":false,"isOpaque":true}}},"metadata":null,"slug":{"_type":"slug","current":"anduril-industries"}}],"categories":[{"_createdAt":"2025-04-10T03:57:42Z","_id":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"news"},"title":"News"},{"_createdAt":"2025-04-10T03:57:42Z","_id":"f84a91e1-010a-4e53-853b-2c9f005edbda","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"products"},"title":"Products"}],"date":"2023-09-07","image":{"_type":"imageWithMeta","alt":"Anduril unmanned aerial system drone model displayed against dark background.","asset":{"_id":"image-2847a9f060828956195cff069a2099605ac2245e-3840x2160-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":2160,"width":3840},"hasAlpha":false,"isOpaque":true}}},"meta":{"_type":"meta","description":"Acquisition expands Anduril's suite of autonomous capabilities into the group 5 autonomous aircraft space.","title":"ANDURIL INDUSTRIES ACQUIRES UAS DEVELOPER BLUE FORCE TECHNOLOGIES","type":"article"},"parent":{"_id":"cb940787-64b7-481d-8379-537ea6a1cf56","parent":null,"slug":{"_type":"slug","current":"news"},"title":"Newsroom"},"relatedArticles":[{"_createdAt":"2023-07-19T00:16:41Z","_id":"293b2a6e-259b-4913-b460-9de94c64cc68","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","authors":[{"_createdAt":"2025-04-10T02:38:50Z","_id":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_rev":"8QtQE8S3U2lXjdjxKMFvCL","_type":"person","_updatedAt":"2025-11-18T00:08:12Z","bio":[],"fullName":"Anduril Industries","image":{"_type":"image","asset":{"_ref":"image-a990fb8ef1bae814dc01807f8757917489c9e64d-2536x2536-jpg","_type":"reference"}},"metadata":null,"slug":{"_type":"slug","current":"anduril-industries"}}],"categories":[{"_createdAt":"2025-04-10T03:57:42Z","_id":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"news"},"title":"News"},{"_createdAt":"2025-04-10T03:57:42Z","_id":"93421cd8-6498-4e99-a11f-fe55783b363f","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"life-at-anduril"},"title":"Anduril Life"},{"_createdAt":"2025-04-10T03:57:42Z","_id":"f84a91e1-010a-4e53-853b-2c9f005edbda","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"products"},"title":"Products"}],"date":"2022-06-05","image":{"_type":"imageWithMeta","alt":"Historic military manufacturing facility with rows of armored vehicles under construction.","asset":{"_id":"image-80f65c20c879a2fe9e28b346e3aa0915f65508c5-1920x1400-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.3714285714285714,"height":1400,"width":1920},"hasAlpha":false,"isOpaque":true}}},"meta":{"_type":"meta","description":"Help us to rebuild the arsenal of democracy and make that future safe, prosperous, and free.","title":"Rebooting the Arsenal of Democracy: Anduril Mission Document","type":"article"},"metadata":null,"parent":{"_createdAt":"2025-03-18T06:18:29Z","_id":"cb940787-64b7-481d-8379-537ea6a1cf56","_rev":"N1G5rtOZj8187JlhVNj8ZV","_system":{"base":{"id":"cb940787-64b7-481d-8379-537ea6a1cf56","rev":"U0oN0QIqDw3OWy2Rvws2n8"}},"_type":"page","_updatedAt":"2026-10-06T20:13:24Z","category":"company","meta":{"description":"The latest news, announcements, and insights from Anduril Industries.","title":"Newsroom"},"metadata":null,"slices":[{"_key":"be226df55718","_type":"navColorSlice","navColorMode":"dark"},{"_key":"862b9c27dddf","_type":"newsroomHeader","header":"News & Insights","headerLabel":"NEWSROOM","highlightedArticle":{"_type":"newsLink","link":{"_ref":"deba6017-6ea9-492e-a4f6-78f295f14d6a","_type":"reference"}}},{"_key":"54576d983b87","_type":"newsListSlice","header":"All articles"}],"slug":{"_type":"slug","current":"news"},"title":"Newsroom"},"relatedArticles":[{"_createdAt":"2023-07-13T23:34:28Z","_id":"32719de1-93e9-4884-a9f1-948d06259a8e","_rev":"tVCH8grWWfglJ1B3WbCHbn","_system":{"base":{"id":"32719de1-93e9-4884-a9f1-948d06259a8e","rev":"RS0vWXjRQWPGuLISTMIe9d"}},"_type":"article","_updatedAt":"2026-09-07T16:36:55Z","authors":[{"_key":"ffc4d028-7be9-44c3-b025-c4db63562a76","_ref":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_type":"reference"}],"categories":[{"_key":"864bf31cfbe0","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"},{"_key":"b4037e268a88","_ref":"93421cd8-6498-4e99-a11f-fe55783b363f","_type":"reference"},{"_key":"17a51108ae32","_ref":"f84a91e1-010a-4e53-853b-2c9f005edbda","_type":"reference"}],"date":"2022-03-22","image":{"_type":"imageWithMeta","alt":"Anduril's expansive manufacturing facility with production zones, organized inventory, and industrial equipment.","asset":{"_ref":"image-4ff28e6e07df3f565a77f0f798ec96c6bfaed7e9-1600x1067-jpg","_type":"reference"}},"meta":{"_type":"meta","description":"\"Manufacturing is where the rubber really hits the road,\" says Anduril Founder Palmer Luckey.","title":"Operating at Scale: Manufacturing at Anduril","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"relatedArticles":[{"_key":"c83a931ef041","_ref":"905cbfcc-d185-490f-aa9a-79c671f3c8a7","_type":"reference"},{"_key":"eace153ebe48","_ref":"77437e63-70e7-41f1-9a11-a9adfc914449","_type":"reference"}],"slices":[{"_key":"60ddb3ae026d","_type":"oneColumnRichText","content":[{"_key":"0f2c302ec77e","_type":"block","children":[{"_key":"0d5a1aed178b","_type":"span","marks":["em","strong"],"text":"This blog post and video is the first in a series on Anduril’s approach to operating a nontraditional defense company at scale."}],"markDefs":[],"style":"lead"},{"_key":"821171dfdc2e","_type":"block","children":[{"_key":"62f68c4adc28","_type":"span","marks":[],"text":"Warfare, and the deterrence thereof, remains dominated by physical systems. Software has unlocked a slew of science fiction capabilities — autonomy, collaborative swarming, precision guiding, and more — which have enhanced, not replaced, the hardware systems that armies use to wage war. Kinetic engagement between people and machines remains the bread and butter of battle — and at facilities like Anduril’s SA9 warehouse, our manufacturing team is responsible for building and shipping some of those very machines to men and women in uniform."}],"markDefs":[],"style":"normal"},{"_key":"2b5b4a184911","_type":"block","children":[{"_key":"e20961ce0483","_type":"span","marks":[],"text":"“Manufacturing is where the rubber really hits the road,” said Anduril Founder Palmer Luckey. “It’s how we turn our best ideas into prototype units for testing, and then turn the best prototypes into thousands of production units for our customers.” Across 6 locations in Southern California, Massachusetts, and Georgia totaling nearly 150,000 sq ft, Anduril’s manufacturing team turns the models and designs of their fellow engineers into tangible reality. The manufacturing operation is sophisticated but lean — the team, headed up by Justin Lopas, is extremely hands-on during the development phase of a new product, often working late nights at short notice to get new parts produced for testing the next day."}],"markDefs":[],"style":"normal"},{"_key":"95c1f94e47a3","_type":"block","children":[{"_key":"c3089d09040b","_type":"span","marks":[],"text":"Anduril has grown rapidly since it was founded in 2017. “When I started here, we had two hardware products — our "},{"_key":"320f36750211","_type":"span","marks":["36ee609c61e5"],"text":"Sentry Towers"},{"_key":"1316073fd00c","_type":"span","marks":[],"text":" and "},{"_key":"8e0bfcaa05b2","_type":"span","marks":["07eed1f66cf7"],"text":"Ghost drones"},{"_key":"87cd6f67f117","_type":"span","marks":[],"text":" — and we were shipping a couple dozen of them,” said Lopas, who left SpaceX to join Anduril in May 2020. “The manufacturing challenge wasn’t as steep. Since then, we’ve built several "},{"_key":"6137f534b1fb","_type":"span","marks":["2496f91327a4"],"text":"variants"},{"_key":"3e27cb79015a","_type":"span","marks":[],"text":" of our Towers, our interceptor drone "},{"_key":"3f8f57bab87b","_type":"span","marks":["66bc6715646c"],"text":"Anvil"},{"_key":"7816fd830a16","_type":"span","marks":[],"text":", "},{"_key":"2496a9b886fa","_type":"span","marks":["25675b62d971"],"text":"WISP passive sensors"},{"_key":"3fa41e848d1b","_type":"span","marks":[],"text":", "},{"_key":"854c39b25677","_type":"span","marks":["32975fe5d71b"],"text":"ALTIUS air-launched effects"},{"_key":"80fbcd99cadf","_type":"span","marks":[],"text":", and much more. We’re shipping our Towers, Anvils, WISPs, air-launched effects, and Ghosts at production quantities — hundreds of units, for some items — to fulfill major task orders from our customers. This year, we’ll build over 1000 Anvils and almost double the size of the team, from 36 today to 60 by the end of the year."}],"markDefs":[{"_key":"36ee609c61e5","_type":"internalLink","reference":{"_ref":"385b268e-8ce5-4c67-8825-257bd568a88b","_type":"reference"},"targetBlank":false},{"_key":"07eed1f66cf7","_type":"internalLink","reference":{"_ref":"9077e6b2-41b7-454c-8945-6b7747e0bf6e","_type":"reference"},"targetBlank":false},{"_key":"2496f91327a4","_type":"internalLink","reference":{"_ref":"c6e51253-80df-43d1-8be1-c2743da43954","_type":"reference"},"targetBlank":false},{"_key":"66bc6715646c","_type":"internalLink","reference":{"_ref":"29f7e0fc-6b26-45fd-a0a5-c55f3018aa82","_type":"reference"},"targetBlank":false},{"_key":"25675b62d971","_type":"internalLink","reference":{"_ref":"c6e51253-80df-43d1-8be1-c2743da43954","_type":"reference"},"targetBlank":false},{"_key":"32975fe5d71b","_type":"internalLink","reference":{"_ref":"dcca08af-1047-4f8e-820d-0a05e1ece758","_type":"reference"},"targetBlank":false}],"style":"normal"},{"_key":"69e70de6b927","_type":"videoEmbed","thumbnail":{"_type":"imageWithMeta","asset":{"_ref":"image-5dbbba17f9461803d879933c02e919d512c8dd78-2079x1085-png","_type":"reference"}},"url":"https://www.youtube.com/embed/--52_oTh7wM"},{"_key":"c78f3643d705","_type":"block","children":[{"_key":"304df24e80710","_type":"span","marks":[],"text":"The most intense phase of work for Lopas and his team is in supporting their counterparts across other engineering teams to develop new systems quickly. "}],"markDefs":[],"style":"normal"},{"_key":"4e835c0d94fc","_type":"block","children":[{"_key":"a137aa35acc9","_type":"span","marks":[],"text":"“Our mechanical and electrical engineers are iterating on their designs on a weekly or even daily basis,” said Dana Paz, one of Anduril’s manufacturing engineers. “We work extremely closely with them to limit the number of hours between design and test. To enable such a rapid development cycle, our mechanical and electrical development lab has ‘one of everything.’ We handle all kinds of development fabrication, from multi-axis machining, to sheetmetal fabrication, MIG and TIG welding, and 3D printing.”"}],"markDefs":[],"style":"normal"},{"_key":"89aea3ce6d8e","_type":"block","children":[{"_key":"e472f2e313240","_type":"span","marks":[],"text":"The challenge of simultaneously ramping up production while implementing internal systems and practices to get large orders out the door is substantial. To handle it, Lopas and his team settled on a set of core principles that define both their processes and culture."}],"markDefs":[],"style":"normal"},{"_key":"3cff8f7d3b77","_type":"block","children":[{"_key":"5c83b56a1c710","_type":"span","marks":[],"text":"1. Moving as quickly as possible from prototype to production"}],"markDefs":[],"style":"h2"},{"_key":"d96fba92bd40","_type":"block","children":[{"_key":"481dc0fa5b140","_type":"span","marks":[],"text":"Anduril’s approach to manufacturing is inseparable from its broader ambition to disrupt the defense industry with rapidly deployed cutting-edge technology. To reduce the timelines for development from years — as is typical in the defense industry — to months, manufacturing plays a key role."}],"markDefs":[],"style":"normal"},{"_key":"335efd5d30ee","_type":"block","children":[{"_key":"581b28dd9bdd0","_type":"span","marks":[],"text":"“An engineer can test a new part on Monday, update their CAD model that evening, have us build a new part overnight, and be back out in the field testing as early as Tuesday morning,” said Lopas. “And if that part doesn’t work like the engineer imagined, she can send us a modification on Wednesday and be back out testing on Thursday. We pride ourselves on that kind of rapid delivery. Over time that efficiency and speed compound, and the amount of development another defense company might get done in a year happens in a month or two at Anduril.”"}],"markDefs":[],"style":"normal"},{"_key":"7a0fc927281a","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-081ae2885c52743abf4c60142177013046837954-7510x4542-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"d5b3a99b9b05","_type":"block","children":[{"_key":"2fa23abe78690","_type":"span","marks":[],"text":"To accommodate a deep R&D pipeline of products at different states of maturity, Lopas has optimized Anduril’s manufacturing process for flexibility. “You see this in two areas: in the incredible range of ‘Swiss Army knife’ tools we keep on hand, and in the depth of talent among our manufacturing engineers. We hire engineering technicians with a high level of technical sophistication, who can respond intelligently and quickly to new designs or complications that come their way.”"}],"markDefs":[],"style":"normal"},{"_key":"21ee4cf153b8","_type":"block","children":[{"_key":"54b6231018a00","_type":"span","marks":[],"text":"2. Data defines the factory"}],"markDefs":[],"style":"h2"},{"_key":"af5e76365687","_type":"block","children":[{"_key":"53b9fe1db6690","_type":"span","marks":[],"text":"The manufacturing team uses a variety of data software tools to shape the manufacturing process. “We’re constantly getting data-driven feedback from both commercial software and a suite of internally developed tools, built by a team of in-house engineers,” said Paz. “We collect and analyze data from the production process, the performance of hardware during tests, and the end use of the hardware.”"}],"markDefs":[],"style":"normal"},{"_key":"40d49f0eae3d","_type":"block","children":[{"_key":"65920d4180570","_type":"span","marks":[],"text":"Data is shared and understood at all levels of the manufacturing team, allowing each individual on the team to improve their personal workflows. “It holds us accountable, helps us quickly identify things that aren’t working, and lets us predict issues down the road well in advance,” said Lopas."}],"markDefs":[],"style":"normal"},{"_key":"1bd3671843aa","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-2b3aa0c367625c5d62829c4454b53a112a9e1904-2411x1284-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"68725099ce17","_type":"block","children":[{"_key":"459b32f3142c0","_type":"span","marks":[],"text":"3. Culture is a differentiator"}],"markDefs":[],"style":"h2"},{"_key":"df124956e39e","_type":"block","children":[{"_key":"b6398a7594e40","_type":"span","marks":[],"text":"Given the technical and operational complexity of very quickly manufacturing mission-critical complex hardware at scale, we have strategically elevated the importance of manufacturing throughout the organization. Many of America’s most successful hardware companies have recognized the importance of designing an effective manufacturing process, which ultimately determines an end product’s cost, quality, and scalability. Manufacturing engineers aren’t simply called upon last minute to build — manufacturing considerations are a first priority when designing new parts and systems."}],"markDefs":[],"style":"normal"},{"_key":"00d3f0c7359a","_type":"block","children":[{"_key":"b3085c0450ee0","_type":"span","marks":[],"text":"“There’s no hierarchy between manufacturing engineers and non-manufacturing engineers,” said Lopas. “We work extremely closely with a range of engineering teams. They consult with us early and often to make sure that new parts won’t run into any manufacturing difficulties. They know that by thinking about a part’s manufacturability from day one, they’re saving themselves time and expense in the long run.”"}],"markDefs":[],"style":"normal"},{"_key":"cb9085e50ee8","_type":"block","children":[{"_key":"7a3e1d0bb95f0","_type":"span","marks":[],"text":"Being relied upon so heavily means that Lopas and his team have to hold a high bar for excellence when interviewing new candidates. “Our manufacturing-oriented engineers and engineering technicians all have to be able to operate at a high level,” said Lopas. “Luckily, we have been able to attract some of the world’s best talent in both areas. We’ve hired alumni from the most successful nontraditional and traditional aerospace and defense companies alike. We also hire from ‘non-traditional’ backgrounds: one of our techs, for example, previously worked in the live production industry setting up huge sound and light shows for concerts and events like the Emmys.”"}],"markDefs":[],"style":"normal"},{"_key":"c17e01166159","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-d432c610c65dd8f99f24b43e7bbdfcf947172cb5-8167x5447-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"6cc7e75b2c52","_type":"block","children":[{"_key":"ed39a3e6bc1a","_type":"span","marks":[],"text":"4. Using best practices from industry"}],"markDefs":[],"style":"h2"},{"_key":"0e048971df00","_type":"block","children":[{"_key":"6f97b3310bae","_type":"span","marks":[],"text":"In some instances, however, Anduril doesn’t need to reinvent the wheel — it is easier and quicker to take the very best lessons from industries like automotive, medical devices, and consumer electronics and apply them to Anduril."}],"markDefs":[],"style":"normal"},{"_key":"fff80197e1c4","_type":"block","children":[{"_key":"d1badc321e42","_type":"span","marks":[],"text":"“We are trying to manufacture complicated parts at scale. That is a difficult problem, but not an unsolved one,” said Lopas. “Many fundamental concepts of Lean Manufacturing, such as the division of labor, elimination of waste, and Kanban inventory control are directly applicable to Anduril.”"}],"markDefs":[],"style":"normal"},{"_key":"50373e1b541c","_type":"block","children":[{"_key":"09d9c2a1429a","_type":"span","marks":[],"text":"“Ultimately, in some cases, we don’t need to reinvent the wheel. Lessons from the world’s best manufacturers in adjacent industries (medical device, automotive, consumer electronics, etc.) are often easily transferable to Anduril."}],"markDefs":[],"style":"normal"},{"_key":"2f423966da41","_type":"block","children":[{"_key":"32a7b75988d8","_type":"span","marks":[],"text":"Conclusion"}],"markDefs":[],"style":"h2"},{"_key":"c1809f1c4766","_type":"block","children":[{"_key":"f6e66167f7e7","_type":"span","marks":[],"text":"While manufacturing is a painful necessity for companies selling custom-designed hardware, at Anduril it is a core piece of completing the mission, and a differentiator in the marketplace."}],"markDefs":[],"style":"normal"},{"_key":"e60634e36c0f","_type":"block","children":[{"_key":"31fa9c9429b2","_type":"span","marks":[],"text":"And the growth that took Anduril from its foundation in 2017 to large scale orders today isn’t slowing any time soon. “To achieve goals like building 1000 Anvils and hundreds of Sentry Towers this year, we’re hiring almost two dozen new people,” said Lopas. “A few years ago, we were a cool new startup building demo kits for customers. Today, we’re executing on huge contracts and making sure our men and women in uniform get the technology they need quickly and reliably.”"}],"markDefs":[],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"operating-at-scale-manufacturing-at-anduril"},"title":"Operating at Scale: Manufacturing at Anduril"},{"_createdAt":"2023-07-14T21:13:07Z","_id":"cc30a4a8-574c-4269-afe3-2f465f1bd15c","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","authors":[{"_key":"2c710829-b70f-49fb-8f50-6b1918b3d38e","_ref":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_type":"reference"}],"categories":[{"_key":"6e72412e9ef5","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"}],"date":"2022-03-28","image":{"_type":"imageWithMeta","alt":"Anduril Industries building entrance sign at sunset with new leadership announcement.","asset":{"_ref":"image-4d5d86b7e32bb734116ef32f8587460b1dd86e07-720x480-jpg","_type":"reference"}},"meta":{"_type":"meta","description":"Anduril welcomes Gregory Kausner as Head of Global Defense, bringing extensive experience to lead international defense initiatives.","title":"Anduril Welcomes Gregory Kausner as Head of Global Defense","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"relatedArticles":[{"_key":"0aeb60ba3771","_ref":"454c7a34-34c4-41b9-869e-3fbccd210fe7","_type":"reference"},{"_key":"45c386e85074","_ref":"6b6906bc-a003-42b7-9666-8c308b7f6673","_type":"reference"},{"_key":"047503472221","_ref":"898429c8-a840-4801-ae8d-15f5068fd173","_type":"reference"}],"slices":[{"_key":"e4b2949f3ade","_type":"oneColumnRichText","content":[{"_key":"383d3f539f31","_type":"block","children":[{"_key":"a6d7b19e7fc1","_type":"span","marks":[],"text":"We are thrilled to announce that Gregory Kausner has joined Anduril as our Head of Global Defense. Greg has led a distinguished career in the U.S. government, having held leadership roles in the Department of Defense, Department of State, and the United States Senate. He also previously served in the U.S. Navy as an aviator. Greg will lead Anduril’s growth efforts outside of the United States, bringing our technology to a wider range of partners across the world."}],"markDefs":[],"style":"lead"},{"_key":"289c2c6740c1","_type":"block","children":[{"_key":"ab8eee9bf0bb","_type":"span","marks":[],"text":"Throughout his tenure at the Department of Defense, Greg developed deep expertise on the defense acquisition system, security cooperation, and defense technology sales. He performed the duties of the Under and Deputy Secretary of Defense for Acquisition and Sustainment, served as Executive Director for International Cooperation in the Office of the Secretary of Defense, and was the Deputy Director of the Defense Security Cooperation Agency. At the Department of State, Greg was a Senior Advisor to the Under Secretary for Arms Control and International Security and the Deputy Assistant Secretary for Political Military Affairs. In the Senate, Greg served as a Senior Professional Staff Member on the Committee on Foreign Relations."}],"markDefs":[],"style":"normal"},{"_key":"52cbe1e6d3f6","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-c48f112768abc0cafdac34d0fe53dcbb799c3ce1-1000x1000-jpg","_type":"reference"}},"imageWidth":"60","style":"center"},{"_key":"f204dd9ca4dc","_type":"block","children":[{"_key":"3909a29944c2","_type":"span","marks":[],"text":"As a Naval Officer, he piloted F-14s and F/A-18s, represented the Navy to Congress as a Senate Liaison, mobilized as the Deputy Director of the Naval and Amphibious Liaison Element, and conducted Reserve assignments to the Defense Innovation Unit, the Office of the Chief of Naval Operations, and the Office of Naval Intelligence."}],"markDefs":[],"style":"normal"},{"_key":"1bffc3e5edb5","_type":"block","children":[{"_key":"142a86c75e41","_type":"span","marks":[],"text":"Greg is the recipient of the Defense Medal for Exceptional Civilian Service, the Defense Medal for Meritorious Civilian Service, the Secretary of State’s Award for Excellence in International Security Affairs, the Meritorious Service Medal, the Air Medal-Individual Action (with Combat V), and the Air Medal (Strike Flight)."}],"markDefs":[],"style":"normal"},{"_key":"f6488ce45f2e","_type":"block","children":[{"_key":"65823eaa9c67","_type":"span","marks":[],"text":"“Greg Kausner is a rock star who could have gone anywhere and done anything,” said Chris Brose, Chief Strategy Officer at Anduril. “We are incredibly excited that he has chosen to bring his talents and experience to Anduril to supercharge our international growth.”"}],"markDefs":[],"style":"normal"},{"_key":"c1ded222bd57","_type":"block","children":[{"_key":"7e6445d7b539","_type":"span","marks":[],"text":"“Throughout my career, it became increasingly apparent that today’s security challenges demand new technology and a new approach,” said Kausner. “I’m excited to bring those innovations to our closest allies and partners across the world.”"}],"markDefs":[],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"anduril-welcomes-gregory-kausner-as-head-of-global-defense"},"title":"Anduril Welcomes Gregory Kausner as Head of Global Defense"},{"_createdAt":"2023-07-19T00:09:53Z","_id":"77437e63-70e7-41f1-9a11-a9adfc914449","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","authors":[{"_key":"f0788c0e-f036-43de-9fc2-c9aadc0fe092","_ref":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_type":"reference"}],"categories":[{"_key":"a3e00bf0831d","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"}],"date":"2022-05-19","image":{"_type":"imageWithMeta","alt":"ALTIUS air-launched drone flies against blue sky during Army demonstration.","asset":{"_ref":"image-8c5372085ee0d82ee918c273577bc87586e69691-1323x877-png","_type":"reference"}},"meta":{"_type":"meta","description":"ALTIUS Air Launched Effects demonstrates advanced teaming capabilities at US Army Project Edge 2022, showcasing autonomous collaboration.","title":"ALTIUS Air Launched Effects Demonstrated Advanced Teaming at US Army Project Edge 2022","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"relatedArticles":[{"_key":"6833c9b01d95","_ref":"eaec10a1-6380-4995-bd18-bb11b121fcd0","_type":"reference"},{"_key":"3f27f6447f37","_ref":"2c25e7a0-1242-4557-8c78-c09efae5177a","_type":"reference"},{"_key":"0bab8191b308","_ref":"c775c350-2299-4d4a-bf75-8c8ca76c9861","_type":"reference"}],"slices":[{"_key":"8e0a0b7fe23d","_type":"oneColumnRichText","content":[{"_key":"80afd8074e65","_type":"block","children":[{"_key":"4969ab8306b10","_type":"span","marks":[],"text":"Anduril & Area-I are excited to announce that the ALTIUS Air Launched Effects platform demonstrated first of its kind intelligent teaming during EDGE22. Air Launched Effects are vital to the Army’s Future Vertical Lift. As demonstrated at EDGE22, Area-I’s ALE technology — ALTIUS 600 — represents a technological leap ahead for this critical capability."}],"markDefs":[],"style":"lead"},{"_key":"b74d03741eed","_type":"block","children":[{"_key":"2634d7ef0bca","_type":"span","marks":[],"text":"ALTIUS was key to achieving EDGE 22’s technological goals, including demonstrating its autonomous teaming capabilities as part of the largest ALE swarm to date. The modular ALTIUS platform led the largest demonstration of collaborative teaming with multiple ALTIUS platforms operating collaboratively at once. In addition, ALTIUS demonstrated a coordinated detect, identify, locate and report mission capability."}],"markDefs":[],"style":"normal"},{"_key":"f9fe50e515f5","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-d7a5c96d2a3c3f6cf0e1951186772daad8a8cbf7-2048x1324-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"a4f69be572d1","_type":"block","children":[{"_key":"efe4d6f5f24e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"3d7f974b0843","_type":"block","children":[{"_key":"4ddb2a3814d2","_type":"span","marks":[],"text":"ALTIUS was key to achieving EDGE 22’s technological goals, including demonstrating its autonomous teaming capabilities as part of the largest ALE swarm to date. The modular ALTIUS platform led the largest demonstration of collaborative teaming with multiple ALTIUS platforms operating collaboratively at once. In addition, ALTIUS demonstrated a coordinated detect, identify, locate and report mission capability."}],"markDefs":[],"style":"normal"},{"_key":"768de03b0bc7","_type":"block","children":[{"_key":"750f7610824f","_type":"span","marks":[],"text":"ALTIUS is an industry leader that can track, engage, and provide overmatch of enemy targets in a multi-domain environment. The ALTIUS system is modular by design, capable of supporting a variety of kinetic and non-kinetic payloads and sensors that can be customized based on the mission. ALTIUS has a demonstrated ability to be organically carried and tube launched from fixed and rotary wing aircraft in both high and low altitude, ground and utility vehicles, as well as watercraft."}],"markDefs":[],"style":"normal"},{"_key":"d0cfc74e6b27","_type":"block","children":[{"_key":"08c9c9638ebf","_type":"span","marks":[],"text":"Air Launched Effects are a critical component of the Future Attack Reconnaissance Aircraft ecosystem’s ability to regain the asymmetric advantage in reach, stand-off, protection, and lethality required in the execution of joint combined arms and maneuver operations."}],"markDefs":[],"style":"normal"},{"_key":"d39ef4a2e420","_type":"block","children":[{"_key":"a74fde2463e8","_type":"span","marks":[],"text":"Anduril is proud to support Army Futures Command during EDGE 22. EDGE 22 is part of AFC’s campaign of learning designed to accelerate technological advancements in integrated artificial intelligence, robotics, and autonomy to improve battlefield situational awareness."}],"markDefs":[],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"altius-air-launched-effects-demonstrated-advanced-teaming-at-us-army-project-edge-2022"},"title":"ALTIUS Air Launched Effects Demonstrated Advanced Teaming at US Army Project Edge 2022"}],"slices":[{"_key":"ded6c120a657","_type":"twoColumnRichText","backgroundColor":{"_createdAt":"2025-03-28T19:48:15Z","_id":"4ef72091-a5e5-4392-b0bb-30764a72ee0f","_rev":"UXH5eRH3LWIQEsoDKxb1Mv","_system":{"base":{"id":"4ef72091-a5e5-4392-b0bb-30764a72ee0f","rev":"7VWAhJjM6fDIh2mauhtJEa"}},"_type":"color","_updatedAt":"2026-06-04T16:31:45Z","contrastColor":"#010101","hex":"#FFFFFF","metadata":null,"name":"White"},"column1":[{"_key":"51359d7bfa26","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-42b006950ed9a94a84954a836f2f1684df14646d-7701x5137-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.4991240023359937,"height":5137,"width":7701},"hasAlpha":false,"isOpaque":true}}},"style":"center"},{"_key":"28b77cee3bc5","_type":"block","children":[{"_key":"42983bfb906d","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"column2":[{"_key":"aacbb4de1fab","_type":"block","children":[{"_key":"06eb94c532ee","_type":"span","marks":["em"],"text":"Visit "},{"_key":"9f5dd27ba6a4","_type":"span","marks":["em","1f259fe6ba5f"],"text":"rebootingthearsenal.com"},{"_key":"9a728b0d895d","_type":"span","marks":["em"],"text":"."}],"markDefs":[{"_key":"1f259fe6ba5f","_type":"link","href":"https://rebootingthearsenal.com"}],"style":"normal"},{"_key":"bfb9bbc6eee1","_type":"block","children":[{"_key":"a65f1ffeed82","_type":"span","marks":[],"text":"0. What We Believe"}],"markDefs":[],"style":"h2"},{"_key":"b802d3eaed9e","_type":"block","children":[{"_key":"14f16a0ea941","_type":"span","marks":[],"text":"1. Introduction"}],"markDefs":[],"style":"h2"},{"_key":"8337e7874a7e","_type":"block","children":[{"_key":"5b1d08df5d7f","_type":"span","marks":[],"text":"2. How Did We Get Here?"}],"markDefs":[],"style":"h2"},{"_key":"aeb0b23aa658","_type":"block","children":[{"_key":"c04998b380c6","_type":"span","marks":[],"text":"3. The Defense Industry Today"}],"markDefs":[],"style":"h2"},{"_key":"08b6050bdf92","_type":"block","children":[{"_key":"a7c2a8c974b3","_type":"span","marks":[],"text":"4. The Rise of Software"}],"markDefs":[],"style":"h2"},{"_key":"ef1c01620b71","_type":"block","children":[{"_key":"bfd3ccb393ae","_type":"span","marks":[],"text":"5. A New Model"}],"markDefs":[],"style":"h2"},{"_key":"41e69b8d5c48","_type":"block","children":[{"_key":"5f7045b7d397","_type":"span","marks":[],"text":"6. The Government Response"}],"markDefs":[],"style":"h2"},{"_key":"b7696c912368","_type":"block","children":[{"_key":"a48e479cf37c","_type":"span","marks":[],"text":"7. Call to Action"}],"markDefs":[],"style":"h2"}],"columnRatio":"ratio-6-6"},{"_key":"5f867e5aa484","_type":"oneColumnRichText","content":[{"_key":"0210451df239","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-07338ea0aab31a24774e614e6dfec63d64f85e91-720x1065-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.676056338028169,"height":1065,"width":720},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"60","style":"center"},{"_key":"1a0a3d1ac693","_type":"block","children":[{"_key":"bfdc2f8f55e60","_type":"span","marks":[],"text":"Only superior military technology can credibly deter war."}],"markDefs":[],"style":"lead"},{"_key":"7ed9daa7483f","_type":"block","children":[{"_key":"2c3e73c641460","_type":"span","marks":[],"text":"Since World War II, America and its allies’ lead in military technology has been the pivotal factor in preventing World War III."}],"markDefs":[],"style":"normal"},{"_key":"c139691f04dd","_type":"block","children":[{"_key":"c692e47a33330","_type":"span","marks":[],"text":"Today, that technological lead is in jeopardy."}],"markDefs":[],"style":"normal"},{"_key":"4715a419051f","_type":"block","children":[{"_key":"4afc6a58ac560","_type":"span","marks":[],"text":"The incumbent defense companies are unable to build the technology we need to reaffirm our technological lead."}],"markDefs":[],"style":"normal"},{"_key":"1362f1b675a2","_type":"block","children":[{"_key":"7cde35120df30","_type":"span","marks":[],"text":"We need a new breed of defense technology companies to reboot the arsenal of democracy."}],"markDefs":[],"style":"normal"},{"_key":"63f5898e7e7b","_type":"block","children":[{"_key":"ab9eafe304c90","_type":"span","marks":[],"text":"1 — Introduction"}],"markDefs":[],"style":"h1"},{"_key":"e20f233213cc","_type":"block","children":[{"_key":"c2c455b7c3940","_type":"span","marks":[],"text":"If you have followed world events for the last decade, you have felt something changing. The 20th century is well behind us, and with it the sense that America and its allied democracies are the undisputed leaders of the world. World War II — the last major war that America and its allies can truly be said to have won — feels awfully long ago."}],"markDefs":[],"style":"normal"},{"_key":"c19e2bac33d2","_type":"block","children":[{"_key":"1e4d25101d110","_type":"span","marks":[],"text":"The most glaring herald of our decline is in our military’s technology. Once upon a time, the armed services of the United States, United Kingdom, and their partners across the world were envied for their science fiction technology. Today, they are equipped with tools decades behind what you or I use every day. Software has, to paraphrase Marc Andreessen, tried to eat the world, but with the battlefield it found a meal too ungainly to digest."}],"markDefs":[],"style":"normal"},{"_key":"ec48fddd308d","_type":"block","children":[{"_key":"9714011071d30","_type":"span","marks":[],"text":"Despite spending more money than ever on defense, our military technology stays the same. There is more AI in a Tesla than in any U.S. military vehicle; better computer vision in your Snapchat app than in any system the Department of Defense owns; and, until 2019, the United States’ nuclear arsenal operated off floppy disks."}],"markDefs":[],"style":"normal"},{"_key":"1d52c8656646","_type":"block","children":[{"_key":"425372f0112b0","_type":"span","marks":[],"text":"The absence of a crisis made us complacent. In the aftermath of the Cold War, America and its allies felt invincible. Former Soviet states appeared to be liberalizing. China’s economy was growing, and most modernization theorists believed that the Chinese Communist Party would move inexorably toward open democracy. It was the end of history — the triumph of Western ideals and a new age of American-led world order."}],"markDefs":[],"style":"normal"},{"_key":"142af849f945","_type":"block","children":[{"_key":"754378ff782a0","_type":"span","marks":[],"text":"Until it wasn’t. Instead of acquiescing, our competitors seized the moment. China and Russia spent two decades harnessing our most powerful weapon — innovation — and built advanced weapon systems designed to neutralize and surpass our own. The results are sobering: today, in almost every wargame the United States Department of Defense models against China, China wins.¹"}],"markDefs":[],"style":"normal"},{"_key":"1a77e5950418","_type":"block","children":[{"_key":"2b7000ab71530","_type":"span","marks":[],"text":"All too quickly, we have reached the point where, in the words of General C.Q. Brown, “We must accelerate change, or lose.”"}],"markDefs":[],"style":"normal"},{"_key":"891b8e9104f8","_type":"block","children":[{"_key":"bb68afdfc0fd0","_type":"span","marks":[],"text":"There is a better way. Throughout World War II and the decades that followed, the West attracted the world’s most brilliant scientists and engineers, many of whom made foundational contributions to national defense. John von Neumann, Alan Turing, Kelly Johnson, the Jasons, and other gifted patriots recognized that our prosperity is only as strong as our means to defend it. Their technological innovations didn’t just bolster our military — many of their advances percolated into the consumer market. War research and development turned futuristic dreams into household staples: personal computing, GPS, the Internet, commercial air travel, and so much more."}],"markDefs":[],"style":"normal"},{"_key":"87745606d2ff","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-564348c06fa82b7656cfcc7cf7654bb31928bc6a-1588x1274-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.2464678178963893,"height":1274,"width":1588},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"b5756aec0bc6","_type":"block","children":[{"_key":"650515b0635f0","_type":"span","marks":[],"text":"It is time to recapture that spirit of innovation and bring cutting-edge technology to our armed forces again. War in Eastern Europe, the looming threat of a Taiwan invasion, and a rising tide of security threats in other regions of the world demand it. This is not a matter of minor reform. It will require a major re-evaluation of what kinds of technology we build, how we build it, and the speed at which we move."}],"markDefs":[],"style":"normal"},{"_key":"017cca002a3c","_type":"block","children":[{"_key":"9544e1fcbd850","_type":"span","marks":[],"text":"Why can’t the existing defense companies simply do better? The largest defense contractors are staffed with patriots who nevertheless do not have the software expertise or business model to build the technology we need. Tomorrow’s weapons — autonomous systems, cyberweapons and defenses, networked systems, and more — are enabled through software, while these companies specialize in hardware. These companies work slowly, while the best engineers relish working at speed. And the software engineering talent who can build faster than our adversaries resides in the commercial sector, not at large defense primes. These companies built the tools that kept us safe in the past, but they are not the future of our defense."}],"markDefs":[],"style":"normal"},{"_key":"115cdffbee9a","_type":"block","children":[{"_key":"775bf5745d430","_type":"span","marks":[],"text":"We at Anduril are building defense technology in a new way, but we are just one company. If the allied democracies are to break free from the morass of bureaucracy, embedded habits, and mediocre technology that have failed our men and women in uniform for decades, we will need action at scale. Not just a handful, but dozens of new, innovative companies will be required to modernize our military. Tens of thou- sands of engineers will have to ask themselves if there is more to their careers than money alone. And our officials in government, without whom this effort will be for naught, will have to listen and to lead."}],"markDefs":[],"style":"normal"},{"_key":"2586ce1e3bb8","_type":"block","children":[{"_key":"341217bef1d40","_type":"span","marks":[],"text":"Some observers have suggested that young engineers do not wish to work on national security. We disagree — Silicon Valley was founded by patriots pushing science and engineering forward in the national interest and is filled with people eager to do the same again today. Others claim that it is impossible to compete with the defense giants. But the government has enthusiastically embraced nontraditional companies that get results like SpaceX and Palantir. And finally, the most pessimistic critics believe our effort to be futile because democratic leadership is in inexorable decline, as our adversaries hope it to be. We reject this. With the right technology, the right ways of building, and the right partners in the armed forces, we can build the systems that will safeguard the allied democracies for the next century and beyond."}],"markDefs":[],"style":"normal"},{"_key":"341351c1359e","_type":"block","children":[{"_key":"9c3e452425140","_type":"span","marks":[],"text":"2 — How Did We Get Here?"}],"markDefs":[],"style":"h2"},{"_key":"c9467b6591e5","_type":"block","children":[{"_key":"38fd3927d7ed","_type":"span","marks":[],"text":"In his eponymous memoir about the group, former Lockheed Skunk Works director Ben Rich tells two stories. One, for which he is best remembered, is a tale of aspiration and ingenuity. Alongside his iconoclastic predecessor, Kelly Johnson, Rich and his team of “skunks” designed and built vehicles that changed how the United States waged war and gathered intelligence: the U-2 spy plane, the SR-71 Blackbird, and the F-117 Nighthawk. Lockheed’s incredible record of innovation in the national interest is defense industry mythology; Rich’s memoir is practically mandated reading for patriotic engineers."}],"markDefs":[],"style":"normal"},{"_key":"a96c8da37ea9","_type":"block","children":[{"_key":"ab8747f7957c0","_type":"span","marks":[],"text":"The second story Rich tells, however, is less optimistic. Writing in 1994, Rich warns of a creeping decline among the major defense companies. “In my forty years at Lockheed,” he wrote, “I worked on twenty-seven different airplanes. Today’s young engineer will be lucky to build even "},{"_key":"ab8747f7957c1","_type":"span","marks":["em"],"text":"one"},{"_key":"ab8747f7957c2","_type":"span","marks":[],"text":".”² Not only were new things rarely being built, Rich observed, but the costs of even trying to do so had skyrocketed. “The development costs of fighters have increased by a factor of 100 since the 1950s, and unit procurement costs have risen 11 percent every year since 1963,” Rich despaired. “Small wonder, then, that there were only seven new airplanes in the 1980s, compared to forty-nine in the 1950s.”³"}],"markDefs":[],"style":"normal"},{"_key":"b5f244fb3477","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-6156f46158720e157170551e1ad294e171c02bdd-2003x2101-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.9533555449785817,"height":2101,"width":2003},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"60","style":"center"},{"_key":"24a67f17f53b","_type":"block","children":[{"_key":"4ba7b08e6dac0","_type":"span","marks":[],"text":"Rich’s first story is history; his second is yet to conclude. The United States has not fielded a new bomber plane since the end of the Cold War. The F-35, one of the few new major systems the military is fielding, has become a byword for extravagance, currently estimated to cost taxpayers $1.6 trillion. And instead of attracting new entrants to fill the gaps, the Pentagon lost a staggering 20,500 suppliers from 2000 to 2018.⁴"}],"markDefs":[],"style":"normal"},{"_key":"8d45a4be7b84","_type":"block","children":[{"_key":"2cb8813a854d0","_type":"span","marks":[],"text":"When former Lockheed CEO Norm Augustine wrote that “In the year 2054, the entire defense budget will purchase just one aircraft,” he was joking — but not by much."}],"markDefs":[],"style":"normal"},{"_key":"6b3c4ec2a1b2","_type":"block","children":[{"_key":"6caebc9253410","_type":"span","marks":[],"text":"How did we get here? Understanding our present circumstances means understanding the history that preceded them. We do not have to delve far into the past — World War II and the years immediately following were a golden age of military innovation."}],"markDefs":[],"style":"normal"},{"_key":"4523a0af74a4","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-5e009cc4b8bb0ce4a4ad5993668171bdc9ab5d10-2470x1952-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.2653688524590163,"height":1952,"width":2470},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"1fe92d9d105e","_type":"block","children":[{"_key":"de5ecd42bb8b0","_type":"span","marks":["strong"],"text":"The Golden Years"}],"markDefs":[],"style":"h2"},{"_key":"46a2db7a1d7f","_type":"block","children":[{"_key":"c59e2ae869500","_type":"span","marks":["em"],"text":"“It was the civilian scientists, not the military engineers, who had been the technological innovators during the war. ‘They are the ones who made the breakthroughs,’ [General Arnold] said. He predicted that those breakthroughs — in radar, in jet propulsion, in rocketry, in nuclear weapons — would prove to be the catalysts for further innovation that would radically alter the nature of war. The First World War had been decided by brawn, he said, the Second by logistics. ‘The Third World War will be different. It will be won by brains.’”"},{"_key":"c59e2ae869501","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"blockquote"},{"_key":"d1253df229cd","_type":"block","children":[{"_key":"d0726db7aaf5","_type":"span","marks":[],"text":""},{"_key":"c59e2ae869502","_type":"span","marks":["em"],"text":"–Neil Sheehan,"},{"_key":"c59e2ae869503","_type":"span","marks":[],"text":" A Fiery Peace in a Cold War"}],"markDefs":[]},{"_key":"7267a47b0883","_type":"block","children":[{"_key":"28a0154f683b0","_type":"span","marks":[],"text":"It can be difficult to imagine the Department of Defense, which today employs nearly 3 million Americans, moving quickly. But last century, it innovated at a speed that puts modern Silicon Valley startups to shame: the Pentagon was built in only 16 months (1941–1943), the Manhattan Project ran for just over 3 years (1942–1946), and the Apollo Program put a man on the moon in under a decade (1961–1969). In the 1950s alone, the United States built five generations of fighter jets, three generations of manned bombers, two classes of aircraft carriers, submarine-launched ballistic missiles, and nuclear-powered attack submarines."}],"markDefs":[],"style":"normal"},{"_key":"23858d3b858f","_type":"block","children":[{"_key":"8caf19e76d240","_type":"span","marks":[],"text":"Perhaps it should not surprise us that the government worked at the pace of a Silicon Valley startup, given that World War II and Cold War military research and development kickstarted Silicon Valley in the first place. Fred Terman, the “father of Silicon Valley,” had left Stanford in World War II to run the Harvard Radio Research Laboratory, the Department of Defense’s premiere electronic warfare lab. When he returned to Stanford after the war, he brought a wealth of government connections and influence with him. By 1947, the DoD provided half of Stanford School of Engineering’s budget. Federal government spending on science and engineering, much of it concentrated in Silicon Valley, continued to balloon — in 1960, the DoD accounted for 36% of "},{"_key":"8caf19e76d241","_type":"span","marks":["em"],"text":"all research and development in the world.⁶ ⁷"}],"markDefs":[],"style":"normal"},{"_key":"956599df0f46","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-867222c9f0e450afa7dbd14047feb9b67c0d4d24-1572x1466-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.0723055934515688,"height":1466,"width":1572},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"62e67f0e1846","_type":"block","children":[{"_key":"ceb1ca438a510","_type":"span","marks":[],"text":"The DoD’s investments didn’t just benefit the military. Decades of military research sowed the seeds of prosperity in the consumer and enterprise sectors. The French media mogul and politician Jean- Jacques Servan-Schreiber, writing in 1967, marveled at the United States’ pace of innovation, predicting that “In thirty years America will be a post-industrial society… There will be only four work days a week of seven hours per day.”⁸"}],"markDefs":[],"style":"normal"},{"_key":"eca699f3a20a","_type":"block","children":[{"_key":"27569933185d0","_type":"span","marks":[],"text":"The commercial sector continued to advance — perhaps not as quickly as Servan-Schreiber imagined, but quickly enough for America to remain the most innovative country in the world."}],"markDefs":[],"style":"normal"},{"_key":"ea35b3abc50c","_type":"block","children":[{"_key":"1108d820cf9b0","_type":"span","marks":[],"text":"But, starting in the 1960s and intensifying through the 70s and 80s, the pace of military innovation began to slow, while costs grew. In 1955, it had become clear that the pace of defense spending was unsustainable: the federal government was spending more on defense than everything else "},{"_key":"1108d820cf9b1","_type":"span","marks":["em"],"text":"combined"},{"_key":"1108d820cf9b2","_type":"span","marks":[],"text":".⁹ Congress knew something had to change. Robert S. McNamara, a wunderkind World War II veteran with a sterling reputation for administrative efficiency at Ford Motor Company, was the man for the job."}],"markDefs":[],"style":"normal"},{"_key":"c7f78668720b","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-eedabb6fcd670df4b14b52e2a789055d77dbbff0-720x405-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":405,"width":720},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"5ef269c9ee2c","_type":"block","children":[{"_key":"617e677a7fc60","_type":"span","marks":["strong"],"text":"A New Regime"}],"markDefs":[],"style":"h2"},{"_key":"eb8c83d58403","_type":"block","children":[{"_key":"49abcc140edb0","_type":"span","marks":[],"text":"In the early 1960s, under the direction of then Secretary of Defense McNamara, the Department of Defense instituted a labyrinth of new rules for acquiring military systems. McNamara was not merely reducing spending: his experience at Ford led him to believe that comprehensive reform was needed to reshape how the government bought technology. He revamped acquisitions to emphasize efficiency, the elimination of waste, and predictability. The Planning, Programming, and Budgeting System (PPBS, later changed to PPBE for “Execution”) process that he implemented is arguably the single most influential defense reform ever enacted, indelibly altering the incentives and business models of the major defense contractors."}],"markDefs":[],"style":"normal"},{"_key":"2b64deed42ea","_type":"block","children":[{"_key":"4ab6aab18f170","_type":"span","marks":[],"text":"Competition with the Soviet Union shaped McNamara’s actions — but perhaps not as modern observers would expect. Whereas today senior DoD leaders have rightly sounded the alarm on China’s ability to compete technologically with the West, McNamara did not believe the Soviet Union capable of out-innovating the United States. In the account of Brigadier General James M. Roherty, McNamara viewed the competition against the Soviet Union in terms of “quantifiables,” believing that “a relative stability characterized weapons technology in the 1960s… that ‘technological surprise’ [was] not a threat to national security and that major breakthroughs [were] not to be expected.”¹⁰"}],"markDefs":[],"style":"normal"},{"_key":"407b3bcef777","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-1c2cac629f008b9855480ef08e51c8c77617117f-2237x2280-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.981140350877193,"height":2280,"width":2237},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"60","style":"center"},{"_key":"114deb67da5e","_type":"block","children":[{"_key":"d2a8e8adcd250","_type":"span","marks":[],"text":"The primary focus of McNamara’s reforms was hence not innovation but cost control. He believed that, by and large, the United States already had the technology it needed to win the Cold War, and that the only problem was making sure that we didn’t spend ourselves into oblivion. The headline-grabbing arms races against the Soviet Union — the “missile gap,” the “bomber gap” — reflected differences in quantity, not quality, of military systems."}],"markDefs":[],"style":"normal"},{"_key":"54028b6fdb9c","_type":"block","children":[{"_key":"15e26229bb770","_type":"span","marks":[],"text":"McNamara’s reforms were not wrong: they were built for a specific era with specific characteristics. Those characteristics included the federal government conducting the vast majority of research and development, rather than private companies; the overwhelming importance of large, capital-intensive, “exquisite” military systems like tanks and battleships; a predictability in the adversary’s (the Soviet Union’s) rate of technological progress; and the existence of relatively few companies able to muster the capital and expertise to build military technology."}],"markDefs":[],"style":"normal"},{"_key":"880d25cff8b6","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-8c633985a8ae8ff905b127d09b0eeabeacc1012b-1000x667-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.4992503748125936,"height":667,"width":1000},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"f89421c5fa16","_type":"block","children":[{"_key":"e355ed96d07c","_type":"span","marks":[],"text":"All of those things have, to varying degrees, changed, but our system for buying technology has not. As a result, the large defense companies have learned to operate in highly idiosyncratic ways, unlike major companies in any other industry:"}],"markDefs":[],"style":"normal"},{"_key":"034b1d49162b","_type":"block","children":[{"_key":"acef5e5780ce0","_type":"span","marks":["strong"],"text":"1. Adherence to a Lengthy Bureaucratic Process"}],"markDefs":[],"style":"normal"},{"_key":"83adef6047a7","_type":"block","children":[{"_key":"975f0f0dc8040","_type":"span","marks":[],"text":"Under the PPBS system, before the government even considers purchasing a new military system, it embarks upon a years-long process of defining requirements, deciding where and how to allocate resources, and finally releasing an award for a new system. It is extremely difficult for the Department of Defense to rapidly acquire new technology, and as a result defense companies face no pressure to develop new systems quickly. Technology developed in the commercial sector hence takes years or decades to end up on the battlefield, if it does at all."}],"markDefs":[],"style":"normal"},{"_key":"39d732a631da","_type":"block","children":[{"_key":"8165cb21bb090","_type":"span","marks":["strong"],"text":"2. Working off Onerous System Specifications"}],"markDefs":[],"style":"normal"},{"_key":"5ef946d092ff","_type":"block","children":[{"_key":"58fe304819a20","_type":"span","marks":[],"text":"Reflecting the prevailing belief that industry was re- quired to execute, not innovate, to beat the Soviet Union, the requirements for major military programs are spelled out in extensive detail. Unlike most industries, which are driven forward by the creativity of the most successful companies, defense contractors are rarely asked to find creative ways to solve problems, and are sometimes punished for doing so."}],"markDefs":[],"style":"normal"},{"_key":"6297ad1c55bb","_type":"block","children":[{"_key":"9e0d9f99fc9a0","_type":"span","marks":["strong"],"text":"3. Spending Little on Internal Research & Development"}],"markDefs":[],"style":"normal"},{"_key":"6107b1f383f1","_type":"block","children":[{"_key":"9c322b410e610","_type":"span","marks":[],"text":"Because McNamara’s reforms made it exceptionally difficult to buy new technology quickly or to buy technology for which there is no defined requirement, defense companies rarely develop products of their own accord. Typically, they sell existing systems (which was most of their business under McNamara) or they wait for the government to order specific R&D efforts, for which they are directly compensated. For a comparison, the largest technology companies today — whose revenues vastly exceed those of the largest defense companies — spend roughly 10–20% of their revenue on research and development. Newer or mid-sized technology startups might spend closer to 60% or 70%. The major defense companies spend 1–4%.¹¹"}],"markDefs":[],"style":"normal"},{"_key":"3268678f9c39","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-156b7d94b0185ee7ba41f7c87af7e80e9b3e18ca-2003x2371-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.8447912273302404,"height":2371,"width":2003},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"60","style":"center"},{"_key":"7e6ddd5eb8b6","_type":"block","children":[{"_key":"721206ef8ffb0","_type":"span","marks":["strong"],"text":"4. Prioritizing Proposals Over Performance"}],"markDefs":[],"style":"normal"},{"_key":"db343144d339","_type":"block","children":[{"_key":"721f864dd6320","_type":"span","marks":[],"text":"McNamara believed duplicative programs to be at the root of DoD waste and would not tolerate government spending on multiple development efforts for similar new systems, whether between military services or among different vendors. This means that once a company is awarded a major contract, it is extremely difficult to take it from them. The incentive for large defense firms is hence to spend heavily on teams of lawyers and lobbyists to shape program requirements in line with the company’s existing technology. This political battle becomes just as important as building the product itself. These lobbyists are often former military officials: By 1969, over 2,000 military officers per year were leaving the DoD to work for a major defense contractor, three times as many as in 1959.¹³"}],"markDefs":[],"style":"normal"},{"_key":"10aded02038b","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-d0ac86d9fdd21a0a3213cbc6b1dbee597ff4b75a-1563x1538-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.0162548764629389,"height":1538,"width":1563},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"1ec25b8c8bdb","_type":"block","children":[{"_key":"6cda356d37770","_type":"span","marks":["strong"],"text":"5. Tolerating Prolonged Failure"}],"markDefs":[],"style":"normal"},{"_key":"d92bc89635ee","_type":"block","children":[{"_key":"233922035b3c0","_type":"span","marks":[],"text":"In most industries, a company that fails to produce a functional product goes out of business. In the defense industry, when a company is three, five, ten years into a program and has failed to build what they promised, the government is stuck between a rock and a hard place — do they cancel the contract and throw away years of development, potentially bankrupting the vendor in the process? Or do they begrudgingly provide the vendor with even more money to salvage the program? Typically, it’s the latter. In the words of the infamous city planner Robert Moses, “Once you sink that first stake, they’ll never make you pull it up.”¹⁴"}],"markDefs":[],"style":"normal"},{"_key":"cd58a4897e1c","_type":"block","children":[{"_key":"72cd3a41d21e0","_type":"span","marks":[],"text":"This may simply be a poor decision (sunk cost fallacy), but sometimes it is part of a deliberate policy to pre- serve the “defense industrial base” — a critical mass of defense companies that can be called upon in an emergency. There is value to this policy, but it has significant costs. It creates moral hazard for major defense companies, which effectively become “too important to fail,” and ensures that not all contracts are given out meritocratically, blunting companies’ incentives to produce better products."}],"markDefs":[],"style":"normal"},{"_key":"3e843afc4cdd","_type":"block","children":[{"_key":"58de25bfdf3e0","_type":"span","marks":[],"text":"To reiterate, there were highly logical rationales for each of these rules and norms. Some of McNamara’s beliefs turned out to be wrong, but others were vindicated — the West won the Cold War, after all. One thing McNamara’s DoD got emphatically right was reducing the use of cost-plus-fixed-fee (CPFF) contracts from 38% of contracts awarded to just over nine percent (though by 2020 they had crept back up to comprise 38% of DoD’s contracts once again).¹⁵ ¹⁶ Cost-plus contracts pay vendors for the costs of developing and producing new systems, plus a percentage fee on top (typically 6–8%). This means that working quickly and efficiently often conflicts with contractors’ profit motives. In the words of Lt. Gen. James Stansberry, “Unless changes are made in the current profit system that demands higher costs as a prerequisite for higher profits, it is futile to expect lower costs… there is little economic motivation for contractors to reduce direct or indirect costs.”¹⁷"}],"markDefs":[],"style":"normal"},{"_key":"c7bc518a87a7","_type":"block","children":[{"_key":"176ec8e6e4bd0","_type":"span","marks":[],"text":"Ultimately, however, McNamara’s system was a bet that the United States could predict the future — that they had a good idea of how Soviet technological development would progress and that, with careful planning, the United States could remain ahead. That is simply no longer true. Our adversaries innovate incredibly quickly, partially because they have learned from the mistakes of the Soviets, partially because they have become incredibly adept at industrial espionage,¹⁸ and partially because software, unlike hardware, can be built and improved upon incredibly quickly (more on this below)."}],"markDefs":[],"style":"normal"},{"_key":"42b8d77fbf7b","_type":"block","children":[{"_key":"56ed31ac1ff60","_type":"span","marks":[],"text":"Six decades after they were first introduced, the rules for doing business with the Pentagon remain, in the words of former Defense Secretary Donald Rumsfeld, “one of the world’s last bastions of central planning.”¹⁹ The primary aim of these rules — to keep costs in check — was a failure: in 1969, Robert Benson, an analyst in the Office of the Secretary of Defense, testified that “about 90% of major weapon systems that the Defense Department procures end up costing at least twice as much as was originally estimated.”²⁰ The incentives these rules created for defense companies have ossified into these companies’ very ways of being. It is not malice or incompetence that prevents the large defense companies from innovating, or moving quickly, or investing in internal research and development — it is simply a rational response to the incentives with which they are presented."}],"markDefs":[],"style":"normal"},{"_key":"b66f0b41d4c7","_type":"block","children":[{"_key":"99a6bbb5141c0","_type":"span","marks":[],"text":"3 — The Defense Industry Today"}],"markDefs":[],"style":"h1"},{"_key":"35c5ddd93fb9","_type":"block","children":[{"_key":"46a5e16dbc630","_type":"span","marks":[],"text":"One remarkable statistic tells a damning story about the modern defense sector: Since 1963, the defense industry has never suffered a negative ten-year period."}],"markDefs":[],"style":"normal"},{"_key":"52707447612f","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-fb76d1cce0b152a9f8fae592dd51348956314850-2003x1678-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.1936829558998807,"height":1678,"width":2003},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"d545f705be71","_type":"block","children":[{"_key":"451b4b8afdb20","_type":"span","marks":[],"text":"Is this because defense companies have built an unprecedented succession of valuable products? Far from it. On a long enough time horizon, defense companies are simply not punished for failure (and, indeed, the horizon is not all that long). Individual companies may receive a slap on the wrist for particularly egregious missteps, but by and large the government accepts that, frustrating as it may be, slow timelines, minimal innovation, and swelling costs are “the way things are.”"}],"markDefs":[],"style":"normal"},{"_key":"80ecf65ea7a8","_type":"block","children":[{"_key":"69e193413b240","_type":"span","marks":[],"text":"Part of the reason that the large defense companies keep getting away with underperformance is that they face little competition. In 1993, the Cold War fading into memory, then Deputy Secretary of Defense Bill Perry sat down with the CEOs of the major defense firms at what came to be known as “the last supper.”²² Perry warned them that substantial cuts to the defense budget were coming and that many of their companies would not be able to survive. Put simply, he said, “We expect defense companies to go out of business. We will stand by and watch it happen.” This precipitated a flurry of mergers and acquisitions."}],"markDefs":[],"style":"normal"},{"_key":"d2f44d9dadba","_type":"block","children":[{"_key":"7fee156ebeeb0","_type":"span","marks":[],"text":"Perry attempted to counterbalance the impact of consolidation by lowering the barriers to entry into the defense industry. He discouraged the use of onerous military specifications (“milspecs”) for new systems except as a “last resort”²⁴ and championed 1994’s Federal Acquisitions Streamlining Act (FASA), which mandated the use of commercial, off-the-shelf alternatives over bespoke new technology. He also encouraged program managers in the DoD to “take more risks” and bet on new technology and new companies. Many of these changes, however, were not enforced. Both SpaceX and Palantir were forced to sue their largest customers for a failure to adhere to Perry’s rules,²⁵ ²⁶ while a RAND corporation study from the early 2000s found that program managers had neither the incentives nor capacity to make meaningful bets on new companies and technology.²⁷"}],"markDefs":[],"style":"normal"},{"_key":"51f470d2898b","_type":"block","children":[{"_key":"d8eb23728eab0","_type":"span","marks":[],"text":"The result is an ageing, top-heavy industry that moves slowly because nobody is chasing it. The ten largest defense companies, all of which were founded decades ago, account for upwards of 80% of the industry’s revenue. Nearly two thirds of major weapons systems contracts in the United States have just "},{"_key":"d8eb23728eab1","_type":"span","marks":["em"],"text":"one"},{"_key":"d8eb23728eab2","_type":"span","marks":[],"text":" bidder.²⁸ Shareholders buy defense stocks for their stability, their predictability. These companies move slowly and break as little as possible."}],"markDefs":[],"style":"normal"},{"_key":"e37e0a969a5e","_type":"block","children":[{"_key":"0b956adbd8e10","_type":"span","marks":[],"text":"Most engineers, understandably, do not wish to work on national security under these conditions. Engineers want to see their code deployed, their robots in motion, their products out in the world making an impact. Working slowly on antiquated technology that may never be deployed is far from an engineer’s dream. And so the companies once staffed with some of the greatest engineering minds in the Western world now struggle to attract graduates from top engineering programs."}],"markDefs":[],"style":"normal"},{"_key":"f91a2caa0446","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-ec5eda79ed9580b297802bfdfdd6b191dead5826-2003x2597-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.771274547554871,"height":2597,"width":2003},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"60","style":"center"},{"_key":"c78291a122a4","_type":"block","children":[{"_key":"5d7c7aa109f80","_type":"span","marks":[],"text":"The Department of Defense used to own all the technology it needed to credibly deter and, if necessary, win the next great war. But the same is not true today."}],"markDefs":[],"style":"normal"},{"_key":"c1d6a3f19528","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-dd250275ee2790580c68f7ea14b47c3ae20a0059-2480x1676-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.4797136038186158,"height":1676,"width":2480},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"024a127b6b66","_type":"block","children":[{"_key":"d7e889d03d670","_type":"span","marks":[],"text":"This isn’t because our ships aren’t big enough, or our planes fast enough, or our tanks sturdy enough. The areas in which the United States and its allies are falling behind are not these large hardware systems, which we employed to dominate the 20th century, but sophisticated software. The majority of the Department of Defense’s innovation priorities — including artificial intelligence, networked weapons, cybersecurity, and more — are enabled, either in part or in total, by software. The hardware components of swarming munitions, autonomous UAVs, or cruise missile defense systems are just one half of the equation."}],"markDefs":[],"style":"normal"},{"_key":"1ed2f4ba4c2d","_type":"block","children":[{"_key":"d35a07be1dad0","_type":"span","marks":[],"text":"Software will change how war is waged. The battlefield of the future will teem with artificially intelligent, unmanned systems, which fight, gather reconnaissance data, and communicate at breathtaking speeds. The bipartisan congressional Future of Defense Task Force, drawing upon DARPA’s “Mosaic Warfare” concept, describe a future “where ubiquitous and affordable unmanned air and ground platforms find targets on a contested battlefield and pass the information to a decision maker who can instantly task another part of the same system to strike the enemy from safety.”²⁹ The traditional division between land, air, sea, and space domains will become increasingly anachronistic, as nation states compete for total, all-domain superiority."}],"markDefs":[],"style":"normal"},{"_key":"ade11c302aaa","_type":"block","children":[{"_key":"1dbc2a902a700","_type":"span","marks":[],"text":"There is sometimes a misconception among government officials that software is easier to build than hardware, or that higher quality human capital is required to produce hardware than software. This is flatly untrue: Building the software that makes these concepts possible is an engineering task on the order of magnitude of building a fighter jet. It will require the work of the very brightest engineers in the allied democracies."}],"markDefs":[],"style":"normal"},{"_key":"6d738ba07e5a","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-b04f73e5cd122c61f46c4cfc03853cc18afcac67-2608x1952-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.3360655737704918,"height":1952,"width":2608},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"d95c70c4479b","_type":"block","children":[{"_key":"5cd172fbf9d30","_type":"span","marks":[],"text":"Silicon Valley has a near-monopsony on this talent. Almost every single top-tier software engineer in the democratic world works at a technology company, whether at a startup or in Big Tech. John von Neumann, whose talents were so highly valued that the RAND corporation paid him to scribble down his morning thoughts while shaving,³⁰ would today be working for Google or Facebook. Everything about how such companies operate has been tailored to these engineers — the creative and professional freedom, the speed and lack of bureaucracy, even the casual dress code. There is also an economic incentive for these engineers to work at technology companies, which have higher margins than most other industries and can afford to pay their top talent more."}],"markDefs":[],"style":"normal"},{"_key":"f22977aac6e7","_type":"block","children":[{"_key":"732e6f36284f0","_type":"span","marks":[],"text":"The most unrealistic part about James Bond’s gadgets isn’t the technology itself — it’s that the government owns it. Indeed, the companies building transformative software technology rarely work on national security at all. Sometimes, this is for cultural reasons — after employees at Google protested Google’s participation in Project Maven, the DoD’s flagship AI program, Google canceled their contract. Google isn’t alone; the largest tech companies either avoid defense work or treat it as a secondary priority. Moreover, the defense technology they do build is rarely designed for the job. More often, it is commercial software adapted to a military purpose. These companies deserve our applause for working with the government, but dual-use technology won’t be enough to maintain our technological lead."}],"markDefs":[],"style":"normal"},{"_key":"a54c08d0dad9","_type":"block","children":[{"_key":"4ea4a142382e0","_type":"span","marks":[],"text":"In fairness to the tech employees who’d rather not work on national security, they didn’t sign up to work on defense, and there is no reason in a liberal democracy that one should be forced to work on things that one finds objectionable. But it is striking how far behind the times Silicon Valley has been on questions of national security. The tech industry prides itself on being the first to spot new trends. On national security and the rise of our strategic adversaries, it was the last."}],"markDefs":[],"style":"normal"},{"_key":"6c40e6991443","_type":"block","children":[{"_key":"7a2cd21a18670","_type":"span","marks":[],"text":"The traditional defense contractors, meanwhile, struggle with software not only because they lose engineering talent to Silicon Valley, but because modern software development practices conflict with their very ways of being. The legacy primes are used to slowly developing large, exquisite hardware systems like battleships, which sit in a factory for years before they are finally complete. Once sold, they are largely finished, besides occasional maintenance. Software is fundamentally different. It is developed by shipping a minimum viable product out the door as quickly as possible and seeing where it fails. Software companies respond rapidly and continuously to the performance of software in the field, to such an extent that deployment and iteration are parts of the development process itself. As software technology advances, developers add new features and keep a product up to date."}],"markDefs":[],"style":"normal"},{"_key":"d16f09e0d5b1","_type":"block","children":[{"_key":"5cd994b099c00","_type":"span","marks":[],"text":"That is what the military systems and military companies of today should look like: more Tesla than Ford, more Apple than Nokia."}],"markDefs":[],"style":"normal"},{"_key":"01ef8a200d62","_type":"block","children":[{"_key":"03f68d683d1b0","_type":"span","marks":[],"text":"5 — A New Model"}],"markDefs":[],"style":"h1"},{"_key":"33294b280fb5","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-c31da07cb0e2688373338a52d9ff3ebc88d1907f-1990x1738-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.144994246260069,"height":1738,"width":1990},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"4c22b51d3949","_type":"block","children":[{"_key":"924d690723530","_type":"span","marks":[],"text":"The biggest lie of the political debate surrounding defense spending is that we are stuck in a dichotomy between doing “more with more” or “less with less.” This is a false choice — technology means doing more with less. The stagnation in the defense industry is not inevitable, and we need not accept it."}],"markDefs":[],"style":"normal"},{"_key":"be1a9c23c1bc","_type":"block","children":[{"_key":"bb0ea11414850","_type":"span","marks":[],"text":"Anduril is one of a slew of innovative defense companies pioneering a new model, based on the following principles:"}],"markDefs":[],"style":"normal"},{"_key":"6eefc8a0c758","_type":"block","children":[{"_key":"cc7fb8c162450","_type":"span","marks":["strong"],"text":"1. Outpacing the Threat"}],"markDefs":[],"style":"normal"},{"_key":"faf81e8ca705","_type":"block","children":[{"_key":"49fe6c0061b70","_type":"span","marks":[],"text":"Security threats are evolving faster than we are. In 2018, Under Secretary for Research and Engineering Mike Griffin noted that, on average, it takes the US six- teen years to deliver an idea to operational capability, compared to under seven years for China.³¹ That kind of advantage compounds incredibly quickly: an adversary that starts out with only a fraction of our capabilities but which advances 2x faster will quickly overpower us. And it isn’t just great powers moving more quickly than we are — in the Middle East, well-financed terrorist organizations and militias iterate monthly on their armed drones.³² In the cyber domain, a greater number of state and nonstate actors alike have become capable of sophisticated attacks."}],"markDefs":[],"style":"normal"},{"_key":"c94e13896233","_type":"block","children":[{"_key":"9da0f1e7493d0","_type":"span","marks":[],"text":"We need defense companies that are "},{"_key":"9da0f1e7493d1","_type":"span","marks":["em"],"text":"fast"},{"_key":"9da0f1e7493d2","_type":"span","marks":[],"text":". That won’t happen simply by wishing it to be so: it will only happen if companies are incentivized to move. Thankfully, there is a readily available model for this: every single other industry on the planet. Whether they are selling cars, phones, furniture, or coffee, most companies do not get paid until they build a finished product. That can and should be the case in the defense industry, too: companies should privately finance their research and development, engineer new products quickly and efficiently, and then sell them “off the shelf” to their government partners. The government, in turn, should appropriately reward companies that take on risk and development costs for the technology they build."}],"markDefs":[],"style":"normal"},{"_key":"3657676e7471","_type":"block","children":[{"_key":"2dfc2b598e0b0","_type":"span","marks":[],"text":"There is recent and compelling precedent for this: SpaceX. Despite working on capital-intensive, highly complex products, SpaceX has poured billions of dollars of private capital into research and development. It was found by NASA’s own analysis to be three times cheaper than NASA itself.³³ If rocket-ships can be built quickly and sold “off the shelf,” then so can many more things in the defense budget."}],"markDefs":[],"style":"normal"},{"_key":"9758c34e7b2f","_type":"block","children":[{"_key":"d670fd27af020","_type":"span","marks":[],"text":"But the threat doesn’t stop changing once we sell a system, so nor should our technology. It beggars belief that our men and women in uniform receive updates on their smart phones whenever technology improves, but must wait years for updates to the technology that might save their lives. Software is a double-edged sword: updates can be distributed to operational theaters across the globe with the click of a button, which means that software-enabled technology can stay up to date nearly indefinitely. Conversely, if software isn’t updated frequently, it quickly becomes obsolete. The government should demand the continuous deployment of the latest and greatest software to the tactical edge."}],"markDefs":[],"style":"normal"},{"_key":"d4d75731f208","_type":"block","children":[{"_key":"529f0407af54","_type":"span","marks":["strong"],"text":"2. Building to the Mission, Not to Spec"}],"markDefs":[],"style":"normal"},{"_key":"f67ad6a548c4","_type":"block","children":[{"_key":"40a055657e410","_type":"span","marks":[],"text":"The defining feature of history’s most successful technology companies is product vision. Jeff Bezos, Steve Jobs, Elon Musk, and other great technology entrepreneurs all had distinct images of the future and how their products would shape it. These visions were independent of — and often directly contradicted by — the opinions of those around them. They worked on things that their customers and competition did not believe were possible or did not yet understand. Had they been building new products off painstaking specifications laid out by their customers, the history of modern technology would look very different."}],"markDefs":[],"style":"normal"},{"_key":"5537767c283d","_type":"block","children":[{"_key":"0f484c1a59270","_type":"span","marks":[],"text":"The next great defense companies will also have a vision of the future: they will build to the mission, not to spec. That means designing products to solve problems from first principles. Defense acquisitions have historically been dominated by an emphasis on exquisite platforms — i.e., the Navy needs a fleet with X ships, or the Air Force needs Y planes — whose capability requirements are laid out in excruciating detail. This process answers the question of what the next battleship should look like, but never the question of whether a new battleship is needed at all."}],"markDefs":[],"style":"normal"},{"_key":"97978b4ef4e9","_type":"block","children":[{"_key":"a25536df74e80","_type":"span","marks":[],"text":"Today’s model has things backwards. The problems we are trying to solve should be top of mind, not only for the government, but for the companies building the solutions to those problems. Nobody understands the operational threats that the government is engaging with better than the government itself, but, in turn, nobody understands the technical solutions that can be brought to bear better than industry. Not every company’s product vision will ultimately meet the operational needs of their partners in government, but that is okay — most companies in a capitalist system fail. Competition will bring the best to the forefront and solve problems in ways the government had not predicted or thought possible."}],"markDefs":[],"style":"normal"},{"_key":"0b8cefdc71a7","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-3921dcfc810fb525c4baf542bb96d5c105a5bc89-1148x1762-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":0.6515323496027242,"height":1762,"width":1148},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"60","style":"center"},{"_key":"31936a1bebb2","_type":"block","children":[{"_key":"94d5d86b38210","_type":"span","marks":["strong"],"text":"3. Software-First"}],"markDefs":[],"style":"normal"},{"_key":"1c5c5ed3d9da","_type":"block","children":[{"_key":"e183d1ac2c0b0","_type":"span","marks":[],"text":"Software is finally eating the battlefield, whether the defense industry likes it or not. Whether it is AI-enabled drone swarms, networked weapons systems, real-time situational awareness generated by sensor fusion, or cyberwarfare, software is at the core of the weapon systems of the future. Building world-class software platforms is an engineering challenge akin to building a fighter jet: the next generation of defense companies will invest in doing so accordingly."}],"markDefs":[],"style":"normal"},{"_key":"175bd7229fd8","_type":"block","children":[{"_key":"4ff3bdfb508c0","_type":"span","marks":[],"text":"Pure software can radically expand the capabilities of an armed force, but it can become even more potent when integrated into hardware systems. Take unmanned aerial systems, for example. UAVs like General Atomics’ Reapers and Predators have been staples of the United States’ and United Kingdom’s arsenals for decades now, but because these vehicles are manually piloted and monitored, they require a crew of a dozen to operate. Cutting-edge artificial intelligence and autonomy can reverse that equation."}],"markDefs":[],"style":"normal"},{"_key":"499616a9a217","_type":"block","children":[{"_key":"87cf91ce81b30","_type":"span","marks":[],"text":"This is but one example. The broader point is that modern technology companies do not think of the sheet metal on the exterior of a system as its most valuable element: they instead build the hardware around the new capabilities that software enables. For almost any major commercial technology from the last de- cade — new phones, cars, voice assistants, hobby drones — everything from sensor selection to control surfaces is optimized for software."}],"markDefs":[],"style":"normal"},{"_key":"2c58e74f12c4","_type":"block","children":[{"_key":"2e9e0e97d95d0","_type":"span","marks":["strong"],"text":"4. Controlling Defense Budgets"}],"markDefs":[],"style":"normal"},{"_key":"cf9ba27b9054","_type":"block","children":[{"_key":"5cdea5dfaa980","_type":"span","marks":[],"text":"The defense of the nation is the pre-condition for the nation’s prosperity — but defense companies have a duty, like any entity that receives public funding, to deliver services to the government at a minimal burden to the taxpayer."}],"markDefs":[],"style":"normal"},{"_key":"485fb832cd91","_type":"block","children":[{"_key":"bdbf4d5f08dc0","_type":"span","marks":[],"text":"This is a particularly sensitive issue for the defense industry. Governments around the world routinely (and justifiably) complain of being bilked³⁴ by major defense contractors.³⁵ While there are certainly historical examples of fraud and abuse on the part of contractors, the deeper problem is structural. High costs are endemic to a defense industry that operates off cost-plus contracts."}],"markDefs":[],"style":"normal"},{"_key":"12029d422e37","_type":"block","children":[{"_key":"648a355ec4ac0","_type":"span","marks":[],"text":"On the other hand, the uncomfortable truth is that it is impossible to build and scale a successful business without rewarding the investors and employees who took a risk on it. If the companies challenging the incumbent defense firms are not profitable, they will get nowhere at all, and our defense technology will continue to languish behind consumer tech."}],"markDefs":[],"style":"normal"},{"_key":"86cf0b78104d","_type":"block","children":[{"_key":"600453f4f95f0","_type":"span","marks":[],"text":"There is no magic bullet for driving down costs, but a healthy dose of free market capitalism would go a long way in getting us there. The more companies we bring into the defense industrial base, the more these companies will have to compete on price. The more that companies spend on their own dime rather than relying on cost-plus contracts, the more they’ll cut costs. And the more we leverage new technology like AI, the more we can save on labor costs for the dull, dirty, dangerous jobs of military service."}],"markDefs":[],"style":"normal"},{"_key":"04eda459e284","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-b3ec9929e077e2af131ff1ebdb218a49b701dee7-720x720-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1,"height":720,"width":720},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"60","style":"center"},{"_key":"a0a7b9395e7e","_type":"block","children":[{"_key":"9ddfe3be230d0","_type":"span","marks":[],"text":"6 — The Government Response"}],"markDefs":[],"style":"h1"},{"_key":"2d5a6ea19ba2","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-f6f4e23b08208ce5264de27632f48f1cc224e0aa-1920x1280-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5,"height":1280,"width":1920},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"7dec6072d454","_type":"block","children":[{"_key":"a08bfce2a6ca0","_type":"span","marks":[],"text":"With the principles above, we can create a new breed of modern, agile defense companies that turn our soldiers into superheroes. These companies will solve problems of their own accord, but also bring out the best in the incumbent defense contractors, who have not felt competition nipping at their heels in decades."}],"markDefs":[],"style":"normal"},{"_key":"e9ff0e993628","_type":"block","children":[{"_key":"6ee4c04fb5670","_type":"span","marks":[],"text":"But the companies following these principles, however well-intentioned, will mostly fail without an equivalent response from our government leaders. The major defense companies operate as they do because our laws and regulations incentivize it. Governments across the democratic world have a monumental task ahead of them in reshaping the incentives of the defense industry and allowing a more dynamic, innovative model to thrive."}],"markDefs":[],"style":"normal"},{"_key":"c72808f16d13","_type":"block","children":[{"_key":"21226dc6b80d0","_type":"span","marks":[],"text":"We have spent the last few years publishing and advocating a series of policy analyses and recommendations to modernize our antiquated weapons acquisitions system, usually tailored to the United States government but often applicable across nations. Recommendations like these are just the tip of the iceberg, and we exhort our leaders in government to develop and drive forward solutions where they see problems. A few areas we have identified where we can make major progress include:"}],"markDefs":[],"style":"normal"},{"_key":"e4f2b3df8d37","_type":"block","children":[{"_key":"602f1b4d1fc90","_type":"span","marks":["43ac6089cff7","strong"],"text":"1. Thinking Software-First"}],"markDefs":[{"_key":"43ac6089cff7","_type":"link","href":"https://blog.anduril.com/in-the-21st-century-the-department-of-defense-must-think-software-first-36802bd4be65"}],"style":"normal"},{"_key":"9213d2fbdfc7","_type":"block","children":[{"_key":"5dfa7ebecbde0","_type":"span","marks":[],"text":"This isn’t just for companies: the government must embrace a software-first mindset too. In practice, this would involve a long series of changes, including but not limited to:"}],"markDefs":[],"style":"normal"},{"_key":"5cf8a0bc27f2","_type":"block","children":[{"_key":"84ea70d3c86a0","_type":"span","marks":["em"],"text":"a. Establishing large, critical programs for key software priorities."}],"markDefs":[],"style":"normal"},{"_key":"ea552b8e4853","_type":"block","children":[{"_key":"05ebd8dc0d280","_type":"span","marks":[],"text":"Simply put, the government does not value software in the way that it does hardware. In the United States, fewer than 10% of the military’s Major Defense Acquisition Programs (MDAPs) are software systems. Even more damningly, the military’s largest software programs are mostly IT tools, designed for internal management and civil functions, most of which could be done better by commercially available technology. The first step toward leveraging the latest in modern technology is "},{"_key":"05ebd8dc0d281","_type":"span","marks":["em"],"text":"demanding"},{"_key":"05ebd8dc0d282","_type":"span","marks":[],"text":" it through big programs."}],"markDefs":[],"style":"normal"},{"_key":"3760fb0e857c","_type":"block","children":[{"_key":"bbed0d80a4030","_type":"span","marks":["em"],"text":"b. Awarding prime contracts to software companies."}],"markDefs":[],"style":"normal"},{"_key":"1da47a9c60c0","_type":"block","children":[{"_key":"3a0a45eaf0fe0","_type":"span","marks":[],"text":"Fundamental design decisions for new military systems are typically made before software companies are even consulted, meaning the hardware is not optimized for and often entirely unable to accommodate cutting-edge software."}],"markDefs":[],"style":"normal"},{"_key":"685f5286d05f","_type":"block","children":[{"_key":"a32255e405330","_type":"span","marks":["em"],"text":"c. Aligning acquisition policy with industry best practices."}],"markDefs":[],"style":"normal"},{"_key":"0a2462f5cc53","_type":"block","children":[{"_key":"15f5ff7404770","_type":"span","marks":[],"text":"This would include transitioning away from RDT&E- heavy, cost-plus fixed fee contracts towards firm fixed price contracts that encourage rapid prototyping, deployment, and testing of new capabilities. To go even further, governments should experiment with industry-standard payment structures like subscriptions and “as-a-service” models, which minimize switching and sunk costs, encourage competition, and demand that technology is constantly updated."}],"markDefs":[],"style":"normal"},{"_key":"221aa4ba776d","_type":"block","children":[{"_key":"a17e42ce9b0d0","_type":"span","marks":["6a5b1ca54afb","strong"],"text":"2. Running Meritocratic Competitions for New Systems"}],"markDefs":[{"_key":"6a5b1ca54afb","_type":"link","href":"https://blog.anduril.com/reward-winners-or-america-loses-2f4091f251e8"}],"style":"normal"},{"_key":"4c50679d73bb","_type":"block","children":[{"_key":"923c5e9873330","_type":"span","marks":[],"text":"Most government contracts are awarded on the basis of lengthy proposals, with little to no reference to real-life performance of the technology in question. To encourage the most innovative companies and engineers to work on defense technology, the government should instead:"}],"markDefs":[],"style":"normal"},{"_key":"ef7c585606eb","_type":"block","children":[{"_key":"38e3b551f4b80","_type":"span","marks":["em"],"text":"a. Shift from proposals-focused competition to performance-based competition."}],"markDefs":[],"style":"normal"},{"_key":"46022cd0fe82","_type":"block","children":[{"_key":"35b6a6eb8d6f0","_type":"span","marks":[],"text":"Instead of prioritizing proposals, acquisitions should be structured as a series of bake-offs and well delineated projects that test a vendor’s ability to solve a problem with technology and deploy it operationally."}],"markDefs":[],"style":"normal"},{"_key":"7647835f7728","_type":"block","children":[{"_key":"47337e66d3020","_type":"span","marks":["em"],"text":"b. Always have a meaningful contract at the end of a competition, and issue it quickly."}],"markDefs":[],"style":"normal"},{"_key":"cf44796b6241","_type":"block","children":[{"_key":"6205f7df937c0","_type":"span","marks":[],"text":"Innovation grants and pilot contracts only go so far — in return for investing time and money into demonstrating a new capability, companies that successfully solve government problems should be rewarded in a timely manner."}],"markDefs":[],"style":"normal"},{"_key":"8d347c64af60","_type":"block","children":[{"_key":"5435c98fee390","_type":"span","marks":["em"],"text":"c. Keep rewarding new winners by frequently recompeting large programs."}],"markDefs":[],"style":"normal"},{"_key":"8806c6f91e5c","_type":"block","children":[{"_key":"e472d95b8d3e0","_type":"span","marks":[],"text":"Governments routinely award decade-long, multibillion dollar contracts to single vendors. This couldn’t be more different to the commercial world, where consumers are typically free to switch between vendors at minimal cost."}],"markDefs":[],"style":"normal"},{"_key":"c844ac1f495a","_type":"block","children":[{"_key":"3e2149bbe1100","_type":"span","marks":["em"],"text":"d. Measure outputs, not inputs."}],"markDefs":[],"style":"normal"},{"_key":"40f380e7e9fc","_type":"block","children":[{"_key":"6e1cc0ccb2cf0","_type":"span","marks":[],"text":"Governments should hold themselves accountable: instead of asking how many competitions they held, they should ask themselves how many of those competitions led to a meaningful contract for a nontraditional defense company."}],"markDefs":[],"style":"normal"},{"_key":"f0355627a24f","_type":"block","children":[{"_key":"05ed42771d900","_type":"span","marks":["adf29214ec01","strong"],"text":"3. Revamping Anachronistic Data Rights Practices"}],"markDefs":[{"_key":"adf29214ec01","_type":"link","href":"https://blog.anduril.com/the-dod-should-pilot-a-new-category-of-software-data-rights-a949cc9aaae4"}],"style":"normal"},{"_key":"b7de0cd7d0ab","_type":"block","children":[{"_key":"660f764990810","_type":"span","marks":[],"text":"The government typically demands “data rights” — or technical information about how to build a given piece of technology — in a sweeping, one-size-fits-all fashion, a relic of a hardware-centric world. This, unfortunately, scares away all but a handful of modern software companies, who view giving the government their valuable source code as an existential threat to the company. A new model of data rights agreements would:"}],"markDefs":[],"style":"normal"},{"_key":"4dc0d5b4c62b","_type":"block","children":[{"_key":"8a680c93a1a50","_type":"span","marks":["em"],"text":"a."},{"_key":"8a680c93a1a51","_type":"span","marks":[],"text":" "},{"_key":"8a680c93a1a52","_type":"span","marks":["em"],"text":"Account for the size of the program in question, allowing vendors to retain greater rights for small programs and giving the government greater control for larger programs."}],"markDefs":[],"style":"normal"},{"_key":"f6c6c769907f","_type":"block","children":[{"_key":"9552595ad4900","_type":"span","marks":["em"],"text":"b. Closely define the scope of the use of the software being acquired."}],"markDefs":[],"style":"normal"},{"_key":"8a89f8c13407","_type":"block","children":[{"_key":"d7d893270a210","_type":"span","marks":["em"],"text":"c."},{"_key":"d7d893270a211","_type":"span","marks":[],"text":" "},{"_key":"d7d893270a212","_type":"span","marks":["em"],"text":"Address technical lock-in by demanding adherence to technical interoperability standards such as APIs and Government-defined or industry-defined open protocols."}],"markDefs":[],"style":"normal"},{"_key":"eb94b2690490","_type":"block","children":[{"_key":"6b46183f22020","_type":"span","marks":["em"],"text":"d."},{"_key":"6b46183f22021","_type":"span","marks":[],"text":" "},{"_key":"6b46183f22022","_type":"span","marks":["em"],"text":"Allow vendors to propose alternative contract structures, including as-a-service contracts."}],"markDefs":[],"style":"normal"},{"_key":"d9109198c3e6","_type":"block","children":[{"_key":"5e77614fa48d0","_type":"span","marks":["em"],"text":"e. Weigh the costs, not just the benefits, of demanding greater data rights."}],"markDefs":[],"style":"normal"},{"_key":"8a0149a88ec6","_type":"block","children":[{"_key":"d1a53c2b97170","_type":"span","marks":["c23e46d20010","strong"],"text":"4. Helping Companies Cross the ‘Valley of Death’ by Loosening Contracting Timelines"}],"markDefs":[{"_key":"c23e46d20010","_type":"link","href":"https://blog.anduril.com/dod-valley-of-death-closing-the-two-year-gap-758907be9b9f"}],"style":"normal"},{"_key":"d59f8dc5b0c7","_type":"block","children":[{"_key":"18eaa2c33e360","_type":"span","marks":[],"text":"In the United States, it is easier than ever to win a small pilot or prototype contract from the government thanks to a smorgasbord of new innovation entities like the Defense Innovation Unit, AFWERX, NavalX, and more. Conversely, it has never been harder to transition to a large program of record, leaving companies languishing for years between initial funding and scaled deployments. This often sends companies bankrupt, or, more typically, dissuades companies from ever doing business with the government in the first place. This year, the United States Congress addressed this problem with an “Agile Procurement Transition Pilot,” designed to help scale new technologies quickly and get companies through the valley of death. This is a valuable start, but by no means a wholesale solution to the valley of death. Governments across the democratic world should find ways to speed up their acquisitions processes and quickly get new technology into the hands of their uniformed men and women."}],"markDefs":[],"style":"normal"},{"_key":"02ad47a3de3b","_type":"block","children":[{"_key":"18cea671e6ab0","_type":"span","marks":["0a5172898061","strong"],"text":"5. Leveraging Existing Programs"}],"markDefs":[{"_key":"0a5172898061","_type":"link","href":"https://blog.anduril.com/how-the-government-can-use-the-sbir-program-to-scale-innovation-e53806941af2"}],"style":"normal"},{"_key":"fbfb23982c1b","_type":"block","children":[{"_key":"6ea5867e937c0","_type":"span","marks":[],"text":"Often, the government has created programs to access and scale new innovations. Because the process to acquire new technologies is so Byzantine, however, acquisitions officers are often unaware of or under-educated about the acquisition tools at their disposal. Where possible, governments should publicize and educate acquisition and contract officers about the tools they already possess to minimize bureaucracy and access new technology."}],"markDefs":[],"style":"normal"},{"_key":"53f403e6b585","_type":"block","children":[{"_key":"36970974fa420","_type":"span","marks":[],"text":"Since founding Anduril, we have been profoundly encouraged by the volume and intensity of support ideas like these have received from those in government. There is a growing group of government officials in administrations across the world who recognize that business as usual simply will not cut it anymore. The challenge ahead is gigantic, but so are the rewards of success: continued peace and prosperity in the democratic world."}],"markDefs":[],"style":"normal"},{"_key":"c62ba555db47","_type":"block","children":[{"_key":"80c5f171dae40","_type":"span","marks":[],"text":"7 — Call to Action"}],"markDefs":[],"style":"h1"},{"_key":"f213d4891faf","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-17d22fe9d19312bcd960675af5e64df3274c508f-2936x1952-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.5040983606557377,"height":1952,"width":2936},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"f00b9ebcca6d","_type":"block","children":[{"_key":"f5db7c75c00b0","_type":"span","marks":["strong"],"text":"There is no secret government silo of advanced technology that will save us if war breaks out —"},{"_key":"f5db7c75c00b1","_type":"span","marks":[],"text":" "},{"_key":"f5db7c75c00b2","_type":"span","marks":["strong","em"],"text":"you must build it."},{"_key":"f5db7c75c00b3","_type":"span","marks":[],"text":" "},{"_key":"f5db7c75c00b4","_type":"span","marks":["strong"],"text":"If you have read this far, you care deeply about the future of our collective defense. As engineers, government leaders, and citizens:"}],"markDefs":[],"style":"normal"},{"_key":"ec948017c995","_type":"block","children":[{"_key":"56600527fa340","_type":"span","marks":["strong"],"text":"Help us to rebuild the arsenal of democracy and make that future safe, prosperous, and free."}],"markDefs":[],"style":"normal"},{"_key":"1f2c5fd3902a","_type":"block","children":[{"_key":"dc1e6929b6b10","_type":"span","marks":[],"text":"References"}],"markDefs":[],"style":"h2"},{"_key":"c7f89dc03899","_type":"block","children":[{"_key":"b909f76953700","_type":"span","marks":[],"text":"¹ Brose, Christian. "},{"_key":"b909f76953701","_type":"span","marks":["em"],"text":"The Kill Chain"},{"_key":"b909f76953702","_type":"span","marks":[],"text":". 2020. p. xii."}],"markDefs":[],"style":"normal"},{"_key":"b811d846fe59","_type":"block","children":[{"_key":"416c645888980","_type":"span","marks":[],"text":"² Rich, Ben. "},{"_key":"416c645888981","_type":"span","marks":["em"],"text":"Skunk Works: A Personal Memoir of My Years at Lockheed"},{"_key":"416c645888982","_type":"span","marks":[],"text":". 1994. p. 316."}],"markDefs":[],"style":"normal"},{"_key":"3f4f9d4a29fe","_type":"block","children":[{"_key":"6f19ffafb66b0","_type":"span","marks":[],"text":"³ Rich, p. 321."}],"markDefs":[],"style":"normal"},{"_key":"588c9276bf56","_type":"block","children":[{"_key":"71c0ca8308390","_type":"span","marks":[],"text":"⁴ Werner, Ben. “New Pentagon Report Points to Problems in the U.S. Shipbuilding Industrial Base.” "},{"_key":"71c0ca8308391","_type":"span","marks":["em"],"text":"USNI News"},{"_key":"71c0ca8308392","_type":"span","marks":[],"text":", October 2018, "},{"_key":"71c0ca8308393","_type":"span","marks":["bf00defb211d"],"text":"https://news.usni.org/2018/10/05/u-s-shipbuilding-example-of-defense-industrial-base-weakness."}],"markDefs":[{"_key":"bf00defb211d","_type":"link","href":"https://news.usni.org/2018/10/05/u-s-shipbuilding-example-of-defense-industrial-base-weakness."}],"style":"normal"},{"_key":"c8e3ca1ce343","_type":"block","children":[{"_key":"b87fc34b1d4c0","_type":"span","marks":[],"text":"⁵ Chart taken from Greenwalt, William & Patt, Dan, “Competing in Time: Ensuring Capability Advantage and Mission Success through Adaptable Resource Allocation.” "},{"_key":"b87fc34b1d4c1","_type":"span","marks":["em"],"text":"Hudson Institute"},{"_key":"b87fc34b1d4c2","_type":"span","marks":[],"text":", February 2021, "},{"_key":"b87fc34b1d4c3","_type":"span","marks":["7b93d371cf3f"],"text":"https://www.hudson.org/research/16717-competing-in-time-ensuring-capability-advantage-and-mission-success-through-adaptable-resource-allocation."}],"markDefs":[{"_key":"7b93d371cf3f","_type":"link","href":"https://www.hudson.org/research/16717-competing-in-time-ensuring-capability-advantage-and-mission-success-through-adaptable-resource-allocation."}],"style":"normal"},{"_key":"0a0fc24a6bb4","_type":"block","children":[{"_key":"5beac139832e0","_type":"span","marks":[],"text":"⁶ If you are interested in learning more about the history of early Silicon Valley and its overlap with the U.S. military, we recommend Steve Blank’s “The Secret History of Silicon Valley”: "},{"_key":"5beac139832e1","_type":"span","marks":["ad7dc21fa569"],"text":"https://steveblank.com/secret-history/."}],"markDefs":[{"_key":"ad7dc21fa569","_type":"link","href":"https://steveblank.com/secret-history/"}],"style":"normal"},{"_key":"1ce9654126fc","_type":"block","children":[{"_key":"85a1f2a2c46d0","_type":"span","marks":[],"text":"⁷ Congressional Research Service, “The Global Research and Development Landscape and Implications for the Department of Defense.” 2021, "},{"_key":"85a1f2a2c46d1","_type":"s