s/thunder/albedo_bevel_inner.png":"assets/images/products/thunder/albedo_bevel_inner.xxZyB_NRXC.png","assets/images/products/thunder/ao_bevel_inner.png":"assets/images/products/thunder/ao_bevel_inner.xx1ahbI7AI.png","assets/images/products/thunder/headlights.avif":"assets/images/products/thunder/headlights.xxtzXhfxY-.avif","assets/images/products/thunder/headlights.png":"assets/images/products/thunder/headlights.xxAfmdT787.png","assets/images/products/thunder/nose_decal_albedo.png":"assets/images/products/thunder/nose_decal_albedo.xx7srNUyaO.png","assets/images/products/thunder/thunder_ao.png":"assets/images/products/thunder/thunder_ao.xxShn4IPED.png","assets/images/products/thunder/thunder_decals.png":"assets/images/products/thunder/thunder_decals.xxwpBFTYuS.png","assets/images/products/wisp/wisp_albedo.png":"assets/images/products/wisp/wisp_albedo.xxH-Da29EA.png","assets/images/products/wisp/wisp_ao.png":"assets/images/products/wisp/wisp_ao.xxE0jzeiUs.png","assets/images/products/wisp/wisp_decal.png":"assets/images/products/wisp/wisp_decal.xxKuq80R6Z.png","assets/images/specular1-ojto_Smm.ktx2-compressedKtx2":"assets/images/specular1-ojto_Smm.xxm07dlcQK.ktx2-compressedKtx2","assets/images/sprite.svg":"assets/images/sprite.xxFIIWEOs2.svg","assets/images/steelfin_body_albedo-CoYts5ht.ktx2-compressedKtx2":"assets/images/steelfin_body_albedo-CoYts5ht.xxaKDCcVmz.ktx2-compressedKtx2","assets/images/steelfin_booster_albedo-t2vrP-px.ktx2-compressedKtx2":"assets/images/steelfin_booster_albedo-t2vrP-px.xxbDg-xVgx.ktx2-compressedKtx2","assets/images/steelfin_fin_albedo-P9QfAgdr.ktx2-compressedKtx2":"assets/images/steelfin_fin_albedo-P9QfAgdr.xxivdBpIOZ.ktx2-compressedKtx2","assets/images/steelfin_nose_albedo-Tn9pOUH0.ktx2-compressedKtx2":"assets/images/steelfin_nose_albedo-Tn9pOUH0.xxUcKBmPDF.ktx2-compressedKtx2","assets/images/texture/damaged_road_normal.png":"assets/images/texture/damaged_road_normal.xxfLaXFyMF.png","assets/images/texture/grain_1024.png":"assets/images/tex