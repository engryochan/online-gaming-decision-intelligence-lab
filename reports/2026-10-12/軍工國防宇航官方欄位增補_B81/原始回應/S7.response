dren":[{"_key":"d9c501042bc80","_type":"span","marks":[],"text":"¹⁸ Lucas, Ryan. “DOJ’s China Initiative aims to counter theft of U.S. secrets and technology.” "},{"_key":"d9c501042bc81","_type":"span","marks":["em"],"text":"NPR"},{"_key":"d9c501042bc82","_type":"span","marks":[],"text":", November 2021, "},{"_key":"d9c501042bc83","_type":"span","marks":["228652981218"],"text":"https://www.npr.org/2021/11/04/1052248809/dojs-china-initiative-aims-to-counter-theft-of-u-s-secrets-and-technology?t=1639407638565."}],"markDefs":[{"_key":"228652981218","_type":"link","href":"https://www.npr.org/2021/11/04/1052248809/dojs-china-initiative-aims-to-counter-theft-of-u-s-secrets-and-technology?t=1639407638565."}],"style":"normal"},{"_key":"f9786070b573","_type":"block","children":[{"_key":"c82f527e18680","_type":"span","marks":[],"text":"¹⁹ Rumsfeld, Donald. "},{"_key":"c82f527e18681","_type":"span","marks":["em"],"text":"Public Statements of Donald H. Rumsfeld, Secretary of Defense, 2001"},{"_key":"c82f527e18682","_type":"span","marks":[],"text":". 2001. "},{"_key":"c82f527e18683","_type":"span","marks":["297d23026820"],"text":"https://books.google.com/books/about/Public_Statements_of_Donald_H_Rumsfeld_S.html?id=hGFHAQAAIAAJ"},{"_key":"c82f527e18684","_type":"span","marks":[],"text":". p. 1728."}],"markDefs":[{"_key":"297d23026820","_type":"link","href":"https://books.google.com/books/about/Public_Statements_of_Donald_H_Rumsfeld_S.html?id=hGFHAQAAIAAJ"}],"style":"normal"},{"_key":"3e662fb35475","_type":"block","children":[{"_key":"42e28783899d0","_type":"span","marks":[],"text":"²⁰ Fox, p. 40."}],"markDefs":[],"style":"normal"},{"_key":"e2d808e781e8","_type":"block","children":[{"_key":"b328c9ca15670","_type":"span","marks":[],"text":"²¹ Hamtil, Lawrence. “Exploring the Surprising Resilience of the Defense Industry.” "},{"_key":"b328c9ca15671","_type":"span","marks":["em"],"text":"Fortune Financial"},{"_key":"b328c9ca15672","_type":"span","marks":[],"text":", February 2021, "},{"_key":"b328c9ca15673","_type":"span","marks":["857133a79cea"],"text":"https://fortunefinancialadvisors.com/blog/exploring-the-surprising-resilience-of-the-defense-industry/."}],"markDefs":[{"_key":"857133a79cea","_type":"link","href":"https://fortunefinancialadvisors.com/blog/exploring-the-surprising-resilience-of-the-defense-industry/"}],"style":"normal"},{"_key":"df9b2a94a42a","_type":"block","children":[{"_key":"7206cd052e1b0","_type":"span","marks":[],"text":"²² Mintz, John. “How a Dinner Led to a Feeding Frenzy.” "},{"_key":"7206cd052e1b1","_type":"span","marks":["em"],"text":"The Washington Post"},{"_key":"7206cd052e1b2","_type":"span","marks":[],"text":", July 1997. "},{"_key":"7206cd052e1b3","_type":"span","marks":["103832eb0529"],"text":"https://www.washingtonpost.com/archive/business/1997/07/04/how-a-dinner-led-to-a-feeding-frenzy/13961ba2-5908-4992-8335-c3c087cdebc6/."}],"markDefs":[{"_key":"103832eb0529","_type":"link","href":"https://www.washingtonpost.com/archive/business/1997/07/04/how-a-dinner-led-to-a-feeding-frenzy/13961ba2-5908-4992-8335-c3c087cdebc6/"}],"style":"normal"},{"_key":"04e6f8c877d6","_type":"block","children":[{"_key":"ccf8483e169c0","_type":"span","marks":[],"text":"²³ Berenson, Doug; Higgins, Chris; & Tinsley, Jim. “The U.S. Defense Industry In a New Era.” "},{"_key":"ccf8483e169c1","_type":"span","marks":["em"],"text":"War on the Rocks"},{"_key":"ccf8483e169c2","_type":"span","marks":[],"text":", January 2021. "},{"_key":"ccf8483e169c3","_type":"span","marks":["aae6976c8820"],"text":"https://warontherocks.com/2021/01/the-u-s-defense-industry-in-a-new-era/."}],"markDefs":[{"_key":"aae6976c8820","_type":"link","href":"https://warontherocks.com/2021/01/the-u-s-defense-industry-in-a-new-era/"}],"style":"normal"},{"_key":"572b05e1c5ae","_type":"block","children":[{"_key":"fe07403aa9140","_type":"span","marks":[],"text":"²⁴ Fox, p. 172."}],"markDefs":[],"style":"normal"},{"_key":"6c7c71a4a94b","_type":"block","children":[{"_key":"033857fa168e0","_type":"span","marks":[],"text":"²⁵ Judson, J. “Judge Rules in Favor of Palantir in Lawsuit Against US Army.” "},{"_key":"033857fa168e1","_type":"span","marks":["em"],"text":"Defense News"},{"_key":"033857fa168e2","_type":"span","marks":[],"text":", October 2016, "},{"_key":"033857fa168e3","_type":"span","marks":["f381fbbd654b"],"text":"https://www.defensenews.com/land/2016/10/31/judge-rules-in-favor-of-palantir-in-lawsuit-against-us-army/."}],"markDefs":[{"_key":"f381fbbd654b","_type":"link","href":"https://www.defensenews.com/land/2016/10/31/judge-rules-in-favor-of-palantir-in-lawsuit-against-us-army/"}],"style":"normal"},{"_key":"dd6f297cd3ba","_type":"block","children":[{"_key":"c067a751e5880","_type":"span","marks":[],"text":"²⁶ Davenport, Christian & Fung, Brian. “Elon Musk’s SpaceX to sue government over space launch contract.” "},{"_key":"c067a751e5881","_type":"span","marks":["em"],"text":"The Washington Post"},{"_key":"c067a751e5882","_type":"span","marks":[],"text":"April, 2014. "},{"_key":"c067a751e5883","_type":"span","marks":["6c463897d5bf"],"text":"https://www.washingtonpost.com/business/economy/elon-musks-spacex-to-sue-government-over-space-launch-contract/2014/04/25/1001aa6e-cca6-11e3-95f7-7ecdde72d2ea_story.html."}],"markDefs":[{"_key":"6c463897d5bf","_type":"link","href":"https://www.washingtonpost.com/business/economy/elon-musks-spacex-to-sue-government-over-space-launch-contract/2014/04/25/1001aa6e-cca6-11e3-95f7-7ecdde72d2ea_story.html."}],"style":"normal"},{"_key":"b8d9d7dda042","_type":"block","children":[{"_key":"f4fc3cd546470","_type":"span","marks":[],"text":"²⁷ Fox, p. 182."}],"markDefs":[],"style":"normal"},{"_key":"395789a045a1","_type":"block","children":[{"_key":"8b9062e8968b0","_type":"span","marks":[],"text":"²⁸ “Courage to Learn: Defense & Aerospace.” "},{"_key":"8b9062e8968b1","_type":"span","marks":["em"],"text":"American Economic Liberties Project"},{"_key":"8b9062e8968b2","_type":"span","marks":[],"text":", January 2021, "},{"_key":"8b9062e8968b3","_type":"span","marks":["d2d9d13dd414"],"text":"https://www.economicliberties.us/our-work/courage-to-learn-defense-aerospace/."}],"markDefs":[{"_key":"d2d9d13dd414","_type":"link","href":"https://www.economicliberties.us/our-work/courage-to-learn-defense-aerospace/"}],"style":"normal"},{"_key":"3cc2433c1757","_type":"block","children":[{"_key":"949c0ac968130","_type":"span","marks":[],"text":"²⁹ Future of Defense Task Force, “Report 2020.” September 2020, "},{"_key":"949c0ac968131","_type":"span","marks":["34729c014559"],"text":"https://armedservices.house.gov/2020/9/future-of-defense-task-force-releases-final-report"},{"_key":"949c0ac968132","_type":"span","marks":[],"text":", p. 73."}],"markDefs":[{"_key":"34729c014559","_type":"link","href":"https://armedservices.house.gov/2020/9/future-of-defense-task-force-releases-final-report"}],"style":"normal"},{"_key":"b785f8d4854f","_type":"block","children":[{"_key":"83f6418ccf3d0","_type":"span","marks":[],"text":"³⁰ Jacobsen, Annie. "},{"_key":"83f6418ccf3d1","_type":"span","marks":["em"],"text":"The Pentagon’s Brain: An Uncensored History of DARPA, America’s Top-Secret Military Research Agency"},{"_key":"83f6418ccf3d2","_type":"span","marks":[],"text":". 2015. p. 30."}],"markDefs":[],"style":"normal"},{"_key":"ee90308a004e","_type":"block","children":[{"_key":"1b71763cd1120","_type":"span","marks":[],"text":"³¹ Greenwalt, p. 35."}],"markDefs":[],"style":"normal"},{"_key":"86466dada6d2","_type":"block","children":[{"_key":"d9ddbece05030","_type":"span","marks":[],"text":"³² Arraf, Jane & Schmitt, Eric. “Iran’s Proxies in Iraq Threaten U.S. With More Sophisticated Weapons.” "},{"_key":"d9ddbece05031","_type":"span","marks":["em"],"text":"New York Times"},{"_key":"d9ddbece05032","_type":"span","marks":[],"text":", June 2021, "},{"_key":"d9ddbece05033","_type":"span","marks":["c19d54c345aa"],"text":"https://www.nytimes.com/2021/06/04/world/middleeast/iran-drones-iraq.html."}],"markDefs":[{"_key":"c19d54c345aa","_type":"link","href":"https://www.nytimes.com/2021/06/04/world/middleeast/iran-drones-iraq.html."}],"style":"normal"},{"_key":"c6570157b774","_type":"block","children":[{"_key":"f760d5f4fee30","_type":"span","marks":[],"text":"³³ Chaikin, Andrew. “Is SpaceX Changing the Rocket Equation?” "},{"_key":"f760d5f4fee31","_type":"span","marks":["em"],"text":"Smithsonian Magazine"},{"_key":"f760d5f4fee32","_type":"span","marks":[],"text":", January 2012, "},{"_key":"f760d5f4fee33","_type":"span","marks":["fe375ab480d5"],"text":"https://www.smithsonianmag.com/air-space-magazine/is-spacex-changing-the-rocket-equation-132285884/."}],"markDefs":[{"_key":"fe375ab480d5","_type":"link","href":"https://www.smithsonianmag.com/air-space-magazine/is-spacex-changing-the-rocket-equation-132285884/"}],"style":"normal"},{"_key":"d14d5be150e8","_type":"block","children":[{"_key":"a078a37ba4920","_type":"span","marks":[],"text":"³⁴ V. Roberts, Steven. “Congress: The Provocative Saga of the $400 Hammer.” "},{"_key":"a078a37ba4921","_type":"span","marks":["em"],"text":"The New York Times"},{"_key":"a078a37ba4922","_type":"span","marks":[],"text":", June 1984, "},{"_key":"a078a37ba4923","_type":"span","marks":["363f55a273bc"],"text":"https://www.nytimes.com/1984/06/13/us/congress-the-provacative-saga-of-the-400-hammer.html."}],"markDefs":[{"_key":"363f55a273bc","_type":"link","href":"https://www.nytimes.com/1984/06/13/us/congress-the-provacative-saga-of-the-400-hammer.html."}],"style":"normal"},{"_key":"6c4e31889ce8","_type":"block","children":[{"_key":"443b5165c4770","_type":"span","marks":[],"text":"³⁵ NYT staff. “Lockheed Is Accused of Waste and Deceit on C-5A.” "},{"_key":"443b5165c4771","_type":"span","marks":["em"],"text":"The New York Times"},{"_key":"443b5165c4772","_type":"span","marks":[],"text":", September 1971, "},{"_key":"443b5165c4773","_type":"span","marks":["4f4444e1ae7f"],"text":"https://www.nytimes.com/1971/09/30/archives/lockheed-is-accused-of-waste-and-deceit-on-c5a-lockheed-deceit-on.html."}],"markDefs":[{"_key":"4f4444e1ae7f","_type":"link","href":"https://www.nytimes.com/1971/09/30/archives/lockheed-is-accused-of-waste-and-deceit-on-c5a-lockheed-deceit-on.html."}],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"rebooting-the-arsenal-of-democracy-anduril-mission-document"},"title":"Rebooting the Arsenal of Democracy: Anduril Mission Document"},{"_createdAt":"2023-07-14T21:47:39Z","_id":"e1a8d428-f06c-4988-a7da-d3dfff245d6f","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","authors":[{"_createdAt":"2025-04-10T02:38:50Z","_id":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_rev":"8QtQE8S3U2lXjdjxKMFvCL","_type":"person","_updatedAt":"2025-11-18T00:08:12Z","bio":[],"fullName":"Anduril Industries","image":{"_type":"image","asset":{"_ref":"image-a990fb8ef1bae814dc01807f8757917489c9e64d-2536x2536-jpg","_type":"reference"}},"metadata":null,"slug":{"_type":"slug","current":"anduril-industries"}}],"categories":[{"_createdAt":"2025-04-10T03:57:42Z","_id":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"news"},"title":"News"}],"date":"2022-03-22","image":{"_type":"imageWithMeta","alt":"Military personnel operate Ghost autonomous system in forest field exercise.","asset":{"_id":"image-b274f624930e40cab7399453b63851cbe19ad899-720x540-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.3333333333333333,"height":540,"width":720},"hasAlpha":false,"isOpaque":true}}},"meta":{"_type":"meta","description":"Ghost is an autonomous, modular Group 2 UAS Anduril that fills the gap between small quadcopters and fix-wing.","title":"Ghost Brings Autonomy to Small Units at AEWE","type":"article"},"metadata":null,"parent":{"_createdAt":"2025-03-18T06:18:29Z","_id":"cb940787-64b7-481d-8379-537ea6a1cf56","_rev":"N1G5rtOZj8187JlhVNj8ZV","_system":{"base":{"id":"cb940787-64b7-481d-8379-537ea6a1cf56","rev":"U0oN0QIqDw3OWy2Rvws2n8"}},"_type":"page","_updatedAt":"2026-10-06T20:13:24Z","category":"company","meta":{"description":"The latest news, announcements, and insights from Anduril Industries.","title":"Newsroom"},"metadata":null,"slices":[{"_key":"be226df55718","_type":"navColorSlice","navColorMode":"dark"},{"_key":"862b9c27dddf","_type":"newsroomHeader","header":"News & Insights","headerLabel":"NEWSROOM","highlightedArticle":{"_type":"newsLink","link":{"_ref":"deba6017-6ea9-492e-a4f6-78f295f14d6a","_type":"reference"}}},{"_key":"54576d983b87","_type":"newsListSlice","header":"All articles"}],"slug":{"_type":"slug","current":"news"},"title":"Newsroom"},"relatedArticles":[{"_createdAt":"2023-07-19T00:09:53Z","_id":"77437e63-70e7-41f1-9a11-a9adfc914449","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","authors":[{"_key":"f0788c0e-f036-43de-9fc2-c9aadc0fe092","_ref":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_type":"reference"}],"categories":[{"_key":"a3e00bf0831d","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"}],"date":"2022-05-19","image":{"_type":"imageWithMeta","alt":"ALTIUS air-launched drone flies against blue sky during Army demonstration.","asset":{"_ref":"image-8c5372085ee0d82ee918c273577bc87586e69691-1323x877-png","_type":"reference"}},"meta":{"_type":"meta","description":"ALTIUS Air Launched Effects demonstrates advanced teaming capabilities at US Army Project Edge 2022, showcasing autonomous collaboration.","title":"ALTIUS Air Launched Effects Demonstrated Advanced Teaming at US Army Project Edge 2022","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"relatedArticles":[{"_key":"6833c9b01d95","_ref":"eaec10a1-6380-4995-bd18-bb11b121fcd0","_type":"reference"},{"_key":"3f27f6447f37","_ref":"2c25e7a0-1242-4557-8c78-c09efae5177a","_type":"reference"},{"_key":"0bab8191b308","_ref":"c775c350-2299-4d4a-bf75-8c8ca76c9861","_type":"reference"}],"slices":[{"_key":"8e0a0b7fe23d","_type":"oneColumnRichText","content":[{"_key":"80afd8074e65","_type":"block","children":[{"_key":"4969ab8306b10","_type":"span","marks":[],"text":"Anduril & Area-I are excited to announce that the ALTIUS Air Launched Effects platform demonstrated first of its kind intelligent teaming during EDGE22. Air Launched Effects are vital to the Army’s Future Vertical Lift. As demonstrated at EDGE22, Area-I’s ALE technology — ALTIUS 600 — represents a technological leap ahead for this critical capability."}],"markDefs":[],"style":"lead"},{"_key":"b74d03741eed","_type":"block","children":[{"_key":"2634d7ef0bca","_type":"span","marks":[],"text":"ALTIUS was key to achieving EDGE 22’s technological goals, including demonstrating its autonomous teaming capabilities as part of the largest ALE swarm to date. The modular ALTIUS platform led the largest demonstration of collaborative teaming with multiple ALTIUS platforms operating collaboratively at once. In addition, ALTIUS demonstrated a coordinated detect, identify, locate and report mission capability."}],"markDefs":[],"style":"normal"},{"_key":"f9fe50e515f5","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-d7a5c96d2a3c3f6cf0e1951186772daad8a8cbf7-2048x1324-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"a4f69be572d1","_type":"block","children":[{"_key":"efe4d6f5f24e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"3d7f974b0843","_type":"block","children":[{"_key":"4ddb2a3814d2","_type":"span","marks":[],"text":"ALTIUS was key to achieving EDGE 22’s technological goals, including demonstrating its autonomous teaming capabilities as part of the largest ALE swarm to date. The modular ALTIUS platform led the largest demonstration of collaborative teaming with multiple ALTIUS platforms operating collaboratively at once. In addition, ALTIUS demonstrated a coordinated detect, identify, locate and report mission capability."}],"markDefs":[],"style":"normal"},{"_key":"768de03b0bc7","_type":"block","children":[{"_key":"750f7610824f","_type":"span","marks":[],"text":"ALTIUS is an industry leader that can track, engage, and provide overmatch of enemy targets in a multi-domain environment. The ALTIUS system is modular by design, capable of supporting a variety of kinetic and non-kinetic payloads and sensors that can be customized based on the mission. ALTIUS has a demonstrated ability to be organically carried and tube launched from fixed and rotary wing aircraft in both high and low altitude, ground and utility vehicles, as well as watercraft."}],"markDefs":[],"style":"normal"},{"_key":"d0cfc74e6b27","_type":"block","children":[{"_key":"08c9c9638ebf","_type":"span","marks":[],"text":"Air Launched Effects are a critical component of the Future Attack Reconnaissance Aircraft ecosystem’s ability to regain the asymmetric advantage in reach, stand-off, protection, and lethality required in the execution of joint combined arms and maneuver operations."}],"markDefs":[],"style":"normal"},{"_key":"d39ef4a2e420","_type":"block","children":[{"_key":"a74fde2463e8","_type":"span","marks":[],"text":"Anduril is proud to support Army Futures Command during EDGE 22. EDGE 22 is part of AFC’s campaign of learning designed to accelerate technological advancements in integrated artificial intelligence, robotics, and autonomy to improve battlefield situational awareness."}],"markDefs":[],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"altius-air-launched-effects-demonstrated-advanced-teaming-at-us-army-project-edge-2022"},"title":"ALTIUS Air Launched Effects Demonstrated Advanced Teaming at US Army Project Edge 2022"},{"_createdAt":"2021-12-20T18:02:06Z","_id":"29ed2c22-8827-4c22-be27-0d9f8b23ff42","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","categories":[{"_key":"9b4e7f9faf11","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"},{"_key":"48b19a5baf1d","_ref":"f84a91e1-010a-4e53-853b-2c9f005edbda","_type":"reference"}],"date":"2021-06-04","meta":{"_type":"meta","description":"Reimagining base defense strategies with autonomous systems and advanced technologies for enhanced military installation security.","title":"Reimagining Base Defense","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"slices":[{"_key":"11b05301f0fa","_type":"oneColumnRichText","content":[{"_key":"becc66d8ebb6","_type":"videoEmbed","url":"https://player.vimeo.com/video/558696337"},{"_key":"d4a541826549","_type":"block","children":[{"_key":"500dd09cf483","_type":"span","marks":[],"text":"In partnership with the United States Marine Corps, Anduril is reimagining military base defense."}],"markDefs":[],"style":"lead"},{"_key":"72205f6d3225","_type":"block","children":[{"_key":"838ad0009c080","_type":"span","marks":[],"text":"Anduril’s integrated, autonomous defense capabilities meet evolving base security challenges with cutting-edge technology. Our family of sensors, surveillance towers, and ISR sUAS is tied together through Lattice, an AI software platform. By ingesting and fusing sensor data from our assets and running AI algorithms on top of it, Lattice autonomously detects, tracks, and classifies threats from air, land, and sea. It provides human operators with a 3D, real-time picture of everything happening around them, autonomously alerting users to threats and giving them the information they need to act quickly and decisively."}],"markDefs":[],"style":"normal"},{"_key":"b52901f0e06a","_type":"block","children":[{"_key":"75acdb70f3ac0","_type":"span","marks":[],"text":"Our system gives operators more time and information to make targeted interdictions, reduces risk for personnel on base, and allows base commanders to reallocate their limited personnel from patrols to other tasks suited to humans."}],"markDefs":[],"style":"normal"},{"_key":"2249be52fa25","_type":"block","children":[{"_key":"6d725ca06ed70","_type":"span","marks":[],"text":"Earlier this year, LtCol Brandon Newell and NavalX/SoCal Tech Bridge invited Anduril to demonstrate our complete counter intrusion system at MCAS Miramar, including Lattice, our autonomous surveillance towers, unattended ground sensors, and Ghost sUAS. Watch what happened in the video above."}],"markDefs":[],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"reimagining-base-defense"},"title":"Reimagining Base Defense"},{"_createdAt":"2022-02-21T20:59:02Z","_id":"898429c8-a840-4801-ae8d-15f5068fd173","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","authors":[{"_key":"8acf12b0-098f-4845-86ac-2a9773b02d6d","_ref":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_type":"reference"}],"categories":[{"_key":"d5d55f807ef1","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"}],"date":"2022-02-21","image":{"_type":"imageWithMeta","alt":"Military officials examine unmanned aerial vehicle at naval demonstration event.","asset":{"_ref":"image-19a90f17b1bd07202afb24310e56fc857c0c6406-3566x2002-jpg","_type":"reference"}},"meta":{"_type":"meta","description":"Anduril demonstrates unmanned technology capabilities during Navy exercise, showcasing autonomous systems for maritime operations.","title":"Anduril Brings Unmanned Technology to Navy Exercise","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"slices":[{"_key":"60b92f10579f","_type":"oneColumnRichText","content":[{"_key":"4f4aced8278b","_type":"block","children":[{"_key":"aa3ede7e413b0","_type":"span","marks":["em"],"text":"His Royal Highness Prince Salman bin Hamad Al-Khalifa, Crown Prince, Deputy Supreme Commander and Prime Minister of Bahrain, center, receives a brief on Anduril’s Ghost small unmanned aerial system at Naval Support Activity Bahrain, Jan. 31. "},{"_key":"aa3ede7e413b1","_type":"span","marks":["2f444f44a156","em"],"text":"[source]"},{"_key":"aa3ede7e413b2","_type":"span","marks":[],"text":""}],"markDefs":[{"_key":"2f444f44a156","_type":"link","href":"https://www.dvidshub.net/image/7028431/60-nations-international-organizations-kick-off-largest-maritime-exercise-middle-east"}],"style":"lead"},{"_key":"d5c044a19939","_type":"block","children":[{"_key":"f93213cefa2e","_type":"span","marks":[],"text":"Anduril joined nearly 9,000 personnel from more than 60 countries and international organizations last week in Bahrain to participate in International Maritime Exercise/Cutlass Express (IMX/CE) 2022, the largest maritime exercise in the Middle East. Anduril’s Lattice operating system was used in several training scenarios, including those related to surface warfare and search and rescue."}],"markDefs":[]},{"_key":"f5d722147d23","_type":"block","children":[{"_key":"f42109474b47","_type":"span","marks":[],"text":"Throughout the event, using Anduril’s Lattice OS autonomy software, we:"}],"markDefs":[{"_key":"2f444f44a156","_type":"link","href":"https://www.dvidshub.net/image/7028431/60-nations-international-organizations-kick-off-largest-maritime-exercise-middle-east"}]},{"_key":"5dbe4de967b5","_type":"block","children":[{"_key":"d7259caea6ac0","_type":"span","marks":[],"text":"Integrated different unmanned systems across three different warfighting domains into Lattice, providing the fused maritime domain awareness generated by the unmanned systems, as well as the unified ability to command and control a mixed fleet of assets in real time, all under a single pane of glass. U.S. military personnel provided valuable input to our engineers that enabled us to rapidly alter the capability to meet their needs and add new features — not in months and years, but in days."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"2e0ad3bb0a7d","_type":"block","children":[{"_key":"d14c6da496680","_type":"span","marks":[],"text":"Enabled one operator to perform tasks that would have otherwise required more than 12 different operators by integrating the unmanned assets into one battle network."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"7eb7361c08a8","_type":"block","children":[{"_key":"7029da732faf0","_type":"span","marks":[],"text":"Enabled a common operational picture across different locations and surface ships, allowing for shared command and control of unmanned assets, and virtual collaboration amid distributed maritime operations."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"f96e42480a0b","_type":"block","children":[{"_key":"deab44df24190","_type":"span","marks":[],"text":"We did all this and more in support of U.S. Navy efforts to rapidly integrate unmanned systems and artificial intelligence into U.S. 5th Fleet operations."}],"markDefs":[],"style":"normal"},{"_key":"622fe3c6e9e4","_type":"block","children":[{"_key":"a535dd3aa385","_type":"span","marks":[],"text":"While many training scenarios were physically carried out by hardware systems, modern software enabled sophisticated integration— the sine qua non of advanced warfighting in the 21st century."}],"markDefs":[]},{"_key":"a0bc6d2cd957","_type":"block","children":[{"_key":"bed01b6fe3cd","_type":"span","marks":[],"text":"Each of the capabilities we showcased and more are available to the Department of Defense and its partners today. This kind of leap-ahead technology is exactly what the United States and its partners have been crying out for to address a new era of security challenges. Let’s get it in the hands of our warfighters."}],"markDefs":[],"style":"normal"},{"_key":"7e372c888960","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-1d011d41b50df5d4d7fcfadb81014814b6d94f1e-2849x1470-jpg","_type":"reference"}},"imageWidth":"100","style":"center"}],"fullBleed":true}],"slug":{"_type":"slug","current":"anduril-brings-unmanned-technology-to-navy-exercise"},"title":"Anduril Brings Unmanned Technology to Navy Exercise"}],"slices":[{"_key":"b0954ef488ad","_type":"oneColumnRichText","content":[{"_key":"b414a81d3899","_type":"block","children":[{"_key":"63539399266c0","_type":"span","marks":[],"text":"Last month, Army units from the United States, United Kingdom, and the Netherlands gathered in Fort Benning, Georgia for the Army Expeditionary Warrior Exercise (AEWE), a series of force on force exercises aimed at testing and refining tactics for advanced technologies in support of small unit modernization. The objective was not theoretical discussion about what "},{"_key":"63539399266c1","_type":"span","marks":["em"],"text":"might"},{"_key":"63539399266c2","_type":"span","marks":[],"text":" be possible with technology in the future: the units were there to employ cutting-edge systems in realistic scenarios to inform operations "},{"_key":"63539399266c3","_type":"span","marks":["em"],"text":"today"},{"_key":"63539399266c4","_type":"span","marks":[],"text":"."}],"markDefs":[],"style":"lead"},{"_key":"526f7f8d5fdd","_type":"block","children":[{"_key":"3730e8a1b1e10","_type":"span","marks":[],"text":"Through over thirty sorties across nine missions, Anduril’s autonomous small unmanned aerial system (sUAS) "},{"_key":"3730e8a1b1e11","_type":"span","marks":["650ed465440c"],"text":"Ghost"},{"_key":"3e766275510a","_type":"span","marks":[],"text":" showed how software-defined UAS can enhance the lethality and effectiveness of small units. The system was co-located with forward elements and operated directly by soldiers as an autonomous intelligence, surveillance, and reconnaissance (ISR) and targeting asset to shape operations, find the enemy, and enable call for fire missions. Ghost flew at day and night, in the rain and wind to execute a range of complex tasks."}],"markDefs":[{"_key":"650ed465440c","_type":"internalLink","reference":{"_id":"9077e6b2-41b7-454c-8945-6b7747e0bf6e","_type":"page","language":null,"parent":null,"slug":{"_type":"slug","current":"ghost"},"title":"Ghost"},"targetBlank":false}],"style":"normal"},{"_key":"d533460ad93c","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-a2092a37231dfb56a2b14dbb05aa2ecba05c8c78-1050x544-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.9301470588235294,"height":544,"width":1050},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"39efdd952e90","_type":"block","children":[{"_key":"02ca62bf221c0","_type":"span","marks":[],"text":"Background"}],"markDefs":[],"style":"h2"},{"_key":"2cec2a65c608","_type":"block","children":[{"_key":"50970244c9d20","_type":"span","marks":[],"text":"Ghost is an autonomous, modular Group 2 UAS Anduril developed to fill a gap we saw between small quadcopters that are constrained in range and payload, and fixed wing sUAS that require significant equipment and manpower to operate and sustain in the field. It was built to provide tactical users with an extended-range, multi-payload and quiet ISR asset that deploys with extreme ease, and utilize the latest software-defined technologies to minimize operator workload and enhance decision-making in complex environments."}],"markDefs":[],"style":"normal"},{"_key":"a28242281255","_type":"block","children":[{"_key":"6af79958af410","_type":"span","marks":[],"text":"Specific highlights from the exercises:"}],"markDefs":[],"style":"normal"},{"_key":"e6a4bc9555a8","_type":"block","children":[{"_key":"de1e5ad9e0fc0","_type":"span","marks":[],"text":"Intuitive, Autonomous Flight"}],"markDefs":[],"style":"h2"},{"_key":"2f6f85187fcf","_type":"block","children":[{"_key":"f9bf67d2fc920","_type":"span","marks":[],"text":"Through Anduril’s "},{"_key":"f9bf67d2fc921","_type":"span","marks":["7fbc8a688527"],"text":"Lattice OS"},{"_key":"f9bf67d2fc922","_type":"span","marks":[],"text":" software platform, Ghost systems operated autonomously throughout the event. Individual soldiers were able to plan ISR missions, deconflict airspace, and operate Ghost through a point-and-click interface, keeping soldiers focused on the mission."}],"level":1,"listItem":"bullet","markDefs":[{"_key":"7fbc8a688527","_type":"internalLink","reference":{"_id":"9b2a6f22-bf61-4544-a460-6584975cb7d9","_type":"page","language":null,"parent":null,"slug":{"_type":"slug","current":"lattice"},"title":"Lattice"},"targetBlank":false}],"style":"normal"},{"_key":"fa7df6f505ff","_type":"block","children":[{"_key":"2ee1f1e9a49c0","_type":"span","marks":[],"text":"Ghosts and their operators detected, identified and tracked vehicles and personnel in day and night through obstructed terrain, with sensor data processed at the edge."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"9ae3d768b3cc","_type":"block","children":[{"_key":"1c59fa6d68a90","_type":"span","marks":[],"text":"Soldiers employed Ghosts with less than a day of operator training."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"6f87a6c039c4","_type":"block","children":[{"_key":"3794b22da9bc0","_type":"span","marks":[],"text":"Expeditionary Operations"}],"markDefs":[],"style":"h2"},{"_key":"105a58541785","_type":"block","children":[{"_key":"29cf145f36440","_type":"span","marks":[],"text":"Ghost was the only Group 2 UAS co-located with forward elements and operated by soldiers in the field throughout the exercise."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"ffb4ab5f366e","_type":"block","children":[{"_key":"448a36f620bd0","_type":"span","marks":[],"text":"Its VTOL capability and minimal footprint enabled unit leaders to embed with the Ghost operator closer to the fight."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"2d96810435d6","_type":"block","children":[{"_key":"1b0aa2396bc80","_type":"span","marks":[],"text":"In one instance, two Ghosts worked in tandem to maintain continuous ISR coverage of several platoons over a 4-hour movement to contact, in support of a US Experimental Force (EXFOR) company commander co-located with Ghost in the field."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"c61020efd0e6","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-458fed8b4b5789baa1f61d7a32a4d2f384d2ffc6-3600x2401-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.499375260308205,"height":2401,"width":3600},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"7dc2ddf90c1d","_type":"block","children":[{"_key":"cefc359163ee","_type":"span","marks":[],"text":"Multi-Mission Capability"}],"markDefs":[],"style":"h2"},{"_key":"09672cd13abe","_type":"block","children":[{"_key":"1d9073039508","_type":"span","marks":[],"text":"Ghost’s expeditionary VTOL capability enabled take off and landing in confined and makeshift landing zones, operations in rain and 30 mph wind, and nighttime missions searching for targets in woodland terrain."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"d4b9f986f2a9","_type":"block","children":[{"_key":"e53a26079fd2","_type":"span","marks":[],"text":"Ghost provided targeting grid data to allow for accurate indirect fires, enabling an OPFOR platoon defeating a numerically superior opposing force"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"e874ed13e50f","_type":"block","children":[{"_key":"e9f9404e2a08","_type":"span","marks":[],"text":"Ghost passed target data over Android Team Awareness Kit (ATAK) system to unit leaders and soldiers in the field."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"}],"fullBleed":true},{"_key":"818d4aa50b2a","_type":"twoColumnRichText","backgroundColor":{"_createdAt":"2025-03-28T19:48:15Z","_id":"4ef72091-a5e5-4392-b0bb-30764a72ee0f","_rev":"UXH5eRH3LWIQEsoDKxb1Mv","_system":{"base":{"id":"4ef72091-a5e5-4392-b0bb-30764a72ee0f","rev":"7VWAhJjM6fDIh2mauhtJEa"}},"_type":"color","_updatedAt":"2026-06-04T16:31:45Z","contrastColor":"#010101","hex":"#FFFFFF","metadata":null,"name":"White"},"column1":[{"_key":"1a6debb228fe","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-40cedf9aeaa53bd2d763c30b5949addbf938535f-500x302-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.6556291390728477,"height":302,"width":500},"hasAlpha":false,"isOpaque":true}}},"style":"center"},{"_key":"9db807422af1","_type":"block","children":[{"_key":"6137430f98c6","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"}],"column2":[{"_key":"508fa824cf66","_type":"block","children":[{"_key":"efae79a6c188","_type":"span","marks":[],"text":"As the U.S. and its allies retool for competition against peer adversaries, the range of operational environments is shifting rapidly. The pace and complexity of warfare are surpassing the speed at which unit level leaders can effectively observe, analyze, and act. Moreover, lower-echelon forces will be forced to operate with intermittent and unassured access to communication networks, logistics resupply, runways, and higher headquarters assets."}],"markDefs":[],"style":"normal"},{"_key":"dff481c0f96c","_type":"block","children":[{"_key":"9c1cb1d84848","_type":"span","marks":[],"text":"Exercises like AEWE are critical to ensure the U.S. Department of Defense and its international partners can meet these challenges head on. Anduril’s Ghost UAS and Lattice OS software platform are examples of how practical artificial intelligence and hardware design, enabled by intuitive software, can provide the tools for small units to do so."}],"markDefs":[],"style":"normal"},{"_key":"a139029337be","_type":"block","children":[{"_key":"815ce7beba37","_type":"span","marks":[],"text":"Systems are in use today with the UK Royal Marines as well as other U.S. and international customers. Learn more about Ghost and the wider Anduril family of systems "},{"_key":"dbd619978f52","_type":"span","marks":["ed1904378dcb"],"text":"here."}],"markDefs":[{"_key":"ed1904378dcb","_type":"internalLink","reference":{"_id":"9077e6b2-41b7-454c-8945-6b7747e0bf6e","_type":"page","language":null,"parent":null,"slug":{"_type":"slug","current":"ghost"},"title":"Ghost"},"targetBlank":false}],"style":"normal"}],"columnRatio":"ratio-6-6"}],"slug":{"_type":"slug","current":"ghost-brings-autonomy-to-small-units-at-aewe"},"title":"Ghost Brings Autonomy to Small Units at AEWE"},{"_createdAt":"2023-08-08T17:37:02Z","_id":"87e16269-d9c4-490c-ac19-8fb507ae90c6","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","authors":[{"_createdAt":"2025-04-10T02:38:50Z","_id":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_rev":"8QtQE8S3U2lXjdjxKMFvCL","_type":"person","_updatedAt":"2025-11-18T00:08:12Z","bio":[],"fullName":"Anduril Industries","image":{"_type":"image","asset":{"_ref":"image-a990fb8ef1bae814dc01807f8757917489c9e64d-2536x2536-jpg","_type":"reference"}},"metadata":null,"slug":{"_type":"slug","current":"anduril-industries"}}],"categories":[{"_createdAt":"2025-04-10T03:57:42Z","_id":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"news"},"title":"News"},{"_createdAt":"2025-04-10T03:57:42Z","_id":"c72ca404-8ff8-479c-9c0f-0ae73fc0a430","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"engineering"},"title":"Engineering"},{"_createdAt":"2025-04-10T03:57:42Z","_id":"f84a91e1-010a-4e53-853b-2c9f005edbda","_rev":"eBmLOIrMzK4fuf6o6EXXw6","_type":"articleCategory","_updatedAt":"2025-09-30T19:16:31Z","metadata":null,"slug":{"_type":"slug","current":"products"},"title":"Products"}],"date":"2023-06-25","image":{"_type":"imageWithMeta","alt":"Solid rocket motor test firing with bright orange and pink flame thrust.","asset":{"_id":"image-650cb8d540d6467dfb3fcd742e2ca637837cf686-1600x900-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":900,"width":1600},"hasAlpha":false,"isOpaque":true}}},"meta":{"_type":"meta","description":"Anduril acquires Adranos to become a merchant supplier of solid rocket motors, bringing advanced ALITEC fuel technology and modern manufacturing to the defense industry.","title":"ANDURIL INDUSTRIES ACQUIRES SOLID ROCKET MOTOR MANUFACTURER ADRANOS","type":"article"},"metadata":null,"parent":{"_createdAt":"2025-03-18T06:18:29Z","_id":"cb940787-64b7-481d-8379-537ea6a1cf56","_rev":"N1G5rtOZj8187JlhVNj8ZV","_system":{"base":{"id":"cb940787-64b7-481d-8379-537ea6a1cf56","rev":"U0oN0QIqDw3OWy2Rvws2n8"}},"_type":"page","_updatedAt":"2026-10-06T20:13:24Z","category":"company","meta":{"description":"The latest news, announcements, and insights from Anduril Industries.","title":"Newsroom"},"metadata":null,"slices":[{"_key":"be226df55718","_type":"navColorSlice","navColorMode":"dark"},{"_key":"862b9c27dddf","_type":"newsroomHeader","header":"News & Insights","headerLabel":"NEWSROOM","highlightedArticle":{"_type":"newsLink","link":{"_ref":"deba6017-6ea9-492e-a4f6-78f295f14d6a","_type":"reference"}}},{"_key":"54576d983b87","_type":"newsListSlice","header":"All articles"}],"slug":{"_type":"slug","current":"news"},"title":"Newsroom"},"relatedArticles":[{"_createdAt":"2023-07-13T23:34:28Z","_id":"32719de1-93e9-4884-a9f1-948d06259a8e","_rev":"tVCH8grWWfglJ1B3WbCHbn","_system":{"base":{"id":"32719de1-93e9-4884-a9f1-948d06259a8e","rev":"RS0vWXjRQWPGuLISTMIe9d"}},"_type":"article","_updatedAt":"2026-09-07T16:36:55Z","authors":[{"_key":"ffc4d028-7be9-44c3-b025-c4db63562a76","_ref":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_type":"reference"}],"categories":[{"_key":"864bf31cfbe0","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"},{"_key":"b4037e268a88","_ref":"93421cd8-6498-4e99-a11f-fe55783b363f","_type":"reference"},{"_key":"17a51108ae32","_ref":"f84a91e1-010a-4e53-853b-2c9f005edbda","_type":"reference"}],"date":"2022-03-22","image":{"_type":"imageWithMeta","alt":"Anduril's expansive manufacturing facility with production zones, organized inventory, and industrial equipment.","asset":{"_ref":"image-4ff28e6e07df3f565a77f0f798ec96c6bfaed7e9-1600x1067-jpg","_type":"reference"}},"meta":{"_type":"meta","description":"\"Manufacturing is where the rubber really hits the road,\" says Anduril Founder Palmer Luckey.","title":"Operating at Scale: Manufacturing at Anduril","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"relatedArticles":[{"_key":"c83a931ef041","_ref":"905cbfcc-d185-490f-aa9a-79c671f3c8a7","_type":"reference"},{"_key":"eace153ebe48","_ref":"77437e63-70e7-41f1-9a11-a9adfc914449","_type":"reference"}],"slices":[{"_key":"60ddb3ae026d","_type":"oneColumnRichText","content":[{"_key":"0f2c302ec77e","_type":"block","children":[{"_key":"0d5a1aed178b","_type":"span","marks":["em","strong"],"text":"This blog post and video is the first in a series on Anduril’s approach to operating a nontraditional defense company at scale."}],"markDefs":[],"style":"lead"},{"_key":"821171dfdc2e","_type":"block","children":[{"_key":"62f68c4adc28","_type":"span","marks":[],"text":"Warfare, and the deterrence thereof, remains dominated by physical systems. Software has unlocked a slew of science fiction capabilities — autonomy, collaborative swarming, precision guiding, and more — which have enhanced, not replaced, the hardware systems that armies use to wage war. Kinetic engagement between people and machines remains the bread and butter of battle — and at facilities like Anduril’s SA9 warehouse, our manufacturing team is responsible for building and shipping some of those very machines to men and women in uniform."}],"markDefs":[],"style":"normal"},{"_key":"2b5b4a184911","_type":"block","children":[{"_key":"e20961ce0483","_type":"span","marks":[],"text":"“Manufacturing is where the rubber really hits the road,” said Anduril Founder Palmer Luckey. “It’s how we turn our best ideas into prototype units for testing, and then turn the best prototypes into thousands of production units for our customers.” Across 6 locations in Southern California, Massachusetts, and Georgia totaling nearly 150,000 sq ft, Anduril’s manufacturing team turns the models and designs of their fellow engineers into tangible reality. The manufacturing operation is sophisticated but lean — the team, headed up by Justin Lopas, is extremely hands-on during the development phase of a new product, often working late nights at short notice to get new parts produced for testing the next day."}],"markDefs":[],"style":"normal"},{"_key":"95c1f94e47a3","_type":"block","children":[{"_key":"c3089d09040b","_type":"span","marks":[],"text":"Anduril has grown rapidly since it was founded in 2017. “When I started here, we had two hardware products — our "},{"_key":"320f36750211","_type":"span","marks":["36ee609c61e5"],"text":"Sentry Towers"},{"_key":"1316073fd00c","_type":"span","marks":[],"text":" and "},{"_key":"8e0bfcaa05b2","_type":"span","marks":["07eed1f66cf7"],"text":"Ghost drones"},{"_key":"87cd6f67f117","_type":"span","marks":[],"text":" — and we were shipping a couple dozen of them,” said Lopas, who left SpaceX to join Anduril in May 2020. “The manufacturing challenge wasn’t as steep. Since then, we’ve built several "},{"_key":"6137f534b1fb","_type":"span","marks":["2496f91327a4"],"text":"variants"},{"_key":"3e27cb79015a","_type":"span","marks":[],"text":" of our Towers, our interceptor drone "},{"_key":"3f8f57bab87b","_type":"span","marks":["66bc6715646c"],"text":"Anvil"},{"_key":"7816fd830a16","_type":"span","marks":[],"text":", "},{"_key":"2496a9b886fa","_type":"span","marks":["25675b62d971"],"text":"WISP passive sensors"},{"_key":"3fa41e848d1b","_type":"span","marks":[],"text":", "},{"_key":"854c39b25677","_type":"span","marks":["32975fe5d71b"],"text":"ALTIUS air-launched effects"},{"_key":"80fbcd99cadf","_type":"span","marks":[],"text":", and much more. We’re shipping our Towers, Anvils, WISPs, air-launched effects, and Ghosts at production quantities — hundreds of units, for some items — to fulfill major task orders from our customers. This year, we’ll build over 1000 Anvils and almost double the size of the team, from 36 today to 60 by the end of the year."}],"markDefs":[{"_key":"36ee609c61e5","_type":"internalLink","reference":{"_ref":"385b268e-8ce5-4c67-8825-257bd568a88b","_type":"reference"},"targetBlank":false},{"_key":"07eed1f66cf7","_type":"internalLink","reference":{"_ref":"9077e6b2-41b7-454c-8945-6b7747e0bf6e","_type":"reference"},"targetBlank":false},{"_key":"2496f91327a4","_type":"internalLink","reference":{"_ref":"c6e51253-80df-43d1-8be1-c2743da43954","_type":"reference"},"targetBlank":false},{"_key":"66bc6715646c","_type":"internalLink","reference":{"_ref":"29f7e0fc-6b26-45fd-a0a5-c55f3018aa82","_type":"reference"},"targetBlank":false},{"_key":"25675b62d971","_type":"internalLink","reference":{"_ref":"c6e51253-80df-43d1-8be1-c2743da43954","_type":"reference"},"targetBlank":false},{"_key":"32975fe5d71b","_type":"internalLink","reference":{"_ref":"dcca08af-1047-4f8e-820d-0a05e1ece758","_type":"reference"},"targetBlank":false}],"style":"normal"},{"_key":"69e70de6b927","_type":"videoEmbed","thumbnail":{"_type":"imageWithMeta","asset":{"_ref":"image-5dbbba17f9461803d879933c02e919d512c8dd78-2079x1085-png","_type":"reference"}},"url":"https://www.youtube.com/embed/--52_oTh7wM"},{"_key":"c78f3643d705","_type":"block","children":[{"_key":"304df24e80710","_type":"span","marks":[],"text":"The most intense phase of work for Lopas and his team is in supporting their counterparts across other engineering teams to develop new systems quickly. "}],"markDefs":[],"style":"normal"},{"_key":"4e835c0d94fc","_type":"block","children":[{"_key":"a137aa35acc9","_type":"span","marks":[],"text":"“Our mechanical and electrical engineers are iterating on their designs on a weekly or even daily basis,” said Dana Paz, one of Anduril’s manufacturing engineers. “We work extremely closely with them to limit the number of hours between design and test. To enable such a rapid development cycle, our mechanical and electrical development lab has ‘one of everything.’ We handle all kinds of development fabrication, from multi-axis machining, to sheetmetal fabrication, MIG and TIG welding, and 3D printing.”"}],"markDefs":[],"style":"normal"},{"_key":"89aea3ce6d8e","_type":"block","children":[{"_key":"e472f2e313240","_type":"span","marks":[],"text":"The challenge of simultaneously ramping up production while implementing internal systems and practices to get large orders out the door is substantial. To handle it, Lopas and his team settled on a set of core principles that define both their processes and culture."}],"markDefs":[],"style":"normal"},{"_key":"3cff8f7d3b77","_type":"block","children":[{"_key":"5c83b56a1c710","_type":"span","marks":[],"text":"1. Moving as quickly as possible from prototype to production"}],"markDefs":[],"style":"h2"},{"_key":"d96fba92bd40","_type":"block","children":[{"_key":"481dc0fa5b140","_type":"span","marks":[],"text":"Anduril’s approach to manufacturing is inseparable from its broader ambition to disrupt the defense industry with rapidly deployed cutting-edge technology. To reduce the timelines for development from years — as is typical in the defense industry — to months, manufacturing plays a key role."}],"markDefs":[],"style":"normal"},{"_key":"335efd5d30ee","_type":"block","children":[{"_key":"581b28dd9bdd0","_type":"span","marks":[],"text":"“An engineer can test a new part on Monday, update their CAD model that evening, have us build a new part overnight, and be back out in the field testing as early as Tuesday morning,” said Lopas. “And if that part doesn’t work like the engineer imagined, she can send us a modification on Wednesday and be back out testing on Thursday. We pride ourselves on that kind of rapid delivery. Over time that efficiency and speed compound, and the amount of development another defense company might get done in a year happens in a month or two at Anduril.”"}],"markDefs":[],"style":"normal"},{"_key":"7a0fc927281a","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-081ae2885c52743abf4c60142177013046837954-7510x4542-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"d5b3a99b9b05","_type":"block","children":[{"_key":"2fa23abe78690","_type":"span","marks":[],"text":"To accommodate a deep R&D pipeline of products at different states of maturity, Lopas has optimized Anduril’s manufacturing process for flexibility. “You see this in two areas: in the incredible range of ‘Swiss Army knife’ tools we keep on hand, and in the depth of talent among our manufacturing engineers. We hire engineering technicians with a high level of technical sophistication, who can respond intelligently and quickly to new designs or complications that come their way.”"}],"markDefs":[],"style":"normal"},{"_key":"21ee4cf153b8","_type":"block","children":[{"_key":"54b6231018a00","_type":"span","marks":[],"text":"2. Data defines the factory"}],"markDefs":[],"style":"h2"},{"_key":"af5e76365687","_type":"block","children":[{"_key":"53b9fe1db6690","_type":"span","marks":[],"text":"The manufacturing team uses a variety of data software tools to shape the manufacturing process. “We’re constantly getting data-driven feedback from both commercial software and a suite of internally developed tools, built by a team of in-house engineers,” said Paz. “We collect and analyze data from the production process, the performance of hardware during tests, and the end use of the hardware.”"}],"markDefs":[],"style":"normal"},{"_key":"40d49f0eae3d","_type":"block","children":[{"_key":"65920d4180570","_type":"span","marks":[],"text":"Data is shared and understood at all levels of the manufacturing team, allowing each individual on the team to improve their personal workflows. “It holds us accountable, helps us quickly identify things that aren’t working, and lets us predict issues down the road well in advance,” said Lopas."}],"markDefs":[],"style":"normal"},{"_key":"1bd3671843aa","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-2b3aa0c367625c5d62829c4454b53a112a9e1904-2411x1284-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"68725099ce17","_type":"block","children":[{"_key":"459b32f3142c0","_type":"span","marks":[],"text":"3. Culture is a differentiator"}],"markDefs":[],"style":"h2"},{"_key":"df124956e39e","_type":"block","children":[{"_key":"b6398a7594e40","_type":"span","marks":[],"text":"Given the technical and operational complexity of very quickly manufacturing mission-critical complex hardware at scale, we have strategically elevated the importance of manufacturing throughout the organization. Many of America’s most successful hardware companies have recognized the importance of designing an effective manufacturing process, which ultimately determines an end product’s cost, quality, and scalability. Manufacturing engineers aren’t simply called upon last minute to build — manufacturing considerations are a first priority when designing new parts and systems."}],"markDefs":[],"style":"normal"},{"_key":"00d3f0c7359a","_type":"block","children":[{"_key":"b3085c0450ee0","_type":"span","marks":[],"text":"“There’s no hierarchy between manufacturing engineers and non-manufacturing engineers,” said Lopas. “We work extremely closely with a range of engineering teams. They consult with us early and often to make sure that new parts won’t run into any manufacturing difficulties. They know that by thinking about a part’s manufacturability from day one, they’re saving themselves time and expense in the long run.”"}],"markDefs":[],"style":"normal"},{"_key":"cb9085e50ee8","_type":"block","children":[{"_key":"7a3e1d0bb95f0","_type":"span","marks":[],"text":"Being relied upon so heavily means that Lopas and his team have to hold a high bar for excellence when interviewing new candidates. “Our manufacturing-oriented engineers and engineering technicians all have to be able to operate at a high level,” said Lopas. “Luckily, we have been able to attract some of the world’s best talent in both areas. We’ve hired alumni from the most successful nontraditional and traditional aerospace and defense companies alike. We also hire from ‘non-traditional’ backgrounds: one of our techs, for example, previously worked in the live production industry setting up huge sound and light shows for concerts and events like the Emmys.”"}],"markDefs":[],"style":"normal"},{"_key":"c17e01166159","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-d432c610c65dd8f99f24b43e7bbdfcf947172cb5-8167x5447-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"6cc7e75b2c52","_type":"block","children":[{"_key":"ed39a3e6bc1a","_type":"span","marks":[],"text":"4. Using best practices from industry"}],"markDefs":[],"style":"h2"},{"_key":"0e048971df00","_type":"block","children":[{"_key":"6f97b3310bae","_type":"span","marks":[],"text":"In some instances, however, Anduril doesn’t need to reinvent the wheel — it is easier and quicker to take the very best lessons from industries like automotive, medical devices, and consumer electronics and apply them to Anduril."}],"markDefs":[],"style":"normal"},{"_key":"fff80197e1c4","_type":"block","children":[{"_key":"d1badc321e42","_type":"span","marks":[],"text":"“We are trying to manufacture complicated parts at scale. That is a difficult problem, but not an unsolved one,” said Lopas. “Many fundamental concepts of Lean Manufacturing, such as the division of labor, elimination of waste, and Kanban inventory control are directly applicable to Anduril.”"}],"markDefs":[],"style":"normal"},{"_key":"50373e1b541c","_type":"block","children":[{"_key":"09d9c2a1429a","_type":"span","marks":[],"text":"“Ultimately, in some cases, we don’t need to reinvent the wheel. Lessons from the world’s best manufacturers in adjacent industries (medical device, automotive, consumer electronics, etc.) are often easily transferable to Anduril."}],"markDefs":[],"style":"normal"},{"_key":"2f423966da41","_type":"block","children":[{"_key":"32a7b75988d8","_type":"span","marks":[],"text":"Conclusion"}],"markDefs":[],"style":"h2"},{"_key":"c1809f1c4766","_type":"block","children":[{"_key":"f6e66167f7e7","_type":"span","marks":[],"text":"While manufacturing is a painful necessity for companies selling custom-designed hardware, at Anduril it is a core piece of completing the mission, and a differentiator in the marketplace."}],"markDefs":[],"style":"normal"},{"_key":"e60634e36c0f","_type":"block","children":[{"_key":"31fa9c9429b2","_type":"span","marks":[],"text":"And the growth that took Anduril from its foundation in 2017 to large scale orders today isn’t slowing any time soon. “To achieve goals like building 1000 Anvils and hundreds of Sentry Towers this year, we’re hiring almost two dozen new people,” said Lopas. “A few years ago, we were a cool new startup building demo kits for customers. Today, we’re executing on huge contracts and making sure our men and women in uniform get the technology they need quickly and reliably.”"}],"markDefs":[],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"operating-at-scale-manufacturing-at-anduril"},"title":"Operating at Scale: Manufacturing at Anduril"},{"_createdAt":"2023-08-23T23:46:14Z","_id":"a6a9e3c1-8638-48a4-9a63-885486cd9d36","_rev":"Qy55Bpk20qPJqSMUUbsXDv","_type":"article","_updatedAt":"2026-04-08T01:28:11Z","authors":[{"_key":"e58c724e7422","_ref":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_type":"reference"}],"categories":[{"_key":"16edfee9fd4d","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"},{"_key":"049061a3fb41","_ref":"93421cd8-6498-4e99-a11f-fe55783b363f","_type":"reference"}],"date":"2023-08-23","image":{"_type":"imageWithMeta","asset":{"_ref":"image-478ed9341fe489a360b16ba7de3f4f6e2eda7c89-7724x5152-jpg","_type":"reference"}},"meta":{"_type":"meta","description":"Each year, Anduril offers paid technical and non-technical internships for students in undergraduate and graduate programs.","title":"Anduril Interns: Building core tech for 21st century defense","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"relatedArticles":[{"_key":"233852d5b694","_ref":"c31fc8d3-80bb-4d55-8171-b5e43e708652","_type":"reference"},{"_key":"b49ded8335c4","_ref":"be38b51a-7198-4756-8138-62a570215cdf","_type":"reference"},{"_key":"b0dfe3a82d43","_ref":"32719de1-93e9-4884-a9f1-948d06259a8e","_type":"reference"}],"slices":[{"_key":"4483fe1da096","_type":"oneColumnRichText","content":[{"_key":"ad17206b0251","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-fb60aca0dbf026b668e0cc0def43e4f6cdf9c136-4470x2982-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"5ef87646c764","_type":"block","children":[{"_key":"0acb3abfe6270","_type":"span","marks":[],"text":"As Kimberly Johnson was thinking about life after the U.S. Army, she became intrigued by user experience and design."}],"markDefs":[],"style":"lead"},{"_key":"71871b76ef57","_type":"block","children":[{"_key":"8ad592909ba60","_type":"span","marks":[],"text":"“It ticked all my boxes,” Johnson said of the field, which designs software to be efficient and easy to use. It was multidisciplinary and required a diverse skill set. So she applied her GI Bill to attend the University of Washington for a Masters in Human-Centered Design and Engineering. And her military and academic track record has undoubtedly served her well as a graduate intern at Anduril Industries, where she has put both experiences into practice."}],"markDefs":[],"style":"normal"},{"_key":"ec728046829f","_type":"block","children":[{"_key":"9095777aee7b0","_type":"span","marks":[],"text":"Each year, Anduril offers paid technical and non-technical internships for students in undergraduate and graduate programs — and each is assigned meaningful projects with real-world impact while gaining exposure to various engineering disciplines. They also participate in onboarding training and work alongside full-time employees, are paid competitive salaries, and participate in exclusive intern events ranging from team-building summer barbecues and boat rides to dinner at the home of "},{"_key":"9095777aee7b1","_type":"span","marks":["40da925b86d2"],"text":"Anduril Founder Palmer Luckey."}],"markDefs":[{"_key":"40da925b86d2","_type":"internalLink","targetBlank":false}],"style":"normal"},{"_key":"87769c110a02","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-2e3c32329a3ea9bf2fb5b540b9af488d369a4f5e-4800x3202-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"ef77dcaecc2d","_type":"block","children":[{"_key":"0a7295abeed20","_type":"span","marks":[],"text":"“Interns at Anduril don’t do small projects or take on ‘busy work,’” says Gokul Subramanian, Senior Vice President of Engineering (Software Programs). “As a young company, we need all hands on deck! And this year’s class worked on some of our most critical projects while receiving direct mentorship and on-the-job training from our senior engineering mentors. Many interns also receive a security clearance which enables them to interface directly with DoD customers and contribute to our nation’s hardest problems.”"}],"markDefs":[],"style":"normal"},{"_key":"b2ed22728256","_type":"block","children":[{"_key":"d4fa6d455c830","_type":"span","marks":[],"text":"Johnson, who piloted Black Hawk helicopters for two decades before retiring from the Army in 2022, was one of about 100 interns in Anduril’s 2023 class. Though she was initially concerned about fitting in with younger interns, Johnson was “pleasantly surprised” at the friendly, collaborative, and mission-focused culture of Anduril. It was different from what she was used to in the military, with open sharing of feedback between colleagues deemed far more important than formalities and rank structure that can sometimes hinder collaboration."}],"markDefs":[],"style":"normal"},{"_key":"1025e247dd31","_type":"block","children":[{"_key":"8f3d94efab800","_type":"span","marks":[],"text":"“The culture is really supportive of people trying new things,” she said."}],"markDefs":[],"style":"normal"},{"_key":"286e207e36c6","_type":"block","children":[{"_key":"8f7eadf7bae60","_type":"span","marks":[],"text":"At Anduril, Johnson spent most of her time conducting research into how operators use the "},{"_key":"8f7eadf7bae61","_type":"span","marks":["fdf8c81e659d"],"text":"Lattice software platform"},{"_key":"8f7eadf7bae62","_type":"span","marks":[],"text":" to streamline the launch, flight, and landing of "},{"_key":"8f7eadf7bae63","_type":"span","marks":["8e61136b9032"],"text":"ALTIUS launched effects"},{"_key":"8f7eadf7bae64","_type":"span","marks":[],"text":" for intelligence, surveillance, and reconnaissance missions. It was a big project, and one with tangible impact: Her research and designs will soon be handed off to engineers to code a better Lattice user experience for autonomous system operators and commanders alike."}],"markDefs":[{"_key":"fdf8c81e659d","_type":"internalLink","reference":{"_ref":"9f2ad059-2bd9-48e9-9006-2e1891937e73","_type":"reference"},"targetBlank":false},{"_key":"8e61136b9032","_type":"internalLink","reference":{"_ref":"dcca08af-1047-4f8e-820d-0a05e1ece758","_type":"reference"},"targetBlank":false}],"style":"normal"},{"_key":"6f33fdade78f","_type":"block","children":[{"_key":"2b85793498760","_type":"span","marks":[],"text":"“It’s been nice to apply what I’m learning academically,” Johnson said. “I’ve gotten confirmation that what I’m learning in grad school is helpful.”"}],"markDefs":[],"style":"normal"},{"_key":"1ca1fa69eee8","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-fcd63985eebaeca6fd92d29dc02066fc074ce761-5168x3448-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"2cdf52baa9e4","_type":"block","children":[{"_key":"cb6126df15010","_type":"span","marks":[],"text":"Designing apps and websites for a positive user experience is especially important for national security as the Pentagon increasingly shifts its focus "},{"_key":"cb6126df15011","_type":"span","marks":["89dc672d29c1"],"text":"from legacy capability to software-enabled hardware"},{"_key":"cb6126df15012","_type":"span","marks":[],"text":". The more complex and unfriendly the interface, the longer it takes users to get what they need — a potentially serious issue, especially in time-critical situations such as targeting and coordinating fires. Johnson remembered a time early on in her Army career as a personnel recovery officer having to maintain a database of soldiers’ information, which had everything one needed to know about a missing soldier — photo, contact info, identity-verification questions — but could query only one record at a time, solely by social security number. The developers “totally left out the user” while designing the software, she said, so she had to manually look up each soldier’s individual file to ensure their information was correct instead of quickly gathering a roster of the hundreds of soldiers under her charge to identify gaps in the data."}],"markDefs":[{"_key":"89dc672d29c1","_type":"link","href":"https://www.cnbc.com/video/2021/12/06/usaf-sec-kendall-were-in-a-race-for-technological-superiority-with-china.html"}],"style":"normal"},{"_key":"ee79e4e18a69","_type":"block","children":[{"_key":"9ef146af86dc0","_type":"span","marks":[],"text":"For Michael “Misha” Khmelkov, a senior at The University of Southern California majoring in biochemistry and minoring in computer science, interning at Anduril was a positive experience that boosted his confidence and helped him learn a great deal from colleagues on the "},{"_key":"9ef146af86dc1","_type":"span","marks":["f1aa963059e9"],"text":"Mission Systems Engineering team."}],"markDefs":[{"_key":"f1aa963059e9","_type":"link","href":"https://jobs.lever.co/anduril/"}],"style":"normal"},{"_key":"406c7e2afa97","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-7941dd1a2fbe850ac33eccd0320eba095d414b19-1100x734-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"52e03863cbe8","_type":"block","children":[{"_key":"0684ee5c7d6e0","_type":"span","marks":[],"text":"“I have a lot of independence and autonomy in my work,” he said, noting that Anduril interns are given clear guidance and allowed flexibility in how they solve problems. “It built my confidence a lot.” Indeed, within Khmelkov’s first month, he had written code that was deployed for use at a testing event of Anduril’s "},{"_key":"0684ee5c7d6e1","_type":"span","marks":["74b857d5f946"],"text":"counter-unmanned aerial systems (UAS) technology."}],"markDefs":[{"_key":"74b857d5f946","_type":"internalLink","reference":{"_ref":"c6e51253-80df-43d1-8be1-c2743da43954","_type":"reference"},"targetBlank":false}],"style":"normal"},{"_key":"1e88e34c3792","_type":"block","children":[{"_key":"19734e0d2abc0","_type":"span","marks":[],"text":"While studying at Carnegie-Mellon University, Lauren Park helped design a mission control interface for “"},{"_key":"19734e0d2abc1","_type":"span","marks":["2225f90818ef"],"text":"MoonRanger"},{"_key":"19734e0d2abc2","_type":"span","marks":[],"text":",” a suitcase-size robot funded by NASA to search for ice on the lunar surface. That got her interested in space and national defense, and eventually led her to joining Anduril on its mission to transform allied military capability and "},{"_key":"19734e0d2abc3","_type":"span","marks":["bfec60f0af5d"],"text":"bring much-needed reform"},{"_key":"19734e0d2abc4","_type":"span","marks":[],"text":" to an outdated defense industry ecosystem. “I think Anduril’s mission is really cool. And it stands out from other defense companies.”"}],"markDefs":[{"_key":"2225f90818ef","_type":"link","href":"https://labs.ri.cmu.edu/moonranger/"},{"_key":"bfec60f0af5d","_type":"link","href":"https://www.rebootingthearsenal.com/"}],"style":"normal"},{"_key":"1259cf377dc8","_type":"block","children":[{"_key":"e850b81d68910","_type":"span","marks":[],"text":"Park was excited to gain hands-on experience at Anduril, and happy to take on various projects of real significance. That wasn’t always the case on prior internships, she said, with vaguely-described pursuits and small-scope assignments that seemed like busy work."}],"markDefs":[],"style":"normal"},{"_key":"6d96b73cb797","_type":"block","children":[{"_key":"e3fe8e5f206c0","_type":"span","marks":[],"text":"“Anduril focuses on providing autonomy to interns,” Park said. “You have ownership over whatever project or product you are working on.”"}],"markDefs":[],"style":"normal"},{"_key":"178b85d8aac8","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-57b4a212a5cbd6ccd4d0308a94ccec1dc14ad2be-2130x1115-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"868b78859041","_type":"block","children":[{"_key":"000ba18017b70","_type":"span","marks":[],"text":"Park’s main project at Anduril was designing an intuitive user experience for operators of autonomous assets. Whether an asset is flying through the air or diving underwater, operators need to run a series of checks before launch to ensure the hardware and software is working as intended. Some assets may require lengthy pre-flight procedures, while others may need to be completed in a certain order. But “having a more systematic way of doing things” in Lattice, she says, “is a huge step in tying everything together.”"}],"markDefs":[],"style":"normal"},{"_key":"bc9a41661183","_type":"block","children":[{"_key":"1f530bfe1ef10","_type":"span","marks":[],"text":"Albert Wang, an intern on the Counter-UAS team heading into his final year studying computer science at The University of Pennsylvania, enjoyed working at Anduril and in his off time, traveling around southern California with fellow interns. The culture, he said, is “the embodiment of work hard, play hard.” And Wang put in serious effort over the summer to streamline an important analysis tool for operators to understand aerial threats, offering data and statistics for observed “tracks” of drones and other aircraft."}],"markDefs":[],"style":"normal"},{"_key":"b6b7a5c1177e","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-0244d35ee4378d9fe364d6dd1fb62713600375a6-1100x734-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"3750fc082461","_type":"block","children":[{"_key":"971ff7180fea0","_type":"span","marks":[],"text":"“I have learned so much in just three months and feel like I’ve become a much better software engineer,” he said."}],"markDefs":[],"style":"normal"},{"_key":"d3b8d18181ef","_type":"block","children":[{"_key":"1d9e39eb56430","_type":"span","marks":[],"text":"In the end, Anduril interns helped further development on the core technologies Anduril is pioneering for 21st century defense, and delivered on important projects including propulsion system testing, autonomous land vehicle design, electrical board design, and phased array antenna development, among others. And just like their mentors in the full-time ranks, Anduril interns took ownership and great pride in delivering transformational capability to American and Allied warfighters."}],"markDefs":[],"style":"normal"},{"_key":"e8f2fb45044c","_type":"block","children":[{"_key":"021cb86055d80","_type":"span","marks":[],"text":"“It feels like everyone at Anduril is here for a reason,” Khmelkov said. “It’s not just a job. They’re here because they’re passionate about Anduril’s work.”"}],"markDefs":[],"style":"normal"}],"fullBleed":true},{"_key":"c96faa4120ff","_type":"horizontalRule","spacingBottom":"base","spacingTop":"base"},{"_key":"043a934b154d","_type":"oneColumnRichText","content":[{"_key":"9f9b14ec0a39","_type":"block","children":[{"_key":"af67189376df0","_type":"span","marks":["strong"],"text":"ANDURIL INDUSTRIES"},{"_key":"af67189376df1","_type":"span","marks":[],"text":" is a defense technology company with a mission to transform U.S. and allied military capabilities with advanced technology. By bringing the expertise, technology, and business model of the 21st century’s most innovative companies to the defense industry, Anduril is changing how military systems are designed, built and sold. As the world enters a new era of strategic competition, Anduril is committed to bringing cutting-edge AI, computer vision, sensor fusion, and networking technology to the military in months, not years."}],"markDefs":[],"style":"normal"},{"_key":"73a20f274091","_type":"block","children":[{"_key":"78006d91c4840","_type":"span","marks":["db760601b041","strong"],"text":"Join us and find your next mission at Anduril"},{"_key":"78006d91c4841","_type":"span","marks":[],"text":" "},{"_key":"78006d91c4842","_type":"span","marks":["strong"],"text":"→"}],"markDefs":[{"_key":"db760601b041","_type":"internalLink","reference":{"_ref":"a4f36046-112e-4003-92c1-8590bec6104d","_type":"reference"},"targetBlank":false}],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"anduril-interns-building-core-tech-for-21st-century-defense"},"title":"Anduril Interns: Building core tech for 21st century defense"},{"_createdAt":"2023-07-19T00:09:53Z","_id":"77437e63-70e7-41f1-9a11-a9adfc914449","_rev":"RS0vWXjRQWPGuLISTMIe9d","_type":"article","_updatedAt":"2026-06-05T03:03:29Z","authors":[{"_key":"f0788c0e-f036-43de-9fc2-c9aadc0fe092","_ref":"c1dbab2b-5fb8-472a-bb84-9db80e122a31","_type":"reference"}],"categories":[{"_key":"a3e00bf0831d","_ref":"76930408-9dd1-4e94-a22a-e3fb91a252c8","_type":"reference"}],"date":"2022-05-19","image":{"_type":"imageWithMeta","alt":"ALTIUS air-launched drone flies against blue sky during Army demonstration.","asset":{"_ref":"image-8c5372085ee0d82ee918c273577bc87586e69691-1323x877-png","_type":"reference"}},"meta":{"_type":"meta","description":"ALTIUS Air Launched Effects demonstrates advanced teaming capabilities at US Army Project Edge 2022, showcasing autonomous collaboration.","title":"ALTIUS Air Launched Effects Demonstrated Advanced Teaming at US Army Project Edge 2022","type":"article"},"metadata":null,"parent":{"_ref":"cb940787-64b7-481d-8379-537ea6a1cf56","_type":"reference"},"relatedArticles":[{"_key":"6833c9b01d95","_ref":"eaec10a1-6380-4995-bd18-bb11b121fcd0","_type":"reference"},{"_key":"3f27f6447f37","_ref":"2c25e7a0-1242-4557-8c78-c09efae5177a","_type":"reference"},{"_key":"0bab8191b308","_ref":"c775c350-2299-4d4a-bf75-8c8ca76c9861","_type":"reference"}],"slices":[{"_key":"8e0a0b7fe23d","_type":"oneColumnRichText","content":[{"_key":"80afd8074e65","_type":"block","children":[{"_key":"4969ab8306b10","_type":"span","marks":[],"text":"Anduril & Area-I are excited to announce that the ALTIUS Air Launched Effects platform demonstrated first of its kind intelligent teaming during EDGE22. Air Launched Effects are vital to the Army’s Future Vertical Lift. As demonstrated at EDGE22, Area-I’s ALE technology — ALTIUS 600 — represents a technological leap ahead for this critical capability."}],"markDefs":[],"style":"lead"},{"_key":"b74d03741eed","_type":"block","children":[{"_key":"2634d7ef0bca","_type":"span","marks":[],"text":"ALTIUS was key to achieving EDGE 22’s technological goals, including demonstrating its autonomous teaming capabilities as part of the largest ALE swarm to date. The modular ALTIUS platform led the largest demonstration of collaborative teaming with multiple ALTIUS platforms operating collaboratively at once. In addition, ALTIUS demonstrated a coordinated detect, identify, locate and report mission capability."}],"markDefs":[],"style":"normal"},{"_key":"f9fe50e515f5","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_ref":"image-d7a5c96d2a3c3f6cf0e1951186772daad8a8cbf7-2048x1324-jpg","_type":"reference"}},"imageWidth":"100","style":"center"},{"_key":"a4f69be572d1","_type":"block","children":[{"_key":"efe4d6f5f24e","_type":"span","marks":[],"text":""}],"markDefs":[],"style":"normal"},{"_key":"3d7f974b0843","_type":"block","children":[{"_key":"4ddb2a3814d2","_type":"span","marks":[],"text":"ALTIUS was key to achieving EDGE 22’s technological goals, including demonstrating its autonomous teaming capabilities as part of the largest ALE swarm to date. The modular ALTIUS platform led the largest demonstration of collaborative teaming with multiple ALTIUS platforms operating collaboratively at once. In addition, ALTIUS demonstrated a coordinated detect, identify, locate and report mission capability."}],"markDefs":[],"style":"normal"},{"_key":"768de03b0bc7","_type":"block","children":[{"_key":"750f7610824f","_type":"span","marks":[],"text":"ALTIUS is an industry leader that can track, engage, and provide overmatch of enemy targets in a multi-domain environment. The ALTIUS system is modular by design, capable of supporting a variety of kinetic and non-kinetic payloads and sensors that can be customized based on the mission. ALTIUS has a demonstrated ability to be organically carried and tube launched from fixed and rotary wing aircraft in both high and low altitude, ground and utility vehicles, as well as watercraft."}],"markDefs":[],"style":"normal"},{"_key":"d0cfc74e6b27","_type":"block","children":[{"_key":"08c9c9638ebf","_type":"span","marks":[],"text":"Air Launched Effects are a critical component of the Future Attack Reconnaissance Aircraft ecosystem’s ability to regain the asymmetric advantage in reach, stand-off, protection, and lethality required in the execution of joint combined arms and maneuver operations."}],"markDefs":[],"style":"normal"},{"_key":"d39ef4a2e420","_type":"block","children":[{"_key":"a74fde2463e8","_type":"span","marks":[],"text":"Anduril is proud to support Army Futures Command during EDGE 22. EDGE 22 is part of AFC’s campaign of learning designed to accelerate technological advancements in integrated artificial intelligence, robotics, and autonomy to improve battlefield situational awareness."}],"markDefs":[],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"altius-air-launched-effects-demonstrated-advanced-teaming-at-us-army-project-edge-2022"},"title":"ALTIUS Air Launched Effects Demonstrated Advanced Teaming at US Army Project Edge 2022"}],"slices":[{"_key":"68304f7b8431","_type":"oneColumnRichText","content":[{"_key":"a6e6019accf3","_type":"block","children":[{"_key":"91e21583dd230","_type":"span","marks":[],"text":"Costa Mesa, CA — Anduril Industries, a defense technology company, and Adranos, a manufacturer of solid rocket motors, have announced the completion of Anduril’s acquisition of Adranos. The terms of the deal were not disclosed."}],"markDefs":[],"style":"lead"},{"_key":"0ff3ecd03c7d","_type":"block","children":[{"_key":"153701cb13190","_type":"span","marks":[],"text":"Through this acquisition, Anduril will become a merchant supplier of solid rocket motors to prime contractors delivering missiles, hypersonics and other propulsion systems for some of the Department of Defense’s most important programs. Anduril’s entrance to the market as a supplier will bring more resources and competition to an industry facing heavy consolidation, expand the industrial supply base, and provide increased velocity for development and production of solid rocket motors, which are critical to replenishing allied stockpiles of munitions and maintaining credible deterrence."}],"markDefs":[],"style":"normal"},{"_key":"cc914529e908","_type":"block","children":[{"_key":"4be3e4ce93dc0","_type":"span","marks":[],"text":"Founded in 2015, Adranos has refined an approach to the development of solid rocket motors that meets the evolving challenges of modern warfare. Adranos invented a proprietary aluminum-lithium alloy fuel called ALITEC that can produce up to a 40% range increase in solid rocket motors, while saving costs. The company has also devised an advanced manufacturing process for developing solid rocket motors that is significantly faster and more efficient than techniques used by legacy solid rocket motor manufacturers."}],"markDefs":[],"style":"normal"},{"_key":"4a6f646ae5a0","_type":"block","children":[{"_key":"695bf2b67fde0","_type":"span","marks":[],"text":"Anduril will bring critical resources toward developing the Adranos Solid Rocket Complex production facility in Mississippi into a modern manufacturing facility, which will increase output of both standard and ALITEC solid rocket motors to thousands per year at much faster lead times than currently available."}],"markDefs":[],"style":"normal"},{"_key":"dd30de760acf","_type":"block","children":[{"_key":"ed471393b8ca0","_type":"span","marks":[],"text":"“There is a clear need for greater competition and expanded supply in solid rocket motors for the United States and our allies,” said Anduril CEO Brian Schimpf. “With this acquisition, Anduril will grow the defense industrial base, speed development and production of critical components with an advanced manufacturing approach, and enable next-generation performance of solid rocket motors with ALITEC, which is crucial for national security and overall health of the defense industry.”"}],"markDefs":[],"style":"normal"},{"_key":"873aaf2a93f1","_type":"block","children":[{"_key":"6143c3564d760","_type":"span","marks":[],"text":"“Our focus has been on innovating solid rocket motor development and manufacturing, solving the problems of rocket range and production volumes,” said Adranos CEO Chris Stoker. “With Anduril, we’ll be able to rapidly mature our technology and scale our team and production capabilities to increase our output to thousands of traditional and ALITEC solid rocket motors per year.”"}],"markDefs":[],"style":"normal"},{"_key":"40157f0e893d","_type":"block","children":[{"_key":"abcbe3286a890","_type":"span","marks":[],"text":"“Solid rocket motors power some of the most important resources in our arsenal to protect our national security interests, and to fortify our military advantages over adversaries like China, Russia, and Iran,” said U.S. Senator Cyndi Hyde-Smith (R-Miss). “Mississippi is proud of the contributions our workers make toward these important missions. This announcement brings together world-class talent, innovation, and commitment to national defense from Anduril and Adranos. We are thrilled by the opportunity to manufacture best-in-class solid rocket motors in Mississippi to ensure the men and women who protect us are the best trained and equipped in the world.”"}],"markDefs":[],"style":"normal"},{"_key":"413ba24f5670","_type":"block","children":[{"_key":"7fe018396bf40","_type":"span","marks":[],"text":"“The availability of solid rocket motors is of critical importance to U.S. national security. These motors are the lifeblood of munitions, hypersonic weapons, and small space launch systems,” said U.S. Senator Roger Wicker (R-Miss). “Anduril’s acquisition of Adranos establishes a new merchant supplier of these components at a critical time. Anduril’s plan to expand its presence in Mississippi will create more jobs and add to our state’s strong ecosystem of space and defense companies.”"}],"markDefs":[],"style":"normal"},{"_key":"cfb21df48df1","_type":"block","children":[{"_key":"7491a22286880","_type":"span","marks":[],"text":"“Congratulations to Anduril Industries and Adranos on this exciting deal,” said Mississippi Governor Tate Reeves. “Mississippi’s economy is growing stronger every day and companies are really taking off in our state. We have the best workforce in the nation and the innovation happening here is truly awe-inspiring. Mississippians are manufacturing the most advanced solid rocket motors in the world. If you’re a company in the defense industry, Mississippi is the ideal place to do business.”"}],"markDefs":[],"style":"normal"}],"fullBleed":true}],"slug":{"_type":"slug","current":"anduril-industries-acquires-solid-rocket-motor-manufacturer-adranos"},"title":"ANDURIL INDUSTRIES ACQUIRES SOLID ROCKET MOTOR MANUFACTURER ADRANOS"}],"slices":[{"_key":"3fdd120ad674","_type":"oneColumnRichText","content":[{"_key":"b78c1d44ef3d","_type":"block","children":[{"_key":"8b99e303c5eb0","_type":"span","marks":[],"text":"COSTA MESA, Calif. — Defense technology company Anduril Industries today announced its acquisition of Blue Force Technologies, a developer of autonomous aircraft with an integrated aerostructures division serving a wide range of defense and commercial customers. This transaction will expand Anduril’s existing autonomous fleet to now include large high performance, group 5 aircraft and significantly increases Anduril’s reach and impact within the Department of Defense. Terms of the deal were not disclosed."}],"markDefs":[],"style":"lead"},{"_key":"d33343d80b4e","_type":"block","children":[{"_key":"74e89d43165d","_type":"span","marks":[],"text":"Blue Force Technologies designs and manufactures high-end composite aircraft and their components at its factories in North Carolina. Blue Force Technologies has been developing "},{"_key":"8b99e303c5eb1","_type":"span","marks":["b98d586b6c22"],"text":"Fury, a group 5 autonomous air vehicle"},{"_key":"8b99e303c5eb2","_type":"span","marks":[],"text":" with fighter-like performance since 2019. Fury leverages proprietary rapid prototyping, digital engineering and an open architecture that is designed to deliver next-generation flight performance with the flexibility to integrate heterogenous sensors and payloads to support air dominance missions. Recently, the company successfully completed a flight test of the flight software on board a VISTA, Variable Stability In-flight Simulator Test Aircraft"},{"_key":"8b99e303c5eb3","_type":"span","marks":["em"],"text":", "},{"_key":"8b99e303c5eb4","_type":"span","marks":[],"text":"and a ground test for Fury’s novel carbon fiber composite propulsion flowpath system."}],"markDefs":[{"_key":"b98d586b6c22","_type":"internalLink","reference":{"_id":"6880f541-179e-4366-9d2d-646d163d4c1c","_type":"page","language":null,"parent":null,"slug":{"_type":"slug","current":"fury"},"title":"Fury"},"targetBlank":false}]},{"_key":"9cfb7d5d029f","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-352a1646cea0cd45ec82adad73b1f1d5f49d3174-3840x2160-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":2160,"width":3840},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"},{"_key":"6acec0769511","_type":"block","children":[{"_key":"e1a147d4c537","_type":"span","marks":[],"text":"Anduril is making significant investments to continue the development of the Fury autonomous air vehicle, expand manufacturing operations in North Carolina and accelerate development of technologies critical to future capabilities such as autonomous collaborative platforms. As a nontraditional company that uses its own capital for research and development, Anduril moves fast to engineer, prototype, develop and produce new capabilities for the Department of Defense."}],"markDefs":[],"style":"normal"},{"_key":"cfa268a2fba7","_type":"block","children":[{"_key":"6e5ee5c139c5","_type":"span","marks":[],"text":"These new capabilities are critical to maintaining deterrence in an era of strategic competition. To project force, deter aggression, and regain affordable mass, the DoD will need to rely on large quantities of smaller, lower-cost, more autonomous systems. The U.S. Air Force, U.S. Navy and U.S. Marine Corps have all signaled their intention to modernize and adopt advanced autonomous capabilities. This ecosystem of autonomous systems must be powered by software that enables a single operator to control multiple assets to accomplish a wide range of missions."}],"markDefs":[]},{"_key":"a81135398266","_type":"block","children":[{"_key":"086b425baa04","_type":"span","marks":[],"text":"This acquisition follows Anduril’s successful launch of "},{"_key":"1d20e3d8ae0c","_type":"span","marks":["5f0536325f86"],"text":"Lattice for Mission Autonomy"},{"_key":"7f77d0a4e2e0","_type":"span","marks":[],"text":" earlier this year, the artificial intelligence-enabled software platform that enables teams of autonomous systems to dynamically collaborate to achieve complex missions, under human supervision. By investing in both hardware and software capabilities, Anduril will further accelerate the development of autonomous operations like manned-unmanned teaming and other critical advanced autonomous solutions for warfighters around the world."}],"markDefs":[{"_key":"5f0536325f86","_type":"link","href":"https://blog.anduril.com/anduril-unveils-lattice-for-mission-autonomy-8e0c5fa0e94b"}]},{"_key":"3855b514df0d","_type":"block","children":[{"_key":"561f68ba08c8","_type":"span","marks":[],"text":"Anduril is a proven leader in developing and fielding integrated autonomous solutions across a wide variety of sensors, effectors and assets across domains. Anduril has experience automating the operations of hundreds of robotic systems deployed in tactical environments around the world. Its objective is to support Department of Defense and allied militaries services in fielding autonomous and artificially intelligent systems as fast as possible."}],"markDefs":[]},{"_key":"4ad4af7689ca","_type":"richTextImage","image":{"_type":"imageWithMeta","asset":{"_id":"image-b6bbd7fca164e5d7c3107f19c52b13a36c33b1fb-3840x2160-jpg","_type":"sanity.imageAsset","mimeType":"image/jpeg","metadata":{"_type":"sanity.imageMetadata","dimensions":{"_type":"sanity.imageDimensions","aspectRatio":1.7777777777777777,"height":2160,"width":3840},"hasAlpha":false,"isOpaque":true}}},"imageWidth":"100","style":"center"}],"fullBleed":true}],"slug":{"_type":"slug","current":"anduril-acquires-blue-force-technologies"},"title":"ANDURIL INDUSTRIES ACQUIRES UAS DEVELOPER BLUE FORCE TECHNOLOGIES ","path":"news/anduril-acquires-blue-force-technologies"}
    </script>
    <script type="application/json" id="ssgSiteSettings">
